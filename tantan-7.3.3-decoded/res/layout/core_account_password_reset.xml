<?xml version="1.0" encoding="utf-8"?>
<v.VLinear android:orientation="vertical" android:clipChildren="false" android:layout_width="match_parent" android:layout_height="match_parent" holder="account.PasswordResetViewModel" style="@style/core_account_root"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <v.navigationbar.VNavigationBar android:id="@id/navigation_bar" android:layout_width="match_parent" android:layout_height="wrap_content" app:leftIcon="@null" />
    <v.VScroll style="@style/core_account_scroll">
        <LinearLayout style="@style/core_account_frame">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <v.VMaterialEdit android:id="@id/password" android:hint="@string/SIGNUP_CHOOSE_PASSWORD" android:maxLength="20" style="@style/core_account_password_min_length" />
            </LinearLayout>
        </LinearLayout>
    </v.VScroll>
    <v.VButton_FakeShadow android:id="@id/done" android:text="@string/ACTION_DONE" style="@style/core_account_continue_button" />
</v.VLinear>
