    </LinearLayout>
    <TextView android:gravity="center" android:id="@id/music_panel_ok" android:layout_width="match_parent" android:layout_height="50.0dp" android:text="OK" />
    <TextView android:gravity="center" android:id="@id/music_panel_item_1" android:layout_width="match_parent" android:layout_height="50.0dp" android:text="music1" />
    <TextView android:gravity="center" android:id="@id/music_panel_item_2" android:layout_width="match_parent" android:layout_height="50.0dp" android:text="music2" />
    <TextView android:gravity="center" android:id="@id/music_panel_item_3" android:layout_width="match_parent" android:layout_height="50.0dp" android:text="music3" />
</LinearLayout>
