<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:clipChildren="false" android:importantForAutofill="noExcludeDescendants" holder="accountnew.PasswordResetNewViewModel" style="@style/account_account_root"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <v.VScroll style="@style/account_account_scroll">
        <LinearLayout style="@style/account_account_frame">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <v.VMaterialEdit android:id="@id/password" android:hint="@string/SIGNUP_CHOOSE_PASSWORD" android:maxLength="20" style="@style/account_account_password_min_length" />
            </LinearLayout>
        </LinearLayout>
    </v.VScroll>
    <v.VButton_FakeShadow android:id="@id/done" android:text="@string/ACTION_DONE" style="@style/account_account_continue_button" />
</LinearLayout>
