<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal" android:id="@id/media" android:background="#f4f4f6" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@drawable/messages_media_divider_vertical" android:showDividers="middle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout style="@style/messages_media_col">
        <v.VLinear android:id="@id/mild_question" android:layout_height="0.0dp" android:layout_weight="1.0" style="@style/messages_media_item_frame">
            <v.VImage android:src="@null" style="@style/core_messages_media_item_image" />
            <v.VText android:text="@string/INTERACTION_MILD_QUESTION" style="@style/core_messages_media_item_text" />
        </v.VLinear>
        <v.VLinear android:id="@id/camera" android:layout_height="0.0dp" android:layout_weight="1.0" style="@style/messages_media_item_frame">
            <v.VImage android:src="@null" style="@style/core_messages_media_item_image" />
            <v.VText android:text="@string/INTERACTION_CAMERA" style="@style/core_messages_media_item_text" />
        </v.VLinear>
    </LinearLayout>
    <LinearLayout style="@style/messages_media_col">
        <v.VLinear android:id="@id/intimate_question" android:layout_height="0.0dp" android:layout_weight="1.0" style="@style/messages_media_item_frame">
            <v.VImage android:src="@null" style="@style/core_messages_media_item_image" />
            <v.VText android:text="@string/INTERACTION_INTIMATE_QUESTION" style="@style/core_messages_media_item_text" />
        </v.VLinear>
        <v.VFrame android:id="@id/location" android:layout_height="0.0dp" android:layout_weight="1.0" flatten="true" style="@style/messages_media_item_frame">
            <v.VLinear android:layout_gravity="center" android:background="@color/transparent" style="@style/messages_media_item_frame">
                <v.VImage android:src="@null" style="@style/core_messages_media_item_image" />
                <v.VText android:text="@string/INTERACTION_SEND_LOCATION" style="@style/core_messages_media_item_text" />
            </v.VLinear>
        </v.VFrame>
    </LinearLayout>
    <LinearLayout style="@style/messages_media_col">
        <v.VLinear android:id="@id/picture" android:layout_height="0.0dp" android:layout_weight="1.0" style="@style/messages_media_item_frame">
            <v.VImage android:src="@null" style="@style/core_messages_media_item_image" />
            <v.VText android:text="@string/INTERACTION_SEND_PHOTO" style="@style/core_messages_media_item_text" />
        </v.VLinear>
        <v.VFrame android:id="@id/voice_call" android:layout_height="0.0dp" android:layout_weight="1.0" flatten="true" style="@style/messages_media_item_frame">
            <v.VLinear android:layout_gravity="center" android:background="@color/transparent" style="@style/messages_media_item_frame">
                <v.VImage android:src="@null" style="@style/core_messages_media_item_image" />
                <v.VText android:text="@string/VOICE_CALL_BUTTON" style="@style/core_messages_media_item_text" />
            </v.VLinear>
        </v.VFrame>
    </LinearLayout>
</LinearLayout>
