<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#d8ba8e" android:endColor="#d8ba8e" android:angle="45.0" android:type="linear" android:centerColor="#1ad8ba8e" />
            <corners android:radius="24.0dp" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#131110" />
            <corners android:radius="24.0dp" />
        </shape>
    </item>
</layer-list>
