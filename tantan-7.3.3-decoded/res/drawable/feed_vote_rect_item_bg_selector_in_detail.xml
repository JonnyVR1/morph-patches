<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <stroke android:width="3.0dp" android:color="@color/feed_vote_stroke_orange" />
            <solid android:color="@color/white" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <stroke android:width="3.0dp" android:color="@color/feed_gray_f7" />
            <solid android:color="@color/white" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
