<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.p070ui.splash.FakeSplashView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f7f7f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="splash.FakeSplashViewOld">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingBottom="42dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VDelegateLayout
            android:id="@+id/welcome_page_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VPager
                android:id="@+id/pager"
                android:scrollbars="none"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:requiresFadingEdge="none"/>
        </p151v.VDelegateLayout>
        <p151v.VPagerWormIndicator
            android:layout_gravity="center_horizontal"
            android:id="@+id/indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:vwi_indicatorColor="#80d0d0d0"
            app:vwi_indicatorHeight="6dp"
            app:vwi_indicatorMargin="6dp"
            app:vwi_indicatorRadius="4dp"
            app:vwi_indicatorWidth="6dp"
            app:vwi_selectedIndicatorColor="#d0d0d0"
            app:vwi_selectedIndicatorWidth="16dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="128dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/quick_login"
                    android:background="@drawable/account_wechat_login_btn_bg"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="32dp"
                    android:layout_marginRight="32dp"
                    android:layout_marginBottom="24dp"
                    android:minHeight="52dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VImage
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f080130"/>
                        <p151v.VText
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:background="@color/transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="14dp"
                            android:checked="false"
                            android:text="@string/LOGIN_TYPE_WECHAT"
                            android:layout_centerInParent="true"
                            android:textAllCaps="false"
                            android:stateListAnimator="@null"/>
                    </LinearLayout>
                </FrameLayout>
                <p151v.VButton_FakeShadow
                    android:textSize="16sp"
                    android:textColor="@color/gray_999999"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/start"
                    android:background="@drawable/account_phone_login_btn_white_bg"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="32dp"
                    android:layout_marginRight="32dp"
                    android:checked="false"
                    android:minHeight="52dp"
                    android:text="@string/ACTION_START_TANTAN"
                    android:maxLines="1"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    style="@style/v_button"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#d0d0d0"
        android:textColorHighlight="@color/transparent"
        android:textColorLink="#999999"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/privacy_policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"/>
</com.p051p1.mobile.putong.p070ui.splash.FakeSplashView>
