<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feed.newui.FeedAlbumPersionTitleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui.photoalbum.feed.newui"
    holder="FeedAlbumPersionTitleView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_info_container"
        android:paddingLeft="12dp"
        android:paddingTop="20dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="90dp"
            android:layout_height="130dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <p151v.VLinear_FillerMeasure
            android:orientation="horizontal"
            android:id="@+id/user_info"
            android:paddingTop="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            app:fillerIndex="0"
            app:layout_constraintLeft_toRightOf="@+id/avatar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar"
            flatten="true">
            <p151v.VText
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:ellipsize="end"
                android:layout_gravity="left"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:singleLine="true"/>
            <FrameLayout
                android:layout_gravity="center"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:id="@+id/verification_icon"
                    android:visibility="visible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitXY"/>
            </FrameLayout>
            <include
                android:layout_gravity="center"
                android:id="@+id/sex_age_content"
                android:paddingLeft="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/feed_sex_and_age_view"/>
            <FrameLayout
                android:layout_gravity="center"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:id="@+id/img_vip"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/diamond_label_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                    android:id="@+id/diamond_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
            </FrameLayout>
        </p151v.VLinear_FillerMeasure>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:id="@+id/click_tip"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="0dp"
            app:layout_constraintLeft_toLeftOf="@+id/user_info"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_info"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:id="@+id/user_extend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="8dp"
            android:maxLines="2"
            android:letterSpacing="-0.05"
            app:layout_constraintLeft_toLeftOf="@+id/user_info"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/click_tip"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:id="@+id/state_container"
            android:background="@drawable/feed_personal_state_bg"
            android:paddingRight="14dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="9dp"
            app:layout_constraintLeft_toLeftOf="@+id/user_info"
            app:layout_constraintTop_toBottomOf="@+id/user_extend">
            <p151v.VDraweeView
                android:id="@+id/state_img"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="9dp"
                style="@style/feed_fresco_profile_small"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#1a1a1b"
                android:id="@+id/state_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="1dp"/>
        </p151v.VLinear>
        <p151v.VLine
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.p051p1.mobile.putong.feed.newui.photoalbum.feed.personfeedinprofile.FeedWriterLevelInProfileView
        android:id="@+id/personal_feed_writer_level"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/user_info_container"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feed.newui.FeedAlbumPersionTitleView>
