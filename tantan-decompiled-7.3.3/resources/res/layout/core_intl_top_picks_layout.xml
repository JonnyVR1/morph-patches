<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#fff1e9"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="toppicks.TopPicksTabViewModel">
    <p151v.VDraweeView
        android:id="@+id/bg_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="434:262"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VFrame
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VLinear
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/image"
                    android:layout_width="220dp"
                    android:layout_height="150dp"
                    app:actualImageScaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#cc000000"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/desc"
                    android:layout_width="310dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/INTL_PICKS_BLANK_TEXT"/>
            </p151v.VLinear>
            <p151v.VProgressBar
                android:id="@+id/progress"
                style="@style/core_loading_block"/>
        </p151v.VFrame>
        <p151v.VPullUpRecyclerView
            android:id="@+id/list"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="80dp"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/get_privilege"
            android:background="@drawable/core_round_ffdea2_10dp_btn_selector"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="16dp"
            android:text="@string/INTL_PICKS_BUTTON"/>
    </p151v.VFrame>
</androidx.constraintlayout.widget.ConstraintLayout>
