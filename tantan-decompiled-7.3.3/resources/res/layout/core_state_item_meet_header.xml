<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.header.MeetStateHeaderItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="newmeet.header.MeetStateHeaderItem">
    <p151v.VFrame
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:background="@drawable/core_conversation_local_live_bg"
            android:padding="7dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundAsCircle="true"/>
        <p151v.VIcon
            android:layout_gravity="bottom|right"
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="2dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="2dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="5dp"
        android:lines="1"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#4c000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="5dp"
        android:lines="1"/>
</com.p051p1.mobile.putong.core.newui.newmeet.header.MeetStateHeaderItem>
