<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationHeadLikerItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_card_bg_medium_02"
    android:clipChildren="false"
    android:layout_width="100dp"
    android:layout_height="115dp"
    folder="newui"
    holder="messages.ConversationHeadLikerItemLayout">
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/head_layout"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:background="@drawable/core_default_head_bg"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="3dp"
            style="@style/core_special_like_avatar"/>
        <p151v.VFrame
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/chat_label"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/chat_label_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080948"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/chat_label_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:lines="1"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_66000000"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/txt"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationHeadLikerItemLayout>
