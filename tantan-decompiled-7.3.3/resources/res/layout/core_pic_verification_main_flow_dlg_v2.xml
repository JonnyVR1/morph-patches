<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:src="0x7f0805a6"
            android:scaleType="fitXY"/>
        <ImageView
            android:id="@+id/iv_user_gender"
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:src="0x7f0805a8"
            android:scaleType="center"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/close"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="16dp"
            android:src="0x7f081338"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:text="完成真实头像认证，可设置只看认证用户"
        android:maxLines="2"
        android:layout_marginHorizontal="32dp"
        app:typeface="medium"/>
    <LinearLayout
        android:id="@+id/checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:layout_marginHorizontal="32dp">
        <p151v.VCheckBox
            android:id="@+id/check"
            android:background="@drawable/core_checkbox_pic_verification_bg"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="3dp"
            android:button="@null"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:id="@+id/reminder"
            android:paddingBottom="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1.8dp"/>
    </LinearLayout>
    <p151v.VButton
        android:ellipsize="end"
        android:id="@+id/popup_positive_btn"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:text="@string/VERIFICATION_CENTER_VERIFICATION_TYPE_DEFAULT_NEW"
        android:lines="1"
        android:layout_marginHorizontal="32dp"
        app:typeface="medium"
        style="@style/common_button_large_01"/>
    <p151v.VButton
        android:textSize="16dp"
        android:textColor="@color/core_color_30percent_000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/popup_open_svip_btn"
        android:background="@drawable/common_bg_10_08000000"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:text="开通SVIP"
        android:maxLines="1"
        android:lines="1"
        android:fontFamily="PingFangSC-Medium"
        android:layout_marginHorizontal="32dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#33000000"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_change_avatar_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        android:text="稍后再说"
        android:lines="1"
        android:layout_marginHorizontal="32dp"/>
</LinearLayout>
