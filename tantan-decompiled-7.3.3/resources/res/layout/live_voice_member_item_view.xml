<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.virtualmotion.creator.rightcall.VoiceMemberItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="79dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    flatten="true"
    holder="virtual.virtualmotion.creator.rightcall.VoiceMemberItemView">
    <View
        android:id="@+id/background"
        android:background="@drawable/live_bg_black_oval_a20"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/avatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/state"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <p151v.VDraweeView
        android:id="@+id/state_bg"
        android:layout_width="18dp"
        android:layout_height="0dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/index_container"
        app:layout_constraintLeft_toLeftOf="@+id/index_container"
        app:layout_constraintRight_toRightOf="@+id/index_container"
        app:layout_constraintTop_toTopOf="@+id/index_container"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/index_container"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        flatten="true">
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#ccffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/index"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:maxEms="1"
            android:lineSpacingExtra="-1dp"/>
        <View
            android:id="@+id/place"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"/>
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/mute_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginBottom="2dp"
            android:src="0x7f0827e3"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/volume_svg"
        android:layout_width="34dp"
        android:layout_height="58dp"
        android:layout_marginStart="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_cp"
        android:layout_width="36dp"
        android:layout_height="90dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/avatar"
        app:layout_constraintEnd_toStartOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.virtualmotion.creator.rightcall.VoiceMemberItemView>
