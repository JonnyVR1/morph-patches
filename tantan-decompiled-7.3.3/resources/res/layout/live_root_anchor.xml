<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.base.live.LiveView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="base"
    holder="live.LiveView">
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_bg_view"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_pusher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_pusher_view"/>
    <p151v.VRelative
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/live_preview"/>
        <include
            android:id="@+id/live_pk"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="316dp"
            android:layout_marginTop="189dp"
            android:layout_centerHorizontal="true"
            flatten="true"
            layout="@layout/live_pk_view"/>
        <include
            android:id="@+id/live_pk_internal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="316dp"
            android:layout_marginTop="189dp"
            android:layout_centerHorizontal="true"
            flatten="true"
            layout="@layout/live_pk_view_internal"/>
        <include
            android:id="@+id/live_multi_call"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            android:layout_centerHorizontal="true"
            flatten="true"
            layout="@layout/live_multi_call_top_view"/>
        <include
            android:id="@+id/live_multi_pk_points"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="-16dp"
            android:layout_alignTop="@+id/live_multi_call"
            android:layout_centerHorizontal="true"
            flatten="true"
            layout="@layout/live_multi_pk_points_layout"/>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_obs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true"
            layout="@layout/live_obs_preview_view"/>
        <include
            android:id="@+id/live_call"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="268dp"
            android:layout_marginTop="193dp"
            flatten="true"
            layout="@layout/live_call_view"/>
        <p151v.VFrame
            android:id="@+id/live_avatar_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_below="@+id/jump_room"
            flatten="true">
            <include
                android:id="@+id/live_avatar"
                android:layout_width="wrap_content"
                android:layout_height="53dp"
                android:layout_marginStart="@dimen/live_avatar_margin_start"
                layout="@layout/live_avatar"/>
        </p151v.VFrame>
        <View
            android:id="@+id/space"
            android:layout_width="@dimen/live_avatar_margin_start"
            android:layout_height="1dp"/>
        <p151v.VRelative
            android:id="@+id/board_entry_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/live_avatar_layout"
            android:layout_marginStart="12dp"
            flatten="true">
            <include
                android:id="@+id/announcement_entry"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                layout="@layout/live_announcement_entry"/>
            <p151v.VFrame
                android:id="@+id/hour_board_entry_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_toRightOf="@+id/announcement_entry"
                android:layout_marginEnd="8dp"
                android:layout_toEndOf="@+id/announcement_entry"
                flatten="true">
                <include
                    android:id="@+id/hour_board_entry"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    layout="@layout/live_hour_leader_board_entry"/>
                <include
                    android:id="@+id/hour_board_new_entry"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    layout="@layout/live_hour_leader_board_new_entry"/>
            </p151v.VFrame>
            <FrameLayout
                android:id="@+id/star_board_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:layout_toEndOf="@+id/hour_board_entry_root"
                flatten="true">
                <include
                    android:id="@+id/star_board_entry"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    layout="@layout/live_star_board_entry"/>
                <include
                    android:id="@+id/intl_star_board_entry"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    layout="@layout/live_intl_star_board_entry"/>
            </FrameLayout>
        </p151v.VRelative>
        <include
            android:id="@+id/live_fans"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="39dp"
            android:layout_toRightOf="@+id/live_avatar_layout"
            android:layout_alignParentRight="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentEnd="true"
            layout="@layout/live_fans"/>
        <include
            android:id="@+id/live_bullet"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-22dp"
            android:layout_below="@+id/live_avatar_layout"
            layout="@layout/live_bullet_notice_container_view"/>
        <include
            android:id="@+id/sticker_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/live_sticker_container"/>
        <include
            android:id="@+id/live_operation_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/board_entry_container"
            layout="@layout/live_operation_entry"/>
        <View
            android:id="@+id/anchorPoint"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginTop="104dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
        <include
            android:id="@+id/live_call_widget"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="89dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="170dp"
            android:layout_alignParentBottom="true"
            layout="@layout/live_call_widget_view"/>
        <com.p051p1.mobile.putong.live.livingroom.common.chat.danmaku.show.DanmakuViewPort
            android:layout_gravity="bottom"
            android:id="@+id/danmaku_viewport"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginBottom="30dp"
            android:layout_above="@+id/live_chat"/>
        <include
            android:id="@+id/live_chat"
            android:visibility="gone"
            android:layout_width="248dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentBottom="true"
            layout="@layout/live_chat"/>
        <include
            android:orientation="vertical"
            android:id="@+id/live_campaigns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="60dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="12dp"
            flatten="true"
            layout="@layout/live_campaign_view"/>
        <FrameLayout
            android:id="@+id/chatCampaign"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentBottom="true"/>
    </p151v.VRelative>
    <p151v.VFrame
        android:id="@+id/middle_layer"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:id="@+id/gift_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/live_gift_layer"/>
        <include
            android:id="@+id/top_effect_layer"
            layout="@layout/live_top_effect_layer"/>
    </p151v.VFrame>
    <p151v.VRelative
        android:id="@+id/topside_layer"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:id="@+id/live_chat_entry"
            android:visibility="gone"
            android:layout_width="248dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentBottom="true"
            layout="@layout/live_chat_input_entry"/>
        <include
            android:id="@+id/live_bottom"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="56dp"
            android:layout_alignParentEnd="true"
            layout="@layout/live_bottom"/>
        <com.p051p1.mobile.putong.live.livingroom.common.bubble.LiveBubbleView
            android:id="@+id/live_bubble"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="252dp"
            android:layout_alignParentBottom="true">
            <include
                android:id="@+id/gift_trays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/live_gift_trays"/>
            <include
                android:id="@+id/admission"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="-13dp"
                layout="@layout/live_gift_trays_admission"/>
        </p151v.VLinear>
        <FrameLayout
            android:id="@+id/notification_view"
            android:visibility="gone"
            android:layout_width="183dp"
            android:layout_height="48dp"
            android:layout_marginTop="-64dp"
            android:layout_alignTop="@+id/gift_trays"
            android:layout_marginEnd="-3dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <p151v.VRelative
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/close_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/live_close"
            android:layout_width="44dp"
            android:layout_height="38dp"
            app:srcCompat="0x7f0824c3"/>
    </p151v.VRelative>
    <include
        android:id="@+id/sticker_drag_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_sticker_drag_mask"/>
    <View
        android:id="@+id/shadow"
        android:background="@color/live_black_60_opacity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/pre_operation_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/live_pre_operation_anim_view"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.game.GameEffectView
        android:layout_gravity="center"
        android:id="@+id/game_player"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:id="@+id/super_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.livingroom.base.live.LiveView>
