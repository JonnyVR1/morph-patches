<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.MusicAggregateItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="camera.MusicAggregateItemView">
    <p151v.VDraweeView
        android:id="@+id/music_aggregate_item_cover"
        android:background="#eeeff1"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_margin="0.25dp"
        fresco:roundedCornerRadius="1dp"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_gravity="right"
        android:id="@+id/music_aggregate_item_tag"
        android:background="@drawable/music_aggregate_tag_background"
        android:paddingLeft="7dp"
        android:paddingTop="3dp"
        android:paddingRight="7dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="6dp"/>
</com.p051p1.mobile.putong.feed.newui.camera.MusicAggregateItemView>
