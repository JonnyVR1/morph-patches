<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.RoomPusherPreviewView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="recreation"
    holder="multiplayerchat.view.RoomPusherPreviewView">
    <FrameLayout
        android:id="@+id/surfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/live_switch_camera"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:src="0x7f0826a0"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/open_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请开启相机权限"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_open_permission"
            android:background="@drawable/live_bg_white_r6"
            android:layout_width="80dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:text="开启授权"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.RoomPusherPreviewView>
