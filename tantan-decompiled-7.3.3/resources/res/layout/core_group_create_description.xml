<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="group.GroupCreateDescriptionViewModel"
    innerClass="true">
    <p151v.VScroll
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingBottom="88dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#222222"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_INTRODUCTION"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#a8a8a8"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_INTRODUCTION_TIPS"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#222222"
                android:textColorHint="#d0d0d0"
                android:gravity="top|left"
                android:id="@+id/description"
                android:background="@drawable/core_group_create_edit_text_background"
                android:paddingLeft="15dp"
                android:paddingTop="11dp"
                android:paddingRight="15dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="16dp"
                android:hint="@string/CHAT_GROUP_INTRODUCTION_YINDAO"
                android:inputType="textMultiLine"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#a8a8a8"
                android:layout_gravity="right"
                android:id="@+id/description_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginRight="16dp"/>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/next"
        android:background="@drawable/core_group_create_button_background"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="10dp"
        android:text="@string/CHAT_GROUP_INTRODUCTION_FINISH"/>
</p151v.VLinear>
