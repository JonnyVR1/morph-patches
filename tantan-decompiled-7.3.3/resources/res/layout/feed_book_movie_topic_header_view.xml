<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.bookmovie.BookMovieTopicHeaderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/book_movie_container"
    android:background="@color/white"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="10dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.bookmovie.BookMovieTopicHeaderView">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar"
            android:layout_width="60dp"
            android:layout_height="80dp"
            fresco:actualImageScaleType="centerCrop"
            fresco:roundedCornerRadius="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/info_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:layout_toLeftOf="@+id/book_movie_comment"
            android:layout_toRightOf="@+id/avatar"
            android:layout_centerVertical="true">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:id="@+id/book_movie_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#80000000"
                android:ellipsize="end"
                android:id="@+id/book_movie_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="9dp"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/book_movie_user_count_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <ImageView
                    android:id="@+id/book_movie_ic"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="0x7f081c98"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:ellipsize="end"
                    android:id="@+id/book_movie_user_count_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/book_movie_comment"
            android:background="@drawable/feed_book_movie_comment_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.bookmovie.BookMovieTopicHeaderView>
