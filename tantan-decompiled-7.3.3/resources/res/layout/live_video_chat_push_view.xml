<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVideoChatPushView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="internal.vchat"
    holder="view.LiveVideoChatPushView">
    <p151v.VFrame
        android:id="@+id/big_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:id="@+id/mask_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <View
            android:id="@+id/top_mask"
            android:layout_width="match_parent"
            android:layout_height="140dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_mask"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:layout_gravity="top|right"
        android:id="@+id/small_layout"
        android:layout_width="90dp"
        android:layout_height="128dp"
        android:layout_marginTop="53dp"
        android:layout_marginEnd="14dp"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/small_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundedCornerRadius="10dp"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVideoChatPushView>
