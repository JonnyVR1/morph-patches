<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="330dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetUpgradeDialog">
    <View
        android:id="@+id/bg_view"
        android:background="@drawable/live_shape_voice_sweet_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="265dp"/>
    <View
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/bg_view"/>
    <p151v.VImage
        android:id="@+id/close_iv"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:src="0x7f082820"
        android:layout_alignParentRight="true"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/instuction_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="39dp"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08283b"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#f8591c"
            android:gravity="center"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:maxWidth="255dp"
            android:singleLine="true"
            android:fontFamily="PingFangSC-Medium"/>
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08283c"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#f8831c"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="25dp"
        android:layout_below="@+id/instuction_ll"
        android:fontFamily="PingFangSC-Regular"/>
    <p151v.VRecyclerView
        android:id="@+id/gift_recycle"
        android:layout_width="wrap_content"
        android:layout_height="111dp"
        android:layout_marginTop="27dp"
        android:layout_below="@+id/sub_title"
        android:layout_centerHorizontal="true"
        android:overScrollMode="never"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ok_btn"
        android:background="@drawable/live_shape_voice_sweet_btn_bg"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="@string/LIVE_VOICE_CP_CONFIRM"
        android:layout_below="@+id/gift_recycle"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSc-Medium"/>
</p151v.VRelative>
