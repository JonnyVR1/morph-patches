<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemGroupSubTitleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/group_subtitle"
    android:visibility="visible"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    flatten="true"
    folder="newui"
    holder="messages.itemview.ConversationItemGroupSubTitleView">
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/group_message_mute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        app:enableEmojis="true"
        app:typeface="regular"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/muted"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:src="0x7f0810c6"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/group_message_mute_dot"
        android:background="@drawable/core_group_message_mute_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginLeft="14dp"/>
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="0dp">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemGroupSubTitleView>
