<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.NewFilterBaseSetting xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="settings.filter.newui.NewFilterBaseSetting">
    <p151v.VListCell
        android:id="@+id/show_theme_card"
        android:visibility="gone"
        style="@style/core_newfilter_cell"/>
    <p151v.VFrame
        android:id="@+id/ideal_type_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        flatten="true">
        <p151v.VText
            android:text="我的理想型"
            style="@style/core_newfilter_subtitle"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ideal_type_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-8dp"
            android:src="0x7f0811ee"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/ideal_type_empty_view"
        android:background="@drawable/core_ideal_tag_add_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加"
            android:drawablePadding="4dp"
            android:drawableStart="0x7f0809db"
            style="@style/core_newfilter_value_tip"/>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.core.view.CommonLabelShowView
        android:id="@+id/ideal_tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:itemMaxLines_="3"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp">
        <p151v.VText
            android:text="@string/SETTINGS_AGE"
            style="@style/core_newfilter_subtitle"/>
        <TextView
            android:id="@+id/age_text"
            style="@style/core_newfilter_value_tip"/>
    </p151v.VFrame>
    <p151v.VRangeSlider
        android:id="@+id/show_ages"
        android:layout_marginTop="12dp"
        android:valueFrom="16"
        android:valueTo="50"
        style="@style/core_newfilter_slider"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp">
        <p151v.VText
            android:id="@+id/search_distance_title"
            android:text="@string/SETTINGS_DISTANCE"
            style="@style/core_newfilter_subtitle"/>
        <TextView
            android:id="@+id/distance_text"
            style="@style/core_newfilter_value_tip"/>
    </p151v.VFrame>
    <p151v.VSlider
        android:value="36"
        android:id="@+id/search_distance"
        android:layout_marginTop="12dp"
        android:valueFrom="0"
        android:valueTo="100"
        style="@style/core_newfilter_slider"/>
    <p151v.VListCell
        android:id="@+id/auto_distance"
        app:listcell_icon_left_small="0x7f0811f2"
        app:listcell_title="@string/SETTINGS_AUTO_DISTANCE_TITLE"
        app:listcell_title_color="@color/common_black_02"
        app:listcell_title_size="15sp"
        style="@style/core_newfilter_cell"/>
    <com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.FilterSwitchCell
        android:id="@+id/hidden"
        app:listcell_icon_left_small="0x7f0811e8"
        app:listcell_title="@string/SETTINGS_HIDDEN_MYSELF_DISTANCE"
        app:listcell_title_size="15sp"
        style="@style/core_newfilter_cell"/>
    <FrameLayout
        android:id="@+id/hidden_section"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        flatten="true">
        <p151v.VText
            android:text="@string/CORE_LIKED_USER_ACTION_BAR_DISTANCE"
            style="@style/core_newfilter_subtitle"/>
        <TextView
            android:layout_gravity="right"
            android:id="@+id/hidden_nearby_info"
            style="@style/core_newfilter_value_tip"/>
        <p151v.VSlider
            android:value="0"
            android:id="@+id/hidden_nearby_search"
            android:layout_marginTop="21dp"
            android:valueFrom="0"
            android:valueTo="100"
            style="@style/core_newfilter_slider"/>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:layout_marginTop="18dp"
            android:text="隐私管理"
            style="@style/core_newfilter_subtitle"/>
        <p151v.VListCell
            android:id="@+id/block_contact"
            android:visibility="gone"
            android:minHeight="56dp"
            app:listcell_title="屏蔽手机联系人"
            app:listcell_title_color="@color/common_black_02"
            app:listcell_title_size="15sp"
            style="@style/core_new_settings_cell"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/purpose_filter"
        android:background="@drawable/tf_rect_light"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:id="@+id/purpose_filter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="交友目的（可多选）"/>
        <com.p051p1.mobile.putong.core.p058ui.settings.filter.tags.TagContainerLayout
            android:id="@+id/purpose_filter_tags"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            app:column="3"
            app:horSpace="16dp"
            app:iscenter="true"
            app:verSpace="11dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#26000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="人数不足时，将自动扩大搜索范围"/>
    </p151v.VLinear>
    <p151v.VText
        android:layout_marginTop="18dp"
        android:text="@string/SETTINGS_SHOW_GENDER"
        style="@style/core_newfilter_subtitle"/>
    <com.p051p1.mobile.putong.core.p058ui.settings.filter.tags.TagContainerLayout
        android:id="@+id/gender_choose"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="9dp"
        app:column="3"
        app:horSpace="15dp"
        app:iscenter="true"
        app:verSpace="15dp"/>
    <p151v.VText
        android:id="@+id/location_title"
        android:text="@string/CORE_SVIP_ADVANCED_FILTER_ROAMING_MY_LOCATION_TITLE"
        style="@style/core_newfilter_subtitle"/>
    <p151v.VListCell
        android:id="@+id/my_location"
        app:listcell_component_right="@layout/core_newfilter_cell_location"
        app:listcell_title="@string/SETTINGS_LOCATION_TYPE_CURRENT"
        style="@style/core_newfilter_cell"/>
    <p151v.VListCell
        android:id="@+id/prioritized_recommend_student"
        app:listcell_title="@string/STUDENT_RECOMMEND_FIRST"
        style="@style/core_newfilter_cell"/>
    <View
        android:id="@+id/new_section_divider"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        style="@style/core_newfilter_divider"/>
    <p151v.VText
        android:id="@+id/new_section_location_title"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        android:text="@string/CORE_SVIP_ADVANCED_FILTER_ROAMING_MY_LOCATION_TITLE"
        style="@style/core_newfilter_subtitle"/>
    <p151v.VListCell
        android:id="@+id/new_section_my_location"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:listcell_component_right="@layout/core_newfilter_cell_location"
        app:listcell_title="@string/SETTINGS_LOCATION_TYPE_CURRENT"
        style="@style/core_newfilter_cell"/>
</com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.NewFilterBaseSetting>
