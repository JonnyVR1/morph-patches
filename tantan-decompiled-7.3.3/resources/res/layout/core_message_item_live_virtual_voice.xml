<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemLiveVirtualVoice xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemLiveVirtualVoice">
    <RelativeLayout
        android:background="@drawable/core_onlinematch_mess_header2_bg"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            app:roundedCornerRadius="@dimen/core_common_radius"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/image"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="@color/common_grey_03"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:layout_below="@+id/title"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/image"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemLiveVirtualVoice>
