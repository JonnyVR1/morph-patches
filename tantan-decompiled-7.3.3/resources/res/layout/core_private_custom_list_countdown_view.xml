<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.customized.result.PrivateCustomResultCountDownView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="customized.result.PrivateCustomResultCountDownView">
    <RelativeLayout
        android:background="0x7f081393"
        android:layout_width="match_parent"
        android:layout_height="114dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="4dp">
        <RelativeLayout
            android:id="@+id/rl_content"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#f9ecca"
                android:gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距下一次更新时间还有"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="0sp"/>
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="24dp"
                android:layout_below="@+id/title"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffdc9b"
                    android:gravity="center"
                    android:id="@+id/tv_hour"
                    android:background="0x7f081289"
                    android:paddingLeft="7dp"
                    android:paddingTop="1dp"
                    android:paddingRight="7dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:minHeight="24dp"
                    android:lineSpacingExtra="0sp"
                    android:lineHeight="21dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="#b3ffd78c"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="时"
                    android:layout_below="@+id/title"
                    android:lineSpacingExtra="0sp"
                    android:lineHeight="16.8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffdc9b"
                    android:gravity="center"
                    android:id="@+id/tv_minute"
                    android:background="0x7f081289"
                    android:paddingLeft="7dp"
                    android:paddingTop="1dp"
                    android:paddingRight="7dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:minWidth="32dp"
                    android:minHeight="24dp"
                    android:lineSpacingExtra="0sp"
                    android:lineHeight="21dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="#b3ffd78c"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="分"
                    android:layout_below="@+id/title"
                    android:lineSpacingExtra="0sp"
                    android:lineHeight="16.8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffdc9b"
                    android:gravity="center"
                    android:id="@+id/tv_second"
                    android:background="0x7f081289"
                    android:paddingLeft="7dp"
                    android:paddingTop="1dp"
                    android:paddingRight="7dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:minWidth="32dp"
                    android:minHeight="24dp"
                    android:lineSpacingExtra="0sp"
                    android:lineHeight="21dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="#b3ffd78c"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingTop="3dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="秒"
                    android:lineSpacingExtra="0sp"
                    android:lineHeight="16.8dp"/>
            </p151v.VLinear>
        </RelativeLayout>
        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="0x7f081790"
            android:layout_toLeftOf="@+id/rl_content"
            android:layout_alignTop="@+id/rl_content"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:src="0x7f081791"
            android:layout_toRightOf="@+id/rl_content"
            android:layout_alignTop="@+id/rl_content"/>
    </RelativeLayout>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="244dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:src="0x7f081394"
            android:scaleType="centerInside"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="为了你和定制对象更好的聊天体验，\10今天就推荐到这里吧"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.customized.result.PrivateCustomResultCountDownView>
