<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.travel.VoiceVirtualLoveTravelTwoPairView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/love_planet_team_two"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="231dp"
    flatten="true"
    holder="virtual.loveplanet.travel.VoiceVirtualLoveTravelTwoPairView">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-20dp">
        <include
            android:id="@+id/team_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_voice_virtual_call_love_travel_pair_item_view"/>
        <include
            android:id="@+id/team_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            layout="@layout/live_voice_virtual_call_love_travel_pair_item_view"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="104dp"
        layout="@layout/live_voice_virtual_call_love_travel_team_failed_line_view"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_single"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        flatten="true"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.travel.VoiceVirtualLoveTravelTwoPairView>
