<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/undercover_result"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.game.undercover.viewmodule.UndercoverResultView">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/result_win"
        android:layout_width="280dp"
        android:layout_height="130dp"
        android:layout_marginTop="-6dp"
        android:layout_centerHorizontal="true"
        app:clearsAfterStop="false"
        app:fillMode="Forward"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_below="@+id/result_win"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VRecyclerView
                android:layout_gravity="center_horizontal"
                android:id="@+id/result_normal_recycle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#daf4ff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/result_normal_word"
                android:background="@drawable/live_bg_black_r16_a20"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>
        <View
            android:id="@+id/vs"
            android:background="0x7f08234f"
            android:layout_width="36dp"
            android:layout_height="82dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="-4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VRecyclerView
                android:layout_gravity="center_horizontal"
                android:id="@+id/result_under_recycle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#daf4ff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/result_under_word"
                android:background="@drawable/live_bg_black_r16_a20"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1b4173"
        android:gravity="center"
        android:id="@+id/join_next_btn"
        android:background="@drawable/live_selector_bg_undercover_btn"
        android:visibility="gone"
        android:layout_width="178dp"
        android:layout_height="48dp"
        android:layout_marginBottom="22dp"
        android:text="@string/LIVE_ROOM_UNDERCOVER_RESULT_JOIN_NEXT"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</p151v.VRelative>
