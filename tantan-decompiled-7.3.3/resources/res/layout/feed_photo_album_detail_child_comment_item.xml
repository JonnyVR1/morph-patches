<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumCommentChildDetailsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="58dp"
    folder="newui"
    holder="photoalbum.PhotoAlbumCommentChildDetailsView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/pic_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                flatten="true">
                <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
                    android:id="@+id/pic_frame"
                    android:layout_width="34dp"
                    android:layout_height="34dp"/>
                <p151v.VImage
                    android:layout_gravity="bottom|right"
                    android:id="@+id/pic_verification"
                    android:background="0x7f081e18"
                    android:visibility="invisible"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:id="@+id/comment_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="30dp"
                app:layout_constraintLeft_toRightOf="@+id/pic_container"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/feed_nearby_topic_color"
                android:id="@+id/comment_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                app:enableEmojis="true"
                app:largeEmojis="true"
                app:layout_constraintLeft_toLeftOf="@+id/comment_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/comment_name"
                app:typeface="regular"/>
            <RelativeLayout
                android:id="@+id/sticker_content"
                android:background="@drawable/feed_comment_media_bg"
                android:visibility="gone"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:layout_constraintLeft_toLeftOf="@+id/comment_name"
                app:layout_constraintTop_toBottomOf="@+id/comment_text"
                flatten="false">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/sticker"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    app:actualImageScaleType="fitCenter"
                    app:fadeDuration="0"
                    app:failureImageScaleType="center"
                    app:placeholderImageScaleType="center"
                    app:roundedCornerRadius="10dp"/>
            </RelativeLayout>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="@color/feed_comment_reply_text_color"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintLeft_toLeftOf="@+id/comment_name"
                app:layout_constraintTop_toBottomOf="@+id/sticker_content"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="@color/feed_comment_reply_text_color"
                android:id="@+id/reply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/JOIN_REPLY"
                app:layout_constraintLeft_toRightOf="@+id/time"
                app:layout_constraintTop_toTopOf="@+id/time"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VFrame
            android:clipChildren="false"
            android:layout_width="52dp"
            android:layout_height="match_parent">
            <p151v.VRelative
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/like_count_container"
                android:layout_width="48dp"
                android:layout_height="40dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/like_indicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="0x7f081de3"
                    android:scaleType="fitCenter"
                    android:layout_centerHorizontal="true"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#cccccc"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/like_count"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_below="@+id/like_indicator"
                    android:layout_centerHorizontal="true"/>
            </p151v.VRelative>
        </p151v.VFrame>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumCommentChildDetailsView>
