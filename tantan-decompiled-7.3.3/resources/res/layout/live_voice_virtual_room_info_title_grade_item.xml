<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.VirtualRoomInfoTitleGradeItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="virtual.roomInfo.view.VirtualRoomInfoTitleGradeItem">
    <FrameLayout
        android:id="@+id/room_info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/top_bg"
            android:background="@drawable/live_shape_virtual_room_info_dialog_top_bg"
            android:layout_width="match_parent"
            android:layout_height="186dp"/>
        <p151v.VDraweeView
            android:id="@+id/cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="22dp"
            app:roundedCornerRadius="6dp"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginLeft="76dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="176dp"
            android:text="房间名称"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center_vertical"
            android:id="@+id/id_number"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginLeft="76dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="176dp"
            android:text="ID"/>
    </FrameLayout>
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="375dp"
        android:layout_height="186dp"
        android:layout_marginTop="16dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/iv_grade"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginEnd="37dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.VirtualRoomInfoTitleGradeItem>
