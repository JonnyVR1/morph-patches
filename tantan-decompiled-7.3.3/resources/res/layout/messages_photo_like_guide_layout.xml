<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.MessagePicLikeGuideLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_message_bar_input_bg"
    android:paddingLeft="16dp"
    android:paddingTop="15dp"
    android:paddingRight="15dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp"
    flatten="true"
    holder="messages.MessagePicLikeGuideLayout">
    <p151v.VFrame
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/tip_iv"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/messages_reference_pic_icon"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/break_ice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:text="他的照片"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:src="0x7f082894"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刚刚看过的照片"
            android:includeFontPadding="false"
            android:layout_marginStart="83dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e5000000"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="夸夸她，开启愉快的聊天吧"
            android:includeFontPadding="false"
            android:layout_marginStart="83dp"/>
    </p151v.VFrame>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/references_chat"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="引用聊聊"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/like"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="11dp"
            android:text="点赞"
            android:layout_weight="1"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.MessagePicLikeGuideLayout>
