<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/account_profile_example_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#de000000"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="29dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="17dp"
            android:text="@string/FAKE_ALERT_EXAMPLE_TITLE"/>
        <com.p051p1.mobile.putong.core.p058ui.growth.fakenew.MaxHeightScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </com.p051p1.mobile.putong.core.p058ui.growth.fakenew.MaxHeightScrollView>
        <p151v.VButton
            android:id="@+id/change"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="32dp"
            android:text="@string/FAKE_ALERT_EXAMPLE_UPLOAD"
            style="@style/common_button_large_01"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="end|top"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:src="0x7f0801ee"
        android:layout_marginEnd="8dp"/>
</p151v.VFrame>
