<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemMyTagsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    flatten="true"
    folder="newui"
    holder="poi.view.FeedPoiCardItemMyTagsView">
    <View
        android:background="@color/core_color_07000000"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="32dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:layout_marginBottom="12dp">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/core_text_e6000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/PROFILE_SECTION_HEADER_PERSONALITY"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/core_color_33000000"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/view_more"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看全部"
                android:layout_weight="0"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
            android:id="@+id/tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemMyTagsView>
