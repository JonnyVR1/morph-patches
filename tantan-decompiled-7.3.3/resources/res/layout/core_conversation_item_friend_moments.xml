<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemFriendMoments xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemFriendMoments">
    <p151v.VFrame
        android:layout_gravity="center"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="0x7f08088f"/>
        <FrameLayout
            android:layout_gravity="top|right"
            android:id="@+id/avatar_icon_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="-4dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.messages.anim.view.FriendsMomentAvatarView
                android:layout_gravity="center"
                android:id="@+id/anim_view"
                android:visibility="gone"
                android:layout_width="23dp"
                android:layout_height="23dp"/>
            <View
                android:id="@+id/background"
                android:background="@drawable/core_2dp_stroke_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </p151v.VFrame>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="好友动态"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="来看看好友们的最近动态"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/core_color_4d000000"
        android:id="@+id/look_over"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemFriendMoments>
