<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemFriendActiveRemindFemale xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemFriendActiveRemindFemale">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/core_messages_add_tag_artwork_bg"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fffe7e1d"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/warn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="他在等你回复"
            android:drawableLeft="@drawable/core_warn_wait_call_back"
            android:drawablePadding="4dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#33000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lines="1"
            android:layout_marginStart="8dp"
            app:autoEmojis="true"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemFriendActiveRemindFemale>
