<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.view.TopicBannerItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/banner_topic_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="view.TopicBannerItemView">
    <p151v.VRecyclerView
        android:id="@+id/topics_column"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:divider="@null"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <p151v.VRecyclerView
        android:id="@+id/topics_column_next"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="11dp"
        android:divider="@null"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</com.p051p1.mobile.putong.feed.newui.view.TopicBannerItemView>
