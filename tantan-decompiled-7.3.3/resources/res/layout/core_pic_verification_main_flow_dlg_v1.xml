<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:src="0x7f0805a6"
            android:scaleType="fitXY"/>
        <ImageView
            android:id="@+id/iv_user_gender"
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:src="0x7f0805a7"
            android:scaleType="center"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:text="试用“只看认证用户”"
        android:maxLines="2"
        android:layout_marginHorizontal="32dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:text="开启试用后，为你推荐10位已完成头像认证的用户"
        android:lineSpacingExtra="1.8dp"
        android:layout_marginHorizontal="32dp"/>
    <p151v.VButton
        android:ellipsize="end"
        android:id="@+id/popup_positive_btn"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:text="开始试用"
        android:lines="1"
        android:layout_marginHorizontal="32dp"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#33000000"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_change_avatar_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        android:text="取消"
        android:lines="1"
        android:layout_marginHorizontal="32dp"/>
</LinearLayout>
