<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.loop.house.ProfileLoopSelectHouseViewModel"
    innerClass="true">
    <p151v.VRelative
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24sp"
            android:textColor="#000000"
            android:id="@+id/first_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_below="@+id/first_title"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="7sp"/>
        <p151v.VFrame
            android:id="@+id/layout"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="57dp"
            android:layout_below="@+id/subtitle"
            android:paddingHorizontal="40dp"
            flatten="true">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/core_profile_pick_middle_bg"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                    android:layout_gravity="center"
                    android:id="@+id/main_wheel_center_house"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    aigestudio:wheel_atmospheric="true"
                    aigestudio:wheel_curtain="false"
                    aigestudio:wheel_curved="true"
                    aigestudio:wheel_cyclic="false"
                    aigestudio:wheel_item_text_color="#26000000"
                    aigestudio:wheel_selected_item_text_color="#e6000000"/>
                <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                    android:layout_gravity="center"
                    android:id="@+id/main_wheel_center_left"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    aigestudio:wheel_atmospheric="true"
                    aigestudio:wheel_curtain="false"
                    aigestudio:wheel_curved="true"
                    aigestudio:wheel_cyclic="false"
                    aigestudio:wheel_item_text_color="#d0d0d0"
                    aigestudio:wheel_selected_item_text_color="#e6000000"
                    aigestudio:wheel_visible_item_count="5"/>
                <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                    android:layout_gravity="center"
                    android:id="@+id/main_wheel_center_right"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    aigestudio:wheel_atmospheric="true"
                    aigestudio:wheel_curtain="false"
                    aigestudio:wheel_curved="true"
                    aigestudio:wheel_cyclic="false"
                    aigestudio:wheel_item_text_color="#d0d0d0"
                    aigestudio:wheel_item_text_size="18sp"
                    aigestudio:wheel_selected_item_text_color="#212121"
                    aigestudio:wheel_visible_item_count="5"/>
            </p151v.VLinear>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#999999"
            android:gravity="center_vertical"
            android:id="@+id/footer_text"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="仅填写了此项信息的人可看到你的选择"
            android:layout_below="@+id/layout"
            android:lineSpacingExtra="1sp"
            android:paddingHorizontal="40dp"/>
        <include
            android:id="@+id/photo_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_below="@+id/footer_text"
            layout="@layout/core_profile_edit_upload_img_view"/>
    </p151v.VRelative>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/action_view"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        layout="@layout/core_profile_loop_edit_action_layout"/>
</FrameLayout>
