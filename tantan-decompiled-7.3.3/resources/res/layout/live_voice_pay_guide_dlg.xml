<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.payGuide.LiveVoicePayGuideBottomDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:flatten="true"
    holder="virtual.payGuide.LiveVoicePayGuideBottomDialog">
    <View
        android:id="@+id/view_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/live_bg_191919_tr24"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <FrameLayout
            android:id="@+id/img_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            app:flatten="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/gift_icon"
                android:layout_width="55dp"
                android:layout_height="55dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonAnimMaskAvatarView
                android:layout_gravity="center_vertical"
                android:id="@+id/room_avatars"
                android:background="@drawable/live_vector_default_avatar_bg"
                android:layout_width="55dp"
                android:layout_height="55dp"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="8dp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/live_tag"
            android:background="@drawable/live_bg_44a7ff_r5"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="你的礼物"
            android:maxEms="6"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/img_layout"
            app:layout_constraintStart_toStartOf="@+id/img_layout"
            app:layout_constraintTop_toTopOf="@+id/img_layout"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:text="送出你的礼物吧"
            android:singleLine="true"
            android:layout_marginStart="10dp"
            app:layout_constraintLeft_toRightOf="@+id/img_layout"
            app:layout_constraintRight_toLeftOf="@+id/settle_start"
            app:layout_constraintTop_toTopOf="@+id/img_layout"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="@color/live_white_40_opacity"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/sbu_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:text="为房间增加热度"
            android:singleLine="true"
            android:layout_marginStart="10dp"
            app:layout_constraintLeft_toRightOf="@+id/img_layout"
            app:layout_constraintRight_toLeftOf="@+id/settle_start"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/settle_start"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="52dp"
            android:layout_height="34dp"
            android:text="送礼"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.virtual.payGuide.LiveVoicePayGuideBottomDialog>
