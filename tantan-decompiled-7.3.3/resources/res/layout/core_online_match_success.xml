<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.NewOnlineMatchSuccessItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.NewOnlineMatchSuccessItem">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_bg_online_match_success"
        android:paddingTop="32dp"
        android:paddingBottom="27dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <p151v.VRelative
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VFrame
                android:id="@+id/fra_left_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VFrame
                    android:layout_width="82dp"
                    android:layout_height="106dp"
                    android:rotation="-16"
                    android:layout_marginEnd="65dp">
                    <p151v.VDraweeView
                        android:id="@+id/left_head"
                        android:background="@drawable/core_online_match_head_bg"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:cropToPadding="false"
                        app:roundWithOverlayColor="@color/white"
                        app:roundedCornerRadius="10dp"/>
                </p151v.VFrame>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/fra_right_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VFrame
                    android:layout_width="82dp"
                    android:layout_height="106dp"
                    android:rotation="16"
                    android:layout_marginStart="65dp">
                    <p151v.VDraweeView
                        android:id="@+id/right_head"
                        android:background="@drawable/core_online_match_head_bg"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:cropToPadding="false"
                        app:roundedCornerRadius="10dp"/>
                </p151v.VFrame>
            </p151v.VFrame>
        </p151v.VRelative>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="解锁成功"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#919393"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:text="现在是关系升温的最好时机，继续聊聊吧"
            android:layout_marginHorizontal="20dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.NewOnlineMatchSuccessItem>
