<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.MusicAggregateAct">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/music_aggregate_recycle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <RelativeLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/music_aggregate_same_music"
        android:background="@drawable/music_aggregate_same_background"
        android:layout_width="114dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:id="@+id/music_aggregate_same_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FEED_CAPTURE_USE_SAME_MUSIC"
            android:drawableLeft="0x7f082917"
            android:drawablePadding="4dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        flatten="true">
        <ImageView
            android:id="@+id/music_aggregate_back"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0802b4"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/music_aggregate_favor"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f082919"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/music_aggregate_action_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        flatten="true">
        <ImageView
            android:id="@+id/music_aggregate_back_dark"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f082921"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp">
            <TextView
                android:textSize="17sp"
                android:textColor="#383e46"
                android:layout_gravity="center"
                android:id="@+id/music_aggregate_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#383e46"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/music_aggregate_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/music_aggregate_favor_dark"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f082920"/>
    </FrameLayout>
</FrameLayout>
