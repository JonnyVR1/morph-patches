<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.poi.view.FeedPoiGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.poi.view.FeedPoiGuideView">
    <RelativeLayout
        android:id="@+id/content_rl"
        android:background="@drawable/feed_poi_guide_view_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/poi_ic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f081e25"
            android:layout_centerVertical="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/info_content_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/right_arrow_ic"
            android:layout_toRightOf="@+id/poi_ic"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/feed_cc000000"
                android:ellipsize="end"
                android:id="@+id/poi_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点亮足迹"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/feed_4d000000"
                android:ellipsize="end"
                android:id="@+id/poi_guide_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"/>
        </p151v.VLinear>
        <p151v.VImage
            android:id="@+id/right_arrow_ic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="20dp"
            android:src="0x7f081e29"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.poi.view.FeedPoiGuideView>
