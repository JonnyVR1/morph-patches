<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_bg_white_tr24"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.exp.ExpTagGuidePhotoBottomSheet">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f080340"
        android:layout_marginEnd="16dp"/>
    <p151v.VImage
        android:id="@+id/title_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="40dp"
        android:src="0x7f0807d5"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="22sp"
        android:textColor="@color/common_exp_black_01"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="选择标签，添加生活照"
        android:layout_marginStart="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_exp_black_03"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:text="根据你添加过的标签，向你推荐"
        android:layout_marginStart="40dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="264dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="60dp">
        <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
            android:id="@+id/tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</p151v.VLinear>
