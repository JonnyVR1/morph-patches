<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="newui"
    holder="topic.qatopic.QATopicPhotoAlbumFeedFragViewModel">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true"
        useId="true">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:id="@+id/appbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            flatten="true">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:collapsedTitleTextAppearance="@style/TextAppearance.AppCompat.Title"
                app:contentScrim="@color/transparent"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:titleEnabled="false"
                flatten="true">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                    <p151v.VRelative
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <p151v.VImage
                            android:id="@+id/tool_bar_back"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginLeft="8dp"
                            android:src="0x7f081f07"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="@color/feed_e6000000"
                            android:ellipsize="end"
                            android:id="@+id/title_name"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="20dp"
                            android:lines="1"
                            android:layout_toLeftOf="@+id/official_topic_info"
                            android:layout_toRightOf="@+id/tool_bar_back"
                            android:layout_centerVertical="true"/>
                        <p151v.VLinear
                            android:gravity="center_vertical"
                            android:id="@+id/official_topic_info"
                            android:background="@drawable/feed_qa_official_topic_bg_oval"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginRight="12dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#4c000000"
                                android:layout_gravity="center"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/FEED_TANTAN_TOPIC"/>
                        </p151v.VLinear>
                    </p151v.VRelative>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <p151v.VRelative
            android:id="@+id/layout_info"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/layout_head_topic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="6dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/topic_head_image"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerCrop"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@color/white"
                    app:placeholderImageScaleType="centerInside"
                    app:roundedCornerRadius="12dp"
                    style="@style/feed_fresco_base"/>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/feed_e6000000"
                        android:ellipsize="end"
                        android:id="@+id/topic_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/common_grey_03"
                        android:id="@+id/moment_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"/>
                </p151v.VLinear>
            </p151v.VLinear>
            <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
                android:id="@+id/topic_value_expandable_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/layout_head_topic"
                app:expandText="@string/DISCOVER_MOMENT_SPREAD"
                app:expandTextCanClick="true"
                app:maxCollapsedLines="2">
                <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                    android:textSize="14sp"
                    android:textColor="@color/feed_e6000000"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_orange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
            </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
            <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedVoteContainer
                android:orientation="vertical"
                android:id="@+id/vote_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/topic_value_expandable_text"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/enter_contain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/vote_view"
                android:layout_marginStart="12dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/group_contain"
                    android:background="@drawable/feed_group_topic_enter_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <p151v.VImage
                        android:id="@+id/group_enter_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081d1d"
                        android:layout_marginStart="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="@color/feed_nearby_topic_color"
                        android:id="@+id/group_enter_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="200dp"
                        android:singleLine="true"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/group_enter_icon"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <p151v.VImage
                        android:id="@+id/group_enter_icon_right"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081d22"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/group_enter_tv"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/topic_user_contain"
                    android:background="@drawable/feed_group_topic_enter_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <include
                        android:id="@+id/user_header_view"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/feed_header_enter_view"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="@color/feed_nearby_topic_color"
                        android:id="@+id/topic_user_enter_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="400dp"
                        android:singleLine="true"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/user_header_view"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <p151v.VImage
                        android:id="@+id/topic_user_icon_right"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081d22"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/topic_user_enter_tv"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <p151v.VLine
                android:id="@+id/layout_info_bottom_line"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="26dp"
                android:layout_marginRight="14dp"
                android:layout_below="@+id/enter_contain"/>
        </p151v.VRelative>
        <com.p051p1.mobile.putong.feed.newui.topic.topicplugin.FeedTopicContentWithPluginView
            android:id="@+id/topic_moments_and_plugin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <p151v.VFrame
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_for_new_ui"
        android:background="@drawable/feed_profile_buttons_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/feed_post_tv_confirm_color"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/attend_topic"
            android:background="@drawable/feed_topic_aggregation_bg_btn_orange_small"
            android:paddingLeft="20dp"
            android:paddingTop="13dp"
            android:paddingRight="20dp"
            android:paddingBottom="13dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:maxWidth="295dp"
            android:minWidth="180dp"
            android:text="@string/FEED_POST_THOUGHT"/>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQATopicInputJoinView
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/input_comment_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedChangeQATopicInputJoinView
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/input_comment_view_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/moment_upload_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/feed_qa_topic_moment_post_bar"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/no_network_rl"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/no_network_back_fl"
            android:background="#6e757575"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/no_network_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:src="0x7f0802b4"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/no_network_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            flatten="true">
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081e8e"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#d0d0d0"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="21dp"
                android:layout_marginRight="40dp"
                android:text="@string/FEED_LOAD_FAILED"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#bfbfbf"
                android:gravity="center"
                android:id="@+id/retry_network"
                android:background="@drawable/feed_qa_topic_no_network_bg"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="17dp"
                android:text="@string/FEED_CLICK_RETRY"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
