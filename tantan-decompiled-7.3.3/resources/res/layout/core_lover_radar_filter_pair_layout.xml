<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.loveradar.LoveRadarFilterPairedUserViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VFrame
            android:layout_gravity="bottom"
            android:background="@drawable/core_love_radar_filter_pair_bottom_shadow"
            android:layout_width="match_parent"
            android:layout_height="150dp">
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|right"
                android:id="@+id/next"
                android:background="@drawable/common_button_btn_orange_medium"
                android:layout_width="66dp"
                android:layout_height="44dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="12dp"/>
        </p151v.VFrame>
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_loading"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            app:cpb_color="@color/tantan_orange"
            app:cpb_stroke_width="6dp"/>
    </p151v.VFrame>
</p151v.VLinear>
