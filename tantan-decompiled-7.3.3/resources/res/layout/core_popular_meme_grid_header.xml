<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#d0d0d0"
        android:gravity="center"
        android:id="@+id/tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="搜索结果由闪萌提供"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tip_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="150dp">
        <p151v.VImage
            android:background="0x7f081522"
            android:layout_width="220dp"
            android:layout_height="150dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#d0d0d0"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/STICKERS_NO_RESULTS"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#d0d0d0"
        android:gravity="center"
        android:id="@+id/tip_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/ERROR_NETWORK"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#d0d0d0"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/core_popular_meme_refresh_btn_bg"
        android:visibility="gone"
        android:layout_width="123dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:text="@string/STICKERS_REFRESH"/>
</LinearLayout>
