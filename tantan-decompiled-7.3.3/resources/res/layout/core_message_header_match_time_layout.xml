<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.view.MessageMatchTimeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/match_container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="view.MessageMatchTimeLayout">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/invite_container"
        android:background="@drawable/core_message_header_match_time_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="12dp"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/invite_image"
            android:layout_width="15dp"
            android:layout_height="15dp"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="13sp"
            android:textColor="#4d000000"
            android:id="@+id/invite_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/single_container"
        android:background="@drawable/core_message_header_match_time_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:paddingHorizontal="12dp"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/single_image"
            android:layout_width="15dp"
            android:layout_height="15dp"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="13sp"
            android:textColor="#4d000000"
            android:id="@+id/single_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/double_container"
        android:background="@drawable/core_message_header_match_time_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="12dp"
        android:minHeight="34dp"
        android:paddingHorizontal="12dp"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/double_image_1"
            android:layout_width="15dp"
            android:layout_height="15dp"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:id="@+id/double_image_2"
            android:background="@drawable/core_message_header_match_time_icon_bg"
            android:padding="1.5dp"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginStart="-5dp"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="13sp"
            android:textColor="#4d000000"
            android:id="@+id/double_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"
            android:textFontWeight="500"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.view.MessageMatchTimeLayout>
