<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.intl.gift.IntlGiftComboView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="230dp"
    android:layout_height="230dp"
    folder="intl"
    holder="gift.IntlGiftComboView">
    <include
        android:id="@+id/giftCountdownView"
        android:visibility="visible"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_intl_gift_count_down_view"/>
    <include
        android:id="@+id/giftGears"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_gift_dialog_gears_layer_view"/>
    <include
        android:id="@+id/small"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="31dp"
        android:layout_marginStart="44dp"
        app:layout_constraintStart_toStartOf="@+id/giftCountdownView"
        app:layout_constraintTop_toTopOf="@+id/giftCountdownView"
        layout="@layout/live_intl_gift_multiple_item_view"/>
    <include
        android:id="@+id/middle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="@+id/giftCountdownView"
        app:layout_constraintStart_toStartOf="@+id/giftCountdownView"
        app:layout_constraintTop_toTopOf="@+id/giftCountdownView"
        layout="@layout/live_intl_gift_multiple_item_view"/>
    <include
        android:id="@+id/large"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="13dp"
        android:layout_marginBottom="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/giftCountdownView"
        app:layout_constraintStart_toStartOf="@+id/giftCountdownView"
        layout="@layout/live_intl_gift_multiple_item_view"/>
    <View
        android:id="@+id/coin_text_bg"
        android:background="@drawable/live_bg_black_lr14_a50"
        android:layout_width="107dp"
        android:layout_height="22dp"
        android:layout_marginRight="60dp"
        android:layout_marginBottom="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/giftCountdownView"
        app:layout_constraintRight_toRightOf="@+id/giftCountdownView"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ff8100"
        android:gravity="center"
        android:id="@+id/coin_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:drawablePadding="4dp"
        android:drawableStart="0x7f082359"
        app:layout_constraintBottom_toBottomOf="@+id/coin_text_bg"
        app:layout_constraintLeft_toLeftOf="@+id/coin_text_bg"
        app:layout_constraintRight_toRightOf="@+id/coin_text_bg"
        app:layout_constraintTop_toTopOf="@+id/coin_text_bg"/>
</com.p051p1.mobile.putong.live.livingroom.intl.gift.IntlGiftComboView>
