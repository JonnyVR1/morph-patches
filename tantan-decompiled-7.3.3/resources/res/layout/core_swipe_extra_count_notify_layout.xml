<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <p151v.VFrame
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="12dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar_img"
            android:layout_width="28dp"
            android:layout_height="28dp"
            fresco:roundAsCircle="true"/>
        <p151v.VImage
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/core_swipe_extra_count_ic"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="7dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="14dp"
            android:textColor="@color/common_000000_80"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:text="认证权益生效中"/>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="@color/common_000000_40"
            android:id="@+id/extra_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="17dp"
            android:text="今日已右滑100次，因为你完成认证，可继续发送喜欢"/>
    </p151v.VLinear>
</p151v.VLinear>
