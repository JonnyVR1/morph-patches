<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.verification.remind.result.CoreAvatarVerificationFailLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="verification.remind.result.CoreAvatarVerificationFailLayout">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_avatar_fail_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <p151v.VLinear
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <p151v.VImage
                android:layout_width="50dp"
                android:layout_height="10dp"
                android:src="@drawable/core_avatar_detail_flag_left"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                android:textSize="13dp"
                android:textColor="@color/common_000000_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:text="认证攻略"/>
            <p151v.VImage
                android:layout_width="50dp"
                android:layout_height="10dp"
                android:src="@drawable/core_avatar_detail_flag_right"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <p151v.VFrame
                android:layout_width="78dp"
                android:layout_height="96dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/avatar_img1"
                    android:layout_width="78dp"
                    android:layout_height="96dp"
                    fresco:actualImageScaleType="centerCrop"
                    fresco:roundBottomLeft="true"
                    fresco:roundBottomRight="true"
                    fresco:roundTopLeft="true"
                    fresco:roundTopRight="true"
                    fresco:roundedCornerRadius="10dp"/>
                <p151v.VText
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/core_avatar_fail_simple_tips_bg"
                    android:layout_width="52dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="五官清晰"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_width="78dp"
                android:layout_height="96dp"
                android:layout_marginLeft="8dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/avatar_img2"
                    android:layout_width="78dp"
                    android:layout_height="96dp"
                    fresco:actualImageScaleType="centerCrop"
                    fresco:roundBottomLeft="true"
                    fresco:roundBottomRight="true"
                    fresco:roundTopLeft="true"
                    fresco:roundTopRight="true"
                    fresco:roundedCornerRadius="10dp"/>
                <p151v.VText
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/core_avatar_fail_simple_tips_bg"
                    android:layout_width="52dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="光线明亮"/>
            </p151v.VFrame>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tip_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="33dp"
            android:layout_marginBottom="20dp"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="15dp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="认证权益"/>
</com.p051p1.mobile.putong.core.p058ui.verification.remind.result.CoreAvatarVerificationFailLayout>
