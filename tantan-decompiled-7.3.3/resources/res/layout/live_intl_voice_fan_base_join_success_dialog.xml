<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/live_black_30_opacity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/dialog_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <p151v.VDraweeView
            android:id="@+id/background"
            android:background="@drawable/live_bg_19191e_r24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="20dp"/>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:background="0x7f082391"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="36dp"
                android:layout_marginRight="32dp">
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:layout_gravity="center"
                    android:id="@+id/medal"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"/>
            </FrameLayout>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="24dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_WELCOME"
                android:maxLines="1"
                android:singleLine="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/live_white_50_opacity"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/member_num_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="24dp"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/bottom_button"
                android:background="@drawable/live_bg_ff58bc_r16"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="32dp">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_CONFIRM"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </FrameLayout>
</p151v.VLinear>
