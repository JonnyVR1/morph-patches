<?xml version="1.0" encoding="utf-8"?>
<p151v.VScroll xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    flatten="true"
    holder="marry.profile.loop.mate.MarryEditProfileMateViewModel">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VText
            android:textSize="24sp"
            android:textColor="#cc000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="理想伴侣"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="关于理想伴侣，我希望他...\10(预期过高，可能无法匹配到合适的人)"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="40dp"
            android:paddingEnd="32dp">
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/mate_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="婚恋状态"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/mate_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="年龄"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/mate_qualification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="学历"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/mate_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="身高"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/mate_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="年收入"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/mate_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="是否接受异地"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/input_layout"
            android:background="@drawable/core_marry_edit_input_bg"
            android:paddingLeft="16dp"
            android:paddingTop="20dp"
            android:paddingRight="16dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp"
            flatten="true">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#cc000000"
                android:textColorHint="#26000000"
                android:gravity="top|left"
                android:id="@+id/input_text"
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="我喜欢他..."
                android:lines="6"
                android:maxLength="300"
                android:textCursorDrawable="@drawable/core_message_input_cursor"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#26000000"
                android:layout_gravity="end"
                android:id="@+id/max_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/stencil_layout"
            android:background="@drawable/core_marry_edit_input_stencil_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp"
            flatten="true">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#66000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="参考模版"
                android:drawableLeft="@drawable/core_input_stencil_icon"
                android:drawablePadding="2dp"
                app:typeface="medium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#4d000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="希望你是一个有责任心有主见的人，工作稳定，情绪稳定，最好未来有在杭州长期发展的计划。生活上愿意共同分担家务，最好不抽烟，可以接受偶尔和朋友喝点酒"/>
        </p151v.VLinear>
        <View
            android:layout_width="0dp"
            android:layout_height="7dp"/>
    </p151v.VLinear>
</p151v.VScroll>
