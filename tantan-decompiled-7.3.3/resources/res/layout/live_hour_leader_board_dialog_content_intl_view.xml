<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.intl.HourBoardDialogContentIntlView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="leaderboard.hourleaderboard.intl.HourBoardDialogContentIntlView">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="158dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_title_bar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.view.DialogTitleBar
        android:id="@+id/dialog_title_bar"
        android:background="0x7f08231c"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:background="@color/live_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title_bar"/>
    <View
        android:id="@+id/shadow"
        android:background="0x7f082315"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/own"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/shadow"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        layout="@layout/live_hour_list_item"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.intl.HourBoardDialogContentIntlView>
