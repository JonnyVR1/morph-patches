<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.other.liveend.LiveEndDataItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="12dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        android:text="0"/>
</com.p051p1.mobile.putong.live.livingroom.other.liveend.LiveEndDataItemView>
