<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemRightBtnView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/right_btn"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginRight="12dp"
    folder="newui"
    holder="messages.itemview.ConversationItemRightBtnView">
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_03"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/txt"
        android:background="@drawable/common_view_card_small_01_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="@string/CORE_SVIP_RECOVER_UNMATCH_BUTTON_REMATCH"
        app:enableEmojis="true"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/recover_match"
        android:background="@drawable/core_limited_trial_see_conversation_recover_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:paddingHorizontal="8dp"
        app:enableEmojis="true"
        app:typeface="medium"/>
    <p151v.VImage
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/red_dot"
        android:background="@drawable/core_kankan_red_dot_bg"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"/>
</com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemRightBtnView>
