<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="415dp"
    attachToRoot="true"
    folder="intl.common"
    holder="IntlMediaNoticeSettingView">
    <p151v.VFrame
        android:id="@+id/live_notice"
        android:visibility="gone"
        style="@style/live_core_settings_stacked_frame">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:text="@string/LIVE_INTL_SETTING_NOTIFICATION_LIVE"
            style="@style/live_core_settings_header1"/>
        <p151v.VSwitch style="@style/live_core_settings_item_switch"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/voice_notice"
        android:visibility="gone"
        style="@style/live_core_settings_stacked_frame">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:text="@string/LIVE_INTL_SETTING_NOTIFICATION_AUDIO"
            style="@style/live_core_settings_header1"/>
        <p151v.VSwitch style="@style/live_core_settings_item_switch"/>
    </p151v.VFrame>
</merge>
