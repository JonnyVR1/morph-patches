<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    folder="ui"
    holder="lovebuzz.widget.MediaBuzzCallControlView">
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/add_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:default_icon="0x7f080af2"
        app:default_text="@string/INTL_BUZZ_VIDEO_CALLING_ADDTIME"
        app:icon_width="215dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/add_time_count"
        android:background="@drawable/core_intl_love_buzz_red_dot_with_stroke_video"
        android:padding="5dp"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:maxLines="1"
        android:layout_marginStart="190dp"
        app:layout_constraintBottom_toBottomOf="@+id/add_time"
        app:layout_constraintStart_toStartOf="@+id/add_time"
        app:typeface="medium"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/quit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="15dp"
        app:default_icon="0x7f080afe"
        app:default_text="@string/INTL_BUZZ_VIDEO_CALLING_EXIT"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/add_time"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="16dp"
        app:default_icon="0x7f080b02"
        app:default_text="@string/INTL_BUZZ_VIDEO_CALLING_LIKE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/add_time"/>
</merge>
