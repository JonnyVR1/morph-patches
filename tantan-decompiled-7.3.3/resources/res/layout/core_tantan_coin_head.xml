<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/live"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/LIVE_TITLE"
        app:typeface="medium"/>
    <include
        android:id="@+id/live_anchor_level"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/live_my_level"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/live_income"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/live_bill"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/red_packets_records"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/refund"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/trade"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <include
        android:id="@+id/diamond_trade"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        layout="@layout/core_tantan_coin_head_item"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/CORE_PRIVILEGE_PAY"
        app:typeface="medium"/>
</LinearLayout>
