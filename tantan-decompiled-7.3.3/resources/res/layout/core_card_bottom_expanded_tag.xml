<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomTagExpandedLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomTagExpandedLayout">
    <FrameLayout
        android:id="@+id/card_bottom_upper_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        flatten="true">
        <include
            android:id="@+id/card_bottom_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_card_bottom_expanded_basic_info"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/card_bottom_lower_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="60dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_60percent_FFFFFF"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:text="我的兴趣标签"
                android:shadowColor="@color/common_light_02"
                android:shadowDx="1"
                android:shadowDy="1"
                android:lineSpacingExtra="0sp"
                app:typeface="regular"/>
            <com.p051p1.mobile.putong.core.view.CardLabelShowView
                android:id="@+id/labelshowview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomTagExpandedLayout>
