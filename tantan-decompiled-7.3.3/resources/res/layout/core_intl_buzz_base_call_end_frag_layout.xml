<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_end_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="lovebuzz.common.BaseBuzzCallEndFrag">
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/call_end_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:text="@string/INTL_BUZZ_VIDEO_ENDING_TITLE"
        android:maxLines="1"
        android:maxEms="8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/core_color_80ffffff"
        android:gravity="center"
        android:id="@+id/call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_end_title"/>
    <p151v.VDraweeView
        android:id="@+id/vb_peer_avatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/call_duration"
        app:placeholderImage="0x7f080b0a"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderWidth="2dp"/>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/vb_peer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:maxLines="1"
        android:maxEms="8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vb_peer_avatar"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/vb_peer_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="8dp"
        app:layout_constraintEnd_toEndOf="@+id/vb_peer_avatar"
        app:layout_constraintStart_toStartOf="@+id/vb_peer_avatar"
        app:layout_constraintTop_toBottomOf="@+id/vb_peer_name"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/call_back"
        android:background="@drawable/core_intl_video_buzz_back_btn_selector"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="54dp"
        android:text="@string/INTL_BUZZ_END_BUTTON1"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/continue_call"
        app:layout_constraintStart_toStartOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/continue_call"
        android:background="@drawable/core_intl_buzz_next_btn_bg"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="54dp"
        android:text="@string/INTL_BUZZ_END_BUTTON2"
        android:maxLines="1"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/call_back"
        app:typeface="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
