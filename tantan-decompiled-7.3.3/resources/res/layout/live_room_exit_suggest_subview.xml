<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.roomsuggest.view.LiveRoomSuggestSubView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="40dp">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/back_arrow"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:src="0x7f08234a"
            android:scaleType="center"
            android:layout_marginStart="20dp"/>
        <p151v.VText
            android:textSize="21sp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </p151v.VLinear>
    <p151v.VRecyclerView
        android:id="@+id/subcontainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/desc"
        android:layout_marginStart="8dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.roomsuggest.view.LiveRoomSuggestSubView>
