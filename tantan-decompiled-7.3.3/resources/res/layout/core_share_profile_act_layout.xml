<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="profile.ShareProfileActViewModel">
    <ScrollView
        android:id="@+id/share_view_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_profile_info"
            android:background="@drawable/core_bg_share_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/share_ab_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VLinear
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="6dp">
                <p151v.VText
                    android:textSize="26sp"
                    android:textColor="#e6000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/name"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:singleLine="true"
                    app:typeface="medium"
                    style="@style/core_card_text"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:textColor="#e6000000"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"/>
            </p151v.VLinear>
            <p151v.VText
                android:id="@+id/my_information_title"
                android:paddingBottom="16dp"
                android:text="@string/PROFILE_INFO"
                style="@style/profile_item_title_black_no_bg"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/zodiac_type_wrap"
                android:background="@drawable/tf_rect_light"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:id="@+id/zodiac_type_tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/PROFILE_ZODIAC"
                    android:layout_weight="2"
                    style="@style/profile_item_item_new_edit_ab"/>
                <p151v.VText
                    android:id="@+id/zodiac_type"
                    android:paddingLeft="0dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/PROFILE_ZODIAC"
                    android:layout_weight="3"
                    style="@style/profile_item_item_new_edit_ab"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/industry_wrap"
                android:background="@drawable/tf_rect_light"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:layout_gravity="top"
                    android:id="@+id/industry_tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/PROFILE_INFO_INDUSTRY"
                    android:layout_weight="2"
                    style="@style/profile_item_item_new_edit_ab"/>
                <p151v.VText
                    android:id="@+id/industry"
                    android:paddingLeft="0dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/PROFILE_INFO_INDUSTRY_PLACEHOLDER"
                    android:layout_weight="3"
                    style="@style/profile_item_item_new_edit_ab"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/hometown_wrap"
                android:background="@drawable/tf_rect_light"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:layout_gravity="top"
                    android:id="@+id/hometown_tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/PROFILE_INFO_HOMETOWN"
                    android:layout_weight="2"
                    style="@style/profile_item_item_new_edit_ab"/>
                <p151v.VText
                    android:id="@+id/hometown"
                    android:paddingLeft="0dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/PROFILE_INFO_HOMETOWN_PLACEHOLDER"
                    android:layout_weight="3"
                    style="@style/profile_item_item_new_edit_ab"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/hangouts_wrap"
                android:background="@drawable/tf_rect_light"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:layout_gravity="top"
                    android:id="@+id/hangouts_tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/PROFILE_INFO_HANGOUTS"
                    android:layout_weight="2"
                    style="@style/profile_item_item_new_edit_ab"/>
                <p151v.VText
                    android:id="@+id/hangouts"
                    android:paddingLeft="0dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/PROFILE_INFO_HANGOUTS_PLACEHOLDER"
                    android:layout_weight="3"
                    style="@style/profile_item_item_new_edit_ab"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/about_me_wrap"
                android:background="@drawable/tf_rect_light"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:layout_gravity="top"
                    android:id="@+id/about_me_tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="个人签名"
                    android:layout_weight="2"
                    style="@style/profile_item_item_new_edit_ab"/>
                <p151v.VText
                    android:id="@+id/about_me"
                    android:paddingLeft="0dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    style="@style/profile_item_item_new_edit_ab"/>
            </LinearLayout>
        </p151v.VLinear>
    </ScrollView>
    <View
        android:background="#4c000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VRelative
        android:background="@drawable/core_bg_share_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="分享给好友"
            android:layout_centerHorizontal="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_wechat_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_marginStart="20dp">
            <p151v.VImage
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f08077c"/>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="#99000000"
                android:gravity="center"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="微信"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_wechat_friend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_toRightOf="@+id/ll_wechat_share"
            android:layout_marginStart="20dp">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f080780"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#99000000"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="朋友圈"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_save_pic"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_toRightOf="@+id/ll_wechat_friend"
            android:layout_marginStart="15dp">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f08077a"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#99000000"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存至相册"/>
        </p151v.VLinear>
        <View
            android:id="@+id/view_line"
            android:background="#f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="170dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#51000000"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="取消"
            android:layout_below="@+id/view_line"
            app:typeface="medium"/>
    </p151v.VRelative>
</p151v.VRelative>
