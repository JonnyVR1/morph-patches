<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.KtvSuggestViewModel xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="284dp">
    <p151v.VDraweeView
        android:id="@+id/shadow"
        android:layout_width="275dp"
        android:layout_height="264dp"
        android:layout_marginTop="30dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white_90_opacity"
        android:gravity="center_vertical"
        android:layout_gravity="right"
        android:id="@+id/refresh"
        android:background="@drawable/live_bg_black_r6_a15"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="换一批"
        android:drawablePadding="5dp"
        android:drawableStart="0x7f0823a3"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white_90_opacity"
        android:gravity="center_vertical"
        android:id="@+id/tv_choose"
        android:background="@drawable/live_bg_black_r6_a15"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginRight="8dp"
        android:text="点歌"
        android:drawablePadding="5dp"
        android:drawableStart="0x7f0827c7"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintRight_toLeftOf="@+id/refresh"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggest_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="34dp"
        android:layout_marginRight="9dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.KtvSuggestViewModel>
