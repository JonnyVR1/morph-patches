<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.VoiceSquareThemeBFeedCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:background="@drawable/live_shape_voice_square_card_theme_b_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <include
        android:id="@+id/frame_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_intl_square_frame_view"/>
    <p151v.VDraweeView
        android:id="@+id/left_top_tag"
        android:layout_width="42dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/member_container"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"/>
    <FrameLayout
        android:id="@+id/tag_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        flatten="true">
        <p151v.VLinear
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/tag"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_90_opacity"
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Party"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"/>
        </p151v.VLinear>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/member_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        flatten="true"/>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/member_container"
        app:layout_constraintRight_toRightOf="@+id/member_container"
        app:layout_constraintTop_toTopOf="@+id/member_container"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/member_count"
        android:background="@drawable/live_shape_voice_topic_black_theme_b_count_bg"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="20dp"
        android:minHeight="20dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintLeft_toRightOf="@+id/space"
        app:layout_constraintTop_toTopOf="@+id/space"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_70_opacity"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toRightOf="@+id/member_count"
        app:layout_constraintRight_toRightOf="@+id/avatar"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.VoiceSquareThemeBFeedCardView>
