<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/discount_hero_content"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="0dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <p151v.AutoVDraweeView
            android:id="@+id/discount_percent_art"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:actualImageScaleType="fitCenter"/>
        <p151v.VText_NoTopPadding
            android:textSize="18sp"
            android:textColor="@color/core_intl_premium_discount_gold_primary"
            android:gravity="center"
            android:id="@+id/discount_exclusive_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            app:fontWeight="600"/>
        <p151v.VText_NoTopPadding
            android:textSize="18sp"
            android:textColor="@color/core_intl_premium_discount_gold_primary"
            android:gravity="center"
            android:id="@+id/discount_sub_line1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:lineSpacingMultiplier="1.2"
            app:fontWeight="600"/>
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textColor="@color/core_intl_premium_discount_hero_subline_40"
            android:gravity="center"
            android:id="@+id/discount_sub_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:fontWeight="400"/>
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textColor="@color/core_intl_premium_discount_countdown_title"
            android:gravity="center"
            android:id="@+id/discount_expires_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:lineSpacingMultiplier="1.3"
            app:fontWeight="500"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/discount_countdown_laurel_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <p151v.VImage
                android:id="@+id/discount_countdown_laurel_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080b7c"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:maxHeight="44dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/discount_countdown_row"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="0dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VText_NoTopPadding
                        android:textSize="30sp"
                        android:textColor="@color/common_white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/discount_countdown_h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        app:fontWeight="600"/>
                </FrameLayout>
                <p151v.VImage
                    android:id="@+id/discount_countdown_colon_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:src="0x7f080b7b"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginHorizontal="8dp"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VText_NoTopPadding
                        android:textSize="30sp"
                        android:textColor="@color/common_white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/discount_countdown_m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        app:fontWeight="600"/>
                </FrameLayout>
                <p151v.VImage
                    android:id="@+id/discount_countdown_colon_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:src="0x7f080b7b"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginHorizontal="8dp"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VText_NoTopPadding
                        android:textSize="30sp"
                        android:textColor="@color/common_white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/discount_countdown_s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        app:fontWeight="600"/>
                </FrameLayout>
            </LinearLayout>
            <p151v.VImage
                android:id="@+id/discount_countdown_laurel_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080b7d"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:maxHeight="44dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
