<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.doublecard.LiveDoublePanelCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="@dimen/live_square_item_base_margin"
    android:layout_marginEnd="@dimen/live_square_item_base_margin">
    <View
        android:id="@+id/static_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon_view"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="10dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/live_black_80_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/live_black_40_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.doublecard.LiveDoublePanelCardView>
