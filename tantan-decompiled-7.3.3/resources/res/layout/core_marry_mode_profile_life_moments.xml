<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personal_protrait"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    flatten="true"
    folder="newui.home.marrymode.holder"
    holder="ImageLifeMomentsViewHolder">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VFrame
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,3:4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/preview_action_root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                flatten="true">
                <View
                    android:id="@+id/action_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:id="@+id/action_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </p151v.VLinear>
            <include
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/profile_picture_item"/>
            <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
                android:id="@+id/image_indicator"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                app:indicatorColor="#33ffffff"
                app:indicatorMargin="3dp"
                app:indicatorSelectedColor="@color/white"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </p151v.VFrame>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VFrame>
