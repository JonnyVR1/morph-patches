<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#999999"
        android:id="@+id/header_text"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_FOLLOW_PUSH_NOTICE_HEADER"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <p151v.VRelative
            android:gravity="center"
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_FOLLOW_PUSH_NOTICE_EMPTY"
                android:layout_centerInParent="true"/>
        </p151v.VRelative>
    </FrameLayout>
    <p151v.VButton
        android:textSize="16dp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/bottom_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="@string/LIVE_FOLLOW_PUSH_NOTICE_CLOSE_ALL"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</p151v.VLinear>
