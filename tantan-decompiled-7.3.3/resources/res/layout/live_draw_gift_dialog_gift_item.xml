<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.drawgift.DrawRecycleItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="125dp"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.drawgift.DrawRecycleItem">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/unSelect"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/img"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/select"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/img1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:id="@+id/name1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/price1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#80ffffff"
            android:gravity="center"
            android:id="@+id/send"
            android:background="@drawable/live_bg_white_r12_a20"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:text="@string/LIVE_GIFT_SUIT_SEND"
            android:letterSpacing="0"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.drawgift.DrawRecycleItem>
