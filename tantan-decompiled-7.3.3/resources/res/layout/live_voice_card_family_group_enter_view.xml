<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.UserCardFamilyGroupView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    folder="voice.usercard.view"
    holder="UserCardFamilyGroupView">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <p151v.VFrame
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <p151v.VDraweeView
            android:id="@+id/icon2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:roundedCornerRadius="10dp"/>
    </p151v.VFrame>
    <p151v.VMarqueeText
        android:textSize="12sp"
        android:ellipsize="marquee"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VMarqueeText
        android:textSize="10sp"
        android:ellipsize="marquee"
        android:id="@+id/subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="2dp"
        android:text="@string/LIVE_VOICE_MEDAL_WALL"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.UserCardFamilyGroupView>
