<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveSquareVoiceCompanionDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="widgets.LiveSquareVoiceCompanionDialogView">
    <com.p051p1.mobile.putong.live.base.view.LiveHaloAvatar
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar"
        android:layout_width="122dp"
        android:layout_height="122dp"
        android:layout_marginTop="44dp"
        app:avatarSize="98dp"
        app:haloEndColor="#ffa87cff"
        app:haloSize="122dp"
        app:haloStartColor="#ffd67aff"
        app:innerStrokeWidth="6dp"
        app:outerStrokeWidth="5dp"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_80"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="10"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/common_black_01"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_000000_40"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/LIVE_INVITE_YOU_TO_JUMP_ROOM"
        android:lineSpacingMultiplier="1.2"/>
    <p151v.VButton
        android:id="@+id/btn_positive"
        android:layout_marginTop="32dp"
        android:text="@string/LIVE_GO_AND_SEE"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_04"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_negative"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/LIVE_VOICE_CRUEL_REFUSED"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveSquareVoiceCompanionDialogView>
