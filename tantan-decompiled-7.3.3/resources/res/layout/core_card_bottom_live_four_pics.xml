<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VDraweeView
            android:id="@+id/image_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="false"
            app:roundedCornerRadius="10dp"
            style="@style/core_card_bottom_live_pic_small"/>
        <p151v.VDraweeView
            android:id="@+id/image_two"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="false"
            app:roundTopRight="true"
            app:roundedCornerRadius="10dp"
            style="@style/core_card_bottom_live_pic_small"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VDraweeView
            android:id="@+id/image_three"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:roundBottomLeft="true"
            app:roundBottomRight="false"
            app:roundTopLeft="false"
            app:roundTopRight="false"
            app:roundedCornerRadius="10dp"
            style="@style/core_card_bottom_live_pic_small"/>
        <p151v.VDraweeView
            android:id="@+id/image_four"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:roundBottomLeft="false"
            app:roundBottomRight="true"
            app:roundTopLeft="false"
            app:roundTopRight="false"
            app:roundedCornerRadius="10dp"
            style="@style/core_card_bottom_live_pic_small"/>
    </p151v.VLinear>
</p151v.VLinear>
