<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_share_dialog"
    android:layout_width="match_parent"
    android:layout_height="227dp"
    android:layout_alignParentBottom="true">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:id="@+id/share_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/CHAT_GROUP_SHARE"
        android:layout_centerHorizontal="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_wechat_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="77dp"
        android:layout_marginTop="58dp">
        <p151v.VImage
            android:id="@+id/wx_img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="0x7f0809de"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#99000000"
            android:gravity="center"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/CHAT_GROUP_WECHAT"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_save_pic"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:layout_marginRight="77dp"
        android:layout_alignParentRight="true">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/save_img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="0x7f0809dd"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#99000000"
            android:gravity="center"
            android:id="@+id/save_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/CHAT_GROUP_SAVE_ALBUM"/>
    </p151v.VLinear>
    <View
        android:id="@+id/view_line"
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="154dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#51000000"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/ACTION_CANCEL"
        android:layout_below="@+id/view_line"
        app:typeface="medium"/>
</p151v.VRelative>
