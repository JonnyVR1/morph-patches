<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="311dp"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f0814b4"
        android:scaleType="fitXY"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#323232"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="寻找以结婚为目的的理想伴侣"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/sub_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:text="你刚刚将交友目的更改为想结婚，切换到想结婚模式可以更快找到理想伴侣"
        android:layout_marginHorizontal="32dp"/>
    <p151v.VButton
        android:id="@+id/action"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:text="切换模式"
        android:layout_marginHorizontal="32dp"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#33000000"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:text="暂不切换"/>
</p151v.VLinear>
