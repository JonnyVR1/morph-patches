<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.module.PkInviteModule">
    <View
        android:id="@+id/empty"
        android:background="#22000000"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_tr8"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="288dp">
        <FrameLayout
            android:layout_gravity="center"
            android:background="0x7f08246e"
            android:layout_width="112dp"
            android:layout_height="80dp"
            android:layout_marginTop="-16dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/avatar"
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:roundAsCircle="true"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#ffbb00"
                android:gravity="center_horizontal"
                android:id="@+id/tv_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="#212121"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="96dp"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/age"
                android:paddingLeft="3dp"
                android:paddingTop="0.5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_fans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#f36c4e"
            android:layout_gravity="center"
            android:id="@+id/pk_again_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="12dp">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#212121"
                android:gravity="center"
                android:id="@+id/reject"
                android:background="@drawable/live_shape_pk_seek_button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="@string/LIVE_REFUSE"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/accept"
                android:background="@drawable/live_bg_fe7e1d_r16"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="@string/LIVE_ACCEPT"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_decline_status"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f082436"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_gravity="center_vertical"
                android:id="@+id/no_invite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_NOT_ACCEPT_INVITE_TODAY"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
