<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.main.LocationPermissionView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="main.LocationPermissionView">
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="93dp"
        android:src="0x7f082875"
        android:scaleType="fitXY"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="#d34530"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/GET_LOCATION_TITLE"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/describe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/LOCATION_PERMISSION_DESCRIPTION"
        android:lineSpacingExtra="2dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/setting_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/LOCATION_PERMISSION_SETTING_STEP"/>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:textSize="16sp"
        android:textColor="@color/account_buttons"
        android:layout_gravity="center_horizontal"
        android:id="@+id/setting"
        android:background="@drawable/rect_tantan_orange_login"
        android:layout_width="264dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:text="@string/PERMISSION_PAGE_GET_PERMISSION_FROM_SETTING"
        style="@style/v_button"/>
</com.p051p1.mobile.putong.core.p058ui.main.LocationPermissionView>
