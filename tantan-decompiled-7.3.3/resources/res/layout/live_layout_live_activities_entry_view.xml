<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesEntryView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="afterDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="widgets.LiveActivitiesEntryView">
    <p151v.VFrame
        android:id="@+id/content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        flatten="true">
        <include
            android:layout_gravity="end|bottom"
            android:id="@+id/content_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_layout_activities_entry_all"/>
        <include
            android:layout_gravity="end|bottom"
            android:id="@+id/content_sign_in"
            android:visibility="gone"
            android:layout_width="140dp"
            android:layout_height="62dp"
            layout="@layout/live_layout_activities_sign_in"/>
        <include
            android:layout_gravity="end|bottom"
            android:id="@+id/content_start_live"
            android:visibility="gone"
            android:layout_width="104dp"
            android:layout_height="43dp"
            layout="@layout/live_layout_entrance_start_view"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/badge_text"
        android:background="@drawable/live_shape_bg_activities_red_dot_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:minWidth="26dp"
        android:minHeight="26dp"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"/>
    <p151v.VImage
        android:id="@+id/badge_red_dot"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="10dp"
        android:layout_marginStart="3dp"
        app:srcCompat="@drawable/live_shape_circle_red_dot"/>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesEntryView>
