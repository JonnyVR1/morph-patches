<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/certain"
        android:paddingTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="210dp"
        android:layout_height="match_parent">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_left"
            android:background="0x7f082a87"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="8dp"
            android:layout_width="84dp"
            android:layout_height="102dp"
            android:layout_marginLeft="-30dp"
            android:layout_marginTop="-2dp"
            android:layout_marginStart="-30dp"
            app:roundedCornerRadius="5dp"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_right"
            android:background="0x7f082a87"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="8dp"
            android:layout_width="84dp"
            android:layout_height="102dp"
            android:layout_marginTop="-2dp"
            android:layout_marginRight="-30dp"
            android:rotation="15"
            android:layout_marginEnd="-30dp"
            app:roundedCornerRadius="5dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="-46dp"
            android:src="0x7f082a9a"/>
    </FrameLayout>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/uncertain"
        android:layout_width="210dp"
        android:layout_height="@dimen/vip_alert_dynamic_content_height"
        android:src="0x7f082a95"/>
</FrameLayout>
