<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/crop_linear"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.p051p1.mobile.putong.core.p058ui.profile.exp.ExpEditProfileImageCardGroup
        android:id="@+id/reorders"
        android:paddingLeft="24dp"
        android:paddingTop="0dp"
        android:paddingRight="16dp"
        android:paddingBottom="0dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardNums="6"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.photo.AvatarCards
        android:id="@+id/avatar_card"
        android:paddingLeft="24dp"
        android:paddingTop="0dp"
        android:paddingRight="16dp"
        android:paddingBottom="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardNums="6"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_exp_black_03"
        android:gravity="center"
        android:id="@+id/low_alert"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/USER_INFO_CHECK_PROFILE_HINT_TITLE"
        android:drawablePadding="10dp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.exp.ExpEditDividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/publicId"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/common_exp_black_01"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/pic_post_text"
            android:paddingLeft="20dp"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:text="@string/FEED_PIC_SHARE"
            android:layout_weight="1"
            app:typeface="medium"/>
        <p151v.VSwitchButton
            android:layout_gravity="center_vertical"
            android:id="@+id/pic_post_switch"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:checked="false"
            app:VSwitchActiveColor="@color/common_exp_theme_color"
            app:VSwitchThumbHeight="18dp"
            app:VSwitchThumbMargin="6dp"
            app:VSwitchThumbWidth="18dp"/>
    </p151v.VLinear>
</p151v.VLinear>
