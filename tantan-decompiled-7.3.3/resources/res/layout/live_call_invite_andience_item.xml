<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/iv_head"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"
        fresco:actualImageScaleType="centerCrop"
        fresco:failureImage="@drawable/live_vector_default_avatar_bg"
        fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
        fresco:roundAsCircle="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginLeft="16dp"
        android:layout_toRightOf="@+id/iv_head"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#212121"
                android:ellipsize="end"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxEms="6"
                android:singleLine="true"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_age"
                android:background="@drawable/live_bg_85b9f2_r2"
                android:paddingLeft="1dp"
                android:layout_width="30dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                android:drawableLeft="0x7f08246f"
                android:drawablePadding="1dp"
                android:fontFamily="sans-serif-medium"/>
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/user_level"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                fresco:actualImageScaleType="fitXY"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_invite"
        android:background="@drawable/live_shape_ff3a00_gradient_r6"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
