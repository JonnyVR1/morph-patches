<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    flatten="true"
    holder="voice.chat.VoiceChatItemMenu">
    <ImageView
        android:id="@+id/arrow"
        android:background="@drawable/live_shape_voice_menu_arrow_bg"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="-7dp"
        android:layout_alignBottom="@+id/menu_btn_group"
        android:rotation="45"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menu_btn_group"
        android:background="@drawable/live_bg_212121_r8"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="182dp"
        android:layout_height="wrap_content"
        android:divider="#0dffffff"
        android:showDividers="middle"
        android:dividerPadding="2dp"
        flatten="true">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvCopy"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="复制"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvReply"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="回复"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvRepot"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="举报"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
