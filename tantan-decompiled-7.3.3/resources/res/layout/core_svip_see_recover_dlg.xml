<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.SVipSeeRecoverDlg xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="dlg.SVipSeeRecoverDlg">
    <View
        android:id="@+id/offline_dlg_bg"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="208dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="有13人喜欢了你"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#66000000"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:text="SVIP会员已过期，立刻解锁谁喜欢我，重新获得10倍配对"
            android:layout_marginHorizontal="32dp"/>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/primary"
            android:background="@drawable/core_svip_see_recover_dlg_button_bg"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:text="查看谁喜欢我"
            android:fontFamily="sans-serif"
            android:layout_marginHorizontal="32dp"
            app:typeface="medium"
            style="@style/common_button_large_01"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_04"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp"
            android:text="先划卡"
            android:layout_marginHorizontal="32dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.dlg.SVipSeeRecoverDlg>
