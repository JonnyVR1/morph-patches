<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemTagGuide xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:paddingLeft="32dp"
    android:paddingTop="10dp"
    android:paddingRight="32dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="32dp"
    flatten="true"
    holder="messages.ItemTagGuide">
    <RelativeLayout
        android:background="@drawable/core_messages_tag_guide_bg"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:id="@+id/left_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="0x7f081862"
            android:layout_centerVertical="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/left_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="60dp">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/core_color_cc000000"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="他邀请你添加标签"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_66000000"
                android:ellipsize="end"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="完善标签找到更多话题！"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Regular"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/complete"
            android:background="@drawable/core_messages_tag_guide_button_unselect_bg"
            android:paddingLeft="12dp"
            android:paddingTop="7dp"
            android:paddingRight="12dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加"
            android:layout_centerVertical="true"
            android:fontFamily="PingFangSC-Medium"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemTagGuide>
