<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.CallWidgetView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/live_callect_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="multiplayerchat.view.CallWidgetView">
    <p151v.VRelative
        android:orientation="horizontal"
        android:id="@+id/user_layout"
        android:background="@drawable/live_bg_black_r12_a20"
        android:paddingTop="10dp"
        android:clipChildren="false"
        android:layout_width="166dp"
        android:layout_height="match_parent">
        <include
            android:id="@+id/item_3"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            layout="@layout/live_call_widget_item"/>
        <include
            android:id="@+id/item_2"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            layout="@layout/live_call_widget_item"/>
        <include
            android:id="@+id/item_1"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_alignParentLeft="true"
            layout="@layout/live_call_widget_item"/>
    </p151v.VRelative>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp">
        <ImageView
            android:id="@+id/close"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:src="0x7f082271"/>
        <ImageView
            android:id="@+id/minimize"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f082272"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.CallWidgetView>
