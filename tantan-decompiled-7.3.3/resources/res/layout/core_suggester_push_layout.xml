<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingVertical="16dp">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/core_default_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/core_default_avatar"
        app:placeholderImageScaleType="centerCrop"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:id="@+id/online"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="0x7f081595"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/core_color_cc000000"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lines="1"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/button"
        android:background="@drawable/core_push_button_bg_orange"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VText
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/emoji"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/color_text_ffffff"
            android:gravity="center"
            android:id="@+id/text"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </p151v.VLinear>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f081586"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
