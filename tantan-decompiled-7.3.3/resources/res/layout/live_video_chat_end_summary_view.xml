<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/live_bg_white_tr24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="internal.vchat"
    holder="end.LiveVChatEndAct">
    <p151v.VImage
        android:id="@+id/report"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f0826de"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="22dp"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="通话结束"
        android:layout_marginStart="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="22dp"
        android:textColor="#cc000000"
        android:id="@+id/duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="本次通话时长"
        android:layout_marginStart="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#33000000"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="请评价本次的通话体验"
        android:layout_marginStart="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration_text"/>
    <View
        android:id="@+id/unsatisfied_layout"
        android:background="@drawable/live_bg_black_r10_a03"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="24dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/general_layout"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <ImageView
        android:id="@+id/unsatisfied_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:src="0x7f082697"
        app:layout_constraintLeft_toLeftOf="@+id/unsatisfied_layout"
        app:layout_constraintRight_toRightOf="@+id/unsatisfied_layout"
        app:layout_constraintTop_toTopOf="@+id/unsatisfied_layout"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/live_black_30_opacity"
        android:id="@+id/unsatisfied_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="不满意"
        app:layout_constraintLeft_toLeftOf="@+id/unsatisfied_layout"
        app:layout_constraintRight_toRightOf="@+id/unsatisfied_layout"
        app:layout_constraintTop_toBottomOf="@+id/unsatisfied_image"/>
    <View
        android:id="@+id/general_layout"
        android:background="@drawable/live_bg_black_r10_a03"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@+id/unsatisfied_layout"
        app:layout_constraintRight_toLeftOf="@+id/satisfied_layout"
        app:layout_constraintTop_toTopOf="@+id/unsatisfied_layout"/>
    <ImageView
        android:id="@+id/general_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:src="0x7f082693"
        app:layout_constraintLeft_toLeftOf="@+id/general_layout"
        app:layout_constraintRight_toRightOf="@+id/general_layout"
        app:layout_constraintTop_toTopOf="@+id/general_layout"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/live_black_30_opacity"
        android:id="@+id/general_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="一般"
        app:layout_constraintLeft_toLeftOf="@+id/general_layout"
        app:layout_constraintRight_toRightOf="@+id/general_layout"
        app:layout_constraintTop_toBottomOf="@+id/general_image"/>
    <View
        android:id="@+id/satisfied_layout"
        android:background="@drawable/live_bg_black_r10_a03"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginRight="40dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@+id/general_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/general_layout"/>
    <ImageView
        android:id="@+id/satisfied_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:src="0x7f082695"
        app:layout_constraintLeft_toLeftOf="@+id/satisfied_layout"
        app:layout_constraintRight_toRightOf="@+id/satisfied_layout"
        app:layout_constraintTop_toTopOf="@+id/satisfied_layout"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/live_black_30_opacity"
        android:id="@+id/satisfied_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="满意"
        app:layout_constraintLeft_toLeftOf="@+id/satisfied_layout"
        app:layout_constraintRight_toRightOf="@+id/satisfied_layout"
        app:layout_constraintTop_toBottomOf="@+id/satisfied_image"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="20dp"
        android:text="完成"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unsatisfied_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
