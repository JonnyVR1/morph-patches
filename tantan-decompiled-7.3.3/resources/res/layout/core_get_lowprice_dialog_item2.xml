<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecallGetSurpriseItem2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="327dp"
    android:layout_height="wrap_content"
    holder="pricerecall.PriceRecallGetSurpriseItem2">
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f080775"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:src="0x7f080774"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VText_AutoFit
            android:textSize="15sp"
            android:textColor="#212121"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:typeface="medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_orange"
                android:id="@+id/deadline"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:lineSpacingExtra="1sp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/core_vip_normal_subtitle_text_color"
                android:ellipsize="end"
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/price_layout"
        android:background="@drawable/core_lowprice_item_tag_bg_new"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginRight="30dp"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="#efb134"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_centerHorizontal="true"
            app:typeface="medium"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#efb134"
            android:gravity="center"
            android:id="@+id/select_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CORE_PRICERECALL_DISCOUNT_PRICE_COUPON"
            android:layout_below="@+id/price"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecallGetSurpriseItem2>
