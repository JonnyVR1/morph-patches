<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="gift.giftwallnew.category.LiveGiftCategoryDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@color/live_19191e"
        android:layout_width="match_parent"
        android:layout_height="630dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="274dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bg"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        app:layout_constraintTop_toTopOf="@+id/bg"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="皮肤图鉴"
            app:layout_constraintBottom_toTopOf="@+id/sub_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f0822f2"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/live_white_05_opacity"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bg">
        <p151v.VLinear
            android:id="@+id/mini_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            flatten="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_all"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_light"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已点亮"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_dark"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未点亮"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </p151v.VLinear>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/empty_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="0x7f0823e0"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center_horizontal"
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="24dp"
                android:text="尚未收到礼物，快去收集吧"/>
        </LinearLayout>
        <p151v.VRecyclerView
            android:id="@+id/allRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <p151v.VRecyclerView
            android:id="@+id/lightRecyclerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <p151v.VRecyclerView
            android:id="@+id/darkRecyclerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
