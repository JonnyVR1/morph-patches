<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.seepage.likers.IntlFakeLikersItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="215dp"
    android:layout_margin="4dp"
    app:sl_cornerRadius="0dp"
    app:sl_shadowColor="#00000000"
    app:sl_shadowRadius="0dp"
    holder="seepage.likers.IntlFakeLikersItem">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <View
        android:background="@drawable/fakelikers_head_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fra_desc"
        android:background="@drawable/core_vip_superlike_game_item_shadaow"
        android:layout_width="match_parent"
        android:layout_height="93dp"
        flatten="true">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/user_desc_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/user_desc_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/user_active_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:maxLines="1"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.seepage.likers.IntlFakeLikersItem>
