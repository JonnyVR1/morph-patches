<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="ui"
    holder="messages.meme.CoreMyCustomMemeViewModel">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parent"
        android:background="@drawable/core_message_popular_meme_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        flatten="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <p151v.VImage
                    android:id="@+id/cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:src="0x7f081374"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/core_color_cc000000"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/STICKERS_MY_STICKER"
                    android:layout_centerInParent="true"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/core_color_cc000000"
                    android:id="@+id/manage_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:text="@string/CHAT_GROUP_MEMBER_MANAGE_OPERATE"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/common_orange"
                    android:id="@+id/done_top"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:text="@string/STICKERS_ADDED"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <GridView
            android:id="@+id/grid"
            android:background="#ffffff"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:id="@+id/add_btn_layout"
            android:background="#ffffff"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/add_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/STICKERS_ADD"
                style="@style/common_button_small_01"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/manage_layout"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/core_color_cc000000"
                android:layout_gravity="center"
                android:id="@+id/move_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/STICKERS_MOVE_TO_FRONT"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/common_orange"
                android:layout_gravity="center"
                android:id="@+id/delete_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/STICKERS_DELETE"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:typeface="medium"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
