<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.picks.view.PicksItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/liked_user_item_info_bg"
    android:padding="0.5dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    holder="vip.picks.view.PicksItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <p151v.VRelative
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_card_user_text_color_b2ffffff"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_above="@+id/name"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:minHeight="20dp"
            android:lines="1"
            android:layout_toLeftOf="@+id/action_btn"
            android:layout_alignLeft="@+id/age"
            android:layout_alignParentBottom="true"/>
        <p151v.VImage
            android:id="@+id/action_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginBottom="8dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            app:srcCompat="0x7f080d3e"/>
    </p151v.VRelative>
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/verification_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>
    <View
        android:id="@+id/mask"
        android:background="@drawable/core_svip_liked_user_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/core_fresco_base"/>
</com.p051p1.mobile.putong.core.p058ui.vip.picks.view.PicksItemView>
