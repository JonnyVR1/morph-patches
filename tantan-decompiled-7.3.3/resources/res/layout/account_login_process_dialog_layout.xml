<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="278dp">
    <p151v.VButton
        android:id="@+id/bt_process_continue_opt"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="50dp"
        android:text="同意并继续"
        android:layout_alignParentBottom="true"
        style="@style/common_button_large_01"/>
    <p151v.VImage
        android:id="@+id/iv_process_close"
        android:padding="5dp"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginRight="17dp"
        android:src="0x7f0803cb"
        android:layout_alignParentRight="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_grey_04"
        android:textColorHighlight="@color/transparent"
        android:textColorLink="@color/welcome_privacy_link"
        android:id="@+id/tv_process_privacy_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"
        android:text="《用户协议》和《隐私策略》"
        android:layout_below="@+id/iv_process_title"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="#010101"
        android:gravity="left"
        android:id="@+id/iv_process_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="40dp"
        android:text="请阅读并同意以下条款"/>
</p151v.VRelative>
