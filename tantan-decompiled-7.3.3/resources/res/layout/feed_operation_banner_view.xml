<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.moments.operation.OperationBannerFeedView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="#ffffff"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="moments.operation.OperationBannerFeedView">
    <androidx.cardview.widget.CardView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="5dp"
        app:cardElevation="0dp">
        <p151v.AspectRatioViewPager
            android:layout_gravity="center_horizontal"
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ratio="3.8"/>
    </androidx.cardview.widget.CardView>
    <p151v.VPagerCircleIndicator
        android:layout_gravity="bottom"
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        app:fillColor="#ff6f49"
        app:pageColor="#eaeaea"
        app:radius="3dp"/>
</com.p051p1.mobile.putong.feed.p065ui.moments.operation.OperationBannerFeedView>
