<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/layoutrootview"
    android:background="@color/core_intl_premium_discount_page_bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_gravity="top"
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/close"
                android:padding="6dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="0x7f08152c"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="#ffedd6a3"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="60dp"
                android:maxLines="1"
                android:layout_marginHorizontal="60dp"
                app:fontWeight="500"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/title_img"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080bca"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/discount_content_container"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
