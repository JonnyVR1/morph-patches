<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.VipIntroPageBlock xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.VipIntroPageBlock">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_grey_01"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="20dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="fitCenter"
        app:actualImageScaleType="fitCenter"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_digest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_01"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="18dp"
        android:maxLines="2"
        android:lineSpacingExtra="3sp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.VipIntroPageBlock>
