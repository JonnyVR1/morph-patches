<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/core_bg_special_like_new"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="20dp"
    app:elevation="20dp">
    <p151v.VImage
        android:id="@+id/uew_user_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f081186"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/new_user_like_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="19dp"
        android:maxWidth="226dp"
        android:text="@string/SWIPE_SHE_LIKES_NEW_MALE"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/new_user_like_sub_tip"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/uew_user_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#bfffffff"
        android:ellipsize="end"
        android:id="@+id/new_user_like_sub_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="19dp"
        android:maxWidth="226dp"
        android:text="@string/SWIPE_NO_REMIND_AFTER_MATCH"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/new_user_like_tip"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_user_like_tip"/>
</androidx.constraintlayout.widget.ConstraintLayout>
