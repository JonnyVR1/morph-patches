<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemBlindBoxGuideView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content"
    android:paddingLeft="32dp"
    android:paddingTop="15dp"
    android:paddingRight="32dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="32dp"
    flatten="true"
    holder="messages.ItemBlindBoxGuideView">
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_msg_text_tips_text_color"
        android:gravity="center"
        android:id="@+id/text"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="3dp"/>
    <RelativeLayout
        android:id="@+id/entrancne"
        android:background="@drawable/core_bg_14_f9f9f9"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingVertical="16dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/left_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="0x7f080ebd"
            android:layout_centerVertical="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/left_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="60dp">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/core_color_cc000000"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi Party盲盒派对"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_66000000"
                android:ellipsize="end"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="有趣的灵魂在这里相遇"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Regular"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/button"
            android:background="@drawable/core_messages_tag_guide_button_unselect_bg"
            android:paddingLeft="12dp"
            android:paddingTop="9dp"
            android:paddingRight="12dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去拆盒"
            android:layout_centerVertical="true"
            android:fontFamily="PingFangSC-Medium"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemBlindBoxGuideView>
