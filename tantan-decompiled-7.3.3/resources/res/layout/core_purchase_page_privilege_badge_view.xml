<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.page.PurchasePrivilegeBadgeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="purchase.page.PurchasePrivilegeBadgeView">
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/avatar_area"
        android:background="0x7f08183a"
        android:layout_width="90dp"
        android:layout_height="90dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="68dp"
            android:layout_height="68dp"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/vip_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="0x7f0818ea"/>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/vip_badge"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginTop="1dp"
            android:src="0x7f08183b"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.page.PurchasePrivilegeBadgeView>
