<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/publicId"
    holder="profile.profilelist.itemholders.ProfilePublicIdItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VText
        android:id="@+id/tantan_id_title"
        android:text="@string/PROFILE_SECTION_HEADER_ACCOUNT"
        style="@style/profile_item_title"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/tantan_id_text"
        android:paddingLeft="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/PROFILE_ACCOUNT_TANTANID"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_03"
        android:gravity="center_vertical"
        android:id="@+id/tantan_id_number"
        android:paddingLeft="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:typeface="regular"/>
</p151v.VLinear_Dividers>
