<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="#00000000"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.redpacket.RedPacketRecordViewModel">
    <RelativeLayout
        android:id="@+id/red_packet_record_layout"
        android:background="@color/white"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <RelativeLayout
            android:id="@+id/title_bar_layout"
            android:background="#f15645"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <RelativeLayout
                android:id="@+id/title_layout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/back_image"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="0x7f081621"
                    android:scaleType="center"/>
            </RelativeLayout>
        </RelativeLayout>
        <p151v.VImage
            android:id="@+id/title_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f081620"
            android:scaleType="fitXY"
            android:layout_below="@+id/title_bar_layout"/>
        <p151v.VRecyclerView
            android:id="@+id/red_packet_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/title_image"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/bg_close_layout_all"
        android:background="@color/core_red_packet_record_transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/red_packet_layout"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        flatten="true">
        <RelativeLayout
            android:id="@+id/top_view"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            flatten="true">
            <View
                android:id="@+id/bottom_bg_view"
                android:background="0x7f08161c"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_alignParentBottom="true"/>
            <View
                android:id="@+id/top_bg_view"
                android:background="0x7f08161e"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="84dp"/>
            <RelativeLayout
                android:id="@+id/text_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                flatten="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/title_user_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginTop="80dp"
                    android:layout_marginRight="28dp"
                    android:layout_centerHorizontal="true"
                    flatten="true">
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/user_image"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        fresco:actualImageScaleType="centerCrop"
                        fresco:failureImage="@drawable/placeholder_profile_small"
                        fresco:failureImageScaleType="center"
                        fresco:placeholderImage="@drawable/placeholder_profile_small"
                        fresco:placeholderImageScaleType="center"
                        fresco:roundAsCircle="true"/>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:textColor="#ffe1b0"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:maxLines="1"/>
                </LinearLayout>
                <p151v.VText
                    android:textSize="23sp"
                    android:textStyle="normal"
                    android:textColor="#ffe1b0"
                    android:gravity="center_horizontal"
                    android:id="@+id/red_packet_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginTop="21dp"
                    android:layout_marginRight="28dp"
                    android:text="恭喜发财，大吉大利"
                    android:layout_below="@+id/title_user_layout"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="7sp"/>
                <p151v.VImage
                    android:id="@+id/open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:src="0x7f08161d"
                    android:layout_above="@+id/bottom_text"
                    android:layout_centerHorizontal="true"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="#ffe1b0"
                    android:id="@+id/bottom_text"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看大家的手气"
                    android:layout_above="@+id/bottom_view"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="5sp"/>
                <View
                    android:id="@+id/bottom_view"
                    android:layout_width="wrap_content"
                    android:layout_height="7dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/close_layout"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/red_packet_layout"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VImage
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:src="0x7f081619"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
