<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.other.side.entry.LiveSiderEntryView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="115dp"
    android:layout_height="22dp"
    flatten="true"
    folder="other"
    holder="side.entry.LiveSiderEntryView">
    <RelativeLayout
        android:layout_width="115dp"
        android:layout_height="22dp"
        android:layout_alignParentRight="true">
        <p151v.VDraweeView
            android:id="@+id/image_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="3dp"
            android:layout_centerVertical="true"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/image_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/image_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="27dp"
            android:layout_centerVertical="true"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="1dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@drawable/live_bg_black_lr8_a15"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignParentRight="true">
        <p151v.VImage
            android:id="@+id/icon_live_sider_entry"
            android:layout_width="14dp"
            android:layout_height="16dp"
            android:layout_marginLeft="6dp"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:alpha="0"
            android:layout_marginEnd="2dp"
            app:srcCompat="0x7f082329"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/live_white_90_opacity"
            android:gravity="center"
            android:id="@+id/text"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_SIDEBAR_MORE_ROOM"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon_live_sider_entry"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.live.livingroom.other.side.entry.LiveSiderEntryView>
