<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.life.MarryLoopLifeMomentViewModel">
    <p151v.VScroll
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:orientation="vertical"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="生活瞬间"
                    style="@style/marry_loop_edit_title_text"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#4d000000"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="通过照片展示你的个人魅力"
                    android:maxLines="2"/>
                <com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCards
                    android:id="@+id/reorders"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    app:cardNums="6"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/common_black_04"
                android:id="@+id/sync_feed_pic_title"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="选择历史动态同步"/>
            <p151v.VRecyclerView
                android:id="@+id/feed_pic_list"
                android:paddingBottom="20dp"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp"/>
        </p151v.VLinear>
    </p151v.VScroll>
</FrameLayout>
