<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sku_card_root"
    android:background="@drawable/core_intl_superlike_iap_sku_card_bg"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/discount_label"
        android:background="@drawable/core_intl_superlike_iap_discount_bg"
        android:layout_width="match_parent"
        android:layout_height="36dp"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/hot_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-7dp"
        android:layout_marginRight="-10dp"
        android:src="0x7f080a7a"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp">
        <ImageView
            android:id="@+id/star_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="0x7f080c61"/>
        <TextView
            android:textSize="25sp"
            android:textColor="#000000"
            android:id="@+id/quantity_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#000000"
            android:id="@+id/unit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#00aeff"
            android:id="@+id/price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="28dp"/>
    </LinearLayout>
</FrameLayout>
