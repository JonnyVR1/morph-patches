<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.opt.view.GiftPanelTopBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    holder="gift.opt.view.GiftPanelTopBar">
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/core_gift_panel_tab_indicator_bg"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:visibility="gone"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="125dp"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/core_gift_panel_tab_indicator"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="3dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="12dp"
        app:tabPaddingStart="12dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextColor="@color/common_grey_09"/>
    <p151v.VMarqueeText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/gift_tips"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:lineSpacingExtra="0sp"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="125dp"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/switch_tag_layout"
        android:background="0x7f0808b4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        flatten="true">
        <p151v.VIcon
            android:id="@+id/switch_tag_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0808b5"
            android:layout_marginStart="1dp"/>
        <com.p051p1.mobile.putong.core.p058ui.gift.opt.view.SvipVerticalTextView
            android:id="@+id/vertical_switch_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-1dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.gift.opt.view.GiftPanelTopBar>
