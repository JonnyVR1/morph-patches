<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.call.auction.dialog.queue.view.LiveVoiceAuctionQueueItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    app:bind_extends="LinearLayout"
    app:bind_implements="null"
    app:binding="true"
    app:flatten="true">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.MysteryAvatarView
        android:id="@+id/real_avatar_view"
        android:clickable="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:failureImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:maxWidth="151dp"
            android:text="测试测试测试"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/real_avatar_view"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp">
            <p151v.VText
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/user_age"
                android:paddingLeft="3dp"
                android:paddingTop="1dp"
                android:paddingRight="5dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="1dp"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/user_tag"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/live_operation_1"
        android:background="@drawable/live_bg_white_r10_a10"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:fontFamily="PingFangSC-Medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/live_operation_2"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:fontFamily="PingFangSC-Medium"/>
</com.p051p1.mobile.putong.live.livingroom.voice.call.auction.dialog.queue.view.LiveVoiceAuctionQueueItem>
