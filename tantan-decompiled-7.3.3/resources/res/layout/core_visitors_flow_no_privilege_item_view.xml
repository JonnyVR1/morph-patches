<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsFlowNoPrivilegeItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="234dp"
    android:layout_margin="4dp"
    flatten="true"
    holder="visitor.VisitorsFlowNoPrivilegeItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <View
        android:background="@drawable/core_visitor_top_layer"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/core_visitor_bottom_layer"
        android:layout_width="match_parent"
        android:layout_height="94dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#b3ffffff"
        android:ellipsize="end"
        android:layout_gravity="top"
        android:id="@+id/active_infos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:text="5分钟前活跃"
        android:maxLines="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffdf8f"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:id="@+id/visitor_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="28dp"
        android:text="访问5次"
        android:maxLines="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:id="@+id/reason_infos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="8dp"
        android:text="她想认识同城朋友"
        android:maxLines="1"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/o_diamond_visitor_ic"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:src="0x7f081285"
        android:scaleType="fitXY"/>
</com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsFlowNoPrivilegeItemView>
