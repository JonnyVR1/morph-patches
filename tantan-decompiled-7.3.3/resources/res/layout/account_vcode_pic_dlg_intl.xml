<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.account.p055ui.accountnew.VCodeCaptchaView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="accountnew.VCodeCaptchaView">
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="0x7f0801fd"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="202dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close">
        <p151v.VLinear
            android:orientation="horizontal"
            android:background="@drawable/account_vcode_pic_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:id="@+id/captcha"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@color/gray"
                android:layout_weight="1"/>
            <p151v.VImage
                android:id="@+id/refresh"
                android:padding="11dp"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="0x7f080234"/>
        </p151v.VLinear>
        <p151v.VMaterialEdit
            android:gravity="center"
            android:id="@+id/vcode_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/INTL_CAPTCHA"
            android:singleLine="true"/>
        <p151v.VText
            android:textColor="@color/red_d74d37"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/note"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ERROR_PHONE_NUMBER_INVALID_CONFIRMATION_CODE"/>
    </p151v.VLinear>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/account_vcode_pic_btn_bg"
        android:layout_width="250dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="@string/ACTION_CONFIRM"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
</com.p051p1.mobile.putong.account.p055ui.accountnew.VCodeCaptchaView>
