<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="moments.MomentsFeedFragViewModel"
    useId="true"
    useRefId="true">
    <p151v.VFrame_Shadow
        android:layout_gravity="bottom|right"
        android:id="@+id/operation_layout"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_margin="16dp"
        app:sl_cornerRadius="34dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/feed_operation_tab_bg"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/operation_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/operation_count"
            android:background="@drawable/feed_operation_count_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="16dp"/>
    </p151v.VFrame_Shadow>
    <include layout="@layout/moments_comment_input_bar"/>
</FrameLayout>
