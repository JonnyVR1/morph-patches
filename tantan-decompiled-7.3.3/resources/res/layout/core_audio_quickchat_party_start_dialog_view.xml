<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/core_bg_audio_quickchat_party_start_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="ui"
    holder="quickaudio.party.AudioQuickChatPartyStartDialog">
    <p151v.VDraweeView
        android:id="@+id/bg_bottom_icon"
        android:layout_width="236dp"
        android:layout_height="228dp"
        app:actualImageScaleType="centerCrop"
        app:failureImageScaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"/>
    <p151v.VDraweeView
        android:id="@+id/bg_top_icon"
        android:layout_width="272dp"
        android:layout_height="272dp"
        app:actualImageScaleType="centerCrop"
        app:failureImageScaleType="centerInside"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:src="0x7f0815d7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close">
        <p151v.VImage
            android:id="@+id/title_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="0x7f0815d5"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_80percent_000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="极速约会"
            android:layout_below="@+id/title_icon"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_40percent_000000"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="每周三19:00-22:00，限时开启"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <p151v.VDraweeView
        android:id="@+id/campaign_icon"
        android:layout_width="311dp"
        android:layout_height="320dp"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true"
        app:actualImageScaleType="centerCrop"
        app:failureImageScaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_campaign_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="活动火热进行中\10目前共有1937人在线热聊"
        app:layout_constraintBottom_toTopOf="@+id/join_btn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_80percent_000000"
        android:gravity="center"
        android:id="@+id/join_btn"
        android:background="@drawable/core_card_button_bg_white_normal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp"
        android:text="立即加入"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
