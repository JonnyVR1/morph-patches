<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VText
        android:textSize="24sp"
        android:textColor="@color/core_color_333333"
        android:gravity="center"
        android:id="@+id/finding_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.144"
        app:layout_constraintWidth_percent="0.6853"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_999999"
        android:gravity="center"
        android:id="@+id/finding_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:drawablePadding="6dp"
        android:drawableStart="0x7f080b1d"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/finding_title"
        app:typeface="regular"/>
    <p151v.VProgress
        android:layout_gravity="center_horizontal"
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:progress="99"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/finding_time"
        app:layout_constraintWidth_percent="0.384"
        style="@style/common_progress"/>
    <p151v.VDraweeView
        android:id="@+id/finding_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,230:280"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.283"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.464"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_999999"
        android:gravity="center"
        android:id="@+id/finding_bottom_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/INTL_MKT_TIME_STICKER_NOTICE"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:typeface="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
