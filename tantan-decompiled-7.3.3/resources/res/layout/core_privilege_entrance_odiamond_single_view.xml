<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceODiamondSingleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    holder="banner.view.PrivilegeEntranceODiamondSingleView">
    <p151v.VDraweeView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="6dp"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="0x7f08151e"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#e8cb8c"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintRight_toLeftOf="@+id/unlock"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VIcon
        android:id="@+id/arrow_right"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f081244"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#edd7a3"
        android:gravity="center"
        android:id="@+id/unlock"
        android:background="0x7f081086"
        android:visibility="gone"
        android:layout_width="57dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/arrow_right"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="10dp"/>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceODiamondSingleView>
