<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_preview_photo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="preview.uiattach.FeedPhotoMediaMomentUIAttach">
    <View
        android:id="@+id/tool_bar_back_cover"
        android:background="@drawable/feed_preview_tool_bar_cover_back"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/tool_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/feed_preview_tool_bar"/>
    <View
        android:id="@+id/back_cover"
        android:background="@drawable/feed_preview_cover_back"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/head"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="11dp"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/feed_fresco_profile_small_border"/>
        <p151v.VDraweeView
            android:id="@+id/head_frame"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="11dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/feed_fresco_profile_frame"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            android:text=""
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toRightOf="@+id/head"
            app:layout_constraintRight_toLeftOf="@+id/name_container"
            app:layout_constraintTop_toTopOf="@+id/head"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/name_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/name"
            app:layout_constraintLeft_toRightOf="@+id/name"
            app:layout_constraintRight_toLeftOf="@+id/name_right_btn_root"
            app:layout_constraintTop_toTopOf="@+id/name"
            flatten="true">
            <p151v.VImage
                android:id="@+id/certification_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginEnd="5dp"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_gender_age_extra_view"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.feed.newui.photoalbum.feed.personfeedinminetab.FeedWriterLevelView
                android:id="@+id/writer_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/age_gender_parent"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="@+id/name"
            app:layout_constraintTop_toBottomOf="@+id/name"
            flatten="false">
            <ImageView
                android:id="@+id/img_gender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/age"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:minWidth="0dp"
                android:singleLine="true"
                android:alpha="0.7"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/time"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:singleLine="true"
                android:alpha="0.7"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/name_right_btn_root"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintRight_toRightOf="parent"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/attention"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="18dp"
                android:text="@string/TITLE_FOLLOWING"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/moment_boost_btn_root"
                android:background="@drawable/feed_moment_boost_btn_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="14dp"
                flatten="true">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="8dp"
                    android:src="0x7f081d83"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/moment_boost_btn_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="12dp"
                    android:text="曝光中"/>
            </LinearLayout>
        </RelativeLayout>
        <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@+id/interactive_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.p051p1.mobile.putong.feed.newui.photoalbum.feedbottom.insert.FeedInteractiveView
            android:orientation="vertical"
            android:id="@+id/interactive_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/comment_container"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/like_container"
            android:background="@drawable/feed_ui1_follow_rounded_noback_border"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/divide"
            app:layout_constraintLeft_toLeftOf="parent">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/like_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="10dp"
                android:src="0x7f081e17"
                android:scaleType="fitCenter"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/like_count"
                android:paddingLeft="6dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ACTION_LIKE"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/comment_container"
            android:background="@drawable/feed_ui1_follow_rounded_noback_border"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            app:layout_constraintLeft_toRightOf="@+id/like_container"
            app:layout_constraintTop_toTopOf="@+id/like_container">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/comment_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="10dp"
                android:src="0x7f081e13"
                android:scaleType="fitCenter"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/comment_count"
                android:paddingLeft="6dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ACTION_COMMENT"
                android:singleLine="true"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chat_container"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/like_container">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/chat_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f081ea4"
                android:scaleType="fitCenter"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/chat_count"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:text="@string/WELCOME_PAGE_TUTORIAL_CHAT_HIGHLIGHT_TEXT"
                android:singleLine="true"/>
        </p151v.VLinear>
        <View
            android:id="@+id/divide"
            android:background="#1effffff"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/input_comment_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        layout="@layout/photo_album_detail_comment_input_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
