<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice.intl"
    holder="roombg.buy.IntlVoiceBackgroundPreviewDialog">
    <View
        android:id="@+id/empty"
        android:background="@color/live_black_30_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/pictureGroup"
        android:clickable="true"
        android:layout_width="311dp"
        android:layout_height="457dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/staticBgView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svgaBgView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/closeView"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="16dp"
            android:src="0x7f082365"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</FrameLayout>
