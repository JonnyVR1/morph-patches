<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textColor="#383e46"
        android:id="@+id/newwork_error_text_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/FEED_NETWORK_CONNECTION_ERROR"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#7c7c7c"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/FEED_NETWORK_CONNECTION_RETRY"
        android:layout_below="@+id/newwork_error_text_1"
        android:layout_centerInParent="true"/>
</RelativeLayout>
