<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r20"
    android:layout_width="match_parent"
    android:layout_height="285dp"
    android:minHeight="285dp">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_gray_32"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/alert_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="32dp"
        android:lines="1"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/edit_bg_view"
        android:background="@drawable/live_bg_black_r12_a03"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/alert_confirm_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alert_title"/>
    <p151v.VEditText
        android:textSize="16sp"
        android:textColor="@color/live_black_90_opacity"
        android:textColorHint="@color/live_black_20_opacity"
        android:ellipsize="middle"
        android:id="@+id/alert_edit_text"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:singleLine="true"
        android:textCursorDrawable="@drawable/live_shape_edit_alert_text_cursor_icon"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_bg_view"
        app:layout_constraintEnd_toEndOf="@+id/edit_bg_view"
        app:layout_constraintStart_toStartOf="@+id/edit_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/alert_title"
        app:layout_constraintTop_toTopOf="@+id/edit_bg_view"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/alert_confirm_button"
        android:background="@drawable/live_bg_fe7e1d_r16"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:lines="1"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/alert_cancel_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="24dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_gray_cc"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/alert_cancel_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        android:lines="1"
        android:layout_marginHorizontal="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
