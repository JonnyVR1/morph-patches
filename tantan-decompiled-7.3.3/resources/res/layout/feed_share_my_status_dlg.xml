<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/shadow"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_ll"
        android:background="@drawable/feed_share_my_state_bg"
        android:paddingBottom="18dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center"
            android:id="@+id/view_line"
            android:background="@drawable/common_handlebar_handler"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#010101"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:text="分享状态，与好友即刻开聊"
            android:lineSpacingExtra="1sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_chat_input_enable_false"
            android:layout_gravity="center_horizontal"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="24小时后将自动消失"
            android:lineSpacingExtra="7sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cent_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <View
                android:id="@+id/bg_view"
                android:background="@drawable/feed_share_state_bg_oval"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="34dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.p051p1.mobile.putong.feed.newui.status.display.view.FeedSmoothSpeedRecycle
                android:id="@+id/state_recycle"
                android:background="@color/transparent"
                android:scrollbars="none"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:divider="@null"
                app:layout_constraintBottom_toBottomOf="@+id/bg_view"
                app:layout_constraintTop_toTopOf="@+id/bg_view"
                useId="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:gravity="center"
            android:id="@+id/my_state_name"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cent_view"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/input_ll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="38dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="38dp">
            <p151v.VDraweeView
                android:layout_gravity="top"
                android:id="@+id/head_image"
                android:background="0x7f081e75"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="8dp"
                app:roundAsCircle="true"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#e6000000"
                android:textColorHint="@color/feed_comment_reply_text_color"
                android:gravity="left"
                android:id="@+id/input"
                android:background="@null"
                android:visibility="visible"
                android:scrollbars="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="说说你的此刻状态"
                android:maxLines="4"
                android:maxLength="30"
                android:inputType="textMultiLine"
                android:textCursorDrawable="@drawable/feed_guide_states_cursor_bg"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/post"
            android:background="@drawable/feed_share_mystate_post_bg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="14dp"
            android:text="去发布"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_ll"/>
    </p151v.VLinear>
</FrameLayout>
