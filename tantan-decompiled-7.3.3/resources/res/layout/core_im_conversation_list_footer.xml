<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/guide_image"
        android:background="0x7f0803fb"
        android:layout_width="122dp"
        android:layout_height="115dp"
        android:layout_marginTop="50dp"/>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/guide_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/CORE_ACTION_KEEP_SWIPING_TITLE"
        android:fontFamily="sans-serif"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/guide_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="61dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="52dp"
        android:text="@string/CORE_ACTION_KEEP_SWIPING_TIPS"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif"/>
    <p151v.VFrame
        android:id="@+id/switcher"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/guide_swipe"
        android:background="@drawable/bg_guide_swipe"
        android:paddingLeft="36dp"
        android:paddingTop="14dp"
        android:paddingRight="36dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="开始滑动"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif"/>
</p151v.VLinear>
