<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.growth.views.GrowthSpamDlgView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="growth.views.GrowthSpamDlgView">
    <p151v.VLinear
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VFrame
            android:layout_gravity="center_horizontal"
            android:id="@+id/log_out_dlg_frame"
            android:layout_width="130dp"
            android:layout_height="133dp"
            android:layout_marginTop="30dp">
            <p151v.VImage
                android:layout_width="94dp"
                android:layout_height="133dp"
                android:src="0x7f080818"
                android:scaleType="fitXY"/>
            <p151v.VDraweeView
                android:id="@+id/spam_dlg_avatar"
                android:layout_width="90dp"
                android:layout_height="120dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="4dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="25dp"
                app:roundedCornerRadius="10dp"
                app:roundingBorderColor="@color/white"
                app:roundingBorderPadding="1dp"
                app:roundingBorderWidth="4dp"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="4dp"
                android:src="0x7f081474"
                android:scaleType="fitXY"
                android:layout_marginStart="90dp"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/core_color_cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/spam_dlg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="27dp"
            android:layout_marginRight="32dp"
            android:text="真实头像认证"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/spam_dlg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:text="探探要求用户提供真实照片来保证平台和用户的安全。防止假照，交流更真诚"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/ll_protocol_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">
            <p151v.VCheckBox
                android:id="@+id/spam_dlg_privacy_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                style="@style/common_checkbox"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#33000000"
                android:id="@+id/spam_dlg_tv_protocol_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="同意腾讯、阿里将采集我的面部信息并与头像比对，详见《真实头像认证协议》"
                android:layout_marginStart="5dp"/>
        </p151v.VLinear>
        <p151v.VButton
            android:id="@+id/spam_dlg_submit"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:text="立即认证"
            style="@style/common_button_large_01"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/spam_dlg_feedback"
            android:background="@drawable/core_messages_chat_gif_footer_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:text="修改头像"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4c000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/spam_dlg_log_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="登出账号"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.growth.views.GrowthSpamDlgView>
