<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.nightclub.view.IntlNightClubDlgView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="ui"
    holder="nightclub.view.IntlNightClubDlgView">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_intl_night_club_dlg_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toTopOf="@+id/space">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/core_color_151515"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:maxWidth="110dp"
            android:text="@string/INTL_MKT_TWCLUB_POPUP_TITLE"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/core_color_80000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/pop_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/INTL_MKT_TWCLUB_POPUP"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/pop_confirm"
            android:background="@drawable/core_intl_purple_801dfe_radius_14"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/INTL_MKT_TWCLUB_POPUP_BTN"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_33000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/pop_cancel"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/INTL_MKT_TWCLUB_POPUP_BTN2"
            app:typeface="medium"/>
    </p151v.VLinear>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/match_anim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="750:400"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/match_anim"
        app:layout_constraintDimensionRatio="750:200"/>
</com.p051p1.mobile.putong.core.p058ui.nightclub.view.IntlNightClubDlgView>
