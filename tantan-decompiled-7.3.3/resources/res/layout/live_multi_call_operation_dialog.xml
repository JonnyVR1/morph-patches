<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_bg_white_tr8"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_user_desc"
        android:layout_width="match_parent"
        android:layout_height="84dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:roundAsCircle="true"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="#000"
                android:ellipsize="end"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="221dp"
                android:singleLine="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/unit"
                    android:background="@drawable/live_bg_f36c4e_r8"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:text="@string/LIVE_HEART"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#000"
                    android:id="@+id/tv_heart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="16dp"
            android:src="0x7f082347"/>
    </LinearLayout>
    <include
        android:id="@+id/send_gift"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/mute"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/lead_role"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/beauty"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/switch_camera"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/switch_video_call"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/invite_video_call"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/call_fans"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
    <include
        android:id="@+id/end"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/live_call_manage_item"/>
</p151v.VLinear>
