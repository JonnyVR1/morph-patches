<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="appeal.AppealViewModel"
    style="@style/core_account_root">
    <p151v.VScroll style="@style/core_account_scroll">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/TYPING_REASON_FOR_APPEAL"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#de000000"
                android:textColorHint="#d0d0d0"
                android:gravity="top|left"
                android:id="@+id/description"
                android:background="@color/white"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="123dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:hint="@string/TYPING_REASON_FOR_UNBANNED"
                android:maxLines="10"
                android:maxLength="120"
                android:textCursorDrawable="0x7f082a1a"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#d0d0d0"
                android:layout_gravity="right"
                android:id="@+id/input_characters_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"/>
            <View
                android:background="#1e000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/UPLOADING_PICTURE_OPTIONALLY"
                android:lineSpacingExtra="2sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"/>
            <View
                android:background="#1e000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/CONTACT_OPTIONAL"
                android:lineSpacingExtra="2sp"/>
            <p151v.VMaterialEdit
                android:textSize="16sp"
                android:textColor="#de000000"
                android:textColorHint="#d0d0d0"
                android:id="@+id/contact_way"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:hint="@string/PHONE_NUMBER_OR_EMAIL_ADDRESS"
                android:lineSpacingExtra="8sp"
                android:textCursorDrawable="0x7f082a1a"
                app:met_textColor="#de000000"/>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:id="@+id/submit"
        android:text="@string/REPORT_SUBMIT"
        style="@style/core_account_continue_button"/>
</LinearLayout>
