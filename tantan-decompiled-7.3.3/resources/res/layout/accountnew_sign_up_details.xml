<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:importantForAutofill="noExcludeDescendants"
    holder="accountnew.SignUpDetailsNewViewModel"
    style="@style/account_account_root">
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        flatten="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_80"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="56dp"
                android:text="@string/MENU_PROFILE"
                android:layout_marginStart="20dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/common_000000_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/SIGNUP_NICKNAKE_PLACEHOLDER"
                app:typeface="medium"/>
            <p151v.VEditText
                android:textSize="18dp"
                android:textColor="@color/common_black_01"
                android:textColorHint="@color/common_grey_04"
                android:id="@+id/full_name"
                android:background="@drawable/common_card_middle_radius_12_bg"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="20dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/account_signup_ai_cursor"
                android:paddingStart="20dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="@color/common_red"
                android:gravity="center_vertical"
                android:id="@+id/name_error"
                android:background="@drawable/account_sign_input_error_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:drawablePadding="7dp"
                android:drawableStart="0x7f0801f3"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="20dp"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/birthdate_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/NEW_SIGN_UP_EDIT_PROFILE_BIRTHDAY_PLACEHOLDER"
                android:layout_marginEnd="20dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="18dp"
                android:textColor="@color/common_black_01"
                android:textColorHint="@color/common_grey_04"
                android:gravity="center_vertical"
                android:id="@+id/birthdate_label"
                android:background="@drawable/common_card_middle_radius_12_bg"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="20dp"
                android:maxLines="1"
                android:paddingStart="20dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="@color/common_red"
                android:gravity="center_vertical"
                android:id="@+id/birth_error"
                android:background="@drawable/account_sign_input_error_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:drawablePadding="7dp"
                android:drawableStart="0x7f0801f3"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="20dp"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/common_000000_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/SETTINGS_YOUR_GENDER"
                app:typeface="medium"/>
            <p151v.VLinear
                android:id="@+id/gender"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:descendantFocusability="beforeDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="12dp"
                flatten="true">
                <p151v.VFrame
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/male"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    flatten="true">
                    <p151v.VLinear
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/male_gender"
                        android:background="@drawable/account_signup_gender_bg_intl"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp">
                        <p151v.VIcon
                            android:id="@+id/ic_male_gender_icon"
                            android:background="@drawable/account_signup_male_gender_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/account_signup_gender_text_color"
                            android:id="@+id/tv_male_gender_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/TTT_INTL_TTC_CLONE_SIGNUP_GENDER_MAN_BTN"
                            android:textAllCaps="true"
                            app:typeface="bold"/>
                    </p151v.VLinear>
                    <p151v.VImage
                        android:layout_gravity="top|right"
                        android:id="@+id/male_ic"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="0x7f080221"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/female"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    flatten="true">
                    <p151v.VLinear
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/female_gender"
                        android:background="@drawable/account_signup_gender_bg_intl"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp">
                        <p151v.VIcon
                            android:id="@+id/ic_female_gender_icon"
                            android:background="@drawable/account_signup_female_gender_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/account_signup_gender_text_color"
                            android:id="@+id/tv_female_gender_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/TTT_INTL_TTC_CLONE_SIGNUP_GENDER_WOMAN_BTN"
                            android:textAllCaps="true"
                            app:typeface="bold"/>
                    </p151v.VLinear>
                    <p151v.VImage
                        android:layout_gravity="top|right"
                        android:id="@+id/female_ic"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="0x7f080221"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/nonbinary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    flatten="true">
                    <p151v.VLinear
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/nonbinary_gender"
                        android:background="@drawable/account_signup_gender_bg_intl"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp">
                        <p151v.VIcon
                            android:id="@+id/ic_nonbinary_gender_icon"
                            android:background="@drawable/account_signup_nonbinary_gender_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/account_signup_gender_text_color"
                            android:id="@+id/tv_nonbinary_gender_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_NONBINARY_BTN"
                            android:textAllCaps="true"
                            app:typeface="bold"/>
                    </p151v.VLinear>
                    <p151v.VImage
                        android:layout_gravity="top|right"
                        android:id="@+id/nonbinary_ic"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="0x7f080221"/>
                </p151v.VFrame>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="@color/common_red"
                android:gravity="center_vertical"
                android:id="@+id/gender_error"
                android:background="@drawable/account_sign_input_error_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:text="@string/SIGNUP_ERROR_GENDER_EMPTY"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:drawablePadding="7dp"
                android:drawableStart="0x7f0801f3"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="20dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/add_more_gender_entrance"
                android:background="@drawable/common_card_radius_10_f9f9f9_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="20dp">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/common_000000_30"
                    android:ellipsize="end"
                    android:id="@+id/tv_more_gender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_ADD_DETAILS_BTN"
                    android:lines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/tv_more_gender_add"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/common_000000_30"
                    android:id="@+id/tv_more_gender_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_ADD_DETAILS_ADD_BTN"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ic_more_gender"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VIcon
                    android:id="@+id/ic_more_gender"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="0x7f082056"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/blood_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VText
                    android:textSize="14dp"
                    android:textColor="@color/common_grey_03"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/BLOOD_TYPE"
                    android:layout_marginEnd="20dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:gravity="center_vertical"
                    android:id="@+id/blood"
                    android:background="@drawable/common_card_middle_02_bg"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:hint="@string/BLOOD_TYPE"
                    android:paddingStart="20dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/qualification_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VText
                    android:textSize="14dp"
                    android:textColor="@color/common_grey_03"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/PROFILE_QUALIFICATION"
                    android:layout_marginEnd="20dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="18dp"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:id="@+id/qualification"
                    android:background="@drawable/common_card_middle_02_bg"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:hint="@string/PROFILE_QUALIFICATION"
                    android:cursorVisible="false"
                    android:inputType="number"
                    android:paddingStart="20dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/school_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VText
                    android:textSize="14dp"
                    android:textColor="@color/common_grey_03"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/PROFILE_INFO_SCHOOL"
                    android:layout_marginEnd="20dp"
                    app:typeface="medium"/>
                <p151v.VEditText
                    android:textSize="18dp"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:id="@+id/school"
                    android:background="@drawable/common_card_middle_02_bg"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:hint="@string/PROFILE_INFO_SCHOOL"
                    android:textCursorDrawable="@drawable/account_signup_ai_cursor"
                    android:paddingStart="20dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/password_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VText
                    android:textSize="15dp"
                    android:textColor="@color/common_000000_40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/SIGNUP_PASSWORD_PLACEHOLDER"
                    android:layout_marginEnd="20dp"
                    app:typeface="medium"/>
                <p151v.VEditText
                    android:textSize="18dp"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:id="@+id/password"
                    android:background="@drawable/common_card_middle_radius_12_bg"
                    android:nextFocusDown="@+id/continue_"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"
                    android:maxLength="20"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/account_signup_ai_cursor"
                    android:paddingStart="20dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="12dp"
                    android:textColor="@color/common_red"
                    android:gravity="center_vertical"
                    android:id="@+id/pwd_error"
                    android:background="@drawable/account_sign_input_error_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:drawablePadding="7dp"
                    android:drawableStart="0x7f0801f3"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/gdpr_sms_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VCheckBox
                    android:id="@+id/sms_check"
                    android:layout_marginRight="8dp"
                    style="@style/common_checkbox"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_04"
                    android:textColorHighlight="@color/transparent"
                    android:textColorLink="@color/welcome_privacy_link"
                    android:id="@+id/sms_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/GDPR_SMS_TEXT"
                    style="@style/account_welcome_privacy_gravity"/>
            </p151v.VLinear>
            <p151v.VButton
                android:enabled="true"
                android:id="@+id/continue_"
                android:background="@drawable/common_primary_ripple"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="59dp"
                android:layout_marginRight="20dp"
                android:text="@string/ACTION_CONTINUE"
                style="@style/common_button_large_01"/>
        </LinearLayout>
    </p151v.VScroll>
    <include
        android:id="@+id/toolbar"
        flatten="true"
        layout="@layout/account_sign_common_top_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
