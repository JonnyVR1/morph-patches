<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="voice"
    holder="usercard.view.VoiceUserCardDialog2">
    <View
        android:id="@+id/card"
        android:background="@drawable/live_bg_191919_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/head_image_layout"
        flatten="true"/>
    <include
        android:id="@+id/user_card_skin_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/top_placeholder"
        ignore="true"
        layout="@layout/live_user_card_skin_view"/>
    <Space
        android:id="@+id/top_placeholder"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toTopOf="@+id/card"
        ignore="true"/>
    <FrameLayout
        android:id="@+id/head_image_layout"
        android:background="0x7f0826c3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toTopOf="@+id/medal_and_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/pic_verification"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="19dp"
            android:layout_marginBottom="12dp"/>
    </FrameLayout>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/guard_image"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/head_image_layout"
        app:layout_constraintLeft_toLeftOf="@+id/head_image_layout"/>
    <include
        android:id="@+id/medal_and_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/level_outer_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true"
        layout="@layout/live_user_card_dlg_medal_and_name_voice"/>
    <p151v.VFrame
        android:id="@+id/level_outer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_wall_container"
        flatten="true">
        <p151v.VLinear
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/level_container"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            flatten="true">
            <include
                android:id="@+id/user_level"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="56dp"
                flatten="true"
                layout="@layout/live_voice_card_user_level"/>
            <include
                android:id="@+id/anchor_level"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="56dp"
                android:layout_marginStart="9dp"
                flatten="true"
                layout="@layout/live_voice_card_anchor_level"/>
            <include
                android:id="@+id/fan_base"
                android:layout_width="106dp"
                android:layout_height="56dp"
                android:layout_marginStart="9dp"
                flatten="true"
                layout="@layout/live_voice_card_fan_base_enter_view"/>
            <include
                android:id="@+id/medal_wall"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="56dp"
                android:layout_marginStart="9dp"
                flatten="true"
                layout="@layout/live_voice_card_medal_wall_enter_view"/>
            <include
                android:id="@+id/family_group"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="56dp"
                android:layout_marginStart="9dp"
                flatten="true"
                layout="@layout/live_voice_card_family_group_enter_view"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <include
        android:id="@+id/gift_wall_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/cp_layout_container"
        layout="@layout/live_voice_user_card_gift_wall_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cp_layout_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_button"
        flatten="true">
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/cpView"
            android:visibility="gone"
            android:layout_width="325dp"
            android:layout_height="81dp"
            android:layout_marginBottom="12dp"
            layout="@layout/live_voice_sweet_cp_head_layout"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_action_button"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/at_him"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/send_gift"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_SEND_GIFT"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/kick_call"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/attention"
            android:background="@drawable/live_bg_ff8817_r16"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_FOLLOW"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <p151v.VImage
        android:id="@+id/manage"
        android:layout_width="18dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        app:layout_constraintRight_toRightOf="@+id/card"
        app:layout_constraintTop_toTopOf="@+id/card"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#9aa5b1"
        android:gravity="center"
        android:id="@+id/no_data_hint"
        android:background="@drawable/live_bg_white_tr24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:text="@string/LIVE_PROFILE_DATA_LOAD_FAIL"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/obstructView"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/userCardAnimPlayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginBottom="10dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/head_image_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.effect.video.VideoEffectPlayer
        android:id="@+id/cpVideoPlayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/head_image_layout"
        app:layout_constraintDimensionRatio="71:65"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
