<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/common_white_01"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="32dp"
        android:text="@string/RATE_GUIDE_SCORE_TANTAN"
        android:lines="1"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/RATE_GUIDE_TOUCH_STARS"
        android:lineSpacingMultiplier="1.2"/>
    <RatingBar
        android:id="@+id/app_rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minWidth="36dp"
        android:minHeight="36dp"
        android:numStars="5"
        android:rating="0"
        android:stepSize="1"
        android:isIndicator="false"
        style="@style/App_RatingBar"/>
</LinearLayout>
