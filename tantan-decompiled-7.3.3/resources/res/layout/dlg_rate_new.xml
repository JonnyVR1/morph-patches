<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="gp.GpRateGuideDialog"
    useId="true">
    <p151v.VImage
        android:id="@+id/head_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f082999"
        useId="true"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="@color/rate_new_dlg_title"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/RATE_TANTAN"
        android:lineSpacingExtra="0sp"
        useId="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#4c4c4c"
        android:gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="17dp"
        android:text="@string/RATE_TANTAN_DES"
        android:lineSpacingExtra="8sp"
        useId="true"/>
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/check_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="41dp"
        useId="true">
        <p151v.VCheckBox
            android:theme="@style/core_rate_check_box"
            android:id="@+id/check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            useId="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_03"
            android:layout_gravity="center_vertical"
            android:id="@+id/check_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/NEVER_REMIND"
            useId="true"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/positive"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="12dp"
        android:text="@string/RATE_TANTAN"
        style="@style/common_button_large_01"
        useId="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_grey_03"
        android:gravity="center"
        android:id="@+id/negative"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ACTION_CANCEL"
        useId="true"/>
</p151v.VLinear>
