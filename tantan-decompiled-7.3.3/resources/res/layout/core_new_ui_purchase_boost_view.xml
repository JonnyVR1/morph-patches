<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.BoostPurchaseSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.showcase.BoostPurchaseSectionView">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="131dp"
        android:layout_marginTop="12dp"
        flatten="true">
        <p151v.VText
            android:textSize="30sp"
            android:textColor="@color/core_vip_normal_title_text_color"
            android:gravity="center"
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <p151v.VText_AutoFit
            android:textSize="12sp"
            android:textColor="@color/common_grey_01"
            android:gravity="center"
            android:id="@+id/describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/discount_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:typeface="regular"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#f27310"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:singleLine="true"
        app:typeface="regular"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/label"
        android:paddingTop="1dp"
        android:visibility="invisible"
        android:layout_width="74dp"
        android:layout_height="24dp"
        android:maxLines="1"
        app:typeface="regular"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.BoostPurchaseSectionView>
