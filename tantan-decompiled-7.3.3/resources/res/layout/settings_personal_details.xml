<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.personaldetails.PersonalDetailsViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VProgressBar
            android:id="@+id/loading_block"
            android:visibility="visible"
            style="@style/core_loading_block"/>
        <p151v.VScroll
            android:id="@+id/scroll"
            android:visibility="invisible"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VLinear
                    android:id="@+id/my_gender"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/SETTINGS_YOUR_GENDER"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/settings_secondary_disable"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/full_name"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/EDIT_SETTINGS_CELL_FULL_NAME"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/core_settings_secondary"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/birthdate"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/SETTINGS_BIRTHDAY"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/core_settings_secondary"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/blood_type"
                    android:visibility="gone"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/BLOOD_TYPE"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/core_settings_secondary"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/add_emoji"
                    android:visibility="gone"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/INTL_MY_EMOJI"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        android:text="@string/INTL_ADD_EMOJI"
                        android:drawableLeft="0x7f08024a"
                        android:drawablePadding="8dp"
                        style="@style/core_settings_secondary"/>
                    <p151v.VDraweeView
                        android:id="@+id/emoji"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="16dp"/>
                </p151v.VLinear>
            </LinearLayout>
        </p151v.VScroll>
    </p151v.VFrame>
</p151v.VLinear>
