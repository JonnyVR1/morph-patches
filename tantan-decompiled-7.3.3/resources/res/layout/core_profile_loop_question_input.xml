<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/input_root"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.loop.input.ProfileLoopMyQuestionInputViewModel">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/first_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="20dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#999999"
                android:gravity="center"
                android:id="@+id/second_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="20dp"
                android:text="回答感兴趣的问题，表达你的个人态度"
                android:layout_below="@+id/first_title"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="0sp"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <include layout="@layout/core_loop_new_multi_select_item"/>
                <RelativeLayout
                    android:id="@+id/input_layout"
                    android:background="@drawable/core_profile_loop_edit_bg"
                    android:paddingTop="11dp"
                    android:layout_width="match_parent"
                    android:layout_height="162dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="40dp"
                    android:layout_below="@+id/subtitle"
                    flatten="true">
                    <p151v.VEditText
                        android:textSize="16sp"
                        android:textColor="@color/core_color_e6000000"
                        android:textColorHint="@color/common_light_02"
                        android:gravity="top|left"
                        android:id="@+id/input_text"
                        android:background="#00000000"
                        android:paddingLeft="16dp"
                        android:paddingTop="9dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="我觉得…"
                        android:textCursorDrawable="@drawable/core_message_input_cursor"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/common_light_02"
                        android:id="@+id/max_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/input_error_text"
                        android:background="@drawable/core_profile_loop_error_bg"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </p151v.VLinear>
        </p151v.VLinear>
    </ScrollView>
    <include
        android:id="@+id/action_view"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_alignParentBottom="true"
        layout="@layout/core_profile_loop_edit_action_layout"/>
</p151v.VLinear>
