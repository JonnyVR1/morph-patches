<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    holder="verification.CertCenterV2ViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VScroll
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/core_bg_white_r10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <p151v.VImage
                    android:id="@+id/hint_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:src="0x7f0806b0"
                    android:layout_marginStart="20dp"
                    android:layout_marginVertical="12dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#4d000000"
                    android:id="@+id/hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="采集信息仅用于审核，探探承诺保障您的隐私安全"
                    android:layout_marginStart="4dp"/>
            </p151v.VLinear>
            <include
                android:id="@+id/avatar_container"
                layout="@layout/core_certification_avatar_v2"/>
            <include
                android:id="@+id/identify_container"
                layout="@layout/core_certification_identity_v2"/>
            <include
                android:id="@+id/ctdid_container"
                layout="@layout/core_certification_ctdid_v2"/>
            <include
                android:id="@+id/student_container"
                layout="@layout/core_certification_student_v2"/>
            <View
                android:layout_width="0dp"
                android:layout_height="11dp"/>
        </p151v.VLinear>
    </p151v.VScroll>
</p151v.VLinear>
