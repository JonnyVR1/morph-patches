<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemGoogleAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemGoogleAdView">
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:clickable="true"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:src="0x7f080aaf"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/MESSAGE_AD_TITLE"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#7f7f7f"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/MESSAGE_AD_SUBTITLE"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/check"
        android:background="@drawable/core_see_change_look_bg_intl"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="55dp"
        android:text="@string/MESSAGE_AD_BUTTON"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemGoogleAdView>
