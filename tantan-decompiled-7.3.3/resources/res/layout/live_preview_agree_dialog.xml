<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/dlg_root"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/tips"
                android:background="#f2f2f2"
                android:visibility="invisible"
                android:layout_width="37dp"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"/>
            <p151v.VImage
                android:layout_gravity="end"
                android:id="@+id/live_iv_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="0x7f0803a3"
                android:layout_marginEnd="20dp"/>
        </p151v.VFrame>
        <com.p051p1.mobile.putong.live.base.webview.SelfTouchWebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VLinear>
</p151v.VFrame>
