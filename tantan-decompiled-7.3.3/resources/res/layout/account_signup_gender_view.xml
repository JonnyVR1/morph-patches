<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingBottom="120dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    attachToRoot="true"
    holder="accountai.new2021.view.GenderView">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_female"
        android:background="@drawable/account_signup_ai_gender_select_cover"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_weight="1"
        android:layout_marginEnd="23dp">
        <p151v.VImage
            android:id="@+id/iv_female"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="26dp"
            android:src="0x7f080214"/>
        <p151v.VText
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/account_black_01040d"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_female"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/NEW_SIGN_UP_EDIT_PROFILE_GENDER_FEMALE"
            android:includeFontPadding="false"
            app:typeface="medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_male"
        android:background="@drawable/account_signup_ai_gender_select_cover"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_weight="1">
        <p151v.VImage
            android:id="@+id/iv_male"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="26dp"
            android:src="0x7f080215"/>
        <p151v.VText
            android:textSize="18dp"
            android:textColor="@color/account_black_01040d"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_male"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/NEW_SIGN_UP_EDIT_PROFILE_GENDER_MALE"
            android:includeFontPadding="false"
            app:typeface="medium"/>
    </LinearLayout>
</merge>
