<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    flatten="true"
    folder="newui"
    holder="profile.newmine.newprofile.mytab.MyTabProfileImpViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="2dp"
        android:paddingEnd="0dp"/>
    <FrameLayout
        android:id="@+id/notify_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.StateScrollVIew
        android:id="@+id/scroll_list"
        android:visibility="visible"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        flatten="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/root"
            android:paddingBottom="24dp"
            android:focusableInTouchMode="true"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/user_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                flatten="true"/>
            <FrameLayout
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true"/>
        </LinearLayout>
    </com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.StateScrollVIew>
</LinearLayout>
