<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.widget.FilterMenuView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.widget.FilterMenuView">
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <p151v.VImage
            android:id="@+id/camera_filter_compare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:src="0x7f081ca1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <com.p051p1.mobile.putong.feed.newui.camera.widget.FeedTextSeekBar
            android:layout_gravity="center_vertical"
            android:id="@+id/camera_filter_seek_bar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginRight="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/camera_filter_compare"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:progressDrawable="@drawable/feed_camera_filter_seek_bar"
            app:progressHeight="4dp"
            app:textBgHeight="30dp"
            app:textBgWidth="40dp"
            app:textColor="#ffffff"
            app:textPaddingTop="10dp"
            app:textSize="16sp"
            app:thumb="@drawable/feed_camera_filter_seek_bar_thumb"
            app:thumbHeight="32dp"
            app:thumbWidth="23dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:orientation="horizontal"
        android:background="#000000"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FEED_CAMERA_FILTER"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/camera_filter_reset"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f081ca2"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/camera_filter_recycler_view"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:overScrollMode="never"/>
</com.p051p1.mobile.putong.feed.newui.camera.widget.FilterMenuView>
