<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.FeedListActivityTextWithLinkItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feed_item_activity_text_link"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="photoalbum.FeedListActivityTextWithLinkItem">
    <include layout="@layout/feed_photo_album_activities_time"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_fl"
        android:paddingLeft="64dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_orange"
            android:id="@+id/link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="竞猜赚金币"/>
        <include
            android:id="@+id/link_image"
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginTop="8dp"
            layout="@layout/moments_pic_new_feed"/>
    </LinearLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.FeedListActivityTextWithLinkItem>
