<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/feed_moment_viewer_operation_bg"
    android:layout_width="match_parent"
    android:layout_height="94dp"
    folder="newui"
    holder="dialog.FeedMomentBoostDialogItemView">
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:layout_gravity="center_horizontal"
            android:id="@+id/improve_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/common_grey_09"
            android:layout_gravity="center_horizontal"
            android:id="@+id/improve_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </p151v.VLinear>
</p151v.VFrame>
