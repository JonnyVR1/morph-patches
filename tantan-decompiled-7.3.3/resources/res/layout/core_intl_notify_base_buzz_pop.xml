<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="20dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    folder="ui"
    holder="lovebuzz.pop.BaseBuzzNotifyPop">
    <p151v.VImage
        android:id="@+id/front_bg"
        android:layout_width="250dp"
        android:layout_height="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/peer_avatar_anim"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/peer_info_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/peer_info_ll"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/peer_info_ll"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="108dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close_buzz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/core_color_323232"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/peer_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="8dp"
                android:layout_weight="1"
                android:drawableEnd="0x7f080af5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:typeface="medium"/>
            <p151v.VImage
                android:id="@+id/peer_region"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_grey_09"
            android:gravity="start"
            android:id="@+id/buzz_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/peer_info"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_66000000"
        android:gravity="center"
        android:id="@+id/refuse_buzz"
        android:background="@drawable/core_intl_video_buzz_pass_btn_selector"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/INTL_BUZZ_POPUP_INVITE_PASS"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/accept_buzz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/peer_info_ll"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/accept_buzz"
        android:background="@drawable/core_intl_video_buzz_back_btn_selector"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/INTL_BUZZ_POPUP_INVITE_ACCEPT"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/refuse_buzz"
        app:layout_constraintTop_toBottomOf="@+id/peer_info_ll"
        app:typeface="medium"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.BuzzProgressBar
        android:id="@+id/buzz_progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/peer_info_ll"/>
    <View
        android:id="@+id/close_buzz"
        android:background="0x7f080a44"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
