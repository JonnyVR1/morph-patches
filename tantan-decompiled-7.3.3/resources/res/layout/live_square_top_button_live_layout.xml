<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.live.square.home.submodule.topButton.LiveSquareTopButtonLiveView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="internal"
    holder="live.square.home.submodule.topButton.LiveSquareTopButtonLiveView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/img_live_setting"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="6dp"
            android:scaleType="fitXY"
            fresco:placeholderImage="@drawable/live_selector_square_home_setting"/>
        <p151v.VDraweeView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/start_live"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="6dp"
            android:scaleType="fitXY"
            fresco:placeholderImage="0x7f082682"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/start_live_second"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:visibility="gone"
            android:layout_width="57dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"/>
    </p151v.VLinear>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/red_point"
        android:background="@drawable/live_shape_tab_red_bg"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="6dp"/>
</com.p051p1.mobile.putong.live.external.internal.live.square.home.submodule.topButton.LiveSquareTopButtonLiveView>
