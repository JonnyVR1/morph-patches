<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemAiPictureRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="210dp"
    android:layout_height="280dp"
    android:layout_marginEnd="4dp"
    flatten="true"
    holder="messages.ItemAiPictureRight">
    <FrameLayout
        android:id="@+id/cover_content"
        android:layout_width="210dp"
        android:layout_height="280dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/sending"
            style="@style/core_msg_image_sending_progress_style"/>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.5dp"
            android:layout_marginStart="12dp">
            <p151v.VImage
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="0x7f080e9e"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/describe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="魔法照"
                android:layout_marginStart="2dp"/>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemAiPictureRight>
