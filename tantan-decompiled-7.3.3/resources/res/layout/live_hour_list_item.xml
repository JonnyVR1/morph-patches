<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.intl.HourBoardListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    folder="increment"
    holder="leaderboard.hourleaderboard.intl.HourBoardListItem">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#bfbfbf"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/rank"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/rank"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/heart"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VLinear
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.p051p1.mobile.putong.live.base.view.LiveTagView
                android:id="@+id/living"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4a4a4a"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:singleLine="true"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/progress_root"
            android:background="@drawable/live_shape_hour_board_dlg_header_own_progress_bg"
            android:padding="1dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="12dp"
            flatten="true">
            <com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.intl.HourBoardProgressView
                android:layout_gravity="center_vertical"
                android:id="@+id/own_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:liveRadius="9dp"/>
            <com.p051p1.mobile.putong.live.livingroom.view.rollview.LiveTextRollView
                android:layout_gravity="center"
                android:id="@+id/own_roll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                app:contentTextSize="11sp"
                app:maxWidth="155dp"/>
        </FrameLayout>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_ff8817"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/heart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.intl.HourBoardListItem>
