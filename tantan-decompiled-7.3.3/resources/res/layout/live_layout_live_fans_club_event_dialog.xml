<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="580dp"
    flatten="true"
    folder="common.fansclub"
    holder="eventdialog.FansClubEventDialog">
    <View
        android:id="@+id/back"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/back"
        app:layout_constraintTop_toTopOf="@+id/back"
        layout="@layout/live_layout_live_fans_club_event_view"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="@+id/back"
        app:layout_constraintTop_toTopOf="@+id/back"
        app:srcCompat="0x7f0822a6"/>
    <p151v.VImage
        android:id="@+id/question"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="@+id/back"
        app:layout_constraintTop_toTopOf="@+id/back"
        app:srcCompat="0x7f0822a0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
