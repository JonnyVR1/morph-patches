<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.innerpush.CountdownConvPushLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.innerpush.CountdownConvPushLayout">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="0x7f0803c9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <p151v.VDraweeView
                android:id="@+id/image_small"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                style="@style/core_fresco_profile_small"/>
            <p151v.VText
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/common_normal_title"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="20dp"
                android:maxLines="2"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/common_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/action_btn"
                android:background="@drawable/common_button_btn_orange_small"
                android:layout_width="56dp"
                android:layout_height="41dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="16dp"
                android:text="查看"
                android:singleLine="true"/>
        </LinearLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.home.views.innerpush.CountdownConvPushLayout>
