<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ocr_result_symbols_page"
    android:background="@drawable/identity_nfc_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="317dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#3d3d3d"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="62dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="62dp"
            android:text="该证件的符号标识位于出生日期下方，为“***AZ”"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="62dp"/>
        <ImageView
            android:id="@+id/iv_symbol_tip_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/identity_ocr_img_comm_close_grey"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_marginLeft="62dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="62dp"
        android:layout_marginBottom="25dp"
        android:src="@drawable/identity_ocr_id_card_symbol"
        android:contentDescription="内容"
        android:layout_marginHorizontal="62dp"/>
    <Button
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:id="@+id/bt_symbol_confirm"
        android:background="@drawable/shape_identity_ocr_id_result_edit_bg_blue"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80dp"
        android:layout_marginRight="80dp"
        android:layout_marginBottom="20dp"
        android:text="我知道了"
        android:layout_marginHorizontal="80dp"
        android:paddingVertical="10dp"/>
</LinearLayout>
