<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.panel.topic.TopicView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_black_r16_a20"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="FrameLayout"
    app:binding="true">
    <include
        android:id="@+id/collapse_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        layout="@layout/live_virtual_voice_panel_collapse_view"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="解封什么时候去日本"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center_horizontal"
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="#闲聊唠嗑"
            android:layout_below="@+id/title"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center"
            android:id="@+id/edit"
            android:background="@drawable/live_bg_white_r10_a05"
            android:paddingLeft="12dp"
            android:paddingTop="9dp"
            android:paddingRight="12dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:text="编辑"
            android:drawableLeft="0x7f08275c"
            android:drawablePadding="3dp"
            android:layout_below="@+id/tag"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.panel.topic.TopicView>
