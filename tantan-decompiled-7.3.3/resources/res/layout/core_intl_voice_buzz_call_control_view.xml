<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    folder="ui"
    holder="lovebuzz.voice.view.VoiceBuzzCallControlView">
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/add_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:default_icon="@drawable/core_intl_love_buzz_add_time_btn_selector"
        app:default_text="@string/INTL_BUZZ_VOICE_CALLING_ADDTIME"
        app:icon_width="103dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/add_time_count"
        android:background="@drawable/core_intl_love_buzz_red_dot_with_stroke"
        android:padding="5dp"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="54dp"
        android:maxLines="1"
        android:layout_marginStart="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/add_time"
        app:layout_constraintStart_toStartOf="@+id/add_time"
        app:typeface="medium"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/mic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:default_icon="0x7f080b05"
        app:default_text="@string/INTL_BUZZ_VOICE_CALLING_MIC_ON"
        app:layout_constraintEnd_toStartOf="@+id/add_time"
        app:layout_constraintTop_toTopOf="@+id/add_time"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/quit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:default_icon="0x7f080aff"
        app:default_text="@string/INTL_BUZZ_VOICE_CALLING_EXIT"
        app:layout_constraintEnd_toStartOf="@+id/mic"
        app:layout_constraintTop_toTopOf="@+id/add_time"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/speaker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:default_icon="0x7f080b11"
        app:default_text="@string/INTL_BUZZ_VOICE_CALLING_SPEAKER_ON"
        app:layout_constraintStart_toEndOf="@+id/add_time"
        app:layout_constraintTop_toTopOf="@+id/add_time"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzControlView
        android:id="@+id/like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:default_icon="0x7f080b02"
        app:default_text="@string/INTL_BUZZ_VOICE_CALLING_LIKE"
        app:layout_constraintStart_toEndOf="@+id/speaker"
        app:layout_constraintTop_toTopOf="@+id/add_time"/>
</merge>
