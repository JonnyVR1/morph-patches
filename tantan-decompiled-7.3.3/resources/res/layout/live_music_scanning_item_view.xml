<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.music.MusicScanningItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="78dp">
    <p151v.VDraweeView
        android:id="@+id/cover"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f08236b"
        app:roundedCornerRadius="8dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:id="@+id/live_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="24dp"
        android:singleLine="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/cover"
        app:layout_constraintRight_toLeftOf="@+id/select_view"
        app:layout_constraintTop_toTopOf="@+id/cover"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66ffffff"
        android:id="@+id/live_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        app:layout_constraintLeft_toRightOf="@+id/cover"
        app:layout_constraintTop_toBottomOf="@+id/live_title"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66ffffff"
        android:id="@+id/live_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        app:layout_constraintLeft_toRightOf="@+id/live_duration"
        app:layout_constraintTop_toBottomOf="@+id/live_title"/>
    <p151v.VImage
        android:id="@+id/select_view"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/live_selector_voice_preview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/mask_view"
        android:background="#992a2f37"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.external.intl.music.MusicScanningItemView>
