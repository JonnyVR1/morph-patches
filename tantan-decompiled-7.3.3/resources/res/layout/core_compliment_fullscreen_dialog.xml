<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layoutrootview"
    android:background="@color/common_white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="ui"
    holder="compliment.ComplimentFullScreenDialog">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.AutoVDraweeView
            android:layout_gravity="top"
            android:id="@+id/top_gradient_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <FrameLayout
                android:id="@+id/title_bar"
                android:background="@color/common_white"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="0x7f080a7f"
                    android:layout_marginStart="10dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/title_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VText
                        android:textSize="21sp"
                        android:textColor="@color/common_black"
                        android:ellipsize="end"
                        android:id="@+id/title_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="200dp"
                        android:lines="1"
                        app:fontWeight="600"/>
                    <p151v.VText
                        android:textSize="21sp"
                        android:textColor="@color/common_black"
                        android:id="@+id/title_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:paddingStart="6dp"
                        app:fontWeight="600"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/compliment_count_container"
                    android:background="@drawable/core_shape_circle_gold"
                    android:layout_width="30dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="15dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#c1a874"
                        android:layout_gravity="center"
                        android:id="@+id/compliment_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontWeight="600"/>
                </FrameLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/subtitle_area"
                android:background="@color/common_white"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                flatten="true">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/subtitle_root"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="34dp"
                    android:layout_marginRight="40dp"
                    android:layout_marginHorizontal="40dp"
                    flatten="true">
                    <p151v.VImage
                        android:id="@+id/subtitle_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="0x7f080a8d"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#66ffe7a8"
                        android:gravity="center"
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:fontWeight="500"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/photo_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="46dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <FrameLayout
            android:id="@+id/tab_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            flatten="true">
            <FrameLayout
                android:layout_gravity="start"
                android:id="@+id/tab_paid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="156dp"
                android:elevation="2dp"
                flatten="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/tab_paid"
                    android:background="0x7f080a8c"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="24dp"
                    flatten="true">
                    <p151v.VImage
                        android:id="@+id/tab_paid_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="0x7f0809b8"
                        android:layout_marginEnd="6dp"
                        app:tint="#c0a773"/>
                    <p151v.VText_NoTopPadding
                        android:textSize="14sp"
                        android:textColor="#c0a773"
                        android:id="@+id/tab_paid_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/INTL_COMPLIMENT_TAB_NAME"/>
                </LinearLayout>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="end"
                android:id="@+id/tab_free_container"
                android:clipChildren="false"
                android:layout_width="189dp"
                android:layout_height="54dp"
                android:elevation="1dp"
                flatten="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/tab_free"
                    android:background="0x7f080a91"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    flatten="true">
                    <p151v.VImage
                        android:id="@+id/tab_free_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="0x7f0809b9"
                        android:layout_marginEnd="6dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/tab_free_text_container"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <p151v.VText_NoTopPadding
                            android:textSize="14sp"
                            android:textColor="@color/common_white"
                            android:id="@+id/tab_free_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/INTL_WHISPER_TAB_NAME"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <p151v.VText_NoTopPadding
                            android:textSize="9sp"
                            android:textColor="@color/common_white"
                            android:id="@+id/free_label"
                            android:background="@drawable/core_bg_compliment_free_label"
                            android:paddingLeft="6dp"
                            android:paddingTop="2dp"
                            android:paddingRight="6dp"
                            android:paddingBottom="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FREE"
                            android:translationX="-18dp"
                            android:translationY="1dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            app:layout_constraintBottom_toTopOf="@+id/tab_free_text"
                            app:layout_constraintStart_toEndOf="@+id/tab_free_text"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_content"
            android:background="#131110"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/quick_compliment_container"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="12dp"
                android:paddingEnd="16dp"
                android:layout_marginHorizontal="12dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/input_send_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                flatten="true">
                <FrameLayout
                    android:id="@+id/input_container"
                    android:background="@drawable/core_bg_compliment_input"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    flatten="true">
                    <p151v.VEditText
                        android:textSize="16sp"
                        android:textColor="@color/common_white"
                        android:textColorHint="#4dffffff"
                        android:id="@+id/input"
                        android:background="@null"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/INTL_COMPLIMENT_VIEW_INPUT_PLACEHOLDER"
                        android:maxLines="5"
                        android:minLines="1"
                        android:inputType="textMultiLine"
                        android:imeOptions="actionSend"
                        app:fontWeight="400"/>
                </FrameLayout>
                <p151v.VImage
                    android:layout_gravity="bottom"
                    android:id="@+id/send_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="0x7f080a80"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
