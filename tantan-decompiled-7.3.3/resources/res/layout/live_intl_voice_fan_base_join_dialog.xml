<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="480dp">
        <p151v.VDraweeView
            android:layout_gravity="bottom"
            android:id="@+id/background"
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="17dp"
            app:actualImageScaleType="centerCrop"/>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:background="@drawable/live_bg_19191e_oval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="19dp">
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="3dp"
                    app:roundAsCircle="true"/>
            </FrameLayout>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:id="@+id/user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="24dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="24dp">
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medal"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginRight="16dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/live_white_50_opacity"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/member_num_text"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="权益名称"
                    android:drawablePadding="4dp"/>
            </p151v.VLinear>
            <FrameLayout
                android:background="0x7f082391"
                android:layout_width="match_parent"
                android:layout_height="159dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="20dp">
                <com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.GradientTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:background="0x7f082392"
                    android:layout_width="210dp"
                    android:layout_height="32dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_PRIVILEGE"
                    app:gradientEndColor="#ff6ee2"
                    app:gradientStartColor="#ffd6f7"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="26dp"
                    android:layout_marginTop="51dp">
                    <p151v.VDraweeView
                        android:id="@+id/reward_icon_1"
                        android:layout_width="70dp"
                        android:layout_height="70dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/live_white_60_opacity"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/reward_name_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="78dp"
                        android:text="权益名称"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="51dp">
                    <p151v.VDraweeView
                        android:id="@+id/reward_icon_2"
                        android:layout_width="70dp"
                        android:layout_height="70dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/live_white_60_opacity"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/reward_name_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="78dp"
                        android:text="权益名称"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_gravity="right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="51dp"
                    android:layout_marginRight="26dp">
                    <p151v.VDraweeView
                        android:id="@+id/reward_icon_3"
                        android:layout_width="70dp"
                        android:layout_height="70dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/live_white_60_opacity"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/reward_name_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="78dp"
                        android:text="权益名称"/>
                </FrameLayout>
            </FrameLayout>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/bottom_button"
                android:background="@drawable/live_intl_voice_fan_base_join_button_bg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="52dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="46dp">
                <View
                    android:background="0x7f08238a"
                    android:layout_width="26dp"
                    android:layout_height="22dp"
                    android:layout_marginRight="4dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/bottom_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="立即加入"/>
                <View
                    android:background="0x7f08238a"
                    android:layout_width="26dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="4dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </FrameLayout>
</p151v.VLinear>
