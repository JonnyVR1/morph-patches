<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkSuggestAnchorItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="recreation"
    holder="pk.view.PkSuggestAnchorItemView">
    <TextView
        android:textSize="18dp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/rank"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_head"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_centerVertical="true"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="12dp"
        android:layout_weight="1"
        android:layout_toLeftOf="@+id/tv_pk_invite"
        android:layout_toRightOf="@+id/iv_head">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:id="@+id/tv_anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="6"
            android:singleLine="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/tv_anchor_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_pk_invite"
        android:background="@drawable/live_shape_pk_invite_bg_domestic"
        android:layout_width="72dp"
        android:layout_height="34dp"
        android:text="邀请PK"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/text_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkSuggestAnchorItemView>
