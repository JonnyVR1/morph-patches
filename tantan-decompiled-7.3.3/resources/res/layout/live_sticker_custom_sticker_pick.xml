<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.LiveCustomStickerPickView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.bottom.sticker"
    holder="LiveCustomStickerPickView"
    useRefId="true">
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="609dp"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:id="@+id/title"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_GIFT_STICKER"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/back_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="17dp"
            android:src="0x7f0822e2"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/title_line"
            android:background="@drawable/live_bg_white_r1_a03"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/sticker_gift_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/LIVE_GIFT_STICKER"
            app:layout_constraintStart_toStartOf="@+id/back_icon"
            app:layout_constraintTop_toBottomOf="@+id/title_line"/>
        <p151v.VPager
            android:id="@+id/pager"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="242dp"
            android:layout_marginTop="6dp"
            android:divider="@null"
            android:overScrollMode="never"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@+id/sticker_gift_title"/>
        <com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogIndicator
            android:gravity="center_vertical"
            android:id="@+id/indicator"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginBottom="16dp"
            app:fillColor="@color/live_white_60_opacity"
            app:gift_indicator_radius="6dp"
            app:layout_constraintEnd_toEndOf="@+id/pager"
            app:layout_constraintStart_toStartOf="@+id/pager"
            app:layout_constraintTop_toBottomOf="@+id/pager"
            app:pageColor="@color/live_white_10_opacity"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/sticker_bg_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/LIVE_SET_STICKER_BACKGROUND"
            app:layout_constraintStart_toStartOf="@+id/back_icon"
            app:layout_constraintTop_toBottomOf="@+id/pager"/>
        <p151v.VRecyclerView
            android:id="@+id/sticker_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sticker_bg_sub_title"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/submit_bt"
            android:background="@drawable/live_bg_ff8817_r16"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="33dp"
            android:text="@string/LIVE_SET_STICKER_CONFIRM"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.LiveCustomStickerPickView>
