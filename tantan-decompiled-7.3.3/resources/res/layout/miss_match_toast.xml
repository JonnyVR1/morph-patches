<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.GPHomeMissMatchView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    flatten="true"
    folder="newui"
    holder="home.GPHomeMissMatchView">
    <p151v.VFrame
        android:id="@+id/toast"
        android:background="@drawable/home_miss_match_toast_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <RelativeLayout
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/notification_see_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="0x7f081a6d"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"/>
            <p151v.VImage
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="0x7f0828dc"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#424242"
                android:id="@+id/notification_see_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@+id/notification_see_avatar"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#424242"
                android:id="@+id/notification_see_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="4dp"
                android:layout_toRightOf="@+id/notification_see_avatar"
                android:layout_below="@+id/notification_see_title"
                app:typeface="regular"/>
        </RelativeLayout>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.newui.home.GPHomeMissMatchView>
