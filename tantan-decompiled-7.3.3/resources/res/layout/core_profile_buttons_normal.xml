<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/root"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="142dp"
    flatten="true"
    holder="profile.profilelist.buttons.layout.NormalButtonLayout">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/buttons_bg"
        android:background="@drawable/core_profile_buttons_bg_expand"
        android:layout_width="match_parent"
        android:layout_height="142dp"/>
    <p151v.VLinear
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/like_and_dislike_refactor"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <p151v.VLinear
            android:id="@+id/btn_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            flatten="true">
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/dislike_shadow"
                android:background="@drawable/core_card_profile_expand_btn_bg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/dislike_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="0x7f081fc4"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/superlike_shadow"
                android:background="@drawable/core_card_profile_expand_btn_bg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/superlike_btn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="0x7f081fca"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/like_shadow"
                android:background="@drawable/core_card_profile_expand_btn_bg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/like_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="0x7f081fc5"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <p151v.VLinear
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/match"
                android:background="@drawable/core_card_btn_match_bg"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginBottom="1dp"
                android:minWidth="122dp"
                android:paddingStart="20dp"
                android:elevation="1dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="0x7f081fc7"
                    android:scaleType="centerCrop"/>
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="16sp"
                    android:textColor="#f9e7ff"
                    android:gravity="center"
                    android:id="@+id/match_remaining_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_INSTANT_MATCH_BTN"
                    android:layout_marginStart="6dp"/>
            </p151v.VLinear>
            <RelativeLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/chat_shadow"
                android:background="@drawable/core_card_profile_expand_btn_bg"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="50dp"
                android:layout_marginBottom="1dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/chat_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="0x7f081fc9"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </p151v.VLinear>
    </p151v.VLinear>
</FrameLayout>
