<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveSquareActiveGiftDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="intl"
    holder="view.widgets.IntlLiveSquareActiveGiftDialogView">
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cover"
        android:layout_width="311dp"
        android:layout_height="208dp"
        fresco:roundBottomLeft="false"
        fresco:roundBottomRight="false"
        fresco:roundTopLeft="true"
        fresco:roundTopRight="true"
        fresco:roundedCornerRadius="20dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/button"
        android:background="@drawable/live_bg_fe7e1d_r16"
        android:layout_width="247dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#33000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ignore_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/ACTION_CANCEL"/>
</com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveSquareActiveGiftDialogView>
