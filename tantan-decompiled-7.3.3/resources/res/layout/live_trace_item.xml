<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.debugdialog.TracetItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/item_network_feed_root_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="8dp"
    flatten="true"
    holder="common.debugdialog.TracetItemView">
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/view_trace_status"
        android:background="@color/green"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_weight="1">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/dark_gray"
            android:id="@+id/tv_trace_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="ksksksksksksk"/>
        <com.p051p1.mobile.putong.live.livingroom.common.debugdialog.TraceView
            android:id="@+id/trace_detail_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/tv_trace_key"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.live.livingroom.common.debugdialog.TracetItemView>
