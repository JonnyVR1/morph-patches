<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    folder="newui"
    holder="profile.newmine.newprofile.block.NewUserInfoBlockViewModel">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_info_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <FrameLayout
            android:id="@+id/base_info_view_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:id="@+id/ideal_guide"
            android:background="@drawable/core_ideal_guide_in_mine_tab_bg"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="15sp"
                    android:textColor="#333030"
                    android:id="@+id/ideal_guide_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="你在首页曝光较少，需完善资料"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/core_black_opacity_30"
                    android:id="@+id/ideal_guide_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="完善资料符合更多人理想型，提升曝光"/>
            </LinearLayout>
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="13sp"
                android:textColor="#ff700b"
                android:gravity="center"
                android:id="@+id/ideal_guide_button"
                android:background="@drawable/core_ideal_guide_in_mine_tab_button"
                android:layout_width="66dp"
                android:layout_height="40dp"
                android:text="去完善"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/top_like_detail_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="73dp"
            flatten="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/get_praise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                flatten="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="18sp"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_get_praise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        app:typeface="medium"/>
                    <p151v.VOnlineIndicator
                        android:layout_gravity="center_vertical"
                        android:id="@+id/get_praise_dot"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/tv_get_praise"
                        app:indicatorStyle="style01"/>
                </RelativeLayout>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_66000000"
                    android:gravity="center_vertical"
                    android:id="@+id/get_praise_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/COUNT_LIKE"/>
            </LinearLayout>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/get_praise_div"
                android:background="#07000000"
                android:layout_width="3dp"
                android:layout_height="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/like_me"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                flatten="true">
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_like_me_layout"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VText
                        android:textSize="18sp"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_like_me"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        app:typeface="medium"/>
                    <p151v.VText
                        android:textSize="18sp"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_like_me_increase_num"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        app:typeface="medium"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/like_me_num_badge_tv"
                        android:background="@drawable/core_o_diamond_visitor_badge_num_bg"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginLeft="-5dp"
                        android:layout_marginTop="-12dp"
                        android:minWidth="22dp"
                        android:lines="1"
                        android:layout_toRightOf="@+id/tv_like_me"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/like_me_subtitle_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/core_color_66000000"
                        android:gravity="center_vertical"
                        android:id="@+id/like_me_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/CORE_SEEOPTIMIZING_LIKEME"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_gravity="center_vertical"
                android:background="#07000000"
                android:layout_width="3dp"
                android:layout_height="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/me_like"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                flatten="true">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="@color/common_black_80"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_me_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_66000000"
                    android:gravity="center_vertical"
                    android:id="@+id/me_like_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/CORE_MYPAGE_ILIKE"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/visitor_entry"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                flatten="true">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#07000000"
                    android:layout_width="3dp"
                    android:layout_height="20dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/visitor_content_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    flatten="true">
                    <p151v.VText
                        android:textSize="18sp"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:id="@+id/visitor_num_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/visitor_num_subtitle_container"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:typeface="medium"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/visitor_num_subtitle_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/visitor_num_tv"
                        app:layout_constraintVertical_chainStyle="packed"
                        flatten="true">
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="@color/core_color_66000000"
                            android:gravity="center_vertical"
                            android:id="@+id/visitor_entry_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="看过我"/>
                    </LinearLayout>
                    <androidx.legacy.widget.Space
                        android:id="@+id/visitor_reference_point"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:layout_marginBottom="23dp"
                        android:layout_marginEnd="5dp"
                        app:layout_constraintBottom_toBottomOf="@+id/visitor_num_tv"
                        app:layout_constraintRight_toRightOf="@+id/visitor_num_tv"/>
                    <p151v.VOnlineIndicator
                        android:id="@+id/visitor_red_dot"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:indicatorStyle="style01"
                        app:layout_constraintLeft_toRightOf="@+id/visitor_reference_point"
                        app:layout_constraintTop_toTopOf="@+id/visitor_reference_point"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/visitor_num_badge_tv"
                        android:background="@drawable/core_o_diamond_visitor_badge_num_bg"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginBottom="11dp"
                        android:minWidth="22dp"
                        android:lines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/visitor_num_tv"
                        app:layout_constraintLeft_toRightOf="@+id/visitor_reference_point"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_me_moment_divider"
                android:background="#07000000"
                android:visibility="gone"
                android:layout_width="3dp"
                android:layout_height="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/tv_me_moment"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                flatten="true">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="@color/common_black_80"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_me_moment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_66000000"
                    android:gravity="center_vertical"
                    android:id="@+id/me_moment_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="我的动态"/>
            </LinearLayout>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/nearby_people_divider"
                android:background="#07000000"
                android:visibility="gone"
                android:layout_width="3dp"
                android:layout_height="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/nearby_people_layout"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                flatten="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="18sp"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:id="@+id/nearby_people_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        app:typeface="medium"/>
                    <p151v.VOnlineIndicator
                        android:layout_gravity="center_vertical"
                        android:id="@+id/nearby_people_red"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/nearby_people_tv"
                        app:indicatorStyle="style01"/>
                </RelativeLayout>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_66000000"
                    android:gravity="center_vertical"
                    android:id="@+id/nearby_people_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="附近"/>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/core_card_expose_pause_warn"/>
    </LinearLayout>
</p151v.VFrame>
