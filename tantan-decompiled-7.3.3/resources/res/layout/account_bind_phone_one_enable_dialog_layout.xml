<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="379dp">
    <p151v.VButton
        android:id="@+id/bt_process_continue_opt"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:text="同意并绑定此手机号"
        android:layout_alignParentBottom="true"
        style="@style/common_button_large_01"/>
    <p151v.VImage
        android:id="@+id/iv_process_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="26dp"
        android:src="0x7f08018f"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <p151v.VText
        android:textSize="32sp"
        android:textColor="#cc000000"
        android:id="@+id/iv_process_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="38dp"
        android:text=""
        android:layout_below="@+id/tv_process_title_tip"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#fe7e1d"
        android:id="@+id/iv_process_login_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="18dp"
        android:text="使用其他手机号"
        android:layout_below="@+id/iv_process_number"/>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="#000000"
        android:gravity="left"
        android:id="@+id/iv_process_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="40dp"
        android:text="请绑定手机号"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#33000000"
        android:textColorHighlight="@color/transparent"
        android:textColorLink="#fe7e1d"
        android:gravity="left"
        android:id="@+id/tv_process_title_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="40dp"
        android:text="根据国家实名要求，阅读并同意完成手机号绑定，《》、《用户协议》、《隐私策略》"
        android:layout_below="@+id/iv_process_title"/>
</p151v.VRelative>
