<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceHasPrivilegeView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    holder="banner.view.PrivilegeEntranceHasPrivilegeView">
    <p151v.VImage
        android:id="@+id/texture"
        android:layout_width="337dp"
        android:layout_height="66dp"
        android:src="0x7f08124e"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginStart="7dp"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/light_svga"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VImage
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/light_icon_svga"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="11dp"/>
    <p151v.VImage
        android:id="@+id/iv_privilege_icon"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        android:layout_marginTop="19dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="60dp"/>
    <p151v.VText
        android:textSize="12dp"
        android:ellipsize="end"
        android:id="@+id/vip_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:maxLines="2"
        android:layout_marginStart="27dp"/>
    <p151v.VImage
        android:id="@+id/vip_go"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080d04"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceHasPrivilegeView>
