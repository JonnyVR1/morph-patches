<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true">
    <p151v.VImage
        android:id="@+id/error_icon"
        android:layout_width="220dp"
        android:layout_height="150dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/LIVE_GIFT_NET_WORK_ERROR_TIPS"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_ff8817"
        android:gravity="center_vertical"
        android:id="@+id/refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/LIVE_CLICK_TO_REFRESH"/>
</p151v.VLinear>
