<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.avatar.AvatarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common"
    holder="avatar.AvatarView">
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/live_shape_bg_black_tran20_r13"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="39dp"
        android:layout_marginLeft="13dp"
        android:paddingStart="24dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            flatten="true">
            <p151v.VText
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="70dp"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_white"
                    android:gravity="top"
                    android:layout_gravity="top"
                    android:id="@+id/heart"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/LIVE_ANCHOR_PROFILE_HEARTBEAT"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/follow_back"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            flatten="true">
            <com.p051p1.mobile.putong.live.livingroom.common.avatar.view.AvatarShineView
                android:layout_gravity="center"
                android:id="@+id/follow_shine"
                android:background="@drawable/live_bg_ff8817_r10"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="28dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/follow"
                android:background="@drawable/live_bg_ff8817_r10"
                android:visibility="invisible"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:text="@string/LIVE_FOLLOW"
                flatten="true"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/img_fan_club"
                android:background="@drawable/live_bg_f838ff_r10"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="28dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/pic_fan_club"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    app:srcCompat="0x7f082351"/>
                <p151v.VImage
                    android:layout_gravity="end|top"
                    android:id="@+id/red_point"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="-2dp"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="-1dp"
                    app:srcCompat="@drawable/live_shape_bg_red_point_2dp"/>
            </FrameLayout>
        </FrameLayout>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/svga"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="39dp"
        android:layout_marginLeft="23dp"
        android:scaleType="fitXY"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="#ffff34"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/join_fans"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:text="@string/LIVE_FANS_CLUB_JOIN_FANS_CLUB"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="-3dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.avatar.AvatarView>
