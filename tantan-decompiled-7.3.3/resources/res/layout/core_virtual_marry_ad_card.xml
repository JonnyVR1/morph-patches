<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.home.view.MarryAdCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    holder="home.view.MarryAdCardView">
    <p151v.VDraweeView
        android:id="@+id/marry_card_bg_img"
        android:background="@drawable/core_marry_ad_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:src="0x7f080dce"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="22dp"
            android:textColor="@color/common_000000_80"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="“以结婚为目的”的恋爱"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="28dp"
            android:text="严格筛选，人工审核，真实可靠，拒绝虚假理想伴侣、工作收入、家庭背景，一目了然"/>
        <com.p051p1.mobile.putong.core.p058ui.home.view.AutoScaleChildFrameLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="36dp"
            android:layout_weight="1">
            <p151v.VFrame
                android:layout_gravity="center"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_width="272dp"
                    android:layout_height="259dp"
                    android:src="0x7f080da2"/>
                <p151v.VFrame
                    android:layout_gravity="bottom|center_horizontal"
                    android:clipChildren="false"
                    android:layout_width="183dp"
                    android:layout_height="272dp">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:layout_gravity="center"
                        android:id="@+id/marry_avatar_img"
                        android:layout_width="183dp"
                        android:layout_height="272dp"
                        app:actualImageScaleType="centerCrop"
                        app:roundBottomLeft="true"
                        app:roundBottomRight="true"
                        app:roundTopLeft="true"
                        app:roundTopRight="true"
                        app:roundedCornerRadius="16dp"/>
                    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                        android:textSize="10dp"
                        android:textColor="#ffffff"
                        android:background="@drawable/core_marry_adcard_label_bg"
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="9dp"
                        android:layout_marginTop="9dp"
                        android:text="期望一年之内结婚"/>
                    <View
                        android:layout_gravity="bottom"
                        android:background="@drawable/core_marry_adcard_shadow_bg"
                        android:layout_width="match_parent"
                        android:layout_height="69dp"/>
                    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:layout_gravity="bottom"
                        android:id="@+id/ad_info_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginBottom="10dp"/>
                    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                        android:textSize="16dp"
                        android:textColor="#ffffff"
                        android:layout_gravity="bottom"
                        android:id="@+id/ad_name_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginBottom="31dp"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:layout_width="42dp"
                        android:layout_height="38dp"
                        android:layout_marginRight="-10dp"
                        android:layout_marginBottom="-5dp"
                        android:src="0x7f080da3"/>
                </p151v.VFrame>
            </p151v.VFrame>
        </com.p051p1.mobile.putong.core.p058ui.home.view.AutoScaleChildFrameLayout>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16dp"
            android:textColor="#ff837f"
            android:gravity="center"
            android:id="@+id/action_btn"
            android:background="@drawable/core_fake_dailog_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="40dp"
            android:text="我要参加"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.home.view.MarryAdCardView>
