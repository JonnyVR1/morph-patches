<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="lovebuzz.common.BaseBuzzSearchModel">
    <p151v.VImage
        android:id="@+id/stop_search"
        android:background="0x7f080b09"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/buzz_search_anim"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.BuzzCircleCountdownView
        android:id="@+id/process_circle"
        android:visibility="gone"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/search_peer_avatar"
        app:layout_constraintEnd_toEndOf="@+id/search_peer_avatar"
        app:layout_constraintStart_toStartOf="@+id/search_peer_avatar"
        app:layout_constraintTop_toTopOf="@+id/search_peer_avatar"/>
    <p151v.VDraweeView
        android:id="@+id/search_peer_avatar"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f080b0a"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderWidth="4dp"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/bundle_anim"
        android:visibility="gone"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/vb_peer_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/search_peer_avatar"
        app:layout_constraintStart_toStartOf="@+id/search_peer_avatar"
        app:layout_constraintTop_toBottomOf="@+id/search_peer_avatar"
        app:typeface="medium"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vb_peer_name">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/vb_peer_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:layout_weight="1"/>
        <p151v.VImage
            android:id="@+id/peer_region"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"/>
    </p151v.VLinear>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/connect_anim"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/search_buzz_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/refuse_buzz"
        android:background="@drawable/core_intl_video_buzz_pass_btn_selector"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/INTL_BUZZ_BUTTON_PASS"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/accept_buzz"
        app:layout_constraintEnd_toStartOf="@+id/accept_buzz"
        app:layout_constraintStart_toStartOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/accept_buzz"
        android:background="@drawable/core_intl_video_buzz_back_btn_selector"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="54dp"
        android:text="@string/INTL_BUZZ_BUTTON_ACCEPT"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/refuse_buzz"
        app:typeface="medium"/>
    <ViewStub
        android:id="@+id/buzz_marquee"
        android:layout="@layout/core_intl_buzz_marquee_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/search_buzz_desc"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_80000000"
        android:gravity="center"
        android:id="@+id/search_buzz_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="58dp"
        android:text="@string/INTL_BUZZ_STATUS_SEARCHING"
        android:maxLines="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:typeface="regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
