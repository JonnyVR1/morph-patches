<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.verification.remind.view.SimpleUpdateAvatarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="verification.remind.view.SimpleUpdateAvatarView">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center"
        android:id="@+id/avatar_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="10dp"/>
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/uploading"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:indeterminateOnly="true"
        app:cpb_color="@color/tantan_orange"
        app:cpb_stroke_percentage="0.1"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/waring_tips"
        android:background="@drawable/core_avatar_confirm_waring_tips_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="10dp"
        android:text="未检测到五官"
        android:drawableLeft="@drawable/core_avatar_confirm_warning_ic"
        android:drawablePadding="2dp"/>
</com.p051p1.mobile.putong.core.p058ui.verification.remind.view.SimpleUpdateAvatarView>
