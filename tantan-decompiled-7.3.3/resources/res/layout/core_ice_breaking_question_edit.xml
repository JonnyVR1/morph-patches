<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.question.IceBreakingQuestionEditViewModel">
    <p151v.VFrame
        android:id="@+id/top_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/close"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080721"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="20sp"
        android:textStyle="normal"
        android:textColor="#212121"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_action_bar"
        app:typeface="medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/selected_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="166dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        flatten="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/select_topic_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <RelativeLayout
            android:id="@+id/self_define"
            android:background="@drawable/core_ice_breaking_question_item_bg"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <p151v.VImage
                android:id="@+id/add_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="18dp"
                app:srcCompat="@drawable/core_ice_breaking_question_add_icon"
                ignore="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#de000000"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="自定义"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="16dp"
                android:layout_toEndOf="@+id/add_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/add_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="16dp"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/suggest_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="30dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selected_layout"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="推荐问题"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#ff5435"
            android:gravity="end|center_vertical"
            android:layout_gravity="end"
            android:id="@+id/refresh_recommend_questions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="换一批"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/core_refresh_ice_breaking_question"
            android:layout_alignParentEnd="true"
            app:typeface="regular"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/suggest_title"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggest_topic_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <p151v.VButton
            android:enabled="false"
            android:textSize="17sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/save"
            android:background="@drawable/core_ice_breaking_question_save_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ACTION_SAVE"
            android:lineSpacingExtra="1sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
