<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    flatten="true"
    holder="messages.model.MessageChatFireSettingViewModel">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:id="@+id/spark_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginRight="63dp"
            android:text="聊天火花"/>
        <p151v.VSwitchButton
            android:enabled="false"
            android:layout_gravity="right"
            android:id="@+id/spark_switch_button"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:layout_marginTop="13dp"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="#66000000"
            android:id="@+id/spark_des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:layout_marginRight="57dp"
            android:layout_marginBottom="7dp"
            android:text="开启后，将通过聊天火花记录你们的聊天情况，同时可解锁更多功能"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/show_relationship"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="15dp"
            android:textColor="#33000000"
            android:id="@+id/partner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginRight="57dp"
            android:text="展示密友关系"/>
        <p151v.VSwitchButton
            android:enabled="false"
            android:layout_gravity="right"
            android:id="@+id/partner_switch_button"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:layout_marginTop="13dp"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="#33000000"
            android:id="@+id/partner_des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:layout_marginRight="63dp"
            android:layout_marginBottom="7dp"/>
    </FrameLayout>
</p151v.VLinear>
