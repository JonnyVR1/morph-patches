<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallInviteMoreView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bind_extends="ConstraintLayout"
    app:binding="true"
    app:flatten="true">
    <p151v.VText
        android:textSize="21sp"
        android:textColor="#e6000000"
        android:gravity="left"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_MULTI_CALL_INVITE_FRIENDS"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_guard_back"
        app:layout_constraintLeft_toRightOf="@+id/live_guard_back"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_guard_back"/>
    <p151v.VImage
        android:id="@+id/live_guard_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="38dp"
        android:src="0x7f0823e8"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#4d000000"
        android:id="@+id/invite_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/LIVE_MULTI_CALL_INVITE_ACTIVE_FRIENDS"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_guard_back"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="327dp"
        android:layout_marginTop="16dp"
        app:flatten="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invite_hint">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/invited_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            useId="true"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <include
        android:id="@+id/rv_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/refresh"
        app:layout_constraintLeft_toLeftOf="@+id/refresh"
        app:layout_constraintRight_toRightOf="@+id/refresh"
        app:layout_constraintTop_toTopOf="@+id/refresh"
        layout="@layout/live_empty_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/live_bg_black_r14_a03"
        android:paddingRight="24dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:text="@string/LIVE_MULTI_CALL_CONFIRM"
        android:paddingStart="24dp"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/refresh"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallInviteMoreView>
