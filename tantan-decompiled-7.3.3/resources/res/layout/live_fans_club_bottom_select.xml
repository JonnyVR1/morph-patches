<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.fansclub.submodule.recall.FansBottomSelectView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:paddingStart="18dp"
    android:paddingEnd="24dp"
    app:layout_constraintBottom_toBottomOf="parent"
    flatten="true"
    folder="common.fansclub.submodule.recall"
    holder="FansBottomSelectView">
    <p151v.VImage
        android:id="@+id/select_btn"
        android:background="@drawable/live_selector_select_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#99000000"
        android:id="@+id/select_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_ALL_SELECT"
        android:layout_marginStart="10dp"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/recall_btn"
        android:background="@drawable/live_selector_button_recall"
        android:layout_width="92dp"
        android:layout_height="40dp"
        android:text="@string/LIVE_RECALL_BATCH"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#99000000"
        android:id="@+id/cancel_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_ACTION_CANCEL"
        android:layout_marginStart="24dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.fansclub.submodule.recall.FansBottomSelectView>
