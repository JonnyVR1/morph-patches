<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="officialshow.roomcard.OfficialShowCardDialog">
    <View
        android:id="@+id/card"
        android:background="@drawable/live_bg_26173c_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="17dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/head_image_layout"
        flatten="true"/>
    <p151v.VDraweeView
        android:id="@+id/frame_top_static_bg_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card"
        app:placeholderImageScaleType="fitXY"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="24dp"
        app:viewAspectRatio="2.1"/>
    <p151v.VDraweeView
        android:id="@+id/head_image_layout"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/room_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/live_white_90_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.5dp"
        android:singleLine="true"
        android:layout_marginStart="33dp"
        android:layout_marginEnd="33dp"
        app:layout_constraintBottom_toTopOf="@+id/room_live_time_tag"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VFrame
        android:textSize="12sp"
        android:textColor="@color/live_white_90_opacity"
        android:id="@+id/room_live_time_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13.5dp"
        app:layout_constraintBottom_toTopOf="@+id/room_live_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_90_opacity"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直播时间"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f082425"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_70_opacity"
        android:gravity="center"
        android:id="@+id/room_live_time"
        android:background="@drawable/live_shape_bg_2b233c_r10"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginBottom="19dp"
        android:text="每天 · 20:00-24:00"
        android:paddingStart="39dp"
        android:paddingEnd="39dp"
        app:layout_constraintBottom_toTopOf="@+id/room_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/live_white_60_opacity"
        android:gravity="center"
        android:id="@+id/room_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23dp"
        android:text="官方公告：这里是安全健康的公演房间，这里 有美丽动人的歌曲，迷人的舞蹈"
        android:maxLines="3"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toTopOf="@+id/banner_layout"/>
    <com.p051p1.mobile.putong.live.livingroom.view.banner.LiveBannerView
        android:id="@+id/banner_layout"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="@dimen/comm_margin_size_20"
        android:layout_marginEnd="@dimen/comm_margin_size_20"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_button"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_action_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/follow"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="订阅"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#9aa5b1"
        android:gravity="center"
        android:id="@+id/no_data_hint"
        android:background="@drawable/live_bg_black_r11_a10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="356dp"
        android:text="@string/LIVE_PROFILE_DATA_LOAD_FAIL"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
