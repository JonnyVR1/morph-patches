<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="appeal.AppealProgressViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="30dp"
            android:src="0x7f080e31"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#212121"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/APPEAL_REQUEST_SUBMITTED"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/APPEAL_RESULT_NOTIFICATION"/>
    </p151v.VLinear>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:textColor="@color/white"
        android:layout_gravity="bottom"
        android:id="@+id/done"
        android:text="@string/ACTION_DONE"
        style="@style/core_account_continue_button"/>
</p151v.VFrame>
