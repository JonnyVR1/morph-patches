<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetTimeView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetTimeView">
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/day_tv"
        android:background="@drawable/live_shape_voice_sweet_cp_time_number_bg"
        android:paddingLeft="1.5dp"
        android:paddingRight="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:minWidth="14dp"
        android:text="100"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/live_e84b00"
        android:id="@+id/day_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1.5dp"
        android:layout_marginRight="1.5dp"
        android:text="D"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/hour_tv"
        android:background="@drawable/live_shape_voice_sweet_cp_time_number_bg"
        android:paddingLeft="1.5dp"
        android:paddingRight="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:minWidth="14dp"
        android:text="10"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/live_e84b00"
        android:id="@+id/hour_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1.5dp"
        android:layout_marginRight="1.5dp"
        android:text="H"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/minute_tv"
        android:background="@drawable/live_shape_voice_sweet_cp_time_number_bg"
        android:paddingLeft="1.5dp"
        android:paddingRight="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:minWidth="14dp"
        android:text="10"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/live_e84b00"
        android:id="@+id/minute_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1.5dp"
        android:text="M"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetTimeView>
