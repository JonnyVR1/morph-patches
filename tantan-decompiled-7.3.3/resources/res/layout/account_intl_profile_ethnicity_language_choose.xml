<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:importantForAutofill="noExcludeDescendants"
    holder="accountnew.intlsignup.SignUpIntlEthnicityLanguageViewModel"
    style="@style/account_account_root">
    <p151v.VImage
        android:id="@+id/toolbar_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:src="0x7f08200a"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_01"
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/GUESS_ACTION_SKIP"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_icon"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="21sp"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="@string/INTL_REGISTER_ETHNICITY_TITLE"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66000000"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/INTL_REGISTER_ETHNICITY_SUBTITLE"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VRecyclerView
        android:id="@+id/recycler_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_"
        app:layout_constraintTop_toBottomOf="@+id/sub_title"/>
    <p151v.VButton
        android:enabled="true"
        android:id="@+id/continue_"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/ACTION_CONTINUE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/common_button_large_01"/>
</androidx.constraintlayout.widget.ConstraintLayout>
