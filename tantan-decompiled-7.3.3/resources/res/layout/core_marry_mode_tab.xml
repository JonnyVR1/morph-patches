<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui.home.marrymode"
    holder="MarryModeTabViewModel">
    <p151v.VFrame
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <p151v.VFrame
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:id="@+id/spring_festival_activities_inlet"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="48dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:background="@drawable/core_bg_10_ff8473"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp">
                <p151v.VImage
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="0x7f080dbb"
                    android:layout_marginStart="7dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="特别推荐"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="12dp"/>
            </p151v.VLinear>
            <View
                android:layout_gravity="right"
                android:id="@+id/red_dot"
                android:background="@drawable/core_red_dot_12_ff6464"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/msg_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:src="0x7f0818ab"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/msg_unread"
                android:background="@drawable/core_bg_new_all_pairs_unread"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:minWidth="20dp"
                android:layout_alignEnd="@+id/space"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/card_loading"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/core_card_loading_bg"/>
            <p151v.VFrame_Squared
                android:id="@+id/radar"
                android:layout_width="match_parent"
                android:layout_height="416dp"
                android:layout_centerInParent="true"
                android:translationY="-55dp">
                <com.p051p1.mobile.putong.core.p058ui.RadarRipple
                    android:id="@+id/ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:layout_width="@dimen/radar_image_size"
                    android:layout_height="@dimen/radar_image_size"
                    android:outlineSpotShadowColor="#19979797"
                    app:backgroundImage="@color/common_light_04"
                    app:roundingBorderPadding="3dp"
                    style="@style/core_fresco_profile_white_border"/>
            </p151v.VFrame_Squared>
        </RelativeLayout>
        <include
            android:visibility="gone"
            layout="@layout/core_home_net_error_layout"/>
        <com.p051p1.mobile.putong.core.newui.home.marrymode.MarryModeEmptyView
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/conent_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VFrame
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.p051p1.mobile.putong.core.newui.home.marrymode.MarrModeProfileCardView
                    android:id="@+id/profile_list_2"
                    android:background="@drawable/core_bg_20_00000_stroke_ecd3d3"
                    android:padding="1.5px"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:cardViewRadius="19.2dp"
                    app:isUseCardView="true"/>
                <com.p051p1.mobile.putong.core.newui.home.marrymode.MarrModeProfileCardView
                    android:id="@+id/profile_list_1"
                    android:background="@drawable/core_bg_20_00000_stroke_ecd3d3"
                    android:padding="1.5px"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:cardViewRadius="19.2dp"
                    app:isUseCardView="true"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp">
                <p151v.VLinear
                    android:gravity="center_horizontal"
                    android:background="@drawable/core_user_home_card_bottom_shadow_cover_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1.5px">
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp">
                        <p151v.VFrame_Shadow
                            android:id="@+id/dislike_shadow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
                            app:sl_dy="@dimen/core_profile_bottom_dy"
                            app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                            app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
                            flatten="true">
                            <p151v.VLinear
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/replace_one"
                                android:background="@drawable/core_newui_profile_btn_replace_one_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="132dp"
                                android:paddingStart="22dp"
                                android:paddingEnd="22dp"
                                flatten="true">
                                <p151v.VImage
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:src="0x7f0818ac"
                                    android:layout_centerInParent="true"/>
                                <p151v.VText
                                    android:textSize="14dp"
                                    android:textColor="@color/white"
                                    android:id="@+id/replace_one_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="换一个"
                                    android:maxLines="1"
                                    android:layout_marginStart="6dp"
                                    app:typeface="medium"/>
                            </p151v.VLinear>
                        </p151v.VFrame_Shadow>
                        <p151v.VFrame_Shadow
                            android:id="@+id/like_shadow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
                            app:sl_dy="@dimen/core_profile_bottom_dy"
                            app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                            app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
                            flatten="true">
                            <p151v.VLinear
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/like"
                                android:background="@drawable/core_newui_profile_btn_like_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="132dp"
                                android:paddingStart="22dp"
                                android:paddingEnd="22dp"
                                flatten="true">
                                <p151v.VImage
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:src="0x7f0818aa"
                                    android:layout_centerInParent="true"/>
                                <p151v.VText
                                    android:textSize="14dp"
                                    android:textColor="@color/white"
                                    android:id="@+id/like_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_marginStart="6dp"
                                    app:typeface="medium"/>
                            </p151v.VLinear>
                        </p151v.VFrame_Shadow>
                    </p151v.VLinear>
                </p151v.VLinear>
            </p151v.VFrame>
        </FrameLayout>
    </p151v.VFrame>
</p151v.VLinear>
