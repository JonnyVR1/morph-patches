<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="settings.AITranslateSettingViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VLinear
        android:id="@+id/al_translate"
        style="@style/core_intl_settings_stacked_frame">
        <p151v.VText
            android:text="@string/INTL_TT_AITRANSLATE_SETTING_SUBPAGE_LANGUAGELIST"
            style="@style/core_intl_settings_primary"/>
        <p151v.VText
            android:id="@+id/text"
            style="@style/intl_settings_secondary_disable"/>
        <p151v.VIcon
            android:background="0x7f080c4b"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_000000_30"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/INTL_TT_AITRANSLATE_SETTING_SUBPAGE_NOTE"/>
</p151v.VLinear>
