<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="virtual.userCard.VirtualUserCardDialog">
    <View
        android:id="@+id/card"
        android:background="@drawable/live_bg_191919_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/head_image_layout"
        flatten="true"/>
    <include
        android:id="@+id/user_card_skin_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/top_placeholder"
        ignore="true"
        layout="@layout/live_user_card_skin_view"/>
    <Space
        android:id="@+id/top_placeholder"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toTopOf="@+id/card"
        ignore="true"/>
    <FrameLayout
        android:id="@+id/head_image_layout"
        android:background="0x7f0826c3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toTopOf="@+id/medal_and_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"/>
    </FrameLayout>
    <include
        android:id="@+id/medal_and_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_wall_enter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true"
        layout="@layout/live_user_card_dlg_medal_and_name_virtual_voice"/>
    <include
        android:id="@+id/gift_wall_enter"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/sweet_cp_enter"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"
        layout="@layout/live_voice_user_card_gift_wall_layout"/>
    <include
        android:id="@+id/sweet_cp_enter"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/middle_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"
        layout="@layout/live_virtual_voice_sp_friend_head_layout"/>
    <include
        android:id="@+id/middle_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toTopOf="@+id/match_layout"
        layout="@layout/live_virtual_voice_user_card_middle_view"/>
    <include
        android:id="@+id/match_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toTopOf="@+id/line"
        layout="@layout/live_virtual_user_card_match_layout"/>
    <View
        android:id="@+id/line"
        android:background="#05ffffff"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_button"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_action_button"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        flatten="true"/>
    <p151v.VImage
        android:id="@+id/manage"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="18dp"
        app:layout_constraintRight_toRightOf="@+id/card"
        app:layout_constraintTop_toTopOf="@+id/card"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/my_right"
        android:background="@drawable/live_bg_white_r6_a05"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toLeftOf="@+id/card"
        app:layout_constraintTop_toTopOf="@+id/card"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#9aa5b1"
        android:gravity="center"
        android:id="@+id/no_data_hint"
        android:background="@drawable/live_bg_white_tr24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:text="@string/LIVE_PROFILE_DATA_LOAD_FAIL"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/obstructView"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/userCardAnimPlayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/medal_and_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.effect.video.VideoEffectPlayer
        android:id="@+id/cpVideoPlayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/medal_and_name"
        app:layout_constraintDimensionRatio="71:65"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/userCardAnimPlayer1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/head_image_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
