<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.basebuild.notice.VoiceTopNoticeCheckFailDialog xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#4c000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="basebuild.notice.VoiceTopNoticeCheckFailDialog">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/live_bg_white_r20"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        flatten="true">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#323232"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/LIVE_VOICE_TOP_NOTICE_CHECK_FAIL_DIALOG_TITLE"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#999999"
            android:gravity="center"
            android:id="@+id/rule"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="18dp"
            android:text="房间公告内容未通过审核 \10 请修改后重新提交"
            android:lineSpacingExtra="7sp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/argue_continue"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/LIVE_VOICE_TOP_NOTICE_CHECK_FAIL_DIALOG_BTN"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.basebuild.notice.VoiceTopNoticeCheckFailDialog>
