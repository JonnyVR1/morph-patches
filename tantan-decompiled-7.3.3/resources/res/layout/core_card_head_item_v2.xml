<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardHeadLayoutV2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.HeadHomeV2CardExpandedHolder">
    <p151v.VFrame
        android:id="@+id/image_container"
        android:tag="image_container"
        android:background="@drawable/core_bg_20_ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:id="@+id/layout_image"
            layout="@layout/core_expanded_picture_intl_layout"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/shadow_bottom"
            android:background="@drawable/core_card_pic_bottom_shadow_cover_bg_new"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            flatten="true"/>
        <p151v.VImage
            android:layout_gravity="end|bottom"
            android:id="@+id/compliment_btn"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:src="0x7f080a87"
            android:layout_marginEnd="16dp"/>
        <p151v.VFrame
            android:id="@+id/card_info_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="false">
            <com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout
                android:gravity="center_vertical"
                android:id="@+id/top_left_container"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:measureLayoutOrientation="horizontal"
                app:measureReverse="true"
                flatten="true">
                <p151v.VText
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/me_was_liked"
                    android:background="@drawable/core_card_tag_me_by_liked_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="5dp"
                    android:maxLines="1"
                    android:drawableLeft="0x7f0805d4"
                    android:drawablePadding="6dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#edd7a3"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/intl_premium_only"
                    android:background="@drawable/core_card_intl_premium_only_round_corner_bg"
                    android:paddingLeft="6dp"
                    android:paddingRight="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/INTL_PREMIUM_ONLY_BADGE"
                    android:maxLines="1"
                    android:drawableLeft="0x7f080b80"
                    android:drawablePadding="2dp"/>
                <p151v.VFrame
                    android:layout_gravity="center"
                    android:id="@+id/live_tag"
                    android:background="@drawable/core_card_live_tag_round_corner_bg"
                    android:paddingLeft="4dp"
                    android:paddingRight="6dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="5dp"
                    flatten="true">
                    <com.tantan.library.svga.SVGAnimationView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/live_svga"
                        android:layout_width="18dp"
                        android:layout_height="18dp"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/live_tag_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="22dp"
                        android:text="@string/LIVE_LINVING"
                        android:maxLines="1"
                        android:drawablePadding="8dp"
                        app:typeface="regular"/>
                </p151v.VFrame>
            </com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout>
            <android.view.ViewStub
                android:layout_gravity="end|top"
                android:id="@+id/intl_camping"
                android:layout="@layout/core_intl_camping_home_tab"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginTop="15dp"/>
            <ViewStub
                android:layout_gravity="end|top"
                android:id="@+id/intl_buzz_icon_stub"
                android:visibility="gone"
                android:layout="@layout/core_intl_love_buzz_icon_view"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="8dp"/>
            <p151v.VImage
                android:layout_gravity="end|top"
                android:id="@+id/card_certification_btn"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="31dp"
                android:src="0x7f0818a8"
                android:scaleType="centerInside"
                android:layout_marginEnd="16dp"/>
        </p151v.VFrame>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/info_top_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="false">
                <p151v.VImage
                    android:layout_gravity="start|bottom"
                    android:id="@+id/other_superlike_banner"
                    android:visibility="gone"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"/>
                <p151v.VImage
                    android:layout_gravity="start|bottom"
                    android:id="@+id/intl_receive_like_ll_new"
                    android:visibility="gone"
                    android:layout_width="140dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="16dp"
                    flatten="true"/>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:layout_gravity="start|bottom"
                    android:orientation="horizontal"
                    android:id="@+id/intl_receive_like_ll"
                    android:background="@drawable/core_card_intl_like_banner_round_corner_bg"
                    android:paddingLeft="6dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:paddingVertical="3dp"
                    flatten="true">
                    <p151v.VImage
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="0x7f080a72"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:id="@+id/intl_receive_like_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/INTL_PREMIUM_ONLY_LIKE_TAG"
                        android:layout_marginStart="2dp"/>
                </p151v.VLinear>
                <p151v.VImage
                    android:layout_gravity="bottom|left"
                    android:id="@+id/intl_special_card_banner"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"/>
                <ViewStub
                    android:layout_gravity="bottom|left"
                    android:id="@+id/intl_regular_tab"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout="@layout/core_intl_regular_sticker_card_tab_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"/>
                <include
                    android:layout_gravity="bottom|left"
                    android:id="@+id/intl_like_minded_tab"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    layout="@layout/core_intl_like_minded_card_tab_layout"/>
                <android.view.ViewStub
                    android:layout_gravity="bottom|left"
                    android:id="@+id/intl_anim_facial"
                    android:visibility="gone"
                    android:layout="@layout/core_intl_animal_facial_card_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="20dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:layout_gravity="start|bottom"
                    android:id="@+id/iv_new_here"
                    android:background="@drawable/bg_new_here"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_SWIPE_TAG_NEW_HERE"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="18dp"/>
            </FrameLayout>
            <com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedCardInforLayout
                android:id="@+id/expanded_card_infor_layout"
                android:visibility="visible"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
        <View
            android:layout_gravity="bottom|right"
            android:id="@+id/profile_enter_block"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="160dp"/>
        <p151v.VFrame
            android:layout_gravity="bottom"
            android:id="@+id/bottom_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="false">
            <ViewStub
                android:layout_gravity="bottom"
                android:id="@+id/intl_buzz_btn"
                android:visibility="gone"
                android:layout="@layout/core_intl_love_buzz_btn_view"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <ViewStub
                android:layout_gravity="bottom"
                android:id="@+id/commercial_card_bottom_action_layout"
                android:layout="@layout/core_intl_commercial_card_bottom_action_view"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"/>
        </p151v.VFrame>
        <p151v.VImage
            android:layout_gravity="bottom"
            android:id="@+id/newui_superlike_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:src="@drawable/core_newui_profile_superlike_bg"
            android:scaleType="center"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/newui_live_layout"
            android:background="@drawable/core_newui_profile_live_tab_bg"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginBottom="20dp"
            flatten="true">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/newui_live_tag"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </FrameLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/newui_live_text_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/newui_live_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_LINVING"/>
            </LinearLayout>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/newui_live_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080d5a"/>
        </LinearLayout>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.newui.home.views.CardHeadLayoutV2>
