<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/policy"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.agreement.IntlCommonAgreementComponent">
    <TextView
        android:textSize="10sp"
        android:textColor="#7fffffff"
        android:gravity="center"
        android:id="@+id/renewal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/VIP_ALERT_AUTO_RENEWAL_TITLE"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/renewal_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="-7dp"
        android:layout_marginRight="5dp"
        android:text="@string/GP_ALERT_AUTO_RENEWAL_DETAIL"
        android:lineSpacingExtra="3.9sp"
        android:fontFamily="sans-serif"/>
</LinearLayout>
