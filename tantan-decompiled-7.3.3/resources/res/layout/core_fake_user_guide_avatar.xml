<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/core_fake_upload_true_avatar_dlg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="fake.FakeGuideTrueAvatarDialog">
    <ImageView
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:src="0x7f080843"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/light_svga_bg"
        android:layout_width="295dp"
        android:layout_height="128dp"
        android:layout_marginTop="48dp"
        android:layout_centerHorizontal="true"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/light_svga"
        android:layout_width="295dp"
        android:layout_height="128dp"
        android:layout_marginTop="48dp"
        android:layout_centerHorizontal="true"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/bg_svga"
        android:layout_width="295dp"
        android:layout_height="128dp"
        android:layout_marginTop="48dp"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="22dp"
        android:textColor="#d9000000"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="上传真实头像，\10获得最高10倍曝光！"
        android:layout_below="@+id/light_svga"
        android:layout_alignLeft="@+id/light_svga"
        app:typeface="medium"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/post"
        android:background="@drawable/core_fakeuser_guide_avatar_btnbg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="32dp"
        android:text="更换头像"
        android:layout_below="@+id/text"/>
</RelativeLayout>
