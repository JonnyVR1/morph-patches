<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.profile.myroom.view.MyRoomInProfileVideoItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    flatten="true"
    folder="page.profile.myroom.view"
    holder="MyRoomInProfileVideoItemView">
    <p151v.VDraweeView
        android:id="@+id/layout_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/live_bg_bfbfbf_r20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundedCornerRadius="10dp"/>
    <View
        android:background="@drawable/live_shape_my_room_in_newui_profile_total_live_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/avatar_live_frame"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="20dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintBottom_toTopOf="@+id/avatar_layout"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/avatar_live_tag"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/avatar_live_offline"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/avatar_layout"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_vector_room_video_title_bg"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/avatar_layout"
        android:background="@drawable/live_shape_my_room_in_newui_avatar_default_bg"
        android:layout_width="54dp"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="38dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="50dp"
            android:layout_height="40dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/live_shape_my_room_in_newui_avatar_fail_bg"
            app:placeholderImage="@drawable/live_shape_my_room_in_newui_avatar_fail_bg"
            app:roundedCornerRadius="7dp"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/live_top_text"
        android:paddingLeft="8dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="41dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatar_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/live_content"
        android:paddingLeft="8dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatar_layout"
        app:layout_constraintTop_toBottomOf="@+id/live_top_text"/>
</com.p051p1.mobile.putong.live.external.page.profile.myroom.view.MyRoomInProfileVideoItemView>
