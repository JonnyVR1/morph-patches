<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedSquareVoiceItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="visible"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="status.display.statuspage.newtab.FeedSquareVoiceItem">
    <com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedSquareBottomStickoutView
        android:id="@+id/dot_bottom"
        android:layout_width="16dp"
        android:layout_height="9dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="@+id/bubble"
        app:layout_constraintTop_toTopOf="@+id/space_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bubble"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svga"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/value"
            android:paddingTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="144dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/svga"/>
        <include
            android:id="@+id/user_header_view"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/value"
            layout="@layout/feed_header_enter_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/space_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/bubble"/>
</com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedSquareVoiceItem>
