<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.GiftSticker xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common.bottom.sticker"
    holder="GiftSticker">
    <p151v.VText
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="start"
        android:id="@+id/text"
        android:paddingTop="13dp"
        android:layout_width="118dp"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:paddingStart="27dp"
        android:paddingEnd="25dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/gift_bg"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/gift_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/gift_bg"
        app:layout_constraintEnd_toEndOf="@+id/gift_bg"
        app:layout_constraintStart_toStartOf="@+id/gift_bg"
        app:layout_constraintTop_toTopOf="@+id/gift_bg"
        app:roundAsCircle="true"/>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.GiftSticker>
