<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.privacyandpremisson.PrivacyAndPremissonViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VProgressBar
            android:id="@+id/loading_block"
            style="@style/core_loading_block"/>
        <p151v.VScroll
            android:id="@+id/scroll"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:id="@+id/contacts_title"
                    android:layout_marginTop="8dp"
                    android:text="@string/SETTINGS_SECTION_PRIVACY"
                    style="@style/core_settings_header0"/>
                <include layout="@layout/privacy_contacts"/>
                <View
                    android:id="@+id/divider"
                    android:layout_marginTop="7dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:id="@+id/album_title"
                    android:layout_marginTop="8dp"
                    android:text="@string/MOMENT_MY_ALBUM"
                    style="@style/core_settings_header0"/>
                <p151v.VLinear
                    android:id="@+id/do_not_show_my_album_to_not_matched"
                    android:layout_marginTop="0dp"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:id="@+id/do_not_show_my_album_text"
                            android:layout_marginBottom="0dp"
                            android:text="@string/SETTINGS_DO_NOT_SHOW_MY_ALBUM_TO_NOT_MATCHED"
                            android:maxLines="2"
                            style="@style/core_settings_primary"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/do_not_send_moment"
                    android:layout_marginTop="0dp"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <p151v.VText
                        android:gravity="center_vertical"
                        android:id="@+id/do_not_send_moment_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:text="更新头像、自我介绍自动发布动态"
                        android:maxLines="2"
                        android:layout_weight="1"
                        style="@style/core_settings_primary"/>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VLinear>
                <View
                    android:id="@+id/divider_moment"
                    android:layout_marginTop="7dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:id="@+id/mode"
                    android:layout_marginTop="8dp"
                    android:text="模式设置"
                    style="@style/core_settings_header0"/>
                <p151v.VLinear
                    android:id="@+id/marriage_mode_layout"
                    android:layout_marginTop="0dp"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:id="@+id/do_not_show_my_album_text2"
                            android:layout_marginBottom="0dp"
                            android:text="想结婚模式"
                            android:maxLines="2"
                            style="@style/core_settings_primary"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/dark_mode_layout"
                    android:layout_marginTop="0dp"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:layout_marginBottom="0dp"
                            android:text="深色模式"
                            android:maxLines="2"
                            style="@style/core_settings_primary"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:src="0x7f081f64"
                        style="@style/core_settings_arrow"/>
                </p151v.VLinear>
                <View
                    android:id="@+id/divider_mode"
                    android:layout_marginTop="7dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:id="@+id/moments_title"
                    android:layout_marginTop="8dp"
                    android:text="@string/MOMENTS_TITLE"
                    style="@style/core_settings_header0"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="17dp"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <p151v.VFrame
                        android:id="@+id/moments_muted"
                        style="@style/core_settings_clickable_item">
                        <p151v.VText
                            android:id="@+id/title"
                            android:text="@string/SETTINGS_MUTED_USERS"
                            style="@style/core_settings_header1"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:src="0x7f081f64"
                            style="@style/core_settings_arrow"/>
                    </p151v.VFrame>
                    <p151v.VFrame
                        android:id="@+id/like_love_content"
                        android:visibility="gone"
                        style="@style/core_settings_clickable_item">
                        <p151v.VText
                            android:id="@+id/like_love_tv"
                            android:text="点赞后自动喜欢"
                            style="@style/core_settings_header1"/>
                        <p151v.VSwitch
                            android:layout_gravity="center"
                            style="@style/core_settings_item_switch"/>
                    </p151v.VFrame>
                </p151v.VLinear>
            </LinearLayout>
        </p151v.VScroll>
    </p151v.VFrame>
</p151v.VLinear>
