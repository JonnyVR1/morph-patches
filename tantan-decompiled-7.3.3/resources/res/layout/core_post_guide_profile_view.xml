<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_post_guide_profile_bg"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    android:layout_marginBottom="12dp"
    flatten="true">
    <p151v.VDraweeView
        android:id="@+id/post_iv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/core_kankan_card_placeholder"
        app:placeholderImageScaleType="centerInside"
        app:roundAsCircle="false"
        app:roundedCornerRadius="10dp"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/post_feed_tv"
        android:background="@drawable/core_bg_10_fe7e1d"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:maxWidth="100dp"
        android:text="去发布"
        android:maxLines="1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/post_guide_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/post_feed_tv"
        android:layout_toRightOf="@+id/post_iv"
        android:layout_centerVertical="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X位女生/男生看过你后离开了"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:ellipsize="end"
            android:id="@+id/post_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="发布动态，认识更多新朋友"
            android:singleLine="true"/>
    </p151v.VLinear>
</p151v.VRelative>
