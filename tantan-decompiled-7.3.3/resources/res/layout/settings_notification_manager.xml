<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.NotificationManagerAct">
    <p151v.VScroll
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:id="@+id/album_title"
                android:layout_marginTop="8dp"
                android:text="选择开启推送的通知"
                style="@style/core_settings_header0"/>
            <p151v.VLinear
                android:id="@+id/item_new_match"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="新的配对"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="你有新配对了。"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/item_message"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="聊天消息"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="好友发来一条消息。"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/item_super_like"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="超级喜欢"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="有人超级喜欢你。"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/item_moment"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="好友朋友圈"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="有人发布新的朋友圈了。"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/item_weekly"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="探探周报"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="你的探探周报来了"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/item_daily"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="探探日报"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="喜欢你的人都是什么样子"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/item_official_news"
                android:visibility="gone"
                android:layout_marginTop="0dp"
                flatten="true"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="个性化推送消息"
                        android:maxLines="2"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:layout_marginBottom="0dp"
                        android:text="向你推荐喜欢你或新上线的用户。"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/no_disturb"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                flatten="true">
                <View
                    android:layout_marginTop="5dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:layout_marginTop="8dp"
                    android:text="开启夜间勿扰模式"
                    style="@style/core_settings_header0"/>
                <p151v.VLinear
                    android:id="@+id/item_no_disturb"
                    android:layout_marginTop="0dp"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:layout_marginBottom="0dp"
                            android:text="夜间勿扰模式"
                            android:maxLines="2"
                            style="@style/core_settings_primary"/>
                        <p151v.VText
                            android:layout_marginBottom="0dp"
                            android:text="开启后，23：00到8：00期间，将不会收到消息提醒"
                            style="@style/settings_small_des"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VLinear>
            </p151v.VLinear>
        </LinearLayout>
    </p151v.VScroll>
</p151v.VFrame>
