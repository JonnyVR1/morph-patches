<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.packetgift.progress.view.PacketCountdownView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r6_a10"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    flatten="true"
    folder="increment"
    holder="gift.packetgift.progress.view.PacketCountdownView">
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.packetgift.progress.view.CircleCountdownView
        android:id="@+id/circleCountdown"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:circle_ring_color="@color/live_ff8817"
        app:circle_ring_width="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_50_opacity"
        android:gravity="center"
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="21dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/circleCountdown"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.packetgift.progress.view.PacketCountdownView>
