<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.intlmeet.likers.items.IntlMeetLikersItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/new_ui_likers_item_info_bg"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    folder="newui"
    holder="intlmeet.likers.items.IntlMeetLikersItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="5dp"
        style="@style/core_fresco_base"/>
    <p151v.VLinear
        android:id="@+id/super_like_tag_ll"
        android:background="@drawable/core_intl_see_superlike_tag_bg"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:paddingVertical="3dp"
        flatten="true">
        <p151v.VText
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/super_like_tag_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VImage
            android:id="@+id/superlike_tag_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080c43"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/dislike"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081204"/>
    <p151v.VImage
        android:layout_gravity="left"
        android:id="@+id/like"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081205"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/usa_like_btn"
        android:visibility="gone"
        android:drawingCacheQuality="high"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="82dp"
        android:layout_marginRight="7dp"
        android:src="0x7f0829d0"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/usa_dislike_btn"
        android:visibility="gone"
        android:drawingCacheQuality="high"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="138dp"
        android:layout_marginRight="7dp"
        android:src="0x7f0829cc"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/full_card"
        android:background="@drawable/likers_gradient_personal_info_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="96dp">
        <p151v.VLinear_FillerMeasure
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginBottom="1dp"
            android:paddingEnd="40dp"
            app:fillerIndex="0"
            app:layout_constraintBottom_toTopOf="@+id/detail"
            app:layout_constraintStart_toStartOf="parent">
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="#e5ffffff"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/see_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:fontWeight="500"/>
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="#e5ffffff"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/see_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="3dp"
                app:fontWeight="500"/>
            <p151v.VImage
                android:layout_gravity="start|center_vertical"
                android:id="@+id/verification_icon"
                android:background="0x7f082957"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"/>
        </p151v.VLinear_FillerMeasure>
        <p151v.VLinear_FillerMeasure
            android:gravity="center_vertical"
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp"
            app:fillerIndex="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            flatten="true">
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:fontWeight="500"/>
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/job"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:fontWeight="500"/>
        </p151v.VLinear_FillerMeasure>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.newui.intlmeet.likers.items.IntlMeetLikersItemView>
