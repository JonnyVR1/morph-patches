<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="pricerecall.PriceRecallTellPriceDialog2">
    <p151v.VImage
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginRight="16dp"
        android:src="0x7f080723"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutrootview"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="63dp"
            android:layout_marginRight="30dp"
            flatten="true">
            <p151v.VText_AutoFit
                android:textSize="36sp"
                android:textStyle="italic|bold"
                android:textColor="#212121"
                android:layout_gravity="bottom"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="20sp"
                android:textStyle="italic|bold"
                android:textColor="#212121"
                android:layout_gravity="bottom"
                android:id="@+id/title_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-10dp"
                android:text="会员"/>
        </LinearLayout>
        <p151v.VText_AutoFit
            android:textSize="34sp"
            android:textStyle="italic|bold"
            android:textColor="#ff5435"
            android:id="@+id/subtitle"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="30dp"
            android:singleLine="true"/>
        <View
            android:id="@+id/redline"
            android:background="@color/core_pricerecall2_line_bg_tell"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginLeft="26dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="26dp"
            android:layout_marginBottom="30dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/see_layout"
            android:background="@drawable/core_lowprice_select_seecontent_bg2"
            android:paddingLeft="12dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="23dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="23dp">
            <p151v.VText
                android:textSize="12dp"
                android:textColor="#212121"
                android:id="@+id/avatar_txt"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_single"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp">
            <LinearLayout
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp">
                <p151v.VText
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:id="@+id/price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="10sp"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:id="@+id/price_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:lineSpacingExtra="10sp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="5dp">
                <p151v.VText
                    android:textSize="24sp"
                    android:textColor="#999999"
                    android:id="@+id/origin_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:textColor="#999999"
                    android:id="@+id/origin_price_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="10sp"/>
            </LinearLayout>
        </LinearLayout>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="#999999"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/purchase_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/purchase"
            android:background="@drawable/core_lowprice_select_tips_updown_bg"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintLeft_toLeftOf="parent"
            fresco:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="21dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btn_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            fresco:layout_constraintBottom_toBottomOf="@+id/purchase"
            fresco:layout_constraintHorizontal_chainStyle="packed"
            fresco:layout_constraintLeft_toLeftOf="@+id/purchase"
            fresco:layout_constraintRight_toLeftOf="@+id/btn_originprice"
            fresco:layout_constraintTop_toTopOf="@+id/purchase"/>
        <p151v.VText
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="#ffe0d9"
            android:gravity="center_horizontal"
            android:id="@+id/btn_originprice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_toRightOf="@+id/btn_price"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif"
            fresco:layout_constraintBottom_toBottomOf="@+id/purchase"
            fresco:layout_constraintLeft_toRightOf="@+id/btn_price"
            fresco:layout_constraintRight_toLeftOf="@+id/btn_txt"
            fresco:layout_constraintTop_toTopOf="@+id/purchase"/>
        <p151v.VText
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btn_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_toRightOf="@+id/btn_originprice"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="4sp"
            fresco:layout_constraintBottom_toBottomOf="@+id/purchase"
            fresco:layout_constraintLeft_toRightOf="@+id/btn_originprice"
            fresco:layout_constraintRight_toRightOf="parent"
            fresco:layout_constraintTop_toTopOf="@+id/purchase"/>
        <p151v.VText
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tag"
            android:background="0x7f081388"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="立减125元"
            fresco:layout_constraintBottom_toTopOf="@+id/btn_originprice"
            fresco:layout_constraintLeft_toLeftOf="@+id/btn_originprice"
            fresco:layout_constraintRight_toRightOf="@+id/btn_originprice"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/btn_pay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="-2dp"
        android:layout_above="@+id/purchase_layout"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#de000000"
            android:gravity="center"
            android:id="@+id/pay_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支付宝"
            android:drawablePadding="11dp"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="4dp"
            android:drawableStart="0x7f080d95"
            android:layout_marginStart="12dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/prom_text"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/pay_txt"
            android:layout_marginHorizontal="6dp"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080d93"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#33000000"
            android:gravity="center"
            android:id="@+id/agreement"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/pay_txt"
            android:layout_marginStart="14dp"/>
    </RelativeLayout>
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f080d97"
        android:scaleType="fitXY"
        android:layout_above="@+id/btn_pay"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="#cc212121"
        android:gravity="center"
        android:id="@+id/deadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="立减125元"
        android:layout_above="@+id/btn_pay"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
