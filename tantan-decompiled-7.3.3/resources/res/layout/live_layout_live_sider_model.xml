<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.other.side.LiveSiderLiveItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="140dp"
    android:layout_marginBottom="10dp"
    flatten="true"
    folder="other"
    holder="side.LiveSiderLiveItemView">
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.view.LiveSquareMediaView
            android:id="@+id/media_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/cover_layer"
            android:background="@drawable/live_shape_bg_sider_half_cover"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#b2ffffff"
        android:ellipsize="end"
        android:id="@+id/text_anchor_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:shadowColor="#e3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_above="@+id/text_live_desc"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/text_live_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:shadowColor="#33000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.live.livingroom.other.side.LiveSiderLiveItemView>
