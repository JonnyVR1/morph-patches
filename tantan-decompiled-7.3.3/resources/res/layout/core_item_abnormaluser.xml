<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/view_exceptions"
        android:background="@drawable/core_bg_8_08000000"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp">
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/core_33000000"
            android:layout_gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="2dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看异常用户"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081636"/>
    </p151v.VLinear>
</p151v.VLinear>
