<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/letter_send_dlg_round_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    attachToRoot="true"
    flatten="true"
    holder="vip.widget.IntlLetterSendPanel">
    <p151v.VImage
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:src="0x7f082988"/>
    <p151v.VImage
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="0x7f082a0d"/>
    <p151v.VText
        android:textSize="17sp"
        android:textColor="#333333"
        android:gravity="center_horizontal"
        android:id="@+id/letter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableRight="0x7f0819a7"
        android:drawablePadding="5dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#7a7a7a"
        android:gravity="center_horizontal"
        android:id="@+id/letter_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"/>
    <p151v.VRecyclerView
        android:id="@+id/rv_envelop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="17dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:background="@drawable/letter_edit_border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp">
        <p151v.VEditText
            android:textSize="14sp"
            android:textColorHint="@color/text_light"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/core_svip_edit_cursor_style"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:enableEmojis="true"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/send_btn"
            android:background="@drawable/core_svip_letter_send_oval_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="10dp"/>
    </p151v.VLinear>
    <View
        android:background="#f0f1f4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="25dp"/>
    <p151v.VImage
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="36dp"
        android:src="0x7f082a11"/>
    <p151v.VText
        android:textSize="17sp"
        android:textColor="#333333"
        android:gravity="center_horizontal"
        android:id="@+id/superlike_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableRight="0x7f0819ab"
        android:drawablePadding="5dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#7a7a7a"
        android:gravity="center_horizontal"
        android:id="@+id/superlike_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"/>
    <p151v.VText
        android:textSize="17sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/super_like_btn"
        android:background="@drawable/intl_letter_send_dlg_super_like_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="25dp"
        android:lineSpacingExtra="-3sp"/>
</merge>
