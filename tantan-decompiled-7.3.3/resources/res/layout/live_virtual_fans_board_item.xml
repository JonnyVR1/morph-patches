<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.board.accompany.VirtualFansNormalItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="virtual"
    holder="board.accompany.VirtualFansNormalItemView">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/rank"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginStart="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="73dp"
        android:layout_height="73dp"
        android:layout_marginStart="52dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/mvp"
        android:background="@drawable/live_bg_19191e_r12_a90"
        android:padding="1.5dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="4dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:maxEms="6"
        android:singleLine="true"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/gender"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@+id/name"
        app:layout_constraintTop_toBottomOf="@+id/name"
        layout="@layout/live_user_gender_medal_view"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_fe7e1d"
        android:id="@+id/heart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.board.accompany.VirtualFansNormalItemView>
