<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/live_bg_black_r16_a20"
    android:paddingLeft="14dp"
    android:paddingTop="8dp"
    android:paddingRight="14dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1.5dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="1.5dp"
    flatten="true">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/icon"
                android:layout_width="44dp"
                android:layout_height="44dp"/>
            <p151v.VText
                android:textSize="9dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/count"
                android:background="@drawable/live_bg_black_r4_a40"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"/>
        </FrameLayout>
        <com.p051p1.mobile.putong.live.livingroom.view.AutoRefreshTextView
            android:textSize="12dp"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/flow_content"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="3dp"
            android:minHeight="25dp"
            android:maxLines="2"
            android:layout_weight="1"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </LinearLayout>
    <View
        android:background="@color/live_white_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reward_list"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"/>
</LinearLayout>
