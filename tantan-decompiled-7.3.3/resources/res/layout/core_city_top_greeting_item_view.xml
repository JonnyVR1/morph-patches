<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.citytop.CityTopItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    holder="citytop.CityTopItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <LinearLayout
        android:gravity="top|right"
        android:layout_gravity="top|right"
        android:id="@+id/pic_verification_container"
        android:visibility="invisible"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/verification_icon"
            android:background="0x7f082957"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/dislike"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081204"/>
    <p151v.VImage
        android:layout_gravity="left"
        android:id="@+id/like"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081205"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:background="@drawable/core_city_top_item_common_gradient"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="8.5dp"
            android:layout_toLeftOf="@+id/action_btn"
            android:layout_alignParentBottom="true">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#b3ffffff"
                android:id="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                app:typeface="regular"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/greeting_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </p151v.VLinear>
        <p151v.VImage
            android:id="@+id/action_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            app:srcCompat="0x7f08071b"/>
        <p151v.VImage
            android:id="@+id/superliked_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:src="0x7f080d3f"/>
    </RelativeLayout>
    <p151v.VText
        android:textColor="#dbbd7a"
        android:id="@+id/new_tag"
        android:background="@drawable/core_city_top_item_tag_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="新请求"
        android:drawableLeft="0x7f08071a"
        app:typeface="regular"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:textColor="#b3ffffff"
        android:id="@+id/online_tag"
        android:paddingLeft="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="在线"
        android:drawableLeft="@drawable/core_city_top_online_dot"
        android:drawablePadding="6dp"
        app:typeface="regular"
        style="@style/core_user_card_top_left_label"/>
</com.p051p1.mobile.putong.core.p058ui.citytop.CityTopItemView>
