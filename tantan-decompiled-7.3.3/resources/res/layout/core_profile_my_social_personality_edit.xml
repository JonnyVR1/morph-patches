<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/my_social_personality"
    android:background="@color/white"
    android:paddingTop="18dp"
    flatten="true"
    holder="profile.profilelist.itemholders.EditProfileMySocialPersonalityItemHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:id="@+id/edit_title"
            android:paddingTop="0dp"
            android:layout_width="0dp"
            android:text="我的社交性格"
            android:layout_weight="1"
            style="@style/profile_item_title_black_edit"/>
    </p151v.VLinear>
    <include layout="@layout/core_profile_integrity_opt"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/mbti_edit_ll"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:id="@+id/mbti_edit_title"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:text="我的MBTI"
            android:layout_weight="1"
            style="@style/profile_item_item_new"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/mbti_edit_icon"
            android:paddingRight="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_profile_edit_data_right_add"/>
    </LinearLayout>
    <include
        android:id="@+id/mbti_result"
        layout="@layout/core_card_mbti_personality_test_item"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/ll_inner_disposition"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_inner"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:text="内在性格测试"
            android:layout_weight="1"
            style="@style/profile_item_item_new"/>
        <ImageView
            android:gravity="center"
            android:paddingRight="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08145e"/>
    </p151v.VLinear>
</p151v.VLinear_Dividers>
