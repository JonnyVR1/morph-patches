<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/two_pic_avatar_left"
        android:background="0x7f080575"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:layout_gravity="right"
        android:id="@+id/two_pic_avatar_right"
        android:background="0x7f080575"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:roundAsCircle="true"/>
    <p151v.VImage
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:src="0x7f0829c8"/>
</p151v.VFrame>
