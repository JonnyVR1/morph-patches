<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.p069pk.VoicePkTimeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.pk.VoicePkTimeView">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/bg_svga"
        android:layout_width="135dp"
        android:layout_height="71dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/bg_static"
        android:background="0x7f0827eb"
        android:layout_width="115dp"
        android:layout_height="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="50dp"
        android:layout_height="35dp"
        android:layout_marginLeft="8dp"
        android:src="0x7f0827ee"
        app:layout_constraintBottom_toBottomOf="@+id/bg_static"
        app:layout_constraintLeft_toLeftOf="@+id/bg_static"
        app:layout_constraintTop_toTopOf="@+id/bg_static"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="3.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_static"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/bg_static"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.giftlayer.LiveStrokeTextView
        android:textSize="24sp"
        android:textColor="#fee8dc"
        android:gravity="center"
        android:id="@+id/stroke_text"
        android:visibility="gone"
        android:layout_width="50.5dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_static"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/bg_static"/>
    <p151v.VImage
        android:id="@+id/time_pic"
        android:visibility="gone"
        android:layout_width="45dp"
        android:layout_height="35dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_static"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/bg_static"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.p069pk.VoicePkTimeView>
