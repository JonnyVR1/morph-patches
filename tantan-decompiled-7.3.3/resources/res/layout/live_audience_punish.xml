<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.module.PunishChooseModule">
    <View
        android:id="@+id/view_place"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/live_shape_pk_punish_choose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">
                <p151v.VDraweeView
                    android:id="@+id/iv_head"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    fresco:actualImageScaleType="centerCrop"
                    fresco:roundAsCircle="true"/>
                <ImageView
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_width="32dp"
                    android:layout_height="12dp"
                    android:src="0x7f082407"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tv_audience_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxEms="6"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/LIVE_GOT_PK_MVP"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffbb00"
                    android:id="@+id/tv_punish_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/LIVE_PK_PUNISH_DESCRIPTION"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_punish_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="26dp"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#f57c00"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="19dp"/>
    </LinearLayout>
</LinearLayout>
