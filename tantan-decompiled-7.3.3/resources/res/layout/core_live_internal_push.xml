<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalPushView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="0x7f0803c9"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui.home.bubble"
    holder="internalpush.LiveInternalPushView">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        flatten="true">
        <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
            android:layout_gravity="center_vertical"
            android:id="@+id/reward"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="7dp"/>
        <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
            android:layout_gravity="center_vertical"
            android:id="@+id/ani_avatar"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            app:avatarSize="36dp"
            app:haloSize="48dp"/>
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar"
            android:visibility="gone"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="7dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/placeholder_see_bubble_avatar"
            app:placeholderImage="@drawable/placeholder_see_bubble_avatar"
            app:roundAsCircle="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#212121"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:lineSpacingExtra="4dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#999999"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/operate"
            android:background="@drawable/core_live_voice_push_button_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="44dp"
            android:text="@string/LIVE_PUSH_JUMP_ROOM"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="10dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f080d58"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalPushView>
