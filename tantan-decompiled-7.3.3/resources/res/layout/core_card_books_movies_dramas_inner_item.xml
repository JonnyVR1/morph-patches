<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.expanded.holder.item.BooksMoviesDramasItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/content_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.item.BooksMoviesDramasItem">
    <RelativeLayout
        android:id="@+id/literature_container"
        android:layout_width="90dp"
        android:layout_height="112dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/white"
            app:failureImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"/>
        <p151v.VImage
            android:id="@+id/add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginRight="7dp"
            android:src="@drawable/core_profile_edit_data_right_add"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/num"
            android:background="@drawable/core_profile_like_num_white_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="@dimen/core_profile_like_num_padding_bottom"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/watch_common_title"
            android:background="@drawable/core_profile_recently_common_watch_bg"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="6dp"/>
    </RelativeLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_toRightOf="@+id/literature_container"
        android:layout_centerVertical="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="18sp"
            android:textColor="@color/common_000000_80"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_000000_40"
            android:id="@+id/kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:singleLine="true"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <p151v.VImage
                android:id="@+id/type_image"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:tint="@color/common_000000_40"
                android:layout_above="@+id/kind"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/watch_type"
                android:paddingTop="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:singleLine="true"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.card.expanded.holder.item.BooksMoviesDramasItem>
