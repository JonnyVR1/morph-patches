<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/feed_profile_tab_comment"
    android:paddingLeft="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="photoalbum.feed.personfeedinprofile.FeedInsertCommentView">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/head_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="11dp"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_04"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="42dp"
        android:lines="1"
        android:singleLine="true"
        android:layout_weight="1"/>
    <p151v.VEditText
        android:textSize="14sp"
        android:textColor="@color/feed_e6000000"
        android:textColorHint="@color/scenario_entrance_title_light"
        android:layout_gravity="center_vertical"
        android:id="@+id/input"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="42dp"
        android:maxLines="4"
        android:maxLength="1000"
        android:layout_weight="1"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/emoji_one"
        android:paddingLeft="8dp"
        android:paddingRight="9dp"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:text="❤️"
        app:enableEmojis="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/emoji_two"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:text="��"
        app:enableEmojis="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/emoji_three"
        android:paddingLeft="9dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:text="��"
        app:enableEmojis="true"/>
    <p151v.VText
        android:textColor="@color/common_light_02"
        android:layout_gravity="center_vertical"
        android:id="@+id/submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:text="@string/MATCH_TEXT_SEND"/>
</LinearLayout>
