<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="account.AccountDeleteActViewModel">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="35dp"
        android:paddingRight="35dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0812fc"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/pause_account_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/GDPR_PAUSE_MY_ACCOUNT"/>
        <p151v.VText
            android:textColor="@color/home_empty_loading_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/GDPR_PAUSE_ACCOUNT_CONTENT"
            android:lineSpacingExtra="8sp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <p151v.VButton
            android:textColor="@color/white"
            android:id="@+id/account_pause"
            android:background="@drawable/rect_rounded_tantan_orange"
            android:layout_width="264dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/GDPR_PAUSE_MY_ACCOUNT"
            android:maxLines="1"
            style="@style/v_button"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/account_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/account_start_with_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/GDPR_DELETE_MY_ACCOUNT"
                android:maxLines="1"/>
        </p151v.VLinear>
    </p151v.VLinear>
</p151v.VLinear>
