<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.signin.prize.LiveSignPrizeListView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common"
    holder="signin.prize.LiveSignPrizeListView">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.p051p1.mobile.putong.live.base.view.DialogTitleBar
            android:id="@+id/dialog_title_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/prize_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/prize_null_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="40dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08268b"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/LIVE_SIGN_IN_PRIZE_NULL"/>
        </LinearLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.common.signin.prize.LiveSignPrizeListView>
