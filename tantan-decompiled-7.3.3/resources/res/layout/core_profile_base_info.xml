<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/edit_name_frame"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.holders.ProfileBaseInfoHolder"
    needPublic="true">
    <RelativeLayout
        android:id="@+id/name_frame"
        android:paddingLeft="20dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/name_first_line_frame"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/follow_button_behind_name"
            flatten="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                flatten="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/name_age_tag_wrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VText
                        android:textSize="26sp"
                        android:textColor="@color/common_black_02"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/name"
                        android:padding="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_weight="1"
                        style="@style/core_card_text"/>
                    <p151v.VDraweeView
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/emoji"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="8dp"/>
                    <p151v.VImage
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/emoji_edit"
                        android:padding="2dp"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="8dp"
                        android:src="0x7f080249"/>
                    <p151v.VText
                        android:textSize="24sp"
                        android:textColor="@color/common_black_02"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        app:typeface="regular"
                        style="@style/core_card_text"/>
                    <ImageView
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/pic_tag_icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="6dp"
                        android:src="0x7f0818bf"/>
                    <ImageView
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/pic_tag_small_intl"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="6dp"/>
                    <ImageView
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tantan_tag_icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="6dp"
                        android:src="0x7f0818c0"/>
                    <p151v.VImage
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/decoration_border"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/follow_button_behind_name"
            android:background="@drawable/common_button_btn_orange_medium"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="-10dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:text="@string/FOLLOW_STATE_WITHOUT_PLUS"
            android:layout_alignParentRight="true"/>
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/wealth_icon_new"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"/>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/say_hi_svga"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="26dp"
            android:layout_marginRight="20dp"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/second_layout"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/name_first_line_frame"
            flatten="true">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/age_sex_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"/>
            <com.p051p1.mobile.putong.newui.view.VIPShimmerTag
                android:id="@+id/vip_shimmer_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"/>
            <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                android:id="@+id/diamond_taglabel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/vip_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"/>
            <include
                android:id="@+id/black_diamond_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"
                layout="@layout/core_black_diamond_tag_layout_view"/>
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/wealth_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/student_tag"
                android:background="@drawable/core_student_verification_tag_bg"
                android:paddingLeft="4dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"
                android:minWidth="46dp"
                android:text="学生"
                android:drawableLeft="@drawable/core_profile_school_tag_ic"
                android:drawablePadding="2dp"/>
            <p151v.VText
                android:textSize="11sp"
                android:layout_gravity="center_vertical"
                android:id="@+id/zodiac"
                android:visibility="gone"
                android:layout_height="20dp"
                style="@style/core_card_icon_right"/>
        </LinearLayout>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/gender_age"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/name_first_line_frame"
            android:paddingStart="5dp"
            android:paddingEnd="6dp"
            app:rRadius="6dp">
            <p151v.VImage
                android:id="@+id/gender"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/age_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout>
        <p151v.VIcon
            android:id="@+id/intl_entry"
            android:background="0x7f080c4b"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/name_first_line_frame"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/location_and_active_wrap"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_toLeftOf="@+id/follow_button_behind_name"
            android:layout_below="@+id/second_layout"
            flatten="true">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:gravity="start|bottom"
                android:id="@+id/location_and_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                app:typeface="regular"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/gp_hide_active_time_guide_holder"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VRelative
                    android:background="0x7f081f6c"
                    android:layout_width="12dp"
                    android:layout_height="12dp">
                    <p151v.VImage
                        android:id="@+id/gp_hide_active_time_guide_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081f6d"/>
                </p151v.VRelative>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/tantan_orange"
                    android:id="@+id/gp_hide_active_time_guide_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/INTL_HIDE_ACTIVE_TIME"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:id="@+id/like_container"
            android:background="@drawable/core_profile_base_info_like_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/location_and_active_wrap"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">
            <p151v.VDraweeView
                android:id="@+id/like_img"
                android:background="@drawable/core_profile_base_info_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_66000000"
                android:id="@+id/like_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/tag_container_layout"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="9dp"
            android:layout_below="@+id/like_container"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/state_container"
                android:background="@drawable/core_profile_state_bg"
                android:paddingRight="14dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="10dp">
                <p151v.VDraweeView
                    android:id="@+id/state_img"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="8dp"
                    style="@style/core_fresco_profile_small"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#1a1a1b"
                    android:id="@+id/state_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="1dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/frame_container"
                android:background="@drawable/core_profile_state_bg"
                android:paddingRight="14dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="34dp">
                <p151v.VDraweeView
                    android:id="@+id/img"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="8dp"
                    style="@style/core_fresco_profile_small"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#1a1a1b"
                    android:id="@+id/tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="1dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </RelativeLayout>
</LinearLayout>
