<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_certification_bottom_sheet_bg"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.views.CertBlockBottomSheet">
    <p151v.VText_NoTopPadding
        android:textSize="22sp"
        android:textColor="#cc000000"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="40dp"
        android:text="新头像会导致认证失效"
        android:layout_marginHorizontal="40dp"
        app:fontWeight="500"/>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="40dp"
        android:text="建议保留原头像及认证权益，照片未满9张，新头像会保存为其他照片"
        android:layout_marginHorizontal="40dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp">
        <p151v.VFrame
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <p151v.VDraweeView
                android:id="@+id/image_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="start|top"
                android:id="@+id/cert_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scaleType="fitXY"
                android:layout_marginStart="8dp"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/check_1"
                android:background="0x7f0829d5"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp"/>
            <p151v.VText_NoTopPadding
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/value_1"
                android:background="@drawable/profile_cert_q4_block_dlg_icon_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="10dp"
                android:text="原头像"
                android:drawablePadding="2dp"
                android:drawableStart="@drawable/profile_cert_q4_avatar_block_icon_1"
                android:paddingHorizontal="6dp"
                app:fontWeight="500"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp">
            <p151v.VDraweeView
                android:id="@+id/image_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/check_2"
                android:background="0x7f0829d3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp"/>
            <p151v.VText_NoTopPadding
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/value_2"
                android:background="@drawable/profile_cert_q4_block_dlg_icon_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="10dp"
                android:text="新头像·认证失效"
                android:drawablePadding="2dp"
                android:drawableStart="@drawable/profile_cert_q4_avatar_block_icon_2"
                android:paddingHorizontal="6dp"
                app:fontWeight="500"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_1"
        android:background="@drawable/core_low_photo_bottom_sheet_photo_button_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="24dp"
        android:text="确定"
        android:layout_marginHorizontal="24dp"
        app:fontWeight="500"/>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="使用新头像，并保存其他资料"
        app:fontWeight="500"/>
</p151v.VLinear>
