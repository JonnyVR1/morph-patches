<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainlandnew.HourLeaderBoardAssistanceGiftItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    flatten="true"
    folder="increment"
    holder="leaderboard.hourleaderboard.mainlandnew.HourLeaderBoardAssistanceGiftItemView">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_66D89C90"
        android:id="@+id/threshold"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginTop="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/threshold"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/live_ccbb8378"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_66D89C90"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:maxLines="1"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainlandnew.HourLeaderBoardAssistanceGiftItemView>
