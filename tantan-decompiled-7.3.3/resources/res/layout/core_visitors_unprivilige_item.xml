<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsUnPrivilegeView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    holder="visitor.VisitorsUnPrivilegeView">
    <p151v.VRelative
        android:id="@+id/comment_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
            android:id="@+id/profile"
            android:layout_width="69dp"
            android:layout_height="69dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/button"
            android:layout_toEndOf="@+id/profile"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:textSize="15sp"
                            android:textColor="@color/core_color_e6000000"
                            android:ellipsize="end"
                            android:layout_gravity="center"
                            android:id="@+id/title"
                            android:padding="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:fontFamily="PingFangSc-Medium"/>
                    </p151v.VLinear>
                </p151v.VLinear>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_08"
                android:ellipsize="end"
                android:id="@+id/visitor_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_below="@+id/content_container"/>
        </p151v.VLinear>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffdea2"
            android:gravity="end"
            android:id="@+id/button"
            android:background="@drawable/core_visitors_unprivilege_item_get_privilege_bg"
            android:paddingLeft="12dp"
            android:paddingTop="7dp"
            android:paddingRight="12dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="立即解密"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            android:letterSpacing="0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsUnPrivilegeView>
