<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.recharge.LiveRemindDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_recharge_remain_dialog_bt_bg"
    android:paddingTop="32dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layout_marginStart="25dp"
    android:layout_marginEnd="25dp"
    holder="increment.recharge.LiveRemindDialog">
    <FrameLayout
        android:id="@+id/gift_player_layout"
        android:visibility="gone"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.immomo.svgaplayer.view.MomoLayUpSVGAImageView
            android:id="@+id/gift_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.p051p1.mobile.putong.live.base.view.XEGiftView
            android:id="@+id/gift_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_gray_99"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_player_layout"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/live_bg_fe7e1d_r16"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/LIVE_CONFIRM"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.recharge.LiveRemindDialog>
