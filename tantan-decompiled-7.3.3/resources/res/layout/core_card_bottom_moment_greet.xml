<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomMomentGreetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomMomentGreetView">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="94dp"
        android:layout_marginBottom="4dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <include
            android:id="@+id/user_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="94dp"
            layout="@layout/core_card_user_content_view"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/content_container"
            android:background="@drawable/core_card_theme_answer_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VFrame
                android:layout_gravity="center_vertical"
                android:id="@+id/moment_media_container"
                android:visibility="gone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginRight="8dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/moment_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:backgroundImage="@drawable/core_card_moment_image_bg"
                    app:roundedCornerRadius="10dp"
                    app:roundingBorderColor="#3dffffff"
                    app:roundingBorderWidth="1.5dp"/>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/moment_video_play"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f08095e"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/color_ccffffff"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:drawablePadding="6dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6ffffff"
                    android:ellipsize="end"
                    android:id="@+id/subtitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.5dp"
                    android:maxLines="1"
                    android:lineSpacingExtra="1dp"
                    app:typeface="medium"/>
                <com.p051p1.mobile.putong.core.p058ui.vip.widget.LetterRemainingSwitcherView
                    android:textSize="14sp"
                    android:id="@+id/messages"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.5dp"
                    android:textAlignment="textStart"
                    app:contentTextColor="#e6ffffff"
                    app:contentTextSize="14sp"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_greet"
                android:background="@drawable/core_card_bottom_moment_greet_btn_bg"
                android:visibility="gone"
                android:layout_width="67dp"
                android:layout_height="34dp"
                android:layout_marginLeft="12dp"
                android:text="@string/FEED_GREETING"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomMomentGreetView>
