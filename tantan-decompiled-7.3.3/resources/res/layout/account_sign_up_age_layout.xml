<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:id="@+id/sign_up_top_icon"
        android:layout_width="138dp"
        android:layout_height="120dp"
        android:src="0x7f0801fb"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="24dp"
        android:textColor="@color/black"
        android:id="@+id/sign_up_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="116dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="24dp"
        android:textColor="@color/black"
        android:id="@+id/sign_up_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请问你的年龄是？"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_title"
        app:typeface="medium"/>
    <com.p051p1.mobile.putong.p070ui.datepicker.WheelView
        android:id="@+id/sign_up_age_wheel_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_subtitle"
        app:wv_curtainColor="@color/common_000000_03"
        app:wv_curtainRadius="10dp"
        app:wv_curved="true"
        app:wv_isShowCurtain="true"
        app:wv_lineSpacing="28dp"
        app:wv_minTextSize="22sp"
        app:wv_normalTextColor="#d9d9d9"
        app:wv_refractRatio="1"
        app:wv_selectedTextColor="@color/black"
        app:wv_textAlign="center"
        app:wv_textSize="22sp"
        app:wv_visibleItems="5"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_000000_40"
        android:gravity="center_vertical"
        android:id="@+id/sign_up_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:text="18岁及以上，才能使用探探"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/sign_up_tip_icon"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_age_wheel_view"/>
    <p151v.VImage
        android:id="@+id/sign_up_tip_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f0829f9"
        android:scaleType="fitCenter"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sign_up_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
