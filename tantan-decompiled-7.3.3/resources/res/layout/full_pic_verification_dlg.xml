<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/verification_popup_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:src="0x7f081fd4"
        android:scaleType="center"
        android:layout_marginEnd="12dp"/>
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="139dp"
        android:layout_marginTop="20dp"
        android:src="0x7f08098b"
        android:scaleType="center"
        android:layout_marginStart="-35dp"/>
    <p151v.VText
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/VERIFICATION_PICTURE_GUIDE_ALERT_TITLE"
        android:maxLines="2"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_000000_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:text="@string/VERIFICATION_PICTURE_GUIDE_ALERT_SUBTITLE_VERSION_TWO_NEW"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/common_000000_30"
        android:id="@+id/verification_popup_policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VButton
        android:ellipsize="end"
        android:id="@+id/verification_popup_positive_primary_button"
        android:text="@string/VERIFICATION_PICTURE_GUIDE_ALERT_CONFIRM"
        android:lines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_000000_30"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/verification_popup_negative"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="32dp"
        android:text="@string/VERIFICATION_PICTURE_FAIL_ALERT_CANCEL"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
