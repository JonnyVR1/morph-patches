<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveSquareMenuItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_square_menu_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0"
    flatten="true"
    folder="view"
    holder="widgets.LiveSquareMenuItemView">
    <p151v.VImage
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="23dp"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/live_shape_bg_red_point_3dp"/>
    <p151v.VDraweeView
        android:id="@+id/img_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="14dp"
        android:scaleType="fitXY"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#212121"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/menu_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp"
        android:maxWidth="80dp"
        android:minWidth="64dp"
        android:maxLines="2"
        android:layout_below="@+id/img_icon"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSC-Regular"/>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveSquareMenuItemView>
