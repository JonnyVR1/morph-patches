<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.business.IntlVisitorConversationView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/tf_rect_light"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.business.IntlVisitorConversationView">
    <p151v.VDraweeView
        android:id="@+id/image_layout"
        android:background="0x7f080f37"
        android:padding="6dp"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="7.5dp"
        android:layout_marginBottom="6.5dp"
        android:layout_marginStart="12dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"
        style="@style/core_conversation_profile_small"/>
    <p151v.VFrame
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="29dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_layout"
        app:layout_constraintStart_toStartOf="@+id/image_layout">
        <p151v.VText_AutoFit
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/head_like_num"
            android:background="@drawable/core_intl_visitor_change_head_num_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="24dp"/>
    </p151v.VFrame>
    <ViewStub
        android:id="@+id/look_up_stub"
        android:layout="@layout/core_intl_visitor_look_up_layout"
        android:inflatedId="@+id/look_up_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8.5dp"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/image_layout"
        app:layout_constraintLeft_toRightOf="@+id/image_layout"
        app:layout_constraintRight_toLeftOf="@+id/look_up_stub"
        app:layout_constraintTop_toTopOf="@+id/image_layout">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#010101"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/SEE_PURCHASE_MIN_TITLE"
            android:maxLines="1"
            app:enableEmojis="true"
            app:typeface="medium"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#7a7a7a"
                android:ellipsize="end"
                android:id="@+id/sub_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                app:enableEmojis="true"
                app:typeface="regular"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.business.IntlVisitorConversationView>
