<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/live_bg_white_r20"
    android:layout_width="311dp"
    android:layout_height="337dp"
    flatten="true"
    folder="common.fansclub.submodule.recall"
    holder="FansRecallEditDialog">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#323232"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/LIVE_FANSCLUB_FANS_RECALL_EDIT_TITLE"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#4d323232"
        android:layout_gravity="start"
        android:id="@+id/tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/LIVE_FANSCLUB_FANS_RECALL_EDIT_TIPS"
        android:layout_marginStart="24dp"/>
    <p151v.VEditText
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_black"
        android:textColorHint="#4d000000"
        android:gravity="start|top"
        android:layout_gravity="center_horizontal"
        android:id="@+id/edit_content"
        android:background="@drawable/live_bg_f9f9f9_r16"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="271dp"
        android:layout_height="110dp"
        android:layout_marginTop="12dp"
        android:hint="@string/LIVE_FANSCLUB_FANS_RECALL_EDIT_HINT"
        android:maxLength="100"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/send_btn"
        android:background="@drawable/live_selector_button_recall"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/LIVE_SEND_MESSAGE"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
</p151v.VLinear>
