<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetCpItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetCpItemView">
    <p151v.VDraweeView
        android:id="@+id/house_drawee_view"
        android:layout_width="208dp"
        android:layout_height="207dp"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/locked_layout"
        android:background="@drawable/live_shape_voice_sweet_cp_lock_bg"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:layout_centerHorizontal="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="0x7f082836"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="10dp"
            android:text="@string/LIVE_VOICE_UNLOCKED"
            android:fontFamily="PingFangSC-Regular"/>
    </p151v.VLinear>
    <include
        android:id="@+id/cp_head_view"
        android:layout_width="168dp"
        android:layout_height="60dp"
        android:layout_marginTop="-35dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/house_drawee_view"
        android:layout_centerHorizontal="true"
        layout="@layout/live_voice_sweet_simple_cp_head_layout"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetCpItemView>
