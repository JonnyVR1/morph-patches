<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedtop.PhotoAlbumTopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_feed"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.feedtop.viewhome.FeedPhotoAlbumTopViewHomeImpl">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/like_no_data_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            flatten="true"
            layout="@layout/feed_like_no_data_view"/>
        <p151v.VFrame
            android:id="@+id/top_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/moment_topic_rl"
                android:background="#fffffd"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/delete_topic"
                    android:paddingLeft="16dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="0x7f081f30"/>
                <p151v.VFrame
                    android:id="@+id/attention_fl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    flatten="true">
                    <p151v.VDraweeView
                        android:id="@+id/activity_tail"
                        android:visibility="gone"
                        android:layout_width="108dp"
                        android:layout_height="40dp"
                        android:layout_marginRight="16dp"
                        app:actualImageScaleType="centerCrop"
                        style="@style/feed_fresco_profile_frame"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/attention"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#f55a43"
                            android:gravity="center_vertical"
                            android:id="@+id/status"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/roam_layout"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp">
                        <p151v.VImage
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="0x7f081ec8"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/feed_cdcdcd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="1dp"
                            android:text="漫游"/>
                    </LinearLayout>
                </p151v.VFrame>
                <RelativeLayout
                    android:id="@+id/photo_album_feed_profile"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_toLeftOf="@+id/attention_fl"
                    android:layout_alignTop="@+id/attention_fl"
                    android:layout_alignParentLeft="true"
                    flatten="true">
                    <FrameLayout
                        android:id="@+id/pic_container"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp">
                        <p151v.VDraweeView
                            android:layout_gravity="center"
                            android:id="@+id/pic"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            style="@style/feed_fresco_profile_small_newui"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/state_contain"
                            android:background="@color/transparent"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="40dp">
                            <p151v.VLinear
                                android:background="@drawable/bg_round_white"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_centerInParent="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintRight_toRightOf="parent"/>
                            <p151v.VDraweeView
                                android:id="@+id/state"
                                android:visibility="visible"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                style="@style/feed_fresco_profile_small_newui"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <p151v.AutoVDraweeView
                            android:layout_gravity="center"
                            android:id="@+id/pic_frame"
                            android:visibility="gone"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            style="@style/feed_fresco_profile_frame"/>
                        <com.p051p1.mobile.putong.feed.newui.photoalbum.feedtop.render.live.LiveHaloAvatar
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/living_avatar"
                            android:visibility="gone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:avatarSize="32dp"
                            app:haloSize="44dp"/>
                    </FrameLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/pic_container"
                        android:layout_centerVertical="true">
                        <p151v.VLinear_FillerMeasure
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/name_with_vip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_alignParentLeft="true"
                            app:fillerIndex="0"
                            flatten="true">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/common_black_02"
                                android:layout_gravity="center"
                                android:id="@+id/name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:singleLine="true"/>
                            <p151v.VFrame
                                android:layout_gravity="center_vertical"
                                android:paddingLeft="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <p151v.VImage
                                    android:id="@+id/pic_verification"
                                    android:background="0x7f081e18"
                                    android:visibility="invisible"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"/>
                            </p151v.VFrame>
                            <p151v.VLinear
                                android:gravity="center"
                                android:layout_gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/layout_gender_age_extra_view"
                                android:paddingLeft="4dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/vip_flag_ab"
                                android:paddingLeft="4dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:scaleType="fitCenter"/>
                            <com.p051p1.mobile.putong.newui.view.VIPShimmerTag
                                android:layout_gravity="center"
                                android:id="@+id/decoration_flag_ab"
                                android:paddingLeft="4dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:scaleType="fitCenter"/>
                            <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                                android:layout_gravity="center"
                                android:id="@+id/odiamond_tag"
                                android:paddingLeft="4dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:scaleType="fitCenter"/>
                            <com.p051p1.mobile.putong.feed.newui.photoalbum.view.WealthLevelView
                                android:layout_gravity="center"
                                android:id="@+id/wealth_level_label_ab"
                                android:visibility="gone"
                                android:layout_width="18dp"
                                android:layout_height="14dp"
                                android:paddingStart="4dp"/>
                            <p151v.VFrame
                                android:layout_gravity="center"
                                android:id="@+id/relationship_layout"
                                android:paddingLeft="4dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <p151v.VText
                                    android:textSize="10sp"
                                    android:textColor="#c8c8c8"
                                    android:id="@+id/text"
                                    android:background="@drawable/feed_moment_top_relationship_tag"
                                    android:paddingLeft="3dp"
                                    android:paddingTop="2dp"
                                    android:paddingRight="3dp"
                                    android:paddingBottom="2dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </p151v.VFrame>
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/live_level"
                                android:visibility="gone"
                                android:layout_width="35dp"
                                android:layout_height="14dp"
                                android:paddingStart="4dp"
                                app:actualImageScaleType="centerInside"/>
                            <p151v.VFrame
                                android:layout_gravity="center_vertical"
                                android:paddingLeft="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#ff6728"
                                    android:gravity="center_vertical"
                                    android:id="@+id/topic_create_flag"
                                    android:background="@drawable/feed_topic_creator_icon"
                                    android:paddingLeft="4dp"
                                    android:paddingRight="4dp"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="14dp"
                                    android:text="创建者"
                                    android:singleLine="true"/>
                            </p151v.VFrame>
                            <p151v.VFrame
                                android:layout_gravity="center_vertical"
                                android:paddingLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <com.p051p1.mobile.putong.feed.newui.photoalbum.feed.personfeedinminetab.FeedWriterLevelView
                                    android:textStyle="bold"
                                    android:gravity="center_vertical"
                                    android:id="@+id/writer_level"
                                    android:paddingRight="4dp"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </p151v.VFrame>
                        </p151v.VLinear_FillerMeasure>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="3dp"
                            android:layout_below="@+id/name_with_vip">
                            <p151v.VLinear
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/layout_gender_age"
                                android:paddingLeft="2dp"
                                android:paddingRight="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp">
                                <ImageView
                                    android:id="@+id/img_gender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <p151v.VText
                                    android:textSize="9sp"
                                    android:textColor="@color/white"
                                    android:gravity="center_vertical"
                                    android:id="@+id/age"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"
                                    android:minWidth="0dp"
                                    android:singleLine="true"/>
                            </p151v.VLinear>
                            <p151v.VText
                                android:textSize="12sp"
                                android:textColor="@color/common_grey_03"
                                android:id="@+id/review"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/USER_INFO_CHECKING"/>
                            <p151v.VLinear
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/like_from_ll"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <p151v.VDraweeView
                                    android:id="@+id/like_from_img"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:scaleType="centerCrop"
                                    app:actualImageScaleType="centerCrop"
                                    app:failureImage="0x7f081d4e"
                                    app:placeholderImage="0x7f081d4e"/>
                                <p151v.VText
                                    android:textSize="12sp"
                                    android:textColor="@color/common_grey_03"
                                    android:ellipsize="end"
                                    android:id="@+id/like_from_tv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:maxLines="1"/>
                            </p151v.VLinear>
                            <p151v.VText
                                android:textSize="12sp"
                                android:textColor="@color/common_grey_03"
                                android:id="@+id/like_time_dot"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:text="·"/>
                            <p151v.VText
                                android:textSize="12sp"
                                android:textColor="@color/common_grey_03"
                                android:ellipsize="end"
                                android:id="@+id/time"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"/>
                            <p151v.VText
                                android:textSize="12sp"
                                android:textColor="@color/common_grey_03"
                                android:id="@+id/time_distance_dot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:text="·"/>
                            <p151v.VText
                                android:textSize="12sp"
                                android:textColor="@color/common_grey_03"
                                android:ellipsize="end"
                                android:id="@+id/distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
            <p151v.VImage
                android:layout_gravity="bottom|left"
                android:id="@+id/follow_avatar_tip_arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:src="0x7f0802a8"/>
            <FrameLayout
                android:id="@+id/labels_fl"
                android:visibility="invisible"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                flatten="true">
                <TextView
                    android:textSize="9dp"
                    android:textStyle="bold"
                    android:textColor="@color/feed_nearby_topic_color"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/labels"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"/>
            </FrameLayout>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/moment_intention_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/moment_intention_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="12dp"/>
                <p151v.VText
                    android:textSize="11dp"
                    android:textColor="#fe7e1d"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/moment_intention_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="可能感兴趣"
                    android:layout_marginStart="4dp"/>
            </p151v.VLinear>
        </p151v.VFrame>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedtop.PhotoAlbumTopView>
