<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/core_color_121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="newui"
    holder="immersionvideo.post.imagetovideo.IVVideoComposerActivity">
    <FrameLayout
        android:id="@+id/video_composer_preview_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/video_composer_tip_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/video_composer_preview_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <TextureView
            android:id="@+id/video_composer_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="#99000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/video_composer_tip_layout"
        android:paddingLeft="55dp"
        android:paddingRight="55dp"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_composer_preview_layout">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/video_composer_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="该功能发布前素材原图仅会在你的手机上进行处理，不会上传或备份你选择的相册内容"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/video_composer_progressbar"
            android:background="0x7f0818e5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_ivvideo_composer_loading"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/video_composer_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="1%"
            app:layout_constraintLeft_toLeftOf="@+id/video_composer_progressbar"
            app:layout_constraintRight_toRightOf="@+id/video_composer_progressbar"
            app:layout_constraintTop_toBottomOf="@+id/video_composer_progressbar"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#99ffffff"
            android:id="@+id/video_composer_progress_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="视频合成中"
            app:layout_constraintLeft_toLeftOf="@+id/video_composer_progressbar"
            app:layout_constraintRight_toRightOf="@+id/video_composer_progressbar"
            app:layout_constraintTop_toBottomOf="@+id/video_composer_progress_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:leftIcon="0x7f080387"
        app:title=""/>
</androidx.constraintlayout.widget.ConstraintLayout>
