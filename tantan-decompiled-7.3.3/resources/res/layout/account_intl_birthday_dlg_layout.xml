<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/account_intl_birthday_dlg_bg"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="BirthdayDlg">
    <p151v.VButton
        android:id="@+id/close"
        android:background="0x7f080335"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/SIGNUP_BIRTH_FILTER"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close"/>
    <com.p051p1.mobile.putong.p070ui.datepicker.DatePickerView
        android:gravity="center"
        android:id="@+id/date_picker"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:dpv_curtainColor="#08000000"
        app:dpv_cyclic="true"
        app:dpv_endYear="2088"
        app:dpv_leftTextGravity="center"
        app:dpv_lineSpacing="36dp"
        app:dpv_normalTextColor="#26000000"
        app:dpv_selectedTextColor="#cc000000"
        app:dpv_showCurtain="true"
        app:dpv_startYear="1890"
        app:dpv_textAlign="center"
        app:dpv_textSize="18sp"
        app:dpv_visibleItems="13"
        app:dpv_widthWeightMode="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/later_btn"
        android:background="@drawable/account_intl_birthday_btn_selector"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="31dp"
        android:text="@string/ACTION_CONFIRM"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/date_picker"
        app:typeface="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
