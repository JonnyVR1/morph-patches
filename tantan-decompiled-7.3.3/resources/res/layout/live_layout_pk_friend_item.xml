<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkFriendItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="recreation"
    holder="pk.view.PkFriendItemView">
    <p151v.VDraweeView
        android:id="@+id/iv_head"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:layout_centerVertical="true"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/live_black"
        android:ellipsize="end"
        android:id="@+id/tv_anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:maxEms="6"
        android:singleLine="true"
        android:layout_toRightOf="@+id/iv_head"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pk_invite"
        android:background="@drawable/live_shape_ff3a00_gradient_r6"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkFriendItemView>
