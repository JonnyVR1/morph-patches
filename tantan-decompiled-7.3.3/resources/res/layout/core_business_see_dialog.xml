<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.likers.LikersDialogView">
    <View
        android:id="@+id/offline_dlg_bg"
        android:background="@drawable/core_offline_see_dialog_gradient_bg"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
    <ImageView
        android:id="@+id/offline_dlg_heart_bg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:src="0x7f0812ce"
        android:scaleType="fitStart"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VFrame
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VFrame_Shadow
                android:layout_gravity="center_horizontal"
                android:id="@+id/style_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:sl_cornerRadius="42dp"
                app:sl_dy="2dp"
                app:sl_shadowColor="#145d4000"
                app:sl_shadowRadius="24dp">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/avatar1"
                    android:background="@drawable/core_business_circle_resource"
                    android:padding="4dp"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    style="@style/fresco_profile_offline_see"/>
            </p151v.VFrame_Shadow>
            <p151v.VFrame
                android:layout_gravity="center_horizontal"
                android:id="@+id/style_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">
                <p151v.VFrame_Shadow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:sl_cornerRadius="42dp"
                    app:sl_dy="2dp"
                    app:sl_shadowColor="#145d4000"
                    app:sl_shadowRadius="24dp">
                    <p151v.VDraweeView
                        android:id="@+id/avatar2"
                        android:background="@drawable/core_business_circle_resource"
                        android:padding="4dp"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        style="@style/fresco_profile_offline_see"/>
                </p151v.VFrame_Shadow>
                <p151v.VFrame_Shadow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    app:sl_cornerRadius="42dp"
                    app:sl_dy="2dp"
                    app:sl_shadowColor="#145d4000"
                    app:sl_shadowRadius="24dp">
                    <p151v.VDraweeView
                        android:id="@+id/avatar3"
                        android:background="@drawable/core_business_circle_resource"
                        android:padding="4dp"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        style="@style/fresco_profile_offline_see"/>
                </p151v.VFrame_Shadow>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_gravity="center_horizontal"
                android:id="@+id/style_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">
                <p151v.VFrame_Shadow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:sl_cornerRadius="42dp"
                    app:sl_dy="2dp"
                    app:sl_shadowColor="#145d4000"
                    app:sl_shadowRadius="24dp">
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/avatar4"
                        android:background="@drawable/core_business_circle_resource"
                        android:padding="4dp"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        style="@style/fresco_profile_offline_see"/>
                </p151v.VFrame_Shadow>
                <p151v.VFrame_Shadow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="110dp"
                    app:sl_cornerRadius="42dp"
                    app:sl_dy="2dp"
                    app:sl_shadowColor="#145d4000"
                    app:sl_shadowRadius="24dp">
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/avatar5"
                        android:background="@drawable/core_business_circle_resource"
                        android:padding="4dp"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        style="@style/fresco_profile_offline_see"/>
                </p151v.VFrame_Shadow>
                <p151v.VFrame_Shadow
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:sl_cornerRadius="42dp"
                    app:sl_dy="2dp"
                    app:sl_shadowColor="#145d4000"
                    app:sl_shadowRadius="24dp">
                    <p151v.VDraweeView
                        android:layout_gravity="center"
                        android:id="@+id/avatar6"
                        android:background="@drawable/core_business_circle_resource"
                        android:padding="4dp"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        style="@style/fresco_profile_offline_see"/>
                </p151v.VFrame_Shadow>
            </p151v.VFrame>
        </p151v.VFrame>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#66000000"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subTitle"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="16dp"
            android:lineSpacingExtra="5dp"/>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/primary"
            android:background="@drawable/core_rect_rounded_offline_see_gradient"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="27dp"
            android:layout_marginRight="24dp"
            android:fontFamily="sans-serif"
            app:typeface="medium"
            style="@style/common_button_large_01"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_04"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersDialogView>
