<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemWechatNotifyGuideMessage xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemWechatNotifyGuideMessage">
    <p151v.VLinear
        android:orientation="horizontal"
        android:background="@drawable/core_message_wechat_notify_guide_bg"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:src="0x7f081a1f"/>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在微信接收通知"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#66000000"
                android:id="@+id/guide_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </p151v.VLinear>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/open_wechat"
            android:background="@drawable/core_wechat_nofity_guide_btn"
            android:paddingLeft="12dp"
            android:paddingTop="7dp"
            android:paddingRight="12dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="去开启"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemWechatNotifyGuideMessage>
