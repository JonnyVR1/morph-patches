<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.superlikeopt.upgrade.ComboNumView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    holder="superlikeopt.upgrade.ComboNumView">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/white_bg"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginLeft="3dp"
        android:layout_marginBottom="3dp"/>
    <ImageView
        android:id="@+id/nums"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f081708"/>
    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/digits_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/thousands_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/hundreds_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
        <ImageView
            android:id="@+id/tens_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
        <ImageView
            android:id="@+id/ones_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
        <ImageView
            android:id="@+id/plus_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/digits"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/thousands"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/hundreds"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
        <ImageView
            android:id="@+id/tens"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
        <ImageView
            android:id="@+id/ones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"/>
        <ImageView
            android:id="@+id/plus"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-11dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.superlikeopt.upgrade.ComboNumView>
