<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/group_card_root_view"
        android:background="@drawable/core_purchase_page_exclusive_privilege_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="18dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/group_card_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_000000_40"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/group_card_title"
        android:background="@drawable/core_purchase_page_exclusive_privilege_title_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="5dp"
        android:lines="1"
        android:drawablePadding="4dp"
        android:paddingHorizontal="10dp"
        app:typeface="medium"/>
</FrameLayout>
