<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="intlmeet.visitor.IntlMeetVisitorViewModel">
    <FrameLayout
        android:id="@+id/intl_meet_visitor_discount_banner_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/visitors_ll"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/intl_meet_visitor_discount_banner_container"
        flatten="true">
        <p151v.VRecyclerView
            android:id="@+id/visitors"
            android:paddingTop="7dp"
            android:paddingBottom="100dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            useId="true"/>
    </p151v.VLinear>
    <FrameLayout
        android:id="@+id/bottom_bg"
        android:background="@drawable/core_intl_button_bg_ultra_premium_bg"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:layout_alignParentBottom="true">
        <com.p051p1.mobile.putong.core.util.view.RoundTextView
            android:textSize="16sp"
            android:textColor="#f9e7ff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/get_privilege"
            android:background="@drawable/core_intl_member_button_bg_ultra_premium"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="35dp"
            android:text="@string/INTL_MEET_ULTRA_GET_BTN"
            android:textAllCaps="false"
            app:rRadius="14dp"
            app:typeface="medium"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/empty_img"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="-10dp"
            android:src="0x7f080b47"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:id="@+id/empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/INTL_VAS_VISITOR_NONE"/>
    </p151v.VLinear>
</RelativeLayout>
