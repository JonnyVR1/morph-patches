<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.svip.opads.BoostIntroCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_svip_boost_purple_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="svip.opads.BoostIntroCardView">
    <p151v.VFrame_FixRatio
        android:id="@+id/fixed_radio_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">
        <p151v.VImage
            android:id="@+id/avatars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </p151v.VFrame_FixRatio>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="#ffffff"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="220dp"
        android:text="黄金时间段来啦"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="163dp"
        android:text="现在“超级曝光”一下，让你的个人资料浏览量立刻暴涨起来！"
        android:lineSpacingMultiplier="1.4"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/boost"
        android:background="@drawable/core_svip_boost_ads_card_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="34dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="64dp"
        android:text="开始超级曝光"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/skip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="34dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="26dp"
        android:text="跳过"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/free_tag"
        android:background="0x7f0817cf"
        android:paddingLeft="9dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="66dp"
        android:text="免费试用1次"/>
</com.p051p1.mobile.putong.core.p058ui.svip.opads.BoostIntroCardView>
