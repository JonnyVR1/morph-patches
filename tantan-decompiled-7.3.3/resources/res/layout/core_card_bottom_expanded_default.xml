<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomDefaultExpandedLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomDefaultExpandedLayout">
    <FrameLayout
        android:id="@+id/card_bottom_upper_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <include
            android:id="@+id/card_bottom_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_card_bottom_expanded_basic_info"/>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/card_bottom_lower_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/online_and_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:id="@+id/online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="medium"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/self_introduction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.p051p1.mobile.putong.core.newui.home.views.IconTextView
                android:id="@+id/icon_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="58dp"/>
        </p151v.VFrame>
        <include
            android:id="@+id/card_bottom_info_profile_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            layout="@layout/core_card_bottom_expanded_profile_item"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomDefaultExpandedLayout>
