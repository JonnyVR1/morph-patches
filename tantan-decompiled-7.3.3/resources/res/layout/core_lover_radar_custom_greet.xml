<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.loveradar.LoveRadarCustomGreetViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="24dp"
            android:textColor="@color/core_color_80percent_000000"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:text="自定义招呼语"/>
        <RelativeLayout
            android:background="@drawable/core_bg_16_stroke_3percent_000000_solid_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="40dp">
            <p151v.VEditText
                android:textSize="16dp"
                android:textColor="@color/core_color_80percent_000000"
                android:textColorHint="@color/core_color_15percent_000000"
                android:gravity="top|left"
                android:id="@+id/edit_greet"
                android:background="@null"
                android:paddingLeft="16dp"
                android:paddingTop="20dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="137dp"
                android:hint="可以尝试添加开场白，展现你的聊天偏好，收获更有深度的聊天"
                android:maxLength="200"
                android:textCursorDrawable="@drawable/core_message_input_cursor"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/create_ai_text"
                android:background="@drawable/core_bg_10_7_percent_fe7e1d"
                android:paddingLeft="8dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp"
                android:layout_below="@+id/edit_greet"
                android:layout_alignRight="@+id/edit_greet">
                <p151v.VImage
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="0x7f080d89"/>
                <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                    android:textSize="14dp"
                    android:textColor="#fe7e1d"
                    android:paddingTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="AI生成"/>
            </p151v.VLinear>
        </RelativeLayout>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="16dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|right"
        android:id="@+id/save"
        android:background="@drawable/core_bg_10_5_percent_000000"
        android:layout_width="66dp"
        android:layout_height="40dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="保存"/>
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_loading"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminate="true"
        app:cpb_color="@color/tantan_orange"
        app:cpb_stroke_width="6dp"/>
</p151v.VFrame>
