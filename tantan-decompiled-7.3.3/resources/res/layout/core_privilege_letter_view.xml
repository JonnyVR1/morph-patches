<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeLetterView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.privilege.PrivilegeLetterView">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar"
        android:layout_width="102dp"
        android:layout_height="102dp"
        android:layout_marginTop="3dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/decorate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08182f"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/letter_panel"
        android:background="0x7f081832"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#04aeff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginRight="2dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/send"
            android:background="@drawable/core_svip_letter_send_oval_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginRight="9dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeLetterView>
