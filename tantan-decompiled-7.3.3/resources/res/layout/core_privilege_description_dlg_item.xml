<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilege.dlg.PrivilegeContentDlgItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="vip.privilege.dlg.PrivilegeContentDlgItemView">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="206dp"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="40dp"
        android:lines="1"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="40dp"
        android:maxLines="2"
        android:layout_weight="1"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="normal"
        android:textColor="@color/common_orange"
        android:gravity="center_vertical"
        android:id="@+id/privilege_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="15dp"
        android:drawableRight="0x7f08140a"
        android:lineSpacingExtra="8sp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.privilege.dlg.PrivilegeContentDlgItemView>
