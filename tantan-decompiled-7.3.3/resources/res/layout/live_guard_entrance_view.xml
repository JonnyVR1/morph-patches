<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LiveGuardEntranceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r16_a03"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    flatten="true"
    folder="increment"
    holder="knight.view.LiveGuardEntranceView">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/guard_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/guard_user_roll_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LivingUserRollAnimView
        android:id="@+id/guard_user_roll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignRight="@+id/entrance_arrow"
        android:layout_centerVertical="true"
        app:enableExitScale="true"
        app:enableExitTranslation="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/entrance_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:liveItemSize="30"
        app:liveViewPadding="5dp"/>
    <p151v.VImage
        android:id="@+id/entrance_arrow"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="15dp"
        android:src="0x7f082307"
        android:layout_alignParentRight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LiveGuardEntranceView>
