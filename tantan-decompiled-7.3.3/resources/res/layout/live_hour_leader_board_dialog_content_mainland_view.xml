<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.HourBoardDialogContentMainlandView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="leaderboard.hourleaderboard.mainland.HourBoardDialogContentMainlandView">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        app:layout_constraintBottom_toTopOf="@+id/header"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty"/>
    <p151v.VDraweeView
        android:id="@+id/bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="207dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/bg_svga"
        android:visibility="invisible"
        android:layout_width="255dp"
        android:layout_height="207dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <p151v.VImage
        android:id="@+id/top_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="207dp"
        android:src="0x7f082323"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <com.p051p1.mobile.putong.live.base.view.DialogTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty"/>
    <View
        android:id="@+id/top_divider"
        android:background="@color/live_white_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_divider"/>
    <include
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="255dp"
        app:layout_constraintTop_toTopOf="@+id/recyclerView"
        layout="@layout/live_hour_leader_board_dialog_content_mainland_empty_view"/>
    <include
        android:id="@+id/own"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/live_hour_list_item_mainland_me"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.HourBoardDialogContentMainlandView>
