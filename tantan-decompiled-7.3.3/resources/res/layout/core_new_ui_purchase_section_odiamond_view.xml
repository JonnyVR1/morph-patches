<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.ODiamondAllPriceSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.showcase.ODiamondAllPriceSectionView">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="121dp"
        android:layout_marginTop="12dp">
        <p151v.VText
            android:textSize="28dp"
            android:textColor="#66ffdea2"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:singleLine="true"/>
        <p151v.VText_AutoFit
            android:textSize="12sp"
            android:textColor="#66ffdea2"
            android:gravity="center"
            android:id="@+id/top_price"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            app:typeface="medium"/>
        <p151v.VText_AutoFit
            android:textSize="15sp"
            android:textColor="#66ffdea2"
            android:gravity="center"
            android:id="@+id/center_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_vip_normal_title_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/label"
        android:paddingTop="1dp"
        android:visibility="invisible"
        android:layout_width="74dp"
        android:layout_height="24dp"
        android:maxLines="1"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.ODiamondAllPriceSectionView>
