<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.TabsPurchaseDialog">
    <FrameLayout
        android:id="@+id/tabs_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.AutoVDraweeView
            android:id="@+id/place_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="268dp"
            app:actualImageScaleType="fitXY"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.p051p1.mobile.putong.core.p058ui.purchase.PurchaseTabViewContainer
                android:id="@+id/tabs_container"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"/>
            <com.p051p1.mobile.putong.core.p058ui.view.VPagerInPurchaseDialog
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/intl_agreement_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/intl_agreement_container_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/intl_agreement_container_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
