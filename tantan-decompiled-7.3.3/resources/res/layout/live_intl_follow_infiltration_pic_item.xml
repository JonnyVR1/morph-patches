<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.livesquare.fragments.followTab.IntlLiveFollowInfiltrationItemPicView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="intl"
    holder="livesquare.fragments.followTab.IntlLiveFollowInfiltrationItemPicView">
    <p151v.VDraweeView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roundedCornerRadius="8dp"/>
    <p151v.VImage
        android:layout_gravity="top|right"
        android:id="@+id/follow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:src="0x7f082110"/>
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp">
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/live_white"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/age"
            android:background="@drawable/live_bg_ff82c2_r3"
            android:paddingLeft="3dp"
            android:paddingTop="0.5dp"
            android:paddingRight="3dp"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_weight="1"
            android:lineSpacingExtra="1sp"/>
    </p151v.VLinear>
    <TextView
        android:textSize="11sp"
        android:textStyle="normal"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:layout_gravity="bottom|left"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:lineSpacingExtra="5sp"/>
</com.p051p1.mobile.putong.live.external.intl.livesquare.fragments.followTab.IntlLiveFollowInfiltrationItemPicView>
