<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="photoalbum.photoalbumfans.PhotoAlbumFansViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:background="#e9000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:pointerIcon="text"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#61000000"
        android:gravity="center"
        android:id="@+id/tips"
        android:background="#f8f8f8"
        android:paddingLeft="17dp"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:text="@string/FOLLOW_FANS_CAN_CHAT_TIP"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VList
            android:id="@+id/fans"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            useId="true"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="167dp">
        <p151v.VDraweeView
            android:id="@+id/empty_img"
            android:layout_width="210dp"
            android:layout_height="150dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#26000000"
            android:gravity="center"
            android:id="@+id/empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</LinearLayout>
