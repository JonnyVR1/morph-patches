<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.consumealert.SetConsumeAlertDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="467dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="@string/LIVE_CONSUME_ALERT_TITLE_TEXT"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <p151v.VImage
        android:id="@+id/back_icon"
        android:visibility="gone"
        android:layout_width="42dp"
        android:layout_height="22dp"
        android:src="0x7f08227f"
        android:paddingStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <p151v.VImage
        android:id="@+id/question_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f082281"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <View
        android:id="@+id/line"
        android:background="@color/live_f9f9f9_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="21dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/switch_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/LIVE_CONSUME_ALERT_SET_COUNT_SWITCH_TITLE"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/switch_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/LIVE_CONSUME_ALERT_SET_COUNT_SWITCH_SUB_TITLE"
        app:layout_constraintStart_toStartOf="@+id/switch_title"
        app:layout_constraintTop_toBottomOf="@+id/switch_title"/>
    <FrameLayout
        android:id="@+id/switch_open"
        android:layout_width="46dp"
        android:layout_height="30dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@+id/switch_sub_title"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/switch_title"
        flatten="true">
        <View
            android:id="@+id/point_bg"
            android:background="@drawable/live_shape_consume_alert_switch_close"
            android:layout_width="46dp"
            android:layout_height="30dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/round_point"
            android:background="@drawable/live_shape_consume_alert_switch_thumb_close"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/set_count_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/LIVE_CONSUME_ALERT_SET_COUNT_TITLE"
        app:layout_constraintStart_toStartOf="@+id/switch_title"
        app:layout_constraintTop_toBottomOf="@+id/switch_sub_title"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@drawable/live_selector_consume_alert_item_text_color"
        android:gravity="center"
        android:id="@+id/count_position_left"
        android:background="@drawable/live_selector_consume_alert_item_bg"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@+id/count_position_center"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/switch_title"
        app:layout_constraintTop_toBottomOf="@+id/set_count_title"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@drawable/live_selector_consume_alert_item_text_color"
        android:gravity="center"
        android:id="@+id/count_position_center"
        android:background="@drawable/live_selector_consume_alert_item_bg"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/count_position_right"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/count_position_left"
        app:layout_constraintTop_toTopOf="@+id/count_position_left"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@drawable/live_selector_consume_alert_item_text_color"
        android:gravity="center"
        android:id="@+id/count_position_right"
        android:background="@drawable/live_selector_consume_alert_item_bg"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/count_position_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/count_position_center"
        app:layout_constraintTop_toTopOf="@+id/count_position_left"/>
    <p151v.VEditText
        android:textColor="@drawable/live_selector_consume_alert_item_text_color"
        android:textColorHint="@color/live_white_20_opacity"
        android:id="@+id/input_number"
        android:background="@drawable/live_selector_consume_alert_item_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:hint="@string/LIVE_CONSUME_ALERT_SET_COUNT_HINT"
        android:singleLine="true"
        android:maxLength="9"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/live_shape_consume_alert_input_cursor_style"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/submit_bt"
        app:layout_constraintTop_toBottomOf="@+id/count_position_left"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/live_white_20_opacity"
        android:id="@+id/hint_unit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CONSUME_ALERT_COUNT_NAME"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_number"
        app:layout_constraintEnd_toEndOf="@+id/input_number"
        app:layout_constraintTop_toTopOf="@+id/input_number"/>
    <TextView
        android:enabled="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@drawable/live_selector_consume_alert_dialog_bt_text_color"
        android:gravity="center"
        android:id="@+id/submit_bt"
        android:background="@drawable/live_selector_consume_alert_dialog_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="52dp"
        android:text="@string/LIVE_CONSUME_ALERT_COUNT_SUBMIT_BUTTON_TEXT"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/input_number"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/live_white_30_opacity"
        android:id="@+id/root_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp"
        android:text="@string/LIVE_CONSUME_ALERT_COUNT_SUBMIT_BUTTON_SUB_TEXT"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/submit_bt"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ruler_linear"
        android:background="@color/live_19191e"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/rules_text_one"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_CONSUME_ALERT_RULES_TEXT_ONE"
            android:lineSpacingExtra="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/rules_text_two"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_CONSUME_ALERT_RULES_TEXT_TWO"
            android:lineSpacingExtra="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rules_text_one"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/rules_text_three"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_CONSUME_ALERT_RULES_TEXT_THREE"
            android:lineSpacingExtra="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rules_text_two"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
