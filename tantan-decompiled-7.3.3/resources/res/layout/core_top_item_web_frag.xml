<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="home.topitemweb.TopItemWebViewModel">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/head"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_66000000"
            android:gravity="center"
            android:id="@+id/right_item_1"
            android:paddingLeft="10dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <com.hellogroup.p036mk.business.base.p037ui.MKWebView
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</p151v.VLinear>
