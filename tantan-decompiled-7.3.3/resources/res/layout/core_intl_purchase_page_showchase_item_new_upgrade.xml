<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.ScrollerGPUpgradePurchaseSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="270dp"
    android:layout_height="160dp"
    holder="purchase.showcase.ScrollerGPUpgradePurchaseSectionView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_01"
            android:gravity="center"
            android:id="@+id/hot_tag"
            android:background="@drawable/core_bg_privilege_price_vip_tag"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:minWidth="46dp"
            android:text="@string/INTL_UPGRADE_SKU_TAG"
            android:singleLine="true"
            android:paddingHorizontal="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VImage
            android:id="@+id/select_img"
            android:background="0x7f080ce4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText_AutoFit
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffe7aa66"
            android:gravity="center"
            android:id="@+id/origin_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/unit"
            app:layout_constraintRight_toRightOf="parent"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="30sp"
            android:textColor="@color/common_grey_01"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hot_tag"
            app:layout_goneMarginTop="25dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_grey_01"
            android:layout_gravity="bottom"
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="5dp"
            android:text="个月"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/count"
            app:layout_constraintLeft_toRightOf="@+id/count"
            app:typeface="regular"/>
        <View
            android:id="@+id/center_price_bg"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <p151v.VText_AutoFit
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/top_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/center_price_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/center_price_bg"
            app:typeface="regular"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/center_price_bg"
            app:layout_constraintRight_toRightOf="@+id/center_price_bg"
            app:layout_constraintTop_toTopOf="@+id/center_price_bg">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#4d000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_UPGRADE_SELECT_DURATION"
                android:maxLines="1"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="20dp"
                android:src="0x7f080cc8"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.ScrollerGPUpgradePurchaseSectionView>
