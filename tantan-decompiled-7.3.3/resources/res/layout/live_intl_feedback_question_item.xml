<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.feedback.item.IntlFeedbackQuestionItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    flatten="true"
    holder="intl.feedback.item.IntlFeedbackQuestionItemView">
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        flatten="true">
        <p151v.VText
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/live_black_80_opacity"
            android:layout_gravity="center_vertical"
            android:id="@+id/question_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"/>
        <p151v.VImage
            android:layout_gravity="end|center_vertical"
            android:id="@+id/question_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f08235a"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="15dp"
        android:textColor="@color/live_black_40_opacity"
        android:id="@+id/answer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>
</com.p051p1.mobile.putong.live.external.intl.feedback.item.IntlFeedbackQuestionItemView>
