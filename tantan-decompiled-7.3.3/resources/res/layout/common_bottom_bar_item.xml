<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="@dimen/common_icon_small"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/common_icon_small"
        android:layout_height="@dimen/common_icon_small"
        android:layout_marginTop="8dp">
        <p151v.bottombar.VBottomBarRippleView
            android:id="@+id/ripple"
            android:layout_width="@dimen/common_icon_small"
            android:layout_height="@dimen/common_icon_small"
            android:layout_centerHorizontal="true"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/picture"
            android:layout_width="23dp"
            android:layout_height="27dp"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="6dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_badge"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp">
        <p151v.RedPointView
            android:id="@+id/badge"
            android:visibility="gone"
            style="@style/common_badge"/>
    </FrameLayout>
    <p151v.VOnlineIndicator
        android:id="@+id/indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp"
        app:indicatorStyle="style01"/>
    <RelativeLayout
        android:id="@+id/placeholder"
        android:visibility="invisible"
        android:clipChildren="false"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp"/>
    <p151v.VImage
        android:id="@+id/dot_icon"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"/>
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="6dp">
        <p151v.VImage
            android:id="@+id/warning_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/common_bottom_bar_warning_icon"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/rl_tab"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp">
        <p151v.VText
            android:textSize="10dp"
            android:textStyle="normal"
            android:textColor="@color/common_grey_03"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </RelativeLayout>
</FrameLayout>
