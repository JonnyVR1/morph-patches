<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_new"
    android:background="@drawable/core_new_message_head_card_bg"
    android:paddingLeft="20dp"
    android:paddingTop="22dp"
    android:paddingRight="20dp"
    android:paddingBottom="25dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="32dp"
    android:layout_marginRight="32dp"
    holder="messages.view.MessageUserHeaderLayout">
    <RelativeLayout
        android:id="@+id/user_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_marginBottom="8dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/me_head"
            android:layout_width="48dp"
            android:layout_height="62dp"
            android:layout_marginTop="3dp"
            android:scaleType="centerCrop"
            android:rotation="-8"
            android:layout_marginStart="2dp"
            style="@style/core_messages_card_img"/>
        <FrameLayout
            android:id="@+id/other_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            flatten="true">
            <View
                android:background="@drawable/core_message_new_other_head_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:rotation="8"/>
            <p151v.VDraweeView
                android:id="@+id/image_small"
                android:layout_width="48dp"
                android:layout_height="62dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="3dp"
                android:rotation="8"
                style="@style/core_messages_card_img"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/match_from"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="-4dp"/>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/tickle_anim_content"
                android:clipChildren="false"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="6dp"
                style="@style/core_im_fresco_profile_small"/>
        </FrameLayout>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/name_age_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_toLeftOf="@+id/check"
            android:layout_toRightOf="@+id/other_layout"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/common_black_02"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:includeFontPadding="false"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:ellipsize="end"
            android:id="@+id/zodiac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:lines="1"
            android:layout_toRightOf="@+id/other_layout"
            android:layout_below="@+id/name_age_layout"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:id="@+id/backup_age"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text=" · 23岁"
            android:layout_toRightOf="@+id/zodiac"
            android:layout_below="@+id/name_age_layout"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4c000000"
            android:gravity="center"
            android:id="@+id/check"
            android:background="@drawable/core_message_check_more_btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="14dp"
            android:text="查看更多"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/location_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/location_layout_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.5dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/core_message_head_location_icon"
                useId="true"/>
            <p151v.VText
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/location_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/meet_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/meet_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.5dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/core_message_head_meet_icon"
                useId="true"/>
            <p151v.VText
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/meet_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/tag_layout_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.5dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/core_message_head_tag_icon"
                useId="true"/>
            <p151v.VText
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tag_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/topic_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/topic_layout_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.5dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/core_message_head_topic_icon"
                useId="true"/>
            <p151v.VText
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/topic_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
