<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="430dp"
    flatten="true"
    folder="common.fansgroup"
    holder="FansGroupDialogHolder">
    <p151v.VRelative
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp">
        <p151v.VImage
            android:id="@+id/back_arrow"
            android:layout_width="22dp"
            android:layout_height="64dp"
            android:src="0x7f08233f"
            android:layout_marginStart="20dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_FANSGROUP_TITLE"
            android:layout_centerInParent="true"/>
        <p151v.VImage
            android:id="@+id/notice"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:src="0x7f082340"
            android:layout_marginEnd="17dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/notice_num"
            android:background="@drawable/live_shape_bg_fansgroup_notice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:minWidth="18dp"
            android:text="12"
            android:lineSpacingExtra="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@drawable/live_bg_f9f9f9_a02_r1"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </p151v.VRelative>
    <include
        android:id="@+id/fansgroup_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        layout="@layout/live_fansgroup_list_content"/>
    <include
        android:id="@+id/fansgroup_notice_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        layout="@layout/live_fansgroup_notice"/>
</p151v.VLinear>
