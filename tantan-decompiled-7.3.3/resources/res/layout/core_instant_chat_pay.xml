<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="purchase.intlInstantChat.InstantChatPaymentComponent">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/pay_root"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/content"
            android:background="@drawable/core_intl_instant_chat_x1_item_bg"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginRight="12dp"
            android:layout_weight="13">
            <p151v.VRelative
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <p151v.VText
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:id="@+id/instant_chat_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:layout_centerHorizontal="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:id="@+id/instant_chat_price"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/instant_chat_count"
                    android:layout_centerHorizontal="true"/>
            </p151v.VRelative>
        </p151v.VRelative>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/instant_chat_root"
            android:background="@drawable/core_intl_button_bg_ultra_premium"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="20"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#f9e7ff"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/instant_chat_pay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#33000000"
        android:textColorLink="#fe7e1d"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/agreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        app:typeface="medium"/>
</LinearLayout>
