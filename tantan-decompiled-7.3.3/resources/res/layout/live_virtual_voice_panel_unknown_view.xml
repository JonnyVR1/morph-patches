<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.panel.unknown.PanelUnknownView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_bg_black_r16_a20"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:bind_extends="LinearLayout"
    app:binding="true">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/content"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:paddingBottom="1dp"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="6dp"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:id="@+id/expand_view"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:layout_marginBottom="14dp"
        flatten="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.panel.unknown.PanelUnknownView>
