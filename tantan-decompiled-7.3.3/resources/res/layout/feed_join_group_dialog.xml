<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/right_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="22dp"
            android:src="0x7f081d48"/>
    </p151v.VFrame>
    <p151v.VDraweeView
        android:id="@+id/group_head_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="40dp"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="12dp"
        style="@style/feed_fresco_base"/>
    <TextView
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_03"
        android:id="@+id/sub_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:text="加入圈子后可以找到更多志同道合的小伙伴～"/>
    <p151v.VButton
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/post"
        android:background="@drawable/common_button_btn_orange_medium"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="12dp"
        android:text="分享我的日常"/>
    <p151v.VRelative
        android:id="@+id/joined_rv_title_rl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="40dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/feed_e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="你可能感兴趣的圈友"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_03"
            android:id="@+id/to_all_friends_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看全部圈友"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </p151v.VRelative>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group_friend_rv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="28dp"
        android:layout_marginBottom="20dp"/>
</LinearLayout>
