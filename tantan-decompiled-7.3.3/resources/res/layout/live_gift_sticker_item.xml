<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.LiveGiftStickerItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_selector_gift_sticker_gift_item_bg"
    android:layout_width="82dp"
    android:layout_height="115dp"
    android:layout_marginTop="6dp"
    folder="common.bottom.sticker"
    holder="LiveGiftStickerItemView">
    <p151v.VDraweeView
        android:id="@+id/item_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_icon"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/live_white_50_opacity"
        android:id="@+id/item_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_title"/>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.LiveGiftStickerItemView>
