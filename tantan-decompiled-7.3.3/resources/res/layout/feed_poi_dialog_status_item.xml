<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.poi.view.FeedPoiDialogStateItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/status_item_root"
    android:background="@drawable/feed_poi_dialog_status_item_bg"
    android:layout_width="68dp"
    android:layout_height="84dp"
    android:layout_marginRight="8dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.poi.view.FeedPoiDialogStateItem">
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/status_item_image"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="5dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/feed_99000000"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/status_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:maxLines="1"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.poi.view.FeedPoiDialogStateItem>
