<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.VoiceWeekStarTopItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66ffffff"
        android:id="@+id/current_rank_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:text="@string/LIVE_CURRENT_WEEK_RANK_HALE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#33ffffff"
        android:id="@+id/current_rank_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="8dp"
        android:text="@string/LIVE_WEEK_STAR_TOP_THREE_REWARDS_DESC"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/rule"
        app:layout_constraintTop_toBottomOf="@+id/current_rank_text"/>
    <p151v.VImage
        android:id="@+id/rule"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="20dp"
        android:src="0x7f08285f"
        app:layout_constraintBottom_toBottomOf="@+id/current_rank_desc"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/current_rank_text"/>
</com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.VoiceWeekStarTopItemView>
