<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterLiveVoiceMomentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_voice_root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="photoalbum.feedcenter.FeedCenterLiveVoiceMomentView">
    <include layout="@layout/feed_photo_album_activities_time"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_voice_moment_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="16dp"
        flatten="false">
        <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
            android:id="@+id/moment_expandable_text"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expandLine="3"
            app:expandText="@string/DISCOVER_MOMENT_SPREAD"
            app:isTextExpandSameLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxCollapsedLines="4">
            <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/live_voice_new_root"
            android:background="@drawable/feed_bg_live_voice_moment"
            android:layout_width="match_parent"
            android:layout_height="83dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/voice_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:src="0x7f081cc4"
                android:scaleType="center"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@+id/voice_image">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_02"
                    android:ellipsize="end"
                    android:id="@+id/voice_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="14dp"
                    android:maxLines="1"/>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/member_count_fl"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    flatten="true">
                    <p151v.VFrame
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VFrame
                            android:id="@+id/pic_one_fl"
                            android:background="@drawable/feed_center_live_voice_moment_pic_bg"
                            android:visibility="gone"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            flatten="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/pic_one"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                style="@style/feed_fresco_profile_small_recommend"/>
                        </p151v.VFrame>
                        <p151v.VFrame
                            android:id="@+id/pic_two_fl"
                            android:background="@drawable/feed_center_live_voice_moment_pic_bg"
                            android:visibility="gone"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginLeft="16dp"
                            flatten="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/pic_two"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                style="@style/feed_fresco_profile_small_recommend"/>
                        </p151v.VFrame>
                        <p151v.VFrame
                            android:id="@+id/pic_three_fl"
                            android:background="@drawable/feed_single_topic_image_bg"
                            android:visibility="gone"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginLeft="33.5dp"
                            flatten="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/pic_three"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                style="@style/feed_fresco_profile_small_recommend"/>
                        </p151v.VFrame>
                    </p151v.VFrame>
                    <p151v.VText
                        android:textSize="10sp"
                        android:textColor="@color/common_grey_09"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/count_tv"
                        android:background="@drawable/feed_center_live_moment_count_bg"
                        android:paddingLeft="7.5dp"
                        android:paddingTop="1dp"
                        android:paddingRight="7.5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="21dp"
                        android:layout_marginLeft="-3.5dp"/>
                </p151v.VLinear>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#d8d8d8"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterLiveVoiceMomentView>
