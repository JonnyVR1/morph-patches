<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.view.MessageIdealTypeHeadLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.view.MessageIdealTypeHeadLayout">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ideal_info_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/ideal_des_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/core_message_head_location_icon"
            useId="true"/>
        <p151v.VText
            android:textColor="#99000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/location_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineHeight="19dp"/>
    </LinearLayout>
    <com.p051p1.mobile.putong.core.view.CommonLabelShowView
        android:id="@+id/ideal_match_label"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="20dp"
        app:itemMaxLines_="1"
        app:itemRadius_="8dp"/>
    <p151v.VRecyclerView
        android:id="@+id/ideal_match_pics"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:overScrollMode="never"/>
</com.p051p1.mobile.putong.core.p058ui.messages.view.MessageIdealTypeHeadLayout>
