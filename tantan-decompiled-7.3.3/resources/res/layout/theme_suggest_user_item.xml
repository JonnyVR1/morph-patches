<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.discovery.SuggestUserItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/likers_item_info_bg"
    android:padding="0.5dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    android:layout_margin="5dp"
    folder="newui"
    holder="discovery.SuggestUserItem">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="4dp"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:layout_gravity="top|right"
        android:id="@+id/online_simple"
        android:background="@drawable/bg_topic_recommand_online"
        android:paddingLeft="5dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:text="@string/HOME_TAB_ONLINE"
        android:drawableLeft="0x7f082a42"/>
    <p151v.VRelative
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/likers_fuzzy_personal_info"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/greet_btn"
            android:background="0x7f082a33"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="11dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="44dp"
            android:maxLines="1"
            android:layout_alignBottom="@+id/greet_btn"
            android:layout_alignParentLeft="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="44dp"
            android:layout_marginBottom="6dp"
            android:text="重生的小胖, 21"
            android:maxLines="1"
            android:layout_above="@+id/distance"
            android:layout_alignParentLeft="true"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.newui.discovery.SuggestUserItem>
