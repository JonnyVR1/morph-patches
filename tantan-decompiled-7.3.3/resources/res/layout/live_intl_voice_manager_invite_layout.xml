<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.manager.invite.IntlVoiceLiveManagerInviteItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    flatten="true"
    folder="voice.intl"
    holder="manager.invite.IntlVoiceLiveManagerInviteItemView">
    <p151v.VDraweeView
        android:id="@+id/header"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/status"
        android:background="@drawable/live_shape_voice_online_status_bg"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintRight_toRightOf="@+id/header"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/inviteBtn"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/LIVE_INVITE"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="40dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintLeft_toRightOf="@+id/header"
        app:layout_constraintRight_toLeftOf="@+id/inviteBtn"
        app:layout_constraintTop_toTopOf="@+id/header"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.manager.invite.IntlVoiceLiveManagerInviteItemView>
