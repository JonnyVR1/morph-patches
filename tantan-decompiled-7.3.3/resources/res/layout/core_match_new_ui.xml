<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/match_root"
    android:fitsSystemWindows="false"
    android:clickable="true"
    android:clipChildren="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.newanim.MatchNewUIActViewModel"
    innerClass="true">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/odiamond_content_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <com.p051p1.mobile.putong.core.view.HeartView
            android:id="@+id/heart_bg"
            android:background="#fffaf9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sunshine.engine.bone.StageView
            android:id="@+id/stageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="#cc000000"
            android:id="@+id/say_hi"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="47dp"
            android:text="@string/CARD_MATCH_SUCCESS_GREETING_TITLE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/match_wooo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="73dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="34sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/pairing"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:maxLines="2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/match_wooo"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/match_pairing_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="40dp"
            android:maxLines="2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pairing"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lines="1"
            android:paddingHorizontal="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/match_pairing_sub"/>
        <p151v.VRelative
            android:id="@+id/match_head_me_container"
            android:layout_width="190dp"
            android:layout_height="200dp"
            android:layout_marginTop="181dp"
            app:layout_constraintRight_toRightOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/match_wooo"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/match_head_me"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_centerInParent="true"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundAsCircle="true"/>
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/svga_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VImage
                android:id="@+id/super_love_heart_me"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="0x7f080df0"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </p151v.VRelative>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <p151v.VRelative
            android:enabled="false"
            android:id="@+id/match_head_other_container"
            android:clickable="false"
            android:layout_width="190dp"
            android:layout_height="200dp"
            android:layout_marginTop="181dp"
            app:layout_constraintLeft_toLeftOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/match_wooo"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/match_head_other"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_centerInParent="true"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundAsCircle="true"/>
            <p151v.VImage
                android:id="@+id/super_love_heart_other"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="0x7f080def"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <p151v.VFrame
                android:id="@+id/pic_icon"
                android:visibility="gone"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                flatten="true">
                <p151v.VIcon
                    android:layout_gravity="center"
                    android:id="@+id/pic_icon_outer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="0x7f0805eb"
                    android:scaleType="fitXY"/>
                <p151v.VIcon
                    android:layout_gravity="center"
                    android:id="@+id/pic_icon_inner"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="0x7f0805ea"
                    android:scaleType="fitXY"/>
            </p151v.VFrame>
            <View
                android:id="@+id/online"
                android:background="@drawable/core_free_trial_online"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="23dp"
                android:layout_marginBottom="23dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
            <p151v.VImage
                android:id="@+id/intl_receive_like_other"
                android:visibility="gone"
                android:layout_width="200dp"
                android:layout_height="70dp"
                android:layout_marginBottom="-13dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </p151v.VRelative>
        <p151v.VRecyclerView
            android:orientation="horizontal"
            android:id="@+id/icebreaks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/edit_wrapper"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/fake_sendmsg"
            android:background="@drawable/fake_matchact_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="43dp"
            android:layout_marginTop="55dp"
            android:layout_marginRight="43dp"
            android:text="发消息"
            app:layout_constraintTop_toBottomOf="@+id/match_head_other_container"/>
        <TextView
            android:textColor="#80000000"
            android:gravity="center"
            android:id="@+id/fake_cancel_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="43dp"
            android:layout_marginRight="43dp"
            android:text="放弃"
            app:layout_constraintTop_toBottomOf="@+id/fake_sendmsg"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/cert_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/match_head_me_container">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#4d000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/cert_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="完成认证，招呼更容易被回应"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080ddd"/>
        </p151v.VLinear>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/edit_wrapper"
            android:background="@drawable/core_match_new_ui_edit_shape"
            android:focusableInTouchMode="true"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="51dp"
            android:layout_marginRight="40dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/match_head_me_container"
            flatten="true">
            <p151v.VEditText
                android:textSize="18sp"
                android:textColor="@color/common_black_01"
                android:textColorHint="@color/common_grey_03"
                android:ellipsize="end"
                android:id="@+id/edit_text"
                android:background="@null"
                android:paddingLeft="24dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:hint="@string/MATCH_BOX_DEFAULT_TEXT"
                android:maxLines="1"
                android:maxLength="1000"
                android:layout_weight="1"
                android:inputType="textAutoCorrect"
                app:typeface="regular"/>
            <p151v.VText
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="@color/common_orange"
                android:gravity="center"
                android:id="@+id/text_send"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/MATCH_TEXT_SEND"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:autoSizeMaxTextSize="16sp"/>
        </LinearLayout>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/emoji_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_wrapper"
            flatten="true">
            <FrameLayout
                android:id="@+id/first_emoji_frame"
                android:background="@drawable/core_match_success_emoji_item_background"
                android:layout_width="56dp"
                android:layout_height="56dp"
                flatten="true">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/svga_first_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/first_emoji_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:src="@drawable/core_match_success_emoji_item_background_odiamond"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/first_emoji_text"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </FrameLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/second_emoji_frame"
                android:background="@drawable/core_match_success_emoji_item_background"
                android:layout_width="56dp"
                android:layout_height="56dp"
                flatten="true">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/svga_second_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/second_emoji_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:src="@drawable/core_match_success_emoji_item_background_odiamond"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/second_emoji_text"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </FrameLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/third_emoji_frame"
                android:background="@drawable/core_match_success_emoji_item_background"
                android:layout_width="56dp"
                android:layout_height="56dp"
                flatten="true">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/svga_third_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/third_emoji_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:src="@drawable/core_match_success_emoji_item_background_odiamond"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/third_emoji_text"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </FrameLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/fourth_emoji_frame"
                android:background="@drawable/core_match_success_emoji_item_background"
                android:layout_width="56dp"
                android:layout_height="56dp"
                flatten="true">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/svga_fourth_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/fourth_emoji_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:src="@drawable/core_match_success_emoji_item_background_odiamond"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/fourth_emoji_text"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </FrameLayout>
        </p151v.VLinear>
        <p151v.VButton_FakeShadow
            android:textColor="@color/common_grey_01"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cancel"
            android:background="@null"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="25dp"
            android:minWidth="264dp"
            android:minHeight="48dp"
            android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
            android:layout_below="@+id/edit_wrapper"
            android:layout_centerHorizontal="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emoji_layout"
            style="@style/core_main_button"/>
        <p151v.VButton
            android:textSize="15sp"
            android:textColor="@color/common_grey_01"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/share"
            android:background="@null"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/SHARE_MATCH_TELL_YOUR_FRIENDS"
            android:maxLines="1"
            android:drawableLeft="0x7f080de2"
            android:drawablePadding="6dp"
            android:layout_alignParentBottom="true"
            android:textAllCaps="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
