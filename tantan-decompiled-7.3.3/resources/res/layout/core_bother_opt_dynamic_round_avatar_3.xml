<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/three_pic_avatar_left"
        android:background="0x7f080575"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/three_pic_avatar_right"
        android:background="0x7f080575"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/three_pic_avatar_center"
        android:background="0x7f080573"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:roundAsCircle="true"/>
    <p151v.VImage
        android:layout_gravity="bottom|right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="9dp"
        android:src="0x7f080574"/>
</p151v.VFrame>
