<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_explore_tags"
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/explore_tags_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        fresco:actualImageScaleType="centerInside"
        fresco:failureImage="@drawable/common_card_image_holder_full_round"
        fresco:failureImageScaleType="centerInside"
        fresco:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"
        useId="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/explore_tag_name"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:lines="1"
        android:layout_marginStart="2dp"/>
</p151v.VLinear>
