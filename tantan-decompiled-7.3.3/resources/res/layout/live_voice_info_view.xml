<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.roominfobar.VoiceRoomInfoView xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.roominfobar.VoiceRoomInfoView">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/oversea_header"
        android:background="@drawable/live_shape_voice_room_header_info_bg"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:paddingStart="12dp"
        android:paddingEnd="21dp"
        flatten="true">
        <TextView
            android:textSize="11sp"
            android:textStyle="normal"
            android:textColor="#ffe28d"
            android:gravity="center"
            android:id="@+id/room_tags"
            android:background="@drawable/live_shape_voice_room_title_tags_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="4dp"
            android:maxLines="1"/>
        <com.p051p1.mobile.putong.live.livingroom.view.FocusTextView
            android:textSize="16dp"
            android:textColor="@color/live_white"
            android:ellipsize="marquee"
            android:id="@+id/room_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="113dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:shadowColor="#3f000000"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:marqueeRepeatLimit="marquee_forever"/>
        <ImageView
            android:id="@+id/edit_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f082840"/>
        <p151v.VText
            android:textSize="11sp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/follow_btn"
            android:background="@drawable/live_bg_fe7e1d_r8"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_FOLLOW"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/mainland_header"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/live_shape_voice_room_header_info_bg"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="44dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                flatten="true">
                <com.p051p1.mobile.putong.live.livingroom.view.FocusTextView
                    android:textSize="14sp"
                    android:textColor="@color/live_white"
                    android:ellipsize="marquee"
                    android:id="@+id/mainland_room_title"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxWidth="70dp"
                    android:text="xxxxxx"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:shadowColor="#3f000000"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:marqueeRepeatLimit="marquee_forever"/>
                <TextView
                    android:textSize="8sp"
                    android:textColor="@color/live_white"
                    android:ellipsize="end"
                    android:id="@+id/heart_beat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxWidth="44dp"
                    android:singleLine="true"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/mainland_follow_btn"
                android:background="@drawable/live_bg_ff8817_r10"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:text="@string/LIVE_FOLLOW"
                android:layout_toRightOf="@+id/container"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"/>
        </RelativeLayout>
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.roominfobar.VoiceRoomInfoView>
