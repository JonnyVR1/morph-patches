<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.QuickChatHeaderUserView">
    <p151v.VDraweeView
        android:id="@+id/profile_user"
        android:background="@drawable/splash_match_dlg_oval"
        android:padding="3dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="20dp"
        android:layout_centerVertical="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f0812e7"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:id="@+id/green"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:src="0x7f0815d3"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/profile_user"
        app:layout_constraintRight_toRightOf="@+id/profile_user"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="32dp"
        android:layout_toRightOf="@+id/profile_user"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@+id/profile_user"
        app:layout_constraintLeft_toRightOf="@+id/profile_user"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profile_user">
        <TextView
            android:textSize="17sp"
            android:textStyle="normal"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            android:drawablePadding="4dp"
            android:lineHeight="25dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/sex"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:maxLines="1"
            android:drawablePadding="3dp"/>
    </LinearLayout>
    <p151v.VImage
        android:id="@+id/close"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0815c6"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="20dp"
        android:gravity="center"
        android:id="@+id/tag1"
        android:background="@drawable/core_quickchat_fuliao_tag_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="18dp"
        android:text="[呲牙]"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_user"/>
    <p151v.VText
        android:textSize="20dp"
        android:gravity="center"
        android:id="@+id/tag2"
        android:background="@drawable/core_quickchat_fuliao_tag_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="18dp"
        android:text="[呲牙]"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintLeft_toRightOf="@+id/tag1"
        app:layout_constraintTop_toBottomOf="@+id/profile_user"/>
    <p151v.VText
        android:textSize="20dp"
        android:gravity="center"
        android:id="@+id/tag3"
        android:background="@drawable/core_quickchat_fuliao_tag_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="18dp"
        android:text="[呲牙]"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintLeft_toRightOf="@+id/tag2"
        app:layout_constraintTop_toBottomOf="@+id/profile_user"/>
    <p151v.VText
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/gotochat"
        android:background="@drawable/core_quickchat_fuliao_tag_bg"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:text="即刻聊天"
        app:layout_constraintLeft_toRightOf="@+id/tag3"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_user"
        app:typeface="regular"/>
</merge>
