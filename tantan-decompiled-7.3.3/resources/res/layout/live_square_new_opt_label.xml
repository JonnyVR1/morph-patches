<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.view.LiveNewOptLabelView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="view.LiveNewOptLabelView">
    <p151v.VLinear
        android:id="@+id/container_label_a"
        android:background="@drawable/live_bg_fe7e1d_r6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/a_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="2dp"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/a_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:singleLine="true"
            android:maxLength="12"
            android:layout_marginHorizontal="6dp"/>
    </p151v.VLinear>
    <p151v.VDraweeView
        android:id="@+id/b_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:id="@+id/c_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="47dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.live.base.view.LiveNewOptLabelView>
