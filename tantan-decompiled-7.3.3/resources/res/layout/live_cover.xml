<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="#383e46"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="other.livecover"
    holder="LiveCoverAct">
    <p151v.VDraweeView
        android:id="@+id/image_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:failureImage="@drawable/live_shape_pull_up_bg"
        fresco:placeholderImage="@drawable/live_shape_pull_up_bg"
        style="@style/live_fresco_base"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/live_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="22dp"
            android:src="0x7f08268a"/>
        <FrameLayout
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <p151v.VDraweeView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                fresco:actualImageScaleType="centerCrop"
                fresco:failureImage="0x7f082284"
                fresco:failureImageScaleType="centerCrop"
                fresco:placeholderImage="0x7f082284"
                fresco:placeholderImageScaleType="centerCrop"
                fresco:roundBottomLeft="true"
                fresco:roundBottomRight="true"
                fresco:roundTopLeft="true"
                fresco:roundTopRight="true"
                fresco:roundedCornerRadius="16dp"
                style="@style/live_fresco_base"
                useId="true"/>
            <p151v.VButton
                android:textSize="13sp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/change"
                android:background="@drawable/live_bg_black_r10_a40"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:text="@string/LIVE_REPLACE"
                android:layout_marginEnd="8dp"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_COVER"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#80ffffff"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="32dp"
            android:text="@string/LIVE_COVER_UPDATE_WARNING"
            android:lineSpacingExtra="5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#027abb"
            android:layout_gravity="center_horizontal"
            android:id="@+id/see_cover_rule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/LIVE_CHECK_EXAMPLE_COVER"/>
    </LinearLayout>
    <p151v.VButton
        android:enabled="false"
        android:textSize="17sp"
        android:textColor="@drawable/live_selector_cover_text_color_selector"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/confirm"
        android:background="@drawable/live_bg_black_r10_a40"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="48dp"
        android:text="@string/LIVE_COVER_SUBMIT_AUDIT"/>
</FrameLayout>
