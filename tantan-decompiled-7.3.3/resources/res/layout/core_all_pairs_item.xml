<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.AllPairsItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/match_layout_container"
    android:background="@drawable/liked_user_item_info_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    folder="newui"
    holder="messages.AllPairsItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="10dp"
        style="@style/core_fresco_base"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_color_b3ffffff"
            android:gravity="center_vertical"
            android:id="@+id/online_status"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/MY_TANTAN_CARD_ONLINE"
            android:drawableLeft="0x7f0812eb"
            android:drawablePadding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:typeface="regular"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/core_color_b3ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_user_info_sub"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:typeface="regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/core_color_b3ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_user_info1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                app:typeface="regular"/>
            <View
                android:background="@drawable/core_online_match_view_long"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginHorizontal="4dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/core_color_b3ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_user_info2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                app:typeface="regular"/>
            <View
                android:background="@drawable/core_online_match_view_long"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginHorizontal="4dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/core_color_b3ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_user_info3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                app:typeface="regular"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:divider="@drawable/core_online_match_tag_linear_divider"
        android:showDividers="middle">
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/core_color_b3ffffff"
            android:gravity="center"
            android:id="@+id/newly"
            android:background="@drawable/all_match_new_bg"
            android:visibility="gone"
            android:drawingCacheQuality="high"
            android:layout_width="38dp"
            android:layout_height="20dp"
            android:text="new"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/core_color_b3ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/online_match"
            android:background="@drawable/core_online_match_tag_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/QUICK_CHAT_MATCH"
            android:lines="1"
            android:drawablePadding="3dp"
            app:typeface="medium"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.newui.messages.AllPairsItemView>
