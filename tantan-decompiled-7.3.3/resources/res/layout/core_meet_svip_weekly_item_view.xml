<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.feed.weekly.MeetFeedSvipWeeklyItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="newmeet.feed.weekly.MeetFeedSvipWeeklyItemView">
    <RelativeLayout
        android:id="@+id/header_container"
        android:paddingLeft="12dp"
        android:paddingTop="14dp"
        android:paddingRight="3dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        flatten="true">
        <ImageView
            android:id="@+id/header_privilege_ic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:src="0x7f08184a"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/core_A33B00"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="12dp"
            android:text="SVIP会员周报"
            android:lines="1"
            android:layout_toLeftOf="@+id/header_arrow_ic"
            android:layout_toRightOf="@+id/header_privilege_ic"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_40percent_B55E2C"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            android:text="尊敬的SVIP会员，本周你的探探周报更新啦"
            android:lines="1"
            android:layout_toLeftOf="@+id/header_arrow_ic"
            android:layout_toRightOf="@+id/header_privilege_ic"
            android:layout_below="@+id/header_title"/>
        <ImageView
            android:id="@+id/header_arrow_ic"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="0x7f081848"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/weekly_content_container"
        android:background="@drawable/core_svip_weekly_module_container_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="24dp"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/weekly_content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/svip_renew_btn"
            android:background="@drawable/core_svip_weekly_svip_renew_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="16dp"
            android:text="立即续费"
            android:lines="1"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/core_40percent_BB4300"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/odiamond_buy_btn"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:text="升级黑金会员，解锁更多特权"
            android:lines="1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.newmeet.feed.weekly.MeetFeedSvipWeeklyItemView>
