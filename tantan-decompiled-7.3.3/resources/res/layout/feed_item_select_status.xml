<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/feed_select_status_item_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="status.selectstatus.adapter.FeedSelectStatusItem">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/image"
        android:layout_width="64dp"
        android:layout_height="64dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_gravity="center"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"/>
</p151v.VLinear>
