<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="210dp"
    android:layout_height="120dp">
    <p151v.AutoVDraweeView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/three_pic_avatar_left"
        android:layout_width="@dimen/picks_showcase_composite_picture_small_width"
        android:layout_height="@dimen/picks_showcase_composite_picture_small_height"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="4dp"
        android:rotation="-15"
        android:layout_marginStart="30dp"
        fresco:failureImage="@drawable/core_picks_showcase_composite_picture_load_fail"
        fresco:failureImageScaleType="centerInside"
        fresco:placeholderImage="@color/picks_showcase_dialog_top_image_default_color"
        fresco:placeholderImageScaleType="centerInside"
        style="@style/picks_showcase_composite_picture_small"/>
    <p151v.AutoVDraweeView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/three_pic_avatar_right"
        android:layout_width="@dimen/picks_showcase_composite_picture_small_width"
        android:layout_height="@dimen/picks_showcase_composite_picture_small_height"
        android:layout_marginTop="4dp"
        android:layout_marginRight="30dp"
        android:rotation="15"
        android:layout_marginEnd="30dp"
        fresco:failureImage="@drawable/core_picks_showcase_composite_picture_load_fail"
        fresco:failureImageScaleType="centerInside"
        fresco:placeholderImage="@color/picks_showcase_dialog_top_image_default_color"
        fresco:placeholderImageScaleType="centerInside"
        style="@style/picks_showcase_composite_picture_small"/>
    <p151v.AutoVDraweeView
        android:layout_gravity="center"
        android:id="@+id/three_pic_avatar_center"
        android:layout_width="@dimen/picks_showcase_composite_picture_width"
        android:layout_height="@dimen/picks_showcase_composite_picture_height"
        fresco:failureImage="@drawable/core_picks_showcase_composite_picture_load_fail"
        fresco:failureImageScaleType="centerInside"
        fresco:placeholderImage="@color/picks_showcase_dialog_top_image_default_color"
        fresco:placeholderImageScaleType="centerInside"
        style="@style/picks_showcase_composite_picture_big"/>
    <p151v.VImage
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/heart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:src="0x7f082959"/>
</p151v.VFrame>
