<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    folder="newui"
    holder="messages.SetNicknameActViewModel"
    style="@style/core_im_account_root">
    <p151v.VScroll style="@style/core_im_account_scroll">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:id="@+id/nickname_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="备注名"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VMaterialEdit
                    android:id="@+id/nickname"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="20dp"
                    android:imeOptions="actionDone"
                    app:met_minCharacters="0"
                    style="@style/core_im_account_name"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/delete_icon"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-50dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f080890"/>
            </LinearLayout>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:id="@+id/done_"
        android:text="@string/ACTION_DONE"
        style="@style/core_im_account_continue_button"/>
</p151v.VLinear>
