<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.heatbox.VoiceLiveHeatBoxEntryView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/entry"
    android:background="@drawable/live_bg_black_r8_a15"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:maxWidth="140dp"
    flatten="true"
    folder="voice.intl"
    holder="heatbox.VoiceLiveHeatBoxEntryView">
    <View
        android:id="@+id/pink_bg"
        android:background="@drawable/live_bg_black_r10_a30"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxWidth="140dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VMarqueeText
        android:textSize="10sp"
        android:textColor="#e6ffffff"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/guideText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:paddingEnd="10dp"
        android:layout_marginStart="2dp"
        app:layout_constraintLeft_toRightOf="@+id/icon"/>
    <p151v.VMarqueeText
        android:textSize="10sp"
        android:textColor="#e6ffffff"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:paddingEnd="10dp"
        android:layout_marginStart="2dp"
        app:layout_constraintLeft_toRightOf="@+id/icon"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.heatbox.VoiceLiveHeatBoxEntryView>
