<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.VipIntroPage3 xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="vip.VipIntroPage3">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/bg"
            android:layout="@layout/vip_alert_dialog_page_top_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <ViewStub
            android:id="@+id/vip_badge"
            android:layout="@layout/core_vip_alert_dialog_page_3_vip_badge"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vip_alert_dynamic_content_height"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/vip_super_like"
            android:layout="@layout/vip_alert_dialog_page_3_super_like"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/vip_undo"
            android:layout="@layout/vip_alert_dialog_page_3_vip_undo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/vip_location"
            android:layout="@layout/vip_alert_dialog_page_3_vip_location"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/vip_unlimited_likes"
            android:layout="@layout/vip_alert_dialog_page_3_vip_unlimited_likes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/svip"
            android:layout="@layout/svip_alert_dialog_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/see"
            android:layout="@layout/see_alert_dialog_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/quick_chat"
            android:layout="@layout/quick_chat_alert_dialog_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/vip_letter"
            android:layout="@layout/letter_privilege_count_component"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/common_grey_01"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/txt_digest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:text="尊贵会员身份标识"
            android:maxLines="2"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_03"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/txt_content"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="昵称升级，专属身份标识！"
            android:maxLines="1"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.VipIntroPage3>
