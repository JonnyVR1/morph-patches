<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemGroupInviteMessage xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemGroupInviteMessage"
    innerClass="true">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_msg_bg_radius_10_f9f9f9"
        android:padding="16dp"
        android:visibility="visible"
        android:layout_width="256dp"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/image"
                android:background="@drawable/core_bg_10_ffffff"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:failureImage="0x7f0808ac"
                app:placeholderImage="0x7f0808ac"
                app:roundedCornerRadius="@dimen/core_common_radius"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:id="@+id/sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/enter_group_bt_content"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/common_orange"
                android:gravity="center"
                android:id="@+id/enter_group_bt"
                android:background="@drawable/core_bg_10_ffffff"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="点击进去群聊"
                android:layout_weight="1"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemGroupInviteMessage>
