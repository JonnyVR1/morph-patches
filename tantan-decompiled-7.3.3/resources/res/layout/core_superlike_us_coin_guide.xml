<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="30dp"
    android:paddingTop="55dp"
    android:paddingRight="30dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0818a5"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/ACTION_SUPERLIKE"
        android:maxLines="2"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="4dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/checkbox"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/tv_content">
        <p151v.VCheckBox
            android:id="@+id/check"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:checked="true"
            android:button="@null"
            style="@style/common_checkbox"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_04"
            android:layout_gravity="center_vertical"
            android:id="@+id/reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/RATE_TANTAN_NEVER"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</p151v.VLinear>
