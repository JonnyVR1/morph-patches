<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VText
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/core_gray_212121"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/GP_SUBS_FAILED_TITLE"/>
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:src="0x7f081f6e"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/gray_999999"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="40dp"
        android:text="@string/GP_SUBS_FAILED_CONTENT"/>
</p151v.VLinear>
