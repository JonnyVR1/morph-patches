<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.greet.hello.VerticalTextSwitcher xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="greet.hello.VerticalTextSwitcher">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/first"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:singleLine="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/second"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.core.p058ui.greet.hello.VerticalTextSwitcher>
