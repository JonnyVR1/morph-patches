<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/superlike_banner"
    android:background="0x7f081fa1"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    folder="newui"
    holder="home.views.SuperLikeBannerView">
    <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
        android:id="@+id/icon"
        android:drawingCacheQuality="high"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:layout_centerHorizontal="true"
        app:buttonColorEnd="#03aeff"
        app:buttonColorStart="#6ad3ff"
        app:icon="0x7f08178b"
        app:iconWidth="18dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#03aeff"
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="14dp"
        android:text="@string/SUPERLIKE_CARD_BANNER_TEXT_FEMALE"/>
</LinearLayout>
