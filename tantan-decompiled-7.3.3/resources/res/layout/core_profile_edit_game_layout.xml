<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingLeft="20dp"
    android:paddingTop="18dp"
    android:paddingRight="20dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    flatten="false"
    holder="profile.profilelist.itemholders.EditProfileGameItemHolder">
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="15sp"
        android:textColor="@color/core_color_66000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="游戏日常"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/game_name_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/looking_partner_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/rank_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/micro_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/game_screenshots_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/game_screenshots_title"
            android:paddingTop="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="false">
            <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                android:textColor="#cc000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="游戏截图"
                android:layout_weight="1"/>
            <p151v.VImage
                android:id="@+id/game_screenshots_icon_add"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/core_profile_edit_data_right_add"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/game_screenshots_icon_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08145e"
                android:layout_weight="0"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/screenshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            flatten="false">
            <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileGameImageView
                android:id="@+id/screenshot_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileGameImageView
                android:id="@+id/screenshot_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileGameImageView
                android:id="@+id/screenshot_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</p151v.VLinear_Dividers>
