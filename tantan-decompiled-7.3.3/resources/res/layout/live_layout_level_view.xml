<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/level_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_1"
        app:layout_constraintStart_toStartOf="@+id/node_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level_tag_1"
        android:background="0x7f082760"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="2dp"
        app:layout_constraintEnd_toEndOf="@+id/level_1"
        app:layout_constraintStart_toStartOf="@+id/level_1"
        app:layout_constraintTop_toBottomOf="@+id/level_1"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/level_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_2"
        app:layout_constraintStart_toStartOf="@+id/node_2"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level_tag_2"
        android:background="0x7f082760"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="2dp"
        app:layout_constraintEnd_toEndOf="@+id/level_2"
        app:layout_constraintStart_toStartOf="@+id/level_2"
        app:layout_constraintTop_toBottomOf="@+id/level_2"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/level_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_3"
        app:layout_constraintStart_toStartOf="@+id/node_3"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level_tag_3"
        android:background="0x7f082760"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="2dp"
        app:layout_constraintEnd_toEndOf="@+id/level_3"
        app:layout_constraintStart_toStartOf="@+id/level_3"
        app:layout_constraintTop_toBottomOf="@+id/level_3"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/level_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_progress_bar"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level_tag_4"
        android:background="0x7f082760"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="2dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/level_4"
        app:layout_constraintTop_toBottomOf="@+id/level_4"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:id="@+id/num_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_1"
        app:layout_constraintStart_toStartOf="@+id/node_1"
        app:layout_constraintTop_toBottomOf="@+id/node_1"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:id="@+id/num_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_2"
        app:layout_constraintStart_toStartOf="@+id/node_2"
        app:layout_constraintTop_toBottomOf="@+id/node_2"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:id="@+id/num_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_3"
        app:layout_constraintStart_toStartOf="@+id/node_3"
        app:layout_constraintTop_toBottomOf="@+id/node_3"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/white"
        android:id="@+id/num_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/node_4"
        app:layout_constraintStart_toStartOf="@+id/node_4"
        app:layout_constraintTop_toBottomOf="@+id/node_4"/>
    <ImageView
        android:id="@+id/node_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/node_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/level_2"/>
    <ImageView
        android:id="@+id/node_2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/node_3"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/node_1"
        app:layout_constraintTop_toBottomOf="@+id/level_2"/>
    <ImageView
        android:id="@+id/node_3"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/node_4"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/node_2"
        app:layout_constraintTop_toBottomOf="@+id/level_2"/>
    <ImageView
        android:id="@+id/node_4"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/node_3"
        app:layout_constraintTop_toBottomOf="@+id/level_2"/>
    <ProgressBar
        android:id="@+id/node_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="-1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/level_1"
        style="@style/live_level_progress_horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
