<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/root_origin"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToOutline="false"
    holder="messages.view.MessageUserHeaderLayout">
    <FrameLayout
        android:layout_gravity="top"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <p151v.VDraweeView
            android:layout_gravity="bottom"
            android:id="@+id/image_small"
            android:layout_width="?attr/message_page_profile_pic_size"
            android:layout_height="?attr/message_page_profile_pic_size"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            style="@style/core_im_fresco_profile_small"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/tickle_anim_content"
            android:clipChildren="false"
            android:layout_width="?attr/message_page_profile_pic_size"
            android:layout_height="?attr/message_page_profile_pic_size"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            style="@style/core_im_fresco_profile_small"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/profile_bubble"
        android:background="@drawable/core_message_head_bg"
        android:paddingBottom="14dp"
        android:layout_width="213dp"
        android:layout_height="280dp"
        android:layout_marginTop="2dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/layout_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/profile_image"
                android:layout_width="match_parent"
                android:layout_height="216dp"
                app:roundBottomLeft="false"
                app:roundBottomRight="false"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="bottom|left"
                android:id="@+id/match_from"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerInside"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/intl_instant_match_tag"
                android:visibility="gone"
                android:layout_width="170dp"
                android:layout_height="80dp"
                android:layout_marginRight="-24dp"
                android:layout_marginBottom="8dp"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <ViewStub
            android:layout_gravity="bottom"
            android:id="@+id/vs_about_me_oniv"
            android:layout="@layout/core_message_header_about_me_oniv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:id="@+id/date_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="14dp"
            android:lineSpacingExtra="2dp"/>
        <ViewStub
            android:id="@+id/vs_aboutme_content"
            android:layout="@layout/core_message_header_about_me_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"/>
    </LinearLayout>
</LinearLayout>
