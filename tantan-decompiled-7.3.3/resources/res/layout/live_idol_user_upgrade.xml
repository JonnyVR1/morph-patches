<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.topeffect.view.IdolUserUpgradeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="increment"
    holder="gift.topeffect.view.IdolUserUpgradeView">
    <View
        android:id="@+id/shadow"
        android:background="@drawable/live_shape_user_upgrade_shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
    <FrameLayout
        android:id="@+id/upgrade_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="40dp"
            fresco:failureImage="@drawable/live_vector_default_avatar_bg"
            fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
            fresco:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_horizontal"
            android:id="@+id/bg_svga"
            android:layout_width="310dp"
            android:layout_height="140dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/text_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="96dp"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="84dp"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ffdd19"
                android:id="@+id/level_to_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_WEALTH_LEVEL_REACHED"/>
            <p151v.VDraweeView
                android:id="@+id/level_icon"
                android:layout_width="30dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.topeffect.view.IdolUserUpgradeView>
