        android:paddingRight="8dp"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ACTION_DONE"
        android:layout_centerVertical="true"
        app:typeface="medium"/>
</RelativeLayout>
