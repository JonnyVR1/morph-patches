<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.group.CoreGroupChatHeaderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_fl"
    android:paddingLeft="0dp"
    android:paddingTop="10dp"
    android:paddingRight="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="group.CoreGroupChatHeaderView">
    <p151v.VRelative
        android:id="@+id/group_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_grey_09"
            android:id="@+id/title_chat_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="群聊"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:id="@+id/chat_group_more"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看更多"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </p151v.VRelative>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/group_contain"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"/>
    <p151v.VRelative
        android:id="@+id/chat_room_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_grey_09"
            android:id="@+id/title_chat_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="聊天室"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:id="@+id/chat_room_more"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看更多"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.newui.group.CoreGroupChatHeaderView>
