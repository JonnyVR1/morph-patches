<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.internal.PkViewInternal xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="recreation"
    holder="pk.internal.PkViewInternal">
    <include
        android:layout_gravity="bottom"
        android:id="@+id/pk_decorate_view"
        android:background="@color/red"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="10dp"
        layout="@layout/live_pk_decorate_view_internal"/>
    <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkScoreView
        android:layout_gravity="bottom"
        android:id="@+id/pk_score_view"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"/>
    <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkCursorView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pk_cursor_view"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"/>
    <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkMagnetCardView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pk_magnet_card_view"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/time_view_alpha"
            android:background="@drawable/live_bg_ff4081_r13_a70"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/time_view_bg"
            android:background="@drawable/live_bg_212121_r10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_time_view"
            android:background="@drawable/live_bg_212121_r10"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/top_pk_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="5dp"
                android:src="0x7f08246d"
                android:scaleType="centerInside"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/top_time_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_result_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_SETTLING"/>
            </FrameLayout>
            <View
                android:id="@+id/view_place"
                android:layout_width="10dp"
                android:layout_height="2dp"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/top_view_close"
                android:padding="6dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="5dp"
                android:src="0x7f082459"
                android:scaleType="centerInside"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="32.5dp">
        <View
            android:id="@+id/left_cards_bg"
            android:background="0x7f082437"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5"/>
        <View
            android:id="@+id/right_cards_bg"
            android:background="0x7f082486"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/anchor_utils_card_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_cards_bg"
            app:layout_constraintStart_toStartOf="@+id/left_cards_bg"
            app:layout_constraintTop_toTopOf="@+id/left_cards_bg"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/other_utils_card_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/right_cards_bg"
            app:layout_constraintEnd_toEndOf="@+id/right_cards_bg"
            app:layout_constraintTop_toTopOf="@+id/right_cards_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VImage
        android:layout_gravity="bottom|right"
        android:id="@+id/other_user_mute"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="102dp"
        android:src="0x7f08249d"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end|top"
        android:id="@+id/other_user"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="8dp"
        flatten="true">
        <View
            android:id="@+id/has_follow_back"
            android:background="@drawable/live_shape_pk_other_avatar_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="@+id/center_head_space"
            app:layout_constraintRight_toRightOf="parent"/>
        <Space
            android:id="@+id/center_head_space"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toLeftOf="@+id/other_user_icon"
            app:layout_constraintRight_toRightOf="@+id/other_user_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/other_user_icon"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:failureImageScaleType="centerInside"
            app:layout_constraintLeft_toLeftOf="parent"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:roundAsCircle="true"
            app:roundingBorderColor="#fff"
            app:roundingBorderWidth="0dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/other_anchor_name"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="46dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/other_user_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/follow_other_user"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="@dimen/live_pk_follow_other_user"
            android:src="0x7f082467"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/other_anchor_name"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/follow_other_user_text"
            android:background="@drawable/live_bg_ff8817_r7"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/FOLLOW_STATE_WITHOUT_PLUS"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/follow_other_user"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:layout_width="2dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toRightOf="@+id/follow_other_user_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="46dp"
        android:layout_marginBottom="42dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_gravity="start|bottom"
                android:orientation="vertical"
                android:id="@+id/anchor_result_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:layout_marginStart="10dp"
                flatten="true">
                <include
                    android:id="@+id/anchor_win_times_result"
                    android:layout_width="72dp"
                    android:layout_height="30dp"
                    layout="@layout/live_pk_win_times_view_internal"/>
                <p151v.VImage
                    android:id="@+id/anchor_result_icon"
                    android:layout_width="72dp"
                    android:layout_height="30dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="start|bottom"
                android:orientation="horizontal"
                android:id="@+id/anchor_contributions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="10dp"/>
            <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.AutoVisibleEffectPlayer
                android:layout_gravity="center"
                android:id="@+id/svg_current_anchor"
                android:layout_width="150dp"
                android:layout_height="150dp"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp">
                <include
                    android:id="@+id/first_gift_container"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    layout="@layout/live_layout_first_gift"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/anchor_bounty"
                    android:paddingLeft="8dp"
                    android:paddingTop="1dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="1dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <p151v.VDraweeView
                android:layout_gravity="bottom|right"
                android:id="@+id/anchor_rank_image"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="end"
                android:layout_gravity="end|bottom"
                android:orientation="vertical"
                android:id="@+id/other_result_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:layout_marginEnd="10dp"
                flatten="true">
                <include
                    android:id="@+id/other_win_times_result"
                    android:layout_width="72dp"
                    android:layout_height="30dp"
                    layout="@layout/live_pk_win_times_view_internal"/>
                <p151v.VImage
                    android:id="@+id/other_result_icon"
                    android:layout_width="72dp"
                    android:layout_height="30dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="end|bottom"
                android:orientation="horizontal"
                android:id="@+id/other_contributions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_marginEnd="10dp"/>
            <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.AutoVisibleEffectPlayer
                android:layout_gravity="center"
                android:id="@+id/svg_other_anchor"
                android:layout_width="150dp"
                android:layout_height="150dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:gravity="center"
                android:layout_gravity="bottom|right"
                android:id="@+id/other_bounty"
                android:paddingLeft="8dp"
                android:paddingTop="1dp"
                android:paddingRight="8dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="48dp"
                android:layout_marginEnd="10dp"/>
            <p151v.VDraweeView
                android:layout_gravity="bottom|left"
                android:id="@+id/other_rank_image"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="10dp"/>
        </FrameLayout>
    </LinearLayout>
    <include
        android:id="@+id/pk_bounty_container_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="46dp"
        android:layout_marginBottom="42dp"
        flatten="true"
        layout="@layout/live_layout_pk_bounty_view"/>
    <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.AutoVisibleEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/svg_middle"
        android:layout_width="255dp"
        android:layout_height="305dp"/>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_pk_again"
        android:background="@drawable/live_bg_ff8817_r10"
        android:visibility="gone"
        android:layout_width="96dp"
        android:layout_height="28dp"
        android:layout_marginBottom="54dp"
        android:text="@string/LIVE_PK_ANOTHER_ROUND"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_60_opacity"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pk_buffer_tv"
        android:background="@drawable/live_bg_ff8817_r10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginBottom="54dp"
        android:maxWidth="152dp"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/pk_buffer_effect"
        android:layout_width="80dp"
        android:layout_height="26dp"
        android:layout_marginBottom="54dp"
        android:scaleType="fitXY"/>
    <p151v.VImage
        android:layout_gravity="end|top"
        android:id="@+id/mute"
        android:background="@drawable/live_selector_pk_mute_icon_bg"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="73dp"
        android:layout_marginEnd="10dp"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.internal.PkViewInternal>
