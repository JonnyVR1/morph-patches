<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/core_growth_new_user_tip_bg"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <p151v.VDraweeView
        android:id="@+id/dr_new_user_bg"
        android:background="@drawable/core_growth_live_icon_bg"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"/>
    <p151v.VDraweeView
        android:id="@+id/dr_new_user_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        app:actualImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#cc000000"
        android:id="@+id/tv_new_user_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:layout_marginEnd="69dp"
        android:layout_toEndOf="@+id/dr_new_user_icon"
        android:layout_alignParentEnd="true"/>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/bt_new_user_pop_submit"
        android:background="@drawable/common_button_btn_orange_medium"
        android:layout_width="53dp"
        android:layout_height="34dp"
        android:text="查看"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</p151v.VRelative>
