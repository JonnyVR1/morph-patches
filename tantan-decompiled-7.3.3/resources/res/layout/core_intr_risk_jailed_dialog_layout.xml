<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp">
        <p151v.VImage
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081637"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="18sp"
            android:textColor="#323232"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="14sp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textColor="#4d000000"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/core_intr_risk_jailed_dialog_btn_cancel_bg"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/BAN_FEATURE_ALERT_CANCEL"
                android:layout_weight="1"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_confirm"
                android:background="@drawable/core_intr_risk_jailed_dialog_btn_cancel_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/BAN_FEATURE_ALERT_VERIFY"
                android:layout_weight="1"
                android:layout_marginStart="9dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/BAN_ALERT_COUNTDOWN"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#fe7e1d"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0天 01:29:23"/>
        </p151v.VLinear>
    </p151v.VLinear>
</p151v.VLinear>
