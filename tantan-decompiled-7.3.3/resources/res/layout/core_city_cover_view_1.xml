<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.views.CityCoverView1 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/city_cover_view_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="dlg.views.CityCoverView1">
    <androidx.viewpager.widget.ViewPager
        android:layout_gravity="center_horizontal"
        android:id="@+id/viewpager"
        android:layout_width="295dp"
        android:layout_height="300dp"
        android:layout_marginTop="22dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <p151v.VPagerCircleIndicator
        android:id="@+id/viewpager_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:centered="true"
        app:fillColor="@color/core_color_50percent_E1D1AC"
        app:pageColor="@color/core_color_10percent_FFFFFF"
        app:radius="4dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/core_color_DBBD7A"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17.4dp"
        android:minHeight="25dp"
        android:maxLines="1"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_40percent_FFFFFF"
        android:gravity="center_horizontal"
        android:id="@+id/sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="44dp"
        android:maxLines="2"
        android:minLines="2"
        android:lineSpacingExtra="1.1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="44dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#212121"
        android:gravity="center"
        android:id="@+id/btn_submit"
        android:background="@drawable/core_city_cover_buttom_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="47dp"
        android:text="我要上封面"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</com.p051p1.mobile.putong.core.p058ui.dlg.views.CityCoverView1>
