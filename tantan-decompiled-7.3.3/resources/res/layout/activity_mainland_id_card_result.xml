<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identity_ocr_result_title"
                android:layout_centerInParent="true"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_result_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/identity_ocr_img_comm_close_black"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/identity_ocr_main_margin_left"
                android:layout_alignParentStart="true"/>
            <View
                android:id="@+id/identity_ocr_result_close"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_result_tips"
            android:background="@color/identity_ocr_frame_color_ededed"
            android:paddingLeft="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_result_tips_icon"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/identity_ocr_result_id_top_tips_icon"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                android:textColor="#000000"
                android:id="@+id/tv_top_message_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/identity_ocr_result_top_tips"
                android:layout_toRightOf="@+id/iv_result_tips_icon"
                android:layout_centerVertical="true"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="20dp"
                android:src="@drawable/identity_ocr_img_comm_close_grey"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <View
                android:id="@+id/view_result_tips"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <ScrollView
            android:id="@+id/identity_ocr_id_card_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/identity_ocr_main_margin_left"
                        android:layout_marginBottom="@dimen/identity_ocr_main_margin_left">
                        <com.idv.identity.ocr.widget.CardPreviewWidget
                            android:id="@+id/card_preview_widget"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/identity_ocr_id_card_front_default"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_marginLeft="25dp"
                            android:layout_marginRight="25dp"
                            android:scaleType="fitXY"
                            android:layout_weight="1"/>
                        <View
                            android:id="@+id/view_top_break_line"
                            android:background="#f7f7f7"
                            android:layout_width="match_parent"
                            android:layout_height="15dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_mainland_name"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_mainland_name"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_mainland_hint_name"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_mainland_sex"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_mainland_sex"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_mainland_hint_sex"
                                android:maxLength="10"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_mainland_ethnicity"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_mainland_ethnicity"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_mainland_hint_ethnicity"
                                android:maxLength="10"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_mainland_birthDate"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_birthDate"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#000000"
                                    android:textColorHint="#999999"
                                    android:gravity="center_vertical"
                                    android:id="@+id/identity_ocr_result_id_mainland_birthDate"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:paddingStart="16dp"
                                    android:layout_marginEnd="16dp"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/dtf_right_arrow"
                                    android:layout_marginEnd="16dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_mainland_idNumber"
                                android:layout_centerVertical="true"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_mainland_idNumber"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_mainland_hint_idNumber"
                                android:maxLength="18"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_mainland_address"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_mainland_address"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_mainland_hint_address"
                                android:maxLength="80"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/identity_ocr_result_id_is_permanent_ll"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:id="@+id/identity_ocr_result_id_is_permanent_tv"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_isPermanent"/>
                            <CheckBox
                                android:id="@+id/identity_check_yes"
                                android:background="@drawable/identity_check_box"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:checked="true"
                                android:button="@null"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#333333"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="@string/identity_ocr_result_id_permanent_yes"/>
                            <CheckBox
                                android:id="@+id/identity_check_none"
                                android:background="@drawable/identity_check_box"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginLeft="40dp"
                                android:checked="false"
                                android:button="@null"
                                android:paddingVertical="5dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#333333"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="@string/identity_ocr_result_id_permanent_no"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/identity_ocr_result_id_origin_of_issue_ll"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:id="@+id/identity_ocr_result_id_origin_of_issue_tv"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_originOfIssue"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_origin_of_issue"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_hong_kong_go_hint_originOfIssue"
                                android:maxLength="50"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_issueDate_out"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_issueDate"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_issueDate"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#000000"
                                    android:textColorHint="#999999"
                                    android:gravity="center_vertical"
                                    android:id="@+id/txt_issueDate"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:paddingStart="16dp"
                                    android:layout_marginEnd="16dp"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/dtf_right_arrow"
                                    android:layout_marginEnd="16dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_expiryDate_out"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="@dimen/identity_ocr_result_page_margin"
                            android:layout_marginRight="@dimen/identity_ocr_result_page_margin">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_expiryDate"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_expiryDate"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#000000"
                                    android:textColorHint="#999999"
                                    android:gravity="center_vertical"
                                    android:id="@+id/txt_expiryDate"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:paddingStart="16dp"
                                    android:layout_marginEnd="16dp"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/dtf_right_arrow"
                                    android:layout_marginEnd="16dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
        <Button
            android:textSize="@dimen/identity_ocr_result_page_font_size_big"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/identity_ocr_result_ok"
            android:background="@drawable/identity_result_round_shape"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:text="@string/identity_ocr_result_btn_txt"/>
    </LinearLayout>
    <com.idv.identity.platform.IdentityAlertOverlay
        android:id="@+id/identity_alert_overlay"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.idv.identity.ocr.widget.IdentityAlertSymbol
        android:id="@+id/identity_alert_symbol"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.idv.identity.platform.iOSLoadingView
        android:layout_gravity="center"
        android:id="@+id/iosLoadingView"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</FrameLayout>
