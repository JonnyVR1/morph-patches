<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/match_root"
    android:background="#dcdcdc"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.newanim.MatchCongratsViewModel">
    <com.p051p1.mobile.putong.core.p058ui.match.view.MatchPicViewPager
        android:id="@+id/pic_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <com.p051p1.mobile.putong.core.p058ui.match.view.MatchTransView
        android:id="@+id/trans_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.p051p1.mobile.putong.core.p058ui.match.view.MatchBlackShadowView
        android:layout_gravity="bottom"
        android:id="@+id/black_shadow_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"/>
    <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:alpha="0"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/match_input_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="18dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/match_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:layout_marginBottom="26dp"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="2"/>
        <View
            android:id="@+id/top_anim_view"
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <com.p051p1.mobile.putong.core.p058ui.match.view.MatchEdgeTransFrameLayout
            android:id="@+id/about_me_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:layout_marginBottom="21dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.match.view.MatchMaxHeightScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never">
                <p151v.VText
                    android:textSize="16dp"
                    android:textColor="#ffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/about_me_text"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"/>
            </com.p051p1.mobile.putong.core.p058ui.match.view.MatchMaxHeightScrollView>
        </com.p051p1.mobile.putong.core.p058ui.match.view.MatchEdgeTransFrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/core_match_input_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp">
            <EditText
                android:textColorHint="#bfbfbf"
                android:layout_gravity="center_vertical"
                android:id="@+id/input_text"
                android:background="#00000000"
                android:paddingLeft="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="62dp"
                android:hint="@string/MATCH_BOX_DEFAULT_TEXT"
                android:singleLine="true"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#d74d37"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/send_btn"
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:text="@string/MATCH_TEXT_SEND"/>
        </FrameLayout>
        <TextView
            android:textSize="17dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="42dp"
            android:text="@string/MATCH_BUTTON_KEEP_PLAYING"/>
        <FrameLayout
            android:id="@+id/bottom_anim_layout"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/congrats_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="130dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/congrats_text_default"
            android:layout_width="626dp"
            android:layout_height="88dp"
            android:alpha="0"
            android:scaleX="1"
            android:scaleY="1"
            app:srcCompat="0x7f080950"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/congrats_text_red"
            android:layout_width="299dp"
            android:layout_height="44dp"
            android:alpha="0"
            android:scaleX="16"
            android:scaleY="16"
            app:srcCompat="0x7f080951"/>
    </FrameLayout>
</FrameLayout>
