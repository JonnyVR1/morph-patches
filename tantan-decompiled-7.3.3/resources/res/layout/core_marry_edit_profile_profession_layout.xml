<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.profession.MarryEditProfileProfessionViewModel"
    innerClass="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VRelative
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/first_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                aigestudio:typeface="medium"
                style="@style/marry_loop_edit_title_text"/>
            <p151v.VFrame
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="80dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/first_title"
                flatten="true">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/core_profile_curtain_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                        android:layout_gravity="center"
                        android:id="@+id/main_wheel_center_left"
                        android:background="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        aigestudio:wheel_atmospheric="true"
                        aigestudio:wheel_curtain="true"
                        aigestudio:wheel_curtain_color="#f7f7f7"
                        aigestudio:wheel_curtain_height="56dp"
                        aigestudio:wheel_curved="true"
                        aigestudio:wheel_cyclic="false"
                        aigestudio:wheel_item_text_color="@color/core_color_26000000"
                        aigestudio:wheel_selected_item_text_color="@color/common_black_01"/>
                    <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                        android:layout_gravity="center"
                        android:id="@+id/main_wheel_center_right"
                        android:background="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="20dp"
                        android:layout_weight="1"
                        aigestudio:wheel_atmospheric="true"
                        aigestudio:wheel_curtain="true"
                        aigestudio:wheel_curtain_color="#f7f7f7"
                        aigestudio:wheel_curtain_height="56dp"
                        aigestudio:wheel_curved="true"
                        aigestudio:wheel_cyclic="false"
                        aigestudio:wheel_item_text_color="@color/core_color_26000000"
                        aigestudio:wheel_item_text_size="18sp"
                        aigestudio:wheel_selected_item_text_color="@color/common_black_01"/>
                </p151v.VLinear>
            </p151v.VFrame>
        </p151v.VRelative>
    </ScrollView>
</FrameLayout>
