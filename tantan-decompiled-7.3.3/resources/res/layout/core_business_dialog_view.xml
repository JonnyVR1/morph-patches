<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.views.BusinessAnimView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="dlg.views.BusinessAnimView">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/rl_content"
        android:background="@drawable/common_view_popupup_bg"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/v_top_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="20dp"/>
        <FrameLayout
            android:id="@+id/fl_svga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            flatten="true">
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/tantan_svga_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/tantan_svga_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/center_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VFrame
                android:layout_gravity="center"
                android:id="@+id/center_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <p151v.VFrame
            android:id="@+id/custom_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/fl_svga"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/custom_view"
            android:layout_centerHorizontal="true">
            <p151v.VImage
                android:id="@+id/iv_boost_finished"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="50dp"
                android:layout_marginStart="55dp"/>
        </RelativeLayout>
        <p151v.VImage
            android:id="@+id/icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="18sp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:maxLines="2"
            android:layout_below="@+id/custom_view"
            android:layout_centerHorizontal="true"
            style="@style/core_vip_normal_title_style"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="32dp"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="4dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_04"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/subtitle"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/tv_content_time"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/tv_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/v_checkbox"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/tv_content_time">
            <p151v.VCheckBox
                android:id="@+id/check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:checked="true"
                android:button="@null"
                style="@style/common_checkbox"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_04"
                android:layout_gravity="center_vertical"
                android:id="@+id/reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/positive"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:visibility="visible"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/v_checkbox"
            android:fontFamily="sans-serif"
            app:typeface="medium"
            style="@style/common_button_large_01"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#33000000"
            android:gravity="center"
            android:id="@+id/negative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/positive"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/bubble_target"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="50dp"/>
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_boost_progress_bubble"
        android:visibility="gone"
        android:layout_width="107dp"
        android:layout_height="45dp"
        android:layout_marginBottom="-25dp"
        android:layout_above="@+id/rl_content"
        android:layout_centerHorizontal="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08056e"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/bubble_content"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="7dp"
            android:singleLine="true"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.dlg.views.BusinessAnimView>
