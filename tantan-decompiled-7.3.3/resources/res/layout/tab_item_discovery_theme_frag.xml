<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.discovery.SuggestTabItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="discovery.SuggestTabItem">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <p151v.VFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="start"
                android:id="@+id/back_header_img"
                android:layout_width="32dp"
                android:layout_height="32dp"
                style="@style/fresco_topic_avatar_white_border"/>
            <p151v.VDraweeView
                android:layout_gravity="start"
                android:id="@+id/header_img"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"
                style="@style/fresco_topic_avatar_white_border"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#999"
            android:id="@+id/theme_title"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"/>
    </p151v.VLinear>
    <View
        android:id="@+id/indicator"
        android:background="#c44f31"
        android:layout_width="18dp"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.core.newui.discovery.SuggestTabItem>
