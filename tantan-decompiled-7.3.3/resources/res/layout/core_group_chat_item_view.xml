<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <p151v.VDraweeView
        android:id="@+id/group_chat_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="10dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/join"
        android:background="@drawable/core_group_chat_join_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="加入"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/group_chat_icon"
        app:layout_constraintRight_toLeftOf="@+id/join"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:singleLine="true"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/tag_contain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/common_grey_03"
                android:gravity="center"
                android:id="@+id/age"
                android:background="@drawable/core_group_chat_tag_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginRight="4dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/common_grey_03"
                android:gravity="center"
                android:id="@+id/tags"
                android:background="@drawable/core_group_chat_tag_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="14dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
