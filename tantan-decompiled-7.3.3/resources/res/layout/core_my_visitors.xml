<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="visitor.myvisitors.MyVisitorsFragViewModel">
    <p151v.VPullDownRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VPullUpRecyclerView
            android:id="@+id/list"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            useId="true"/>
    </p151v.VPullDownRefreshLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/privilege"
        android:background="@drawable/core_visitor_my_visitor_button_bg_gradient"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="164dp"
        flatten="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/get_privilege"
            android:background="@drawable/core_visitor_my_visitor_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="31dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#ffdea2"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开通黑金会员"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#99ffdea2"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一键隐藏我的访问足迹"
                android:lineSpacingExtra="1sp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
