<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:id="@+id/cover_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        style="@style/core_fresco_base"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cover_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDivider
            android:id="@+id/top_divider"
            android:visibility="visible"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            app:dashGap="4dp"
            app:dashWidth="5dp"
            app:dashed="true"
            app:dividerColor="#8fffffff"
            app:dividerOrientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/cover_bottom"
            app:layout_constraintLeft_toRightOf="@+id/cover_top_Left"
            app:layout_constraintRight_toLeftOf="@+id/cover_top_right"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDivider
            android:id="@+id/bottom_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:dashGap="4dp"
            app:dashWidth="5dp"
            app:dashed="true"
            app:dividerColor="#8fffffff"
            app:dividerOrientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/cover_bottom"/>
        <FrameLayout
            android:id="@+id/cover_top_Left"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/top_divider"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/left_hand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:text="上一张照片"
                android:drawableTop="0x7f08148e"
                android:drawablePadding="8dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/cover_top_right"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/top_divider"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/right_hand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:text="下一张照片"
                android:drawableTop="0x7f081490"
                android:drawablePadding="8dp"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/cover_bottom"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <View
                android:id="@+id/cover_hide_bottom"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/bottom_hand"
                    android:background="0x7f081490"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginRight="27dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/back_title"
                    android:paddingLeft="90dp"
                    android:paddingRight="90dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/PROFILE_CLOSE"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
