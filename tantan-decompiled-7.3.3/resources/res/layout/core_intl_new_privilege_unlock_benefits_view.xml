<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.intlPrivilege.content.item.IntlPrivilegeUnlockBenefitsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="18dp"
    android:layout_marginHorizontal="16dp"
    flatten="true"
    holder="vip.intlPrivilege.content.item.IntlPrivilegeUnlockBenefitsView">
    <FrameLayout
        android:id="@+id/unlock_benefits_card"
        android:background="@drawable/core_intl_privilege_unlock_benefits_card_bg"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_gravity="center_horizontal"
                android:id="@+id/unlock_benefits_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/unlock_benefits_card_privileges_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/unlock_benefits_card_get_premium_button"
                android:background="@drawable/core_intl_privilege_combo_buy"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/INTL_SUBSCRIPTION_SEE_TO_PREMIUM_POP_BTN"
                android:paddingVertical="14dp"/>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.intlPrivilege.content.item.IntlPrivilegeUnlockBenefitsView>
