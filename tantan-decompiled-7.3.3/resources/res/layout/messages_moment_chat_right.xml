<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMomentChat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true">
    <RelativeLayout
        android:id="@+id/moment_prompt"
        android:background="@drawable/bg_message_moment_prompt"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/moment_image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/moment_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:actualImageScaleType="centerCrop"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/moment_play"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/core_message_video_play_icon"/>
        </FrameLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/moment_content_container"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/moment_image_container">
            <TextView
                android:textSize="12sp"
                android:textColor="#4a4a4a"
                android:ellipsize="end"
                android:id="@+id/moment_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#bfbfbf"
                android:ellipsize="end"
                android:id="@+id/moment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lines="1"
                android:layout_below="@+id/moment_desc"/>
        </RelativeLayout>
        <View
            android:id="@+id/line"
            android:background="#e9e9e9"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="7.5dp"
            android:layout_below="@+id/moment_image_container"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#bfbfbf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:text="内容来自朋友圈"
            android:layout_below="@+id/line"/>
    </RelativeLayout>
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemText
        android:textColorLink="#9fe6ff"
        android:autoLink="web"
        android:id="@+id/text"
        android:paddingLeft="14dp"
        android:paddingTop="9.5dp"
        android:paddingRight="18dp"
        android:paddingBottom="9.5dp"
        android:layout_marginTop="10dp"
        android:text="阿斯顿发顺丰是"
        android:lineSpacingExtra="2dp"
        app:enableEmojis="true"
        app:largeEmojis="true"
        style="@style/messages_item_right"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMomentChat>
