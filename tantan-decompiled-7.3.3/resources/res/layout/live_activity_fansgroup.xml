<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.fansgroup.FansGroupView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="page.fansgroup"
    holder="FansGroupView">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/title_bar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/LIVE_FANSGROUP_TITLE"/>
    <include
        android:id="@+id/fansgroup_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="21dp"
        android:layout_below="@+id/title_bar"
        layout="@layout/live_fansgroup_list_content"/>
    <p151v.VRelative
        android:id="@+id/chat_group_ring_rl"
        android:background="0x7f082279"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="146dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="14dp"
        android:layout_alignParentEnd="true"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08227a"
            android:layout_centerInParent="true"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/chat_group_ring_red_point"
            android:background="@drawable/live_shape_chat_group_ring_circle_red"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-10dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="10dp"
            android:minWidth="17dp"
            android:minHeight="17dp"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:typeface="medium"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.live.external.page.fansgroup.FansGroupView>
