<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="account.EmailVerifyDeviceIntroViewModel">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#de000000"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="28dp"
        android:text="@string/VERIFY_EMAIL_CONFIRM_TITLE"/>
    <p151v.VImage
        android:textSize="16sp"
        android:textColor="#de000000"
        android:layout_gravity="center_horizontal"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="0x7f0829f5"
        android:scaleType="center"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#8a000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="29dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="56dp"
        android:text="@string/VERIFY_EMAIL_CONFIRM_NUMBER_TEXT"/>
    <p151v.VButton_FakeShadow
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/go"
        android:background="@drawable/account_get_code"
        android:layout_width="252dp"
        android:layout_height="48dp"
        android:text="@string/VERIFY_DEVICE_SEND_CONFIRMATION_CODE"
        style="@style/v_button"/>
</LinearLayout>
