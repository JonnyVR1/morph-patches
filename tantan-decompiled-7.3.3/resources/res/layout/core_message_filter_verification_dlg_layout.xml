<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/filter_close_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="40dp">
        <p151v.VImage
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:srcCompat="@drawable/core_msg_filter_verification_dlg_ic"/>
        <p151v.VText
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/filter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="只和认证用户聊天"/>
        <p151v.VText
            android:textSize="16dp"
            android:textColor="#33000000"
            android:id="@+id/pic_verification_pending_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="53dp"
            android:text="认证审核中，审核成功后可设置只和已认证的用户聊天"/>
        <FrameLayout
            android:id="@+id/open_filte_layout"
            android:background="@drawable/core_msg_filter_verification_content_bg"
            android:paddingLeft="16dp"
            android:paddingTop="20dp"
            android:paddingRight="16dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="53dp"
            android:minHeight="80dp"
            flatten="true">
            <p151v.VText
                android:textSize="14dp"
                android:textColor="#66000000"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="62dp"
                android:text="通过照片认证才可聊天，仅接收已验证用户发来的消息"/>
            <p151v.VFrame
                android:layout_gravity="center"
                android:id="@+id/open_filter_model_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VSwitchButton
                    android:id="@+id/open_filter_model_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VFrame>
        </FrameLayout>
    </p151v.VLinear>
</FrameLayout>
