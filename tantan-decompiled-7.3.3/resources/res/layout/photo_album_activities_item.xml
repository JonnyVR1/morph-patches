<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumActivitiesView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.PhotoAlbumActivitiesView">
    <FrameLayout
        android:id="@+id/comment_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <View
            android:id="@+id/unreadPoint"
            android:background="@drawable/feed_interaction_red_point"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="33dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/content_container"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="12dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/profile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="12dp"
                style="@style/feed_fresco_profile_small"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/common_grey_08"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="150dp"
                        android:singleLine="true"/>
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:id="@+id/pic_verification"
                        android:background="0x7f081e18"
                        android:visibility="gone"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="4dp"/>
                    <p151v.VText
                        android:textSize="9sp"
                        android:textColor="#33000000"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/relation_lable_tv"
                        android:background="@drawable/feed_activities_relation_lable_bg"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginLeft="4dp"
                        android:text="好友"/>
                </LinearLayout>
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/feed_e6000000"
                    android:ellipsize="end"
                    android:id="@+id/comment_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:maxLines="3"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/feed_e6000000"
                    android:ellipsize="end"
                    android:id="@+id/moment_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:maxLines="1"
                    android:drawableLeft="@drawable/feed_activity_moment_small_ic"
                    android:drawablePadding="6dp"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
                <include
                    android:id="@+id/user_header_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    layout="@layout/feed_header_enter_view"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/activity_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="16dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="#4c000000"
                        android:gravity="center"
                        android:id="@+id/comment_back"
                        android:background="@drawable/feed_interaction_comment_bg"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="回复"
                        app:enableEmojis="true"
                        app:largeEmojis="true"/>
                    <ImageView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:gravity="center"
                        android:id="@+id/comment_like"
                        android:background="@drawable/feed_interaction_comment_bg"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="10dp"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/common_grey_03"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:enableEmojis="true"
                        app:largeEmojis="true"/>
                </LinearLayout>
                <p151v.VRelative
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-7dp"
                    android:layout_marginBottom="2dp">
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="#4c000000"
                        android:gravity="center"
                        android:id="@+id/reply_tv"
                        android:background="@drawable/feed_activities_reply_bg"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginRight="6dp"
                        android:text="回复评论"/>
                    <p151v.VImage
                        android:id="@+id/anim_iv"
                        android:background="0x7f081d4f"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="center"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="#4c000000"
                        android:gravity="center"
                        android:id="@+id/reply_flower"
                        android:background="@drawable/feed_activities_reply_bg"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="送小红花"
                        android:drawablePadding="2dp"
                        android:layout_toRightOf="@+id/reply_tv"
                        android:drawableStart="0x7f081eb1"/>
                </p151v.VRelative>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/moment_frame"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <p151v.VButton
                android:textSize="14sp"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/attention"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:singleLine="true"/>
        </LinearLayout>
        <p151v.VDraweeView
            android:id="@+id/profile_frame"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="11dp"
            style="@style/feed_fresco_profile_frame"/>
    </FrameLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumActivitiesView>
