<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/image1"
                android:background="@drawable/core_default_head_bg"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:roundAsCircle="true"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/online_dot1"
                android:background="@drawable/core_bg_chat_online_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/image2"
                android:background="@drawable/core_default_head_bg"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:roundAsCircle="true"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/online_dot2"
                android:background="@drawable/core_bg_chat_online_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/image3"
                android:background="@drawable/core_default_head_bg"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:roundAsCircle="true"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/online_dot3"
                android:background="@drawable/core_bg_chat_online_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#cc000000"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="和其他配对好友聊聊吧"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/positive"
        android:background="@drawable/common_normal_orange_btn_bg"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:text="打个招呼"
        android:lines="1"/>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="#33000000"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/negative"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        android:text="暂不打招呼"/>
</p151v.VLinear>
