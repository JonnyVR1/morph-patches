<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="44dp"
    android:layout_height="44dp">
    <p151v.VDraweeView
        android:id="@+id/user_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
        fresco:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/user_count"
        android:background="@drawable/live_bg_black_oval_a30"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"/>
</p151v.VFrame>
