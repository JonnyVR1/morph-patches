<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilegeNewUi.content.item.IntlPrivilegeShowcaseWrapper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.privilegeNewUi.content.item.IntlPrivilegeShowcaseWrapper">
    <RelativeLayout
        android:id="@+id/promotion_rl"
        android:background="@drawable/core_intl_renew_contract_grey_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        flatten="true">
        <p151v.VMarqueeText
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/core_msg_cell_left_text_color"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/promotion_content"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="28dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <p151v.VIcon
            android:id="@+id/promotion_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080be3"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.privilegeNewUi.content.item.IntlPrivilegeShowcaseWrapper>
