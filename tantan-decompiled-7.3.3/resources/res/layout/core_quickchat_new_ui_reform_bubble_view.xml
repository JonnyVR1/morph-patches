<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.NewQuickChatAudioReformBubbleView">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f0815f2"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="10dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#66ffffff"
        android:id="@+id/mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:text="闪聊匹配"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:src="0x7f0815e6"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/profile_user"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="32dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:src="0x7f0815e7"
        app:layout_constraintRight_toRightOf="@+id/profile_user"
        app:layout_constraintTop_toTopOf="@+id/profile_user"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_40percent_FFFFFF"
        android:ellipsize="end"
        android:id="@+id/name_age_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_user"/>
    <ImageView
        android:id="@+id/quick_chat_pop_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="4dp"
        android:src="0x7f0815f3"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/quick_chat_pop_info"
        app:layout_constraintTop_toBottomOf="@+id/name_age_info"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/quick_chat_pop_info"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="3dp"
        app:layout_constraintLeft_toRightOf="@+id/quick_chat_pop_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_age_info"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/core_color_80percent_000000"
        android:gravity="center"
        android:id="@+id/gotochat"
        android:background="@drawable/core_bg_white_r10"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:text="和她聊聊"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:typeface="regular"/>
</merge>
