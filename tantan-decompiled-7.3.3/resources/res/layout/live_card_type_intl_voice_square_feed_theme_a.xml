<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.VoiceSquareThemeAFeedCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <p151v.VImage
        android:id="@+id/item_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/frame_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_intl_square_frame_view"/>
    <View
        android:id="@+id/outer_ring"
        android:background="@drawable/live_shape_voice_topic_black_theme_a_outer_ring_bg"
        android:layout_width="83dp"
        android:layout_height="83dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="7dp"
        app:layout_constraintLeft_toLeftOf="@+id/item_background"
        app:layout_constraintTop_toTopOf="@+id/item_background"/>
    <View
        android:id="@+id/middle_ring"
        android:background="@drawable/live_shape_voice_topic_black_theme_a_middle_ring_bg"
        android:layout_width="71dp"
        android:layout_height="71dp"
        app:layout_constraintBottom_toBottomOf="@+id/outer_ring"
        app:layout_constraintLeft_toLeftOf="@+id/outer_ring"
        app:layout_constraintRight_toRightOf="@+id/outer_ring"
        app:layout_constraintTop_toTopOf="@+id/outer_ring"/>
    <View
        android:id="@+id/inner_ring"
        android:background="@drawable/live_shape_voice_topic_black_theme_a_inner_ring_bg"
        android:layout_width="59dp"
        android:layout_height="59dp"
        app:layout_constraintBottom_toBottomOf="@+id/outer_ring"
        app:layout_constraintLeft_toLeftOf="@+id/outer_ring"
        app:layout_constraintRight_toRightOf="@+id/outer_ring"
        app:layout_constraintTop_toTopOf="@+id/outer_ring"/>
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:failureImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/inner_ring"
        app:layout_constraintLeft_toLeftOf="@+id/inner_ring"
        app:layout_constraintRight_toRightOf="@+id/inner_ring"
        app:layout_constraintTop_toTopOf="@+id/inner_ring"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImageScaleType="centerCrop"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/member_container"
        app:layout_constraintLeft_toLeftOf="@+id/item_background"
        app:layout_constraintRight_toRightOf="@+id/item_background"/>
    <FrameLayout
        android:id="@+id/tag_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintLeft_toRightOf="@+id/outer_ring"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        flatten="true">
        <p151v.VLinear
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/tag"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_90_opacity"
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"/>
        </p151v.VLinear>
    </FrameLayout>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/member_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_background"
        app:layout_constraintLeft_toLeftOf="@+id/item_background"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.view.LiveAvatarNumberItemView
            android:id="@+id/container_avatar_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/avatar_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundAsCircle="true"/>
        </com.p051p1.mobile.putong.live.base.view.LiveAvatarNumberItemView>
        <com.p051p1.mobile.putong.live.base.view.LiveAvatarNumberItemView
            android:id="@+id/container_avatar_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="18dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/avatar_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundAsCircle="true"/>
        </com.p051p1.mobile.putong.live.base.view.LiveAvatarNumberItemView>
        <com.p051p1.mobile.putong.live.base.view.LiveAvatarNumberItemView
            android:id="@+id/container_avatar_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="36dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/avatar_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundAsCircle="true"/>
        </com.p051p1.mobile.putong.live.base.view.LiveAvatarNumberItemView>
    </FrameLayout>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/member_container"
        app:layout_constraintRight_toRightOf="@+id/member_container"
        app:layout_constraintTop_toTopOf="@+id/member_container"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white_70_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/member_count"
        android:background="@drawable/live_shape_voice_topic_black_theme_a_count_bg"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:singleLine="true"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintLeft_toRightOf="@+id/space"
        app:layout_constraintTop_toTopOf="@+id/space"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/member_count"
        app:layout_constraintLeft_toRightOf="@+id/member_count"
        app:layout_constraintRight_toRightOf="@+id/item_background"
        app:layout_constraintTop_toTopOf="@+id/member_count"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.VoiceSquareThemeAFeedCardView>
