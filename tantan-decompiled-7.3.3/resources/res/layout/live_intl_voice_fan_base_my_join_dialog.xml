<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="580dp">
        <p151v.VDraweeView
            android:id="@+id/background"
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/back"
            android:background="0x7f082382"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_VOICE_FUN_CLUB_MY_FAN_CLUBS"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/exit"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:text="@string/LIVE_VOICE_FUN_CLUB_LEAVE_THE_GROUP"/>
        <View
            android:background="@drawable/live_bg_white_r1_a03"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="64dp"
            android:layout_marginRight="20dp"/>
        <p151v.VRecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="83dp"/>
        <include
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="83dp"
            layout="@layout/live_empty_view"/>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/manager_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="46dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/manager_left"
                android:background="@drawable/live_bg_47474b_r16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="8dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_CANCEL"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/manager_right"
                android:background="@drawable/live_selector_intl_voice_fan_base_manager_button_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="20dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_LEAVE_THE_FAN_CLUB"
                android:layout_weight="1"/>
        </p151v.VLinear>
    </FrameLayout>
</p151v.VLinear>
