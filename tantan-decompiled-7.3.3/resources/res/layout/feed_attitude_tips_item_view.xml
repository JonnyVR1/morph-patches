<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui">
    <p151v.VText
        android:textSize="25.5dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/attitude_emoji"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:enableApngEmojis="true"
        app:enableEmojis="true"
        app:largeEmojis="true"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/feed_33000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
</p151v.VLinear>
