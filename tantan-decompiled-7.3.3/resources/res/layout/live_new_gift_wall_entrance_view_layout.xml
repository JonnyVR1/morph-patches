<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.view.LiveNewGiftWallEntranceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r10_a03"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    folder="increment"
    holder="gift.giftwallnew.view.LiveNewGiftWallEntranceView">
    <com.p051p1.mobile.putong.live.livingroom.view.AutoRefreshTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/arrow"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="0x7f082307"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/icon3"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f0822c5"/>
    <ImageView
        android:id="@+id/five_star_icon3"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="13dp"
        android:src="0x7f0822e7"
        app:layout_constraintBottom_toBottomOf="@+id/icon3"
        app:layout_constraintEnd_toEndOf="@+id/icon3"
        app:layout_constraintStart_toStartOf="@+id/icon3"/>
    <p151v.VDraweeView
        android:id="@+id/icon2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon3"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f0822c5"/>
    <ImageView
        android:id="@+id/five_star_icon2"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="13dp"
        android:src="0x7f0822e7"
        app:layout_constraintBottom_toBottomOf="@+id/icon2"
        app:layout_constraintEnd_toEndOf="@+id/icon2"
        app:layout_constraintStart_toStartOf="@+id/icon2"/>
    <p151v.VDraweeView
        android:id="@+id/icon1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon2"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f0822c5"/>
    <ImageView
        android:id="@+id/five_star_icon1"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="13dp"
        android:src="0x7f0822e7"
        app:layout_constraintBottom_toBottomOf="@+id/icon1"
        app:layout_constraintEnd_toEndOf="@+id/icon1"
        app:layout_constraintStart_toStartOf="@+id/icon1"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.view.LiveNewGiftWallEntranceView>
