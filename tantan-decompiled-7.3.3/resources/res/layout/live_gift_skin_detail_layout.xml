<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="gift.skin.detail.LiveGiftSkinDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@color/live_19191e"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="10:13"/>
    <ImageView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="274dp"
        android:src="0x7f0822de"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="@+id/bg"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toTopOf="@+id/sub_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f0822f2"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VDraweeView
        android:id="@+id/gift_tray_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/skin_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"/>
    <p151v.VDraweeView
        android:id="@+id/skin_img"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/skin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="皮肤介绍"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skin_img"/>
    <ImageView
        android:layout_width="10dp"
        android:layout_height="17dp"
        android:src="0x7f0822df"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/skin_title"
        app:layout_constraintEnd_toStartOf="@+id/skin_title"
        app:layout_constraintTop_toTopOf="@+id/skin_title"/>
    <ImageView
        android:layout_width="10dp"
        android:layout_height="17dp"
        android:src="0x7f0822e0"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/skin_title"
        app:layout_constraintStart_toEndOf="@+id/skin_title"
        app:layout_constraintTop_toTopOf="@+id/skin_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/skin_describe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skin_title"/>
    <TextView
        android:enabled="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/bt"
        android:background="@drawable/live_selector_multi_pk_start"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
