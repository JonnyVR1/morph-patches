<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemUnderstandShare xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="?attr/message_bubble_bg_left"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemUnderstandShare">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080d17"
            android:scaleType="fitXY"
            android:maxWidth="271dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/right_icon"
            android:layout_width="98dp"
            android:layout_height="68dp"
            android:layout_marginRight="12dp"
            android:src="0x7f080d18"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintRight_toRightOf="@+id/bg"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintLeft_toLeftOf="@+id/bg"
            app:layout_constraintRight_toLeftOf="@+id/right_icon"
            app:layout_constraintTop_toTopOf="@+id/bg">
            <p151v.VImage
                android:id="@+id/text_decorate"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="0x7f080d19"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="8dp"
                android:maxLines="2"
                android:lineSpacingMultiplier="0.9"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        android:lines="1"
        android:lineSpacingMultiplier="1"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/core_message_comment_video_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="12dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemUnderstandShare>
