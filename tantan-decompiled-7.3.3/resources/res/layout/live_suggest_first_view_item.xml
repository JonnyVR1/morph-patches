<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/live_square_item_base_margin"
    android:layout_marginRight="@dimen/live_square_item_base_margin"
    android:layout_marginBottom="8dp"
    flatten="true"
    folder="common.roomsuggest.model"
    holder="LiveRoomSuggestFirstModel">
    <p151v.VDraweeView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="start"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#80ffffff"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VImage
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="0x7f08234b"/>
        </p151v.VLinear>
        <View
            android:background="@drawable/live_bg_white_r2_a05"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <p151v.VFrame
            android:id="@+id/layout1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/item1_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/item1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="16dp"/>
                <p151v.VText
                    android:textSize="8sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/item1_tag"
                    android:background="@drawable/live_bg_white_r5_a30"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/LIVE_BORADCASTE_ING"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>
            </p151v.VLinear>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/layout2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/item2_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/item2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="16dp"/>
                <p151v.VText
                    android:textSize="8sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/item2_tag"
                    android:background="@drawable/live_bg_white_r5_a30"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/LIVE_BORADCASTE_ING"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>
            </p151v.VLinear>
        </p151v.VFrame>
    </p151v.VLinear>
</p151v.VFrame>
