<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.task.CommonTaskItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="24dp"
    flatten="true"
    folder="newui"
    holder="profile.newmine.newprofile.task.CommonTaskItemView">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginRight="28dp"
        android:layout_marginHorizontal="28dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="18sp"
        android:textColor="@color/common_exp_black_01"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="28dp"
        android:layout_marginHorizontal="28dp"/>
    <p151v.VText
        android:textColor="@color/common_exp_black_03"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="28dp"
        android:layout_marginHorizontal="28dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sub_avatar_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="28dp"
        android:layout_marginHorizontal="28dp"/>
    <FrameLayout
        android:id="@+id/button_frame"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.task.CommonTaskItemView>
