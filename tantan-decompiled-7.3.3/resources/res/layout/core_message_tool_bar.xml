<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationLeftToolBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.ConversationLeftToolBar">
    <FrameLayout
        android:id="@+id/message_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="9dp"
        flatten="true">
        <p151v.VText
            android:textSize="21sp"
            android:textColor="#cc000000"
            android:gravity="center_vertical"
            android:id="@+id/message_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/CONVERSATION_LIST_TITLE_MESSAGES"/>
        <p151v.VText
            android:layout_gravity="right"
            android:id="@+id/message_red_dot"
            android:background="@drawable/core_conversation_op_red_dot"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="-6dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/new_match_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VText
            android:textSize="21sp"
            android:textColor="#979797"
            android:gravity="center"
            android:id="@+id/new_match_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="新配对"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/new_match_red_dot"
            android:background="@drawable/core_conversation_num_red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-10dp"
            android:minWidth="24dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/whisper_layout"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="6dp"
        flatten="true">
        <p151v.VText
            android:textSize="21sp"
            android:textColor="#979797"
            android:gravity="center_vertical"
            android:id="@+id/whisper_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/INTL_WHISPER_TAB_TITLE"/>
        <p151v.VText
            android:layout_gravity="right"
            android:id="@+id/whisper_red_dot"
            android:background="@drawable/core_conversation_op_red_dot"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="-6dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.messages.ConversationLeftToolBar>
