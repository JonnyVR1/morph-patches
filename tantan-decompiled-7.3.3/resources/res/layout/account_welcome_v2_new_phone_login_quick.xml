<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/phone_login"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="welcome.WelcomeV2ActViewModel">
    <p151v.VText
        android:textColor="@color/white"
        android:id="@+id/phone_quick"
        android:background="@drawable/common_button_btn_orange_medium_v2"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:checked="false"
        android:text="189****2976 一键登录"
        android:layout_marginHorizontal="20dp"
        style="@style/common_button_large"/>
    <FrameLayout
        android:id="@+id/phone_change_opt"
        android:background="@drawable/account_change_login_btn_bg_v2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <p151v.VText
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/phone_change_opt_text"
            android:layout_width="wrap_content"
            android:text="@string/WECHAT_BIND_MOBILE_ACTION_SWITCH_ACCOUNT_NEW"
            android:drawablePadding="8dp"
            android:drawableStart="0x7f08018e"
            style="@style/common_button_large"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/common_000000_20"
        android:gravity="center_horizontal"
        android:id="@+id/phone_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="70dp"
        android:text="未注册手机号验证后将自动注册"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/other_login_wechat"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:src="0x7f08023d"
            android:scaleType="fitCenter"
            android:layout_marginHorizontal="26dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/other_login_qq"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:src="0x7f08023c"
            android:scaleType="fitCenter"
            android:layout_marginHorizontal="26dp"/>
    </p151v.VLinear>
</p151v.VLinear>
