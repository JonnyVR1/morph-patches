<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:background="@drawable/core_question_card_default_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roundedCornerRadius="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:src="0x7f08159d"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="22dp"
            android:textColor="@color/common_black_80"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="不想头像认证的原因是?"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/question_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="28dp"
            android:layout_marginHorizontal="32dp"/>
    </LinearLayout>
</FrameLayout>
