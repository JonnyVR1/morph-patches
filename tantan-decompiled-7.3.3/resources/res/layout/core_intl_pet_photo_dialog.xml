<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/core_intl_pet_photo_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rTopLeftRadius="20dp"
    app:rTopRightRadius="20dp"
    flatten="true"
    holder="petphoto.PetPhotoDlg">
    <p151v.VDraweeView
        android:id="@+id/img_bg_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundView
        android:id="@+id/top"
        android:background="@color/white"
        android:layout_width="45dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"
        app:rRadius="18dp"/>
    <p151v.VFrame
        android:id="@+id/image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-23dp"
        android:layout_marginEnd="-55dp"
        android:layout_alignParentEnd="true">
        <p151v.VDraweeView
            android:id="@+id/img_bg"
            android:layout_width="330dp"
            android:layout_height="382dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/transparent"
            app:failureImageScaleType="centerInside"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"
            style="@style/core_fresco_base"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/img"
            android:layout_width="148dp"
            android:layout_height="222dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/transparent"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"
            style="@style/core_fresco_base"/>
        <p151v.VImage
            android:id="@+id/star_img"
            android:background="0x7f080b77"
            android:layout_width="41dp"
            android:layout_height="49dp"
            android:layout_marginTop="240dp"
            android:layout_marginStart="68dp"/>
    </p151v.VFrame>
    <p151v.VDraweeView
        android:id="@+id/peg_tag"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="26dp"
        android:layout_alignParentEnd="true"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="150dp"
        android:layout_height="382dp"
        android:layout_marginTop="-23dp"
        android:layout_marginStart="19dp">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#574390"
            android:id="@+id/title"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_ACTIVITIES_PETS_SHOW_TITLE"/>
        <p151v.VImage
            android:id="@+id/desc_img"
            android:background="0x7f080b73"
            android:layout_width="116dp"
            android:layout_height="83dp"
            android:layout_marginTop="5dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/title"/>
    </p151v.VLinear>
    <TextView
        android:textSize="16sp"
        android:textColor="#574390"
        android:gravity="center"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-28dp"
        android:layout_below="@+id/image_container"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/bt"
        android:background="@drawable/core_intl_pet_photo_bt_bg"
        android:layout_width="276dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="50dp"
        android:text="@string/INTL_ACTIVITIES_PETS_SHOW_CLICK"
        android:layout_below="@+id/desc"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundRelativeLayout>
