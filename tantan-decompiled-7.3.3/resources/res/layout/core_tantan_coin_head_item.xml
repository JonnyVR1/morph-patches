<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.wallet.TanTanCoinHeadItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="wallet.TanTanCoinHeadItem">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#cc000000"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_ANCHOR_RANK"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/icon"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f081a0a"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:id="@+id/right_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/arrow"
        android:layout_alignParentEnd="true"/>
    <p151v.VOnlineIndicator
        android:id="@+id/indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_alignTop="@+id/icon"
        android:layout_alignRight="@+id/icon"
        app:indicatorStyle="style01"/>
</com.p051p1.mobile.putong.core.p058ui.wallet.TanTanCoinHeadItem>
