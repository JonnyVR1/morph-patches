<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/fans_follow_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fans_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        flatten="true">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:gravity="center"
            android:id="@+id/fans_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:gravity="center"
            android:id="@+id/fans_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:text="@string/FANS"
            android:layout_marginStart="4dp"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/core_mine_tab_bg_oval"
            android:layout_width="2dp"
            android:layout_height="2dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/follow_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        flatten="true">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:gravity="center"
            android:id="@+id/follow_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="regular"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:gravity="center"
            android:id="@+id/follow_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/TITLE_FOLLOWING"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
