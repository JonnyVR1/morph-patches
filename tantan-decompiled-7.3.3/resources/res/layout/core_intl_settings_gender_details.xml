<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.intlGender.IntlGenderDetailsViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="@color/common_000000_80"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/SETTINGS_YOUR_GENDER"
        app:typeface="bold"/>
    <p151v.VLinear
        android:id="@+id/gender"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VFrame
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/male"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            flatten="true">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/male_gender"
                android:background="@drawable/core_setting_gender_bg_intl"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp">
                <p151v.VIcon
                    android:id="@+id/ic_male_gender_icon"
                    android:background="@drawable/core_intl_setting_male_gender_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/core_intl_setting_gender_text_color"
                    android:id="@+id/tv_male_gender_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_MAN_BTN"
                    android:textAllCaps="true"/>
            </p151v.VLinear>
            <p151v.VImage
                android:layout_gravity="top|right"
                android:id="@+id/male_ic"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080c46"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/female"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            flatten="true">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/female_gender"
                android:background="@drawable/core_setting_gender_bg_intl"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp">
                <p151v.VIcon
                    android:id="@+id/ic_female_gender_icon"
                    android:background="@drawable/core_intl_setting_female_gender_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/core_intl_setting_gender_text_color"
                    android:id="@+id/tv_female_gender_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_WOMAN_BTN"
                    android:textAllCaps="true"/>
            </p151v.VLinear>
            <p151v.VImage
                android:layout_gravity="top|right"
                android:id="@+id/female_ic"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080c46"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/nonbinary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            flatten="true">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/nonbinary_gender"
                android:background="@drawable/core_setting_gender_bg_intl"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp">
                <p151v.VIcon
                    android:id="@+id/ic_nonbinary_gender_icon"
                    android:background="@drawable/core_intl_setting_nonbinary_gender_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/core_intl_setting_gender_text_color"
                    android:id="@+id/tv_nonbinary_gender_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_NONBINARY_BTN"
                    android:textAllCaps="true"/>
            </p151v.VLinear>
            <p151v.VImage
                android:layout_gravity="top|right"
                android:id="@+id/nonbinary_ic"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080c46"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_more_gender_entrance"
        android:background="@drawable/common_card_radius_10_f9f9f9_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:layout_marginHorizontal="20dp">
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_30"
            android:ellipsize="end"
            android:id="@+id/tv_more_gender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_ADD_DETAILS_BTN"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_more_gender_add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="bold"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_30"
            android:id="@+id/tv_more_gender_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_ADD_DETAILS_ADD_BTN"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ic_more_gender"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="bold"/>
        <p151v.VIcon
            android:id="@+id/ic_more_gender"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f080aca"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VButton
        android:enabled="true"
        android:id="@+id/save_"
        android:background="@drawable/common_primary_ripple"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:text="@string/ACTION_SAVE"
        style="@style/common_button_large_01"/>
</p151v.VLinear>
