<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/input_root"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.loop.ProfileLoopEditViewModel">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/close_btn"
            android:padding="6dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="0x7f082986"
            android:scaleType="centerInside"/>
        <com.p051p1.mobile.putong.core.p058ui.profile.views.SetInfoProgressView
            android:layout_gravity="center_vertical"
            android:id="@+id/input_progress_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100dp"
            android:layout_marginRight="100dp"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:layout_width="100dp"
            android:layout_height="44dp">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#80000000"
                android:gravity="center_vertical"
                android:id="@+id/skip"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/EDIT_PROFILE_SKIP"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="32dp"
        android:minHeight="60dp"
        layout="@layout/core_profile_featured_edit_progress_layout"/>
    <FrameLayout
        android:id="@+id/input_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</p151v.VLinear>
