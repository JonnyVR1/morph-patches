<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.addressbook.loveradar.FilterPairedUsersView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="10dp"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.loveradar.FilterPairedUsersView">
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="15dp"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:text="筛选配对用户"/>
    <p151v.VFrame
        android:id="@+id/system_filter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginRight="10dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="15dp"
            android:textColor="@color/core_color_80percent_000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="智能推荐"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/system_recommendation_select"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="0x7f08167c"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/customized_filter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginRight="10dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="15dp"
            android:textColor="@color/core_color_80percent_000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手动定制筛选"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/customized_by_oneself_select"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="0x7f08167c"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/customized_by_oneself_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="15dp"
                android:textColor="@color/core_color_80percent_000000"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="对方状态"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/core_color_40percent_000000"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/state_text"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginRight="29dp"
                android:maxLines="1"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080d8c"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/speciality"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="15dp"
                android:textColor="@color/core_color_80percent_000000"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="对方特质"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/core_color_40percent_000000"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/speciality_text"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginRight="29dp"
                android:maxLines="1"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080d8c"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/interest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="15dp"
                android:textColor="@color/core_color_80percent_000000"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="兴趣爱好"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/core_color_40percent_000000"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/interest_text"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginRight="29dp"
                android:maxLines="1"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080d8c"/>
        </p151v.VFrame>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.addressbook.loveradar.FilterPairedUsersView>
