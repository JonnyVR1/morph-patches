<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="virtual.roomInfo.VirtualRoomLevelDetailDialog">
    <View
        android:id="@+id/dialog_bg_first"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <View
        android:id="@+id/dialog_bg_second"
        android:background="@drawable/live_shape_virtual_room_info_dialog_top_bg"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <View
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toTopOf="@+id/scroll_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f0827e1"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintStart_toStartOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="群等级说明"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintLeft_toLeftOf="@+id/top_view"
        app:layout_constraintRight_toRightOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <ImageView
        android:id="@+id/answer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="18dp"
        android:src="0x7f0827ad"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintRight_toRightOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="426dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/level_bg"
                android:background="0x7f082786"
                android:layout_width="match_parent"
                android:layout_height="134dp"
                android:layout_marginTop="18dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/level_bg2"
                android:layout_width="335dp"
                android:layout_height="134dp"
                android:src="0x7f082787"
                app:layout_constraintRight_toRightOf="@+id/level_bg"
                app:layout_constraintTop_toTopOf="@+id/level_bg"/>
            <p151v.VDraweeView
                android:id="@+id/iv_grade"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="36dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18dp"
                android:textColor="#66ffffff"
                android:id="@+id/tv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="当前等级"
                android:layout_marginStart="24dp"
                app:layout_constraintLeft_toLeftOf="@+id/level_bg"
                app:layout_constraintTop_toTopOf="@+id/level_bg"/>
            <com.p051p1.mobile.putong.live.livingroom.voice.intl.heatchallenge.HeatChallengeProgressView
                android:id="@+id/progress"
                android:layout_width="175dp"
                android:layout_height="10dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="@+id/level_bg"
                app:layout_constraintTop_toBottomOf="@+id/tv_level"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#66ffffff"
                android:id="@+id/next_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="10dp"
                app:layout_constraintLeft_toLeftOf="@+id/level_bg"
                app:layout_constraintTop_toBottomOf="@+id/progress"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="#fe7e1d"
                android:id="@+id/upgrade_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/next_level"
                app:layout_constraintLeft_toRightOf="@+id/next_level"
                app:layout_constraintTop_toTopOf="@+id/next_level"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ccffffff"
                android:id="@+id/level_rights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="等级权益"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/level_bg"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="9dp"
                android:layout_marginRight="4dp"
                android:src="0x7f0823b4"
                app:layout_constraintBottom_toBottomOf="@+id/level_rights"
                app:layout_constraintRight_toLeftOf="@+id/level_rights"
                app:layout_constraintTop_toTopOf="@+id/level_rights"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="9dp"
                android:layout_marginLeft="4dp"
                android:src="0x7f0823b5"
                app:layout_constraintBottom_toBottomOf="@+id/level_rights"
                app:layout_constraintLeft_toRightOf="@+id/level_rights"
                app:layout_constraintTop_toTopOf="@+id/level_rights"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/level_rights"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
