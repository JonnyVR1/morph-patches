<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.increment.bullet.VoiceLiveSpecialSystemBulletView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    flatten="true"
    folder="voice.intl.increment"
    holder="bullet.VoiceLiveSpecialSystemBulletView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <p151v.VDraweeView
            android:id="@+id/startIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:actualImageScaleType="fitEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/content_bg"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:minWidth="105dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/arrow"
            app:layout_constraintStart_toStartOf="@+id/content"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="105dp"
            android:singleLine="true"
            android:marqueeRepeatLimit="1"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/startIcon"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VMarqueeText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/marqueeContent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:singleLine="true"
            android:marqueeRepeatLimit="1"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/startIcon"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/arrow"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="centerCrop"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/content_bg"
            app:layout_constraintStart_toEndOf="@+id/content"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="0x7f0824b9"/>
        <p151v.VDraweeView
            android:id="@+id/endIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:actualImageScaleType="fitStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/arrow"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VDraweeView
        android:id="@+id/aniShadow"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.increment.bullet.VoiceLiveSpecialSystemBulletView>
