<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="settings.IntlSettingGenderViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"
        app:title=""/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_80"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/SETTINGS_SHOW_GENDER"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/gender_man"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_80"
            android:id="@+id/show_profile_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_GENDER_MAN"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:id="@+id/gender_man_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_monolayer_1"
            style="@style/common_checkbox"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/gender_woman"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_80"
            android:id="@+id/gender_woman_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_GENDER_WOMAN"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:id="@+id/gender_woman_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_monolayer_1"
            style="@style/common_checkbox"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/gender_nonbinary"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_80"
            android:id="@+id/gender_nonbinary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_GENDER_NONBINARY"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:id="@+id/gender_nonbinary_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_monolayer_1"
            style="@style/common_checkbox"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/gender_everyone"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_80"
            android:id="@+id/gender_everyone_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_LOOKINGFOR_EVERYONE"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:id="@+id/gender_everyone_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_monolayer_1"
            style="@style/common_checkbox"/>
    </p151v.VLinear>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_cis"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        android:paddingVertical="8dp">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/show_cis_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_LOOKINGFOR_SHOW_CIS_ONLY"
            android:layout_marginEnd="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_30"
            android:id="@+id/show_cis_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.5dp"
            android:text="@string/INTL_TTC_CLONE_LOOKINGFOR_SHOW_CIS_ONLY_TEXT"
            android:layout_marginEnd="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/show_cis_title"/>
        <p151v.VSwitch
            android:id="@+id/show_cis_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VButton
        android:enabled="true"
        android:id="@+id/save_"
        android:background="@drawable/common_primary_ripple"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:text="@string/ACTION_SAVE"
        style="@style/common_button_large_01"/>
</p151v.VLinear>
