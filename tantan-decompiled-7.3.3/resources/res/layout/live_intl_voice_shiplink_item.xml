<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.VoiceShipLinkItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="80dp"
    android:layout_height="wrap_content">
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:background="@drawable/live_shape_voice_room_square_ship_link_item_circle"
        android:layout_width="61dp"
        android:layout_height="61dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="47dp"
            android:layout_height="47dp"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:failureImageScaleType="centerCrop"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImageScaleType="centerCrop"
            app:roundAsCircle="true"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxWidth="61dp"
        android:text="Jesus Je…"
        android:singleLine="true"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ship"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="61dp"
        android:text="Jesus Je…"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.VoiceShipLinkItemView>
