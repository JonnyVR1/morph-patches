<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.mediator.PurchaseParallelDialog">
    <com.p051p1.mobile.putong.core.p058ui.alifree.AliFreeClipLinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.purchase.PurchaseTabViewContainer
            android:id="@+id/tabs_container"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"/>
        <com.p051p1.mobile.putong.core.p058ui.view.VPagerInPurchaseDialog
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.p051p1.mobile.putong.core.p058ui.alifree.AliFreeClipLinearLayout>
    <FrameLayout
        android:id="@+id/agreement_container_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <FrameLayout
        android:id="@+id/agreement_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
