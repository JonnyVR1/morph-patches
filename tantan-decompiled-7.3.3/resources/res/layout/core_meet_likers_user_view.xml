<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.meet.likers.items.MeetLikersUserView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/core_vip_normal_card_corner"
    app:cardElevation="0dp"
    folder="newui"
    holder="meet.likers.items.MeetLikersUserView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/verification_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>
    <p151v.VText
        android:id="@+id/tv_newlikes_badges"
        android:background="@drawable/core_see_newlike_badges_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="新喜欢"
        android:drawableStart="0x7f081650"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:id="@+id/tv_superlike_badges"
        android:background="@drawable/core_see_superlike_badges_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:drawableStart="0x7f081651"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:id="@+id/tv_chat_immediately"
        android:background="@drawable/core_see_chat_immediately_badges_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="即刻聊天"
        android:drawableStart="0x7f0806cc"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:textColor="#7b4308"
        android:id="@+id/tv_custom_tag"
        android:background="@drawable/core_meet_likers_user_custom_tag_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:id="@+id/tv_verification_tag"
        android:background="@drawable/core_see_newlike_badges_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="来自邀请认证"
        android:drawableStart="0x7f081656"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        flatten="true">
        <ImageView
            android:id="@+id/action_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:src="0x7f081653"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/action_btn">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_card_user_text_color_b2ffffff"
                android:gravity="center_vertical"
                android:id="@+id/active"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/SEE_LIST_SORT_ACTIVITY"
                android:drawablePadding="3dp"
                android:drawableStart="0x7f080d45"
                android:layout_marginStart="-2dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_card_user_text_color_b2ffffff"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/distance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:maxLines="1"/>
            <p151v.VLinear_FillerMeasure
                android:gravity="center_vertical"
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:minHeight="20dp"
                app:fillerIndex="0"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/age"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:typeface="medium"/>
            </p151v.VLinear_FillerMeasure>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_zodiac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:minHeight="17dp"
                android:maxLines="1"
                app:typeface="medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/dislike"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081204"/>
    <p151v.VImage
        android:layout_gravity="left"
        android:id="@+id/like"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081205"/>
</com.p051p1.mobile.putong.core.newui.meet.likers.items.MeetLikersUserView>
