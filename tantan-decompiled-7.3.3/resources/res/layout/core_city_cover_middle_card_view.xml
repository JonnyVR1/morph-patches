<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.views.CityCoverMiddleCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/city_cover_middle_card_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="dlg.views.CityCoverMiddleCardView">
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="502dp">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/card"
            android:layout_width="300dp"
            android:layout_height="502dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/iamge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/core_color_20percent_000000"
                app:failureImageScaleType="centerCrop"
                app:placeholderImage="@color/core_color_20percent_000000"
                app:placeholderImageScaleType="centerCrop"
                app:roundedCornerRadius="20dp"/>
            <View
                android:background="@drawable/core_bg_20_gradient_1c1c1c_top"
                android:layout_width="match_parent"
                android:layout_height="60dp"/>
            <View
                android:layout_gravity="bottom"
                android:background="@drawable/core_bg_20_gradient_1c1c1c_bottom"
                android:layout_width="match_parent"
                android:layout_height="160dp"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/core_bg_city_cover_text"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp">
                    <p151v.VImage
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="0x7f08070f"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="4dp"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="#dbbd7a"
                        android:id="@+id/city_cover_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="城市封面"
                        android:layout_marginEnd="8dp"/>
                </p151v.VLinear>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/core_color_FFDB89"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:id="@+id/cover_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="12dp"
                    android:singleLine="true"/>
            </p151v.VLinear>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:visibility="visible"
                android:layout_width="89dp"
                android:layout_height="71dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="50dp"
                android:src="0x7f08070d"
                android:scaleType="centerCrop"/>
            <p151v.VLinear
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="27dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <p151v.VText
                    android:textSize="28sp"
                    android:textColor="@color/core_color_90percent_FFFFFF"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="39dp"
                    android:maxWidth="180dp"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_80percent_FFFFFF"
                    android:gravity="center_vertical"
                    android:id="@+id/desc"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginBottom="10dp"/>
                <com.p051p1.mobile.putong.core.newui.main.view.LinearLayoutFixedLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/third_line"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/age_sex_content"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"/>
                    <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                        android:id="@+id/odiamond_tag"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginRight="5dp"/>
                    <com.p051p1.mobile.putong.newui.view.VIPShimmerTag
                        android:id="@+id/vip_shimmer_tag"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginRight="5dp"/>
                    <p151v.VImage
                        android:id="@+id/vip_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:src="@drawable/vip_status_vip"/>
                    <include
                        android:id="@+id/black_diamond_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginRight="5dp"
                        layout="@layout/core_black_diamond_tag_layout_view"/>
                    <p151v.VText
                        android:id="@+id/zodiac"
                        android:visibility="gone"
                        android:layout_marginRight="5dp"
                        style="@style/core_card_small_tag"/>
                </com.p051p1.mobile.putong.core.newui.main.view.LinearLayoutFixedLayout>
            </p151v.VLinear>
            <com.p051p1.mobile.putong.core.view.CardFrameViewCityC
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:isShowLine1="true"
                app:isShowLine2="true"
                app:isShowLine3="true"
                app:line1ItemRounded="18"
                app:line1ItemStrokeWidth="6dp"
                app:line2ItemRounded="20"
                app:line2ItemStrokeWidth="2dp"
                app:line3ItemRounded="17"
                app:line3ItemStrokeWidth="1dp"
                app:line3toOuterEdgeDistance="3dp"/>
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/svga_sweeping_seedings"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </FrameLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.dlg.views.CityCoverMiddleCardView>
