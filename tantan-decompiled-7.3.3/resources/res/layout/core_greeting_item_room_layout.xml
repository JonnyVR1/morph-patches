<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.greet.GreetingItemRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="13sp"
        android:textStyle="normal"
        android:textColor="#4c000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/common_tips_text"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="21dp"
        android:drawablePadding="4dp"
        android:lineSpacingExtra="1dp"
        android:fontFamily="PingFangSC-Regular"/>
    <ViewStub
        android:id="@+id/odmanond_pay_sub"
        android:layout="@layout/core_greeting_odmamond_pay_notify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="10dp"/>
    <ViewStub
        android:id="@+id/core_city_centre_guide_pic_sub"
        android:layout="@layout/core_city_centre_guide_pic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>
</com.p051p1.mobile.putong.core.p058ui.greet.GreetingItemRootLayout>
