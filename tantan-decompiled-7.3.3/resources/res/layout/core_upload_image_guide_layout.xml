<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/core_bg_drop_down_totop"
    android:layout_width="match_parent"
    android:layout_height="520dp">
    <p151v.VHandleBar
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="22dp"
        android:textColor="@color/common_000000_80"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:text="上传本人出镜的真实照片"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/common_000000_40"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginLeft="27dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="27dp"
        android:text="认识更多真实的人"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/pic_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">
        <include
            android:id="@+id/pic_1"
            android:layout_width="93dp"
            android:layout_height="114dp"
            layout="@layout/core_upload_image_view"/>
        <include
            android:id="@+id/pic_2"
            android:layout_width="93dp"
            android:layout_height="114dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            layout="@layout/core_upload_image_view"/>
        <include
            android:id="@+id/pic_3"
            android:layout_width="93dp"
            android:layout_height="114dp"
            layout="@layout/core_upload_image_view"/>
        <include
            android:id="@+id/pic_single"
            android:visibility="gone"
            android:layout_width="141dp"
            android:layout_height="174dp"
            layout="@layout/core_upload_image_view"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="17dp">
        <View
            android:background="#1e000000"
            android:layout_width="15dp"
            android:layout_height="1px"/>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="#4c000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="以下照片不能通过审核"/>
        <View
            android:background="#1e000000"
            android:layout_width="15dp"
            android:layout_height="1px"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <include
            android:id="@+id/ex_pic_1"
            android:layout_width="78dp"
            android:layout_height="96dp"
            layout="@layout/core_upload_image_view"/>
        <include
            android:id="@+id/ex_pic_2"
            android:layout_width="78dp"
            android:layout_height="96dp"
            android:layout_marginLeft="8dp"
            layout="@layout/core_upload_image_view"/>
        <include
            android:id="@+id/ex_pic_3"
            android:layout_width="78dp"
            android:layout_height="96dp"
            android:layout_marginLeft="8dp"
            layout="@layout/core_upload_image_view"/>
        <include
            android:id="@+id/ex_pic_4"
            android:layout_width="78dp"
            android:layout_height="96dp"
            android:layout_marginLeft="8dp"
            layout="@layout/core_upload_image_view"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/core_bg_10_fe7e1d"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="从相册选择"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="36dp"/>
</p151v.VLinear>
