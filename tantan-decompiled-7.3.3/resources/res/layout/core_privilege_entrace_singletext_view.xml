<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceSingleTextView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_vip_mytab_banner_promotion_vip_bg_new"
    android:layout_width="match_parent"
    android:layout_height="47dp"
    holder="banner.view.PrivilegeEntranceSingleTextView">
    <p151v.VImage
        android:id="@+id/texture"
        android:layout_width="339dp"
        android:layout_height="47dp"
        android:scaleType="fitStart"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="19dp"/>
    <p151v.VImage
        android:id="@+id/go"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="center"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceSingleTextView>
