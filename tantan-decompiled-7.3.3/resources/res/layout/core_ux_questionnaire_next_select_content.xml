<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_questionnaire"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/core_certification_bottom_sheet_button_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:text="选好了"
        android:layout_marginHorizontal="20dp"/>
</p151v.VLinear>
