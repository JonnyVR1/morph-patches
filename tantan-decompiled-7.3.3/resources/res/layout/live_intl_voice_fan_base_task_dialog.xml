<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="580dp">
        <p151v.VDraweeView
            android:layout_gravity="bottom"
            android:id="@+id/background"
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom|right"
            android:id="@+id/faq"
            android:background="0x7f08238d"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="532dp"/>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/top_part"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp">
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:roundAsCircle="true"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="none"
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginLeft="72dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="24dp"
                    android:singleLine="true"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="72dp"
                    android:layout_marginTop="25dp">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/live_white_50_opacity"
                        android:gravity="center"
                        android:id="@+id/member_num_text"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:drawableRight="0x7f082383"
                        android:drawablePadding="2dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/live_white_50_opacity"
                        android:gravity="center"
                        android:id="@+id/rank_text"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginLeft="16dp"
                        android:drawableRight="0x7f082383"
                        android:drawablePadding="2dp"/>
                </p151v.VLinear>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ff58bc"
                    android:gravity="center"
                    android:id="@+id/accompany_text"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_marginLeft="72dp"
                    android:layout_marginTop="48dp"
                    android:text="权益名称"
                    android:drawableLeft="0x7f082381"
                    android:drawablePadding="4dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/mid_part"
                android:layout_width="match_parent"
                android:layout_height="150dp">
                <p151v.VDraweeView
                    android:id="@+id/mid_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="24dp">
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp">
                        <p151v.VDraweeView
                            android:id="@+id/self_avatar"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:roundAsCircle="true"/>
                        <p151v.VLinear
                            android:orientation="horizontal"
                            android:id="@+id/name_and_medal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp">
                            <TextView
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:textColor="#ff58bc"
                                android:gravity="center"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/user_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="4dp"
                                android:maxWidth="150dp"
                                android:maxLines="1"/>
                            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/medal"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"/>
                        </p151v.VLinear>
                    </p151v.VLinear>
                    <FrameLayout
                        android:background="@drawable/live_intl_voice_fan_base_progress_bg"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp">
                        <com.p051p1.mobile.putong.live.livingroom.voice.intl.heatchallenge.HeatChallengeProgressView
                            android:id="@+id/progress"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginRight="2dp"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="9dp"
                        android:textColor="#0e3890"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/exp_text"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="10dp"/>
                </p151v.VLinear>
            </FrameLayout>
            <p151v.VLinear
                android:orientation="vertical"
                android:background="@color/live_19191e"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <p151v.VLinear
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="0x7f082393"
                        android:layout_width="24dp"
                        android:layout_height="8dp"/>
                    <com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.GradientTextView
                        android:textSize="12dp"
                        android:textColor="#ff58bc"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:text="@string/LIVE_VOICE_FUN_CLUB_DAILY_TASKS"
                        app:gradientEndColor="#ff6ee2"
                        app:gradientStartColor="#ffd6f7"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="0x7f082393"
                        android:layout_width="24dp"
                        android:layout_height="8dp"
                        android:rotation="180"/>
                </p151v.VLinear>
                <include
                    android:id="@+id/task_item_1"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="20dp"
                    layout="@layout/live_intl_voice_fan_base_task_item"/>
                <include
                    android:id="@+id/task_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="20dp"
                    layout="@layout/live_intl_voice_fan_base_task_item"/>
                <include
                    android:id="@+id/task_item_3"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="20dp"
                    layout="@layout/live_intl_voice_fan_base_task_item"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </FrameLayout>
</p151v.VLinear>
