<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogContentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.view.GiftDialogContentView">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/title_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/title_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/title_bg_space"
        layout="@layout/live_gift_skin_view"/>
    <p151v.VDraweeView
        android:id="@+id/dialog_bg"
        android:background="@drawable/live_shape_gift_dialog2_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appearance"
        app:placeholderImage="@drawable/live_shape_gift_dialog2_bg"
        app:placeholderImageScaleType="fitXY"/>
    <p151v.VDraweeView
        android:id="@+id/middle_layer_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appearance"/>
    <Space
        android:id="@+id/title_bg_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        app:layout_constraintLeft_toLeftOf="@+id/appearance"
        app:layout_constraintTop_toTopOf="@+id/appearance"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/normalGiftsView"
        flatten="true">
        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <include
            android:id="@+id/user_info_new"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            layout="@layout/live_gift_receive_gift_users_view"/>
        <include
            android:id="@+id/user_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            layout="@layout/live_gift_user_info_view"/>
        <include
            android:id="@+id/user_info_official_show"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            layout="@layout/live_gift_user_info_offical_show"/>
        <include
            android:id="@+id/wealth_level"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            layout="@layout/live_gift_dialog_wealth_level_view"/>
        <include
            android:id="@+id/packet_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            layout="@layout/live_gift_dialog_packet_progress_layout"/>
    </LinearLayout>
    <include
        android:id="@+id/normalGiftsView"
        android:layout_width="match_parent"
        android:layout_height="268dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/live_gift_dialog_gifts_view"/>
    <ViewStub
        android:id="@+id/packetGiftsViewStub"
        android:visibility="invisible"
        android:layout="@layout/live_gift_dialog_gifts_view"
        android:layout_width="match_parent"
        android:layout_height="268dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/live_gift_dialog_bottom_bar"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.operation.GiftDialogShadeLayer
        android:id="@+id/shade_layer"
        android:background="@drawable/live_bg_black_r24_a30"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appearance"/>
    <include
        android:id="@+id/gift_operation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_gift_operation_view"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogContentView>
