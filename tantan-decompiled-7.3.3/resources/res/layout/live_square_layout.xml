<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal"
    holder="live.square.featuredExp.LiveSquareViewModel">
    <com.p051p1.mobile.putong.live.external.view.widgets.NoSaveStateViewPager
        android:id="@+id/v_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/status_skin_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <View
                android:id="@+id/toolbar_skin_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <p151v.navigationbar.VNavigationBar
                android:id="@+id/navigation_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </p151v.VFrame>
        <com.google.android.material.tabs.TabLayout
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tabs"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:fadingEdgeLength="27dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="9dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            app:tabBackground="@null"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="350dp"
            app:tabMinWidth="20dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="3dp"
            app:tabPaddingStart="3dp"
            app:tabTextAppearance="@style/liveTitleLayoutTextAppearance"/>
    </p151v.VLinear>
    <include
        android:id="@+id/teen_mode_control"
        layout="@layout/live_square_teenmode_control"/>
</p151v.VFrame>
