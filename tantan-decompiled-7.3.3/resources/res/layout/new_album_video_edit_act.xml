<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="mediapicker.NewAlbumVideoEditAct">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/new_post_bottom_album_bar_height"/>
    <android.view.TextureView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#383e46"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"/>
    <FrameLayout
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp">
        <p151v.VRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"/>
        <com.p051p1.mobile.putong.feed.newui.mediapicker.VideoCutDrawView
            android:layout_gravity="center_vertical"
            android:id="@+id/cutting"
            android:layout_width="match_parent"
            android:layout_height="66dp"/>
    </FrameLayout>
</p151v.VLinear>
