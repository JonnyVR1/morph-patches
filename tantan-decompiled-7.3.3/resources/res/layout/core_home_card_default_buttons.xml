<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.operation.HomeCardDefaultButtons xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="bottom|center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/buttons"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="16dp"
    android:layout_weight="1"
    flatten="true"
    folder="newui"
    holder="home.card.operation.HomeCardDefaultButtons">
    <p151v.VFrame_FlipContainer
        android:id="@+id/undo_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:mainChildIndex="0"
        app:otherChildIndex="1"
        flatten="true">
        <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
            android:id="@+id/undo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:iconPressStateColor="@color/white"
            app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
            app:maxIconZoomRate="0.8"
            app:normalStateIcon="0x7f08064c"
            app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
            app:pressedStateLayerBackground="@drawable/core_card_undo_button_bg_press"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#ffbc00"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/undo_remaining"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="99+"
            app:typeface="medium"/>
    </p151v.VFrame_FlipContainer>
    <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
        android:id="@+id/dislike"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_weight="1"
        app:cob_iconStyle="small"
        app:iconPressStateColor="@color/white"
        app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
        app:maxIconZoomRate="0.8"
        app:normalStateIcon="0x7f0805ae"
        app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
        app:pressedStateLayerBackground="@drawable/core_card_undo_button_bg_press"/>
    <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
        android:id="@+id/like"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_weight="1"
        app:cob_iconStyle="small"
        app:iconPressStateColor="@color/white"
        app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
        app:maxIconZoomRate="0.8"
        app:normalStateIcon="0x7f0805cb"
        app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
        app:pressedStateLayerBackground="@drawable/core_card_like_button_press"/>
    <FrameLayout
        android:id="@+id/superlike_layout_warp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        flatten="true">
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center"
            android:id="@+id/superlike_combo_svga"
            android:layout_width="150dp"
            android:layout_height="150dp"/>
        <p151v.VFrame_FlipContainer
            android:layout_gravity="center"
            android:id="@+id/superlike_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:mainChildIndex="0"
            app:otherChildIndex="1"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
                android:id="@+id/superlike"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:iconPressStateColor="@color/white"
                app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                app:maxIconZoomRate="0.8"
                app:normalStateIcon="0x7f080616"
                app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
                app:pressedStateLayerBackground="@drawable/core_card_superlike_button_press"/>
            <p151v.VText
                android:textSize="20sp"
                android:textColor="#2bccff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/superlike_remaining"
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="99+"
                app:typeface="medium"/>
        </p151v.VFrame_FlipContainer>
    </FrameLayout>
    <p151v.VFrame
        android:id="@+id/new_biz_layout"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="132dp"
        android:layout_height="48dp"
        android:layout_marginRight="8dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
            android:id="@+id/new_biz_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
            app:maxIconZoomRate="0.8"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.newui.home.card.operation.HomeCardDefaultButtons>
