<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemMomentInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/core_poi_card_round_gray_10"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    flatten="true"
    folder="newui"
    holder="poi.view.FeedPoiCardItemMomentInfoView">
    <RelativeLayout
        android:id="@+id/state_icon_container"
        android:background="@drawable/core_poi_card_round_white_20"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/state_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_toRightOf="@+id/state_icon_container">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_e6000000"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/moment_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="16dp"
                android:src="0x7f08136c"
                android:scaleType="fitXY"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_color_4d000000"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/moment_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemMomentInfoView>
