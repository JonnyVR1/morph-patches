<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.VoiceUserCardMedalAndNameView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="voice"
    holder="usercard.view.VoiceUserCardMedalAndNameView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.p051p1.mobile.putong.live.livingroom.royal.LiveGradientTextView
            android:textSize="18sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="7"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="7"
            android:layout_marginStart="5dp"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/sex"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="5dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_50_opacity"
        android:layout_gravity="center"
        android:id="@+id/fans_distance"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/grade_module"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <HorizontalScrollView
        android:layout_gravity="center"
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/view_group_medals"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="9sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/constellation"
                android:background="@drawable/live_bg_white_r5_a10"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/medal_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"
                app:actualImageScaleType="fitXY"/>
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/vip"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:layout_gravity="center_vertical"
                android:id="@+id/medal_view_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:layout_gravity="center_vertical"
                android:id="@+id/medal_view_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:layout_gravity="center_vertical"
                android:id="@+id/medal_view_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:layout_gravity="center_vertical"
                android:id="@+id/medal_view_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <p151v.VDraweeView
                android:id="@+id/user_level"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"
                app:actualImageScaleType="fitCenter"/>
        </p151v.VLinear>
    </HorizontalScrollView>
</com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.VoiceUserCardMedalAndNameView>
