<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="219dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.ImpressSignalConversationHeadView">
    <p151v.VFrame
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VText
            android:textSize="13.5dp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:text="心动信号"/>
        <p151v.VFrame
            android:id="@+id/avatar_layout"
            android:visibility="visible"
            android:layout_width="112dp"
            android:layout_height="162dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="41dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/profile_user"
                android:layout_width="112dp"
                android:layout_height="162dp"
                android:layout_centerVertical="true"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <View
                android:background="@drawable/core_heartbeat_avatar_cover_min"
                android:layout_width="112dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:alpha="0.3"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="top|left"
                android:id="@+id/green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:text="在线"
                android:shadowColor="@color/shadow"
                android:shadowRadius="2"
                android:drawableLeft="0x7f0815d3"
                android:drawablePadding="4dp"/>
        </p151v.VFrame>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/text_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="140dp"
            android:layout_marginTop="43dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <p151v.VImage
                    android:id="@+id/avatar_icon"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/common_grey_02"
                android:ellipsize="end"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/common_black_01"
                android:ellipsize="end"
                android:id="@+id/say_hi"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lines="2"
                android:lineHeight="20dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/image_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp">
                <p151v.VDraweeView
                    android:id="@+id/image1"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:roundedCornerRadius="5dp"/>
                <p151v.VDraweeView
                    android:id="@+id/image2"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    app:roundedCornerRadius="5dp"/>
                <p151v.VDraweeView
                    android:id="@+id/image3"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    app:roundedCornerRadius="5dp"/>
            </p151v.VLinear>
        </LinearLayout>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svga_view"
            android:layout_width="162dp"
            android:layout_height="162dp"
            android:layout_marginLeft="-9dp"
            android:layout_marginTop="41dp"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/close"
            android:padding="12dp"
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:layout_marginTop="-3dp"
            android:alpha="204"
            app:srcCompat="0x7f0809f2"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tag_layout"
            android:background="@drawable/core_heartbeat_goto_msg_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="140dp"
            android:layout_marginTop="155dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/iv_hi"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="4dp"
                android:src="0x7f0809f3"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/common_light_01"
                android:gravity="center_vertical"
                android:id="@+id/gotochat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="快去和她打个招呼～"
                android:layout_weight="1"
                app:typeface="regular"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga_view_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
</merge>
