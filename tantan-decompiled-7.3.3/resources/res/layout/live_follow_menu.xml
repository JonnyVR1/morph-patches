<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common"
    holder="follow.FollowDialog">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/normal_frame"
        android:background="@drawable/live_bg_19191e_tr24"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="214dp"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/avatar_frame"
            android:background="@drawable/live_shape_room_follow_avatar_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-21dp"
            android:layout_centerHorizontal="true"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/avatar"
                android:layout_width="74dp"
                android:layout_height="74dp"
                fresco:failureImage="@drawable/live_vector_default_avatar_bg"
                fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
                fresco:roundAsCircle="true"/>
        </p151v.VFrame>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/base_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/avatar_frame"
            flatten="true">
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="normal"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="22"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/sex"
                android:background="@drawable/live_shape_follow_dialog_male_sex_icon_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="1dp"
                android:scaleType="center"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="test desc"
            android:maxLines="1"
            android:layout_below="@+id/base_info"
            android:layout_centerHorizontal="true"/>
        <p151v.VRelative
            android:gravity="center"
            android:id="@+id/follow"
            android:background="@drawable/live_bg_ff8817_r14"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/desc">
            <p151v.VText
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="follow"
                android:layout_centerInParent="true"/>
            <p151v.VText
                android:textSize="10dp"
                android:textColor="#80ffffff"
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="follow"
                android:layout_below="@+id/button"
                android:layout_centerInParent="true"/>
        </p151v.VRelative>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/float_frame"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/f_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="14dp"
            android:layout_centerVertical="true"
            fresco:failureImage="@drawable/live_bg_white_oval"
            fresco:placeholderImage="@drawable/live_bg_white_oval"
            fresco:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/f_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="19dp"
            android:layout_marginRight="124dp"
            android:text="test name"
            android:maxLines="1"
            android:layout_toRightOf="@+id/f_avatar"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/f_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="124dp"
            android:layout_marginBottom="19dp"
            android:maxLines="1"
            android:layout_alignLeft="@+id/f_title"
            android:layout_alignParentBottom="true"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/f_follow"
            android:background="@drawable/live_shape_ff3a00_gradient_r15"
            android:layout_width="88dp"
            android:layout_height="30dp"
            android:layout_marginRight="16dp"
            android:text="@string/LIVE_FOLLOW"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</p151v.VLinear>
