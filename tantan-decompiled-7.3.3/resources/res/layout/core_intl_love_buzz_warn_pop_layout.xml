<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzWarnView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    folder="ui"
    holder="lovebuzz.widget.LoveBuzzWarnView">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/core_color_151515"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/pop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:maxWidth="110dp"
        android:text="@string/INTL_BUZZ_WARNING_TITLE"
        android:maxLines="1"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_80000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/pop_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/INTL_BUZZ_WARNING_SUBTITLE"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/pop_confirm"
        android:background="@drawable/core_intl_common_disable_origin_btn_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:text="@string/INTL_BUZZ_WARNING_OK"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzWarnView>
