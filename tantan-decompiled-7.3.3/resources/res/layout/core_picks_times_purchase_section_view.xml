<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.PicksTimesPurchaseSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.showcase.PicksTimesPurchaseSectionView">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="131dp"
        android:layout_marginTop="12dp"
        flatten="true">
        <p151v.VText
            android:textSize="30dp"
            android:textColor="#80000000"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="#ebb958"
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="心动"
            android:singleLine="true"/>
        <p151v.VText_AutoFit
            android:textSize="12dp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/top_price"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:singleLine="true"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:gravity="center"
            android:id="@+id/bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            flatten="true">
            <p151v.VText_AutoFit
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/bottom_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </FrameLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.PicksTimesPurchaseSectionView>
