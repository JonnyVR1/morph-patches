<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemPictureWithPayLeft xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemPictureWithPayLeft">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="?attr/message_bubble_bg_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.AutoVDraweeView
                android:id="@+id/drawee_view"
                android:layout_width="210dp"
                android:layout_height="210dp"/>
            <p151v.AutoVDraweeView
                android:id="@+id/image_2"
                android:visibility="gone"
                android:layout_width="108dp"
                android:layout_height="165dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/other_infos"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="3"
                android:lineSpacingExtra="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <RelativeLayout
                android:id="@+id/pay_method"
                android:paddingLeft="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/pay_method_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="5dp"
                    android:src="0x7f081972"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#80000000"
                    android:gravity="center"
                    android:id="@+id/pay_method_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="支付宝"
                    android:drawablePadding="6dp"
                    android:layout_toRightOf="@+id/pay_method_icon"
                    android:layout_centerVertical="true"
                    app:typeface="medium"/>
                <ImageView
                    android:id="@+id/pay_method_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:src="0x7f080fb3"
                    android:scaleType="center"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/common_orange"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/button"
                android:background="@drawable/core_message_action_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#27000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cancel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="8dp"
                android:lineSpacingExtra="2sp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <p151v.VCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/check"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="8dp"
            android:checked="false"
            style="@style/core_svip_year_checkbox"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#de000000"
            android:id="@+id/agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.25"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemPictureWithPayLeft>
