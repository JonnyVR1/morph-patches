<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="?attr/message_audio_height_left">
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemAudio
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="?attr/message_audio_height_left">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:paddingLeft="?attr/core_msg_layout_padding_left"
                android:layout_width="match_parent"
                android:layout_height="?attr/message_audio_layout_height"
                android:layout_marginTop="?attr/message_audio_layout_top"
                android:layout_marginEnd="?attr/message_audio_layout_left_right">
                <com.p051p1.mobile.putong.core.p058ui.messages.AudioView
                    android:id="@+id/audio_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:bgColor="?attr/message_audio_left_bg_color"
                    app:itemType="left"
                    app:paintColor="?attr/message_audio_left_print_color"
                    app:radius="10dp"/>
                <ImageView
                    android:id="@+id/audio_img"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="?attr/core_msg_left_item_audio_button_img_start"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"/>
                <p151v.VText
                    android:textSize="@dimen/message_text_size"
                    android:textColor="?attr/message_audio_left_text_color"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="14dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <ImageView
                android:background="?attr/message_audio_left_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
    </com.p051p1.mobile.putong.core.p058ui.messages.ItemAudio>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/audio_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginLeft="8dp"
        android:src="@drawable/message_audio_unread_dot"/>
    <p151v.VText
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="#33000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/convert_to_text"
        android:background="@drawable/core_audio_convert_to_text_btn_bg"
        android:paddingLeft="6dp"
        android:paddingTop="1dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:text="@string/CHAT_VOICE_CONVERT_TO_TEXT_INITIAL_BUTTON"/>
</LinearLayout>
