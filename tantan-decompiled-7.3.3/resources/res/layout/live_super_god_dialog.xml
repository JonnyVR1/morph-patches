<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment.supergod"
    holder="SuperGodDialog">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="532dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/content_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga_bg"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="184dp"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/content"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="至尊封神庆"
            android:translationZ="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/more_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f08269a"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/user_icon"
            android:background="0x7f082698"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="@+id/icon_mask"
            app:layout_constraintStart_toStartOf="@+id/icon_mask"
            app:layout_constraintTop_toTopOf="@+id/icon_mask"
            app:roundedCornerRadius="100dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_99ffb388"
            android:gravity="center_horizontal"
            android:id="@+id/sub_title"
            android:background="0x7f08269b"
            android:paddingTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="31dp"
            android:layout_marginTop="83dp"
            android:text="封神指日可待"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/icon_mask"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:id="@+id/icon_mask"
            android:layout_width="88dp"
            android:layout_height="99dp"
            android:src="0x7f082699"
            app:layout_constraintBottom_toTopOf="@+id/tab_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VDraweeView
            android:id="@+id/tab_bg"
            android:layout_width="0dp"
            android:layout_height="329dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tabBackground="@color/transparent"
            app:tabGravity="center"
            app:tabIndicator="@drawable/live_vector_super_god_tab_indicator_icon"
            app:tabIndicatorColor="@color/live_FFBC9D"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="top"
            app:tabIndicatorHeight="6dp"
            app:tabRippleColor="@color/transparent"
            flatten="true"/>
        <View
            android:id="@+id/tab_click_area"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tabLayout"
            app:layout_constraintEnd_toEndOf="@+id/tabLayout"
            app:layout_constraintStart_toStartOf="@+id/tabLayout"
            app:layout_constraintTop_toTopOf="@+id/tabLayout"/>
        <View
            android:background="@drawable/live_shape_bg_gradient_white_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            app:layout_constraintEnd_toEndOf="@+id/tabLayout"
            app:layout_constraintStart_toStartOf="@+id/tabLayout"
            app:layout_constraintTop_toTopOf="@+id/tabLayout"/>
        <p151v.VPager
            android:id="@+id/viewpager"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/tabLayout"
            app:layout_constraintEnd_toEndOf="@+id/tab_bg"
            app:layout_constraintStart_toStartOf="@+id/tab_bg"
            app:layout_constraintTop_toBottomOf="@+id/desc"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/power_title"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_60_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/power_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tab_bg"/>
        <p151v.VImage
            android:layout_width="29.1dp"
            android:layout_height="6.1dp"
            android:src="0x7f08269c"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/power_title"
            app:layout_constraintEnd_toStartOf="@+id/power_title"
            app:layout_constraintTop_toTopOf="@+id/power_title"/>
        <p151v.VImage
            android:layout_width="29.1dp"
            android:layout_height="6.1dp"
            android:src="0x7f08269d"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/power_title"
            app:layout_constraintStart_toEndOf="@+id/power_title"
            app:layout_constraintTop_toTopOf="@+id/power_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear>
