<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="group.GroupCreateCategoryViewModel"
    innerClass="true">
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#222222"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_CHOOSE_TYPE"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#a8a8a8"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="20dp"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="20dp"/>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VFrame
        android:background="@drawable/core_group_create_actionbar_background"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VImage
            android:id="@+id/actionbar_back"
            android:padding="16dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/core_actionbar_back"/>
    </p151v.VFrame>
</p151v.VFrame>
