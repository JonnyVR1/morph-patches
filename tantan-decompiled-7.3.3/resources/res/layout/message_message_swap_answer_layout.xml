<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemSwapAnswerMessage xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="@drawable/core_message_ice_break_state_left"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp"
    android:layout_marginEnd="4dp"
    flatten="true"
    holder="messages.ItemSwapAnswerMessage">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="14dp">
        <p151v.VImage
            android:id="@+id/tip_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f0828aa"/>
        <p151v.VText_NoTopPadding
            android:textSize="14sp"
            android:textColor="#4d000000"
            android:id="@+id/tip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="交换答案"
            android:layout_marginStart="4dp"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="14sp"
            android:textColor="#26000000"
            android:id="@+id/title_swap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="（等待对方交换）"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp">
        <p151v.VImage
            android:id="@+id/ask_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f0828a8"/>
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:id="@+id/question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:layout_marginStart="4dp"
            app:fontWeight="500"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="14dp">
        <p151v.VImage
            android:id="@+id/answer_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f0828a5"/>
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textColor="#66000000"
            android:id="@+id/answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:layout_marginStart="4dp"/>
        <p151v.VImage
            android:id="@+id/hide_answer"
            android:visibility="gone"
            android:layout_width="150dp"
            android:layout_height="21dp"
            android:src="0x7f0828bc"
            android:scaleType="fitXY"
            android:layout_marginStart="4dp"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="15sp"
        android:textColor="#fe7e1d"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/message_message_swap_answer_button_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:text="回答后揭晓"
        android:includeFontPadding="false"
        android:layout_marginStart="14dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemSwapAnswerMessage>
