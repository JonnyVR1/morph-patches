<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="accountnew.loginopt.viewmodel.TtcAccountBindViewModel">
    <p151v.VScroll
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top"
        style="@style/account_account_scroll">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="46dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <p151v.VImage
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="0x7f08200a"/>
            <p151v.VText
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/account_black_01040d"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="30dp"
                android:text="@string/INTL_TTC_CLONE_PHONE_CHECK_IF_TTC_USER_TITLE"
                android:maxLines="1"
                app:autoSizeMaxTextSize="24dp"
                app:autoSizeMinTextSize="10dp"
                app:autoSizeTextType="uniform"
                app:typeface="medium"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/layout_yes_root"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16dp"
                    android:textColor="@color/color_cc000000"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_PHONE_CHECK_IF_TTC_USER_YES_OPTION"
                    android:layout_weight="1"
                    app:typeface="medium"/>
                <p151v.VImage
                    android:id="@+id/iv_yes_select"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/selector_account_select"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/color_4c000000"
                android:gravity="center_vertical"
                android:id="@+id/tv_yes_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/INTL_TTC_CLONE_PHONE_CHECK_IF_TTC_USER_YES_OPTION_TEXT"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/layout_no_root"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16dp"
                    android:textColor="@color/color_cc000000"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_CLONE_PHONE_CHECK_IF_TTC_USER_NO_OPTION"
                    android:layout_weight="1"
                    app:typeface="medium"/>
                <p151v.VImage
                    android:id="@+id/iv_no_select"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/selector_account_select"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/color_4c000000"
                android:gravity="center_vertical"
                android:id="@+id/tv_no_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/INTL_TTC_CLONE_PHONE_CHECK_IF_TTC_USER_NO_OPTION_TEXT"/>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VText
        android:id="@+id/continue_btn"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="46dp"
        android:text="@string/ACTION_CONTINUE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:typeface="medium"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/color_4c000000"
        android:gravity="center_horizontal"
        android:id="@+id/tv_contact"
        android:paddingTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_TTC_CLONE_PHONE_CHECK_IF_TTC_USER_CONTACT_BTN"
        app:layout_constraintBottom_toBottomOf="parent"
        app:typeface="medium"/>
    <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
        android:id="@+id/loading_svga"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/top"
        layout="@layout/account_sign_common_top_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
