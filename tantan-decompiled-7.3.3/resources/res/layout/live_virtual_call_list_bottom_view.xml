<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.LiveVirtualCallListBottomView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:bind_extends="FrameLayout"
    app:binding="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_bg"
        android:background="@drawable/live_shape_voice_call_apply_manager_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:text="@string/LIVE_VOICE_APPLICATION"
            android:fontFamily="PingFangSC-Semibold"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/red_dot"
        android:background="@drawable/live_bg_ff6464_r10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:maxHeight="20dp"
        android:minWidth="20dp"
        android:text="0"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="-3dp"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.LiveVirtualCallListBottomView>
