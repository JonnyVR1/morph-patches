<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/root"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@drawable/core_intl_salvage_dlg_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:id="@+id/top_bg"
            android:layout_width="match_parent"
            android:layout_height="280dp"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:background="0x7f080bc6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#edd6a3"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="30dp"
                android:text="@string/INTL_STAY_SUBSCRIBE_POP_TITLE"
                android:layout_marginHorizontal="30dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99edd6a3"
                android:gravity="center"
                android:id="@+id/tvSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/INTL_STAY_SUBSCRIBE_POP_TEXT"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center_horizontal"
                android:id="@+id/rvLikes"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="32dp"
                android:overScrollMode="never"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/btnContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#cc000000"
                    android:gravity="center"
                    android:id="@+id/btnUnlock"
                    android:background="@drawable/core_intl_salvage_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/INTL_STAY_SUBSCRIBE_POP_BTN_PAY"
                    android:textAllCaps="false"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#66edd6a3"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btnLeave"
                    android:paddingLeft="30dp"
                    android:paddingTop="10dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/INTL_STAY_SUBSCRIBE_POP_BTN_LEAVE"
                    android:textAllCaps="false"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
