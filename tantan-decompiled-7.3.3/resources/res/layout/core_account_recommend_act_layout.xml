<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="account.AccountRecommendActViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_account_recommend_button_layout"
        android:layout_below="@+id/navigation_bar">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="28sp"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:id="@+id/tv_account_title_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:id="@+id/tv_account_title_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="注销账号后以下信息将被清除且无法恢复"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_account_title_heart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:text="心动回忆"
                android:maxLines="1"
                android:drawableLeft="0x7f081891"
                android:drawablePadding="2dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#66000000"
                android:id="@+id/tv_account_title_heart_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_account_title_today_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="今日心动"
                android:maxLines="1"
                android:drawableLeft="0x7f08188e"
                android:drawablePadding="2dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#66000000"
                android:id="@+id/tv_account_title_today_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp">
                <p151v.VRelative
                    android:id="@+id/rl_account_avatar1"
                    android:layout_width="0dp"
                    android:layout_height="216dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp">
                    <p151v.VDraweeView
                        android:id="@+id/tv_account_title_today_image1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerCrop"
                        app:failureImage="@color/white"
                        app:failureImageScaleType="centerInside"
                        app:placeholderImage="@color/white"
                        app:placeholderImageScaleType="centerInside"
                        app:roundBottomLeft="true"
                        app:roundBottomRight="true"
                        app:roundTopLeft="true"
                        app:roundTopRight="true"
                        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
                        style="@style/core_fresco_base"/>
                    <View
                        android:background="@drawable/core_today_heart_break_bg"
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:layout_alignParentBottom="true"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_account_title_today_age1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="32dp"
                        android:maxLines="1"
                        android:layout_alignParentBottom="true"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_account_title_today_name1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="12dp"
                        android:maxLines="1"
                        android:layout_toLeftOf="@+id/tv_account_title_today_chat1"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="8dp"/>
                    <p151v.VImage
                        android:id="@+id/tv_account_title_today_chat1"
                        android:drawingCacheQuality="high"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:src="0x7f081890"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"/>
                </p151v.VRelative>
                <p151v.VRelative
                    android:id="@+id/rl_account_avatar2"
                    android:layout_width="0dp"
                    android:layout_height="216dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1">
                    <p151v.VDraweeView
                        android:id="@+id/tv_account_title_today_image2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerCrop"
                        app:failureImage="@color/white"
                        app:failureImageScaleType="centerInside"
                        app:placeholderImage="@color/white"
                        app:placeholderImageScaleType="centerInside"
                        app:roundBottomLeft="true"
                        app:roundBottomRight="true"
                        app:roundTopLeft="true"
                        app:roundTopRight="true"
                        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
                        style="@style/core_fresco_base"/>
                    <View
                        android:layout_gravity="bottom"
                        android:background="@drawable/core_today_heart_break_bg"
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:layout_alignParentBottom="true"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_account_title_today_age2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="32dp"
                        android:maxLines="1"
                        android:layout_alignParentBottom="true"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_account_title_today_name2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="12dp"
                        android:maxLines="1"
                        android:layout_toLeftOf="@+id/tv_account_title_today_chat2"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="8dp"/>
                    <p151v.VImage
                        android:id="@+id/tv_account_title_today_chat2"
                        android:drawingCacheQuality="high"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:src="0x7f081890"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"/>
                </p151v.VRelative>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_account_recommend_button_layout"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true">
        <p151v.VButton
            android:id="@+id/btn_cancel_log_out"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="46dp"
            android:layout_marginRight="20dp"
            android:text="取消注销"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_submit_log_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="仍要狠心注销"/>
    </p151v.VLinear>
</p151v.VRelative>
