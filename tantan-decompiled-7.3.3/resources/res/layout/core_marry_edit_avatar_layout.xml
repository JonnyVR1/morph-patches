<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VFrame
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCards
            android:id="@+id/reorders"
            android:paddingLeft="0dp"
            android:paddingTop="0dp"
            android:paddingRight="0dp"
            android:paddingBottom="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pic_text"
            app:cardNums="6"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/avatar_tag"
            android:background="@drawable/core_crop_profile_tag_bg"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/EDIT_PROFILE_USER_COVER_TEXT"
            android:layout_alignLeft="@+id/reorders"
            android:layout_alignTop="@+id/reorders"/>
    </p151v.VFrame>
</p151v.VLinear>
