<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    holder="settings.filter.newui.HiddenNearByView">
    <com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.FilterSwitchCell
        android:id="@+id/new_section_hidden_cell"
        app:listcell_subtitle_max_lines="2"
        app:listcell_title="@string/SETTINGS_HIDDEN_MYSELF_DISTANCE"
        style="@style/core_newfilter_cell"/>
    <FrameLayout
        android:id="@+id/new_section_hidden_cell_content"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        flatten="true">
        <p151v.VText
            android:text="@string/CORE_LIKED_USER_ACTION_BAR_DISTANCE"
            style="@style/core_newfilter_subtitle"/>
        <TextView
            android:layout_gravity="end"
            android:id="@+id/new_section_hidden_cell_content_distance"
            style="@style/core_newfilter_value_tip"/>
        <p151v.VSlider
            android:value="0"
            android:id="@+id/new_section_hidden_cell_content_slider"
            android:clipChildren="false"
            android:layout_marginTop="21dp"
            android:valueFrom="0"
            android:valueTo="100"
            style="@style/core_newfilter_slider"/>
    </FrameLayout>
</merge>
