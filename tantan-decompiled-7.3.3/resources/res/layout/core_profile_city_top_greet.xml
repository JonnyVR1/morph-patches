<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.CityTopGreetDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/dialog_view"
        android:background="@drawable/core_greet_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <TextView
            android:enabled="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/post"
            android:background="@drawable/core_post_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="发送招呼"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pic_post"/>
        <p151v.VEditText
            android:textSize="16sp"
            android:textColorHint="#33000000"
            android:id="@+id/edit_text"
            android:background="@drawable/core_kankan_action_send_bg"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:hint="来段真诚的自我介绍..."
            android:maxLines="1"
            android:maxLength="60"
            android:layout_weight="1"
            android:inputType="text"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@+id/text_desc"/>
        <p151v.VFrame
            android:id="@+id/pic_frame"
            android:visibility="gone"
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="40dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_text"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="right"
                android:id="@+id/pic_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="5dp"
                android:src="0x7f080714"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/avatar_frame"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="46dp"
            android:layout_marginStart="38dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:roundAsCircle="true"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/avatar_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f080715"/>
        </p151v.VFrame>
        <p151v.VIcon
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f080716"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/pic_post"
            android:background="@drawable/core_kankan_action_send_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@+id/pic_frame">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="0x7f08071d"
                android:layout_marginStart="12dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#33000000"
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="发送本人照片回复率+100%"
                android:layout_weight="1"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#33000000"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加照片"
                android:drawableEnd="0x7f080713"
                android:layout_marginEnd="8dp"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:id="@+id/text_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="40dp"
            android:text="个人介绍可突出你的才艺或特质，更容易得到对方回复"
            app:layout_constraintTop_toBottomOf="@+id/avatar_frame"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
