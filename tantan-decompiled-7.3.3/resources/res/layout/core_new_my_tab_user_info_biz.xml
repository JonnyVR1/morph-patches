<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/head_biz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="profile.newmine.newprofile.block.BizUserInfoView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/avatar"
                android:layout_width="70dp"
                android:layout_height="88dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/common_light_04"
                app:placeholderImage="@color/common_light_04"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/profile_edit"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f0811d8"/>
            <com.p051p1.mobile.putong.core.newui.view.RoundedRectangleProgressView
                android:id="@+id/rectangle_progress"
                android:visibility="gone"
                android:layout_width="70dp"
                android:layout_height="88dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/nickname_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="13dp"
            android:layout_marginStart="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/avatar_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="34dp">
                <p151v.VText
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_80"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="@string/MENU_VIEW_PROFILE"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    app:typeface="medium"/>
                <p151v.VImage
                    android:id="@+id/avatar_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
                <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                    android:id="@+id/odiamond_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
                <p151v.VImage
                    android:id="@+id/img_vip"
                    android:layout_width="38dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </FrameLayout>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/desc"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toRightOf="@+id/avatar_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nickname_container"/>
        <Space
            android:id="@+id/desc_space"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toRightOf="@+id/avatar_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/desc"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toRightOf="@+id/avatar_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/desc_space">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/change_state_container"
                android:background="@drawable/core_mytab_biz_state_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/change_state_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    app:actualImageResource="0x7f0810ff"/>
                <p151v.VText
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/core_color_66000000"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/change_state_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:typeface="medium"/>
                <p151v.VIcon
                    android:id="@+id/change_state_arrow"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="0x7f0811d9"
                    android:layout_marginStart="-2dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/moment_container"
                android:background="@drawable/core_mytab_biz_state_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="6dp"
                flatten="true">
                <p151v.VText
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/core_color_66000000"
                    android:gravity="center_horizontal"
                    android:id="@+id/moment_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更多状态"
                    android:maxLines="1"
                    app:typeface="medium"/>
                <p151v.VIcon
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="0x7f0811d9"
                    android:layout_marginStart="-2dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
