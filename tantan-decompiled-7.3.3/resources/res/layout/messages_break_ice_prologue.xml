<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.MessageChatPrologueLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_new_messages_prompt"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="4dp"
    android:paddingHorizontal="16dp"
    flatten="true"
    holder="messages.MessageChatPrologueLayout">
    <p151v.VFrame
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="15sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/break_ice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="根据你的资料，为你定制了开场白"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:src="0x7f082896"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:background="@drawable/core_new_messages_prologue_bg"
        android:paddingLeft="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="15sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/break_ice_prologue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:layout_weight="1"
            android:layout_marginVertical="18dp"/>
        <p151v.VImage
            android:id="@+id/send_btn"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:paddingHorizontal="16dp"
            app:srcCompat="0x7f0828ae"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/ll_auto_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">
        <p151v.VCheckBox
            android:background="@drawable/core_prologue_auto_send_checkbox_bg"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:button="@null"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="以后自动发送给所有新配对"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.MessageChatPrologueLayout>
