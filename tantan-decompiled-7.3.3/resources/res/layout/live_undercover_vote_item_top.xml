<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="52dp"
    android:layout_height="94dp">
    <p151v.VRecyclerView
        android:id="@+id/vote_recycle"
        android:background="0x7f0826bc"
        android:paddingTop="9dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="43dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <p151v.VFrame
        android:layout_gravity="top|center_horizontal"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <p151v.VDraweeView
            android:id="@+id/vote_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
            fresco:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#1b4173"
            android:gravity="center"
            android:id="@+id/vote_num"
            android:background="@drawable/live_shape_bg_undercover_num"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <p151v.VImage
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/live_vector_bg_undercover_vote"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#1b4173"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/LIVE_ROOM_UNDERCOVER_VOTE"/>
    </p151v.VFrame>
</p151v.VFrame>
