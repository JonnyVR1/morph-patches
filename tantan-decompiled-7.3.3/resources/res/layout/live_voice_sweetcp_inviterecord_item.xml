<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetCpInviteRecordItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetCpInviteRecordItemView">
    <p151v.VDraweeView
        android:id="@+id/inviteAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/live_black_80_opacity"
        android:ellipsize="end"
        android:id="@+id/inviteName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:maxWidth="170dp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/inviteAvatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/live_black_50_opacity"
        android:id="@+id/inviteTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintStart_toStartOf="@+id/inviteName"
        app:layout_constraintTop_toBottomOf="@+id/inviteName"/>
    <TextView
        android:id="@+id/stateView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/operateLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textColor="#4d000000"
            android:gravity="end|center_vertical"
            android:layout_gravity="center"
            android:id="@+id/refuseBtn"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:minWidth="40dp"
            android:text="@string/LIVE_CALL_REJECT"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/agreeBtn"
            android:background="@drawable/live_bg_ffa90f_r10"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:text="@string/LIVE_AGREE"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetCpInviteRecordItemView>
