<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_bg_new_match_parent"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VFrame
        android:layout_gravity="top"
        android:id="@+id/base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="100dp">
        <View
            android:background="0x7f0812f6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33dp"
            android:layout_marginTop="35dp"
            android:layout_marginRight="33dp"
            flatten="true">
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="normal"
                android:textColor="@color/common_black_01"
                android:layout_gravity="center_horizontal"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="2dp"
                android:text="配对成功，她在等你聊天"
                android:fontFamily="sans-serif-medium"/>
            <p151v.VText_Tags
                android:gravity="center"
                android:id="@+id/tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="40dp"
                android:maxLines="1"/>
            <androidx.cardview.widget.CardView
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/chat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="13dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">
                <View
                    android:background="#fe7e1d"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_chat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="快去聊聊"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/close"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="34dp"
            android:src="0x7f0812ee"/>
    </p151v.VFrame>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="53dp">
        <p151v.VFrame
            android:id="@+id/fra_avatar"
            android:background="@drawable/core_bg_fra_avatar"
            android:padding="4dp"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:layout_marginStart="60dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                app:placeholderImage="0x7f0812e7"
                app:placeholderImageScaleType="fitXY"
                app:roundAsCircle="true"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/fra_avatar_own"
            android:background="@drawable/core_bg_fra_avatar"
            android:padding="4dp"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:layout_marginRight="60dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/avatar_own"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                app:placeholderImage="@color/white"
                app:roundAsCircle="true"/>
        </p151v.VFrame>
    </RelativeLayout>
</FrameLayout>
