<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/data_integrity_warn"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="#07000000"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    flatten="true">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp">
        <com.p051p1.mobile.putong.core.newui.view.RoundedRectangleProgressView
            android:layout_gravity="center_vertical"
            android:id="@+id/progress_bg"
            android:layout_width="28dp"
            android:layout_height="32dp"
            flatten="true"/>
        <com.p051p1.mobile.putong.core.newui.view.RoundedRectangleProgressView
            android:layout_gravity="center_vertical"
            android:id="@+id/progress_anim"
            android:layout_width="28dp"
            android:layout_height="32dp"
            flatten="true"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/data_integrity_img"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f08076d"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/data_integrity_full_img"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f08076c"/>
    </FrameLayout>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="53dp"
        android:layout_marginRight="15dp">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:id="@+id/text_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:typeface="medium"/>
    </p151v.VLinear>
</androidx.cardview.widget.CardView>
