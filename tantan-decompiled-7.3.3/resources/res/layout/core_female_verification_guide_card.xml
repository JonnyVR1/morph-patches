<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.femalevip.FemaleVerificationGuideCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    folder="newui"
    holder="femalevip.FemaleVerificationGuideCardView">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/core_female_vip_verification_card_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/title_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:src="0x7f0805b4"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:textColor="#cc000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="试用结束"
            android:layout_below="@+id/title_icon"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66000000"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="你喜欢了4位头像已认证的用户"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"/>
        <com.p051p1.mobile.putong.core.p058ui.home.view.AutoScaleChildFrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/frame_image_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.p051p1.mobile.putong.core.p058ui.home.view.AutoScaleChildFrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16dp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/subtitle_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="65dp"
            android:text="完成认证或开通SVIP\10向她们发出喜欢\10并可继续使用“只看认证用户”功能"
            android:maxLines="3"
            android:layout_marginHorizontal="32dp"
            app:autoSizeMaxTextSize="16dp"
            app:autoSizeMinTextSize="14dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2a6f94"
            android:gravity="center"
            android:id="@+id/send_btn"
            android:background="@drawable/core_card_button_bg_white_normal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="10dp"
            android:text="去认证"
            android:layout_marginHorizontal="56dp"
            android:lineHeight="22.4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/send_sub_text"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="16dp"
            android:text="开通SVIP"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="56dp"
            android:lineHeight="22.4dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.femalevip.FemaleVerificationGuideCardView>
