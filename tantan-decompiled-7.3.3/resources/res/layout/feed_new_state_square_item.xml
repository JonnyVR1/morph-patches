<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedStateSquareItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="status.display.statuspage.newtab.FeedStateSquareItem">
    <com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedSquareBottomStickoutView
        android:id="@+id/dot_bottom"
        android:layout_width="16dp"
        android:layout_height="9dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="@+id/bubble"
        app:layout_constraintTop_toTopOf="@+id/space_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bubble"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <p151v.VDraweeView
            android:id="@+id/header"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"
            style="@style/fresco_profile_small"/>
        <Space
            android:id="@+id/user_space"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="4dp"
            app:layout_constraintLeft_toRightOf="@+id/header"/>
        <View
            android:id="@+id/emotion_img_bg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/emotion_img"
            app:layout_constraintLeft_toLeftOf="@+id/emotion_img"
            app:layout_constraintRight_toRightOf="@+id/emotion_img"
            app:layout_constraintTop_toTopOf="@+id/emotion_img"/>
        <p151v.VDraweeView
            android:id="@+id/emotion_img"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/header"
            app:layout_constraintRight_toRightOf="@+id/user_space"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/value"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="144dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/time"
            android:paddingBottom="2.5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="3.5dp"
            android:layout_marginRight="12dp"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/value"/>
        <View
            android:id="@+id/bg_online"
            android:background="@color/white"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="1dp"
            app:layout_constraintRight_toRightOf="@+id/header"
            app:layout_constraintTop_toTopOf="@+id/header"/>
        <View
            android:id="@+id/dot"
            android:background="#68de48"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg_online"
            app:layout_constraintLeft_toLeftOf="@+id/bg_online"
            app:layout_constraintRight_toRightOf="@+id/bg_online"
            app:layout_constraintTop_toTopOf="@+id/bg_online"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/space_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/bubble"/>
</com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedStateSquareItem>
