<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="topic.qatopic.FeedQATopicInputJoinView">
    <View
        android:id="@+id/keyboard_layer_view"
        android:background="#4d000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/moment_bar_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close_moment_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:src="0x7f081e8a"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/moment_bar"
            android:background="@color/white"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="144dp">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#212121"
                android:textColorHint="#d0d0d0"
                android:gravity="top|left"
                android:id="@+id/text"
                android:background="@null"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:hint="@string/FEED_TALK_IDEA"
                android:maxLines="4"
                android:maxLength="300"
                android:inputType="textMultiLine"
                android:textCursorDrawable="0x7f082a1a"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/send"
                android:background="@drawable/feed_qa_topic_send_bg"
                android:layout_width="44dp"
                android:layout_height="26dp"
                android:layout_marginTop="9dp"
                android:text="@string/FEED_RELEASE_NEW"
                android:singleLine="true"
                android:textAllCaps="true"
                app:typeface="medium"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
