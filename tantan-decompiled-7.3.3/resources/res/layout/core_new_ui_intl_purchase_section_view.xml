<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUiGPPurchaseSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.showcase.NewUiGPPurchaseSectionView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <p151v.VText
            android:textSize="30sp"
            android:textColor="@color/common_grey_01"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:singleLine="true"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_01"
            android:layout_gravity="bottom"
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="个月"
            android:singleLine="true"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/count"
            app:typeface="regular"/>
        <p151v.VText_AutoFit
            android:textSize="13sp"
            android:textColor="@color/common_grey_01"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/top_price"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="16dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/unit"
            app:typeface="medium"/>
        <View
            android:id="@+id/center_price_bg"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/top_price"/>
        <p151v.VText_AutoFit
            android:textSize="16sp"
            android:textColor="@color/common_grey_02"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_price"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_price"
            app:typeface="medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/label"
        android:paddingTop="1dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:maxWidth="100dp"
        android:minWidth="81dp"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUiGPPurchaseSectionView>
