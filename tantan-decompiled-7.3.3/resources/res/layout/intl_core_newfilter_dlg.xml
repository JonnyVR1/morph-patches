<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_newui_filter_dlg_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="settings.filter.newui.IntlNewFilterDlgViewModel">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="63dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f0820da"
            android:scaleType="centerCrop"
            android:layout_marginStart="16dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_black_02"
            android:layout_gravity="center"
            android:id="@+id/filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_VOICETRICK_INLT_TTC_CLONE_FILTER_EIGHT"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="17sp"
            android:textColor="@color/common_orange"
            android:layout_gravity="center"
            android:id="@+id/save"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CORE_PAYTIPS_MAKE_SURE"
            android:layout_marginEnd="24dp"
            app:typeface="medium"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VScroll
            android:id="@+id/scroll"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            flatten="true">
            <p151v.VLinear
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp">
                <include
                    android:id="@+id/base_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-20dp"
                    android:layout_marginRight="-20dp"
                    layout="@layout/intl_core_newui_filter_basesetting"/>
                <View
                    android:background="#0a000000"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="32dp"/>
                <p151v.VText
                    android:gravity="center"
                    android:id="@+id/advance_title"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/CORE_SVIP_PURCHASE_PRIVILEGE_ADVANCED_FILTER_TITLE"
                    style="@style/core_newfilter_subtitle"/>
                <p151v.VText
                    android:textColor="@color/black"
                    android:layout_marginTop="20dp"
                    android:text="@string/INTL_VOICETRICK_INLT_TTC_CLONE_FILTER_TEN"
                    style="@style/core_newfilter_subtitle"/>
                <FrameLayout
                    android:id="@+id/relationship_tags_layout"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <com.p051p1.mobile.putong.core.p058ui.settings.filter.tags.TagContainerLayout
                        android:id="@+id/relationship_tags"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        app:column="2"
                        app:iscenter="true"
                        app:verSpace="11dp"/>
                </FrameLayout>
                <p151v.VListCell
                    android:id="@+id/show_authenticated_user"
                    app:listcell_title="@string/INTL_PREMIUM_SHOW_VERIFIED_TITLE1"
                    style="@style/core_newfilter_cell"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="34dp"/>
            </p151v.VLinear>
        </p151v.VScroll>
    </p151v.VFrame>
</p151v.VLinear>
