<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.scrap.ScrapInfoDialog">
    <View
        android:id="@+id/blank_space"
        android:background="#00ffffff"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg_view"
        android:background="0x7f0824d1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="10:13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/star_bg_view"
        android:layout_width="0dp"
        android:layout_height="266dp"
        android:layout_marginBottom="27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/scrap_gift_title_view"
        android:background="0x7f082328"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toStartOf="@+id/scrap_right_title_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_view"
        app:layout_goneMarginEnd="4dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/scrap_right_title_view"
        android:background="0x7f08232f"
        android:visibility="visible"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrap_gift_title_view"
        app:layout_constraintTop_toTopOf="@+id/bg_view"
        app:layout_goneMarginStart="4dp"/>
    <View
        android:id="@+id/scrap_help_view"
        android:background="0x7f08268c"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <View
        android:id="@+id/scrap_number_desc_bg"
        android:background="0x7f0824d0"
        android:layout_width="134dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrap_gift_title_view"/>
    <p151v.VText
        android:textSize="12sp"
        android:typeface="sans"
        android:textStyle="normal"
        android:textColor="#d8f3ff"
        android:id="@+id/hold_scrap_number_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/LIVE_SCRAP_OWNED"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toStartOf="@+id/scrap_number_desc_bg"
        app:layout_constraintTop_toTopOf="@+id/scrap_number_desc_bg"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#d8f3ff"
        android:gravity="center_vertical"
        android:id="@+id/scrap_number"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@+id/hold_scrap_number_text"
        app:layout_constraintTop_toTopOf="@+id/scrap_number_desc_bg"/>
    <p151v.VText
        android:textSize="12sp"
        android:typeface="sans"
        android:textStyle="normal"
        android:textColor="#d8f3ff"
        android:id="@+id/scrap_craft_text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/LIVE_SCRAP_COMPOSE"
        app:layout_constraintBottom_toBottomOf="@+id/scrap_number_desc_bg"
        app:layout_constraintStart_toStartOf="@+id/hold_scrap_number_text"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#d8f3ff"
        android:gravity="center_vertical"
        android:id="@+id/scrap_result_number"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/scrap_number_desc_bg"
        app:layout_constraintStart_toEndOf="@+id/scrap_craft_text1"/>
    <View
        android:id="@+id/scrap_target_name_layout_bg"
        android:background="0x7f08232d"
        android:layout_width="196dp"
        android:layout_height="80dp"
        android:layout_marginTop="35dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrap_number_desc_bg"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#77e3ff"
        android:gravity="center_vertical"
        android:id="@+id/target_level"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/scrap_target_name_layout_bg"
        app:layout_constraintEnd_toStartOf="@+id/target_name"
        app:layout_constraintStart_toStartOf="@+id/scrap_target_name_layout_bg"
        app:layout_constraintTop_toTopOf="@+id/scrap_target_name_layout_bg"/>
    <p151v.VText
        android:textSize="16sp"
        android:typeface="sans"
        android:textColor="#dee8ff"
        android:gravity="center_vertical"
        android:id="@+id/target_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/scrap_target_name_layout_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/target_level"
        app:layout_constraintTop_toTopOf="@+id/scrap_target_name_layout_bg"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#c2c7ff"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/target_right_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrap_number_desc_bg"
        app:layout_constraintTop_toBottomOf="@+id/target_name"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.scrap.widget.ScrapTargetShowView
        android:id="@+id/scrap_target_layout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="26dp"
        android:minWidth="247dp"
        android:minHeight="188dp"
        app:layout_constraintBottom_toTopOf="@+id/target_craft_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrap_number_desc_bg"
        app:layout_constraintTop_toBottomOf="@+id/target_right_desc"/>
    <p151v.VRecyclerView
        android:id="@+id/scrap_list_recycler"
        android:layout_width="134dp"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrap_number_desc_bg"/>
    <p151v.VButton
        android:textSize="14.4sp"
        android:textColor="#fffcdd"
        android:gravity="center"
        android:id="@+id/target_craft_button"
        android:background="0x7f0824cd"
        android:layout_width="115dp"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:text="@string/LIVE_SCRAP_CLICK_COMPOSE"
        app:layout_constraintBottom_toTopOf="@+id/guide_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrap_number_desc_bg"/>
    <p151v.VButton
        android:textSize="9.6sp"
        android:textColor="#ddf7ff"
        android:gravity="start|center_vertical"
        android:id="@+id/scrap_event_button"
        android:background="0x7f08232c"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:text="活动标题xxxxxxxxxxxxxxxxxx"
        android:maxLines="2"
        android:shadowColor="#80003584"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="2"
        android:paddingStart="11dp"
        android:paddingEnd="7dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_desc"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="68dp"/>
    <p151v.VText
        android:textSize="11sp"
        android:textStyle="normal"
        android:textColor="#c2c7ff"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/scrap_acquire_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_SCRAP_OBTAIN_NOTICE_NONE"
        android:maxLines="3"
        android:lineSpacingExtra="7sp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrap_number_desc_bg"
        app:layout_constraintTop_toTopOf="@+id/guide_desc"/>
    <View
        android:id="@+id/no_data_view"
        android:background="0x7f0824d3"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="#bfbfbf"
        android:gravity="center_horizontal"
        android:id="@+id/no_data_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/LIVE_FANS_CLUB_NO_DATA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_data_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
