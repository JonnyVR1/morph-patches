<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/white"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.MarryEditProfileSeriesViewModel">
    <FrameLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/left_close_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f080dbf"
            android:layout_marginStart="8dp"/>
        <com.p051p1.mobile.putong.core.p058ui.profile.views.SetInfoProgressView
            android:layout_gravity="center_horizontal"
            android:id="@+id/progress_bar"
            android:layout_width="175dp"
            android:layout_height="6dp"
            android:layout_marginTop="13dp"/>
        <include layout="@layout/core_profile_featured_edit_progress_layout"/>
    </FrameLayout>
    <p151v.VFrame
        android:id="@+id/frag_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/next_button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_layout"/>
    <p151v.VFrame
        android:id="@+id/next_button_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="false">
        <p151v.VButton
            android:layout_gravity="bottom|right"
            android:id="@+id/next_button"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:text="@string/ACTION_NEXT"
            android:layout_marginEnd="20dp"
            android:paddingHorizontal="12dp"
            app:typeface="medium"
            style="@style/common_button_small_01"/>
    </p151v.VFrame>
</androidx.constraintlayout.widget.ConstraintLayout>
