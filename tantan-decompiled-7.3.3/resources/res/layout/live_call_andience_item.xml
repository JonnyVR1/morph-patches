<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/iv_head"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"
        fresco:actualImageScaleType="centerCrop"
        fresco:failureImage="@drawable/live_vector_default_avatar_bg"
        fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
        fresco:roundAsCircle="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginLeft="16dp"
        android:layout_toRightOf="@+id/iv_head"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="6"
            android:singleLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#999999"
                android:id="@+id/tv_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_age"
                android:background="@drawable/live_bg_85b9f2_r2"
                android:paddingLeft="1dp"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="14dp"
                android:drawableLeft="0x7f08246f"
                android:drawablePadding="1dp"
                android:fontFamily="sans-serif-medium"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/tv_zodiac"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="8dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/tv_distance"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_status"
        android:background="@drawable/live_shape_ff3a00_gradient_r6"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_operation"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="28dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_connecting"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f082259"/>
    </FrameLayout>
</RelativeLayout>
