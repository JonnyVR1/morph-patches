<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/contacts_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true">
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:src="0x7f081389"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="32dp"
        android:text="@string/SIGNUP_PERMISSIONS_ADDRESSBOOK_TITLE"
        android:lines="1"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="8dp"
        android:text="@string/SIGNUP_PERMISSIONS_ADDRESSBOOK_CONTENT"
        android:lineSpacingExtra="3dp"/>
    <p151v.VFrame
        android:id="@+id/hide_contacts"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_black_01"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginBottom="0dp"
            android:maxWidth="200dp"
            android:text="@string/HIDE_CONTACTS"
            android:fontFamily="sans-serif-medium"/>
        <p151v.VSwitchButton
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/show_mutual_contacts"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_black_01"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginBottom="0dp"
            android:maxWidth="200dp"
            android:text="@string/SETTINGS_SHOW_MUTUAL_CONTACTS"
            android:fontFamily="sans-serif-medium"/>
        <p151v.VSwitchButton
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"/>
    </p151v.VFrame>
    <p151v.VButton
        android:id="@+id/positive"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/SIGNUP_PERMISSIONS_ADDRESSBOOK_OK"
        style="@style/common_button_large_01"/>
</LinearLayout>
