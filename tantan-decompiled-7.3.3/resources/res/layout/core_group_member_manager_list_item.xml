<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/core_default_head_bg"
        app:placeholderImage="@drawable/core_default_head_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/core_greet_moment_audio_bg"
        android:layout_width="49dp"
        android:layout_height="32dp"
        android:layout_marginRight="16dp"
        android:text="@string/CHAT_GROUP_MEMBER_MANAGE_OPERATE"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/btn"
        android:layout_toEndOf="@+id/avatar"
        app:typeface="medium"/>
</p151v.VRelative>
