<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/identity_ocr_text_color_comm"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_close"
            android:padding="20dp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/identity_ocr_img_comm_close_black"
            android:scaleType="centerCrop"/>
    </RelativeLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/guide_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.idv.identity.platform.widget.IndicatorView
        android:id="@+id/indicatorView"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="32dp"
        app:colorSelected="@color/identity_indicator_selected_color"
        app:colorUnSelected="@color/identity_indicator_unselected_color"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_auth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_48"
        android:layout_marginRight="@dimen/margin_48"
        android:layout_marginBottom="@dimen/margin_10"
        android:layout_marginHorizontal="@dimen/margin_48">
        <CheckBox
            android:id="@+id/checkbox_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/identity_checkbox_color_selector"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/identity_ocr_guide_content_color"
            android:id="@+id/tv_auth_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/identity_auth_title"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/sp_14"
        android:textColor="@color/identity_ocr_text_color_comm"
        android:layout_gravity="bottom"
        android:id="@+id/bt_start_ocr"
        android:background="@color/identity_color_bt_bg"
        android:paddingTop="@dimen/margin_10"
        android:paddingBottom="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_48"
        android:layout_marginRight="@dimen/margin_48"
        android:layout_marginBottom="@dimen/margin_48"
        android:text="@string/identity_guide_start_btn"
        android:layout_marginHorizontal="@dimen/margin_48"
        android:paddingVertical="@dimen/margin_10"/>
</LinearLayout>
