<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.result.OnlineMatchContent xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    holder="result.OnlineMatchContent">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp">
        <p151v.VFrame
            android:id="@+id/content_bg"
            android:background="@drawable/bg_privilege_desc"
            android:layout_width="match_parent"
            android:layout_height="260dp">
            <p151v.VImage
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/ic_online_match"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:src="0x7f08203e"
                android:scaleType="fitEnd"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/description"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="44dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.result.OnlineMatchContent>
