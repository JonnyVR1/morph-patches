<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame_Shadow xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dislike_shadow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:sl_cornerRadius="65dp"
    app:sl_dx="@dimen/core_profile_bottom_dx"
    app:sl_dy="@dimen/core_profile_bottom_dy"
    app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
    app:sl_shadowRadius="8dp"
    flatten="true">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/core_profile_video_quick_chat_bg"
        android:layout_width="132dp"
        android:layout_height="48dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f08150c"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="视频闪聊"
            android:layout_marginStart="6dp"/>
    </p151v.VLinear>
</p151v.VFrame_Shadow>
