<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/icon_bg"
            android:layout_width="132dp"
            android:layout_height="132dp"
            app:buttonColorEnd="#ffbb28"
            app:buttonColorStart="#ffdb3c"
            app:shadowEnable="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/text_medium"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/VIP_PAYMENT_SUCCEED_CONTENT"/>
    <p151v.VButton
        android:textColor="@color/white"
        android:id="@+id/done"
        android:background="@drawable/common_button_btn_orange_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/ACTION_DONE"
        style="@style/v_button"/>
    <p151v.VButton
        android:textColor="@color/common_orange"
        android:id="@+id/view"
        android:background="@drawable/tf_rect_rounded_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/VIP_VIEW_PRIVILEGE"
        style="@style/v_button"/>
</LinearLayout>
