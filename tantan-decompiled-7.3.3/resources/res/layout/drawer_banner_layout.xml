<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.DrawerBannersView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/banner"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="5dp"
    app:cardElevation="0dp"
    holder="banner.DrawerBannersView">
    <p151v.AspectRatioViewPager
        android:layout_gravity="center_horizontal"
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ratio="0"/>
    <p151v.VPagerCircleIndicator
        android:layout_gravity="bottom"
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="4dp"
        app:pageColor="@color/white"
        app:radius="3dp"/>
</com.p051p1.mobile.putong.core.p058ui.banner.DrawerBannersView>
