<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumBottomView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui1_follow"
    android:background="#fffffd"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.feedbottom.PhotoAlbumBottomNewUI1FollowViewHome">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <include
                android:id="@+id/bottom_greet_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                flatten="true"
                layout="@layout/feed_bottom_greet_view"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/extra_top_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/layout_time_distance"
                android:paddingTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="16dp"
                flatten="true">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_03"
                    android:id="@+id/review"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:text="@string/USER_INFO_CHECKING"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_03"
                    android:id="@+id/read_count"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_03"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_03"
                    android:id="@+id/distance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_03"
                    android:ellipsize="end"
                    android:id="@+id/txt_location"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="2dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/common_grey_03"
                    android:id="@+id/moment_from"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:id="@+id/visit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                flatten="true">
                <include
                    android:id="@+id/user_header_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/value"
                    layout="@layout/feed_header_enter_view"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#4d000000"
                    android:id="@+id/user_view_count"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0.75dp"
                    android:layout_marginStart="4dp"/>
                <p151v.VImage
                    android:id="@+id/user_view_count_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0.3dp"
                    android:src="0x7f081f2e"
                    android:layout_marginStart="0dp"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#bfbfbf"
                android:gravity="center"
                android:id="@+id/live_audiences"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:drawablePadding="2dp"/>
            <RelativeLayout
                android:id="@+id/enter_living_room"
                android:paddingLeft="12dp"
                android:paddingTop="13dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btn_enter_living_room"
                    android:background="@drawable/feed_moments_feed_live_bottom_btn_bg"
                    android:paddingLeft="45dp"
                    android:paddingTop="1dp"
                    android:paddingRight="45dp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="进入直播间"/>
                <ImageView
                    android:layout_gravity=""
                    android:id="@+id/living_options"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginRight="8dp"
                    android:src="0x7f082a75"
                    android:scaleType="center"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/like_comment_new_ab"
                android:paddingLeft="12dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                flatten="true">
                <p151v.VRelative
                    android:orientation="horizontal"
                    android:id="@+id/like_count_container_new_ab"
                    android:background="@drawable/feed_ui1_follow_rounded_gray_border"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    flatten="true">
                    <p151v.VFrame
                        android:id="@+id/like_indicator_fl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        flatten="true">
                        <p151v.VImage
                            android:layout_gravity="center_vertical"
                            android:id="@+id/like_indicator_new_ab"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="10dp"
                            android:src="0x7f081de3"
                            android:scaleType="fitCenter"/>
                        <p151v.VDraweeView
                            android:layout_gravity="center"
                            android:id="@+id/like_indicator_attitude"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:actualImageScaleType="centerCrop"/>
                    </p151v.VFrame>
                    <com.p051p1.mobile.putong.feed.newui.view.FeedAutoScrollTextView
                        android:textSize="12sp"
                        android:textColor="@color/feed_like_normal_color"
                        android:gravity="center_vertical"
                        android:id="@+id/like_count_new_ab"
                        android:paddingLeft="6dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/like_indicator_fl"
                        android:layout_centerVertical="true"/>
                    <com.tantan.library.svga.SVGAnimationView
                        android:layout_gravity="center"
                        android:id="@+id/like_svg"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginLeft="10dp"
                        android:scaleType="fitCenter"/>
                </p151v.VRelative>
                <p151v.VLinear
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/comment_count_container_new_ab"
                    android:background="@drawable/feed_ui1_follow_rounded_gray_border"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@+id/like_count_container_new_ab"
                    android:layout_centerVertical="true"
                    flatten="true">
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:id="@+id/comment_icon_new_ab"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginLeft="10dp"
                        android:src="0x7f081de2"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/feed_like_normal_color"
                        android:gravity="center_vertical"
                        android:id="@+id/comment_count_new_ab"
                        android:paddingLeft="6dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/chat_count_container_new_ab"
                    android:visibility="gone"
                    android:layout_width="78dp"
                    android:layout_height="38dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    flatten="true">
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:id="@+id/chat_icon_new_ab"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="0x7f081e9d"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/feed_like_normal_color"
                        android:gravity="center_vertical"
                        android:id="@+id/chat_count_new_ab"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="6dp"
                        android:text="@string/WELCOME_PAGE_TUTORIAL_CHAT_HIGHLIGHT_TEXT"/>
                </p151v.VLinear>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#4c000000"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/enter_live_room"
                    android:background="@drawable/feed_enter_live_room_bg"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/FEED_LIVE_ROOM_ENTRANCE_NEWUI"
                    android:singleLine="true"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#66000000"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/enter_live_room_v2"
                    android:background="@drawable/feed_rect_rounded_moment_topic"
                    android:paddingLeft="8dp"
                    android:paddingRight="12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="20dp"
                    android:text="正在直播"
                    android:singleLine="true"
                    android:drawableStart="0x7f081d54"/>
                <ImageView
                    android:id="@+id/options"
                    android:visibility="invisible"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginRight="16dp"
                    android:src="0x7f081de0"
                    android:scaleType="center"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#bfbfbf"
                    android:id="@+id/visibility"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <include
                android:id="@+id/bottom_comment_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                flatten="true"
                layout="@layout/feed_bottom_comment_view"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#33000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tab_like_new_moment_divide"
                android:background="@drawable/feed_tab_like_new_moment_divide_shape"
                android:visibility="gone"
                android:layout_width="192dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:text="新动态都看完了，向下查看更多"
                android:layout_marginEnd="23dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/moment_intention_layout"
            android:background="@drawable/feed_bg_10_f7f7f7"
            android:paddingLeft="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/container"
            android:layout_centerHorizontal="true"
            android:paddingEnd="10dp"
            flatten="true">
            <p151v.VText
                android:textSize="12dp"
                android:textColor="#33000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/moment_intention_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击查看更多"/>
            <p151v.VDraweeView
                android:id="@+id/moment_intention_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
        </p151v.VLinear>
        <ImageView
            android:id="@+id/options_top"
            android:visibility="invisible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="-6dp"
            android:layout_marginRight="8dp"
            android:src="0x7f082a75"
            android:scaleType="center"
            android:layout_alignParentRight="true"/>
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_below="@+id/container"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumBottomView>
