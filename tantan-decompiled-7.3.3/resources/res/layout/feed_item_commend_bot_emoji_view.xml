<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.commend.FeedItemCommendBotEmojiView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.commend.FeedItemCommendBotEmojiView">
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/bot_emoji_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/feed_commend_bot_emoji_selector"
        android:scaleType="centerCrop"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/bot_gif_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/feed_commend_bot_gif_selector"
        android:scaleType="centerCrop"
        android:layout_marginStart="18dp"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/bot_media_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/feed_commend_media_icon_day_light"
        android:scaleType="centerCrop"
        android:layout_marginStart="18dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.commend.FeedItemCommendBotEmojiView>
