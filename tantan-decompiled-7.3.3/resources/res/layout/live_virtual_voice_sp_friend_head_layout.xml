<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.userCard.p068cp.VirtualVoiceSpFriendHeadView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    app:bind_extends="FrameLayout"
    app:binding="true"
    flatten="true">
    <p151v.VDraweeView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:layout_gravity="left"
        android:id="@+id/title"
        android:layout_width="25dp"
        android:layout_height="match_parent"
        android:text="礼\10物\10墙"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linear_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="32dp">
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/item1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_voice_sp_friend_item_view"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/item2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_voice_sp_friend_item_view"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/item3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_voice_sp_friend_item_view"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <include
            android:id="@+id/item4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_voice_sp_friend_item_view"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/more_bt"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f082846"
        android:layout_marginEnd="8dp"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.userCard.p068cp.VirtualVoiceSpFriendHeadView>
