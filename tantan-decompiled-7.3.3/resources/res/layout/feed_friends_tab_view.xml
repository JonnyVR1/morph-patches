<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <include
        android:layout_gravity="center_vertical"
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        layout="@layout/feed_like_tab_title_view"/>
    <com.p051p1.mobile.putong.feed.newui.photoalbum.redpointview.FeedRedDotView
        android:layout_gravity="end|top"
        android:id="@+id/iv_tab_red"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="11dp"
        app:feedDotDrawableOvalColor="@color/common_red"
        app:feedDotDrawableRingColor="@color/white"
        app:feedDotDrawableRingWidth="2dp"
        app:feedDotDrawableWidth="12dp"/>
    <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
        android:layout_gravity="end|top"
        android:id="@+id/iv_tab_red_svg"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="5dp"
        android:scaleType="center"
        android:layout_marginEnd="9dp"/>
</p151v.VFrame>
