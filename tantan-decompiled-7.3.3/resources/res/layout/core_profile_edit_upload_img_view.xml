<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileLoopEditUploadPhoto xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/upload_img"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="40dp"
    flatten="true"
    holder="profile.views.ProfileLoopEditUploadPhoto">
    <p151v.VDivider
        android:layout_width="match_parent"
        android:layout_height="3dp"
        app:dividerColor="#08000000"
        app:dividerOrientation="horizontal"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#4d000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="上传相关图片："
        app:typeface="medium"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/upload_container"
        android:background="@drawable/core_profile_edit_upload_bg"
        android:visibility="gone"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:layout_marginTop="12dp">
        <p151v.VImage
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081462"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/photo_container"
        android:visibility="gone"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:layout_marginTop="12dp">
        <p151v.VDraweeView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/red"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <p151v.VImage
            android:layout_gravity="end|bottom"
            android:id="@+id/delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:src="0x7f081455"
            android:layout_marginEnd="8dp"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileLoopEditUploadPhoto>
