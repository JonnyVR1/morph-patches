<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.MessageExchangeQuestionAnswerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/core_new_messages_prompt"
    android:paddingLeft="16dp"
    android:paddingTop="15dp"
    android:paddingRight="15dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="4dp"
    flatten="true"
    holder="messages.MessageExchangeQuestionAnswerLayout">
    <p151v.VFrame
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/tip_iv"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="0x7f0828aa"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/break_ice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:text="交换答案"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:src="0x7f082894"/>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="20sp"
        android:textStyle="normal"
        android:textColor="#cc000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/break_ice_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="国庆假期你最想去哪个城市旅行?"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/exchange_answer"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="18dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="15sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/exchange"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="立即交换"
            android:layout_weight="1"/>
        <View
            android:id="@+id/next_question"
            android:background="0x7f0828af"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.MessageExchangeQuestionAnswerLayout>
