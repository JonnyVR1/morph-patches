<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.roomsuggest.view.LiveRoomSuggestView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="40dp">
    <p151v.VText
        android:textSize="21sp"
        android:textStyle="normal"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="#80ffffff"
        android:ellipsize="end"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VRecyclerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/desc"
        android:layout_marginStart="8dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.roomsuggest.view.LiveRoomSuggestView>
