<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.maindialog.LiveGuardPrivilegeCardItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment"
    holder="knight.view.maindialog.LiveGuardPrivilegeCardItem">
    <View
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/icon"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="18dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#3253e1"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="@string/LIVE_GUARD_HEART_GUARD"
        android:fontFamily="PingFangSC-Medium"
        android:layout_marginStart="6dp"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#993353dd"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#993353dd"
        android:ellipsize="end"
        android:id="@+id/expire_date"
        android:background="@drawable/live_bg_3253e1_r10_a10"
        android:paddingLeft="6dp"
        android:paddingTop="1dp"
        android:paddingRight="6dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="41dp"
        android:maxWidth="80dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="29dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/next_privilege"
        android:background="0x7f082115"
        android:layout_width="30dp"
        android:layout_height="90dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.maindialog.LiveGuardPrivilegeCardItem>
