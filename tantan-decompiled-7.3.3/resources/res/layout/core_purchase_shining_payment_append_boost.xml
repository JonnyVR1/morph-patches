<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guide_svip_root"
    android:background="@drawable/core_boost_dlg_svip_button_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.mediator.payment.PurchasePaymentBoostComponent">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="17dp"
        android:layout_marginStart="16dp">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/guide_svip_title"
            android:layout_width="wrap_content"
            android:layout_height="23dp"
            flatten="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#d35006"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:text="开通"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:src="0x7f08139e"
                android:layout_marginStart="2dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:src="0x7f080566"
                android:layout_marginStart="6dp"/>
        </p151v.VLinear>
        <TextView
            android:textSize="12sp"
            android:textColor="#99d35006"
            android:id="@+id/guide_svip_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="2dp"
            android:text="每月免费赠送3次加速配对"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#fe7e1d"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/guide_svip_button"
        android:background="@drawable/core_boost_dlg_svip_buy_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="立即开通"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="10dp"/>
</FrameLayout>
