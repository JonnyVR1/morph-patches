<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.banner.LiveSquareBannerItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <p151v.VDraweeView
        android:id="@+id/drawee_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:actualImageScaleType="centerCrop"
        fresco:placeholderImage="@drawable/live_shape_cover_square_nearby_item_image"
        fresco:roundBottomLeft="true"
        fresco:roundBottomRight="true"
        fresco:roundTopLeft="true"
        fresco:roundTopRight="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="start|bottom"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="24dp"
        android:maxLines="2"
        android:layout_marginHorizontal="12dp"/>
    <View
        android:id="@+id/black_cover"
        android:background="@drawable/live_bg_black_r12_a10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.banner.LiveSquareBannerItemView>
