<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.MusicVolumeEditView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.MusicVolumeEditView">
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#eeffffff"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#f6f5f1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/original_video_txt"
            android:background="@drawable/music_edit_volume_text"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="12dp"
            android:text="@string/FEED_CAPTURE_ORIGINAL_AUDIO"
            android:singleLine="true"/>
        <SeekBar
            android:id="@+id/music_edit_volume_video"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:maxHeight="4dp"
            android:progressDrawable="@drawable/camera_seek_bar"
            android:minHeight="4dp"
            android:thumb="@drawable/camera_seek_bar_thumb"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/music_edit_volume_video_text"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="100"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#eeffffff"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#f6f5f1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/music_txt"
            android:background="@drawable/music_edit_volume_text"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="12dp"
            android:text="@string/PROFILE_TAGS_CATEGORY_MUSIC"
            android:singleLine="true"/>
        <SeekBar
            android:id="@+id/music_edit_volume_music"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:maxHeight="4dp"
            android:progressDrawable="@drawable/camera_seek_bar"
            android:minHeight="4dp"
            android:thumb="@drawable/camera_seek_bar_thumb"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/music_edit_volume_music_text"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="100"/>
    </LinearLayout>
</com.p051p1.mobile.putong.feed.newui.camera.MusicVolumeEditView>
