<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_living_habit"
    android:background="@color/white"
    android:paddingTop="18dp"
    flatten="true"
    holder="profile.profilelist.itemholders.EditProfileLivingHabitItemHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VText
        android:id="@+id/edit_title"
        android:paddingTop="0dp"
        android:text="生活习惯"
        style="@style/profile_item_title_black_edit"/>
    <include layout="@layout/core_profile_integrity_opt"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fitness_type_wrap"
        android:layout_marginTop="4dp"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="top"
            android:id="@+id/fitness_type_tip"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:text="健身"
            android:layout_weight="2"
            style="@style/profile_item_item_new"/>
        <p151v.VText
            android:textColor="@color/core_color_66000000"
            android:textColorHint="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/fitness_type"
            android:paddingLeft="0dp"
            android:paddingRight="20dp"
            android:maxLines="1"
            android:drawablePadding="0dp"
            android:layout_weight="3"
            app:drawableRightCompat="0x7f08145e"
            style="@style/profile_item_item_new"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/drinking_wrap"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="top"
            android:id="@+id/drinking_type_tip"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:text="饮酒"
            android:layout_weight="2"
            style="@style/profile_item_item_new"/>
        <p151v.VText
            android:textColor="@color/core_color_66000000"
            android:textColorHint="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/drinking"
            android:paddingLeft="0dp"
            android:paddingRight="20dp"
            android:maxLines="1"
            android:drawablePadding="0dp"
            android:layout_weight="3"
            app:drawableRightCompat="0x7f08145e"
            style="@style/profile_item_item_new"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/smoking_wrap"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="top"
            android:id="@+id/smoking_tip"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:text="吸烟"
            android:layout_weight="2"
            style="@style/profile_item_item_new"/>
        <p151v.VText
            android:textColor="@color/core_color_66000000"
            android:textColorHint="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/smoking"
            android:paddingLeft="0dp"
            android:paddingRight="20dp"
            android:maxLines="1"
            android:drawablePadding="0dp"
            android:layout_weight="3"
            app:drawableRightCompat="0x7f08145e"
            style="@style/profile_item_item_new"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/divider_layout"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="20dp">
        <View
            android:background="@drawable/core_profile_newui_edit_item_normal"
            android:layout_width="match_parent"
            android:layout_height="3dp"/>
    </LinearLayout>
</p151v.VLinear_Dividers>
