<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal"
    holder="live.square.LiveSquareHomeViewModelDomestic">
    <p151v.VFrame
        android:id="@+id/content_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <View
            android:id="@+id/skin_background_layer"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="72dp"/>
        <com.p051p1.mobile.putong.live.external.view.widgets.NoSaveStateViewPager
            android:id="@+id/v_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.live.external.internal.live.square.home.submodule.skin.ToolBarSkinView
        android:layout_gravity="top"
        android:id="@+id/toolbar_skin_view"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/root_bg_svga"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:scaleType="centerCrop"/>
    <p151v.VFrame
        android:id="@+id/title_bar"
        android:padding="0dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_tool_bar_height"
        app:contentInsetStart="0dp"
        flatten="true">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/tool_bar_line"
            android:background="#19000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.tabs.TabLayout
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tabs"
                android:fadingEdgeLength="27dp"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                app:tabBackground="@null"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="350dp"
                app:tabMinWidth="20dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="6dp"
                app:tabPaddingStart="9dp"
                app:tabTextAppearance="@style/liveTitleLayoutTextAppearance"/>
            <include
                android:id="@+id/top_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/live_square_home_top_button"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <View
        android:id="@+id/view_live_blur"
        android:background="@drawable/live_shape_set_blur"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="56dp"/>
    <include
        android:id="@+id/teen_mode_control"
        layout="@layout/live_square_teenmode_control"/>
</FrameLayout>
