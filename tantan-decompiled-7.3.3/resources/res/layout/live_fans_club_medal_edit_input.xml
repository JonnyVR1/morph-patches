<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/input_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.fansclub.widget"
    holder="LiveFansClubMedalEditPanel">
    <View
        android:id="@+id/input_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/input_layout"
        android:background="@drawable/live_bg_white_tr8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <p151v.VEditText
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:id="@+id/edit_text"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:maxLines="2"
            android:layout_weight="1"/>
        <p151v.VText
            android:enabled="false"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/btn_done"
            android:background="@drawable/live_bg_fe7e1d_r8"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="4dp"
            android:text="@string/LIVE_FANS_CLUB_SEND"/>
    </LinearLayout>
</LinearLayout>
