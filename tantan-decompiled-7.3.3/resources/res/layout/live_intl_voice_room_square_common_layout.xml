<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="intl.voicesquare.common"
    holder="VoiceRoomSquareCommonViewModel">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true"
            useId="true">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <p151v.VText
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:textColor="@color/common_000000_80"
                    android:textColorHint="@color/common_000000_20"
                    android:gravity="center"
                    android:id="@+id/search_tv"
                    android:background="@drawable/common_view_card_small_01_bg"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_margin="8dp"
                    android:maxLines="1"
                    android:drawablePadding="4dp"
                    android:layout_centerVertical="true"
                    android:drawableStart="0x7f082861"
                    android:paddingStart="8dp"
                    android:paddingEnd="34dp"
                    useId="true"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/view_group_no_live"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            flatten="true"
            useId="true">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:layout_gravity="center"
                    android:id="@+id/empty_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true"
                    layout="@layout/live_empty_view"/>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
