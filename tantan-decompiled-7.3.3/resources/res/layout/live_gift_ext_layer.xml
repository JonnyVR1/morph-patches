<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.giftlayer.LiveGiftExtLayer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/send_info_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp">
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:id="@+id/avatar1"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="125dp"/>
        <com.p051p1.mobile.putong.live.livingroom.increment.gift.giftlayer.LiveStrokeTextView
            android:textSize="15dp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/text1"
            android:layout_width="90dp"
            android:layout_height="23dp"
            android:layout_marginTop="94dp"
            android:layout_marginRight="125dp"/>
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:id="@+id/avatar2"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="125dp"
            android:layout_marginRight="0dp"/>
        <com.p051p1.mobile.putong.live.livingroom.increment.gift.giftlayer.LiveStrokeTextView
            android:textSize="15dp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/text2"
            android:layout_width="90dp"
            android:layout_height="23dp"
            android:layout_marginLeft="125dp"
            android:layout_marginTop="94dp"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/svga_view"
            android:layout_width="94dp"
            android:layout_height="47dp"
            android:layout_marginBottom="12dp"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:layout_gravity="bottom|right"
        android:id="@+id/right_bottom_avatar"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="53dp"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.giftlayer.LiveGiftExtLayer>
