<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatMissedCallItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="internal.vchat.view"
    holder="LiveVChatMissedCallItem">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/call_bt"
        android:background="@drawable/live_selector_vchat_call_bt_bg"
        android:layout_width="69dp"
        android:layout_height="34dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="2dp"
            android:src="0x7f0826db"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:text="回拨"
            android:fontFamily="PingFangSC-Medium"/>
    </p151v.VLinear>
    <p151v.VDraweeView
        android:id="@+id/user_icon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/green_point"
        android:background="@drawable/live_shape_bg_00ca48_point"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_black_80_opacity"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Medium"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/desc_layout"
        app:layout_constraintEnd_toStartOf="@+id/call_bt"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/desc_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintStart_toStartOf="@+id/user_name"
        app:layout_constraintTop_toBottomOf="@+id/user_name"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_ff6464"
            android:gravity="center"
            android:id="@+id/new_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="新未接"
            android:fontFamily="PingFangSC-Medium"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/sub_title_red_point"
            android:background="@drawable/live_bg_ff6464_r37"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_black_40_opacity"
            android:gravity="center"
            android:id="@+id/sub_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="18dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatMissedCallItem>
