<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:id="@+id/dlg_img"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="0x7f080953"
        android:scaleType="center"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="12dp"
        android:text="@string/LOCATION_PERMISSION_TIPS_POPUP_CONTENT"
        android:lineSpacingMultiplier="1.2"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/not_notify_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <p151v.VCheckBox
            android:gravity="center"
            android:id="@+id/not_notify"
            android:layout_width="16dp"
            android:layout_height="16dp"
            style="@style/common_checkbox"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#bfbfbf"
            android:id="@+id/not_notify_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/LOCATION_PERMISSION_TIPS_POPUP_NO_PROMPT"/>
    </p151v.VLinear>
</LinearLayout>
