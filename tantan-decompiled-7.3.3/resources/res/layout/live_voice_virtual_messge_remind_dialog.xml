<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/remind_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bg"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <View
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/remind_choice"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f0827e1"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintStart_toStartOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="消息提醒"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintLeft_toLeftOf="@+id/top_view"
        app:layout_constraintRight_toRightOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <RadioGroup
        android:id="@+id/remind_choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <p151v.VRadioButton
            android:textSize="15sp"
            android:textColor="#ccffffff"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/remind_all"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginRight="20dp"
            android:button="@null"
            android:text="所有消息均提醒"
            android:layout_marginStart="20dp"/>
        <p151v.VRadioButton
            android:textSize="15sp"
            android:textColor="#ccffffff"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/remind_settle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginRight="20dp"
            android:button="@null"
            android:text="仅入驻成员消息提醒"
            android:layout_marginStart="20dp"/>
        <p151v.VRadioButton
            android:textSize="15sp"
            android:textColor="#ccffffff"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/remind_friend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginRight="20dp"
            android:button="@null"
            android:text="仅好友消息提醒"
            android:layout_marginStart="20dp"/>
        <p151v.VRadioButton
            android:textSize="15sp"
            android:textColor="#ccffffff"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/remind_none"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:button="@null"
            android:text="所有消息均不提醒"
            android:layout_marginStart="20dp"/>
    </RadioGroup>
    <ImageView
        android:id="@+id/selceted_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="20dp"
        android:src="0x7f08267c"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
