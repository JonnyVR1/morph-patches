<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emoji_recycler"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:divider="@null"
        android:overScrollMode="never"/>
    <FrameLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/emoji_bottom_layout"
        android:layout_width="wrap_content"
        android:layout_height="140dp">
        <LinearLayout
            android:layout_gravity="bottom|right"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_delete_layout"
                android:layout_width="81dp"
                android:layout_height="63dp"
                android:layout_marginRight="16dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/emoji_delete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/core_message_multi_emoji_delete_bg"
                    android:scaleType="fitXY"
                    app:typeface="medium"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_send_layout"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginRight="12dp">
                <p151v.VText
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/emoji_send"
                    android:background="@drawable/core_message_emoji_send_bg"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/ACTION_SEND"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
