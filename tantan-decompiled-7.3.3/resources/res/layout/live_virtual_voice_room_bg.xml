<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.background.VirtualBgView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="virtual"
    holder="background.VirtualBgView">
    <p151v.VDraweeView
        android:id="@+id/static_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:actualImageScaleType="fitXY"
        app:failureImage="@color/live_2C2F36"
        app:failureImageScaleType="centerCrop"
        app:placeholderImage="@color/live_2C2F36"
        app:placeholderImageScaleType="centerCrop"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svg_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.p051p1.mobile.putong.live.livingroom.virtual.background.LiveMediaBgView
        android:id="@+id/media_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VImage
        android:id="@+id/ktv_bg_view"
        android:background="0x7f0827c8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,375:470"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.background.VirtualBgView>
