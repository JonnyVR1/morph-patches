<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="4">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/image"
                android:background="@drawable/student_id_sample_pic_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_centerHorizontal="true">
                <p151v.VText
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/CAMPUS_STUDENT_CARD_PHOTO_SAMPLE"
                    android:lineSpacingExtra="4sp"/>
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/imageSample"
                    android:layout_width="182dp"
                    android:layout_height="108dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="30dp"/>
            </LinearLayout>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/CAMPUS_STUDENT_CARD_SAMPLE_NOTE"
                android:layout_below="@+id/image"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:weightSum="3"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#de000000"
            android:gravity="center"
            android:id="@+id/from_camera"
            android:background="@drawable/tf_rect_light"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="38dp"
            android:text="@string/INTERACTION_CAMERA"
            android:layout_weight="1"/>
        <View
            android:background="#1e000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#de000000"
            android:gravity="center"
            android:id="@+id/from_album"
            android:background="@drawable/tf_rect_light"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="38dp"
            android:text="@string/ACTION_CHOOSE_PICTURE"
            android:layout_weight="1"/>
        <View
            android:background="#1e000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#de000000"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/tf_rect_light"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="38dp"
            android:text="@string/ACTION_CANCEL"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
