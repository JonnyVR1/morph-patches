<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.expanded.view.CardPhotoFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ratio="1"
    flatten="true"
    folder="newui"
    holder="profile.expandprofilelike.holder.ExpandProfileLikeLifePhotoHolder">
    <include
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/profile_picture_item"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/tag"
        android:paddingLeft="8dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_margin="16dp"
        flatten="true">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/lable_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="2dp"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/lable_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </p151v.VLinear>
    <p151v.VText
        android:gravity="center"
        android:id="@+id/head_pic_tag"
        android:paddingLeft="0dp"
        android:paddingTop="1dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:layout_width="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="头像"
        style="@style/core_card_small_tag"/>
</com.p051p1.mobile.putong.core.newui.home.card.expanded.view.CardPhotoFrame>
