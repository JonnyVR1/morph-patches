<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.status.improve.FeedStatusPostGuidePopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="249dp"
    flatten="true"
    folder="newui"
    holder="status.improve.FeedStatusPostGuidePopView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:background="@drawable/feed_status_post_guide_pop_bg"
        android:paddingBottom="26dp"
        android:layout_width="311dp"
        android:layout_height="193dp"
        android:layout_marginBottom="10dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/common_color_0d000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:src="0x7f081d8f"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/emoji_1_container"
                android:background="@drawable/feed_poi_guide_view_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/image_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="6dp"
                    app:roundAsCircle="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_08"
                    android:id="@+id/emoji_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="12dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/emoji_2_container"
                android:background="@drawable/feed_poi_guide_view_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/image_2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="6dp"
                    app:roundAsCircle="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_08"
                    android:id="@+id/emoji_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="12dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_000000_20"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VFrame
        android:id="@+id/pic_fl"
        android:background="@drawable/bg_round_white"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/common_color_0d000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/pic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:placeholderImage="@color/common_white"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:id="@+id/state"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="51dp"
            android:layout_marginTop="51dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="3dp"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.feed.newui.status.improve.FeedStatusPostGuidePopView>
