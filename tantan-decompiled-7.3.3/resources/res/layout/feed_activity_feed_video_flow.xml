<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_flow_root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    flatten="false"
    folder="newui"
    holder="videoflow.FeedVideoFlowViewModel">
    <com.p051p1.mobile.putong.feed.newui.videoflow.util.FeedVideoFlowRecycleView
        android:id="@+id/video_flow"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/guide_tips_cover"
        android:background="#66000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/guide_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:text="滑动查看更多"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:typeface="medium"/>
        <p151v.VImage
            android:background="0x7f081f25"
            android:layout_width="22dp"
            android:layout_height="6.6dp"
            android:layout_marginBottom="11dp"
            android:layout_above="@+id/guide_tips"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
