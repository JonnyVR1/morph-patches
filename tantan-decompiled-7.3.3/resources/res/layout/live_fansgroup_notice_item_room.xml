<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="23dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/user_avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        android:layout_toEndOf="@+id/user_avatar">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>
        <include layout="@layout/live_user_age_gender"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:id="@+id/apply_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/user_layout"
        android:layout_marginEnd="20dp"
        android:layout_alignStart="@+id/user_layout"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#66ffffff"
        android:id="@+id/apply_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/apply_desc"
        android:layout_alignStart="@+id/user_layout"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/apply_time"
        android:layout_alignStart="@+id/user_layout">
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/agree_btn"
            android:background="@drawable/live_bg_f83899_r12"
            android:layout_width="77dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_FANSGROUP_AGREE"
            android:layout_marginEnd="16dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/refuse_btn"
            android:background="@drawable/live_bg_white_r12_a10"
            android:layout_width="77dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_FANSGROUP_REFUSE"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#40ffffff"
            android:gravity="center"
            android:id="@+id/agreed_btn"
            android:background="@drawable/live_bg_white_r12_a10"
            android:layout_width="63dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_FANSGROUP_AGREED"/>
    </p151v.VLinear>
</p151v.VRelative>
