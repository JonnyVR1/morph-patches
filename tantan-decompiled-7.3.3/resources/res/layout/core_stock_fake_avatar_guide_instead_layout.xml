<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:src="0x7f080791"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/icon"
            android:layout_width="94dp"
            android:layout_height="133dp"
            android:layout_marginTop="47dp"
            android:src="0x7f0816db"
            android:layout_marginEnd="42dp"
            app:layout_constraintEnd_toEndOf="@+id/avatar"
            app:layout_constraintStart_toStartOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:background="@drawable/core_stock_fake_dlg_avatar_bg"
            android:padding="4dp"
            android:layout_width="98dp"
            android:layout_height="128dp"
            android:layout_marginTop="52dp"
            android:layout_marginStart="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="10dp"/>
        <p151v.VImage
            android:id="@+id/status_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="@+id/avatar"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="18sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:paddingHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="14sp"
            android:textColor="#ff6464"
            android:gravity="center"
            android:id="@+id/tint"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:paddingHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/button_1"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tint"
            app:layout_goneMarginTop="16dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/button_2"
            android:background="@drawable/core_stock_fake_avatar_guide_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button_1"
            app:layout_goneMarginTop="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear>
