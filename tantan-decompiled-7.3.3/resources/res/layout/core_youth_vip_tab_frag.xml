<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="youthvip.YouthVipTabViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/top_texture_bg"
                        android:layout_width="375dp"
                        android:layout_height="150dp"
                        android:layout_marginTop="20dp"
                        android:src="0x7f081a4c"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:id="@+id/top_title_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="60dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        flatten="true">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="0x7f081a4d"/>
                        <TextView
                            android:textSize="24dp"
                            android:textStyle="bold"
                            android:textColor="#cc000000"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/top_title"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginTop="8dp"
                            android:text="青春交友专区"
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#66000000"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/top_sub_title"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="3dp"
                            android:text="年轻人专区，结交和你一样的同龄人"
                            android:maxLines="1"/>
                    </p151v.VLinear>
                    <include
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/youthvip_student_verify"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/top_title_container"
                        layout="@layout/core_youth_vip_student_verify_view"/>
                    <include
                        android:id="@+id/youthvip_location"
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="38dp"
                        android:layout_marginRight="12dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/youthvip_student_verify"
                        layout="@layout/core_youth_vip_location_view"/>
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="231dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="12dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/youthvip_location">
                        <include
                            android:id="@+id/youthvip_daizi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            layout="@layout/core_youth_vip_base_privilege_view"/>
                        <View
                            android:layout_width="9dp"
                            android:layout_height="0dp"/>
                        <include
                            android:id="@+id/youthvip_blindbox"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            layout="@layout/core_youth_vip_base_privilege_view"/>
                    </p151v.VLinear>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </p151v.VLinear>
        </androidx.core.widget.NestedScrollView>
    </p151v.VLinear>
</FrameLayout>
