<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.base.player.LivePlayerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="base"
    holder="player.LivePlayerView">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/error_stub"
        android:layout="@layout/live_net_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#9aa5b1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/live_end"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="78dp"
        android:text="@string/LIVE_AUDIENCE_BORADCAST_STOP"/>
    <RelativeLayout
        android:id="@+id/water_mark_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:layout_marginRight="16dp"
        flatten="true">
        <p151v.VText
            android:textSize="6sp"
            android:textStyle="bold"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:id="@+id/water_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="0.5"
            android:shadowRadius="0"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/water_mark_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_vector_water_mark_cn"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/water_mark"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/loading"
        android:layout="@layout/live_loading_view"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
</com.p051p1.mobile.putong.live.livingroom.base.player.LivePlayerView>
