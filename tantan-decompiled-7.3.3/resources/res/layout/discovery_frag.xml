<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="discovery.DiscoveryFrag"
    useRefId="true">
    <FrameLayout
        android:id="@+id/title_bar"
        android:background="@drawable/new_ui_1_title_bar_bg_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/NEW_UI_TAB_MOMENT"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/new_tantan_v_1_main_background_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/moments"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            flatten="true">
            <ImageView
                android:background="@drawable/tf_rect_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/comment_count_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                flatten="true">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:src="0x7f081a77"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#b3000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="17dp"
                    android:layout_marginRight="8dp"
                    android:text="@string/MOMENTS_TITLE"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/comment_count"
                    android:background="@drawable/core_new_anim_tb_bar_num"
                    android:padding="2dp"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginRight="20dp"
                    android:minWidth="18dp"
                    app:typeface="medium"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/arrow_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                flatten="true">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:src="0x7f081f64"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/moments_profile"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_toLeftOf="@+id/arrow_container"
                android:layout_toRightOf="@+id/comment_count_container"
                android:layout_centerInParent="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    style="@style/core_fresco_profile_small"/>
                <ImageView
                    android:layout_gravity="top|right"
                    android:background="@drawable/new_ui_1_anim_tb_bar_dot"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
        </RelativeLayout>
        <ViewStub
            android:id="@+id/discover_frag_dynamic_banner"
            android:layout="@layout/viewstub_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            flatten="true"/>
    </LinearLayout>
</LinearLayout>
