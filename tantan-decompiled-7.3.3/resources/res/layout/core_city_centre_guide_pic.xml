<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.greet.ItemGreetGuidePic xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="greet.ItemGreetGuidePic">
    <p151v.VFrame
        android:background="@drawable/core_message_bar_input_bg"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="12dp">
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp">
            <p151v.VImage
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="0x7f0806fc"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:textColor="#cc000000"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="想更快收到回复？"
                    app:typeface="medium"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:id="@+id/tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发一张展示自我的照片吧"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/agree"
            android:background="@drawable/core_audio_player_view_bg"
            android:layout_width="67dp"
            android:layout_height="34dp"
            android:layout_marginRight="16dp"
            android:text="发送"
            app:typeface="medium"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.greet.ItemGreetGuidePic>
