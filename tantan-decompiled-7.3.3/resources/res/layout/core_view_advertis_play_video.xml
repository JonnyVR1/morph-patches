<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/video_content"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:id="@+id/video_ad_picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/core_kankan_card_placeholder"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomEnd="false"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundBottomStart="false"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"/>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="64dp"
        android:layout_height="64dp">
        <ImageButton
            android:id="@+id/icon_suspended"
            android:background="@color/transparent"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0809ca"/>
        <ImageButton
            android:id="@+id/icon_play"
            android:background="@color/transparent"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0809c7"/>
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminateOnly="true"
            app:cpb_color="@color/white"
            app:cpb_stroke_percentage="0.1"
            useId="true"/>
        <ImageButton
            android:id="@+id/ad_icon_play"
            android:background="@color/transparent"
            android:visibility="invisible"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="0x7f0809c7"
            android:layout_centerInParent="true"/>
    </FrameLayout>
</FrameLayout>
