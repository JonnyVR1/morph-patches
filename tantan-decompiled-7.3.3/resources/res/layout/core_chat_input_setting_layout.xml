<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="settings.ChatInputSettingActViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VScroll
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="20dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/common_grey_09"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_TITLE"/>
                <p151v.VListCell
                    android:id="@+id/chat_switch"
                    app:listcell_title="@string/SETTINGS_PRESS_ENTER_TO_SEND"
                    app:listcell_title_color="@color/common_black_02"
                    app:listcell_title_size="15sp"
                    style="@style/core_newfilter_cell"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
</p151v.VLinear>
