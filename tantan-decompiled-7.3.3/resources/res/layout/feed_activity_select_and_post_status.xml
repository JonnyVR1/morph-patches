<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="status.selectstatus.FeedSelectAndPostStatusViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/state_ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <View
                android:id="@+id/cover"
                android:background="@drawable/feed_select_and_post_state_header_bg"
                android:layout_width="match_parent"
                android:layout_height="240dp"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/view_line"
                android:background="@drawable/common_handlebar_handler"
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="25dp"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="20sp"
                android:textColor="@color/feed_black_010101"
                android:id="@+id/state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@+id/view_line"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/feed_gray_999999"
                android:id="@+id/state_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_below="@+id/state_title"
                android:layout_centerHorizontal="true"/>
            <p151v.AutoVDraweeView
                android:id="@+id/emotion_img"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="15dp"
                android:src="0x7f081efd"
                android:layout_below="@+id/state_time"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/feed_state_status_cursor_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="20dp"
                android:minHeight="56dp"
                android:layout_below="@+id/emotion_img">
                <p151v.VEditText
                    android:textSize="16sp"
                    android:textColor="@color/common_black_80"
                    android:textColorHint="@color/feed_33000000"
                    android:id="@+id/status_edit"
                    android:background="@null"
                    android:paddingLeft="20dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:hint="说说你此刻的状态..."
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/feed_guide_states_cursor_bg"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/common_orange"
                    android:gravity="center"
                    android:id="@+id/send"
                    android:paddingLeft="16dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/FEED_RELEASE"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    app:textAllCaps="false"/>
            </LinearLayout>
        </p151v.VRelative>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:divider="@null"
            android:layout_weight="1"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </p151v.VLinear>
    <View
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="84dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/feed_gray_fafafa"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/post"
        android:background="@drawable/feed_comment_send_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="14dp"
        android:text="@string/FEED_RELEASE"/>
</p151v.VFrame>
