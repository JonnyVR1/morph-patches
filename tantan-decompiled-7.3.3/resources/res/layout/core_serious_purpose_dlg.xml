<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_purpose_dlg_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="14dp"
        android:src="0x7f0811a6"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"/>
    <p151v.VImage
        android:id="@+id/purpose_icon"
        android:layout_width="124dp"
        android:layout_height="120dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="75dp"
        android:src="0x7f081684"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="22dp"
        android:text="你的交友目的：想结婚"
        android:layout_below="@+id/purpose_icon"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4c000000"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"
        android:minHeight="48dp"
        android:text="填写更多资料，和想结婚的用户加深对彼此的了解"
        android:layout_below="@+id/title"
        android:layout_marginHorizontal="40dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/fill_more_info"
        android:background="@drawable/core_purpose_all_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="43dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="54dp"
        android:text="@string/GUIDE_MARRIAGE_COMPLETE_PROFILE_BUTTON"
        android:layout_below="@+id/message"
        android:layout_marginHorizontal="40dp"/>
</p151v.VRelative>
