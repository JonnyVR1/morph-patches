<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemVoiceCall xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tip_layout"
        android:paddingTop="?attr/message_voice_call_right_padding_top"
        android:paddingBottom="?attr/message_voice_call_right_padding_bottom"
        android:layout_width="wrap_content"
        android:layout_height="?attr/message_audio_height_right"
        android:paddingStart="?attr/message_voice_call_right_padding_left"
        android:paddingEnd="?attr/message_voice_call_right_padding_right"
        style="@style/messages_item_right">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/message_text_content_color_right"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/image"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:scaleType="fitXY"
            android:layout_marginStart="?attr/message_voice_icon_margin_left"
            app:srcCompat="?attr/message_voice_phone_hang_out_right"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemVoiceCall>
