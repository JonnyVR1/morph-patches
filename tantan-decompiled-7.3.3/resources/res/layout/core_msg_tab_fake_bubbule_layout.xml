<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.growth.fakebyconv.MsgTabFakeBubbleRoot xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="ui"
    holder="growth.fakebyconv.MsgTabFakeBubbleRoot">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fake_bubble_root"
        android:background="0x7f0803c9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close_btn"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="0x7f080817"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-2dp"
            android:layout_marginRight="16dp">
            <FrameLayout
                android:id="@+id/profile_frame"
                android:layout_width="80dp"
                android:layout_height="102dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:roundedCornerRadius="10dp"/>
                <ImageView
                    android:layout_gravity="bottom|right"
                    android:id="@+id/indicator"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginRight="-3dp"
                    android:layout_marginBottom="-3dp"
                    android:src="0x7f081474"
                    android:scaleType="fitXY"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/common_000000_80"
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="99dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="16dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/common_000000_80"
                android:id="@+id/sub_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="99dp"
                android:layout_marginTop="37dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp">
            <p151v.VText
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/common_000000_40"
                android:gravity="center"
                android:id="@+id/exp_btn"
                android:background="@drawable/common_button_btn_gray_small"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="头像示例"
                android:layout_weight="1"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/exchange_btn"
                android:background="@drawable/common_button_btn_orange_small"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="9dp"
                android:text="更换头像"
                android:layout_weight="1"
                app:typeface="medium"/>
        </LinearLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.growth.fakebyconv.MsgTabFakeBubbleRoot>
