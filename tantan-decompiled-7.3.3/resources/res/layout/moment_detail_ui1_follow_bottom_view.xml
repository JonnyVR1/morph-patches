<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.MomentDetailHeaderBottomView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui1_follow"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.MomentDetailHeaderBottomView">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/detail"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText_Expandable
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            app:maxCollapsedLines="3">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </p151v.VText_Expandable>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#383e46"
            android:ellipsize="end"
            android:autoLink="web"
            android:id="@+id/content_follow1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:lineSpacingExtra="2dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_orange"
            android:ellipsize="end"
            android:id="@+id/moment_hyperlinks"
            android:paddingRight="32dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:singleLine="true"/>
        <include
            android:id="@+id/feed_share_link_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            layout="@layout/feed_share_link"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/insert_extra_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.p051p1.mobile.putong.feed.newui.photoalbum.feedbottom.insert.FeedInteractiveView
            android:orientation="vertical"
            android:id="@+id/interactive_play_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:id="@+id/qa_topic_tag"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="6dp"
            layout="@layout/feed_qa_topic_tag_view_layout"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:id="@+id/layout_time_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_03"
                android:id="@+id/read_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_03"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_03"
                android:ellipsize="end"
                android:id="@+id/txt_location"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:id="@+id/review"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/USER_INFO_CHECKING"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:id="@+id/feed_visit_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            flatten="true">
            <include
                android:id="@+id/user_header_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/value"
                layout="@layout/feed_header_enter_view"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#4d000000"
                android:id="@+id/user_view_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
            <p151v.VImage
                android:id="@+id/user_view_count_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081f2e"
                android:layout_marginStart="0dp"/>
        </p151v.VLinear>
        <RelativeLayout
            android:id="@+id/like_comment_new_ab"
            android:paddingLeft="12dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            flatten="true">
            <p151v.VRelative
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/like_count_container_new_ab"
                android:background="@drawable/feed_ui1_follow_rounded_gray_border"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                flatten="true">
                <p151v.VFrame
                    android:id="@+id/like_indicator_fl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    flatten="true">
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:id="@+id/like_indicator_new_ab"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginLeft="10dp"
                        android:src="0x7f081de3"
                        android:scaleType="fitCenter"/>
                    <p151v.VDraweeView
                        android:layout_gravity="center"
                        android:id="@+id/like_indicator_attitude"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:actualImageScaleType="centerCrop"/>
                </p151v.VFrame>
                <com.p051p1.mobile.putong.feed.newui.view.FeedAutoScrollTextView
                    android:textSize="12sp"
                    android:textColor="@color/feed_33000000"
                    android:gravity="center_vertical"
                    android:id="@+id/like_count_new_ab"
                    android:paddingLeft="4dp"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/like_indicator_fl"
                    android:layout_centerVertical="true"/>
            </p151v.VRelative>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/comment_count_container_new_ab"
                android:background="@drawable/feed_ui1_follow_rounded_gray_border"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@+id/like_count_container_new_ab"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/common_icon_new_ab"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="10dp"
                    android:src="0x7f081de2"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/feed_33000000"
                    android:gravity="center_vertical"
                    android:id="@+id/comment_count_new_ab"
                    android:paddingLeft="4dp"
                    android:paddingRight="11dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/chat_count_container_new_ab"
                android:visibility="gone"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/chat_icon_new_ab"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f081e9d"
                    android:scaleType="fitCenter"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#bfbfbf"
                    android:gravity="center_vertical"
                    android:id="@+id/chat_count_new_ab"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="@string/WELCOME_PAGE_TUTORIAL_CHAT_HIGHLIGHT_TEXT"/>
            </p151v.VLinear>
            <ImageView
                android:id="@+id/options"
                android:visibility="invisible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="16dp"
                android:src="0x7f081f19"
                android:scaleType="center"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#bfbfbf"
                android:id="@+id/user_set_visibility"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <include
            android:id="@+id/bottom_comment_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="14dp"
            flatten="true"
            layout="@layout/feed_bottom_comment_view"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/follow_avatar_tip"
        android:background="@drawable/bg_round_corner_blue"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="点击头像了解TA的更多动态"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/group_contain"
        android:background="@color/white"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_below="@+id/detail">
        <View
            android:background="#f2f2f2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VRelative
            android:id="@+id/group_icon"
            android:background="@drawable/feed_group_detail_enter_icon_bg"
            android:layout_width="38dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VImage
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="0x7f081d1c"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>
        </p151v.VRelative>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/group_icon"
            app:layout_constraintRight_toLeftOf="@+id/group_arrow"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:id="@+id/group_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/common_grey_03"
                android:id="@+id/group_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:maxLines="1"
                android:singleLine="true"/>
        </p151v.VLinear>
        <p151v.VImage
            android:id="@+id/group_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081d18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/group_contain">
        <View
            android:id="@+id/divider"
            android:background="#f2f2f2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_09"
            android:id="@+id/comment_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:text="@string/ACTION_COMMENT"/>
    </LinearLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.MomentDetailHeaderBottomView>
