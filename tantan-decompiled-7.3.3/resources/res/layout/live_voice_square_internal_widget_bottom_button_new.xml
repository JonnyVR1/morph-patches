<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/widget_bottom_button"
    android:background="@drawable/live_bg_fe7e1d_r10"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/left_text_container"
        android:layout_width="130dp"
        android:layout_height="48dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/left_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="3dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:id="@+id/left_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/split_line"
        android:background="@drawable/live_bg_white_r2_a10"
        android:visibility="gone"
        android:layout_width="3dp"
        android:layout_height="14dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/right_text_container"
        android:visibility="gone"
        android:layout_width="130dp"
        android:layout_height="48dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/right_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="3dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:id="@+id/right_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</p151v.VLinear>
