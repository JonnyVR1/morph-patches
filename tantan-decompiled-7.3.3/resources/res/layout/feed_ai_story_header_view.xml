<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/content_rl"
        android:background="@drawable/feed_poi_guide_view_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/poi_ic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f081c56"
            android:layout_centerVertical="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/info_content_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/right_arrow_ic"
            android:layout_toRightOf="@+id/poi_ic"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/feed_cc000000"
                android:ellipsize="end"
                android:id="@+id/poi_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="试用探探AI故事大师"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/feed_4d000000"
                android:ellipsize="end"
                android:id="@+id/poi_guide_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="只需几个关键词，就能帮你写故事"
                android:maxLines="1"/>
        </p151v.VLinear>
        <p151v.VImage
            android:id="@+id/right_arrow_ic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:src="0x7f081e29"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</merge>
