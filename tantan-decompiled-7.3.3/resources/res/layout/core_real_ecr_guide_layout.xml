<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@drawable/core_city_center_bg"
    android:paddingTop="16dp"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="messages.RealEcrGuideDlg">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f080701"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:layout_width="140dp"
        android:layout_height="110dp"
        android:layout_marginLeft="40dp"
        android:src="0x7f081604"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/certification_guide"
        android:background="@drawable/core_explore_confirm_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:text="去认证，每天无限配对"
        android:layout_marginHorizontal="20dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="16sp"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:id="@+id/svip_guide"
        android:background="@drawable/core_bg_10_15_percent_fe7e1d"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:text="开通SVIP，每天无限配对"
        android:layout_marginHorizontal="20dp"/>
</p151v.VLinear>
