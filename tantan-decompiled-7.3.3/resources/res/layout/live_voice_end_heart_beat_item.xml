<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.liveend.VoiceLiveEndHeartBeatItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:layout_marginTop="11dp"
    folder="voice.intl.liveend"
    holder="VoiceLiveEndHeartBeatItemView">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="16dp"
        style="@style/live_fresco_profile_small"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="16dp"
        android:layout_toLeftOf="@+id/heart_beat_value"
        android:layout_toRightOf="@+id/avatar"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            tools:text="哈哈"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/gender_age"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="9dp"
            android:paddingStart="3dp"
            android:paddingEnd="5dp">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/gender"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#a8aab0"
        android:gravity="center"
        android:id="@+id/heart_beat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        tools:text="34.2w"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.liveend.VoiceLiveEndHeartBeatItemView>
