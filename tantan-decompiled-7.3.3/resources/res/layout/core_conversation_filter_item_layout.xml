<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.FilterRoundedCornerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_layout"
    android:background="@drawable/core_message_tab_item_select_bg"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="10dp">
    <View
        android:id="@+id/anim"
        android:background="@drawable/core_message_tab_item_anim_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
    <com.p051p1.mobile.putong.core.newui.messages.ColorTrackTextView
        android:textSize="12sp"
        android:textColor="@color/core_color_66000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/item_view"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="附近"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/shimmer_svga"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.core.newui.messages.FilterRoundedCornerLayout>
