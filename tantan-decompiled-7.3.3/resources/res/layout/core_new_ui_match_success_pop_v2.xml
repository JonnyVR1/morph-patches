<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.match.view.MatchSuccessPopViewOpt xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="match.view.MatchSuccessPopViewOpt">
    <com.p051p1.mobile.putong.core.p058ui.match.view.LinearLayoutShadowLayout
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="12dp">
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:clipChildren="false"
            android:layout_width="125dp"
            android:layout_height="match_parent">
            <p151v.VDraweeView
                android:id="@+id/left_avatar"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:layout_marginLeft="11dp"
                android:layout_marginTop="10dp"
                android:alpha="0"
                android:elevation="10dp"
                android:outlineSpotShadowColor="@color/white"
                android:outlineAmbientShadowColor="@color/white"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:placeholderImage="@color/common_white"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/white"
                app:roundingBorderPadding="1dp"
                app:roundingBorderWidth="2dp"/>
            <p151v.VDraweeView
                android:id="@+id/right_avatar"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="10dp"
                android:alpha="0"
                android:elevation="10dp"
                android:outlineSpotShadowColor="@color/white"
                android:outlineAmbientShadowColor="@color/white"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@color/white"
                app:placeholderImage="@color/common_white"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/white"
                app:roundingBorderPadding="1dp"
                app:roundingBorderWidth="2dp"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/common_000000_80"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-40dp"
            android:text="@string/SWIPE_MATCH_SUCESS_CONTENT"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/core_match_success_opt_arrow"/>
    </com.p051p1.mobile.putong.core.p058ui.match.view.LinearLayoutShadowLayout>
</com.p051p1.mobile.putong.core.p058ui.match.view.MatchSuccessPopViewOpt>
