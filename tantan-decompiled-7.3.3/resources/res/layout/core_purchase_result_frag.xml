<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="result.PurchaseResultViewModel">
    <Space
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="206dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top"
        app:layout_constraintVertical_bias="0"/>
    <FrameLayout
        android:id="@+id/summarize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.result.VRectBottomArc
            android:id="@+id/gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="204dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/close"
            android:padding="5dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f08296f"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/product_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            flatten="true">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/product_name"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:drawableLeft="0x7f081564"
                android:drawablePadding="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#99ffffff"
                android:gravity="center"
                android:id="@+id/product_detail"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/feedback"
                android:background="@drawable/core_purchase_result_order_question"
                android:paddingLeft="10dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/privilege_summarize"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="146dp"
            android:layout_marginRight="10dp"
            flatten="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/privilege_summarize_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#a3775d"
                android:layout_gravity="center_vertical"
                android:id="@+id/privilege_summarize_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/action_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/action_view"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="17sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/action"
                android:background="@drawable/bg_privilege_vip_buy"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/flash_icon"
                android:visibility="invisible"
                android:layout_width="54dp"
                android:layout_height="49dp"
                android:src="0x7f081563"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#d74d37"
            android:gravity="center"
            android:autoLink="all"
            android:layout_gravity="center_vertical"
            android:id="@+id/feedback_bottom"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/divider"
        android:background="@drawable/vip_desc_line_buy"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintBottom_toTopOf="@+id/action_frame"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
