<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecallTellPriceSelectItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="pricerecall.PriceRecallTellPriceSelectItem">
    <p151v.VText
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="bottom"
        android:id="@+id/spec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3个月"
        app:typeface="regular"/>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="2dp">
        <p151v.VText
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:id="@+id/price_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥"/>
        <p151v.VText
            android:textSize="38dp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ff5435"
        android:id="@+id/origin_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecallTellPriceSelectItem>
