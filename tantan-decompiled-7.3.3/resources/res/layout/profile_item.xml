<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    attachToRoot="true"
    folder="newui"
    holder="profile.ProfileItem">
    <ImageView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_toRightOf="@+id/icon"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#1a1a1a"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="4sp"/>
    </LinearLayout>
    <View
        android:id="@+id/dot"
        android:background="@drawable/bg_red_size_10_dot"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/dot_num"
        android:background="@drawable/core_profile_item_red_dot_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:minWidth="16dp"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/flag"
        android:background="@drawable/core_me_tab_new_flag"
        android:paddingLeft="7dp"
        android:paddingTop="4dp"
        android:paddingRight="7dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"/>
    <p151v.VImage
        android:id="@+id/flag_icon"
        android:visibility="gone"
        android:layout_width="21dp"
        android:layout_height="14dp"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:id="@+id/status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f081f64"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <p151v.VDraweeView
        android:id="@+id/arrow_icon"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <ViewStub
        android:id="@+id/see_avatar_one"
        android:layout="@layout/core_intl_profile_item_viewstub_vdraw"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="30dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="22dp"
        android:layout_toStartOf="@+id/arrow"/>
    <ViewStub
        android:id="@+id/see_avatar_two"
        android:layout="@layout/core_intl_profile_item_viewstub_vdraw"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="30dp"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/arrow"/>
    <View
        android:id="@+id/divider"
        android:layout_alignParentBottom="true"
        style="@style/core_new_ui_1_me_item_line"/>
</merge>
