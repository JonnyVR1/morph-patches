<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.intl.common.bottom.gamepanel.IntlGameBoardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="intl"
    holder="common.bottom.gamepanel.IntlGameBoardView">
    <View
        android:id="@+id/backView"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/game_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/guide_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true"
        layout="@layout/live_intl_game_board_banner_layout"/>
    <View
        android:id="@+id/panel_bg"
        android:background="@drawable/live_bg_19191e_tr20"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvGameList"/>
    <View
        android:id="@+id/guide_line"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/panel_bg"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VRecyclerView
        android:id="@+id/gameList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="15dp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/tvGameList"
        android:paddingTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_ROOM_GAME_LIST"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/gameList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="16dp"/>
</com.p051p1.mobile.putong.live.livingroom.intl.common.bottom.gamepanel.IntlGameBoardView>
