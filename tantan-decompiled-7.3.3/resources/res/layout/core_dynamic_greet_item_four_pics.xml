<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VDraweeView
            android:id="@+id/image_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            style="@style/core_im_greet_pic_small"/>
        <p151v.VDraweeView
            android:id="@+id/image_two"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            style="@style/core_im_greet_pic_small"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">
        <p151v.VDraweeView
            android:id="@+id/image_three"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            style="@style/core_im_greet_pic_small"/>
        <p151v.VDraweeView
            android:id="@+id/image_four"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            style="@style/core_im_greet_pic_small"/>
    </p151v.VLinear>
</p151v.VLinear>
