<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/image_border"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.TickerView
        android:id="@+id/text_ticker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/heart_single_1_big"
        style="@style/heart_single"/>
    <ImageView
        android:id="@+id/heart_single_2_big"
        style="@style/heart_single"/>
    <ImageView
        android:id="@+id/heart_single_3_big"
        style="@style/heart_single"/>
    <ImageView
        android:id="@+id/heart_single_4_big"
        style="@style/heart_single"/>
</p151v.VFrame>
