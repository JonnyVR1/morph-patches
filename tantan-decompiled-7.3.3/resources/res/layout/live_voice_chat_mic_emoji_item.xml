<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.chat.view.VoiceChatMicEmojiItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.chat.view.VoiceChatMicEmojiItemView">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_message"
        android:paddingLeft="4dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/avatar"
        flatten="true">
        <include
            android:id="@+id/item_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            layout="@layout/live_voice_chat_atom_item"/>
        <FrameLayout
            android:id="@+id/item_2"
            android:background="@drawable/live_bg_black_r10_a20"
            android:layout_width="80dp"
            android:layout_height="72dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            flatten="true">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/emoji_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
                    android:layout_gravity="center"
                    android:id="@+id/svg_middle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
                <include
                    android:id="@+id/triple_dice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/live_voice_triple_dice_layout"/>
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/emoji_result"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    fresco:actualImageScaleType="centerCrop"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.chat.view.VoiceChatMicEmojiItemView>
