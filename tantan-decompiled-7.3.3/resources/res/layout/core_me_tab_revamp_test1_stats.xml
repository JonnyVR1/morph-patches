<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/test1_stats_container"
    android:paddingTop="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginStart="12dp">
    <p151v.VFrame
        android:id="@+id/test1_likes_you_stat"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:gravity="start"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText_NoTopPadding
                android:textSize="20sp"
                android:textColor="#000000"
                android:gravity="start"
                android:id="@+id/test1_likes_you_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontWeight="700"/>
            <p151v.VText_NoTopPadding
                android:textSize="11sp"
                android:textColor="#000000"
                android:gravity="start"
                android:id="@+id/test1_likes_you_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/TTT_INTL_TTC_FULLSCREEN_PREMIUM_PRIVILEGE_TITLE_1_USA"
                app:fontWeight="500"/>
        </p151v.VLinear>
        <p151v.VText_NoTopPadding
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/test1_likes_you_badge"
            android:background="@drawable/core_me_tab_revamp_see_badge_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="0dp"
            android:minWidth="20dp"
            android:lines="1"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="23dp"
            app:fontWeight="700"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/test1_likes_sent_stat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp">
        <p151v.VText_NoTopPadding
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="start"
            android:id="@+id/test1_likes_sent_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fontWeight="700"/>
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="#000000"
            android:gravity="start"
            android:id="@+id/test1_likes_sent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/INTL_MEET_TAB_ILIKE_TITLE"
            app:fontWeight="500"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:id="@+id/test1_visitors_stat"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp">
        <p151v.VLinear
            android:gravity="start"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText_NoTopPadding
                android:textSize="20sp"
                android:textColor="#000000"
                android:gravity="start"
                android:id="@+id/test1_visitors_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontWeight="700"/>
            <p151v.VText_NoTopPadding
                android:textSize="11sp"
                android:textColor="#000000"
                android:gravity="start"
                android:id="@+id/test1_visitors_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/INTL_MEET_TAB_VISITOR_TITLE"
                app:fontWeight="500"/>
        </p151v.VLinear>
        <p151v.VImage
            android:layout_gravity="start|top"
            android:id="@+id/test1_visitors_dot"
            android:background="@drawable/core_intl_profile_me_edit_red_dot"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="39dp"/>
    </p151v.VFrame>
</p151v.VLinear>
