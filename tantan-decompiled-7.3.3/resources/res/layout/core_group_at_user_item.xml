<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.group.p061at.GroupAtItemViewContent xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.group.at.GroupAtItemViewContent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_layout"
        android:background="@drawable/tf_rect_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar_image"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="8dp"
            style="@style/core_fresco_profile_small_without_foreground"/>
        <TextView
            android:textColor="#212121"
            android:ellipsize="end"
            android:id="@+id/member_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#999999"
        android:gravity="center_vertical"
        android:id="@+id/title_text"
        android:background="#f7f7f7"
        android:paddingLeft="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.group.p061at.GroupAtItemViewContent>
