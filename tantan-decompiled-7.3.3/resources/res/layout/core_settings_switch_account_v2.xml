<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="account.SwitchAccountV2ActViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080389"
        app:title="@string/SWITCH_ACCOUNT_TITLE"
        app:titleColor="@color/black"
        app:titleSize="20"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/switch_icon"
            android:layout_width="138dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:src="0x7f08185b"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/prompt_title"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="140dp"
            android:text="@string/SWITCH_ACCOUNT_BY_CLICK_AVATAR"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/common_000000_70"
            android:gravity="center"
            android:id="@+id/prompt_detial"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/SWITCH_ACCOUNT_CLEAR_ACCOUNT_WARM"
            android:layout_below="@+id/prompt_title"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_below="@+id/prompt_detial">
            <include
                android:id="@+id/account_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="26dp"
                android:layout_weight="1"
                layout="@layout/core_account_view_v2"/>
            <include
                android:id="@+id/account_two"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="26dp"
                android:layout_weight="1"
                layout="@layout/core_account_view_v2"/>
        </LinearLayout>
        <p151v.VButton_FakeShadowSmall
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/delete_account"
            android:background="@drawable/common_button_btn_orange_medium_v2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="40dp"
            android:text="@string/SWITCH_ACCOUNT_CLEAR_ACCOUNT"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="20dp"/>
    </RelativeLayout>
</p151v.VLinear>
