<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.MarryProfileViewModel">
    <p151v.VFrame
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="false">
        <View
            android:id="@+id/action_bar_bg"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:src="0x7f08168b"/>
    </p151v.VFrame>
    <p151v.VFrame_Shadow
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/like_shadow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:sl_cornerRadius="100dp"
        app:sl_dy="3dp"
        app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
        app:sl_shadowRadius="10dp"
        flatten="true">
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/like"
            android:background="@drawable/core_newui_marry_profile_btn_like_bg"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            flatten="true">
            <p151v.VImage
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f0818be"
                android:layout_centerInParent="true"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/like_text"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"/>
        </p151v.VLinear>
    </p151v.VFrame_Shadow>
</p151v.VFrame>
