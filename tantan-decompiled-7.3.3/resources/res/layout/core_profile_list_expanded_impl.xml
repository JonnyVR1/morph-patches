<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base_root"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.profilelist.imp.ProfileListExpandedViewModel">
    <p151v.VFrame
        android:id="@+id/root"
        android:background="@color/crop__button_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VProgressBar
            android:id="@+id/loading_block"
            style="@style/core_loading_block"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileCustomBar
                android:id="@+id/profile_custom_bar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:background="@drawable/core_expanded_profile_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="27dp"/>
                <com.p051p1.mobile.putong.core.newui.home.card.expanded.UserProfileExpandedCard
                    android:id="@+id/profile_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp"/>
            </FrameLayout>
        </p151v.VLinear>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/superlike_combo_anim_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            layout="@layout/core_super_like_combo_anim_view"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VFrame>
</p151v.VFrame>
