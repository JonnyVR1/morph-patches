<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl_deputy"
    android:paddingLeft="23dp"
    android:paddingTop="8dp"
    android:paddingRight="23dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.call.view.VoiceTenDeputyWidgetView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/one"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <include
            android:id="@+id/vc_deputy_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/two"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        flatten="true">
        <include
            android:id="@+id/vc_deputy_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
