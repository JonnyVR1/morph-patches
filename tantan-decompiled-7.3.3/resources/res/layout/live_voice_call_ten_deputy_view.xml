            android:id="@+id/vc_deputy_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            layout="@layout/live_voice_call_widget_item_view"/>
    </p151v.VLinear>
</p151v.VLinear>
