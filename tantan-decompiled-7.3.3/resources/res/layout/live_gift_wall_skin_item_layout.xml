<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.skin.LiveGiftWallSkinItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r10_a03"
    android:layout_width="match_parent"
    android:layout_height="175dp"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    flatten="true"
    folder="increment"
    holder="gift.giftwallnew.skin.LiveGiftWallSkinItemView">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/item_icon"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginTop="22dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="0x7f0822f1"
        android:layout_width="33dp"
        android:layout_height="21dp"
        android:layout_marginTop="120dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/user_icon"
        android:layout_width="19.2dp"
        android:layout_height="19.2dp"
        android:layout_marginTop="120.9dp"
        app:actualImageScaleType="fitCenter"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#e7b76b"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="94dp"
        android:layout_marginRight="10dp"
        android:maxLines="1"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.skin.LiveGiftWallSkinItemView>
