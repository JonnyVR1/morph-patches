<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemVisitorHideFootPrint xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemVisitorHideFootPrint">
    <FrameLayout
        android:background="0x7f0819c4"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:src="0x7f0819c7"
            android:scaleType="fitXY"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#e8cb8c"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#99e8cb8c"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"/>
            </p151v.VLinear>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#edd7a3"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/button"
                android:background="0x7f0819c5"
                android:layout_width="81dp"
                android:layout_height="34dp"
                android:layout_marginRight="8dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f0819c6"
                android:layout_marginEnd="12dp"/>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemVisitorHideFootPrint>
