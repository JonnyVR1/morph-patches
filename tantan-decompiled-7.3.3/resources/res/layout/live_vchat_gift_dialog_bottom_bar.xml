<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.module.giftDialog.view.LiveVChatGiftDialogBottomBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    folder="internal.vchat"
    holder="module.giftDialog.view.LiveVChatGiftDialogBottomBar">
    <ImageView
        android:id="@+id/recharge_start_icon"
        android:visibility="visible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="0x7f0822cb"
        app:layout_constraintBottom_toBottomOf="@+id/charge"
        app:layout_constraintEnd_toStartOf="@+id/charge"
        app:layout_constraintTop_toTopOf="@+id/charge"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/live_ff8817"
        android:gravity="center"
        android:id="@+id/charge"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/LIVE_GIFT_RECHARGE"
        android:lines="1"
        android:drawableEnd="0x7f0822ca"
        android:paddingStart="4dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogIndicator
        android:gravity="center_vertical"
        android:id="@+id/indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:fillColor="@color/live_white_60_opacity"
        app:gift_indicator_radius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pageColor="@color/live_white_10_opacity"/>
</com.p051p1.mobile.putong.live.external.internal.vchat.module.giftDialog.view.LiveVChatGiftDialogBottomBar>
