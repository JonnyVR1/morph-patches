<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="hideandseek.IntlHideAndSeekViewModel">
    <p151v.VFrame
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VButton
        android:id="@+id/back"
        android:background="0x7f080ab9"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="12dp"/>
    <p151v.VButton
        android:layout_gravity="end|bottom"
        android:id="@+id/self_location_btn"
        android:background="0x7f080ac5"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="64dp"
        android:layout_marginEnd="12dp"/>
    <p151v.VButton
        android:layout_gravity="end|bottom"
        android:id="@+id/self_role"
        android:background="0x7f080ac2"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="12dp"/>
    <com.p051p1.mobile.putong.core.p058ui.hideandseek.IntlHideAndSeekInfoView
        android:layout_gravity="bottom"
        android:id="@+id/info_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"/>
    <com.p051p1.mobile.putong.core.p058ui.hideandseek.IntlHideAndSeekRoleView
        android:layout_gravity="bottom"
        android:id="@+id/role_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"/>
</FrameLayout>
