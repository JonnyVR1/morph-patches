<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="582dp"
    flatten="true"
    folder="common.roomsuggest"
    holder="LiveRoomExitSuggestDialogHolder">
    <include
        android:id="@+id/main_layout"
        layout="@layout/live_room_exit_suggest_view"/>
    <include
        android:id="@+id/sub_layout"
        android:visibility="gone"
        layout="@layout/live_room_exit_suggest_subview"/>
    <include
        android:id="@+id/error_layout"
        android:visibility="gone"
        flatten="true"
        layout="@layout/live_net_error_1"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/bottom_lin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="24dp">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/enter"
            android:background="@drawable/live_bg_fe7e1d_r16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="24dp"
            android:text="@string/LIVE_ENTER_ROOM_QUICKLY"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/live_black"
            android:gravity="center"
            android:id="@+id/quit"
            android:background="@drawable/live_bg_white_r16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="32dp"
            android:text="@string/LIVE_OUT_OF_LIVE"
            android:layout_weight="1"/>
    </LinearLayout>
</p151v.VFrame>
