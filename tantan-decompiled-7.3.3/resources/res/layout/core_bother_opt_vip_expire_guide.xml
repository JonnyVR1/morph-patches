<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f081925"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/NEW_VIP_EXPIRED_ALERT_TITLE"
        android:fontFamily="sans-serif-medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:text="@string/NEW_VIP_EXPIRED_ALERT_DESCRIPTION"/>
    <p151v.VButton
        android:textStyle="bold"
        android:id="@+id/get"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:text="@string/NEW_VIP_EXPIRED_ALERT_GET_VIP_BUTTON"
        app:typeface="regular"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#cccccc"
        android:gravity="center"
        android:id="@+id/dismiss"
        android:background="@drawable/tf_rect_rounded_light"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/CORE_SVIP_PURCHASE_PRIVILEGE_THANKS"/>
</LinearLayout>
