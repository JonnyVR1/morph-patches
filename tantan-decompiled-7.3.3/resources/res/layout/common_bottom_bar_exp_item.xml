<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="@dimen/common_icon_small"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/common_icon_small"
        android:layout_height="@dimen/common_icon_small"
        android:layout_marginTop="6dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/common_icon_small"
            android:layout_height="@dimen/common_icon_small"
            android:layout_centerHorizontal="true"/>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center"
            android:id="@+id/svga_anim"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_badge"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp">
        <p151v.RedPointView
            android:id="@+id/badge"
            android:visibility="gone"
            style="@style/common_badge"/>
    </FrameLayout>
    <p151v.VOnlineIndicator
        android:id="@+id/indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp"
        app:indicatorStyle="style01"/>
    <p151v.VImage
        android:id="@+id/dot_icon"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"/>
    <RelativeLayout
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/rl_tab"
        android:layout_width="64dp"
        android:layout_height="14dp"
        android:layout_marginBottom="2dp">
        <p151v.VText
            android:textSize="10dp"
            android:textStyle="normal"
            android:textColor="@color/common_exp_black_01"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </RelativeLayout>
</FrameLayout>
