<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="page"
    holder="rights.niceNumber.RightNiceNumberViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/tool_bar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/LIVE_USER_RIGHT_NOBLE_NICE_NUMBER_MANAGE_TITLE"/>
    <include
        android:id="@+id/nice_number_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tool_bar"
        layout="@layout/live_user_right_nice_number_view"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/live_black_30_opacity"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/live_actionButton"
        android:background="@drawable/live_bg_black_r10_a03"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/notice"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_20_opacity"
        android:gravity="center"
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
