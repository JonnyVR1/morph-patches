<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.greet.ProfileSendLetterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@drawable/common_new_button_btn_white_medium"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    flatten="true"
    holder="vip.greet.ProfileSendLetterView">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/common_grey_04"
        android:layout_gravity="center_vertical"
        android:id="@+id/envelop_say_hai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#2bccff"
        android:gravity="center_vertical"
        android:id="@+id/send_btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:drawablePadding="3dp"
        android:layout_marginEnd="14dp"/>
    <com.p051p1.mobile.putong.core.p058ui.vip.widget.LetterRemainingSwitcherView
        android:textSize="14sp"
        android:gravity="center_vertical"
        android:id="@+id/letter_remaining_switcher"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="14dp"
        app:contentTextColor="#2bccff"
        app:contentTextSize="14sp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.greet.ProfileSendLetterView>
