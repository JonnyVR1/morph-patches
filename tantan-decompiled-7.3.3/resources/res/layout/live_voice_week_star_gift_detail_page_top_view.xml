<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.LiveVoiceWeekStarGiftDetailPageTopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="352dp">
    <p151v.VDraweeView
        android:id="@+id/gift_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view1"
        android:background="@drawable/live_bg_voice_new_gift_wall_card"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/view2"
        app:layout_constraintTop_toBottomOf="@+id/gift_icon"/>
    <p151v.VDraweeView
        android:id="@+id/contribute_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/view1"
        app:layout_constraintLeft_toLeftOf="@+id/view1"
        app:layout_constraintTop_toTopOf="@+id/view1"
        app:placeholderImage="0x7f08231a"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="7sp"
        android:textColor="#ffffff"
        android:background="@drawable/live_bg_fe7e1d_r4"
        android:paddingLeft="3dp"
        android:paddingTop="1dp"
        android:paddingRight="3dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CURRENT_NAMED"
        app:layout_constraintBottom_toBottomOf="@+id/contribute_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/contribute_avatar"
        app:layout_constraintRight_toRightOf="@+id/contribute_avatar"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:id="@+id/contribute_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/contribute_avatar"
        app:layout_constraintRight_toRightOf="@+id/view1"
        app:layout_constraintTop_toTopOf="@+id/view1"/>
    <p151v.VMarqueeText
        android:textSize="11sp"
        android:textColor="#40ffffff"
        android:ellipsize="marquee"
        android:id="@+id/contribute_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/contribute_avatar"
        app:layout_constraintRight_toRightOf="@+id/view1"
        app:layout_constraintTop_toBottomOf="@+id/contribute_name"/>
    <View
        android:id="@+id/view2"
        android:background="@drawable/live_bg_voice_new_gift_wall_card"
        android:layout_width="88dp"
        android:layout_height="56dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintLeft_toRightOf="@+id/view1"
        app:layout_constraintRight_toLeftOf="@+id/view3"
        app:layout_constraintTop_toBottomOf="@+id/gift_icon"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:id="@+id/sent_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/view2"
        app:layout_constraintRight_toRightOf="@+id/view2"
        app:layout_constraintTop_toTopOf="@+id/view2"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#66ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="3dp"
        android:text="@string/LIVE_CURRENT_WEEK_SENDED"
        app:layout_constraintLeft_toLeftOf="@+id/view2"
        app:layout_constraintRight_toRightOf="@+id/view2"
        app:layout_constraintTop_toBottomOf="@+id/sent_count"/>
    <View
        android:id="@+id/view3"
        android:background="@drawable/live_bg_fe7e1d_r16"
        android:layout_width="81dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        app:layout_constraintLeft_toRightOf="@+id/view2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_icon"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/LIVE_SEND_OUT"
        app:layout_constraintLeft_toLeftOf="@+id/view3"
        app:layout_constraintRight_toRightOf="@+id/view3"
        app:layout_constraintTop_toTopOf="@+id/view3"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="#66ffffff"
        android:gravity="center_vertical"
        android:id="@+id/diamond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="11233"
        android:drawableLeft="0x7f082287"
        android:drawablePadding="2dp"
        app:layout_constraintLeft_toLeftOf="@+id/view3"
        app:layout_constraintRight_toRightOf="@+id/view3"
        app:layout_constraintTop_toBottomOf="@+id/tv_send"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66ffffff"
        android:id="@+id/top1_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:text="@string/LIVE_TOP_ONE_NAMED_PRIVILEGE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3"/>
    <View
        android:id="@+id/privilege_view1"
        android:background="@drawable/live_bg_voice_new_gift_wall_card"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="5dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/privilege_view2"
        app:layout_constraintTop_toBottomOf="@+id/top1_title"/>
    <p151v.VDraweeView
        android:id="@+id/privilege_pic1"
        android:layout_width="121dp"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/privilege_view1"
        app:layout_constraintRight_toRightOf="@+id/privilege_view1"
        app:layout_constraintTop_toTopOf="@+id/privilege_view1"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#ccffffff"
        android:id="@+id/privilege_text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="礼物托盘标识"
        app:layout_constraintBottom_toBottomOf="@+id/privilege_view1"
        app:layout_constraintLeft_toLeftOf="@+id/privilege_view1"
        app:layout_constraintRight_toRightOf="@+id/privilege_view1"/>
    <View
        android:id="@+id/privilege_view2"
        android:background="@drawable/live_bg_voice_new_gift_wall_card"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/privilege_view1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top1_title"/>
    <p151v.VDraweeView
        android:id="@+id/privilege_pic2"
        android:layout_width="121dp"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="@+id/privilege_view2"
        app:layout_constraintRight_toRightOf="@+id/privilege_view2"
        app:layout_constraintTop_toTopOf="@+id/privilege_view2"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#ccffffff"
        android:id="@+id/privilege_text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="礼物公聊冠名"
        app:layout_constraintBottom_toBottomOf="@+id/privilege_view2"
        app:layout_constraintLeft_toLeftOf="@+id/privilege_view2"
        app:layout_constraintRight_toRightOf="@+id/privilege_view2"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66ffffff"
        android:gravity="center_vertical"
        android:id="@+id/contribute_board_text"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:text="@string/LIVE_NAMED_LEADERBOARD"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privilege_view1"/>
</com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.LiveVoiceWeekStarGiftDetailPageTopView>
