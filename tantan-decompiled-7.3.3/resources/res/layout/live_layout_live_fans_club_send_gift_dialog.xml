<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.fansclub"
    holder="sendgiftdialog.FansClubSendGiftDialog">
    <View
        android:id="@+id/back"
        android:background="@drawable/live_bg_white_r16"
        android:layout_width="310dp"
        android:layout_height="362dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="106dp"
        android:layout_height="106dp"
        android:layout_marginTop="30dp"
        app:layout_constraintLeft_toLeftOf="@+id/back"
        app:layout_constraintRight_toRightOf="@+id/back"
        app:layout_constraintTop_toTopOf="@+id/back"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#323232"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/back"
        app:layout_constraintRight_toRightOf="@+id/back"
        app:layout_constraintTop_toBottomOf="@+id/image"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#4d000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:lines="2"
        app:layout_constraintLeft_toLeftOf="@+id/back"
        app:layout_constraintRight_toRightOf="@+id/back"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/sure_text"
        android:background="@drawable/live_bg_ff8817_r16"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:text="@string/LIVE_SURE_ZH"
        app:layout_constraintBottom_toTopOf="@+id/cancel"
        app:layout_constraintLeft_toLeftOf="@+id/back"
        app:layout_constraintRight_toRightOf="@+id/back"/>
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminateOnly="true"
        app:cpb_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/sure_text"
        app:layout_constraintLeft_toLeftOf="@+id/sure_text"
        app:layout_constraintRight_toRightOf="@+id/sure_text"
        app:layout_constraintTop_toTopOf="@+id/sure_text"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="2dp"
        android:text="@string/LIVE_CANCEL_ZH"
        app:layout_constraintBottom_toBottomOf="@+id/back"
        app:layout_constraintLeft_toLeftOf="@+id/back"
        app:layout_constraintRight_toRightOf="@+id/back"/>
</androidx.constraintlayout.widget.ConstraintLayout>
