<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.voiceslipcard.chatroom.VoiceTabView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="voiceslipcard"
    holder="chatroom.VoiceTabView">
    <TextView
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingStart="12dp"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="76dp"
        android:layout_height="32dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="12dp"/>
</com.p051p1.mobile.putong.live.external.voiceslipcard.chatroom.VoiceTabView>
