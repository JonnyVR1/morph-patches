<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.match.view.MatchSuccessNewLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.view.MatchSuccessNewLayout">
    <View
        android:id="@+id/background"
        android:background="#ffb6f9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svge_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/input_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/core_match_success_input_close"
        android:scaleType="centerInside"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#cc000000"
        android:gravity="center"
        android:id="@+id/input_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="和她打个招呼吧"/>
    <FrameLayout
        android:id="@+id/head_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="39dp"
        android:layout_above="@+id/match_success_txt"
        flatten="true">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/me_head_layout"
            android:background="@drawable/core_group_chat_join_bg_selected"
            android:layout_width="135dp"
            android:layout_height="180dp"
            android:rotation="-10"
            android:layout_marginStart="-47.5dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/me_head"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="14dp"/>
            <p151v.VImage
                android:id="@+id/me_super_like"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="-10dp"
                android:src="0x7f0810e9"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/other_head_layout"
            android:background="@drawable/core_group_chat_join_bg_selected"
            android:layout_width="135dp"
            android:layout_height="180dp"
            android:rotation="10"
            android:layout_marginStart="47.5dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/other_head"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="14dp"/>
            <p151v.VImage
                android:layout_gravity="right"
                android:id="@+id/other_super_like"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="-10dp"
                android:src="0x7f0810e9"
                android:scaleType="centerInside"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="13sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/other_online_state"
                android:background="@drawable/core_match_success_new_ui_online_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:includeFontPadding="false"
                android:drawablePadding="1dp"/>
        </FrameLayout>
    </FrameLayout>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svge_flower"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignBottom="@+id/head_layout"/>
    <p151v.VText
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/match_success_txt"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="配对成功"
        android:layout_centerInParent="true"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/match_success_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="你们相互喜欢了对方"
        android:layout_below="@+id/match_success_txt"
        android:layout_centerInParent="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/verify_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_below="@+id/match_success_content"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VImage
            android:id="@+id/match_success_verify_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/core_match_success_verify_ok"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#bc5fb6"
            android:id="@+id/verify_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成认证，更容易被回应"/>
        <p151v.VImage
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/core_match_success_verify_go"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:id="@+id/emoji_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:layout_below="@+id/verify_layout"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VText
            android:textSize="24sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/one_emoji_text"
            android:background="@drawable/core_match_success_emoji_bg"
            android:padding="0dp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/two_emoji_text"
            android:background="@drawable/core_match_success_emoji_bg"
            android:padding="0dp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="14dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/three_emoji_text"
            android:background="@drawable/core_match_success_emoji_bg"
            android:padding="0dp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="14dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/four_emoji_text"
            android:background="@drawable/core_match_success_emoji_bg"
            android:padding="0dp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="14dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/edit_wrapper"
        android:background="@drawable/white"
        android:focusableInTouchMode="true"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/emoji_layout"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VEditText
            android:textSize="18sp"
            android:textColor="@color/common_black_01"
            android:textColorHint="@color/common_grey_03"
            android:ellipsize="end"
            android:id="@+id/edit_text"
            android:background="@null"
            android:paddingLeft="24dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="48dp"
            android:hint="@string/MATCH_BOX_DEFAULT_TEXT"
            android:maxLines="1"
            android:maxLength="1000"
            android:layout_weight="1"
            android:inputType="textAutoCorrect"
            app:typeface="regular"/>
        <p151v.VText
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/text_send"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/MATCH_TEXT_SEND"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:autoSizeMaxTextSize="16sp"/>
    </p151v.VLinear>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/core_match_success_close"
        android:layout_below="@+id/edit_wrapper"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.core.p058ui.match.view.MatchSuccessNewLayout>
