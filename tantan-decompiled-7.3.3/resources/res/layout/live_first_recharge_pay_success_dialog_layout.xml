<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.recharge.FirstRechargePaySuccessDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_ff7676_r20"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="25dp"
    android:layout_marginEnd="25dp"
    holder="increment.recharge.FirstRechargePaySuccessDialog">
    <p151v.VDraweeView
        android:id="@+id/top_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/question_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="11dp"
        android:src="0x7f0824b3"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_fff8d7"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:text="你已获得"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:src="0x7f0824b4"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/sub_title"
        app:layout_constraintEnd_toStartOf="@+id/sub_title"
        app:layout_constraintTop_toTopOf="@+id/sub_title"/>
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:src="0x7f0824b5"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/sub_title"
        app:layout_constraintStart_toEndOf="@+id/sub_title"
        app:layout_constraintTop_toTopOf="@+id/sub_title"/>
    <p151v.VLinear
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        app:layout_constraintTop_toBottomOf="@+id/sub_title">
        <include
            android:id="@+id/gift_item_left"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_weight="1"
            layout="@layout/live_first_recharge_gift_item"/>
        <include
            android:id="@+id/gift_item_center"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            layout="@layout/live_first_recharge_gift_item"/>
        <include
            android:id="@+id/gift_item_right"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:layout_weight="1"
            layout="@layout/live_first_recharge_gift_item"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.increment.recharge.FirstRechargePaySuccessDialog>
