<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui.home.marrymode.holder"
    holder="HeadItemViewHolder">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/core_marry_card_head_bg_gradient"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="18.5dp"/>
        <p151v.VDraweeView
            android:id="@+id/core_marry_card_head_bg"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="18.5dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/top_online_label"
                android:background="@drawable/core_marry_card_location_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginRight="5dp"
                android:text="在线"
                android:drawableLeft="@drawable/core_marry_online_ic"
                android:drawablePadding="3dp"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/top_location_label"
                android:background="@drawable/core_marry_card_location_bg"
                android:paddingLeft="6dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="距你9km"
                android:drawableLeft="0x7f081638"
                android:drawablePadding="3dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/head_bg"
            android:paddingTop="35dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            flatten="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VDraweeView
                    android:id="@+id/user_avatar"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    app:actualImageScaleType="centerCrop"
                    app:alertForRes="false"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:roundAsCircle="true"/>
                <p151v.VImage
                    android:id="@+id/certification_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="0x7f0818a7"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                    app:layout_constraintRight_toRightOf="@+id/user_avatar"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:textColor="@color/core_color_80percent_000000"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/name_and_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:maxLines="1"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="44dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_avatar"
                    app:typeface="medium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#fe7e1d"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/expected_wedding_date_text"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="44dp"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/label_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.view.CardLabelShowView3
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:itemBackground_="#f5ebea"
            app:itemHaveStroke_="false"
            app:itemMaxNumber_="6"
            app:itemsCenter_="true"/>
        <View
            android:id="@+id/label_tag_view"
            android:layout_width="10px"
            android:layout_height="10px"
            android:layout_marginTop="3dp"/>
    </p151v.VFrame>
</p151v.VLinear>
