<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rTopLeftRadius="24dp"
    app:rTopRightRadius="24dp"
    flatten="true"
    holder="wallet.PayCoolsDialog">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/INTL_WALLET_PREMIUM_POPUP_TITLE"
        app:typeface="medium"/>
    <View
        android:background="#08000000"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="20dp"/>
    <p151v.VImage
        android:background="0x7f080b6b"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="24dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#cc000000"
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="#fe7e1d"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:typeface="medium"/>
    <p151v.VRelative
        android:id="@+id/bill"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:id="@+id/category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GCash-Bills Payment"
            android:layout_centerVertical="true"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ff6244"
            android:gravity="center"
            android:id="@+id/pending"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:drawableLeft="0x7f080b6c"
            android:drawablePadding="8dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/bill_bt"/>
        <p151v.VButton
            android:id="@+id/bill_bt"
            android:background="0x7f080b6a"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <p151v.VRelative
        android:gravity="center_vertical"
        android:id="@+id/qr"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:id="@+id/qr_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR Pay"
            android:layout_centerVertical="true"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ff6244"
            android:gravity="center_vertical"
            android:id="@+id/qr_pending"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:drawableLeft="0x7f080b6c"
            android:drawablePadding="8dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/qr_bt"/>
        <View
            android:gravity="center_vertical"
            android:id="@+id/qr_icon"
            android:background="0x7f080b6f"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/qr_bt"/>
        <p151v.VButton
            android:id="@+id/qr_bt"
            android:background="0x7f080b6a"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <View
        android:background="#08000000"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"/>
    <p151v.VButton
        android:textSize="15sp"
        android:textColor="#66000000"
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="54dp"
        android:text="@string/CLOSE"
        android:layout_alignParentEnd="true"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout>
