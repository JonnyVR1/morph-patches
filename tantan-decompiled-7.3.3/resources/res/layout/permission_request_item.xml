<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.p070ui.permission.PermissionRequestItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:minHeight="72dp"
    holder="permission.PermissionRequestItemView">
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:layout_centerVertical="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_toRightOf="@+id/icon"
        android:layout_centerVertical="true">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:id="@+id/group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="0sp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_01"
            android:ellipsize="end"
            android:id="@+id/reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:layout_below="@+id/group"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.p070ui.permission.PermissionRequestItemView>
