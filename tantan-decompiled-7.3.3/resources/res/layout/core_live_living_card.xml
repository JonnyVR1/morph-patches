<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.p051p1.mobile.putong.core.newui.home.livewindow.LiveMediaView
        android:id="@+id/live_media_play_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/core_living_card_bottom_bg"
        android:layout_width="0dp"
        android:layout_height="148dp"
        android:layout_marginBottom="78dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_bg_view_2"
        android:background="@color/black"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.p051p1.mobile.android.p053ui.label.CommonLabelView
        android:id="@+id/label_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:labelIndex="7"
        app:labelSize="max"
        app:labelSpace="core"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/living_bg_view"
        android:background="@drawable/core_live_card_6_radius_bg"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VFrame
        android:id="@+id/living_svga"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/living_bg_view"
        app:layout_constraintEnd_toEndOf="@+id/living_bg_view"
        app:layout_constraintStart_toStartOf="@+id/living_bg_view"
        app:layout_constraintTop_toTopOf="@+id/living_bg_view">
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/live_svga"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="直播中"
            android:layout_marginStart="24dp"/>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/enter_room_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:measureLayoutOrientation="horizontal"
        app:measureReverse="true">
        <p151v.VText
            android:textSize="32sp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:shadowColor="@color/common_grey_04"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:fontFamily="PingFangSc-Medium"/>
        <p151v.VText
            android:textSize="32sp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/anchor_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/common_grey_04"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:fontFamily="PingFangSc-Medium"
            android:layout_marginStart="10dp"/>
        <p151v.VFrame
            android:layout_gravity="center"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp">
            <p151v.VIcon
                android:layout_gravity="center"
                android:id="@+id/verification_outer"
                android:src="0x7f0805b9"
                style="@style/common_icon_small"/>
            <p151v.VIcon
                android:layout_gravity="center"
                android:id="@+id/verification_inner"
                android:src="0x7f0805b8"
                style="@style/common_icon_xxxSmall"/>
        </p151v.VFrame>
    </com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/core_text_cdffffff"
        android:ellipsize="end"
        android:id="@+id/live_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:shadowColor="@color/common_light_02"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="0"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/enter_room_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/enter_room_button"
        android:background="@color/core_stroke_26ffffff"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:text="点击进入直播间"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.p051p1.mobile.putong.core.newui.home.views.SuperLikeBanner
        android:id="@+id/live_card_superlike_banner"
        android:visibility="invisible"
        android:layout_width="300dp"
        android:layout_height="167dp"
        android:layout_marginBottom="120dp"
        android:src="0x7f080613"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.p051p1.mobile.putong.core.newui.home.views.SwipeLikeButton
        android:id="@+id/live_card_dislike"
        android:visibility="invisible"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.core.newui.home.views.SwipeLikeButton
        android:id="@+id/live_card_like"
        android:visibility="invisible"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
