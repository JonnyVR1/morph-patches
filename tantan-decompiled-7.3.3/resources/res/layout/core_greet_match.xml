<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@drawable/core_theme_profile_gerrt_match_bg"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="10dp"
    android:paddingBottom="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/cover_left"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        style="@style/core_im_fresco_profile_white_tip_border"/>
    <p151v.VDraweeView
        android:id="@+id/cover_right"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="17dp"
        android:layout_centerVertical="true"
        style="@style/core_im_fresco_profile_white_tip_border"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:id="@+id/cover_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="49dp"
        android:text="@string/INTL_LETTER_MATCH_TIPS"
        android:layout_centerVertical="true"/>
</RelativeLayout>
