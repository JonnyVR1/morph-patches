<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fl"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="newui"
    holder="status.display.statuspage.FeedStatusPageAct">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar_title"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@+id/navigation_bar_title"/>
    <com.p051p1.mobile.putong.feed.newui.photoalbum.DiscoveryPager
        android:id="@+id/pager"
        android:background="#00ff00"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/meet_root"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/meet_close"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:src="0x7f081ee8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VRelative
            android:id="@+id/bg_view"
            android:background="@color/white"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/meet_close">
            <p151v.VImage
                android:id="@+id/bg_img_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="29dp"
                android:layout_marginTop="10dp"
                android:src="0x7f081c8a"/>
            <p151v.VImage
                android:id="@+id/bg_img_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081c8b"
                android:layout_alignParentRight="true"/>
            <p151v.VImage
                android:id="@+id/bg_img_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="127dp"
                android:src="0x7f081c8c"
                android:layout_alignParentBottom="true"/>
        </p151v.VRelative>
        <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/meet_svg"
            android:visibility="visible"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="226dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/meet_close"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#80000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正在偶遇…"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/meet_svg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
