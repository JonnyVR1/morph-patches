<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.tvline.LiveTvLineCardMainItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="@dimen/live_square_item_base_margin"
    android:layout_marginEnd="@dimen/live_square_item_base_margin">
    <com.p051p1.mobile.putong.live.base.view.LiveSquareMediaView
        android:id="@+id/media_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:id="@+id/cover"
        android:background="@drawable/live_shape_bg_half_cover"
        android:layout_width="match_parent"
        android:layout_height="77dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.p051p1.mobile.putong.live.base.arch.card.cardmodel.tvline.LiveMsgAutoScrollView
            android:id="@+id/msg_scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="50dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/tv_live_distance">
            <p151v.VText
                android:textSize="10dp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/text1"
                android:background="@drawable/live_bg_black_r5_a20"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:singleLine="true"
                android:alpha="0"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
            <p151v.VText
                android:textSize="10dp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/text2"
                android:background="@drawable/live_bg_black_r5_a20"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:singleLine="true"
                android:alpha="0"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
            <p151v.VText
                android:textSize="10dp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/text3"
                android:background="@drawable/live_bg_black_r5_a20"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:singleLine="true"
                android:alpha="0"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </com.p051p1.mobile.putong.live.base.arch.card.cardmodel.tvline.LiveMsgAutoScrollView>
        <include
            android:id="@+id/view_group_opt_label"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/live_square_new_opt_label"/>
        <p151v.VDraweeView
            android:id="@+id/anchor_level_icon"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="14dp"
            android:layout_marginBottom="1dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_distance"
            app:layout_constraintStart_toStartOf="@+id/tv_live_distance"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_live_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="1dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_distance"
            app:layout_constraintStart_toEndOf="@+id/anchor_level_icon"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="right"
            android:id="@+id/tv_live_audience_amount"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/tv_live_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.tvline.LiveTvLineCardMainItemView>
