<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.expirence.view.ItemTestChallengeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="?attr/message_bubble_bg_left"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="messages.expirence.view.ItemTestChallengeView">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content_child"
        android:background="@drawable/core_bg_18_f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="271dp"
        flatten="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="83dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/pic_img"
                android:layout_width="match_parent"
                android:layout_height="83dp"
                app:actualImageScaleType="fitXY"/>
            <p151v.VText
                android:textSize="21sp"
                android:textColor="@color/white"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测测你的真相"
                android:layout_centerVertical="true"
                android:paddingStart="19dp"/>
        </RelativeLayout>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:id="@+id/sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="我对你的测试感兴趣，已完成你的测试邀请"
            android:lineSpacingExtra="1dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_msg_cell_link_color"
            android:gravity="center"
            android:id="@+id/complete"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="12dp"
            android:text="查看我们能否成为饭友"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.expirence.view.ItemTestChallengeView>
