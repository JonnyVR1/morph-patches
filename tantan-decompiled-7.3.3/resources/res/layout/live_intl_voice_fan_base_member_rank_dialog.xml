<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="580dp">
        <p151v.VDraweeView
            android:id="@+id/background"
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/back"
            android:background="0x7f082382"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_VOICE_FUN_CLUB_MEMBER_LEADERBOARD"/>
        <View
            android:layout_gravity="right"
            android:id="@+id/faq"
            android:background="0x7f082387"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"/>
        <View
            android:background="@drawable/live_bg_white_r1_a03"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="64dp"
            android:layout_marginRight="20dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="83dp">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/live_selector_intl_voice_fan_base_rank_title_color"
                android:gravity="center"
                android:id="@+id/day_rank"
                android:background="@drawable/live_intl_voice_fan_base_rank_title_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_DAILY_BOARD"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/live_selector_intl_voice_fan_base_rank_title_color"
                android:gravity="center"
                android:id="@+id/week_rank"
                android:background="@drawable/live_intl_voice_fan_base_rank_title_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="12dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_WEEKLY_BOARD"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/live_selector_intl_voice_fan_base_rank_title_color"
                android:gravity="center"
                android:id="@+id/all_rank"
                android:background="@drawable/live_intl_voice_fan_base_rank_title_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="12dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_TOTAL_BOARD"/>
        </p151v.VLinear>
        <p151v.VRecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="116dp"/>
        <include
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="116dp"
            layout="@layout/live_empty_view"/>
    </FrameLayout>
</p151v.VLinear>
