<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.boost.BoostGuidePushLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/core_boost_guide_push_bg"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/boost_guide_push_svga"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            fresco:actualImageScaleType="centerCrop"
            fresco:roundAsCircle="true"/>
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f080568"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#8a7acb"
            android:gravity="center"
            android:id="@+id/open"
            android:background="@drawable/core_card_button_bg_white_normal"
            android:layout_width="53dp"
            android:layout_height="34dp"
            android:text="开启"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/close"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/title_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="加速配对"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/open"
            android:layout_toEndOf="@+id/boost_guide_push_svga"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:id="@+id/content_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="30分钟内，斩获最高10倍配对"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_below="@+id/title_txt"
            android:layout_toStartOf="@+id/open"
            android:layout_toEndOf="@+id/boost_guide_push_svga"
            android:layout_alignStart="@+id/title_txt"
            android:layout_alignEnd="@+id/title_txt"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.newui.boost.BoostGuidePushLayout>
