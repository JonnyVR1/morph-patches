<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="settings.datastorage.DataAndStorageActViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VScroll
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:id="@+id/title_data"
                android:layout_marginTop="8dp"
                android:text="@string/SETTINGS_DATA_TITLE"
                style="@style/core_settings_header0"/>
            <p151v.VFrame
                android:id="@+id/autoplay_video"
                style="@style/core_settings_stacked_frame">
                <p151v.VLinear style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/SETTING_VIDEO_AUTO_PLAY"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/auto_paly_text"
                        style="@style/core_settings_secondary"/>
                </p151v.VLinear>
                <ImageView
                    android:layout_gravity="center"
                    android:src="0x7f081f64"
                    style="@style/core_settings_arrow"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/preload_media"
                style="@style/core_settings_stacked_frame">
                <p151v.VLinear style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/SETTINGS_PRELOAD_MEDIA_TITLE"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/core_settings_secondary"/>
                </p151v.VLinear>
                <ImageView
                    android:layout_gravity="center"
                    android:src="0x7f081f64"
                    style="@style/core_settings_arrow"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:gravity="center_vertical"
                android:id="@+id/download_personal_data"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:text="@string/GDPR_DOWNLOAD_PERSONAL_DATA"
                    style="@style/core_settings_primary"/>
                <ImageView
                    android:layout_gravity="center"
                    android:src="0x7f081f64"
                    style="@style/core_settings_arrow"/>
            </p151v.VFrame>
            <View
                android:layout_marginTop="12dp"
                style="@style/core_settings_divider"/>
            <p151v.VText
                android:id="@+id/title_cache"
                android:layout_marginTop="8dp"
                android:text="@string/SETTINGS_STORAGE_TITLE"
                style="@style/core_settings_header0"/>
            <FrameLayout
                android:layout_marginBottom="42dp"
                style="@style/core_storage_frame">
                <p151v.VText
                    android:text="@string/SETTINGS_TOTAL_STORAGE"
                    style="@style/core_settings_storage_text"/>
                <p151v.VText
                    android:id="@+id/total"
                    android:text="..."
                    style="@style/core_settings_storage_text2"/>
            </FrameLayout>
            <p151v.VFrame
                android:id="@+id/clear_all"
                style="@style/core_settings_stacked_frame">
                <p151v.VButton_FakeShadowSmall
                    android:textColor="@color/common_orange"
                    android:layout_marginLeft="16dp"
                    android:text="@string/SETTINGS_CLEAR_STORAGE_BUTTON"
                    style="@style/core_settings_storage_text"/>
                <ImageView
                    android:layout_gravity="center"
                    android:src="0x7f081f64"
                    style="@style/core_settings_arrow"/>
            </p151v.VFrame>
            <p151v.VText
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="17dp"
                android:text="@string/SETTINGS_CLEAR_STORAGE_INFO"
                style="@style/settings_small_des"/>
        </LinearLayout>
    </p151v.VScroll>
</p151v.VLinear>
