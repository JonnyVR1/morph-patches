<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.model.messagebar.MessageBarActionItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.model.messagebar.MessageBarActionItemView">
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/action_img"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/new_function_dot"
        android:background="@drawable/core_message_bar_action_new_dot"
        android:visibility="gone"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="-12dp"
        android:layout_marginRight="-12dp"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/common_black_01"
        android:layout_gravity="center"
        android:id="@+id/value_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_gravity="right"
        android:id="@+id/value_line"
        android:background="@color/common_light_04"
        android:visibility="gone"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.model.messagebar.MessageBarActionItemView>
