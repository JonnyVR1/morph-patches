<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.group.FeedGroupEntranceItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    folder="newui"
    holder="group.FeedGroupEntranceItemView">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/group_head"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            app:roundedCornerRadius="12dp"
            style="@style/feed_fresco_base"/>
        <p151v.VFrame
            android:id="@+id/group_head_update_fl"
            android:background="@drawable/feed_group_entrance_update_state_bg"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="70dp"
            flatten="false">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/group_head_update"
                android:layout_width="59dp"
                android:layout_height="59dp"
                android:layout_margin="2.5dp"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/common_light_04"
                app:placeholderImage="@color/common_light_04"
                app:roundedCornerRadius="12dp"
                style="@style/feed_fresco_base"/>
        </p151v.VFrame>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/feed_e6000000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxWidth="64dp"/>
    </p151v.VLinear>
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/anonymous_tv"
        android:background="@drawable/feed_group_entrance_anonymous_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="9.5dp"
        android:text="@string/FEED_ANONYMOUS_POST_IDENTITY_ANONYMOUS_TITLE"/>
</com.p051p1.mobile.putong.feed.newui.group.FeedGroupEntranceItemView>
