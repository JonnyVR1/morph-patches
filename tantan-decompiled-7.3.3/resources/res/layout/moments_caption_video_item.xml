<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        app:actualImageScaleType="centerCrop"
        style="@style/feed_fresco_moment_small"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/play"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/feed_message_video_play_icon"/>
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/loading"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="10dp"
        android:indeterminateOnly="true"
        app:cpb_color="#d34530"
        app:cpb_stroke_percentage="0.1"/>
</p151v.VFrame>
