<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp">
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:text="@string/SENSITIVE_PROMPT_TITLE"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:src="0x7f080720"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="17dp"
        android:layout_marginRight="24dp"
        android:text="@string/SENSITIVE_PROMPT_DESCRIPTION"/>
    <p151v.VLinear
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="8dp">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#d74d37"
            android:gravity="center"
            android:id="@+id/positive"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:minWidth="72dp"
            android:text="@string/SENSITIVE_PROMPT_SEND"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#d74d37"
            android:gravity="center"
            android:id="@+id/negative"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:minWidth="72dp"
            android:text="@string/SENSITIVE_PROMPT_CANCEL"/>
    </p151v.VLinear>
</p151v.VLinear>
