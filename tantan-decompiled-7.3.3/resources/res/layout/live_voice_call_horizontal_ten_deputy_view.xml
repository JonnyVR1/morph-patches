<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fl_deputy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.call.view.VoiceHorizontalTenDeputyWidgetView">
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/touch_swallow_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <HorizontalScrollView
            android:id="@+id/scroll_view"
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="21dp"
            android:layout_marginRight="21dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            flatten="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <include
                    android:id="@+id/vc_deputy_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_9"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
                <include
                    android:id="@+id/vc_deputy_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    layout="@layout/live_voice_call_widget_item_view"/>
            </LinearLayout>
        </HorizontalScrollView>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
</LinearLayout>
