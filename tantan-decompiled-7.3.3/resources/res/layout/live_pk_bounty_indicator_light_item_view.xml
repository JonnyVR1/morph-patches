<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.bounty.PkBountyIndicatorLightItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="26dp"
    android:layout_height="26dp"
    flatten="true"
    folder="recreation"
    holder="pk.view.bounty.PkBountyIndicatorLightItemView">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/bg_dv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/light_img_disable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08244b"
        android:scaleType="centerCrop"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/light_img_enable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08244c"
        android:scaleType="centerCrop"/>
    <p151v.VImage
        android:layout_gravity="bottom"
        android:id="@+id/light_money"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1.5dp"
        android:src="0x7f08244d"
        android:scaleType="centerCrop"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/light_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/fg_dv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.bounty.PkBountyIndicatorLightItemView>
