<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/core_imageview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="80dp"
        android:src="0x7f0803a4"
        android:layout_marginStart="40dp"/>
    <TextView
        android:textSize="24sp"
        android:textColor="#010101"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/core_imageview"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:layout_above="@+id/tv_ok"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#999999"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_ok"
        android:background="@drawable/common_privacy_dialog_ok_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="6dp"
        android:text="@string/VERIFICATION_POLICY_AGREE"
        android:layout_above="@+id/tv_cancel"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#cccccc"
        android:id="@+id/tv_cancel"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/VERIFICATION_POLICY_NO"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="0x7f0803a3"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"/>
</RelativeLayout>
