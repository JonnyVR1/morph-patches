<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/error_layout"
    android:background="@drawable/live_shape_pull_up_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:id="@+id/error_text"
        android:background="@drawable/live_bg_black_r4_a60"
        android:paddingLeft="24dp"
        android:paddingTop="8dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_FOLLOW_ANCHOR"/>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/error_bt"
        android:background="@drawable/live_bg_black_r4_a60"
        android:layout_width="76dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:text="@string/LIVE_RETRY"/>
</LinearLayout>
