<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.customized.result.PrivateCustomResultListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_supreme_user_item_bg"
    android:layout_width="match_parent"
    android:layout_height="215dp"
    android:layout_margin="4dp"
    app:sl_cornerRadius="0dp"
    app:sl_shadowColor="#00000000"
    app:sl_shadowRadius="0dp"
    folder="newui"
    holder="customized.result.PrivateCustomResultListItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <View
        android:background="@drawable/core_nearby_top_layer"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/core_nearby_bottom_layer"
        android:layout_width="match_parent"
        android:layout_height="94dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="top"
        android:id="@+id/tag"
        android:background="@drawable/core_supreme_user_tag_bg"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"/>
    <p151v.VLinear_FillerMeasure
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/user_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="52dp"
        android:layout_marginBottom="8dp"
        app:fillerIndex="0"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/user_age"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear_FillerMeasure>
    <p151v.VImage
        android:layout_gravity="bottom|right"
        android:id="@+id/like_image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        app:srcCompat="0x7f0810ac"/>
</com.p051p1.mobile.putong.core.newui.customized.result.PrivateCustomResultListItemView>
