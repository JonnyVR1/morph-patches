<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/core_card_expose_pause"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="49dp"
    android:layout_marginBottom="12dp"
    flatten="true">
    <View
        android:id="@+id/point_like_me"
        android:background="0x7f081605"
        android:layout_width="54dp"
        android:layout_height="7dp"
        android:layout_marginLeft="28dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:background="@drawable/core_edit_new_tag_item_bg"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="13sp"
            android:textColor="#cc000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/card_expose_pause_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日收到喜欢x，当前无法获得更多喜欢"
            android:layout_weight="1"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="12sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:background="@drawable/core_privilege_vip_gotorenew_bg"
            android:layout_width="41dp"
            android:layout_height="26dp"
            android:text="查看"
            android:layout_weight="0"/>
    </p151v.VLinear>
</p151v.VLinear>
