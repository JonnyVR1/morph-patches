<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/filter_close_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f081055"/>
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/head_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="center"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="#66000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/content_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="32dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="4dp"
        flatten="true">
        <p151v.VCheckBox
            android:id="@+id/check"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2.5dp"
            android:checked="false"
            android:button="@null"
            style="@style/common_checkbox"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_33000000"
            android:id="@+id/reminder"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1.8dp"
            android:layout_marginStart="4dp"/>
    </p151v.VLinear>
    <p151v.VButton
        android:ellipsize="end"
        android:id="@+id/sub_btn"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:text="立即认证"
        android:lines="1"
        style="@style/common_button_large_01"/>
</p151v.VLinear>
