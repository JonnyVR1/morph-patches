<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="accountnew.loginopt.viewmodel.ShortCutLoginOptViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="0x7f080231"/>
        <p151v.VButton
            android:id="@+id/continue_opt"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="72dp"
            android:layout_marginRight="32dp"
            android:checked="false"
            android:text="一键登录"
            style="@style/common_button_large_01"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/common_orange"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/change_opt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/WECHAT_BIND_MOBILE_ACTION_SWITCH_ACCOUNT_NEW"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/terms_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        flatten="true">
        <p151v.VCheckBox
            android:id="@+id/terms_check"
            android:layout_marginRight="8dp"
            style="@style/common_checkbox"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_04"
            android:textColorHighlight="@color/transparent"
            android:textColorLink="#b2b2b2"
            android:id="@+id/agreement_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"/>
    </LinearLayout>
</FrameLayout>
