<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemPlatinumPinLike xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/core_message_platinum_pin_like_bg"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    folder="newui"
    holder="messages.ConversationItemPlatinumPinLike">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/header_pic"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        style="@style/fresco_profile_small"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp">
        <p151v.VLinear_FillerMeasure
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fillerIndex="0">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:typeface="medium"/>
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:src="0x7f080fb5"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear_FillerMeasure>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#869cc3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="她喜欢了你，配对马上开聊"
            android:singleLine="true"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/count_down"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            app:typeface="regular"/>
    </p151v.VLinear>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#e6ebf4"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/pin_like_match"
        android:background="0x7f080fb4"
        android:layout_width="53dp"
        android:layout_height="34dp"
        android:text="配对"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemPlatinumPinLike>
