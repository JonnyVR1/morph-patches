<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.signin.main.SignInMainFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.signin.main"
    holder="SignInMainFrame">
    <p151v.VImage
        android:id="@+id/rules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:srcCompat="0x7f08268c"/>
    <p151v.VImage
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_centerHorizontal="true"
        app:srcCompat="0x7f08267b"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/my_prize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"
        flatten="true">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="56dp"
            android:layout_height="56dp">
            <p151v.VImage
                android:id="@+id/box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="0x7f082671"/>
            <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
                android:id="@+id/box_svga"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/live_bg_black_r7_a15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-15dp"
            android:text="@string/LIVE_SIGN_IN_MY_GIFT"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/days"
        android:background="0x7f082670"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/days"/>
</com.p051p1.mobile.putong.live.livingroom.common.signin.main.SignInMainFrame>
