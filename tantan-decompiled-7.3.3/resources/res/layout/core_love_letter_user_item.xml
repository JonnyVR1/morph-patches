<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.loveletter.LoveLetterUserItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/match_layout_container"
    android:background="@drawable/liked_user_item_info_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    flatten="true"
    folder="newui"
    holder="loveletter.LoveLetterUserItem">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="10dp"
        style="@style/core_fresco_base"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_margin="10dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="10dp"
            android:textColor="#ef69e6"
            android:gravity="center"
            android:id="@+id/custom_icon"
            android:background="@drawable/core_love_letter_suggest_item_icon_bg"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"/>
        <View
            android:id="@+id/verified_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"/>
    </p151v.VLinear>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/info_layout"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        flatten="true">
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/user_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="62dp"
            flatten="false">
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/user_info_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:singleLine="true"
                    android:layout_weight="1"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/user_info_age"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:singleLine="true"
                    app:typeface="regular"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_color_b3ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/online_status_and_dist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:text="@string/MY_TANTAN_CARD_ONLINE"
                android:singleLine="true"
                android:drawableLeft="0x7f0812eb"
                android:drawablePadding="4dp"/>
        </p151v.VLinear>
        <View
            android:layout_gravity="bottom|right"
            android:background="0x7f080d87"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.loveletter.LoveLetterUserItem>
