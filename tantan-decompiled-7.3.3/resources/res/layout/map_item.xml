<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.map.MapPoiItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/tf_rect_light"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/map_item_height"
    holder="map.MapPoiItem">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#282828"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:singleLine="true"
            useId="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/detail_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#303030"
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                useId="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ff747474"
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                useId="true"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/check"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="14dp"
        android:src="0x7f082878"
        useId="true"/>
    <p151v.VText
        android:textColor="#e82d2d"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/add"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="14dp"
        android:text="添加"/>
</com.p051p1.mobile.putong.core.p058ui.map.MapPoiItem>
