<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/tv_about_me_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_about_me_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:includeFontPadding="false"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_grey_09"
        android:ellipsize="end"
        android:id="@+id/tv_about_me"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        app:typeface="regular"/>
</p151v.VLinear>
