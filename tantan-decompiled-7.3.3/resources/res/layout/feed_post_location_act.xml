<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/feed_location_bg_act"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="mediapicker.post.NewPostLocationViewModel">
    <p151v.VMenuBar
        android:id="@+id/menu_bar"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menubar_bottom_line_visible="false"
        app:menubar_icon_left="0x7f081d67"
        app:menubar_text_center="@string/INTERACTION_SEND_LOCATION"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VSearchBar
            android:id="@+id/search_bar"
            android:paddingLeft="19dp"
            android:paddingRight="19dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/FEED_SEARCH_POI_LOCATION"
            app:searchbar_cancel_behavior="behavior_float"
            app:searchbar_cancel_text="@string/ACTION_CANCEL"/>
        <ImageView
            android:id="@+id/no_result"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f081d66"
            android:scaleType="centerCrop"/>
        <p151v.VRecyclerView
            android:id="@+id/recycler"
            android:focusableInTouchMode="true"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
