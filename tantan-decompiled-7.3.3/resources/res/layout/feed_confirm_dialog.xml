<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.dialog.FeedRestrictLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:library="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/feed_confirm_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    library:restrict_width="400dp">
    <p151v.VText
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:id="@+id/dialogTitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#535353"
        android:id="@+id/dialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"/>
    <p151v.VLinear
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp">
        <p151v.VButton
            android:textSize="15sp"
            android:textColor="#bf4b4b"
            android:gravity="center"
            android:id="@+id/buttonNegative"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="60dp"
            android:text="@string/ACTION_CANCEL"/>
        <p151v.VButton
            android:textSize="15sp"
            android:textColor="#bf4b4b"
            android:gravity="center"
            android:id="@+id/buttonPositive"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:minWidth="60dp"
            android:text="@string/ALERT_OK"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.dialog.FeedRestrictLayout>
