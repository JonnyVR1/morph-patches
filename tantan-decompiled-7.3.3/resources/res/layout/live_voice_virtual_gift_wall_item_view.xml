<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.giftwalllocal.giftwall.VoiceGiftWallItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r10_a03"
    android:layout_width="match_parent"
    android:layout_height="129dp"
    android:layout_margin="5dp"
    folder="virtual.giftwalllocal.giftwall"
    holder="VoiceGiftWallItemView">
    <p151v.VImage
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="0x7f0822ee"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/item_icon"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginTop="16dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/user_icon_bg"
        android:background="@drawable/live_shape_round_1b1e2a_bg"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintEnd_toEndOf="@+id/user_icon"
        app:layout_constraintStart_toStartOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VDraweeView
        android:id="@+id/user_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/item_icon"
        app:layout_constraintEnd_toEndOf="@+id/item_icon"
        app:roundedCornerRadius="100dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_icon"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/item_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_title"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.giftwalllocal.giftwall.VoiceGiftWallItemView>
