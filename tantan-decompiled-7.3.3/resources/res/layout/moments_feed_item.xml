<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.moments.MomentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="moments.MomentView">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            flatten="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VDraweeView
                        android:id="@+id/profile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        style="@style/feed_fresco_profile_small"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:id="@+id/verification_icon"
                        android:background="0x7f081e18"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <p151v.VLinear_FillerMeasure
                            android:orientation="horizontal"
                            android:paddingRight="4dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:fillerIndex="0">
                            <p151v.VText
                                android:textSize="16sp"
                                android:textColor="@color/text_dark"
                                android:ellipsize="end"
                                android:layout_gravity="left"
                                android:id="@+id/name"
                                android:paddingRight="6dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:singleLine="true"
                                app:typeface="regular"/>
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/emoji"
                                android:paddingRight="6dp"
                                android:visibility="gone"
                                android:layout_width="26dp"
                                android:layout_height="20dp"/>
                            <p151v.VImage
                                android:layout_gravity="center"
                                android:id="@+id/vip_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="16dp"/>
                        </p151v.VLinear_FillerMeasure>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="@color/text_light"
                            android:id="@+id/time"
                            android:paddingRight="16dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            app:typeface="regular"/>
                    </LinearLayout>
                    <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
                        android:id="@+id/content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="48dp"
                        app:expandLine="3"
                        app:maxCollapsedLines="4">
                        <p151v.VText
                            android:textSize="14sp"
                            android:textColor="@color/text_medium"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textColor="@color/common_orange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"/>
                    </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
                    <FrameLayout
                        android:id="@+id/images_frame_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="48dp"
                        flatten="true">
                        <FrameLayout
                            android:id="@+id/images_frame"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_pic"/>
                            <include
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                layout="@layout/moments_video"/>
                            <p151v.VDraweeView
                                android:layout_gravity="bottom"
                                android:id="@+id/pic_mask"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="fitXY"/>
                        </FrameLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/live_tag"
                            android:background="@drawable/feed_live_room_bg_newui"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="8dp"
                            android:minWidth="64dp">
                            <com.p051p1.mobile.putong.feed.newui.photoalbum.live.FeedLiveLightView
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                app:layout_constraintEnd_toEndOf="@+id/live_tag_view_group"
                                app:layout_constraintStart_toStartOf="@+id/live_tag_view_group"
                                app:lightWidth="50"
                                app:loopTime="1500"/>
                            <LinearLayout
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/live_tag_view_group"
                                android:paddingRight="3dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                flatten="true">
                                <p151v.VText
                                    android:textSize="12sp"
                                    android:textColor="#ffffff"
                                    android:gravity="center"
                                    android:id="@+id/live_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="1dp"
                                    android:text="@string/LIVE_LINVING"/>
                                <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                                    android:layout_gravity="center"
                                    android:id="@+id/live_svg"
                                    android:visibility="visible"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </FrameLayout>
                    <com.p051p1.mobile.putong.feed.newui.photoalbum.livevoiceroom.FeedLiveVoiceRoomView
                        android:id="@+id/live_voice_enter"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="32dp"/>
                </LinearLayout>
            </LinearLayout>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/text_light"
                android:id="@+id/details"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="64dp"
                android:singleLine="true"
                android:drawableRight="0x7f08209d"
                android:drawablePadding="5dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/text_light"
                android:id="@+id/location"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:drawableLeft="0x7f0828f4"
                android:drawablePadding="5dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#bdbdbd"
                android:id="@+id/review"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="5dp"
                android:text="@string/USER_INFO_CHECKING"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/comment_like_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="20dp"
                flatten="true">
                <FrameLayout
                    android:id="@+id/comment"
                    android:background="@drawable/moments_feed_button_rounded"
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    android:layout_marginRight="8dp"
                    flatten="true">
                    <p151v.VText
                        android:layout_gravity="center"
                        android:id="@+id/comment_text"
                        android:text="@string/MOMENTS_BUTTON_COMMENT_TITLE"
                        android:drawableLeft="0x7f0828f2"
                        android:drawablePadding="6dp"
                        style="@style/feed_moment_comment_button_text"/>
                </FrameLayout>
                <include layout="@layout/moments_comment_like"/>
                <FrameLayout
                    android:id="@+id/chat"
                    android:background="@drawable/moments_feed_button_rounded"
                    android:visibility="gone"
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    flatten="true">
                    <p151v.VText
                        android:layout_gravity="center"
                        android:id="@+id/chat_text"
                        android:text="@string/MOMENTS_BUTTON_CHAT_TITLE"
                        android:drawableLeft="0x7f0828f1"
                        android:drawablePadding="6dp"
                        style="@style/feed_moment_comment_button_text"/>
                </FrameLayout>
                <p151v.VText
                    android:textColor="#4c000000"
                    android:gravity="center"
                    android:id="@+id/enter_live_room"
                    android:background="@drawable/feed_enter_live_room_bg"
                    android:paddingLeft="14dp"
                    android:paddingTop="10dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/FEED_LIVE_ROOM_ENTRANCE_NEWUI"
                    style="@style/feed_moment_comment_button_text"/>
                <FrameLayout
                    android:id="@+id/options_container"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    flatten="true">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/options"
                        android:background="@drawable/tf_circle_bounded_light"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="0x7f081d9f"
                        android:scaleType="center"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/moments_like_row"/>
        <View
            android:id="@+id/comment_divider"
            style="@style/feed_comment_like_divider"/>
        <FrameLayout
            android:id="@+id/see_all_frame"
            android:background="@drawable/moments_comment_bg"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/text_medium"
                android:layout_gravity="center"
                android:id="@+id/see_all_text"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/MOMENTS_FEED_MORE_COMMENTS_CELL"
                app:typeface="medium"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/comment_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/moments_item_divider"/>
    </LinearLayout>
    <p151v.VFrame_Anim
        android:id="@+id/sending_frame"
        android:background="#d9ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:layout_gravity="center"
            android:layout_width="40dp"
            android:layout_height="40dp"
            layout="@layout/feed_messages_sending_or_error"/>
    </p151v.VFrame_Anim>
</com.p051p1.mobile.putong.feed.p065ui.moments.MomentView>
