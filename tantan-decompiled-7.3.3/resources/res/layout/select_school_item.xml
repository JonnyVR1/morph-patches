<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.campus.SchoolItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="campus.SchoolItemView">
    <View
        android:id="@+id/divider"
        android:background="@drawable/settings_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/tantan_orange"
        android:id="@+id/sort_letter"
        android:padding="12dp"
        android:paddingLeft="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:typeface="medium"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item"
        android:background="@drawable/tf_rect_light"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/school_name"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:minHeight="48dp"
            android:singleLine="true"
            app:typeface="regular"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.campus.SchoolItemView>
