<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f082779"
        android:scaleType="centerCrop"/>
    <p151v.VDraweeView
        android:id="@+id/iv_top"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f082777"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/tv_top_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/tv_top_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_name"/>
    <com.p051p1.mobile.putong.live.external.page.swipecard.VoiceRoomAvatarLayout
        android:id="@+id/avatar_center"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_bottom_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_desc"
        app:layout_constraintVertical_bias="0.28">
        <p151v.VDraweeView
            android:id="@+id/avatar_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundAsCircle="true"/>
    </com.p051p1.mobile.putong.live.external.page.swipecard.VoiceRoomAvatarLayout>
    <FrameLayout
        android:background="@drawable/live_bg_ffc866_r15"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:layout_marginTop="68dp"
        app:layout_constraintEnd_toEndOf="@+id/avatar_center"
        app:layout_constraintStart_toStartOf="@+id/avatar_center"
        app:layout_constraintTop_toTopOf="@+id/avatar_center">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/anim_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"/>
    </FrameLayout>
    <p151v.VDraweeView
        android:id="@+id/avatar_2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintCircle="@+id/avatar_center"
        app:layout_constraintCircleAngle="40"
        app:layout_constraintCircleRadius="80dp"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintCircle="@+id/avatar_center"
        app:layout_constraintCircleAngle="120"
        app:layout_constraintCircleRadius="80dp"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_4"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintCircle="@+id/avatar_center"
        app:layout_constraintCircleAngle="200"
        app:layout_constraintCircleRadius="80dp"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_5"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintCircle="@+id/avatar_center"
        app:layout_constraintCircleAngle="260"
        app:layout_constraintCircleRadius="80dp"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_6"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintCircle="@+id/avatar_center"
        app:layout_constraintCircleAngle="320"
        app:layout_constraintCircleRadius="80dp"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/tv_online"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/live_shape_bg_68de48_oval"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_center"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_online"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e89e4d"
        android:gravity="center"
        android:id="@+id/tv_bottom_button"
        android:background="@drawable/live_bg_white_r10"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
