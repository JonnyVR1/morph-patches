<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#2c2f36"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal"
    holder="virtualVoice.square.LiveVoiceInternalSquareViewModelNew">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_view"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/page_title_bar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <p151v.VPullDownRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:srlEnableLoadMore="false"
            flatten="true">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/tab_container"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:elevation="0dp"
                    flatten="true"
                    useId="true">
                    <include
                        android:id="@+id/header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_scrollFlags="exitUntilCollapsed|scroll"
                        flatten="true"
                        layout="@layout/live_voice_square_internal_header"
                        useId="true"/>
                    <com.google.android.material.tabs.TabLayout
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/tabs"
                        android:paddingTop="8dp"
                        android:paddingBottom="5dp"
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginLeft="9dp"
                        android:layout_marginRight="9dp"
                        app:tabBackground="@null"
                        app:tabGravity="fill"
                        app:tabIndicatorHeight="0dp"
                        app:tabMaxWidth="350dp"
                        app:tabMinWidth="20dp"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="3dp"
                        app:tabPaddingStart="3dp"
                        app:tabTextAppearance="@style/liveTitleLayoutTextAppearance"
                        useId="true"/>
                </com.google.android.material.appbar.AppBarLayout>
                <com.p051p1.mobile.putong.live.external.view.widgets.NoSaveStateViewPager
                    android:id="@+id/v_pager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    useId="true"/>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </p151v.VPullDownRefreshLayout>
    </FrameLayout>
</FrameLayout>
