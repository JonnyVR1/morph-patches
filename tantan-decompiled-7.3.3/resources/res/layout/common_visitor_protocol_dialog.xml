<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_visitor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/PRIVACY_POLICY_DLG_SECOND_TITLE"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_visitor_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="32dp"
            android:text="@string/PRIVACY_POLICY_DLG_SECOND_CONTENT"/>
        <p151v.VButton
            android:id="@+id/bt_visitor_read"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="32dp"
            android:text="@string/PRIVACY_POLICY_DLG_SECOND_AGREE"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#33000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_to_visitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ACTION_PREVIEW"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#33000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_visitor_cancle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/PRIVACY_POLICY_DLG_SECOND_DISAGREE"/>
    </p151v.VLinear>
</p151v.VLinear>
