<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/phone_login"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="welcome.WelcomeActViewModel">
    <p151v.VText
        android:textColor="@color/white"
        android:id="@+id/phone_quick"
        android:background="@drawable/common_button_btn_orange_large"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:checked="false"
        android:text="189****2976 一键登录"
        android:layout_marginHorizontal="40dp"
        style="@style/common_button_large"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_grey_09"
        android:id="@+id/phone_change_opt"
        android:background="@drawable/account_change_login_btn_bg"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"
        android:text="@string/WECHAT_BIND_MOBILE_ACTION_SWITCH_ACCOUNT_NEW"
        android:layout_marginHorizontal="40dp"
        style="@style/common_button_large"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/common_grey_03"
        android:gravity="center_horizontal"
        android:id="@+id/phone_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="74dp"
        android:text="未注册手机号验证后将自动注册"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/other_login_wechat"
            android:background="@drawable/account_other_login_btn_bg"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:src="0x7f0803db"
            android:layout_marginHorizontal="26dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/other_login_qq"
            android:background="@drawable/account_other_login_btn_bg"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:src="0x7f0803d9"
            android:layout_marginHorizontal="26dp"/>
    </p151v.VLinear>
</p151v.VLinear>
