<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="dialog.FeedFlowerCountDialog">
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_view"
        android:background="@drawable/feed_dialog_bottom_to_top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/iv_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            app:srcCompat="0x7f081cef"/>
        <p151v.VImage
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:src="0x7f081d08"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="15dp"
            android:text="我的小红花"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_000000_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="40dp"
            android:text="送出小红花即可发送配对邀请。有效期48小时，可通过发布受欢迎的动态获得。"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_80"
            android:id="@+id/flower_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="40dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/submit"
            android:background="@drawable/feed_post_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="知道了"/>
    </p151v.VLinear>
</FrameLayout>
