<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.VipLocationItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:background="@color/common_white"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:minHeight="76dp"
    android:paddingHorizontal="20dp"
    flatten="true"
    holder="vip.VipLocationItemView">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/core_vip_location_history_explored_left"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/address"
            android:paddingTop="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_toRightOf="@+id/icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"/>
    </RelativeLayout>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.VipLocationItemView>
