<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.femalevip.FemaleVipCreditScoreIntroView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="femalevip.FemaleVipCreditScoreIntroView">
    <View
        android:background="@drawable/core_female_vip_credit_score_intro_bg"
        android:layout_width="match_parent"
        android:layout_height="208dp"/>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080851"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="94dp"
        android:layout_height="94dp"
        android:layout_marginTop="60dp">
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/score_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/score_lock_ic"
            android:visibility="invisible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="22dp"
            android:src="0x7f080852"/>
        <p151v.VText
            android:textSize="28sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/score_num"
            android:layout_width="wrap_content"
            android:layout_height="39dp"
            android:layout_marginTop="21dp"
            app:typeface="medium"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="208dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="238dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="32dp"/>
</com.p051p1.mobile.putong.core.newui.femalevip.FemaleVipCreditScoreIntroView>
