<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="ui"
    holder="messages.meme.CoreMemePhotoPreviewViewModel">
    <p151v.fresco.photodraweeview.PhotoDraweeView
        android:orientation="vertical"
        android:id="@+id/img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:failureImage="0x7f081a6c"
        app:layout_constraintBottom_toTopOf="@+id/bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/core_im_fresco_base"/>
    <View
        android:id="@+id/bar"
        android:background="#1a1a1a"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/next"
        android:background="@drawable/core_message_my_custom_meme_orange_small_btn"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/STICKERS_NEXT"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
