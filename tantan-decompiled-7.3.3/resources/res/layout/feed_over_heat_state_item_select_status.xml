<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/feed_over_heat_state_time_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="status.selectstatus.adapter.FeedSelectStatusItem">
    <p151v.AutoVDraweeView
        android:layout_gravity="center"
        android:id="@+id/over_heat_image"
        android:layout_width="52dp"
        android:layout_height="52dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99000000"
        android:layout_gravity="center"
        android:id="@+id/over_heat_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</p151v.VLinear>
