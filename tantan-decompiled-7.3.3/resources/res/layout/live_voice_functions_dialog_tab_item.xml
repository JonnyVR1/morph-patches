<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.dialog.tab.VoiceFunctionsTabItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:bind_extends="LinearLayout"
    app:bind_implements="null"
    app:binding="true">
    <p151v.VFrame
        android:id="@+id/icon_root"
        android:background="@drawable/live_selector_voice_virtual_function_tab_bg"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:flatten="true">
        <View
            android:layout_gravity="center"
            android:id="@+id/background"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/auction_tag"
        android:background="@drawable/live_bg_fe7e1d_r4"
        android:paddingTop="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="-10dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.dialog.tab.VoiceFunctionsTabItemView>
