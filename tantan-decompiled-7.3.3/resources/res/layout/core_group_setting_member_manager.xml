<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.group.GroupSettingMemberManagerViewModel"
    innerClass="true">
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="#4c323232"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/empty_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="@string/CHAT_GROUP_MEMBER_MANAGE_NULL_TOAST"
        android:drawableTop="0x7f0816b5"
        android:drawablePadding="2dp"
        android:lineSpacingExtra="6sp"/>
    <p151v.VRecyclerView
        android:id="@+id/recyclerView"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</p151v.VFrame>
