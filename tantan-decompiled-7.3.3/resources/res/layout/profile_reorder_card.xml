<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="profile.MediaReorderCard">
    <com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCardScaleIndependentFrame
        android:id="@+id/frame"
        android:background="0x7f081452"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true"
        style="@style/core_fresco_base">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_fresco_base"/>
        <View
            android:id="@+id/mask"
            android:background="#80ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/crop_pic_state"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/core_crop_pic_delete"
            android:scaleType="fitXY"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/upload_tip"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="28dp"
            android:text="上传这张头像增加6.6%被喜欢概率"/>
        <com.p051p1.mobile.putong.core.newui.view.ShimmerLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/shimmer_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:shimmer_angle="-45"
            app:shimmer_animation_duration="1000"
            app:shimmer_mask_width="0.5">
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_05"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/bg_tips"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="PingFangSC-Medium"
                app:typeface="medium"/>
        </com.p051p1.mobile.putong.core.newui.view.ShimmerLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/illegal"
            android:background="@drawable/core_profile_recorder_card_illegal_bg"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:text="@string/HIGH_RISH_MESSAGE_BLOCK_TIP"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            flatten="true">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tag"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:drawablePadding="2dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
            </FrameLayout>
            <Space
                android:layout_width="6dp"
                android:layout_height="0dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/scale_independent"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:src="0x7f081187"/>
        </LinearLayout>
        <p151v.VFrame_Anim
            android:layout_gravity="center"
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/failure"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/core_profile_edit_error"
                android:scaleType="fitXY"/>
            <p151v.VProgressBar
                android:layout_gravity="center"
                android:id="@+id/uploading"
                android:visibility="invisible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateOnly="true"
                app:cpb_color="@color/tantan_orange"
                app:cpb_stroke_percentage="0.1"/>
            <p151v.VProgressBar
                android:layout_gravity="center"
                android:id="@+id/uploading_white"
                android:visibility="invisible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateOnly="true"
                app:cpb_color="@color/white"
                app:cpb_stroke_percentage="0.1"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/success"
                android:visibility="invisible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f082971"/>
        </p151v.VFrame_Anim>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/new_scale_independent"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="8dp"/>
    </com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCardScaleIndependentFrame>
</com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCard>
