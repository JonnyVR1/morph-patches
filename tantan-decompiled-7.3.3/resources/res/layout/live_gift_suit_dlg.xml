<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="344dp"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/safe_area_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/rules"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/count_down_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:scaleType="fitXY"
            android:minWidth="150dp"
            android:minHeight="25dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="150dp"
            android:minHeight="25dp"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toBottomOf="@+id/count_down_bg"
            app:layout_constraintLeft_toLeftOf="@+id/count_down_bg"
            app:layout_constraintRight_toRightOf="@+id/count_down_bg"
            app:layout_constraintTop_toTopOf="@+id/count_down_bg"/>
        <p151v.VDraweeView
            android:id="@+id/suit_hint_bg"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="17dp"
            android:minWidth="290dp"
            android:minHeight="48dp"
            android:layout_below="@+id/count_down"
            android:layout_centerHorizontal="true"
            app:actualImageScaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/count_down"/>
        <p151v.VText
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/suit_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_below="@+id/count_down"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/suit_hint_bg"
            app:layout_constraintLeft_toLeftOf="@+id/suit_hint_bg"
            app:layout_constraintRight_toRightOf="@+id/suit_hint_bg"
            app:layout_constraintTop_toTopOf="@+id/suit_hint_bg"/>
        <include
            android:id="@+id/suit_item_1"
            android:layout_width="wrap_content"
            android:layout_height="125dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/suit_item_2"
            app:layout_constraintTop_toBottomOf="@+id/suit_hint"
            layout="@layout/live_gift_suit_item_view"/>
        <include
            android:id="@+id/suit_item_2"
            android:layout_width="wrap_content"
            android:layout_height="125dp"
            app:layout_constraintBottom_toBottomOf="@+id/suit_item_1"
            app:layout_constraintLeft_toRightOf="@+id/suit_item_1"
            app:layout_constraintRight_toLeftOf="@+id/suit_item_3"
            app:layout_constraintTop_toTopOf="@+id/suit_item_1"
            layout="@layout/live_gift_suit_item_view"/>
        <include
            android:id="@+id/suit_item_3"
            android:layout_width="wrap_content"
            android:layout_height="125dp"
            app:layout_constraintBottom_toBottomOf="@+id/suit_item_1"
            app:layout_constraintLeft_toRightOf="@+id/suit_item_2"
            app:layout_constraintRight_toLeftOf="@+id/reward_bg"
            app:layout_constraintTop_toTopOf="@+id/suit_item_1"
            layout="@layout/live_gift_suit_item_view"/>
        <p151v.VDraweeView
            android:id="@+id/reward_bg"
            android:layout_width="102dp"
            android:layout_height="125dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/suit_item_1"
            app:layout_constraintLeft_toRightOf="@+id/suit_item_3"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/suit_item_1"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/reward_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toBottomOf="@+id/reward_bg"
            app:layout_constraintLeft_toLeftOf="@+id/reward_bg"
            app:layout_constraintRight_toRightOf="@+id/reward_bg"
            app:layout_constraintTop_toTopOf="@+id/reward_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/safe_area_view"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <include
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_empty_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
