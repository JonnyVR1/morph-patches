<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.customized.result.PrivateCustomResultUserHeaderView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="customized.result.PrivateCustomResultUserHeaderView">
    <RelativeLayout
        android:id="@+id/custom_layout"
        android:background="0x7f081395"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp">
        <RelativeLayout
            android:id="@+id/rl_content"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#f9ecca"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="私人定制速配"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="0sp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#f9ecca"
                android:gravity="bottom"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="根据你的定制需求实时推送，尊享专属社交体验"
                android:layout_below="@+id/title"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="0sp"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="9dp"
            android:src="0x7f0817a4"
            android:layout_toLeftOf="@+id/rl_content"
            android:layout_alignTop="@+id/rl_content"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:src="0x7f0817a5"
            android:layout_toRightOf="@+id/rl_content"
            android:layout_alignTop="@+id/rl_content"/>
    </RelativeLayout>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="244dp"
        android:layout_height="match_parent"
        android:layout_marginTop="114dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:src="0x7f0817a8"
            android:scaleType="centerInside"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="您还没有完成私人定制，请点击右上角进行设置"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.customized.result.PrivateCustomResultUserHeaderView>
