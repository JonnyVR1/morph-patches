<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="other.tipsdialog.LiveTipsDialog">
    <p151v.VFrame
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="37dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            flatten="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="@color/live_black_80_opacity"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="46dp"
                    android:singleLine="true"
                    android:layout_marginStart="33dp"
                    android:layout_marginEnd="33dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/live_black_40_opacity"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="已开启公演请准备好才艺吧"
                    android:singleLine="true"
                    android:layout_marginStart="33dp"
                    android:layout_marginEnd="33dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:id="@+id/follow"
                    android:background="@drawable/live_bg_fe7e1d_r10"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginStart="33dp"
                    android:layout_marginEnd="33dp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_time_countdown"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_desc"
                    app:layout_goneMarginBottom="22dp"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/live_black_40_opacity"
                    android:ellipsize="end"
                    android:id="@+id/tv_time_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="22dp"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/follow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:layout_width="74dp"
            android:layout_height="74dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="2dp"/>
    </p151v.VFrame>
</p151v.VFrame>
