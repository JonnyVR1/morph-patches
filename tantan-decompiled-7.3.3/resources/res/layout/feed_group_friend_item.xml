<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="newui"
    holder="group.groupdetail.module.groupfriend.FeedGroupFriendItem">
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp">
        <p151v.VDraweeView
            android:id="@+id/head"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:roundAsCircle="true"/>
        <View
            android:layout_gravity="bottom|right"
            android:id="@+id/active"
            android:background="@drawable/feed_business_circle_resource"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedLinearWithExtraIconsView
            android:id="@+id/name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fillerIndex="0"
            flatten="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ssdfdfdfdf"
                android:maxLines="1"
                android:lineSpacingExtra="0sp"/>
        </com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedLinearWithExtraIconsView>
        <TextView
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#80000000"
            android:ellipsize="end"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_below="@+id/name_container"
            android:lineSpacingExtra="0sp"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#d74d37"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/attention"
        android:background="@drawable/feed_ui1_follow_btn_white_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="12dp"
        android:text="@string/FOLLOW_STATE_WITHOUT_PLUS"/>
</LinearLayout>
