<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#d3273c"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="promotion.page.ODiamondSpringPromotionPage">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VFrame
                android:background="0x7f081518"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="bottom"
                    android:id="@+id/oDiamond_spring_fire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="41dp"/>
                <p151v.VLinear
                    android:gravity="bottom"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="61dp">
                    <p151v.VImage
                        android:id="@+id/back"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp"
                        android:src="0x7f081275"
                        android:layout_marginStart="8dp"/>
                    <p151v.VImage
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:src="0x7f08127b"/>
                    <p151v.VImage
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081278"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#ffdea2"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/promotion_title1"
                        android:background="0x7f08127a"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="10.5dp"
                        android:text="解锁后配对最高增加20倍"
                        android:paddingHorizontal="15dp"/>
                    <p151v.VLinear
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp">
                        <p151v.VLinear
                            android:orientation="vertical"
                            android:id="@+id/left_item"
                            android:background="0x7f081276"
                            android:layout_width="136dp"
                            android:layout_height="148dp">
                            <p151v.VLinear
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="25dp">
                                <p151v.VText
                                    android:textSize="13sp"
                                    android:textColor="#4b1a0a"
                                    android:gravity="center"
                                    android:id="@+id/promotion_tip_left"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="限时"/>
                                <p151v.VText
                                    android:textSize="18sp"
                                    android:textColor="#4b1a0a"
                                    android:gravity="center"
                                    android:id="@+id/promotion_tip_center"
                                    android:paddingLeft="1dp"
                                    android:paddingRight="1dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="4"
                                    android:paddingHorizontal="1dp"/>
                                <p151v.VText
                                    android:textSize="13sp"
                                    android:textColor="#4b1a0a"
                                    android:gravity="center"
                                    android:id="@+id/promotion_tip_right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="折"/>
                            </p151v.VLinear>
                            <p151v.VText
                                android:textSize="15sp"
                                android:textColor="#4b1a0a"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/month_title"
                                android:layout_width="wrap_content"
                                android:layout_height="21dp"
                                android:layout_marginTop="12dp"/>
                            <p151v.VText
                                android:textSize="32sp"
                                android:textColor="#4b1a0a"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/price_content"
                                android:layout_width="wrap_content"
                                android:layout_height="45dp"/>
                            <p151v.VText
                                android:textSize="15sp"
                                android:textColor="#4b1a0a"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/origin_price_content"
                                android:layout_width="wrap_content"
                                android:layout_height="21dp"/>
                        </p151v.VLinear>
                        <Space
                            android:layout_width="23dp"
                            android:layout_height="0dp"/>
                        <p151v.VLinear
                            android:orientation="vertical"
                            android:id="@+id/right_item"
                            android:background="0x7f081277"
                            android:layout_width="136dp"
                            android:layout_height="148dp">
                            <p151v.VLinear
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="25dp">
                                <p151v.VText
                                    android:textSize="13sp"
                                    android:textColor="#4b1a0a"
                                    android:gravity="center"
                                    android:id="@+id/promotion_tip_left"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="限时"/>
                                <p151v.VText
                                    android:textSize="18sp"
                                    android:textColor="#4b1a0a"
                                    android:gravity="center"
                                    android:id="@+id/promotion_tip_center"
                                    android:paddingLeft="1dp"
                                    android:paddingRight="1dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="6"
                                    android:paddingHorizontal="1dp"/>
                                <p151v.VText
                                    android:textSize="13sp"
                                    android:textColor="#4b1a0a"
                                    android:gravity="center"
                                    android:id="@+id/promotion_tip_right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="折"/>
                            </p151v.VLinear>
                            <p151v.VText
                                android:textSize="15sp"
                                android:textColor="#66ffdea2"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/month_title"
                                android:layout_width="wrap_content"
                                android:layout_height="21dp"
                                android:layout_marginTop="12dp"/>
                            <p151v.VText
                                android:textSize="32sp"
                                android:textColor="#66ffdea2"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/price_content"
                                android:layout_width="wrap_content"
                                android:layout_height="45dp"/>
                            <p151v.VText
                                android:textSize="15sp"
                                android:textColor="#66ffdea2"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/origin_price_content"
                                android:layout_width="wrap_content"
                                android:layout_height="21dp"/>
                        </p151v.VLinear>
                    </p151v.VLinear>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="#66ffdea2"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="32dp"
                        android:text="黑金会员专属"
                        android:drawablePadding="5dp"
                        android:drawableStart="0x7f081279"
                        android:drawableEnd="0x7f081279"/>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="#ffdea2"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="一键配对、查看我的访客\10无限超级喜欢等多项特权"/>
                </p151v.VLinear>
            </p151v.VFrame>
            <p151v.VLinear
                android:gravity="bottom"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="32dp">
                <p151v.VText
                    android:textColor="#4b1a0a"
                    android:gravity="center"
                    android:id="@+id/purchase"
                    android:background="@drawable/core_promotion_o_diamond_spring_get_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"/>
                <p151v.VText
                    android:textColor="#ccffdea2"
                    android:gravity="center"
                    android:id="@+id/promotion_counting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>
                <View
                    android:background="#0dffdea2"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"/>
                <RelativeLayout
                    android:id="@+id/btn_pay_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp">
                    <p151v.VImage
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081514"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ccffdea2"
                        android:gravity="center"
                        android:id="@+id/pay_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支付宝"
                        android:drawablePadding="8dp"
                        android:layout_centerVertical="true"
                        android:lineSpacingExtra="4dp"
                        android:drawableStart="0x7f081515"/>
                </RelativeLayout>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#ccffdea2"
                    android:id="@+id/member_protocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </ScrollView>
</FrameLayout>
