<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="group.GroupCreateTypeViewModel"
    innerClass="true">
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#222222"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_CHOICE_GROUP_TOA"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#a8a8a8"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_CAN_NOT_REWRITE"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/autonym"
                android:background="@drawable/core_group_create_type_item_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="20dp">
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <p151v.VText
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/CHAT_GROUP_TRUE_GROUP"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/CHAT_GROUP_TRUE_GROUP_PIC"/>
                </p151v.VLinear>
                <p151v.VImage
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="13dp"
                    android:src="@drawable/core_group_create_arrow"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/anonymity"
                android:background="@drawable/core_group_create_type_item_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp">
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <p151v.VText
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/CHAT_GROUP_ANONYMOUS_GROUP"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/CHAT_GROUP_ANONYMOUS_GROUP_PIC"/>
                </p151v.VLinear>
                <p151v.VImage
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="13dp"
                    android:src="@drawable/core_group_create_arrow"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VFrame
        android:background="@drawable/core_group_create_actionbar_background"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VImage
            android:id="@+id/actionbar_back"
            android:padding="16dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/core_actionbar_back"/>
    </p151v.VFrame>
</p151v.VFrame>
