<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="square.search"
    holder="LiveSearchRootViewModel">
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include layout="@layout/live_layout_search_empty"/>
        <include layout="@layout/live_layout_search_error"/>
        <p151v.VSearchBar
            android:textColor="@color/live_gray_32"
            android:textColorHint="@color/live_gray_cc"
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="3dp"
            android:hint="@string/LIVE_SEARCH_BAR_PLACEHOLDER"
            android:layout_marginStart="8dp"
            app:searchbar_cancel_behavior="behavior_pin"/>
        <p151v.VRecyclerView
            android:orientation="vertical"
            android:id="@+id/search_lists"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/search_bar"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <ScrollView
            android:id="@+id/history_recent_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/search_bar"
            android:overScrollMode="never"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/history_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VRecyclerView
                        android:orientation="vertical"
                        android:id="@+id/history_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/live_gray_b2"
                        android:gravity="center"
                        android:id="@+id/total_history_tv"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/B_LIVE_SEARCH_ALL_RECORD"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <View
                        android:id="@+id/line"
                        android:background="@color/live_gray_f9"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/recent_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:id="@+id/recent_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/B_LIVE_SEARCH_RECENT_BROWSING"
                        android:layout_marginStart="12dp"/>
                    <com.p051p1.mobile.putong.live.base.view.ScrollRecycleView
                        android:orientation="horizontal"
                        android:id="@+id/recent_lists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</FrameLayout>
