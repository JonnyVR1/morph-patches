<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.giftwalllocal.giftwall.GiftWallPageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    flatten="true"
    folder="virtual.giftwalllocal.giftwall"
    holder="GiftWallPageView">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:id="@+id/gift_wall_enter"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="162dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/middle_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0"
            layout="@layout/live_voice_gift_wall_brief_layout"/>
        <p151v.VLinear
            android:id="@+id/mini_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            flatten="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_all"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_light"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已点亮"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_dark"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未点亮"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </p151v.VLinear>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/empty_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="0x7f0823e0"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center_horizontal"
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="24dp"
                android:text="暂无数据"/>
        </LinearLayout>
        <p151v.VRecyclerView
            android:id="@+id/allRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <p151v.VRecyclerView
            android:id="@+id/lightRecyclerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <p151v.VRecyclerView
            android:id="@+id/darkRecyclerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.virtual.giftwalllocal.giftwall.GiftWallPageView>
