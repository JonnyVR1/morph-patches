<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VScroll
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/hide_card_text"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/LIVE_HIDE_CARD_WEALTH_ICON_TEXT"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                app:layout_constraintEnd_toStartOf="@+id/hide_card_switch"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VSwitchButton
                android:gravity="center"
                android:id="@+id/hide_card_switch"
                android:layout_width="46dp"
                android:layout_height="30dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/hide_card_text"
                app:layout_constraintTop_toTopOf="@+id/hide_card_text"/>
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/hide_profile_text"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/LIVE_HIDE_PROFILE_WEALTH_ICON_TEXT"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                app:layout_constraintEnd_toStartOf="@+id/hide_profile_switch"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hide_card_text"/>
            <p151v.VSwitchButton
                android:gravity="center"
                android:id="@+id/hide_profile_switch"
                android:layout_width="46dp"
                android:layout_height="30dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/hide_profile_text"
                app:layout_constraintTop_toTopOf="@+id/hide_profile_text"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_black_30_opacity"
                android:gravity="start"
                android:id="@+id/hide_wealth_desc_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hide_profile_text"/>
            <p151v.VDraweeView
                android:id="@+id/desc_info_image_view"
                android:layout_width="0dp"
                android:layout_height="640dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hide_wealth_desc_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </p151v.VScroll>
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:leftIcon="0x7f080387"/>
</androidx.constraintlayout.widget.ConstraintLayout>
