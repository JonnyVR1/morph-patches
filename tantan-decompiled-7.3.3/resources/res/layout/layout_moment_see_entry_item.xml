<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.see.MomentSeeEntryItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="1px"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="see.MomentSeeEntryItemView">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VFrame
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="71dp">
            <p151v.VRelative
                android:layout_gravity="center"
                android:background="@drawable/bg_moment_see_entry_item"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">
                <p151v.VImage
                    android:id="@+id/see_heart_image"
                    android:layout_width="20dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="18dp"
                    android:src="0x7f081d33"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#ecae41"
                    android:id="@+id/liked_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_toRightOf="@+id/see_heart_image"
                    android:layout_centerVertical="true"
                    app:typeface="medium"/>
                <p151v.VDraweeView
                    android:id="@+id/user_one_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="14dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/feed_fresco_profile_small"/>
                <p151v.VDraweeView
                    android:id="@+id/user_two_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/user_one_icon"
                    android:layout_centerVertical="true"
                    style="@style/feed_fresco_profile_small"/>
                <p151v.VDraweeView
                    android:id="@+id/user_three_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/user_two_icon"
                    android:layout_centerVertical="true"
                    style="@style/feed_fresco_profile_small"/>
            </p151v.VRelative>
        </p151v.VFrame>
        <View
            android:id="@+id/divider"
            android:background="#f8f7f7"
            android:layout_width="match_parent"
            android:layout_height="15dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.see.MomentSeeEntryItemView>
