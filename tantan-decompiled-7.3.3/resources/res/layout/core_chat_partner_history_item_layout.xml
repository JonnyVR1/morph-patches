<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/core_chat_partner_history_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginVertical="6dp">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:layout_gravity="top"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="11.30 14:20"/>
    </p151v.VLinear>
    <p151v.VDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="54dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:dividerColor="#08000000"
        app:dividerOrientation="horizontal"/>
    <p151v.VRecyclerView
        android:orientation="horizontal"
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="71dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:id="@+id/describe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="111dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"/>
</p151v.VFrame>
