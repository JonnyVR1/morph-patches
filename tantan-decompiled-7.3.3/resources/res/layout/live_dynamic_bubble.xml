<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common.dynamic.bubble.item"
    holder="DynamicBubbleItem">
    <p151v.VDraweeView
        android:id="@+id/head"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#ffef5d"
        android:gravity="center_horizontal"
        android:id="@+id/count"
        android:background="@drawable/live_shape_bg_anchor_user_bubble"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginLeft="27dp"
        app:layout_constraintBottom_toBottomOf="@+id/head"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white"
        android:id="@+id/content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxWidth="208dp"
        app:layout_constraintBottom_toBottomOf="@+id/head"
        app:layout_constraintLeft_toRightOf="@+id/count"
        app:layout_constraintTop_toTopOf="@+id/head"/>
    <View
        android:layout_width="16dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toRightOf="@+id/content"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
