<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetCpHeadView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="335dp"
    android:layout_height="100dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetCpHeadView">
    <p151v.VDraweeView
        android:id="@+id/drawee_bg"
        android:background="0x7f082784"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VDraweeView
        android:id="@+id/drawee_house"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_centerInParent="true"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VImage
        android:id="@+id/left_heart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dp"
        android:src="0x7f082833"
        android:layout_toLeftOf="@+id/drawee_house"
        android:layout_centerVertical="true"/>
    <p151v.VImage
        android:id="@+id/right_heart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:src="0x7f082833"
        android:layout_toRightOf="@+id/drawee_house"
        android:layout_centerVertical="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_left"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="6dp"
        android:layout_toLeftOf="@+id/left_heart"
        android:layout_centerVertical="true"
        app:roundAsCircle="true"
        app:roundingBorderColor="#ffffff"
        app:roundingBorderWidth="1.5dp"/>
    <p151v.VImage
        android:id="@+id/left_default"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="6dp"
        android:src="0x7f082785"
        android:layout_toLeftOf="@+id/left_heart"
        android:layout_centerVertical="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_right"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="6dp"
        android:layout_toRightOf="@+id/right_heart"
        android:layout_centerVertical="true"
        app:roundAsCircle="true"
        app:roundingBorderColor="#ffffff"
        app:roundingBorderWidth="1.5dp"/>
    <p151v.VImage
        android:id="@+id/right_default"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="6dp"
        android:src="0x7f082785"
        android:layout_toRightOf="@+id/right_heart"
        android:layout_centerVertical="true"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/house_name"
        android:background="0x7f082839"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSC-Medium"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetCpHeadView>
