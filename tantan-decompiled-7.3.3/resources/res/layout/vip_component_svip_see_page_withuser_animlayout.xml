<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.SvipDlgSeeAnimLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="purchase.privilege.SvipDlgSeeAnimLayout">
    <p151v.VDraweeView
        android:id="@+id/head"
        android:background="0x7f082a88"
        android:padding="14dp"
        android:layout_width="115dp"
        android:layout_height="115dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#f36c4e"
        android:gravity="center"
        android:id="@+id/hello"
        android:background="0x7f081677"
        android:paddingLeft="8dp"
        android:paddingRight="11dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="112dp"
        android:text="@string/SEE_PURCHASE_PAGE_PICTURE_HI"
        app:layout_constraintRight_toRightOf="@+id/head"
        app:layout_constraintTop_toTopOf="@+id/head"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#f36c4e"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_desc"
        android:background="0x7f081677"
        android:paddingLeft="8dp"
        android:paddingRight="11dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="14dp"
        android:maxWidth="85dp"
        android:text="20岁,女生"
        android:maxLines="1"
        app:layout_constraintRight_toRightOf="@+id/hello"
        app:layout_constraintTop_toBottomOf="@+id/hello"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#f36c4e"
        android:gravity="center"
        android:id="@+id/distance"
        android:background="0x7f081678"
        android:paddingLeft="11dp"
        android:paddingRight="8dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginLeft="112dp"
        android:layout_marginTop="25dp"
        android:maxWidth="85dp"
        android:text="离你10km"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/head"
        app:layout_constraintTop_toTopOf="@+id/head"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#f36c4e"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/job"
        android:background="0x7f081678"
        android:paddingLeft="11dp"
        android:paddingRight="8dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="14dp"
        android:maxWidth="85dp"
        android:text="学生"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/distance"
        app:layout_constraintTop_toBottomOf="@+id/distance"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.SvipDlgSeeAnimLayout>
