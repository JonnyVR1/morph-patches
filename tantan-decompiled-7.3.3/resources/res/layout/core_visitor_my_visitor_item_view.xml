<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.myvisitors.MyVisitorsItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    holder="visitor.myvisitors.MyVisitorsItemView">
    <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
        android:id="@+id/profile"
        android:layout_width="69dp"
        android:layout_height="69dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="6dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:maxLines="1"
            android:lines="1"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_02"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </p151v.VLinear>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffdea2"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/action"
        android:background="@drawable/core_visitor_my_visitor_item_button_hide"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="12dp"/>
</com.p051p1.mobile.putong.core.p058ui.visitor.myvisitors.MyVisitorsItemView>
