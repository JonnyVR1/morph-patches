<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="330dp"
    flatten="true"
    folder="increment"
    holder="gift.notice.BottomNoticeWindowDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="330dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/root"
            android:background="@drawable/live_bg_191919_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="18dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="66dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#8c8c8e"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:layout_marginTop="15dp">
                <FrameLayout
                    android:id="@+id/one"
                    android:background="@drawable/live_bg_white_r16_a03"
                    android:layout_width="105dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="10dp">
                    <p151v.VDraweeView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/one_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="normal"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/one_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="66dp"
                        android:maxLines="1"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/two"
                    android:background="@drawable/live_bg_white_r16_a03"
                    android:layout_width="105dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="10dp">
                    <p151v.VDraweeView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/two_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="normal"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/two_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="66dp"
                        android:maxLines="1"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/three"
                    android:background="@drawable/live_bg_white_r16_a03"
                    android:layout_width="105dp"
                    android:layout_height="match_parent">
                    <p151v.VDraweeView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/three_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="normal"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/three_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="66dp"
                        android:maxLines="1"/>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/button"
                android:background="@drawable/live_bg_ff8817_r14"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="20dp"/>
        </LinearLayout>
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:background="@drawable/live_bg_19191e_oval"
            android:padding="1dp"
            android:layout_width="74dp"
            android:layout_height="74dp"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="14dp"
            android:src="0x7f082250"/>
    </FrameLayout>
</LinearLayout>
