<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.common.gameoperation.IntlGameOperationView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="invisible"
    android:layout_width="70dp"
    android:layout_height="70dp"
    flatten="true"
    holder="intl.common.gameoperation.IntlGameOperationView">
    <p151v.VPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="3dp"
        android:overScrollMode="never"/>
    <p151v.VImage
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/live_shape_circle_red_dot"/>
</com.p051p1.mobile.putong.live.external.intl.common.gameoperation.IntlGameOperationView>
