<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="visitor.visitorsme.VisitorsMeViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/visitors_ll"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VPullDownRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srlEnableLoadMore="false"
            flatten="true">
            <p151v.VPullUpRecyclerView
                android:id="@+id/visitors"
                android:paddingTop="7dp"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                useId="true"/>
        </p151v.VPullDownRefreshLayout>
    </p151v.VLinear>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/privilege"
        android:background="@drawable/core_visitors_privilege_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="164dp"
        flatten="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/get_privilege"
            android:background="@drawable/core_visitors_privilege_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="31dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#ffdea2"
                android:gravity="center_horizontal"
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开通黑金会员"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#99ffdea2"
                android:gravity="center_horizontal"
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一键解锁我的访客"
                android:lineSpacingExtra="1sp"/>
        </LinearLayout>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:paddingBottom="50dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:id="@+id/empty_img"
            android:layout_width="220dp"
            android:layout_height="150dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#36000000"
            android:gravity="center"
            android:id="@+id/empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
    </p151v.VLinear>
    <p151v.VRelative
        android:gravity="center_horizontal"
        android:id="@+id/no_permission"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/permission_img"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="134dp"
            android:src="0x7f0819db"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_e6000000"
            android:id="@+id/permission_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/permission_img"
            android:layout_centerHorizontal="true"
            android:fontFamily="PingFangSc-Medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:gravity="center_horizontal"
            android:id="@+id/permission_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/permission_subtitle"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="15dp"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/core_color_f9f9f9"
            android:gravity="center"
            android:id="@+id/permission_btn"
            android:background="@drawable/core_visitor_setting_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:layout_alignParentBottom="true"/>
    </p151v.VRelative>
    <FrameLayout
        android:id="@+id/filter_bar_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <View
            android:id="@+id/filter_bar_foreground"
            android:background="#80000000"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_gravity="top"
            android:id="@+id/filter_bar"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_visitors_filter_bar"/>
    </FrameLayout>
</FrameLayout>
