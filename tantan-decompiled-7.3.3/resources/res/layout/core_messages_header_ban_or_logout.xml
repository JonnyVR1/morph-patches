<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/head_root"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    flatten="true"
    holder="messages.model.inner.MessageBanOrLogoutUserHeaderViewModel">
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/header_loading"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        app:cpb_colors="@array/core_loading_colors"/>
    <FrameLayout
        android:id="@+id/default_header_content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/self_introduction"
            android:paddingTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="18dp"
            flatten="true">
            <include
                android:id="@+id/date_header"
                layout="@layout/messages_item_date_header"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/message_user_header_layout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/image_small"
                    android:layout_width="?attr/message_page_profile_pic_size"
                    android:layout_height="?attr/message_page_profile_pic_size"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="4dp"
                    style="@style/core_im_fresco_profile_small"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/profile_bubble"
                    android:layout_width="216dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    flatten="true"
                    style="@style/messages_item_left">
                    <FrameLayout
                        android:id="@+id/layout_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <p151v.VDraweeView
                            android:id="@+id/profile_image"
                            android:layout_width="match_parent"
                            android:layout_height="216dp"
                            app:roundBottomLeft="true"
                            app:roundBottomRight="true"
                            app:roundTopLeft="true"
                            app:roundTopRight="true"
                            app:roundedCornerRadius="5dp"/>
                        <p151v.VLinear
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:background="@drawable/core_message_aboutme_oniv_bg_ban_or_logout"
                            android:paddingLeft="12dp"
                            android:paddingTop="11dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <p151v.VText
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:ellipsize="end"
                                android:id="@+id/tv_about_me_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:includeFontPadding="false"
                                android:layout_weight="1"/>
                        </p151v.VLinear>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <p151v.VText
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/svip_match_from_boost"
                android:background="@drawable/core_messages_message_date_header"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/SVIP_MATCH_FROM_BOOST"
                app:typeface="regular"
                style="@style/core_messages_date_header"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
