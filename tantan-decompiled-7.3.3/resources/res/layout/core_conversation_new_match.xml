<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationMatchItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    folder="newui"
    holder="messages.ConversationMatchItemLayout">
    <p151v.VFrame
        android:id="@+id/new_match_layout"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="115dp"
        flatten="true">
        <p151v.VFrame
            android:clipChildren="false"
            android:layout_width="115dp"
            android:layout_height="115dp">
            <View
                android:id="@+id/bg_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <p151v.VDraweeView
                android:id="@+id/me_head"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="22dp"
                android:layout_marginStart="19dp"
                style="@style/core_special_like_avatar"/>
            <p151v.VFrame
                android:layout_gravity="right"
                android:id="@+id/other_other_layout"
                android:visibility="visible"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="15dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/other_other_head"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:scaleType="centerCrop"
                    style="@style/core_special_like_avatar"/>
                <View
                    android:background="@drawable/core_bg_head_match"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_gravity="right"
                android:id="@+id/other_head_layout"
                android:visibility="visible"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="15dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/other_head"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:scaleType="centerCrop"
                    style="@style/core_special_like_avatar"/>
                <View
                    android:background="@drawable/core_bg_head_match"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="end|top"
                    android:id="@+id/unread_dot"
                    android:background="@drawable/core_fun_right_icon_dot"
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_margin="4dp"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_gravity="center_horizontal"
                android:id="@+id/new_head_layout"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="13dp">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:background="@drawable/core_default_head_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/core_special_like_avatar"/>
                <p151v.VFrame
                    android:layout_gravity="bottom"
                    android:id="@+id/chat_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-2dp"
                    flatten="true">
                    <p151v.VImage
                        android:layout_gravity="bottom|center_horizontal"
                        android:id="@+id/chat_label_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080948"/>
                    <p151v.VText
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:layout_gravity="bottom|center_horizontal"
                        android:id="@+id/chat_label_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="即刻闪聊"/>
                </p151v.VFrame>
            </p151v.VFrame>
            <com.p051p1.mobile.putong.core.newui.view.LightningView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ff8231"
                android:ellipsize="end"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/match_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="14dp"
                android:text="你有1个新配对"
                android:singleLine="true"
                app:enableEmojis="true"
                app:typeface="medium"/>
        </p151v.VFrame>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.newui.messages.ConversationMatchItemLayout>
