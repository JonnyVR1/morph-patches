<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="photoalbum.photoalbumactivities.tab.FeedActivitiesFragViewModel">
    <p151v.VPullDownRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false"
        flatten="true">
        <p151v.VRecyclerView
            android:scrollbarThumbVertical="@drawable/feed_activity_scroll_bg"
            android:id="@+id/comments"
            android:scrollbars="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            useId="true"/>
    </p151v.VPullDownRefreshLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/empty_img"
            android:layout_width="210dp"
            android:layout_height="150dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#26000000"
            android:gravity="center"
            android:id="@+id/empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/post_feed_tv"
            android:background="@drawable/feed_bg_rounded_fe7e1d"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="20dp"
            android:text="去发布"/>
    </p151v.VLinear>
</p151v.VFrame>
