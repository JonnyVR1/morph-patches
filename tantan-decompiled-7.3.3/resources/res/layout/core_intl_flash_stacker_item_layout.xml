<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/setting_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="intloperation.flash.FlashStickerAdapter">
    <p151v.VDraweeView
        android:id="@+id/setting_bg_img"
        android:background="@drawable/core_intl_like_minded_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/common_black_04"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="24dp"/>
    <p151v.VDraweeView
        android:id="@+id/setting_img"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toTopOf="@+id/setting_content_title"
        app:layout_constraintDimensionRatio="W,280:230"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/core_color_333333"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/setting_content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6634"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_999999"
        android:gravity="center"
        android:id="@+id/setting_content_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:minLines="2"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:elevation="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_content_title"
        app:layout_constraintWidth_percent="0.717"
        app:typeface="regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
