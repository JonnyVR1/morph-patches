<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="gift.panel.NewGiftPanelViewModel">
    <include
        android:id="@+id/gift_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-351dp"
        android:layout_marginBottom="351dp"
        layout="@layout/core_gift_layer"/>
    <FrameLayout
        android:id="@+id/bg"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="351dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/gift_tip"
            android:background="@drawable/core_gift_newpanel_tip"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="8dp"
            android:text="这是女生们最中意的礼物"
            android:maxLines="1"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom"
        android:background="@drawable/core_gift_newui_newpanel_bottom_bg"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="351dp"
        flatten="true">
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="visible"
            android:layout_marginBottom="24dp"
            style="@style/core_loading_block"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="16dp">
                <p151v.VDraweeView
                    android:id="@+id/gift_ic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="送个礼物更容易被回复哦"
                    android:layout_weight="1"
                    android:lineSpacingExtra="0sp"/>
                <p151v.VFrame
                    android:layout_gravity="center"
                    android:id="@+id/charge"
                    android:background="@drawable/core_gift_newpanel_charge_bg"
                    android:layout_width="69dp"
                    android:layout_height="33dp">
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ff5435"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="充值"
                        android:drawableLeft="0x7f0806e4"
                        android:drawablePadding="4dp"/>
                </p151v.VFrame>
            </LinearLayout>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#99212121"
                android:id="@+id/subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                layout="@layout/core_gift_newpanel_tab"/>
            <p151v.VPager
                android:layout_gravity="top"
                android:id="@+id/pager"
                android:background="@color/transparent"
                android:clipChildren="false"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-5dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
