<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="0x7f082774"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView
        android:id="@+id/iv_top"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f082777"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/tv_top_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/tv_top_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_name"/>
    <p151v.VImage
        android:id="@+id/iv_center_bg"
        android:layout_width="317dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="29dp"
        android:src="0x7f082775"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="21dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_bottom_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_desc"/>
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_center_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_center_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_center_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_center_bg"
        app:roundedCornerRadius="12dp"/>
    <View
        android:id="@+id/bottom_bg"
        android:background="@drawable/live_shape_bg_08000000_00000000_r12"
        android:layout_width="0dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"/>
    <View
        android:id="@+id/top_bg"
        android:background="@drawable/live_shape_bg_4d000000_00000000_r12"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_online"
        android:background="@drawable/live_bg_white_r5_a20"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="12dp"
        android:text="在麦上"
        android:drawablePadding="3dp"
        android:drawableStart="@drawable/live_shape_bg_68de48_oval"
        android:paddingStart="3dp"
        android:paddingEnd="5dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_follow_state"
        android:background="@drawable/live_bg_ff8255_r5"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="1dp"
        android:drawablePadding="3dp"
        android:layout_marginStart="4.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_online"
        app:layout_constraintStart_toEndOf="@+id/tv_online"
        app:layout_constraintTop_toTopOf="@+id/tv_online"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="40dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_user_info"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/avatar"/>
    <p151v.VImage
        android:id="@+id/iv_authentication"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f082776"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_user_name"
        app:layout_constraintStart_toEndOf="@+id/tv_user_name"
        app:layout_constraintTop_toTopOf="@+id/tv_user_name"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:id="@+id/tv_user_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/line"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"/>
    <p151v.VLine
        android:id="@+id/line"
        android:background="#19ffffff"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_bottom_desc"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:id="@+id/tv_bottom_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e89e4d"
        android:gravity="center"
        android:id="@+id/tv_bottom_button"
        android:background="@drawable/live_bg_white_r10"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
