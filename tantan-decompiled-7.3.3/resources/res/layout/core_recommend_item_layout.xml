<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationRecommendItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/online_item"
    android:background="@drawable/common_card_bg_medium_02"
    android:clipChildren="false"
    android:layout_width="100dp"
    android:layout_height="115dp"
    folder="newui"
    holder="messages.ConversationRecommendItemView">
    <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:clickable="true"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="3dp"
        app:show_audio_chat_frame="true"/>
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/head_layout"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VRelative
            android:layout_gravity="center_horizontal"
            android:id="@+id/vre_online_match"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="3dp">
            <com.p051p1.mobile.putong.core.newui.talk.view.NewTalkProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
            <p151v.VDraweeView
                android:id="@+id/image2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:cropToPadding="false"
                android:layout_centerInParent="true"
                app:roundAsCircle="true"
                style="@style/core_fresco_profile_small"/>
        </p151v.VRelative>
        <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_avatar"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="3dp"
            app:avatarSize="48dp"
            app:haloSize="60dp"/>
        <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
            android:id="@+id/astigmatism_anim"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:avatarSize="48dp"
            app:haloSize="66dp"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/chat_red_dot"
            android:background="@drawable/core_bg_chat_red_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/chat_online_dot"
            android:background="@drawable/core_bg_chat_online_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"/>
        <p151v.VFrame
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/chat_label"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/chat_label_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080948"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/chat_label_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="即刻闪聊"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_66000000"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/txt"
        android:background="@drawable/core_default_txt_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationRecommendItemView>
