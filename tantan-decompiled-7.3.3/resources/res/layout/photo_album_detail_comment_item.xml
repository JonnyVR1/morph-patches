<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumCommentDetailsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.PhotoAlbumCommentDetailsView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="15dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="50dp">
        <FrameLayout
            android:id="@+id/pic_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/pic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                style="@style/feed_fresco_profile_small"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/pic_verification"
                android:background="0x7f081e18"
                android:visibility="invisible"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:id="@+id/comment_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toRightOf="@+id/pic_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#212121"
            android:id="@+id/comment_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintLeft_toLeftOf="@+id/comment_name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/comment_name"
            app:typeface="regular"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/sticker_content"
            android:background="@drawable/feed_comment_media_bg"
            android:visibility="gone"
            android:layout_width="122dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:layout_constraintLeft_toLeftOf="@+id/comment_name"
            app:layout_constraintTop_toBottomOf="@+id/comment_text"
            flatten="false">
            <p151v.VDraweeView
                android:orientation="horizontal"
                android:id="@+id/sticker"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:actualImageScaleType="fitCenter"
                app:fadeDuration="0"
                app:failureImageScaleType="center"
                app:placeholderImageScaleType="center"
                app:roundedCornerRadius="10dp"/>
        </RelativeLayout>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#bfbfbf"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintLeft_toLeftOf="@+id/comment_name"
            app:layout_constraintTop_toBottomOf="@+id/sticker_content"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:text="@string/JOIN_REPLY"
            app:layout_constraintLeft_toRightOf="@+id/time"
            app:layout_constraintTop_toTopOf="@+id/time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumCommentDetailsView>
