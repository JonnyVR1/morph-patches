<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemTitleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.itemview.ConversationItemTitleView">
    <p151v.VLinear_FillerMeasure
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:layout_marginRight="8dp"
        android:layout_weight="100"
        app:fillerIndex="0">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/title_big"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                app:enableEmojis="true"
                app:typeface="medium"/>
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/emoji"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/pic_tag_big"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginRight="4dp">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/pic_verify_logo"
                android:background="0x7f082957"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:scaleType="fitCenter"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/pic_birthday"
                android:background="@drawable/core_message_ic_birthday"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="4dp"
                android:scaleType="fitCenter"/>
            <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                android:layout_gravity="center"
                android:id="@+id/odiamond_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginBottom="1dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/svip_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/pic_chat_temp"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:scaleType="fitCenter"/>
            <p151v.VText
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_03"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/recover_countdown"
                android:background="@drawable/core_conversation_item_trial_see_countdown_bg_using"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:maxLines="1"
                android:layout_marginStart="3dp"
                android:paddingHorizontal="5dp"
                app:typeface="medium"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/close_friend"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:src="0x7f080745"
                android:scaleType="fitCenter"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/compliment_tag"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/core_ic_compliment_tag"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </p151v.VLinear_FillerMeasure>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_color_4d000000"
        android:layout_gravity="right"
        android:id="@+id/time_big"
        android:paddingTop="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemTitleView>
