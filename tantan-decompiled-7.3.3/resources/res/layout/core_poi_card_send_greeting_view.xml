<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardSendGreetView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/core_poi_card_send_greeting_view_bg"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    flatten="true"
    folder="newui"
    holder="poi.view.FeedPoiCardSendGreetView">
    <p151v.VDraweeView
        android:id="@+id/greet_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#26000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/envelop_say_hai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="真诚打招呼，更容易收到回复"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="8dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_ffc318"
        android:id="@+id/send_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/FEED_GREETING"
        android:layout_marginEnd="16dp"/>
</com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardSendGreetView>
