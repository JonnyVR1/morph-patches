<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.module.PkMenuModule">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_tr8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/title_container_view"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08247a"
                android:text="@string/LIVE_CONNECT_TO_PK"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/iv_show_help"
                android:padding="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:src="0x7f082466"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/broadcast_container_view"
            android:background="#33ffbb00"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="6dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f082450"/>
            <include
                android:layout_gravity="center_vertical"
                android:id="@+id/scroll_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                flatten="true"
                layout="@layout/live_pk_up_down_scroll_view_layout"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="182dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/pk_seek"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_gravity="center"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/iv_pk_seek"
                        android:background="0x7f082499"
                        android:layout_width="88dp"
                        android:layout_height="88dp"/>
                    <p151v.VImage
                        android:layout_gravity="top|right"
                        android:id="@+id/iv_pk_bounty_logo"
                        android:visibility="visible"
                        android:layout_width="48dp"
                        android:layout_height="17dp"
                        android:layout_marginTop="2dp"
                        android:src="0x7f08244e"
                        android:layout_marginEnd="-2dp"/>
                </FrameLayout>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#f57c00"
                    android:layout_gravity="center"
                    android:id="@+id/tv_pk_seek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/LIVE_PK_SEEKING_TITLE"
                    android:singleLine="true"/>
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:layout_gravity="center"
                    android:id="@+id/tv_pk_win_times"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/LIVE_PK_SEEK_WINTIMES"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/pk_invite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_gravity="center"
                    android:layout_width="88dp"
                    android:layout_height="88dp">
                    <p151v.VImage
                        android:id="@+id/iv_invite_friend"
                        android:background="0x7f082469"
                        android:layout_width="88dp"
                        android:layout_height="88dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="normal"
                        android:textColor="@color/white"
                        android:gravity="center_horizontal"
                        android:layout_gravity="top|right"
                        android:id="@+id/tv_friend_num"
                        android:background="@drawable/live_shape_pk_friend_num_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginRight="6dp"/>
                </FrameLayout>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#923bff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_invite_friend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/LIVE_FRIENDS_PK"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
