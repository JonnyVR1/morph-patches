<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/boost_guide_svga"
        android:layout_width="273dp"
        android:layout_height="273dp"
        android:layout_marginStart="-42dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/top_fl"
        android:background="@drawable/bg_dialog_new_boost_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="129dp">
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/right_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f080e7f"
            android:scaleType="center"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:layout_marginStart="37dp"
            android:layout_marginEnd="40dp">
            <p151v.VImage
                android:id="@+id/boost_guide_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080e7e"
                android:alpha="127"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#88ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加速配对·全新上线"
                android:layout_marginStart="3dp"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="24sp"
            android:textColor="#ccffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="30分钟内无限右滑，\10获得最高10倍新配对！"
            android:lineSpacingExtra="3dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8a7acb"
            android:gravity="center"
            android:id="@+id/open"
            android:background="@drawable/core_member_button_bg_white_normal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="33dp"
            android:layout_marginBottom="48dp"
            android:text="立即获取"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </p151v.VLinear>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/boost_guide_content_svga"
        android:background="0x7f080e7d"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="78dp"
        android:layout_marginStart="36dp"/>
</p151v.VFrame>
