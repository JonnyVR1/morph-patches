<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.PaymentModeChooseSheet">
    <p151v.VHandleBar
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/payment_mode_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="26dp"
        android:text="@string/VIP_PAYMENT_TITLE"/>
    <p151v.VLine
        android:id="@+id/top_line"
        style="@style/common_line"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/payment_mode_alipay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_alipay_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:src="0x7f08194a"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_alipay_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:text="@string/VIP_PAYMENT_ALIPAY"
            android:lines="1"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_alipay_promotion"
            android:background="@drawable/core_vip_payment_mode_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:enabled="false"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_alipay_checkbox"
            android:clickable="false"
            android:layout_marginRight="20dp"
            style="@style/core_payment_page_checkbox"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/payment_mode_wechat"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_wechat_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:src="0x7f08194c"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_wechat_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:text="@string/VIP_PAYMENT_WECHAT"
            android:lines="1"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_wechat_promotion"
            android:background="@drawable/core_vip_payment_mode_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:enabled="false"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_wechat_checkbox"
            android:clickable="false"
            android:layout_marginEnd="20dp"
            style="@style/core_payment_page_checkbox"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/payment_mode_jingdong"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_jingdong_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:src="0x7f08194b"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_jingdong_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:text="京东支付"
            android:lines="1"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_jingdong_promotion"
            android:background="@drawable/core_vip_payment_mode_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:text="随机立减最高8元"
            android:maxLines="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VCheckBox
            android:enabled="false"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_jingdong_checkbox"
            android:clickable="false"
            android:layout_marginEnd="20dp"
            style="@style/core_payment_page_checkbox"/>
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <p151v.VLine
        android:id="@+id/bottom_line"
        style="@style/common_line"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ACTION_CANCEL"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
</LinearLayout>
