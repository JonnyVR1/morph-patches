<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui">
    <p151v.VDraweeView
        android:id="@+id/attitude_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:placeholderImage="@color/white"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/feed_33000000"
        android:id="@+id/name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="吃瓜"/>
</p151v.VLinear>
