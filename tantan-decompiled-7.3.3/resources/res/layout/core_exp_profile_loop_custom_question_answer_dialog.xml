<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:id="@+id/back"
        android:background="0x7f08033d"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="56dp"
        android:layout_marginRight="40dp">
        <p151v.VText
            android:textSize="24dp"
            android:textColor="@color/common_exp_black_01"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="写下你的回答"/>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/core_marry_edit_profile_multiple_item_bg"
            android:paddingLeft="16dp"
            android:paddingTop="17dp"
            android:paddingRight="12dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="56dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:maxLines="2"
                android:layout_weight="1"
                android:paddingEnd="12dp"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VEditText
                android:textSize="16dp"
                android:textColor="@color/common_exp_black_01"
                android:textColorHint="@color/common_exp_black_03"
                android:gravity="top|left"
                android:id="@+id/edit_view"
                android:background="@drawable/exp_profile_loop_text_type_bg"
                android:paddingLeft="16dp"
                android:paddingTop="20dp"
                android:paddingRight="16dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"/>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/common_000000_20"
                android:layout_gravity="bottom|right"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="20dp"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VButton
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/next_btn"
            android:background="@drawable/common_exp_button_btn_orange_small"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/ACTION_NEXT"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"/>
    </FrameLayout>
</FrameLayout>
