<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemGuideAuthentication xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemGuideAuthentication">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/core_new_messages_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="15dp">
            <p151v.VImage
                android:id="@+id/icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="0x7f080f08"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_msg_cell_left_text_color"
                    android:gravity="left"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="让相处更安心"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="对方暂未完成认证，可以邀请他完成真人认证，让聊天更安心"
                    android:lineSpacingExtra="2dp"
                    app:typeface="regular"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <FrameLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#fe7e1d"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/autentication"
                android:background="@drawable/core_bg_10_ffffff"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:typeface="medium"/>
        </FrameLayout>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemGuideAuthentication>
