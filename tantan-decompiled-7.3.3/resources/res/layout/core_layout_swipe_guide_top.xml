<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/core_card_shadow_cover_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VRelative
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/core_swipe_guide_top_hand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08185a"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/core_swipe_guide_top_hand"
            android:layout_centerHorizontal="true">
            <p151v.VText
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/swipe_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CARD_UP_SWIPE_GUIDE_TITLE"/>
            <p151v.VText
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#54c7fc"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CARD_UP_SWIPE_GUIDE_SUBTITLE"/>
        </LinearLayout>
    </p151v.VRelative>
</p151v.VRelative>
