<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_tool_bar"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    flatten="true"
    holder="profile.views.HomeCardTopNameViewBar">
    <p151v.VLinear_FillerMeasure
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/name_container"
        android:paddingTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp"
        app:fillerIndex="0"
        flatten="true">
        <p151v.VText
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/common_exp_black_01"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/name_tv"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:singleLine="true"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/avatar_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"/>
        <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
            android:layout_gravity="center"
            android:id="@+id/odiamond_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/img_vip"
            android:paddingLeft="4dp"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="20dp"/>
    </p151v.VLinear_FillerMeasure>
</LinearLayout>
