<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.addressbook.ConversationAddressBookGroupView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.ConversationAddressBookGroupView">
    <p151v.VFrame
        android:layout_gravity="center_vertical"
        android:id="@+id/head"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <com.p051p1.mobile.putong.p070ui.MultipleChatIconView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:failureImage="@color/white"
            app:placeholderImage="@color/white"
            style="@style/fresco_profile_small"/>
    </p151v.VFrame>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="marquee"
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#4d000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/verification"
                android:background="@drawable/core_address_book_group_icon_bg"
                android:layout_width="35dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:id="@+id/des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lines="1"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.newui.messages.addressbook.ConversationAddressBookGroupView>
