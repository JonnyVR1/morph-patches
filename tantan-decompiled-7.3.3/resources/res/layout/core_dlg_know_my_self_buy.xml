<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VHandleBar
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/core_biz_text_e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="探探币支付"/>
        <p151v.VRelative
            android:background="@drawable/core_biz_bg_dlg_know_my_self"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#fe7e1d"
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="84"
                android:layout_centerVertical="true"
                android:layout_marginStart="18dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#fe7e1d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="探探币"
                android:layout_toRightOf="@+id/tv_amount"
                android:layout_alignBaseline="@+id/tv_amount"
                android:layout_marginStart="5dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#a4a4a4"
                android:id="@+id/tv_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="余额：12 探探币"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="18dp"/>
        </p151v.VRelative>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_affirm"
            android:background="@drawable/core_biz_button_btn_new_fe7e1d"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="20dp"
            android:text="确认支付"
            android:layout_marginHorizontal="20dp"
            android:paddingVertical="17dp"/>
    </p151v.VLinear>
</p151v.VLinear>
