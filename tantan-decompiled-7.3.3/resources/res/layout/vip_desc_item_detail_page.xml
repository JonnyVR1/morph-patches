<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.VipItemDetailPage xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.VipItemDetailPage">
    <include layout="@layout/vip_item_detail_content"/>
    <androidx.legacy.widget.Space
        android:id="@+id/button_top_space"
        android:layout_width="wrap_content"
        android:layout_height="40dp"/>
    <p151v.VButton
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/get"
        android:background="@drawable/rect_rounded_tantan_gradient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/VIP_BOOST_PURCHASE_IMMEDIATELY"
        app:typeface="regular"
        style="@style/v_button"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/text_medium"
        android:gravity="center"
        android:id="@+id/dismiss"
        android:background="@drawable/tf_rect_rounded_light"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ACTION_GOT_IT"/>
</com.p051p1.mobile.putong.core.p058ui.vip.VipItemDetailPage>
