<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.rights.niceNumber.view.RightNiceNumberView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="page"
    holder="rights.niceNumber.view.RightNiceNumberView">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="57dp"
        android:text="@string/LIVE_USER_RIGHT_NOBLE_NICE_NUMBER_TITLE"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="start|center_vertical"
        android:id="@+id/current_num"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="57dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/arrow"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f0826d3"
        android:scaleType="fitXY"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/current_num"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="start|center_vertical"
        android:id="@+id/next_num"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="57dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/arrow"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/refresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f0826d4"
        android:scaleType="fitXY"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <include
        android:id="@+id/number_one"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/number_two"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        layout="@layout/live_user_right_nice_number_view_list_item_view"/>
    <include
        android:id="@+id/number_two"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/number_one"
        app:layout_constraintTop_toBottomOf="@+id/title"
        layout="@layout/live_user_right_nice_number_view_list_item_view"/>
    <include
        android:id="@+id/number_three"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="11dp"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/number_four"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/number_one"
        layout="@layout/live_user_right_nice_number_view_list_item_view"/>
    <include
        android:id="@+id/number_four"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/number_three"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/number_three"
        app:layout_constraintTop_toTopOf="@+id/number_three"
        layout="@layout/live_user_right_nice_number_view_list_item_view"/>
    <include
        android:id="@+id/number_five"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="11dp"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/number_six"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/number_three"
        layout="@layout/live_user_right_nice_number_view_list_item_view"/>
    <include
        android:id="@+id/number_six"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/number_five"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/number_five"
        app:layout_constraintTop_toTopOf="@+id/number_five"
        layout="@layout/live_user_right_nice_number_view_list_item_view"/>
</com.p051p1.mobile.putong.live.external.page.rights.niceNumber.view.RightNiceNumberView>
