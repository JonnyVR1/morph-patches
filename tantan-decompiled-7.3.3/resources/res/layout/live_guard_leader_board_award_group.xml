<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.LiveGuardBoardAwardGroup xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment"
    holder="knight.view.leaderboard.LiveGuardBoardAwardGroup">
    <View
        android:id="@+id/reward_bg"
        android:background="@drawable/live_bg_3253e1_r12_a20"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/reward_title"
        app:layout_constraintTop_toTopOf="@+id/reward_title"/>
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#bbc9ff"
        android:gravity="center_horizontal"
        android:id="@+id/reward_title"
        android:paddingTop="4dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_GUARD_EVERYDAY_REWARDS"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="@+id/reward_bg"
        app:layout_constraintStart_toStartOf="@+id/reward_bg"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.LiveGuardBoardAwardGroup>
