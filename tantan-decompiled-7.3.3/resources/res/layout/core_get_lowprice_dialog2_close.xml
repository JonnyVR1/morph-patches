<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecall2Dialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/layout"
    android:background="#00000000"
    android:clickable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    holder="pricerecall.PriceRecall2Dialog">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/common_view_popup_bg"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="0x7f080724"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="-12dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"/>
        <p151v.VText
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_02"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="32dp"
            android:text="确定要离开吗？"
            android:layout_marginHorizontal="32dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ok_btn"
            android:layout_width="match_parent"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:text="再考虑下"
            android:stateListAnimator="@anim/widget_button_sla_mini"
            android:layout_marginHorizontal="32dp"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_02"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cancel_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="2dp"
            android:text="@string/CORE_PRICERECALL_RETAIN_CANCEL"
            android:layout_marginHorizontal="32dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecall2Dialog>
