<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.VoiceSquareRightOperateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="widgets.VoiceSquareRightOperateView">
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/board_entry"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f08239b"
        android:scaleType="fitXY"
        android:layout_marginEnd="8dp"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/search"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f082817"
        android:scaleType="fitXY"
        android:layout_marginEnd="8dp"/>
    <p151v.VImage
        android:id="@+id/create_voice"
        android:layout_width="64dp"
        android:layout_height="40dp"
        android:src="0x7f0827e2"
        android:layout_marginEnd="8dp"/>
</com.p051p1.mobile.putong.live.external.view.widgets.VoiceSquareRightOperateView>
