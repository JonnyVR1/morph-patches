<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.constellationmatch.ConstellationInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:rRadius="24dp"
    holder="constellationmatch.ConstellationInfoView">
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/constrain_layout"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:rRadius="24dp"
        flatten="true">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f080a9b"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/common_card_image_holder_full_round"
            app:failureImageScaleType="centerInside"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerCrop"
            app:roundedCornerRadius="24dp"
            style="@style/core_fresco_base"
            useId="true"/>
        <p151v.VButton
            android:id="@+id/close"
            android:background="0x7f080c72"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/core_intl_constellation_info_bg"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintBottom_toBottomOf="@+id/image"
            app:layout_constraintEnd_toEndOf="@+id/image"
            app:layout_constraintStart_toStartOf="@+id/image"/>
        <com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout
            android:orientation="horizontal"
            android:id="@+id/order_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/image"
            app:measureLayoutOrientation="horizontal"
            app:measureReverse="true"
            flatten="true">
            <p151v.VText
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"/>
        </com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/image"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/constellation_image"
            android:layout_width="129dp"
            android:layout_height="150dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/transparent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space"
            app:placeholderImage="@color/transparent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/info_layout"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintTop_toBottomOf="@+id/image"
            flatten="true">
            <RelativeLayout
                android:id="@+id/card_layout"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                flatten="true">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#5297ff"
                    android:ellipsize="end"
                    android:id="@+id/type"
                    android:layout_width="160dp"
                    android:layout_height="34dp"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"/>
                <org.apmem.tools.layouts.FlowLayout
                    android:orientation="horizontal"
                    android:id="@+id/tags"
                    android:layout_width="198dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/type"
                    android:layout_marginStart="12dp"/>
                <TextView
                    android:scrollbarStyle="insideInset"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="#bdb2ff"
                    android:id="@+id/desc"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="12dp"
                    android:layout_below="@+id/tags"/>
            </RelativeLayout>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#bdb2ff"
                android:gravity="center"
                android:id="@+id/branding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/INTL_HOROSCOPE_MKT_PROMOTEXT"
                android:drawableLeft="0x7f080c8f"
                android:drawablePadding="10dp"
                android:paddingStart="47dp"
                android:paddingEnd="47dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundConstraintLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/save_pic"
        android:background="@drawable/core_intl_constellation_match_bt_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="272dp"
        android:layout_height="48dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="26dp"
        android:layout_below="@+id/constrain_layout">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/INTL_HOROSCOPE_SELF_BUTTON"
            android:drawableLeft="0x7f080a9c"
            android:drawablePadding="10dp"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/normal_operation"
        android:layout="@layout/core_intl_constellation_card_operation_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_alignParentBottom="true"/>
    <ViewStub
        android:id="@+id/usa_operation"
        android:layout="@layout/core_intl_constellation_card_us_operation_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.core.p058ui.constellationmatch.ConstellationInfoView>
