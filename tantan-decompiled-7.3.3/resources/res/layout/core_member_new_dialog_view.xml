<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.IntlMemberAnimView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="dlg.IntlMemberAnimView">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/rl_content"
        android:background="@drawable/common_view_popupup_bg"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/v_top_image"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="fitStart"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="20dp"/>
        <FrameLayout
            android:id="@+id/fl_svga"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            flatten="true">
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/tantan_svga_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/tantan_svga_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/center_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/boost_close"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="0x7f080a2c"
            android:layout_alignParentEnd="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_ff9987"
            android:gravity="center"
            android:id="@+id/boosting_time"
            android:background="@drawable/core_bg_intl_boost_time"
            android:visibility="gone"
            android:layout_width="75dp"
            android:layout_height="28dp"
            android:layout_marginTop="125dp"
            android:layout_centerHorizontal="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/boost_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="150dp"
            android:layout_marginRight="20dp"
            flatten="true">
            <p151v.VText
                android:textSize="20sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/boost_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                app:typeface="medium"/>
            <p151v.VLinear
                android:layout_gravity="center"
                android:id="@+id/views_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="4dp"
                flatten="true">
                <p151v.VText
                    android:textSize="32sp"
                    android:textColor="@color/core_fe7e1d"
                    android:id="@+id/boosting_views"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#323232"
                    android:id="@+id/views_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="@string/INTLVAS_BOOST_PEOPLE"/>
            </p151v.VLinear>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/core_66000000"
                android:gravity="center"
                android:id="@+id/boost_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="4dp"/>
            <p151v.VRelative
                android:orientation="vertical"
                android:id="@+id/boosted_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                flatten="true">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:id="@+id/boosted_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_below="@+id/end_subtitle"
                    flatten="true">
                    <p151v.VRelative
                        android:id="@+id/like_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="@color/common_grey_03"
                            android:id="@+id/like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/BOOST_POPUP_LIKES"
                            android:layout_centerHorizontal="true"/>
                        <TextView
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/common_black_02"
                            android:gravity="center"
                            android:id="@+id/like_num"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1.5dp"
                            android:layout_below="@+id/like"/>
                    </p151v.VRelative>
                    <p151v.VRelative
                        android:id="@+id/view_layout"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        flatten="true">
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="@color/core_4d000000"
                            android:id="@+id/boost_views"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/BOOST_POPUP_VIEWS"
                            android:layout_centerHorizontal="true"/>
                        <ImageView
                            android:id="@+id/iv_label"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="-3.5dp"
                            android:src="0x7f080ad6"
                            android:layout_toRightOf="@+id/boost_views"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textColor="@color/core_color_e6ffffff"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="7dp"
                            android:layout_alignLeft="@+id/iv_label"
                            android:rotation="9"/>
                        <TextView
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/common_black_02"
                            android:gravity="center"
                            android:id="@+id/view_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1.5dp"
                            android:layout_below="@+id/boost_views"/>
                    </p151v.VRelative>
                </p151v.VLinear>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/line"
                    android:background="@drawable/core_intl_boost_line"
                    android:layout_width="2dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:layout_centerHorizontal="true"/>
            </p151v.VRelative>
        </p151v.VLinear>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/positive"
            android:visibility="visible"
            android:layout_height="59dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/boost_content_layout"
            android:fontFamily="sans-serif"
            app:typeface="medium"
            style="@style/common_button_large_01"/>
        <p151v.VImage
            android:gravity="center"
            android:id="@+id/boost_discount"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:src="0x7f080aa4"
            android:layout_below="@+id/boost_content_layout"
            android:layout_marginEnd="17dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_33000000"
            android:gravity="center"
            android:id="@+id/negative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/positive"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_boost_progress_bubble"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginBottom="-25dp"
        android:layout_above="@+id/rl_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/bubble_content"
            android:background="0x7f080a2b"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:singleLine="true"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.dlg.IntlMemberAnimView>
