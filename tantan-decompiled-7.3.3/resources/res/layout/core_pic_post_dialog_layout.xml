<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.profilelist.PicPostDlgView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="24dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="208dp"
    android:minHeight="208dp"
    holder="profile.profilelist.PicPostDlgView">
    <p151v.VDraweeView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/third_image"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:rotation="0"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="12dp"/>
    <p151v.VDraweeView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/second_image"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:rotation="0"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="12dp"/>
    <p151v.VDraweeView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/first_image"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:rotation="0"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="12dp"/>
    <p151v.VImage
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="44dp"
        android:src="0x7f08132f"
        android:scaleType="centerCrop"/>
</com.p051p1.mobile.putong.core.p058ui.profile.profilelist.PicPostDlgView>
