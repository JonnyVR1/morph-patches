<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/identity_nfc_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="252dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <FrameLayout
            android:id="@+id/fl_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="14dp"
                android:layout_gravity="center"
                android:id="@+id/txt_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identity_ocr_alert_cancel_text"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_sure"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/identity_color_nfc_main_color"
                android:layout_gravity="center"
                android:id="@+id/txt_sure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identity_ocr_alert_ok_text"/>
        </FrameLayout>
    </RelativeLayout>
    <View
        android:background="#e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.idv.identity.platform.widget.wheelpiker.WheelDatePicker
        android:layout_gravity="center_vertical"
        android:id="@+id/date_picker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="33dp"
        android:layout_marginEnd="23dp"/>
</LinearLayout>
