<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_friend_tacit_bottom_sheet_bg"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.QuestionGuideAddAnswerBottomSheet">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f080733"
        android:layout_marginEnd="16dp"/>
    <p151v.VImage
        android:id="@+id/question_img"
        android:layout_width="140dp"
        android:layout_height="110dp"
        android:src="@drawable/core_add_answer_dlg_bg"
        android:layout_marginStart="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="22sp"
        android:textColor="#000000"
        android:id="@+id/question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="选择要展示到的生活的标签"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="回答问题，展示到我的资料页"
        android:layout_marginStart="40dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/finish_btn"
        android:background="@drawable/common_button_btn_orange_small"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:text="添加我的回答"
        android:layout_marginHorizontal="20dp"/>
</p151v.VLinear>
