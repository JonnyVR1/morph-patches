<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fra_container"
    android:padding="10dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="语音通话邀请"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f080a18"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <p151v.VRelative
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VFrame
            android:id="@+id/fra_avatar"
            android:layout_width="112dp"
            android:layout_height="162dp"
            android:layout_marginTop="41dp"
            android:layout_marginBottom="16dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp">
            <p151v.VDraweeView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tv_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:text="在线"
                android:drawableLeft="0x7f0809f5"
                android:drawablePadding="3dp"
                android:layout_alignLeft="@+id/avatar"
                android:layout_alignTop="@+id/avatar"/>
            <com.tantan.library.svga.SVGAnimationView
                android:layout_gravity="center"
                android:id="@+id/wave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"/>
        </p151v.VFrame>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="41dp"
            android:layout_marginRight="12dp"
            android:layout_toEndOf="@+id/fra_avatar"
            android:layout_marginHorizontal="12dp">
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:singleLine="true"/>
            <p151v.VImage
                android:id="@+id/avatar_icon"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="12dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_below="@+id/name_container"
            android:layout_toEndOf="@+id/fra_avatar"
            android:layout_marginHorizontal="12dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#cc000000"
            android:id="@+id/tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="12dp"
            android:text="她正在等你语音聊天..."
            android:layout_below="@+id/content"
            android:layout_toEndOf="@+id/fra_avatar"
            android:layout_marginHorizontal="12dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e89e4d"
            android:gravity="center"
            android:id="@+id/chat"
            android:background="@drawable/core_bg_qaudio_broadcast_acc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="立即接听"
            android:layout_alignBottom="@+id/fra_avatar"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@+id/fra_avatar"/>
    </p151v.VRelative>
</FrameLayout>
