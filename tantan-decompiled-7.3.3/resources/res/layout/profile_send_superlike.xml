<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatars"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="118dp"
        android:layout_marginTop="24dp">
        <FrameLayout
            android:layout_gravity="bottom"
            style="@style/vip_alert_avatar_frame_round_bg">
            <p151v.VDraweeView
                android:id="@+id/avatar_left"
                android:layout_width="96dp"
                android:layout_height="96dp"
                style="@style/core_fresco_profile_white_border"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            style="@style/vip_alert_avatar_frame_round_bg">
            <p151v.VDraweeView
                android:id="@+id/avatar_right"
                android:layout_width="96dp"
                android:layout_height="96dp"
                style="@style/core_fresco_profile_white_border"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f0818ed"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="@color/common_white_01"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="喜欢就送「超级喜欢」"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_white_01"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="使用超级喜欢表达心中爱意，配对飙升5倍！"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_orange_01"
        android:layout_gravity="center"
        android:id="@+id/send_superlike"
        android:background="@drawable/rect_rounded_white"
        android:paddingLeft="40dp"
        android:paddingTop="16dp"
        android:paddingRight="40dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="送Ta超级喜欢"/>
</p151v.VLinear>
