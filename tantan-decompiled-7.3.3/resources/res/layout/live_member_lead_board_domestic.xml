<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.member.subModule.leaderBoard.MemberLeaderViewDomestic xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common"
    holder="member.subModule.leaderBoard.MemberLeaderViewDomestic">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/left_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本场榜单"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:src="0x7f0823e1"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/right_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="暂无用户登上宠爱榜"
            android:drawableRight="0x7f0823b0"/>
    </FrameLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="82dp"
        flatten="true">
        <p151v.VRecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            useId="true"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="82dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="0x7f0823e0"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4dffffff"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="24dp"
            android:text="@string/LIVE_GUEST_PROFILE_LIST"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/jump"
            android:background="@drawable/live_bg_ff8817_r16"
            android:layout_width="247dp"
            android:layout_height="56dp"
            android:layout_marginTop="50dp"
            android:text="@string/LIVE_GUEST_PROFILE_GIVE_GIFT"
            flatten="true"/>
    </p151v.VLinear>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/back_to_leader_board"
        android:background="0x7f0823b1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="102dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/live_bg_25252c_r24"
        android:layout_width="match_parent"
        android:layout_height="82dp">
        <include
            android:id="@+id/own"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            layout="@layout/live_member_item"/>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.common.member.subModule.leaderBoard.MemberLeaderViewDomestic>
