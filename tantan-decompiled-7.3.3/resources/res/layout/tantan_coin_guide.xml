<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.CoinGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.CoinGuideView">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/gradient"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:shadowEnable="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/common_grey_01"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#4a4a4a"
        android:gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="6dp"
        android:lineSpacingExtra="6sp"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#fe5246"
        android:gravity="center_horizontal"
        android:id="@+id/additional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="6dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp">
        <p151v.VCheckBox
            android:id="@+id/check"
            android:background="@drawable/core_media_picker_check_selector"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:checked="true"
            android:button="@null"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_02"
            android:layout_gravity="center_vertical"
            android:id="@+id/reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.CoinGuideView>
