<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.redpacket.VoiceRedPacketView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="80dp"
    android:layout_height="106dp">
    <p151v.VFrame
        android:layout_gravity="top|right"
        android:id="@+id/small_view"
        android:background="@drawable/live_bg_black_r8_a15"
        android:layout_width="38dp"
        android:layout_height="38dp">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/small_icon"
            android:layout_width="28dp"
            android:layout_height="33dp"
            android:layout_marginTop="5dp"
            android:src="0x7f0827ff"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ffe8bb"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/time"
            android:background="@drawable/live_bg_black_r4_a40"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="14dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/count"
            android:background="@drawable/live_shape_voice_packet_count_down_bg"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:includeFontPadding="false"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/big_view"
        android:background="0x7f0827fe"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="106dp">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:padding="1dp"
            android:layout_width="33.5dp"
            android:layout_height="33.5dp"
            android:layout_marginTop="16dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="#ffd2a6"
            app:roundingBorderWidth="1.5dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffe8bb"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="礼物红包"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="16dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="0x7f0824b7"/>
            <p151v.VText
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#99fff6bb"
                android:gravity="center_vertical"
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.virtual.redpacket.VoiceRedPacketView>
