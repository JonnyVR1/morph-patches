<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/core_intl_discount_entry_root"
        android:background="@drawable/core_bg_intl_discount_entry_banner_theme1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="@color/core_intl_discount_entry_theme1_headline"
                android:ellipsize="end"
                android:id="@+id/core_intl_discount_entry_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                app:fontWeight="700"/>
            <p151v.VText_NoTopPadding
                android:textSize="12sp"
                android:textColor="@color/core_intl_discount_entry_theme1_subtitle"
                android:ellipsize="end"
                android:id="@+id/core_intl_discount_entry_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:maxLines="2"
                app:fontWeight="400"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/core_intl_discount_entry_theme1_cta"
            android:background="@drawable/core_bg_intl_discount_entry_theme1_cta_card"
            android:padding="0dp"
            android:layout_width="94dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp">
            <p151v.VText_NoTopPadding
                android:textSize="12sp"
                android:textColor="@color/core_intl_discount_entry_theme1_cta_title"
                android:gravity="center_horizontal"
                android:id="@+id/core_intl_discount_entry_cta_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:fontWeight="600"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="@drawable/core_bg_intl_discount_entry_theme1_countdown_pill"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="14dp">
                <p151v.VText_NoTopPadding
                    android:textSize="11sp"
                    android:textColor="@color/core_intl_discount_entry_theme1_cta_timer"
                    android:gravity="center"
                    android:id="@+id/core_intl_discount_entry_timer_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="12sp"
                    android:textColor="@color/core_intl_discount_entry_theme1_cta_timer"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="3dp"
                    android:text=":"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="11sp"
                    android:textColor="@color/core_intl_discount_entry_theme1_cta_timer"
                    android:gravity="center"
                    android:id="@+id/core_intl_discount_entry_timer_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="12sp"
                    android:textColor="@color/core_intl_discount_entry_theme1_cta_timer"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="3dp"
                    android:text=":"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="11sp"
                    android:textColor="@color/core_intl_discount_entry_theme1_cta_timer"
                    android:gravity="center"
                    android:id="@+id/core_intl_discount_entry_timer_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"
                    app:fontWeight="700"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VLinear>
</merge>
