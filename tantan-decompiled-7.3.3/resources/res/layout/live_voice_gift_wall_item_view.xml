<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.giftwall.view.VoiceGiftWallItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    flatten="true"
    folder="voice.intl"
    holder="giftwall.view.VoiceGiftWallItemView">
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_centerInParent="true"/>
        <FrameLayout
            android:id="@+id/contribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignRight="@+id/icon"
            android:layout_alignBottom="@+id/icon"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/first_avatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:failureImage="@drawable/live_vector_default_avatar_bg"
                app:failureImageScaleType="centerCrop"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/live_white"
                app:roundingBorderWidth="1dp"/>
            <p151v.VDraweeView
                android:id="@+id/most_avatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="14dp"
                app:failureImage="@drawable/live_vector_default_avatar_bg"
                app:failureImageScaleType="centerCrop"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/live_white"
                app:roundingBorderWidth="1dp"/>
        </FrameLayout>
    </RelativeLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_50_opacity"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="gift name"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/container"
        app:layout_constraintRight_toRightOf="@+id/container"
        app:layout_constraintTop_toBottomOf="@+id/container"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.giftwall.view.VoiceGiftWallItemView>
