<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomLastMomentExpandedLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomLastMomentExpandedLayout">
    <FrameLayout
        android:id="@+id/card_bottom_upper_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        flatten="true">
        <include
            android:id="@+id/card_bottom_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_card_bottom_expanded_basic_info"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/card_bottom_lower_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/info_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/title_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/core_color_60percent_FFFFFF"
                    android:id="@+id/tv_moment_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:text="我的近期动态"
                    android:shadowColor="@color/common_light_02"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:lineSpacingExtra="0sp"
                    app:typeface="regular"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/image_ll"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/image1"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:actualImageScaleType="centerCrop"
                    app:backgroundImage="@drawable/core_card_moment_image_bg"
                    app:roundedCornerRadius="10dp"
                    app:roundingBorderWidth="0dp"/>
                <p151v.VDraweeView
                    android:id="@+id/image2"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginLeft="8dp"
                    app:actualImageScaleType="centerCrop"
                    app:backgroundImage="@drawable/core_card_moment_image_bg"
                    app:roundedCornerRadius="10dp"
                    app:roundingBorderWidth="0dp"/>
                <p151v.VDraweeView
                    android:id="@+id/image3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginLeft="8dp"
                    app:actualImageScaleType="centerCrop"
                    app:backgroundImage="@drawable/core_card_moment_image_bg"
                    app:roundedCornerRadius="10dp"
                    app:roundingBorderWidth="0dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomLastMomentExpandedLayout>
