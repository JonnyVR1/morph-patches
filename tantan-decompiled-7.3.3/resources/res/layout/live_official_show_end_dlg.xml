<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="officialshow.enddialog.OfficialShowEndDialog">
    <p151v.VFrame
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="37dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            flatten="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="@color/live_black_80_opacity"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="47dp"
                    android:text="直播结束"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/live_black_40_opacity"
                    android:id="@+id/tv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="关注他订阅下次直播通知"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:id="@+id/follow"
                    android:background="@drawable/live_bg_fe7e1d_r10"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:text="订阅"
                    android:layout_marginStart="33dp"
                    android:layout_marginEnd="33dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
                <View
                    android:id="@+id/view_current_anchor"
                    android:background="@drawable/live_bg_black_r10_a03"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/follow"/>
                <p151v.VDraweeView
                    android:id="@+id/iv_anchor_avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/view_current_anchor"
                    app:layout_constraintStart_toStartOf="@+id/view_current_anchor"
                    app:layout_constraintTop_toTopOf="@+id/view_current_anchor"
                    app:roundAsCircle="true"/>
                <p151v.VText
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:id="@+id/tv_anchor_jump"
                    android:background="@drawable/live_bg_fe7e1d_r10"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="跟随"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/view_current_anchor"
                    app:layout_constraintEnd_toEndOf="@+id/view_current_anchor"
                    app:layout_constraintTop_toTopOf="@+id/view_current_anchor"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/live_black_80_opacity"
                    android:ellipsize="end"
                    android:id="@+id/tv_anchor_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_anchor_jump"
                    app:layout_constraintStart_toEndOf="@+id/iv_anchor_avatar"
                    app:layout_constraintTop_toTopOf="@+id/view_current_anchor"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/live_black_40_opacity"
                    android:ellipsize="end"
                    android:id="@+id/tv_anchor_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_anchor_jump"
                    app:layout_constraintStart_toEndOf="@+id/iv_anchor_avatar"
                    app:layout_constraintTop_toBottomOf="@+id/tv_anchor_name"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/live_black_40_opacity"
                    android:ellipsize="end"
                    android:id="@+id/tv_time_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="31dp"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_current_anchor"/>
                <p151v.VProgress
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="26dp"
                    android:max="5"
                    android:progressDrawable="@drawable/common_progress_drawable"
                    app:layout_constraintTop_toBottomOf="@+id/tv_time_countdown"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar"
            android:layout_width="74dp"
            android:layout_height="74dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="2dp"/>
    </p151v.VFrame>
</p151v.VFrame>
