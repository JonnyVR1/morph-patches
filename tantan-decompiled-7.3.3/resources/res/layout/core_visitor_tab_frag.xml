<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="visitor.frag.VisitorTabViewModel">
    <p151v.VPullUpRecyclerView
        android:id="@+id/visitors"
        android:paddingLeft="5dp"
        android:paddingRight="8dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        useId="true"/>
    <androidx.core.widget.NestedScrollView
        android:orientation="vertical"
        android:id="@+id/empty"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="32dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:src="0x7f0819c3"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#323232"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="滑卡让更多人看到我"/>
        </p151v.VLinear>
    </androidx.core.widget.NestedScrollView>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/get_privilege"
        android:background="@drawable/core_visitors_privilege_button_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#ffdea2"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一键解锁我的访客"/>
    </p151v.VLinear>
</RelativeLayout>
