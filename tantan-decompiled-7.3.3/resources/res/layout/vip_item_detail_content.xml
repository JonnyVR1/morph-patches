<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        flatten="true">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/bg_drawee"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:actualImageScaleType="fitCenter"/>
            <p151v.VImage
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/identify_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="10dp"
                android:src="0x7f082959"/>
        </FrameLayout>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:layout_gravity="center"
            android:id="@+id/bg_gradient"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:shadowEnable="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <androidx.legacy.widget.Space
        android:id="@+id/title_top_space"
        android:layout_width="wrap_content"
        android:layout_height="16dp"/>
    <p151v.VText
        android:textSize="19sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#f26c4e"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="24dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/text_medium"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"/>
</LinearLayout>
