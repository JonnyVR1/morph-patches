<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageDynamicComments xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true">
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemText
        android:textColorLink="@color/white"
        android:autoLink="web"
        android:id="@+id/text"
        android:paddingLeft="?attr/right_msg_left_padding"
        android:paddingTop="14dp"
        android:paddingRight="?attr/right_msg_right_padding"
        android:paddingBottom="14dp"
        android:lineSpacingExtra="1.5dp"
        app:enableEmojis="true"
        app:largeEmojis="true"
        style="@style/messages_item_right"/>
    <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/message_dynamic_container"
        android:background="@drawable/core_message_dynamic_container_right_bg"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:isLeft="false"
        flatten="true">
        <FrameLayout
            android:id="@+id/dynamic_image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/dynamic_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f08079f"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="8dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/dynamic_play"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="0x7f080f79"/>
        </FrameLayout>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/dynamic_content_container"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_toRightOf="@+id/dynamic_image_container">
            <TextView
                android:textSize="14sp"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:id="@+id/dynamic_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#4c000000"
                android:ellipsize="end"
                android:id="@+id/dynamic_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:lines="1"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageDynamicComments>
