<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:background="0x7f081c47"
    android:paddingLeft="14dp"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginRight="12dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.photoalbumactivities.PhotoAlbumInterestedCardView">
    <p151v.VDraweeView
        android:id="@+id/profile"
        android:layout_width="60dp"
        android:layout_height="76dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="10dp"
        style="@style/feed_post_fresco_moment_small"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:id="@+id/user_count_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="7dp"
        android:text="21个对你感兴趣的人"
        app:layout_constraintLeft_toRightOf="@+id/profile"
        app:layout_constraintTop_toTopOf="@+id/profile"/>
    <p151v.VImage
        android:id="@+id/close_iv"
        android:background="0x7f081d42"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#99000000"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/user_count_tv"
        app:layout_constraintRight_toLeftOf="@+id/look"
        app:layout_constraintTop_toBottomOf="@+id/user_count_tv"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#99000000"
        android:ellipsize="end"
        android:id="@+id/user_interested_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginRight="13dp"
        android:text="她喜欢肖申克的救赎、瑜伽、跑步等、跑步等、跑步等"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/user_count_tv"
        app:layout_constraintRight_toLeftOf="@+id/look"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:id="@+id/look"
        android:background="@drawable/feed_activity_interested_card_tv_bg"
        android:layout_width="54dp"
        android:layout_height="34dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="14dp"
        android:text="@string/FEED_CARD_CHECK"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
