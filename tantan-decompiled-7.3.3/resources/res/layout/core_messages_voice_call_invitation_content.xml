<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/voice_call_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="10dp"
            app:srcCompat="@drawable/core_voice_call_invitation"/>
        <LinearLayout
            android:gravity="left"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/common_black_02"
                android:id="@+id/tips_line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语音通话邀请"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/invitation_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VButton
        android:textSize="15sp"
        android:textColor="#fe7e1d"
        android:gravity="center"
        android:id="@+id/me_call_voice"
        android:background="@drawable/core_bg_10_ffffff"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/CHAT_VOICE_CALL_INITIATE"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/objective_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:showDividers="middle">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/gray_btn"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/VOICE_CALL_APPLICATION_RECEIVER_REJECT_BUTTON"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/red_btn"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/VOICE_CALL_APPLICATION_RECEIVER_APPROVE"
            android:layout_weight="1"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
</LinearLayout>
