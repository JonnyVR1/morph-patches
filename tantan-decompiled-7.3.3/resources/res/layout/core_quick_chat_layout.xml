<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="quickaudio.newquickchat.secondfloor.QuickChatLoftViewModel">
    <ImageView
        android:id="@+id/background"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-84dp"
        android:src="0x7f0815a7"
        android:scaleType="centerCrop"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/navigation_bar"
        android:background="@color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0815a4"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#ccffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="闪聊广场"
            android:lineHeight="29.4dp"/>
    </p151v.VLinear>
    <p151v.VScroll
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/top_content"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/top_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:src="0x7f0815a6"/>
                <p151v.VText
                    android:textSize="21sp"
                    android:textColor="#ccffffff"
                    android:id="@+id/top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="闪聊速配"
                    android:lineHeight="29dp"/>
                <p151v.VText
                    android:textColor="#66ffffff"
                    android:id="@+id/sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="为你推荐精选在线用户，即刻开聊"
                    android:lineHeight="22dp"/>
            </p151v.VLinear>
            <p151v.VFrame
                android:layout_gravity="center"
                android:id="@+id/text_chat_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-21dp">
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/svg_anim"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"/>
                <p151v.VImage
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/wave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-7dp"
                    android:src="0x7f0815a5"/>
                <com.p051p1.mobile.putong.core.p058ui.quickaudio.newquickchat.secondfloor.item.QuickChatLoftChatItem
                    android:layout_gravity="center"
                    android:id="@+id/view1"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.p051p1.mobile.putong.core.p058ui.quickaudio.newquickchat.secondfloor.item.QuickChatLoftChatItem
                    android:layout_gravity="center"
                    android:id="@+id/view2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/online_tip_button"
                android:background="0x7f0815a0"
                android:layout_width="204dp"
                android:layout_height="58dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#ccffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/quick_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在线闪聊"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#66ffffff"
                    android:gravity="center"
                    android:id="@+id/quick_text_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
            <p151v.VRelative
                android:id="@+id/call_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="56dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="66dp"
                android:layout_marginHorizontal="12dp"
                flatten="true">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#66ffffff"
                    android:id="@+id/bottom_content_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更多交友玩法"
                    android:layout_marginStart="4dp"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:id="@+id/total_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/bottom_content_title">
                    <com.p051p1.mobile.putong.core.p058ui.quickaudio.newquickchat.secondfloor.item.QuickChatPageItem
                        android:id="@+id/voice_call_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <View
                        android:layout_width="9dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"/>
                    <com.p051p1.mobile.putong.core.p058ui.quickaudio.newquickchat.secondfloor.item.QuickChatPageItem
                        android:id="@+id/vedio_call_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </p151v.VLinear>
                <p151v.VRelative
                    android:id="@+id/single_layout"
                    android:background="@drawable/core_quick_chat_page_voice_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/bottom_content_title">
                    <p151v.VImage
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:src="0x7f0815ab"
                        android:layout_marginStart="16dp"
                        android:layout_marginVertical="24dp"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="58dp">
                        <p151v.VText
                            android:textSize="16sp"
                            android:textColor="#66ffffff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="语音闪聊"
                            android:lineHeight="22.4dp"/>
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="#33ffffff"
                            android:id="@+id/desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="用声音认识她"
                            android:lineHeight="18.2dp"/>
                    </p151v.VLinear>
                    <p151v.VImage
                        android:id="@+id/icon"
                        android:layout_width="64dp"
                        android:layout_height="24dp"
                        android:src="0x7f0815ac"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_alignParentEnd="true"/>
                </p151v.VRelative>
            </p151v.VRelative>
        </p151v.VLinear>
    </p151v.VScroll>
    <View
        android:id="@+id/mask"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
</FrameLayout>
