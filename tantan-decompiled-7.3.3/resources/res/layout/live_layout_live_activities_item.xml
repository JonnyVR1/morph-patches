<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="view"
    holder="widgets.LiveActivitiesItemView">
    <p151v.VFrame
        android:id="@+id/layout_avatar"
        android:layout_width="wrap_content"
        android:layout_height="59dp"
        android:layout_marginLeft="12dp"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/live_shape_banner_profile_placeholder"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.live.base.view.LiveMainlandTagView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/live_tag"
            android:background="@drawable/live_shape_activity_living_tag_bg"
            android:layout_width="21dp"
            android:layout_height="15dp"/>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/live_official_show_tag"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="15dp"
            android:src="0x7f082111"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#cc000000"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/tv_enter_room"
        android:layout_toRightOf="@+id/layout_avatar"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66000000"
        android:id="@+id/desc_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="24dp"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/tv_enter_room"
        android:layout_below="@+id/title_text"
        android:layout_alignLeft="@+id/title_text"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/tv_enter_room"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:text="@string/LIVE_ACTIVITY_ENTER"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#33000000"
        android:gravity="center"
        android:id="@+id/live_end_time_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:minWidth="80dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesItemView>
