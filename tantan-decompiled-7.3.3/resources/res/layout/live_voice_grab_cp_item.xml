<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.grabhat.view.VoiceCpItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_r14_a05"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginBottom="10dp"
    flatten="true"
    folder="voice"
    holder="grabhat.view.VoiceCpItemView">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffdd19"
        android:gravity="center"
        android:id="@+id/ranking"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:background="@drawable/live_shape_chat_hall_bottom_avatar_bg"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="91dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/avatar2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="95dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/name_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="27dp"
        android:layout_marginRight="20dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/avatar2"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_love"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="2dp"
        android:src="0x7f0823df"
        app:layout_constraintLeft_toRightOf="@+id/avatar2"
        app:layout_constraintTop_toBottomOf="@+id/name_info"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="normal"
        android:textColor="#66ffffff"
        android:gravity="center_vertical"
        android:id="@+id/love_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="3dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_love"
        app:layout_constraintTop_toBottomOf="@+id/name_info"/>
</com.p051p1.mobile.putong.live.livingroom.voice.grabhat.view.VoiceCpItemView>
