<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rTopLeftRadius="20dp"
    app:rTopRightRadius="20dp"
    flatten="true"
    holder="intloperation.interesting.SimilarInterestsDlg">
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundView
        android:id="@+id/top"
        android:background="@color/white"
        android:layout_width="45dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rRadius="18dp"/>
    <p151v.VDraweeView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:layout_constraintDimensionRatio="h,375:250"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <p151v.VPullUpRecyclerView
        android:id="@+id/list"
        android:paddingBottom="68dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="540dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_monolayer_1"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/bt"/>
    <View
        android:id="@+id/bottom_monolayer_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_monolayer_1"/>
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/bt"
        android:background="#ff7999"
        android:layout_width="276dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="50dp"
        android:text="@string/INTL_ACTIVITIES_PETS_SHOW_CLICK"
        android:layout_below="@+id/desc"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rRadius="16dp"/>
</com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundConstraintLayout>
