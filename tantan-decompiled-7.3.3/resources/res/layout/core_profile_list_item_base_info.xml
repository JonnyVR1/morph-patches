<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/edit_name_frame"
    android:background="@drawable/tf_rect_light"
    android:paddingLeft="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:fillerIndex="0"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileBaseInfoItemHolder">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/name_frame"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:divider="@null"
        flatten="true">
        <p151v.VLinear_FillerMeasure
            android:id="@+id/name_item_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fillerIndex="0"
            flatten="true">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/big_user_name"
                android:gravity="center_vertical"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:singleLine="true"
                android:drawablePadding="5dp"
                app:typeface="medium"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginRight="4dp">
                <p151v.VDraweeView
                    android:id="@+id/emoji"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="8dp"/>
                <p151v.VImage
                    android:id="@+id/emoji_edit"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="8dp"
                    android:src="0x7f080249"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/pic_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:minWidth="72dp">
                <androidx.legacy.widget.Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content"/>
                <p151v.VImage
                    android:gravity="center_vertical"
                    android:id="@+id/tip_image"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:src="0x7f082957"/>
            </LinearLayout>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/certification_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:minWidth="72dp"/>
            <include
                android:layout_gravity="center_vertical"
                android:id="@+id/verification_tag_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                layout="@layout/core_verification_tag_view"/>
        </p151v.VLinear_FillerMeasure>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/age_item_layout"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/name_item_layout"
            flatten="true">
            <p151v.VText
                android:id="@+id/age"
                android:drawableLeft="0x7f082974"
                style="@style/core_card_icon_right"/>
            <p151v.VText
                android:textSize="11sp"
                android:id="@+id/zodiac"
                android:layout_marginLeft="4dp"
                style="@style/core_card_icon_right"/>
            <p151v.VImage
                android:id="@+id/vip_icon"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:src="0x7f0819ad"
                android:adjustViewBounds="true"/>
            <com.p051p1.mobile.putong.core.newui.home.views.WealthLevelView
                android:id="@+id/wealth_level_icon"
                android:visibility="gone"
                android:layout_width="34dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:maxHeight="18dp"
                app:actualImageScaleType="centerInside"/>
            <p151v.VText
                android:layout_gravity="center"
                android:id="@+id/mutual_friends"
                android:layout_width="wrap_content"
                android:layout_marginLeft="4dp"
                android:drawableLeft="0x7f0802d9"
                style="@style/core_card_icon_right"/>
            <p151v.VText
                android:layout_gravity="center"
                android:id="@+id/description"
                android:layout_marginLeft="4dp"
                android:drawableLeft="0x7f0802d8"
                style="@style/core_card_icon_right"/>
            <p151v.VText
                android:textSize="11sp"
                android:layout_gravity="center"
                android:id="@+id/icon_student"
                android:visibility="gone"
                android:layout_marginLeft="4dp"
                android:text="@string/PROFILE_IS_STUDENT_STRING"
                android:drawableLeft="0x7f082047"
                style="@style/core_card_icon_right"/>
        </LinearLayout>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/location_and_active_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/age_item_layout"
            flatten="true">
            <p151v.VText_AutoFit
                android:textSize="13sp"
                android:textColor="@color/text_light"
                android:gravity="center_vertical"
                android:id="@+id/location_and_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:layout_weight="1"
                app:typeface="regular"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/gp_hide_active_time_guide_holder"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VRelative
                    android:background="0x7f081f6c"
                    android:layout_width="12dp"
                    android:layout_height="12dp">
                    <p151v.VImage
                        android:id="@+id/gp_hide_active_time_guide_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f081f6d"/>
                </p151v.VRelative>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/tantan_orange"
                    android:id="@+id/gp_hide_active_time_guide_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/INTL_HIDE_ACTIVE_TIME"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/text_light"
            android:gravity="center_vertical"
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/PROFILE_EDIT_ACCOUNT_SETTINGS"
            android:layout_below="@+id/location_and_active_wrap"
            app:typeface="regular"
            flatten="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/insert_part_attention"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
