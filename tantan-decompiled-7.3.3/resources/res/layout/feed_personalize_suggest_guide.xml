<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedPersonalizeSuggestGuideView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/personalize_suggest_guide_container"
    android:background="@color/feed_post_guide_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.view.FeedPersonalizeSuggestGuideView">
    <ImageView
        android:layout_width="66dp"
        android:layout_height="51dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="15dp"
        android:src="0x7f081e0d"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/personalize_suggest_guide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="没有感兴趣的内容？"
            android:maxLines="1"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:id="@+id/personalize_suggest_guide_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="开启个性化推荐，浏览定制内容"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/personalize_suggest_guide_open_btn"
        android:background="@drawable/feed_book_movie_comment_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="16dp"
        android:text="一键开启"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedPersonalizeSuggestGuideView>
