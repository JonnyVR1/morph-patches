<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.intlpage.IntlPremiumDiscountExclusivePrivilegeItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="2dp">
    <p151v.VIcon
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/core_intl_premium_discount_privilege_check"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        flatten="true">
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textColor="@color/core_intl_premium_discount_item_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/privilege"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="12sp"
            android:textColor="@color/core_intl_premium_discount_item_desc"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/privilege_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            app:fontWeight="400"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.purchase.intlpage.IntlPremiumDiscountExclusivePrivilegeItemView>
