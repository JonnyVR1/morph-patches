<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp">
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/tips_img"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_33000000"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tips_txt"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:text="最有趣的旅行照"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_33000000"
        android:gravity="center"
        android:id="@+id/tips_picture_integrity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:text=""/>
</p151v.VLinear>
