<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeItemIntroPage2 xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="purchase.privilege.PrivilegeItemIntroPage2">
    <FrameLayout
        android:id="@+id/container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="10dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_02"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/privilege_name"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:maxLines="1"
        android:lineSpacingExtra="0dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_vip_normal_subtitle_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/privilege_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        android:maxLines="2"
        android:layout_marginHorizontal="20dp"
        android:fallbackLineSpacing="false"
        android:lineHeight="21sp"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeItemIntroPage2>
