<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemDiceTip xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemDiceTip">
    <p151v.VText
        android:textSize="13dp"
        android:textColor="@color/core_color_4c000000"
        android:gravity="center_horizontal"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="不知道怎么发起话题？先玩局游戏熟悉一下吧~"/>
    <p151v.VText
        android:textSize="13dp"
        android:textColor="#fe7e1d"
        android:gravity="center_horizontal"
        android:id="@+id/start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="开始掷骰子游戏"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemDiceTip>
