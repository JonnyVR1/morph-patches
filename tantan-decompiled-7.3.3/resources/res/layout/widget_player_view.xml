<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    attachToRoot="true"
    holder="PlayerView">
    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignLeft="@+id/cover"
        android:layout_alignTop="@+id/cover"
        android:layout_alignRight="@+id/cover"
        android:layout_alignBottom="@+id/cover"/>
    <p151v.VDraweeView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:actualImageScaleType="centerCrop"
        style="@style/core_im_fresco_base"
        useId="true"/>
    <p151v.VProgressBar
        android:id="@+id/progress_simple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="10000"
        android:progressDrawable="@drawable/core_progress_video_playing"
        android:layout_alignBottom="@+id/cover"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/progress_full"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/cover">
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:id="@+id/track_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"/>
        <p151v.VProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:max="10000"
            android:progressDrawable="@drawable/core_progress_video_playing"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:id="@+id/video_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"/>
    </p151v.VLinear>
    <p151v.VFrame_ColorFilter
        android:layout_gravity="center"
        android:id="@+id/buttons"
        android:padding="14dp"
        android:focusable="true"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="28dp"
        android:layout_centerInParent="true"
        useId="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080f5b"
            useId="true"/>
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:indeterminateOnly="true"
            app:cpb_color="@color/white"
            app:cpb_stroke_percentage="0.1"
            useId="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/pause"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0802dc"
            useId="true"/>
    </p151v.VFrame_ColorFilter>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/voice"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:src="0x7f080fb8"
        android:layout_alignBottom="@+id/cover"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="12dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_above="@+id/replay"
        android:layout_below="@+id/cover"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:enableEmojis="true"/>
    </ScrollView>
    <TextView
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/replay"
        android:background="@drawable/core_message_media_replay_bg"
        android:visibility="invisible"
        android:layout_width="73dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ACTION_REPLY"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:paddingStart="14dp"
        android:layout_marginEnd="16dp"/>
</merge>
