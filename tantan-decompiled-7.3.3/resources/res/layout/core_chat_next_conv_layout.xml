<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.model.view.ConvNextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@drawable/core_chat_next_conv_layout_bg"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="11dp"
    holder="messages.model.view.ConvNextView">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_fe7e1d"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下一条未读"
        android:layout_marginEnd="2dp"/>
    <p151v.VFrame
        android:id="@+id/icon"
        android:layout_width="25dp"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/core_color_f7f7f7"
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="0x7f0806cd"
            android:layout_marginEnd="9dp"
            android:layout_marginVertical="10dp"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.messages.model.view.ConvNextView>
