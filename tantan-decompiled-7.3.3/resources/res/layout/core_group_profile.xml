<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.group.GroupProfileViewModel"
    innerClass="true">
    <p151v.VScroll
        android:id="@+id/scroll_profile"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:background="@color/white"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VLinear
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VFrame
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VDraweeView
                        android:id="@+id/group_avatar"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        app:actualImageScaleType="centerCrop"
                        app:placeholderImage="0x7f08095c"
                        app:roundAsCircle="true"/>
                    <p151v.VLinear
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="92dp">
                        <p151v.VText
                            android:textSize="20sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/group_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                        <p151v.VLinear
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp">
                            <p151v.VText
                                android:textSize="11sp"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/group_category"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="6dp"
                                app:typeface="medium"/>
                            <p151v.VText
                                android:textSize="14sp"
                                android:textColor="#909090"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/group_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </p151v.VLinear>
                    </p151v.VLinear>
                </p151v.VFrame>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:id="@+id/tv_statistic_hint"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/CHAT_GROUP_MEMBERS"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:id="@+id/linear_statistic"
                    android:paddingLeft="4dp"
                    android:paddingTop="14dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="4"
                    flatten="true">
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:id="@+id/group_statistic_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.p058ui.view.SeekArc
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/seek_statistic_1"
                            android:padding="4dp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginLeft="22dp"
                            android:layout_marginRight="22dp"
                            app:seekArcColor="#eeeeee"
                            app:seekArcEnabled="false"
                            app:seekArcMax="100"
                            app:seekArcProgressColor="#ffba1c"
                            app:seekArcProgressWidth="4dp"
                            app:seekArcRoundEdges="true"
                            app:seekArcWidth="2dp"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_statistic_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            app:typeface="regular"/>
                    </p151v.VLinear>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:id="@+id/group_statistic_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.p058ui.view.SeekArc
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/seek_statistic_2"
                            android:padding="4dp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginLeft="22dp"
                            android:layout_marginRight="22dp"
                            app:seekArcColor="#eeeeee"
                            app:seekArcEnabled="false"
                            app:seekArcMax="100"
                            app:seekArcProgressColor="#4dc8ff"
                            app:seekArcProgressWidth="4dp"
                            app:seekArcRoundEdges="true"
                            app:seekArcWidth="2dp"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_statistic_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            app:typeface="regular"/>
                    </p151v.VLinear>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:id="@+id/group_statistic_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.p058ui.view.SeekArc
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/seek_statistic_3"
                            android:padding="4dp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginLeft="22dp"
                            android:layout_marginRight="22dp"
                            app:seekArcColor="#eeeeee"
                            app:seekArcEnabled="false"
                            app:seekArcMax="100"
                            app:seekArcProgressColor="#3cdccc"
                            app:seekArcProgressWidth="4dp"
                            app:seekArcRoundEdges="true"
                            app:seekArcWidth="2dp"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_statistic_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            app:typeface="regular"/>
                    </p151v.VLinear>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:id="@+id/group_statistic_4"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.p058ui.view.SeekArc
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/seek_statistic_4"
                            android:padding="4dp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginLeft="22dp"
                            android:layout_marginRight="22dp"
                            app:seekArcColor="#eeeeee"
                            app:seekArcEnabled="false"
                            app:seekArcMax="100"
                            app:seekArcProgressColor="#3cdccc"
                            app:seekArcProgressWidth="4dp"
                            app:seekArcRoundEdges="true"
                            app:seekArcWidth="2dp"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_statistic_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            app:typeface="regular"/>
                    </p151v.VLinear>
                </p151v.VLinear>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/linear_tags"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <View
                    android:background="@color/tantan_lemon_white"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:paddingLeft="16dp"
                    android:paddingTop="11dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_GROUP_LABEL"/>
                <com.p051p1.mobile.putong.core.newui.group.ChatGroupTags
                    android:id="@+id/group_tags"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/linear_group_admin_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <View
                    android:background="@color/tantan_lemon_white"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
                <p151v.VRelative
                    android:id="@+id/item_group_admin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#505050"
                        android:id="@+id/tv_group_admin_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/CHAT_GROUP_LEADER"
                        android:layout_centerVertical="true"
                        app:typeface="regular"/>
                    <p151v.VImage
                        android:id="@+id/admin_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:src="0x7f081f64"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/admin_arrow"
                        android:layout_centerVertical="true">
                        <p151v.VDraweeView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/img_group_admin_avatar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:actualImageScaleType="centerCrop"
                            app:placeholderImage="0x7f08095c"
                            app:roundAsCircle="true"/>
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_group_admin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:maxLines="1"
                            android:layout_alignParentRight="true"/>
                        <p151v.VImage
                            android:layout_gravity="center_vertical"
                            android:id="@+id/pic_verification"
                            android:background="0x7f082957"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="4dp"/>
                    </p151v.VLinear>
                </p151v.VRelative>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/linear_group_description"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <View
                    android:background="@color/tantan_lemon_white"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:text="@string/CHAT_GROUP_INTRODUCTION_SHEZHI"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#909090"
                    android:id="@+id/tv_group_description"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="2dp"
                    app:typeface="regular"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/linear_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/frame_join_group_reason"
            android:background="@drawable/core_group_profile_join_reason_bg"
            android:paddingLeft="12dp"
            android:paddingTop="18dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VEditText
                android:textSize="15sp"
                android:textColor="#222222"
                android:textColorHint="#d0d0d0"
                android:gravity="top|left"
                android:id="@+id/edit_join_group_reason"
                android:background="@drawable/core_group_profile_description_edit_gray"
                android:paddingLeft="8.5dp"
                android:paddingTop="8dp"
                android:paddingRight="8.5dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="@string/CHAT_GROUP_JOIN_GROUP_REASON_NEW"
                android:maxLength="100"
                app:typeface="regular"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VButton
                android:enabled="true"
                android:textColor="@color/core_common_btn_color"
                android:gravity="center"
                android:id="@+id/btn_bottom_action"
                android:background="@drawable/core_message_my_custom_meme_orange_small_btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/CHAT_GROUP_APPLY_JOIN"/>
        </p151v.VFrame>
    </p151v.VLinear>
</p151v.VLinear>
