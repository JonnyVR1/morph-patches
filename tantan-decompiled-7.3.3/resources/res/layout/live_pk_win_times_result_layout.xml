<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.wintimes.PkWinTimesResultView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    flatten="true"
    folder="recreation"
    holder="pk.view.wintimes.PkWinTimesResultView">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/win_times_result_success"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.wintimes.PkWinTimesNumView
            android:layout_gravity="center_vertical"
            android:id="@+id/win_times_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/win_times_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/win_times_result_failed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.wintimes.PkWinTimesResultView>
