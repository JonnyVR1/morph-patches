<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/root"
    android:background="@drawable/core_profile_buttons_bg_expand"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="3dp"
    android:layout_width="match_parent"
    android:layout_height="161dp"
    flatten="true"
    holder="profile.profilelist.buttons.layout.VideoChatButtonLayout">
    <p151v.VLinear
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/core_profile_bottom_btn_divider"
        android:showDividers="middle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_goneMarginLeft="0dp">
        <p151v.VFrame_Shadow
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/superlike_shadow_single"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sl_cornerRadius="0dp"
            app:sl_dy="0dp"
            app:sl_shadowColor="#fff"
            app:sl_shadowRadius="0dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:background="@drawable/core_vip_onebtn_match_exp2_superlike_bg"
                android:layout_width="132dp"
                android:layout_height="48dp"
                android:layout_marginBottom="15dp">
                <p151v.VImage
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="20dp"
                    android:src="0x7f081219"
                    android:scaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/superlike_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:text="超级喜欢"/>
            </p151v.VLinear>
        </p151v.VFrame_Shadow>
        <p151v.VFrame_Shadow
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/chat_shadow_single"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sl_cornerRadius="0dp"
            app:sl_dy="0dp"
            app:sl_shadowColor="#fff"
            app:sl_shadowRadius="0dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:background="@drawable/core_profile_video_chat_chat_bg"
                android:layout_width="132dp"
                android:layout_height="48dp"
                android:layout_marginBottom="15dp">
                <p151v.VImage
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="20dp"
                    android:src="0x7f081444"
                    android:scaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/chat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="立即聊天"/>
            </p151v.VLinear>
        </p151v.VFrame_Shadow>
        <p151v.VFrame_Shadow
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/video_chat_shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sl_cornerRadius="0dp"
            app:sl_dy="0dp"
            app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
            app:sl_shadowRadius="0dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/core_profile_video_quick_chat_bg"
                android:layout_width="132dp"
                android:layout_height="48dp"
                android:layout_marginBottom="15dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f08150c"
                    android:scaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/videochat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频闪聊"
                    android:layout_marginStart="6dp"/>
            </p151v.VLinear>
        </p151v.VFrame_Shadow>
    </p151v.VLinear>
</FrameLayout>
