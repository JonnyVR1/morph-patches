<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="recreation"
    holder="multiplayerchat.view.AudienceApplyView">
    <View
        android:id="@+id/view_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_status_icon"
                    android:background="@drawable/live_bg_white_r16_a04"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="90dp"
                    android:layout_height="74dp"
                    android:src="0x7f082253"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"/>
                <p151v.VDraweeView
                    android:layout_gravity="left"
                    android:id="@+id/iv_head1"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:src="@drawable/live_vector_default_avatar_bg"
                    fresco:actualImageScaleType="centerCrop"
                    fresco:roundAsCircle="true"
                    fresco:roundingBorderColor="#19191e"
                    fresco:roundingBorderWidth="2dp"/>
                <p151v.VDraweeView
                    android:layout_gravity="right"
                    android:id="@+id/iv_head2"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:src="@drawable/live_vector_default_avatar_bg"
                    fresco:actualImageScaleType="centerCrop"
                    fresco:roundAsCircle="true"
                    fresco:roundingBorderColor="#19191e"
                    fresco:roundingBorderWidth="2dp"/>
                <ImageView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/iv_status_applying"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="0x7f082254"/>
            </FrameLayout>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/live_white"
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/LIVE_APPLY_VOICE_CALL_ANCHOR"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_CALL_PLEASE_OBSERVE"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#0386cd"
                    android:id="@+id/tv_criterion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_CIVILIZATION_CODE"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#40ffffff"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/live_bg_white_r20_a10"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="32dp"
                android:text="@string/LIVE_CONFIRM_APPLY"/>
        </LinearLayout>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/iv_show_help"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f08225e"/>
    </FrameLayout>
</LinearLayout>
