<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.root.VoiceRoomView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.root.VoiceRoomView">
    <include
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_intl_voice_background_view"/>
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/fans_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/close_area"
        app:layout_constraintEnd_toStartOf="@+id/close_area"
        app:layout_constraintStart_toEndOf="@+id/live_room_info"
        app:layout_constraintTop_toTopOf="@+id/close_area"
        flatten="true">
        <include
            android:id="@+id/voice_live_fans"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_voice_fans"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <include
        android:id="@+id/close_area"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="42dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_voice_close_area_view"/>
    <include
        android:id="@+id/pk_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/close_area"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/close_area"
        layout="@layout/live_voice_pk_mvp_view"/>
    <include
        android:id="@+id/live_room_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/close_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/fans_layout"
        app:layout_constraintTop_toTopOf="@+id/close_area"
        app:layout_constraintWidth_min="100dp"
        layout="@layout/live_voice_info_view"/>
    <include
        android:id="@+id/live_campaigns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/live_apply_manager"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true"
        layout="@layout/live_campaign_view"/>
    <include
        android:id="@+id/new_operation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/live_campaigns"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true"
        layout="@layout/live_voice_new_operation_layout"/>
    <FrameLayout
        android:id="@+id/live_deputy_widget"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_all_game_widget"/>
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/voice_operations_swallow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_all_game_widget"
        flatten="true">
        <include
            android:id="@+id/voice_operations"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true"
            layout="@layout/live_voice_operations_layout"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/room_tag_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fans_layout"
        flatten="true">
        <include
            android:id="@+id/heart_beat"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true"
            layout="@layout/live_voice_room_top_heartbeat"/>
        <include
            android:id="@+id/star_board_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            app:layout_constraintLeft_toRightOf="@+id/heart_beat"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/live_intl_star_board_entry"/>
        <include
            android:id="@+id/hour_board_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            app:layout_constraintLeft_toRightOf="@+id/star_board_entry"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true"
            layout="@layout/live_voice_hour_leader_board_entry"/>
        <include
            android:id="@+id/heat_box_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            app:layout_constraintLeft_toRightOf="@+id/hour_board_entry"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="140dp"
            flatten="true"
            layout="@layout/live_voice_heat_box_entry"/>
        <include
            android:id="@+id/notice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/chat_group"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true"
            layout="@layout/live_voice_room_top_notice"/>
        <include
            android:id="@+id/chat_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true"
            layout="@layout/live_voice_chat_group_enter_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/live_apply_manager"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toTopOf="@+id/live_chat_bottom_line"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true"
        layout="@layout/live_voice_call_apply_manager_layout"/>
    <include
        android:id="@+id/income_area_state_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_deputy_widget"
        flatten="true"
        layout="@layout/live_voice_income_area_state_view"/>
    <p151v.VFrame
        android:id="@+id/playing_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="86dp"
        android:layout_marginBottom="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/chat_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/income_area_state_view"
        app:layout_constraintVertical_bias="0"
        flatten="true">
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/voice_end"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="38dp"
            flatten="true"
            layout="@layout/live_voice_state_view"/>
    </p151v.VFrame>
    <include
        android:id="@+id/new_all_game_widget"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/room_tag_container"
        flatten="true"
        layout="@layout/live_voice_new_games_view"/>
    <View
        android:id="@+id/live_chat_top_line"
        android:layout_width="10dp"
        android:layout_height="1px"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/playing_area"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/chat_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="94dp"
        app:layout_constraintBottom_toTopOf="@+id/live_chat_bottom_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_chat_top_line"
        app:layout_constraintVertical_bias="1">
        <include
            android:id="@+id/live_chat"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/live_chat_list"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <include
        android:id="@+id/pk_time_view"
        android:visibility="gone"
        android:layout_width="135dp"
        android:layout_height="71dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_chat_top_line"
        layout="@layout/live_voice_pk_time_view"/>
    <include
        android:id="@+id/grab_hat_float"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_chat_top_line"
        layout="@layout/live_voice_grab_hat_float"/>
    <FrameLayout
        android:id="@+id/campaignGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toTopOf="@+id/live_chat_bottom_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_chat_top_line"
        app:layout_constraintVertical_bias="1"/>
    <View
        android:id="@+id/live_chat_bottom_line"
        android:layout_width="10dp"
        android:layout_height="1px"
        android:layout_marginBottom="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        flatten="true">
        <include
            android:layout_gravity="bottom"
            android:id="@+id/live_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            layout="@layout/live_voice_bottom"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <include
        android:id="@+id/live_player"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_voice_player_state_view"/>
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/gift_trays_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_chat_top_line">
        <include
            android:id="@+id/gift_trays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/live_gift_trays"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <com.p051p1.mobile.putong.live.livingroom.common.chat.danmaku.show.DanmakuViewPort
        android:id="@+id/danmaku_viewport"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="@+id/live_chat_top_line"/>
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/notification_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gift_trays_layout"
        flatten="true">
        <FrameLayout
            android:id="@+id/notification_view"
            android:visibility="gone"
            android:layout_width="183dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-3dp"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="230dp"
        android:layout_height="230dp"
        app:layout_constraintBottom_toTopOf="@+id/live_apply_manager"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/newCombo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="-50dp"
            android:layout_marginStart="40dp"
            layout="@layout/live_intl_gift_combo_view"/>
    </p151v.VLinear>
    <include
        android:id="@+id/voice_bullet"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_area"
        layout="@layout/live_voice_bullet_notice_container_view"/>
    <p151v.VFrame
        android:id="@+id/middle_layer"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.voice.intl.flymic.VoiceFlyMicContainer
            android:id="@+id/fly_mic_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/gift_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/live_gift_layer"/>
        <include
            android:id="@+id/top_effect_layer"
            layout="@layout/live_top_effect_layer"/>
    </p151v.VFrame>
    <include
        android:id="@+id/admission"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="-13dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_trays_layout"
        layout="@layout/live_gift_trays_admission"/>
    <p151v.VFrame
        android:id="@+id/topside_layer"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.voice.bubble.VoiceLiveBubbleView
            android:id="@+id/live_bubble"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"/>
        <View
            android:id="@+id/shadow"
            android:background="@color/live_black_60_opacity"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
    <FrameLayout
        android:id="@+id/super_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.root.VoiceRoomView>
