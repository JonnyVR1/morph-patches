<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalBigStyle2VirtualVoicePushView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui.home.bubble"
    holder="internalpush.LiveInternalBigStyle2VirtualVoicePushView">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="189dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/background_view"
            android:background="@drawable/core_internal_push_bubble_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="实时群聊"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="0x7f080a18"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="42dp"
            android:layout_marginRight="16dp">
            <p151v.VFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.AutoVDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="108dp"
                    android:layout_height="132dp"
                    app:actualImageScaleType="centerCrop"
                    app:roundedCornerRadius="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="在线"
                    android:drawablePadding="3dp"
                    android:drawableStart="@drawable/core_live_internal_push_online_12_bg"
                    android:layout_marginStart="9dp"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp">
                    <p151v.VText
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#cc000000"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_height="25dp"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                    <p151v.VText
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tag"
                        android:background="@drawable/core_internal_push_bubble_tag_bg"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginBottom="1dp"/>
                </p151v.VLinear>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="#66000000"
                    android:ellipsize="end"
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"/>
                <p151v.VButton
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#e89e4d"
                    android:gravity="center"
                    android:id="@+id/button"
                    android:background="@drawable/core_internal_push_bubble_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalBigStyle2VirtualVoicePushView>
