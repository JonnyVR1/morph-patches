<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reports"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileReportItemHolder"
    style="@style/profile_item_frame_no_padding_ab">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="12dp"
            android:src="0x7f08121c"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#dcdcdc"
            android:gravity="center"
            android:id="@+id/report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="举报"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="20dp"
            android:src="0x7f08121c"/>
    </LinearLayout>
</p151v.VLinear_Dividers>
