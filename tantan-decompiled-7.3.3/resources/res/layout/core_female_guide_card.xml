<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.femalevip.FemaleVipGuideCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_vieww"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    folder="newui"
    holder="femalevip.FemaleVipGuideCardView">
    <p151v.VImage
        android:background="0x7f080853"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VRelative
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/title_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:src="0x7f0805b3"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="#bf499a"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="她专享会员"
            android:layout_below="@+id/title_icon"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#6690266f"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="获取男性用户探探信用分，了解他的性格\10特点，安全高效交友"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"/>
        <p151v.VImage
            android:id="@+id/container_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="128dp"
            android:src="0x7f080854"
            android:layout_below="@+id/subtitle"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#f574cd"
            android:gravity="center"
            android:id="@+id/send_btn"
            android:background="@drawable/core_card_button_bg_white_normal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="40dp"
            android:text="立刻获取"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="56dp"
            android:lineHeight="22.4dp"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.newui.femalevip.FemaleVipGuideCardView>
