<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/stat_likes"
    android:paddingLeft="16dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    holder="profile.profilelist.itemholders.ProfileStatLikesItemHolder"
    style="@style/profile_item_frame_no_padding">
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/text_medium"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawableLeft="0x7f080f27"
            android:drawablePadding="32dp"
            android:layout_weight="100"/>
        <p151v.VButton
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/share"
            android:background="@drawable/tf_rect_light"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160dp"
            android:minWidth="85dp"
            android:minHeight="48dp"
            android:text="@string/PROFILE_SHARE_LIKES_BUTTON"
            android:singleLine="true"
            android:textAllCaps="true"
            app:typeface="medium"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#42000000"
        android:id="@+id/guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="56dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="18dp"
        android:text="@string/PROFILE_GET_MORE_LIKES_TIPS"/>
</LinearLayout>
