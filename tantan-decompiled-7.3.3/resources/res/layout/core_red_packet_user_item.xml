<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.redpacket.RedPacketUserItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.redpacket.RedPacketUserItemView">
    <p151v.VDraweeView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/user_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="11dp"
        android:layout_centerVertical="true"
        style="@style/core_im_fresco_profile_small"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_detail_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/amount_layout"
        android:layout_toRightOf="@+id/user_image"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="5sp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#bfbfbf"
            android:layout_gravity="center"
            android:id="@+id/red_packet_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="5sp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/amount_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="15dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/user_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="5sp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/highest_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/highest_image"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:src="0x7f08161a"
                android:layout_weight="0"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="13sp"
                android:textStyle="normal"
                android:textColor="#ffd918"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手气最佳"
                android:lineSpacingExtra="5sp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider_view"
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/user_image"/>
</com.p051p1.mobile.putong.core.p058ui.messages.redpacket.RedPacketUserItemView>
