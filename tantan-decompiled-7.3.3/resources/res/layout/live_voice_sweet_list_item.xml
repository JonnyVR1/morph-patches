<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="134dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetListItemView">
    <ImageView
        android:id="@+id/iv_level_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f082827"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:id="@+id/tvCpValue"
        android:paddingTop="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="奢华度:9090"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvCpRankView"
        app:layout_constraintStart_toStartOf="@+id/tvCpRankView"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tvCpRankView"
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:id="@+id/tvCpHouseLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="小屋等级:LV.10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/cpView"
        android:layout_width="wrap_content"
        android:layout_height="81dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/live_voice_sweet_cp_head_layout"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetListItemView>
