<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.intl.visitor.IntlVisitorsItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="ui"
    holder="intl.visitor.IntlVisitorsItemView">
    <p151v.VRelative
        android:id="@+id/comment_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/profile"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            style="@style/core_fresco_profile_small"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/button"
            android:layout_toEndOf="@+id/profile"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <FrameLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/core_color_cc000000"
                            android:ellipsize="end"
                            android:layout_gravity="center"
                            android:id="@+id/title"
                            android:padding="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/title_cover"
                            android:visibility="gone"
                            android:layout_width="116dp"
                            android:layout_height="20dp"
                            android:scaleType="fitStart"/>
                    </FrameLayout>
                </p151v.VLinear>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:id="@+id/visitor_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:layout_below="@+id/content_container"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundTextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="end"
            android:id="@+id/button"
            android:background="#fe7e1c"
            android:paddingLeft="12dp"
            android:paddingTop="7dp"
            android:paddingRight="12dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            android:letterSpacing="0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            app:rRadius="10dp"
            app:typeface="medium"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.intl.visitor.IntlVisitorsItemView>
