<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="300dp">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/root"
        android:clipChildren="false"
        android:layout_width="225dp"
        android:layout_height="300dp">
        <p151v.VDraweeView
            android:id="@+id/img"
            android:background="@drawable/core_intl_ultra_salvage_item_bg"
            android:padding="1.5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="24dp"/>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/activeRoot"
            android:background="#60df88"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="-10dp"
            android:paddingHorizontal="12dp"
            app:rRadius="60dp">
            <com.p051p1.mobile.android.p053ui.RoundedView
                android:background="@color/black"
                android:layout_width="6dp"
                android:layout_height="6dp"
                app:roundedCornerRadius="6dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/tvActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toTopOf="@+id/nameContain"
                app:layout_constraintStart_toStartOf="parent"
                app:typeface="medium"/>
        </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:background="@drawable/core_intl_ultra_salvage_item_bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="1.5dp"
            android:paddingStart="16dp">
            <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundRelativeLayout
                android:layout_gravity="end"
                android:background="@color/white"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="-30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rRadius="60dp">
                <View
                    android:id="@+id/super_like"
                    android:background="0x7f080cbd"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"/>
                <p151v.VText
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:id="@+id/super_like_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/INTL_RECENTLY_GOT_COUNT"
                    android:paddingEnd="16dp"
                    android:layout_toEndOf="@+id/super_like"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="17sp"
                    android:textColor="@color/black"
                    android:id="@+id/super_like_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:layout_below="@+id/super_like_desc"
                    android:layout_toEndOf="@+id/super_like"
                    app:typeface="medium"/>
            </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundRelativeLayout>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#b2ffffff"
                android:ellipsize="end"
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:maxLines="1"
                app:typeface="medium"/>
            <p151v.VLinear_FillerMeasure
                android:orientation="horizontal"
                android:id="@+id/nameContain"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="74dp"
                app:fillerIndex="0">
                <p151v.VText
                    android:textSize="23dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:layout_gravity="top|left"
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    app:typeface="medium"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivStar"
                    android:background="0x7f080cb5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="20dp"/>
            </p151v.VLinear_FillerMeasure>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
