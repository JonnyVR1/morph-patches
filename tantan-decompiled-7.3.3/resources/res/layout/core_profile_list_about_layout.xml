<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_fame"
    android:background="@color/core_profile_background"
    android:paddingTop="9dp"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileAboutItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VText
        android:id="@+id/about_me_title"
        android:paddingTop="12dp"
        android:text="@string/PROFILE_SELF_INTRODUCTION"
        style="@style/profile_item_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/about_me_layout"
        android:background="@drawable/tf_rect_light"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"
            android:layout_marginEnd="32dp"
            app:srcCompat="@drawable/profile_desc_ic"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_light"
            android:gravity="center"
            android:id="@+id/about_me"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:hint="@string/ADD_SELF_INTRODUCTION"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_333333"
        android:gravity="center_horizontal"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tip_user_risk"
        android:background="@drawable/core_intl_intr_risk_warn_bg"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/EDIT_SELF_INTRODUTION_NOTICE"
        android:drawablePadding="3dp"
        android:drawableStart="0x7f080ad5"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</p151v.VLinear_Dividers>
