<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.topBar.VoiceVirtualRoomInfoTopBarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    flatten="true"
    holder="virtual.roomInfo.topBar.VoiceVirtualRoomInfoTopBarView">
    <ImageView
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f082352"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/cover"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:id="@+id/grade"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_marginBottom="-3dp"
        app:layout_constraintBottom_toBottomOf="@+id/cover"
        app:layout_constraintLeft_toLeftOf="@+id/cover"
        app:layout_constraintRight_toRightOf="@+id/cover"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_room_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/cover"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.view.FocusTextView
            android:textSize="14sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/room_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="118dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:shadowColor="#3f000000"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:marqueeRepeatLimit="marquee_forever"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/room_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="11sp"
        android:textStyle="normal"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/settle_btn"
        android:background="@drawable/live_bg_fe7e1d_r8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="@string/VOICE_VIRTUAL_ROOM_INFO_CHECK_IN"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_room_info"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.topBar.VoiceVirtualRoomInfoTopBarView>
