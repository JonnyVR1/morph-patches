<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.active.SeeActiveCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="active.SeeActiveCard">
    <p151v.VDraweeView
        android:id="@+id/iv_cardpic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/iv_see_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="64dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/common_card_image_holder_full_round"
            app:failureImageScaleType="centerInside"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="20dp"
            style="@style/core_fresco_base"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/vl_head_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="#ffffff"
            android:gravity="top|center_horizontal"
            android:id="@+id/tv_see_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vl_head_layout"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="top|center_horizontal"
            android:id="@+id/tv_see_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_see_title"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="#ffb517"
            android:layout_gravity="bottom"
            android:id="@+id/btn_bottom"
            android:background="@drawable/core_live_active_button"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="57dp"
            android:textAllCaps="false"
            android:layout_marginStart="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginEnd="56dp"
            style="?android:attr/borderlessButtonStyle"/>
        <p151v.VImage
            android:id="@+id/iv_close"
            android:background="0x7f080cd3"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_bottom"
            app:layout_constraintTop_toTopOf="@+id/btn_bottom"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:id="@+id/tv_price"
            android:background="@drawable/core_intl_see_active_price"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_bottom"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.active.SeeActiveCard>
