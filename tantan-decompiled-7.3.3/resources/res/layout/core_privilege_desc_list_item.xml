<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.item.PrivilegeDescListItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp"
    holder="vip.privilege.content.item.PrivilegeDescListItem">
    <p151v.VIcon
        android:id="@+id/icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        android:maxLines="1"
        android:layout_toRightOf="@+id/icon"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/describe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/icon"
        android:layout_below="@+id/title"/>
</com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.item.PrivilegeDescListItem>
