<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="tarot.TarotCreateDialog">
    <p151v.VButton
        android:id="@+id/close"
        android:background="0x7f080c72"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="28sp"
        android:textColor="#ffe19a"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/INTL_TAROT_SELFCHOOSEPOP_TITLE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ffff"
        android:gravity="center"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="26dp"
        android:text="@string/INTL_TAROT_SELFCHOOSEPOP_TEXT"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/content">
        <p151v.VRadioButton
            android:id="@+id/radio_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:drawableTop="@drawable/core_intl_tarot_left_selector"
            android:layout_weight="1"/>
        <p151v.VRadioButton
            android:id="@+id/radio_center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:drawableTop="@drawable/core_intl_tarot_center_selector"
            android:layout_weight="1"/>
        <p151v.VRadioButton
            android:id="@+id/radio_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:drawableTop="@drawable/core_intl_tarot_right_selector"
            android:layout_weight="1"/>
    </RadioGroup>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/bottom_button"
        android:background="@drawable/core_intl_tarot_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="52dp"
        android:layout_marginRight="52dp"
        android:text="@string/INTL_TAROT_SELFCHOOSEPOP_BUTTON"
        android:alpha="0.5"
        app:layout_constraintTop_toBottomOf="@+id/radio_group"/>
</androidx.constraintlayout.widget.ConstraintLayout>
