<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersBigCardItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_likers_card_item_bg_normal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    app:cardCornerRadius="@dimen/core_vip_normal_card_corner"
    app:cardElevation="0dp"
    holder="vip.likers.LikersBigCardItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:id="@+id/left_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <LinearLayout
        android:gravity="top|right"
        android:layout_gravity="top|right"
        android:id="@+id/pic_verification_container"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/verification_icon"
            android:background="0x7f082957"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/dislike"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="7dp"
        android:src="0x7f082106"/>
    <p151v.VImage
        android:layout_gravity="left"
        android:id="@+id/like"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="7dp"
        android:src="0x7f082105"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/right_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            flatten="true">
            <ImageView
                android:id="@+id/like_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f081653"/>
            <ImageView
                android:id="@+id/quick_greeting"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f082107"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/right_button_container"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_zodiac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="17dp"
                android:maxLines="1"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                app:typeface="medium"/>
            <p151v.VLinear_FillerMeasure
                android:gravity="center_vertical"
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:minHeight="20dp"
                android:layout_above="@+id/tv_zodiac"
                android:layout_alignStart="@+id/tv_zodiac"
                app:fillerIndex="0"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重生的小胖"
                    android:maxLines="1"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/age"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:typeface="medium"/>
            </p151v.VLinear_FillerMeasure>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_card_user_text_color_b2ffffff"
                android:gravity="center_vertical"
                android:id="@+id/active"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-2dp"
                android:layout_marginBottom="4dp"
                android:text="@string/SEE_LIST_SORT_ACTIVITY"
                android:drawablePadding="3dp"
                android:layout_above="@+id/info"
                android:drawableStart="0x7f080d45"
                android:layout_alignStart="@+id/info"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_card_user_text_color_b2ffffff"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/distance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:maxLines="1"
                android:layout_above="@+id/info"
                android:layout_alignStart="@+id/info"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersBigCardItemView>
