<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.applymanager.apply.VoiceCallApplyListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    flatten="true"
    holder="voice.applymanager.apply.VoiceCallApplyListItemView">
    <FrameLayout
        android:id="@+id/head_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/iv_head"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_centerVertical="true"
            fresco:actualImageScaleType="centerCrop"
            fresco:failureImage="@drawable/live_vector_default_avatar_bg"
            fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
            fresco:roundAsCircle="true"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/boss"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f08275e"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="6"
        android:singleLine="true"
        android:layout_toRightOf="@+id/head_container"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"/>
    <FrameLayout
        android:id="@+id/fl_status"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="53dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_operation"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:maxLength="6"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_connecting"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f082770"/>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.applymanager.apply.VoiceCallApplyListItemView>
