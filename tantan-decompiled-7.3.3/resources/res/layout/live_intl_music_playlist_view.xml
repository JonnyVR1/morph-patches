<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#2a2f37"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/top_bg"
        android:background="0x7f082371"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/navigation_space"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:id="@+id/edit_view"
        android:background="@drawable/live_bg_66000000_r10"
        android:layout_width="74dp"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_MY_MUSIC_EDIT"
        app:layout_constraintBottom_toBottomOf="@+id/navigation_space"
        app:layout_constraintRight_toRightOf="@+id/navigation_space"
        app:layout_constraintTop_toTopOf="@+id/navigation_space"/>
    <p151v.VImage
        android:id="@+id/back_view"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:src="0x7f082366"
        app:layout_constraintBottom_toBottomOf="@+id/navigation_space"
        app:layout_constraintLeft_toLeftOf="@+id/navigation_space"
        app:layout_constraintTop_toTopOf="@+id/navigation_space"/>
    <p151v.VText
        android:textSize="21sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_MY_MUSIC_TITLE"
        app:layout_constraintBottom_toBottomOf="@+id/navigation_space"
        app:layout_constraintLeft_toRightOf="@+id/back_view"
        app:layout_constraintTop_toTopOf="@+id/navigation_space"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/live_control_panel"
        android:background="0x7f082368"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_space">
        <p151v.VImage
            android:id="@+id/cover_bg"
            android:background="0x7f082367"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_control_panel"
            app:layout_constraintLeft_toLeftOf="@+id/live_control_panel"
            app:layout_constraintTop_toTopOf="@+id/live_control_panel"/>
        <p151v.VDraweeView
            android:id="@+id/cover_pic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/cover_bg"
            app:layout_constraintLeft_toLeftOf="@+id/cover_bg"
            app:layout_constraintRight_toRightOf="@+id/cover_bg"
            app:layout_constraintTop_toTopOf="@+id/cover_bg"
            app:placeholderImage="0x7f082369"
            app:roundAsCircle="true"/>
        <p151v.VMarqueeText
            android:textSize="15sp"
            android:textColor="#ccffffff"
            android:ellipsize="marquee"
            android:id="@+id/music_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="184dp"
            android:text="@string/INTL_LOCAL_MUSIC_PLAY_MIXER_EMPTY"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/live_control_panel"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/cover_bg"
            app:layout_constraintRight_toRightOf="@+id/live_control_panel"
            app:layout_constraintTop_toTopOf="@+id/live_control_panel"/>
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/volume_view"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f08237b"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_control_panel"
            app:layout_constraintRight_toRightOf="@+id/live_control_panel"
            app:layout_constraintTop_toTopOf="@+id/live_control_panel"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/volume_hide_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_control_panel"
            app:layout_constraintRight_toLeftOf="@+id/volume_view"
            app:layout_constraintTop_toTopOf="@+id/live_control_panel">
            <p151v.VImage
                android:id="@+id/pause_view"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:src="0x7f082375"/>
            <p151v.VImage
                android:id="@+id/mode_view"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:src="0x7f082374"/>
            <p151v.VImage
                android:id="@+id/next_view"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:src="0x7f08236f"/>
        </p151v.VLinear>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/volume_bar"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="132dp"
            android:layout_height="14dp"
            android:layout_marginRight="42dp"
            android:maxHeight="4dp"
            android:progressDrawable="@drawable/live_intl_music_seek_bar"
            android:minHeight="4dp"
            android:thumb="@drawable/live_shape_ktv_tuning_seek_bar_thumb"
            app:layout_constraintBottom_toBottomOf="@+id/volume_view"
            app:layout_constraintRight_toRightOf="@+id/live_control_panel"
            app:layout_constraintTop_toTopOf="@+id/volume_view"/>
        <View
            android:id="@+id/disable_view"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/mask_view"
            android:background="0x7f08236a"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VRecyclerView
        android:id="@+id/live_music_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_control_panel"
        app:layout_constraintVertical_bias="0"/>
    <View
        android:background="0x7f08236d"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/content_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_control_panel,live_music_list"/>
    <p151v.VImage
        android:id="@+id/live_empty_icon"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="88dp"
        android:src="0x7f082370"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_space"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#4dffffff"
        android:gravity="center"
        android:id="@+id/live_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="48dp"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_MY_MUSIC_EMPTY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_empty_icon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/empty_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_empty_icon,live_empty_text"/>
    <p151v.VButton
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/add_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_ADD_MUSIC"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/delete_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <p151v.VImage
            android:id="@+id/check_view"
            android:background="@drawable/live_selector_voice_preview"
            android:layout_width="22dp"
            android:layout_height="22dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e6ffffff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/INTL_LOCAL_MUSIC_PLAY_SELECT_ALL"
            android:layout_weight="1"/>
        <p151v.VButton
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/delete_button"
            android:background="@drawable/live_bg_fe7e1d_r16"
            android:layout_width="183dp"
            android:layout_height="56dp"
            android:text="@string/INTL_LOCAL_MUSIC_PLAY_DELETE"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
