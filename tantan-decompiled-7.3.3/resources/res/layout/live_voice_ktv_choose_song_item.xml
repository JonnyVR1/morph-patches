<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.KtvChooseSongItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    flatten="true"
    folder="virtual.ktv.view"
    holder="KtvChooseSongItem">
    <p151v.VDraweeView
        android:id="@+id/music_icon"
        android:layout_width="66dp"
        android:layout_height="66dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="10dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/best_singer_score"
        android:background="@drawable/live_bg_6006aa_r4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="63dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_icon"
        app:layout_constraintEnd_toEndOf="@+id/music_icon"
        app:layout_constraintStart_toStartOf="@+id/music_icon"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/music_name"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/choose_music"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/music_icon"
        app:layout_constraintTop_toTopOf="@+id/music_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/music_anchor"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/choose_music"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/music_name"
        app:layout_constraintTop_toBottomOf="@+id/music_name"/>
    <p151v.VDraweeView
        android:id="@+id/best_singer_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="3dp"
        app:actualImageScaleType="fitXY"
        app:failureImage="0x7f0827c4"
        app:layout_constraintStart_toStartOf="@+id/music_anchor"
        app:layout_constraintTop_toBottomOf="@+id/music_anchor"
        app:placeholderImage="0x7f0827c4"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/best_singer_name"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/choose_music"
        app:layout_constraintStart_toEndOf="@+id/best_singer_icon"
        app:layout_constraintTop_toTopOf="@+id/best_singer_icon"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@drawable/live_selector_voice_ktv_choose_song_bt_text_color"
        android:gravity="center"
        android:id="@+id/choose_music"
        android:background="@drawable/live_selector_voice_ktv_choose_song_bt"
        android:layout_width="52dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.KtvChooseSongItem>
