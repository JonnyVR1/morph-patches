<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#66000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="征婚宣言"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:id="@+id/left_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:maxLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:typeface="medium"/>
    <p151v.VImage
        android:id="@+id/required_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080dc1"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/left_text"
        app:layout_constraintStart_toEndOf="@+id/left_text"
        app:layout_constraintTop_toTopOf="@+id/left_text"/>
    <p151v.VImage
        android:id="@+id/edit_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f0814b5"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <p151v.VImage
        android:id="@+id/right_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f0814b6"
        app:layout_constraintBottom_toBottomOf="@+id/left_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/left_text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17.5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
