<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="status.post.FeedPostStatusViewModel">
    <com.p051p1.mobile.putong.feed.newui.status.display.view.FeedStatesMediaView
        android:id="@+id/media_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/cover"
        android:background="@drawable/feed_state_card_bg_shodow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:src="0x7f081efc"/>
    <p151v.VRelative
        android:id="@+id/state_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/location"
            android:background="@drawable/feed_mystatus_post_bg_text_location"
            android:paddingLeft="14dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="20dp"
            android:hint="@string/MOMENTS_CAPTION_ADD_LOCATION_CELL_TITLE"
            android:singleLine="true"
            android:drawableLeft="0x7f081dda"
            android:drawableRight="0x7f081dd9"
            android:drawablePadding="5dp"
            android:layout_alignParentBottom="true"
            android:paddingStart="14dp"/>
        <p151v.VEditText
            android:textSize="22sp"
            android:textColor="@color/white"
            android:textColorHint="#b3ffffff"
            android:id="@+id/status_edit"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:hint="说说你的状态..."
            android:maxLines="3"
            android:layout_above="@+id/location"
            android:textCursorDrawable="@drawable/feed_states_cursor_bg"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/emotion_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开心"
            android:layout_above="@+id/status_edit"
            android:layout_centerHorizontal="true"/>
        <p151v.VImage
            android:id="@+id/emotion_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081efe"
            android:layout_toRightOf="@+id/emotion_tv"
            android:layout_alignTop="@+id/emotion_tv"
            android:layout_alignBottom="@+id/emotion_tv"/>
        <p151v.VDraweeView
            android:id="@+id/emotion_img"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="0x7f081efd"
            android:layout_above="@+id/emotion_tv"
            android:layout_centerHorizontal="true"/>
    </p151v.VRelative>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentBottom="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/post_album_media"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081ddc"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/post"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/post"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/post_album_camera"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="32dp"
            android:src="0x7f081dd7"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/post"
            app:layout_constraintLeft_toRightOf="@+id/post_album_media"
            app:layout_constraintTop_toTopOf="@+id/post"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/post_location"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="32dp"
            android:src="0x7f081dd8"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/post"
            app:layout_constraintLeft_toRightOf="@+id/post_album_camera"
            app:layout_constraintTop_toTopOf="@+id/post"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/feed_my_status_post_color"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/post"
            android:background="@drawable/feed_mystatus_post_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginBottom="12dp"
            android:text="@string/FEED_RELEASE"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VRelative>
