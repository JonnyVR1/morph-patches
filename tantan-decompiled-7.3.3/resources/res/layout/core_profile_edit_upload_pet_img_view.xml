<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileLoopEditPetUploadPhoto xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="40dp"
    flatten="true"
    holder="profile.views.ProfileLoopEditPetUploadPhoto">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#4d000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="上传宠物照片"
        app:typeface="medium"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/photo_container"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <FrameLayout
            android:id="@+id/photo_container_1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/photo_1"
                android:background="0x7f0810bf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/delete_1"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f081456"
                android:layout_marginEnd="8dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/photo_container_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/photo_2"
                android:background="0x7f0810bf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/delete_2"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f081456"
                android:layout_marginEnd="8dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/photo_container_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/photo_3"
                android:background="0x7f0810bf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/delete_3"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f081456"
                android:layout_marginEnd="8dp"/>
        </FrameLayout>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileLoopEditPetUploadPhoto>
