<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/shadow"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:background="@drawable/feed_share_my_state_bg"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/feed_select_and_post_state_header_bg"
            android:layout_width="match_parent"
            android:layout_height="240dp"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/dialog_ll"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center"
                android:id="@+id/view_line"
                android:background="@drawable/common_handlebar_handler"
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="20sp"
                android:textColor="#010101"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="分享状态，与好友即刻开聊"
                android:lineSpacingExtra="1sp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_chat_input_enable_false"
                android:layout_gravity="center_horizontal"
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="24小时后将自动消失"
                android:lineSpacingExtra="7sp"/>
            <p151v.VFrame
                android:layout_width="match_parent"
                android:layout_height="119dp"
                android:layout_marginTop="18dp">
                <com.p051p1.mobile.putong.feed.newui.status.display.view.FeedSmoothSpeedRecycle
                    android:id="@+id/state_recycle"
                    android:background="@color/transparent"
                    android:scrollbars="none"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:divider="@null"
                    useId="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#e6000000"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/my_state_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/state_recycle"/>
            </p151v.VFrame>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/input_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp">
                <p151v.VEditText
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:textColorHint="@color/feed_comment_reply_text_color"
                    android:gravity="center"
                    android:id="@+id/input"
                    android:background="@drawable/feed_state_status_cursor_bg"
                    android:paddingLeft="20dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:hint="说说你的此刻状态..."
                    android:singleLine="true"
                    android:maxLength="30"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/feed_guide_states_cursor_bg"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/post"
                android:background="@drawable/feed_comment_send_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                android:text="去发布"/>
        </p151v.VLinear>
    </p151v.VFrame>
</FrameLayout>
