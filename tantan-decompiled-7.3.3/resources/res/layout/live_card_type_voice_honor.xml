<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.honorgift.LiveVoiceHonorCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_feed_card_bg"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:layout_margin="4dp">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:id="@+id/title_image"
        android:layout_width="66dp"
        android:layout_height="14dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="23dp"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#99f0bd71"
        android:ellipsize="end"
        android:layout_gravity="left"
        android:id="@+id/content"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="21dp"
        android:layout_marginTop="44dp"/>
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="21dp">
        <p151v.VFrame
            android:layout_width="40dp"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/left_user_icon1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/left_user_icon2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                app:roundAsCircle="true"/>
            <View
                android:background="@drawable/live_shape_bg_honor_gift_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <p151v.VText
                android:textSize="8sp"
                android:textColor="#99f0bd71"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/left_user_name"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:singleLine="true"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/gift_icon1"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <p151v.VDraweeView
                android:id="@+id/gift_icon2"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_width="40dp"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/right_user_icon1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/right_user_icon2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                app:roundAsCircle="true"/>
            <View
                android:background="@drawable/live_shape_bg_honor_gift_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <p151v.VText
                android:textSize="8sp"
                android:textColor="#99f0bd71"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/right_user_name"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:singleLine="true"/>
        </p151v.VFrame>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.honorgift.LiveVoiceHonorCardView>
