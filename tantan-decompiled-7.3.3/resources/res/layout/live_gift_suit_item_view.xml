<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.suit.view.GiftSuitItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="125dp"
    flatten="true"
    folder="increment"
    holder="gift.suit.view.GiftSuitItemView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/icon_root"
        android:clipChildren="false"
        android:layout_width="70dp"
        android:layout_height="89dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/gift_icon_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/gift_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="@+id/gift_icon_bg"
            app:layout_constraintStart_toStartOf="@+id/gift_icon_bg"
            app:layout_constraintTop_toTopOf="@+id/gift_icon_bg"/>
        <p151v.VText
            android:textSize="11sp"
            android:gravity="center"
            android:id="@+id/gift_count"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="44dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
            app:layout_constraintStart_toStartOf="@+id/gift_icon"/>
        <p151v.VText
            android:textSize="11sp"
            android:gravity="center"
            android:id="@+id/gift_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="2sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VDraweeView
        android:id="@+id/send_gift_bt_bg"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:minWidth="70dp"
        android:minHeight="28dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:gravity="center"
        android:id="@+id/send_gift_bt"
        android:layout_width="70dp"
        android:layout_height="28dp"
        android:maxLines="1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="2sp"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.suit.view.GiftSuitItemView>
