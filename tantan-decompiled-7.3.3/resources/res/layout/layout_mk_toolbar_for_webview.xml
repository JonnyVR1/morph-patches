<?xml version="1.0" encoding="utf-8"?>
<com.hellogroup.p036mk.business.widget.CompatAppbarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appbar_id"
    style="@style/CompatAppbarLayout">
    <ImageView
        android:id="@+id/web_toolbar_loading"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/actionBarSize"
        android:src="@drawable/ic_mk_inner_wrapper_loading"
        android:scaleType="centerInside"
        android:minWidth="48dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_id"
        android:layout_toLeftOf="@+id/web_toolbar_loading"
        app:title=""
        style="@style/MKToolBarStyle">
        <ImageView
            android:id="@+id/web_close_button"
            android:paddingLeft="0dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_toolbar_close_gray_24dp"/>
        <TextView
            android:textAppearance="@style/MKToolbarTitleText"
            android:textColor="@color/toolbar_title_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/web_title_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="1"
            android:isScrollContainer="true"/>
    </androidx.appcompat.widget.Toolbar>
</com.hellogroup.p036mk.business.widget.CompatAppbarLayout>
