<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.operation.OperationItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="44dp"
    android:layout_height="wrap_content"
    android:minWidth="40dp"
    flatten="true"
    folder="increment.operation"
    holder="OperationItemView">
    <RelativeLayout
        android:id="@+id/operation"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/operation_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerInParent="true"
            app:failureImage="0x7f08242a"/>
        <com.p051p1.mobile.putong.live.livingroom.increment.operation.OperationCountDownCircleView
            android:layout_gravity="center"
            android:id="@+id/count_down_icon"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <p151v.VDraweeView
        android:id="@+id/mask"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:roundedCornerRadius="8dp"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/label"
        android:background="@drawable/live_shape_operation_item_label_bg"
        android:paddingTop="0.5dp"
        android:visibility="gone"
        android:layout_width="17dp"
        android:layout_height="13dp"
        android:paddingStart="0.5dp"/>
    <p151v.VMarqueeText
        android:textSize="9sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/count_down_text"
        android:background="@drawable/live_bg_black_r4_a20"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:maxWidth="45dp"
        android:minWidth="15dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:layout_below="@+id/operation"
        android:layout_centerHorizontal="true"
        android:marqueeRepeatLimit="marquee_forever"/>
</com.p051p1.mobile.putong.live.livingroom.increment.operation.OperationItemView>
