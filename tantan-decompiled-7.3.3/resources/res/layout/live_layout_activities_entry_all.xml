<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesEntryAll xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    flatten="true"
    folder="view"
    holder="widgets.LiveActivitiesEntryAll">
    <com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesEntryAnimBackground
        android:layout_gravity="end|bottom"
        android:id="@+id/anim_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <FrameLayout
        android:layout_gravity="right"
        android:id="@+id/player_container"
        android:visibility="gone"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_margin="2dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/half_cover"
            android:background="@drawable/live_shape_bg_half_cover"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/pic_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga"
            android:layout_width="28dp"
            android:layout_height="35dp"
            android:layout_marginLeft="8dp"/>
        <p151v.VDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="37dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/live_shape_banner_profile_placeholder"
            app:roundedCornerRadius="9dp"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="55dp"
        flatten="true">
        <p151v.VMarqueeText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:fontFamily="PingFangSC-Semibold"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="marquee"
            android:id="@+id/desc_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:fontFamily="PingFangSC-Regular"/>
    </LinearLayout>
    <p151v.VFrame
        android:layout_gravity="end|center_vertical"
        android:id="@+id/img_close"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            app:srcCompat="0x7f082331"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesEntryAll>
