<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.onlinematch.view.OnlineMatchNewUiCard2PeiLiaoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_vieww"
    android:background="@drawable/common_card_image_holder_full_round"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    holder="onlinematch.view.OnlineMatchNewUiCard2PeiLiaoView">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/image"
            layout="@layout/profile_picture_item"/>
        <View
            android:id="@+id/image_bottom_shadow_cover"
            android:background="@drawable/core_card_bottom_shadow_cover_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="103dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_shadow_cover"
            android:background="@drawable/core_card_bottom_shadow_cover_1_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </p151v.VFrame>
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0812df"
        android:scaleType="fitXY"/>
    <com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout
        android:gravity="center_vertical"
        android:id="@+id/top_left_container"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:measureLayoutOrientation="horizontal"
        app:measureReverse="true"
        flatten="true">
        <p151v.VText
            android:ellipsize="end"
            android:id="@+id/type"
            android:layout_marginRight="5dp"
            android:maxLines="1"
            android:singleLine="true"
            android:drawablePadding="2dp"
            style="@style/core_card_small_tag"/>
        <p151v.VLinear
            android:id="@+id/certification_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"/>
        <p151v.VText
            android:id="@+id/on_line"
            android:paddingLeft="8dp"
            android:text="当前在线"
            style="@style/core_card_small_tag"/>
    </com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="80dp">
            <include
                android:id="@+id/card_bottom_info"
                android:layout_width="match_parent"
                layout="@layout/core_card_bottom_basic_info"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/describe"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom|right"
            android:id="@+id/have_a_chat"
            android:background="@drawable/core_bg_10_33ffffff"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:drawablePadding="2dp"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.onlinematch.view.OnlineMatchNewUiCard2PeiLiaoView>
