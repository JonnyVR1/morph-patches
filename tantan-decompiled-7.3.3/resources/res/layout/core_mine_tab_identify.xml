<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.IdentifyView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="profile.newmine.newprofile.view.IdentifyView">
    <RelativeLayout
        android:id="@+id/auth_parent"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        flatten="true">
        <com.p051p1.mobile.android.p053ui.label.CommonTextureFrameLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/edit_renzheng_content"
            android:background="@drawable/common_view_card_small_01_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:paddingHorizontal="8dp"
            flatten="true">
            <p151v.VLinear
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <p151v.VLinear
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/avatar_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tab_identify_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="0x7f081017"/>
                <p151v.VText
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_80"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/edit_renzheng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/VERIFICATION_CENTER_TITLE"
                    android:layout_marginStart="4dp"
                    app:typeface="medium"/>
                <p151v.VImage
                    android:gravity="center_vertical"
                    android:layout_gravity="right"
                    android:id="@+id/tab_right_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="0x7f081019"
                    android:layout_marginStart="1dp"/>
            </p151v.VLinear>
        </com.p051p1.mobile.android.p053ui.label.CommonTextureFrameLayout>
        <p151v.VOnlineIndicator
            android:id="@+id/edit_renzheng_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-3dp"
            android:layout_alignRight="@+id/edit_renzheng_content"
            android:layout_alignParentTop="true"
            app:indicatorStyle="style01"/>
        <View
            android:layout_width="5dp"
            android:layout_height="wrap_content"
            android:layout_alignRight="@+id/edit_renzheng_dot"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.IdentifyView>
