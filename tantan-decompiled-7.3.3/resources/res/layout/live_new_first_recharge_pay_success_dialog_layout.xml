<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.recharge.NewFirstRechargePaySuccessDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="27dp"
    android:layout_marginEnd="27dp"
    flatten="true"
    holder="increment.recharge.NewFirstRechargePaySuccessDialog">
    <View
        android:id="@+id/shadow"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        app:layout_constraintBottom_toTopOf="@+id/live_new_first_dialog_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/live_new_first_dialog_bg"
        android:background="@drawable/live_bg_ff7676_r20"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/shadow"
        flatten="true">
        <p151v.VImage
            android:layout_width="match_parent"
            android:layout_height="331dp"
            android:src="0x7f082411"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_ffeca4"
            android:gravity="center"
            android:id="@+id/sub_title"
            android:background="@drawable/live_bg_ffe6ae_r16"
            android:layout_width="256dp"
            android:layout_height="27dp"
            android:layout_marginTop="50dp"
            android:text="@string/LIVE_NEW_FIRST_RECHARGE_SUCCESS_SUB_TITLE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VLinear
            android:id="@+id/gift_list_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintTop_toBottomOf="@+id/sub_title">
            <include
                android:id="@+id/gift_item_left"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                layout="@layout/live_new_first_recharge_gift_item"/>
            <include
                android:id="@+id/gift_item_center"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                layout="@layout/live_new_first_recharge_gift_item"/>
            <include
                android:id="@+id/gift_item_right"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                layout="@layout/live_new_first_recharge_gift_item"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/continue_send_gift_linear"
            android:background="@drawable/live_bg_white_r16"
            android:layout_width="match_parent"
            android:layout_height="198dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="13dp"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_list_linear"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/live_ff4747"
                android:gravity="center"
                android:id="@+id/send_gift_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/send_gift_img"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                app:actualImageScaleType="centerInside"/>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/send_gift_button"
                android:background="@drawable/live_shape_new_first_recharge_send_gift_button_bg"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp">
                <p151v.VText
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_ff4747"
                    android:id="@+id/send_gift_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_ff4747"
                    android:gravity="center"
                    android:id="@+id/send_gift_button_sub_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f082412"
        android:scaleType="fitXY"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.recharge.NewFirstRechargePaySuccessDialog>
