<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.honorgift.LiveHonorGiftCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_margin="4dp">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="#f0bd71"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="33dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VFrame
        android:id="@+id/left_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/left_user_icon1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/left_user_icon2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            app:roundAsCircle="true"/>
        <View
            android:background="@drawable/live_shape_bg_honor_gift_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/left_avatar">
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#ccf0bd71"
            android:layout_gravity="center_horizontal"
            android:id="@+id/left_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="4"
            android:singleLine="true"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/right_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/right_user_icon1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/right_user_icon2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            app:roundAsCircle="true"/>
        <View
            android:background="@drawable/live_shape_bg_honor_gift_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/right_avatar">
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#ccf0bd71"
            android:layout_gravity="center_horizontal"
            android:id="@+id/right_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="4"
            android:singleLine="true"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content">
        <p151v.VDraweeView
            android:id="@+id/gift_icon1"
            android:layout_width="48dp"
            android:layout_height="45dp"/>
        <p151v.VDraweeView
            android:id="@+id/gift_icon2"
            android:layout_width="48dp"
            android:layout_height="45dp"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.honorgift.LiveHonorGiftCardView>
