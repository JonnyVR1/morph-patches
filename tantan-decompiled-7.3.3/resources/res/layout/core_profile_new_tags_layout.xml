<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileNewTagsItemHolder">
    <p151v.VFrame
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#e6000000"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/PROFILE_SECTION_HEADER_PERSONALITY"
                    android:layout_weight="1"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#33000000"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/view_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看全部"
                    android:layout_weight="0"/>
            </p151v.VLinear>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
                android:id="@+id/tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/bubble_container"
            android:background="@color/transparent"
            android:visibility="visible"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</p151v.VLinear_Dividers>
