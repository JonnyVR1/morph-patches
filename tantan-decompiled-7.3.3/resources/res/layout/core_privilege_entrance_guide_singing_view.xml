<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceGuideSigningView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    holder="banner.view.PrivilegeEntranceGuideSigningView">
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="17dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/restore"
        android:background="@drawable/core_mytab_banner_buy_bg_white_new"
        android:layout_width="57dp"
        android:layout_height="32dp"
        android:layout_marginRight="10dp"/>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceGuideSigningView>
