<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemUserStatesView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemUserStatesView">
    <p151v.VFrame
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:src="0x7f08075a"/>
        <p151v.VImage
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/new_state_red_dot"
            android:background="@drawable/core_match_reminder_bg"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="10dp"/>
    </p151v.VFrame>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="好友状态"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="分享此刻状态，与好友即刻开聊"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_03"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/look_over"
        android:background="@drawable/core_see_change_look_bg"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:text="查看"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemUserStatesView>
