<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="0x7f081405"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"/>
    <RelativeLayout
        android:background="@drawable/core_privilege_dlg_badge_avatat_bg"
        android:padding="3dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="115dp"
        android:layout_height="153dp"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="40dp">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:drawingCacheQuality="high"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="8dp"/>
        <p151v.VImage
            android:id="@+id/icon_priority_recommend"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            android:src="@drawable/core_certification_privilege_priority_recommend_icon"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-18dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VImage
            android:id="@+id/icon_cert_logo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-15dp"
            android:src="@drawable/core_certification_avatar_icon_big"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="-10dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VImage
            android:id="@+id/icon_high_privacy_setting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            android:src="@drawable/core_certification_privilege_high_privacy_setting_icon"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</p151v.VRelative>
