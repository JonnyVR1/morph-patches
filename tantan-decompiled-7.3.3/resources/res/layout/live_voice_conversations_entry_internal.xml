<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.virtualVoice.entry.VoiceConversationsEntryInternal xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversation_entry_all_layout"
    android:visibility="gone"
    android:layout_width="180dp"
    android:layout_height="80dp"
    flatten="true"
    folder="internal"
    holder="virtualVoice.entry.VoiceConversationsEntryInternal">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_layout"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="5dp"
        flatten="true">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/voice_title"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="10dp"
            android:text="@string/LIVE_VOICE_CHAT_ROOM_PAGE"
            android:lines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/avatar_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.188"/>
        <com.p051p1.mobile.putong.live.external.internal.virtualVoice.entry.VoiceEntryAvatarLayout
            android:id="@+id/tag_avatars"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/avatar_guide"
            app:layout_constraintStart_toStartOf="@+id/avatar_guide"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/dynamic_avatars"
            android:background="@color/live_white"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="3dp"
            app:layout_constraintEnd_toEndOf="@+id/avatar_guide"
            app:layout_constraintStart_toStartOf="@+id/avatar_guide"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true"
            layout="@layout/live_voice_conversations_entry_avatar"/>
        <p151v.VMarqueeText
            android:textSize="12dp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="marquee"
            android:id="@+id/voice_des"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="33dp"
            android:text="@string/LIVE_VOICE_MANY_PEOPLE_ONLINE_CHAT"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/tag_group"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="@+id/tag_avatars"
            app:layout_constraintStart_toStartOf="@+id/tag_avatars"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="9sp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/tag"
                android:paddingTop="0.3dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"
                android:maxLength="8"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VImage
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/live_shape_circle_red_dot"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/num_red_dot"
        android:background="@drawable/live_shape_bg_activities_red_dot_text"
        android:paddingTop="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
</com.p051p1.mobile.putong.live.external.internal.virtualVoice.entry.VoiceConversationsEntryInternal>
