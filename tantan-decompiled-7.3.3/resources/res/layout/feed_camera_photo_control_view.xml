<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.widget.CameraPhotoControlView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_marginBottom="44dp"
    flatten="true"
    folder="newui"
    holder="camera.widget.CameraPhotoControlView">
    <com.p051p1.mobile.putong.feed.newui.camera.widget.RecordButton
        android:id="@+id/camera_control_record_button"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_centerInParent="true"
        app:is_photo="true"/>
    <p151v.VFrame
        android:id="@+id/camera_control_mask_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="36dp"
        android:layout_toLeftOf="@+id/camera_control_record_button"
        android:layout_centerVertical="true"
        flatten="true">
        <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
            android:id="@+id/camera_control_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:image_size="32dp"
            app:src="0x7f081cad"
            app:text="@string/FEED_CAPTURE_TOOLS"/>
        <com.p051p1.mobile.putong.feed.newui.photoalbum.redpointview.FeedRedDotView
            android:layout_gravity="top|right"
            android:id="@+id/camera_control_mask_red_point"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            app:feedDotDrawableOvalColor="#ff3228"
            app:feedDotDrawableWidth="6dp"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_toRightOf="@+id/camera_control_record_button"
        android:layout_centerVertical="true">
        <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
            android:id="@+id/camera_control_upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:image_size="32dp"
            app:text="@string/IMAGE_ALBUM_TITLE"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.feed.newui.camera.widget.CameraPhotoControlView>
