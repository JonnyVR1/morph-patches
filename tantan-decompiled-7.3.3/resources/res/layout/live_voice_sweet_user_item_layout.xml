<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="73dp"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetUserItemView">
    <p151v.VDraweeView
        android:id="@+id/avatar_group"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#323333"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxWidth="110dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@+id/avatar_group"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/gender_age"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginLeft="4dp"
        android:layout_toRightOf="@+id/name"
        android:layout_centerVertical="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/gender"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <p151v.VDraweeView
        android:id="@+id/level"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="11dp"
        android:layout_marginLeft="5dp"
        android:layout_toRightOf="@+id/gender_age"
        android:layout_centerVertical="true"
        app:actualImageScaleType="fitXY"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/bind_btn"
        android:background="@drawable/live_shape_voice_sweet_state_btn_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginRight="14dp"
        android:minWidth="75dp"
        android:text="@string/LIVE_VOICE_CP"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:fontFamily="PingFangSC-Medium"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetUserItemView>
