<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.NewNewHomeViewModel"
    useRefId="true">
    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"/>
    <p151v.VFrame
        android:id="@+id/card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VFrame
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:paddingLeft="8dp"
            android:paddingTop="12dp"
            android:paddingRight="8dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/core_home_card_content_column"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true">
                <FrameLayout
                    android:id="@+id/intl_home_swipe_discount_banner_slot"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="3dp"/>
                <FrameLayout
                    android:id="@+id/core_home_card_stack_host"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToOutline="false">
                    <RelativeLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/card_loading"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="48dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/loading_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/core_card_loading_bg"
                            android:scaleType="centerCrop"/>
                        <p151v.VFrame_Squared
                            android:id="@+id/radar"
                            android:layout_width="match_parent"
                            android:layout_height="416dp"
                            android:layout_centerInParent="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/image"
                                android:layout_width="@dimen/radar_image_size"
                                android:layout_height="@dimen/radar_image_size"
                                android:outlineSpotShadowColor="#19979797"
                                app:backgroundImage="@color/common_light_04"
                                app:roundingBorderPadding="3dp"
                                style="@style/core_fresco_profile_white_border"/>
                        </p151v.VFrame_Squared>
                    </RelativeLayout>
                    <include
                        android:id="@+id/empty_card"
                        android:visibility="gone"
                        layout="@layout/core_empty_card_layout"/>
                    <include
                        android:id="@+id/error_net_cover"
                        android:visibility="gone"
                        layout="@layout/core_home_net_error_layout"/>
                </FrameLayout>
            </p151v.VLinear>
        </p151v.VFrame>
        <com.sunshine.engine.particle.SceneView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/boost_heart_scene"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="135dp"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/boost_tips"
            android:background="0x7f082939"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="5dp"
            android:text="@string/BOOST_CLICK_BUTTON_TIPS"/>
        <ViewStub
            android:id="@+id/certification_tips"
            android:visibility="gone"
            android:layout="@layout/core_card_certification_tips"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="44dp"/>
    </p151v.VFrame>
    <ViewStub
        android:id="@+id/us_layout"
        android:layout="@layout/core_home_us_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/superlike_combo_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:layout_gravity="top"
        android:id="@+id/home_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_home_card_title_layout"/>
</FrameLayout>
