<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.question.MaleChatGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.question.MaleChatGuideView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="bottom"
                android:id="@+id/image_small"
                android:layout_width="?attr/message_page_profile_pic_size"
                android:layout_height="?attr/message_page_profile_pic_size"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="6dp"
                style="@style/core_im_fresco_profile_small"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/verification_icon"
                android:background="0x7f082957"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="6dp"
                useId="true"/>
            <com.p051p1.mobile.putong.core.p058ui.view.GradientBgButton
                android:layout_gravity="bottom|right"
                android:id="@+id/match_from"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="5dp"
                android:scaleType="centerInside"
                app:iconWidth="6dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/profile_bubble"
            android:paddingLeft="20dp"
            android:paddingTop="16dp"
            android:paddingRight="14dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="58dp"
            flatten="true"
            style="@style/messages_item_left">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#bdbdbd"
                android:id="@+id/tv_questions_count_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="我特别好奇这些问题，愿意聊聊吗？"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/first_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#595959"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/first_question_text"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d74d37"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/first_question_chat"
                    android:background="@drawable/core_ice_breaking_button_bg"
                    android:layout_width="77dp"
                    android:layout_height="28dp"
                    android:text="聊这个"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/second_question"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#595959"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/second_question_text"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d74d37"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/second_question_chat"
                    android:background="@drawable/core_ice_breaking_button_bg"
                    android:layout_width="77dp"
                    android:layout_height="28dp"
                    android:text="聊这个"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/third_question"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#595959"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/third_question_text"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d74d37"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/third_question_chat"
                    android:background="@drawable/core_ice_breaking_button_bg"
                    android:layout_width="77dp"
                    android:layout_height="28dp"
                    android:text="聊这个"/>
            </p151v.VLinear>
        </LinearLayout>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.question.MaleChatGuideView>
