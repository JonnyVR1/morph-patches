<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/core_city_cover_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <p151v.VImage
                    android:layout_gravity="start"
                    android:id="@+id/close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="0x7f080711"
                    android:scaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/core_color_80percent_FFFFFF"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/dlg_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="城市封面"/>
                <p151v.VImage
                    android:layout_gravity="end"
                    android:id="@+id/illustrate"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="0x7f080712"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:visibility="gone"
                    layout="@layout/core_city_cover_view_1"/>
                <include
                    android:visibility="gone"
                    layout="@layout/core_city_cover_view_2"/>
                <include
                    android:visibility="gone"
                    layout="@layout/core_city_cover_view_3"/>
                <include
                    android:visibility="gone"
                    layout="@layout/core_city_cover_view_4"/>
                <FrameLayout
                    android:id="@+id/function_description"
                    android:layout_width="match_parent"
                    android:layout_height="562dp">
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="@color/core_color_80percent_FFFFFF"
                        android:id="@+id/function_description_text"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:lineSpacingMultiplier="1.2"/>
                </FrameLayout>
            </FrameLayout>
        </p151v.VLinear>
    </FrameLayout>
</FrameLayout>
