<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.virtualmotion.creator.rightcall.VoiceMembersView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="79dp"
    android:layout_height="match_parent"
    flatten="true"
    holder="virtual.virtualmotion.creator.rightcall.VoiceMembersView">
    <View
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="parent"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/member_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        flatten="true">
        <p151v.VRecyclerView
            android:id="@+id/rv_member_list"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:id="@+id/member_count"
        android:background="@drawable/live_bg_black_r10_a20"
        android:visibility="invisible"
        android:layout_width="71dp"
        android:layout_height="26dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="5dp"
        app:layout_constraintRight_toRightOf="@+id/member_layout"
        app:layout_constraintTop_toBottomOf="@+id/member_layout"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/share"
        android:background="@drawable/live_bg_black_r10_a20"
        android:visibility="invisible"
        android:layout_width="71dp"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:text="分享"
        android:drawableLeft="0x7f0827b3"
        android:drawablePadding="5dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/member_count"
        app:layout_constraintRight_toRightOf="@+id/member_count"
        app:layout_constraintTop_toBottomOf="@+id/member_count"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.virtualmotion.creator.rightcall.VoiceMembersView>
