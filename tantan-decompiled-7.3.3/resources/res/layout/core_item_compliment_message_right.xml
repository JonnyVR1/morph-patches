<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.compliment.ItemComplimentMessageRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.AutoVDraweeView
        android:id="@+id/compliment_photo"
        android:layout_width="200dp"
        android:layout_height="266dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@+id/compliment_type_icon"
        app:layout_constraintTop_toTopOf="@+id/compliment_type_icon"
        app:roundedCornerRadius="14dp"/>
    <p151v.VImage
        android:id="@+id/compliment_type_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#cc000000"
        android:id="@+id/compliment_text"
        android:background="@drawable/core_compliment_msg_bubble_bg"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="246dp"
        android:maxWidth="180dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        app:fontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.p058ui.messages.compliment.ItemComplimentMessageRight>
