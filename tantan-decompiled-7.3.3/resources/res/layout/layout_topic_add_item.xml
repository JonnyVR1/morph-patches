<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    folder="newui"
    holder="topic.topicpost.TopicAddItemView">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f082a40"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#030303"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/FEED_ADD_MOMENT_TOPIC"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#9aa5b1"
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="让更多人发现你"
                android:lineSpacingExtra="0sp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/right_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f081f64"
                android:scaleType="fitCenter"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/right_icon_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0828e5"
                android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
