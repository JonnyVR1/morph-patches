<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.userCard.friend.VirtualUserCardMatchView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="virtual.userCard.friend.VirtualUserCardMatchView">
    <p151v.VFrame
        android:id="@+id/apply_layout"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/gift_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/apply_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/accept_layout"
        android:background="@drawable/live_bg_fe7e1d_r10_a10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="75dp">
        <p151v.VDraweeView
            android:id="@+id/apply_gift"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/apply_gift"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#ccffffff"
                android:id="@+id/apply_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#66ffffff"
                android:id="@+id/apply_send_gift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </p151v.VLinear>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/accept_button"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="53dp"
            android:layout_height="34dp"
            android:text="同意"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.virtual.userCard.friend.VirtualUserCardMatchView>
