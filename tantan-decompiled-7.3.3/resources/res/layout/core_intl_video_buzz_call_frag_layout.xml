<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="lovebuzz.video.call.VideoBuzzCallViewModel">
    <FrameLayout
        android:id="@+id/peer_surface_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/top_mask"
        android:background="@drawable/core_intl_buzz_mask_bg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:rotation="180"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_mask"
        android:background="@drawable/core_intl_buzz_mask_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzMatchView
        android:id="@+id/match_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VImage
        android:id="@+id/vb_report"
        android:background="0x7f080cf8"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/progress_root"
        android:background="@drawable/core_intl_shape_buzz_progress_bg"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/vb_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.zebraprogress.ZebraProgress
            android:layout_gravity="center"
            android:id="@+id/call_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:progress_background="@color/transparent"
            app:progress_max="100"
            app:progress_radius="11dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="@color/white"
        android:id="@+id/countdown_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_root"
        app:layout_constraintEnd_toEndOf="@+id/progress_root"
        app:layout_constraintTop_toTopOf="@+id/progress_root"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/peer_info_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_root"
        app:layout_constraintEnd_toStartOf="@+id/countdown_time"
        app:layout_constraintStart_toStartOf="@+id/progress_root"
        app:layout_constraintTop_toTopOf="@+id/progress_root">
        <p151v.VText
            android:textSize="24sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/peer_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="220dp"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="24sp"
            android:textColor="@color/white"
            android:gravity="start"
            android:id="@+id/peer_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:typeface="regular"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.MediaBuzzCallControlView
        android:id="@+id/vb_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.BuzzNoFaceTipView
        android:id="@+id/no_face_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
