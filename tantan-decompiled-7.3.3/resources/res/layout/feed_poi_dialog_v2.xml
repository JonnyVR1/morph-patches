<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.poi.dialog.FeedPoiV2Dialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/dialog_rl"
        android:background="@drawable/feed_poi_dlg_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:id="@+id/close_ic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f081e1c"
            android:layout_alignParentRight="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/feed_black_010101"
            android:ellipsize="end"
            android:id="@+id/poi_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:layout_alignParentStart="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/feed_gray_999999"
            android:ellipsize="end"
            android:id="@+id/poi_info_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:layout_below="@+id/poi_title_txt"/>
        <p151v.VRecyclerView
            android:id="@+id/state_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_below="@+id/poi_info_txt"/>
        <p151v.VEditText
            android:textSize="16sp"
            android:textColor="@color/feed_cc000000"
            android:textColorHint="@color/feed_33000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/input"
            android:background="@drawable/feed_bg_white_round_corner_10"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:maxLength="60"
            android:layout_below="@+id/state_recyclerview"
            android:inputType="text"
            android:textCursorDrawable="@drawable/feed_guide_states_cursor_bg"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/feed_e6000000"
            android:ellipsize="end"
            android:id="@+id/poi_location_lable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="40dp"
            android:text="我在这里"
            android:maxLines="1"
            android:layout_below="@+id/input"/>
        <p151v.VRecyclerView
            android:id="@+id/location_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/poi_location_lable"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/post"
            android:background="@drawable/feed_poi_dlg_post_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="发布"
            android:layout_below="@+id/location_recyclerview"/>
    </RelativeLayout>
</FrameLayout>
