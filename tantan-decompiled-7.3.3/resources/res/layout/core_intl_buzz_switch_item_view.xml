<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/core_intl_love_buzz_button_white"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    attachToRoot="true"
    folder="ui"
    holder="lovebuzz.widget.BuzzSwitchItemView">
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:background="0x7f080a67"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/right_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toggle"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#151515"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_color_80000000"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            app:typeface="regular"/>
    </p151v.VLinear>
    <p151v.VSwitchButton
        android:id="@+id/toggle"
        android:layout_width="46dp"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
