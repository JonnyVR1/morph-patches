<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="accountnew.loginopt.viewmodel.EmailVerifyCodeViewModel">
    <p151v.VScroll
        android:id="@+id/scrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top"
        flatten="true"
        style="@style/account_account_scroll">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="@color/common_000000_80"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="@string/INTL_TTC_EMAIL_CODE_TITLE"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:autoSizeMaxTextSize="25dp"
                app:autoSizeMinTextSize="10dp"
                app:autoSizeTextType="uniform"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/common_grey_03"
                android:id="@+id/detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="已发送验证码至 ·"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:typeface="medium"/>
            <com.p051p1.mobile.putong.account.p055ui.accountnew.loginopt.EmailVerifyCodeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp">
                <p151v.VText
                    android:textColor="@color/common_red"
                    android:gravity="center_vertical"
                    android:id="@+id/error_code"
                    android:background="@drawable/account_sign_input_error_bg"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:includeFontPadding="false"
                    android:drawablePadding="7dp"
                    android:drawableStart="0x7f0801f3"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp"/>
                <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                    android:id="@+id/loading_svga"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </p151v.VFrame>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/common_orange"
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/TTT_WECHAT_BIND_MOBILE_ACTION_RESEND_NEW"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:typeface="medium"/>
        </LinearLayout>
    </p151v.VScroll>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top"
        android:background="@color/common_white"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080387"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_01"
            android:gravity="center_vertical"
            android:id="@+id/right_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SIGNIN_PASSWORD"
            android:includeFontPadding="false"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
