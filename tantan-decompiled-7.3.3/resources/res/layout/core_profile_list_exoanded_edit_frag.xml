<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/base_root"
    android:background="#f7f7f7"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.exp.ProfileListExpandedEditFrag">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/edit_profile_navigation_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"
        app:title="@string/NEW_PROFILE_PICTURE_EDIT"/>
    <p151v.VFrame
        android:id="@+id/preview_root"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VProgressBar
            android:id="@+id/preview_loading_block"
            android:visibility="visible"
            style="@style/core_loading_block"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/edit_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            app:tabBackground="@color/transparent"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@null"/>
        <com.p051p1.mobile.putong.core.p058ui.profile.exp.ExpEditTopWarnView
            android:id="@+id/top_warn_view"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_list"
            android:paddingTop="8dp"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:overScrollMode="never"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/preview_edit_switch"
        android:background="@drawable/core_exp_preview_switch_bg"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:text="预览资料"
        android:drawableLeft="0x7f082082"
        android:drawablePadding="8dp"
        app:typeface="medium"/>
    <View
        android:id="@+id/block_operation_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</p151v.VFrame>
