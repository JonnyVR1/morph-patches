<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetTaskItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="73dp"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetTaskItemView">
    <p151v.VDraweeView
        android:id="@+id/drawee_task"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        app:actualImageScaleType="centerCrop"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#323333"
        android:ellipsize="end"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="16dp"
        android:maxWidth="177dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@+id/drawee_task"
        android:fontFamily="PingFangSC-Regular"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#aaaaaa"
        android:ellipsize="end"
        android:id="@+id/desc_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:maxWidth="177dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@+id/drawee_task"
        android:layout_below="@+id/title_text"
        android:fontFamily="PingFangSC-Regular"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/live_voice_sweet_cp_text_selector"
        android:gravity="center"
        android:id="@+id/state_btn"
        android:background="@drawable/live_selector_voice_sweet_task"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginRight="15dp"
        android:minWidth="75dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:fontFamily="PingFangSC-Medium"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetTaskItemView>
