<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.receivegift.ReceiveGiftAudienceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    flatten="true"
    folder="increment"
    holder="gift.receivegift.ReceiveGiftAudienceView">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonAnimMaskAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/head"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="15dp"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:maxLines="1"
        android:layout_marginStart="55dp"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.receivegift.ReceiveGiftAudienceView>
