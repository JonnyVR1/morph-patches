<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomIntlVoiceLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomIntlVoiceLayout">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="34dp"
        android:layout_marginBottom="10dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundFrameLayout
        android:id="@+id/intl_voice_card_bt_root"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_below="@+id/card_bottom_info"
        app:rRadius="8dp"
        app:rStrokeColor="#33ffffff"
        app:rStrokeWidth="1dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/intl_voice_card_bt_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_fresco_base"/>
        <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
            android:id="@+id/intl_voice_card_bt_anim"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:scaleType="fitXY"/>
        <View
            android:layout_gravity="end"
            android:background="@drawable/core_intl_voice_card_gradient_bg"
            android:layout_width="156dp"
            android:layout_height="88dp"/>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/intl_voice_card_bt"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VFrame
                android:id="@+id/intl_voice_card_right_layout"
                android:layout_width="88dp"
                android:layout_height="88dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/intl_voice_card_avatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    app:actualImageScaleType="centerCrop"
                    app:failureImage="0x7f080cfb"
                    app:placeholderImage="0x7f080cfb"
                    style="@style/core_fresco_base"/>
                <View
                    android:background="#4d000000"
                    android:layout_width="88dp"
                    android:layout_height="88dp"/>
                <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                    android:layout_gravity="center"
                    android:id="@+id/intl_voice_card_avatar_anim"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"/>
            </p151v.VFrame>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="start"
                android:layout_gravity="center_vertical"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/INTL_CARD_AUIDO"
                android:maxLines="2"
                android:drawablePadding="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="30dp"
                app:typeface="medium"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundFrameLayout>
    <View
        android:id="@+id/info_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomIntlVoiceLayout>
