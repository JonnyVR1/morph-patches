<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="intlmeet.frag.IntlMeetFragTabBar">
    <FrameLayout
        android:id="@+id/liker_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        flatten="true">
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#cc000000"
            android:gravity="center_vertical"
            android:id="@+id/liker_title"
            android:paddingTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/INTL_TTC_MEET_TITLE_0LIKE"/>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/visitor_layout"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/visitor_title"
            android:paddingTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/INTL_MEET_TAB_VISITOR_TITLE"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/new_match_red_dot"
            android:background="@drawable/core_intl_meet_frag_tab_red_dot"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="16dp"
            android:paddingHorizontal="4dp"/>
    </p151v.VLinear>
</p151v.VLinear>
