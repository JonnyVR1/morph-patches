<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="constellationmatch.ConstellationMatchDialog">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/body"
        android:background="0x7f080a9e"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/INTL_HOROSCOPE_REC_TITLE"
            android:shadowColor="#db000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:lineSpacingExtra="12sp"
            android:layout_marginStart="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VButton
            android:id="@+id/close"
            android:background="0x7f080c72"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#bdb2ff"
            android:id="@+id/reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="24dp"
            android:text="@string/INTL_HOROSCOPE_REC_SUBTITLE"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#e6f1ecff"
            android:gravity="center_horizontal"
            android:id="@+id/reading_instruction"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="34dp"
            android:text="@string/INTL_HOROSCOPE_REC_INSTRUCT1"
            android:lineSpacingExtra="8sp"
            app:layout_constraintTop_toBottomOf="@+id/reading"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/reading_instruction"/>
        <p151v.VImage
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:src="0x7f080a9f"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reading_instruction"/>
        <include
            android:id="@+id/hide_card"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space"
            layout="@layout/core_intl_constellation_selected_card"/>
        <com.p051p1.mobile.putong.core.p058ui.tarot.TarotListView
            android:id="@+id/tarot_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/image"/>
        <com.p051p1.mobile.putong.core.p058ui.constellationmatch.ConstellationView
            android:id="@+id/lineView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tarot_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#d5ccff"
            android:id="@+id/slide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/INTL_HOROSCOPE_REC_INSTRUCT2"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@+id/tarot_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
