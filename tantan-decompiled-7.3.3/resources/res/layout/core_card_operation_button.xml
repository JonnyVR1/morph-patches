<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.views.CardOperationButton"
    innerClass="true">
    <View
        android:id="@+id/normal_state_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/pressed_state_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <p151v.VIcon
        android:layout_gravity="center"
        android:id="@+id/icon"
        style="@style/common_icon_xSmall"/>
</p151v.VFrame>
