<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemSubTitleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/subtitle"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    folder="newui"
    holder="messages.itemview.ConversationItemSubTitleView">
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="0dp">
        <p151v.VImage
            android:id="@+id/sign_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="3dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="13sp"
        android:ellipsize="end"
        android:id="@+id/intl_spot_point"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:singleLine="true"
        app:enableEmojis="true"
        app:typeface="medium"/>
    <View
        android:id="@+id/view_spot_point"
        android:background="@drawable/core_spot_circle"
        android:visibility="gone"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#999999"
        android:textColorLink="@color/core_msg_cell_link_color"
        android:ellipsize="end"
        android:id="@+id/message_big"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        app:centerEmojis="true"
        app:enableEmojis="true"
        app:typeface="regular"/>
    <FrameLayout
        android:id="@+id/intlRealMsgGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="0dp">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/small_red_dot"
        android:background="@drawable/core_conversation_op_red_dot"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="10dp"/>
</com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemSubTitleView>
