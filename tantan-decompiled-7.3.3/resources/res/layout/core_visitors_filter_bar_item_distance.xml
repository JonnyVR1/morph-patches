<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsFilterItemDistanceView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="visitor.VisitorsFilterItemDistanceView">
    <LinearLayout
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#66000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距离筛选"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:layout_gravity="right"
            android:id="@+id/distance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"/>
    </LinearLayout>
    <p151v.VSlider
        android:value="0"
        android:id="@+id/search_distance"
        android:layout_marginTop="-5dp"
        android:layout_marginRight="6dp"
        android:valueFrom="0"
        android:valueTo="100"
        style="@style/CommonSliderStyle"/>
</com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsFilterItemDistanceView>
