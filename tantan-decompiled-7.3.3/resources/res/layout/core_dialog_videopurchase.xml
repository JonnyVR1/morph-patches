<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="incentivevideo.VideoPurchaseDialog">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:background="0x7f0816a9"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        flatten="true">
        <View
            android:id="@+id/top_bg"
            android:background="@drawable/core_intl_admob_reward_top_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_icon"
            android:background="0x7f0818e7"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="48dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#323232"
            android:gravity="center_horizontal"
            android:id="@+id/tv_pur_title"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/INTL_REWARDED_VIDEO_POP1_TITLE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_seevideo"
            android:background="@drawable/core_bg_btn_watch_video"
            android:paddingLeft="28dp"
            android:paddingTop="11dp"
            android:paddingRight="28dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:minHeight="56dp"
            android:text="@string/INTL_REWARDED_VIDEO_POP1_BUTTON1"
            app:layout_constraintTop_toBottomOf="@+id/tv_pur_title"/>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/tv_purchase"
            android:background="@drawable/core_bg_button_video_purchase"
            android:paddingLeft="28dp"
            android:paddingTop="11dp"
            android:paddingRight="28dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="32dp"
            android:minHeight="56dp"
            android:text="@string/INTL_REWARDED_VIDEO_POP1_BUTTON2"
            android:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_seevideo"/>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/tv_close"
            android:paddingLeft="28dp"
            android:paddingTop="11dp"
            android:paddingRight="28dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:minHeight="56dp"
            android:text="@string/INTL_REWARD_POPUP_BTN_NOTHANKS"
            android:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_purchase"/>
        <ImageView
            android:id="@+id/iv_close"
            android:background="0x7f0809cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
