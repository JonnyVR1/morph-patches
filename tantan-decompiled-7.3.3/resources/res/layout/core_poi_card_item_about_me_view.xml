<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemAboutMeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    flatten="true"
    folder="newui"
    holder="poi.view.FeedPoiCardItemAboutMeView">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_02"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/PROFILE_PERSONAL_INFO_ABOUT_ME"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_09"
        android:layout_gravity="center_vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowView
        android:id="@+id/tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemAboutMeView>
