<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.likedusers.tablayout.undolike.UndoCoverAnimView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="likedusers.tablayout.undolike.UndoCoverAnimView">
    <View
        android:id="@+id/background"
        android:background="#b3000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.p051p1.mobile.putong.core.p058ui.likedusers.tablayout.undolike.UndoFlipFrameLayout
        android:layout_gravity="center"
        android:id="@+id/undo_flip_layout"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:tag="ignoreAlpha"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/white"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
            style="@style/core_fresco_base"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/personal_info"
            android:background="@drawable/core_liked_user_item_common_gradient"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="8dp"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_card_user_text_color_b2ffffff"
                android:id="@+id/online_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/MY_TANTAN_CARD_ONLINE"
                android:drawableLeft="0x7f08181a"
                android:drawablePadding="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/user_info"
                app:layout_constraintLeft_toLeftOf="parent"
                app:typeface="regular"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:typeface="regular"/>
            <p151v.VImage
                android:id="@+id/action_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="@drawable/core_just_real_unlikelist_undo"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VText
            android:id="@+id/new_user"
            android:background="@drawable/core_svip_liked_user_new_user_tag_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/CORE_SVIP_ADVANCED_FILTER_NEW_USER"
            android:drawableLeft="0x7f081808"
            app:typeface="regular"
            style="@style/core_user_card_top_left_label"/>
        <View
            android:id="@+id/mask"
            android:background="@drawable/core_svip_liked_user_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_fresco_base"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/heart"
            android:tag="ignoreAlpha"
            android:layout_width="55dp"
            android:layout_height="48dp"
            android:src="0x7f081895"
            android:alpha="0"/>
    </com.p051p1.mobile.putong.core.p058ui.likedusers.tablayout.undolike.UndoFlipFrameLayout>
</com.p051p1.mobile.putong.core.p058ui.likedusers.tablayout.undolike.UndoCoverAnimView>
