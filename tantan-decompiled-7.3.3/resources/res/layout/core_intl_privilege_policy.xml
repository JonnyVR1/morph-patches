<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilegeNewUi.content.item.IntlPrivilegePolicyItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.privilegeNewUi.content.item.IntlPrivilegePolicyItem">
    <View
        android:id="@+id/top_line"
        android:background="#08000000"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#4c000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#4c000000"
        android:gravity="left"
        android:id="@+id/policy_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="48dp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.privilegeNewUi.content.item.IntlPrivilegePolicyItem>
