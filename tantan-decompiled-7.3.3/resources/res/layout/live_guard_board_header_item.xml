<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.GuardHeaderItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="increment"
    holder="knight.view.leaderboard.GuardHeaderItemView">
    <p151v.VFrame
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:padding="12dp"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_above="@+id/name"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:roundAsCircle="true"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/living_bg"
            android:background="@drawable/live_bg_white_oval"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"/>
        <com.p051p1.mobile.putong.live.base.view.LiveTagView
            android:layout_gravity="end|bottom"
            android:id="@+id/living"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginBottom="11dp"
            android:layout_marginEnd="11dp"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/text_root"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/heart"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:maxLines="1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.GuardHeaderItemView>
