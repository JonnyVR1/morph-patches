<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.MagicGestureItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="MagicGestureItemView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="70dp"
        android:layout_height="70dp">
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="18dp"
            app:actualImageScaleType="fitXY"
            app:failureImageScaleType="fitXY"
            app:placeholderImageScaleType="fitXY"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#e6ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="7dp"/>
    </p151v.VLinear>
    <p151v.VRecyclerView
        android:orientation="horizontal"
        android:id="@+id/list"
        android:visibility="visible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        useId="true"/>
</com.p051p1.mobile.putong.live.livingroom.view.MagicGestureItemView>
