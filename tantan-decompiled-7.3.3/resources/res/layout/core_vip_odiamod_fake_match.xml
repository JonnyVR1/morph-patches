<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/match_root"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="diamond.match.ODiamondFakeMatchViewModel">
    <View
        android:id="@+id/bottom_cover1"
        android:background="@color/black"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/bottom_cover2"
        android:background="@drawable/bg_match_chat_optimize_black"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="218dp"
        android:layout_marginBottom="-1dp"
        android:layout_above="@+id/bottom_cover1"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/center_div"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerInParent="true"/>
    <p151v.VDraweeView
        android:id="@+id/profile_me"
        android:layout_width="@dimen/core_match_profile_image_size"
        android:layout_height="@dimen/core_match_profile_image_size_height"
        android:layout_marginRight="@dimen/core_match_profile_image_overlap"
        android:layout_toLeftOf="@+id/center_div"
        android:layout_above="@+id/center_div"
        style="@style/core_fresco_profile_white_border"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/core_match_profile_image_overlap"
        android:layout_toRightOf="@+id/center_div"
        android:layout_above="@+id/center_div">
        <p151v.VDraweeView
            android:id="@+id/profile_other"
            android:layout_width="@dimen/core_match_profile_image_size"
            android:layout_height="@dimen/core_match_profile_image_size_height"
            android:cropToPadding="false"
            style="@style/core_fresco_profile_white_border"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/online_tip"
            android:background="@drawable/fakelikers_match_online_bg"
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:layout_marginBottom="-10dp"
            android:text="@string/HOME_TAB_ONLINE"/>
    </FrameLayout>
    <p151v.VLinear_FillerMeasure
        android:orientation="horizontal"
        android:id="@+id/text_like_ui1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="32dp"
        android:layout_below="@+id/profile_me"
        android:layout_centerHorizontal="true"
        app:fillerIndex="0"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/text_white"
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:singleLine="true"
            app:autoSizeTextType="uniform"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/text_white"
            android:id="@+id/text_name_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 也喜欢了你"
            app:autoSizeTextType="uniform"
            app:typeface="regular"/>
    </p151v.VLinear_FillerMeasure>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/text_white"
        android:gravity="center"
        android:id="@+id/text_tip"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:minWidth="0dp"
        android:maxLines="2"
        android:layout_below="@+id/text_like_ui1"
        android:layout_centerHorizontal="true"
        app:autoSizeTextType="uniform"
        app:typeface="regular"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/normal_btn_container_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        flatten="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/normal_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/start_conversation"
                android:background="@drawable/rect_common_rounded_tantan_orange"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="false"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:minWidth="264dp"
                android:text="@string/MATCH_BUTTON_START_A_CONVERSATION"
                android:drawablePadding="15dp"
                style="@style/core_main_button"/>
            <p151v.VButton_FakeShadow
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cancel"
                android:background="@drawable/rect_rounded_stroke_white"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="264dp"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/margin_standard"
                android:layout_marginBottom="45dp"
                android:text="放弃"
                android:maxLines="1"
                style="@style/core_main_button"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/usa_btn_container"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/normal_btn_container_root"
        flatten="true">
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/usa_cancel"
            android:background="@drawable/usa_match_sliding_background"
            android:paddingLeft="@dimen/usa_btn_padding"
            android:paddingRight="@dimen/usa_btn_padding"
            android:layout_width="@dimen/usa_btn_width"
            android:layout_height="@dimen/usa_btn_height"
            android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
            app:typeface="regular"/>
        <View
            android:layout_width="24dp"
            android:layout_height="0dp"/>
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="@color/usa_match_start_conversation_text"
            android:gravity="center"
            android:id="@+id/usa_start_conversation"
            android:background="@drawable/usa_match_conversation_background"
            android:paddingLeft="@dimen/usa_btn_padding"
            android:paddingRight="@dimen/usa_btn_padding"
            android:layout_width="@dimen/usa_btn_width"
            android:layout_height="@dimen/usa_btn_height"
            android:text="@string/MATCH_BUTTON_START_A_CONVERSATION"
            app:typeface="regular"/>
    </LinearLayout>
    <p151v.VScroll_Horizontal
        android:id="@+id/scroll_view"
        android:paddingLeft="8dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/chat_tags"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
    </p151v.VScroll_Horizontal>
    <FrameLayout
        android:id="@+id/title_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="41dp"
        android:layout_above="@+id/profile_me"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        flatten="true">
        <p151v.VText
            android:textSize="42dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:text="Congratulations!"
            app:autoSizeMinTextSize="32sp"/>
    </FrameLayout>
</RelativeLayout>
