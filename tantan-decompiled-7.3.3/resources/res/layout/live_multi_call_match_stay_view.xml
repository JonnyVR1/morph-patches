<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.view.LiveMultiCallMatchStayView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_view_alert_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="ConstraintLayout"
    app:binding="true">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_black_90_opacity"
        android:id="@+id/content"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/LIVE_MULTI_CALL_NO_MATCH_HINT"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VRadioButton
        android:textSize="12sp"
        android:textColor="@color/live_black_30_opacity"
        android:id="@+id/checked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="35dp"
        android:button="@null"
        android:text="@string/LIVE_MULTI_CALL_MATCH_STAY_NOT_SHOW"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/live_selector_multi_call_check"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <View
        android:id="@+id/divider"
        android:background="@color/common_light_03"
        android:layout_width="3dp"
        android:layout_height="20dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checked"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_gray_83"
        android:id="@+id/negative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_MULTI_CALL_DLG_QUIT"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintBottom_toBottomOf="@+id/divider"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/tantan_orange"
        android:id="@+id/positive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_MULTI_CALL_MO_MATCH_DLG_TO_CREATE"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintBottom_toBottomOf="@+id/divider"
        app:layout_constraintLeft_toRightOf="@+id/divider"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.view.LiveMultiCallMatchStayView>
