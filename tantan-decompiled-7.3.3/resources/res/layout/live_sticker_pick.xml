<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.LiveStickerPickView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.bottom.sticker"
    holder="LiveStickerPickView"
    useRefId="true">
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sticker_parent"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:id="@+id/title"
            android:paddingTop="19dp"
            android:paddingBottom="19dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_STICKER"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/title_line"
            android:background="@drawable/live_bg_white_r1_a03"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <View
            android:id="@+id/custom_sticker_parent"
            android:background="@drawable/live_bg_white_r16_a03"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_line"
            flatten="true"/>
        <p151v.VImage
            android:id="@+id/custom_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="0x7f08268f"
            android:layout_marginStart="18dp"
            app:layout_constraintBottom_toBottomOf="@+id/custom_sticker_parent"
            app:layout_constraintStart_toStartOf="@+id/custom_sticker_parent"
            app:layout_constraintTop_toTopOf="@+id/custom_sticker_parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:id="@+id/custom_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_CUSTOM_STICKER"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@+id/custom_icon"
            app:layout_constraintTop_toTopOf="@+id/custom_icon"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/custom_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_MAKE_STICKER"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/custom_icon"
            app:layout_constraintStart_toEndOf="@+id/custom_icon"/>
        <ImageView
            android:id="@+id/custom_go_image"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="0x7f08268e"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/custom_sticker_parent"
            app:layout_constraintEnd_toEndOf="@+id/custom_sticker_parent"
            app:layout_constraintTop_toTopOf="@+id/custom_sticker_parent"/>
        <p151v.VRecyclerView
            android:id="@+id/sticker_list"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintHeight_max="458dp"
            app:layout_constraintHeight_min="224dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/custom_sticker_parent"
            app:layout_constraintVertical_bias="0"
            app:layout_goneMarginTop="20dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.sticker.LiveStickerPickView>
