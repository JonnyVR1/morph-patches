<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#59000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetCpUpLevelAwardDialog">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/dialogContent"
        android:background="@drawable/live_bg_white_r15"
        android:layout_width="315dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="97dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/live_323333"
            android:gravity="center"
            android:id="@+id/cpHouseLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="28dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#aaaaaa"
            android:gravity="center"
            android:id="@+id/cpHouseLevelValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="28dp"/>
        <p151v.VRecyclerView
            android:id="@+id/gift_recycle"
            android:layout_width="wrap_content"
            android:layout_height="111dp"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/iknowBtn"
            android:background="@drawable/live_shape_voice_sweet_light_btn_bg"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/LIVE_ALERT_IKNOW"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/closeView"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="0x7f082823"
        app:layout_constraintEnd_toEndOf="@+id/dialogContent"
        app:layout_constraintTop_toTopOf="@+id/dialogContent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
