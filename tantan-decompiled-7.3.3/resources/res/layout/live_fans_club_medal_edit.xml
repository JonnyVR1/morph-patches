<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.fansclub.widget.LiveFansClubMedalEditPanel xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.fansclub.widget"
    holder="LiveFansClubMedalEditPanel">
    <View
        android:id="@+id/empty_view"
        android:background="#66000000"
        android:layout_width="match_parent"
        android:layout_height="127dp"/>
    <RelativeLayout
        android:id="@+id/content"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="562dp"
        android:layout_alignParentBottom="true"
        flatten="true">
        <FrameLayout
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#e6000000"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/LIVE_FANS_CLUB_EDIT_PANEL_TITLE"/>
            <p151v.VImage
                android:layout_gravity="start|center_vertical"
                android:id="@+id/back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f082295"
                android:scaleType="centerInside"
                android:layout_marginStart="16dp"/>
            <p151v.VImage
                android:layout_gravity="end|center_vertical"
                android:id="@+id/help"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f082341"
                android:layout_marginEnd="16dp"/>
            <View
                android:layout_gravity="bottom"
                android:background="#f9f9f9"
                android:layout_width="match_parent"
                android:layout_height="3dp"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/preview_panel"
            android:background="@drawable/live_list_bg_fans_medal_preview"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/title"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#f0873c"
                android:id="@+id/medal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/LIVE_FANS_CLUB_MEDAL_PREVIEW"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/live_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.33"
                ignore="true"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/live_guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.66"
                ignore="true"/>
            <View
                android:id="@+id/medal_preview_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="3dp"
                app:layout_constraintBottom_toTopOf="@+id/live_guideline2"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/medal_preview_2"
                app:layout_constraintTop_toTopOf="@+id/live_guideline"/>
            <View
                android:id="@+id/medal_preview_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="3dp"
                app:layout_constraintBottom_toTopOf="@+id/live_guideline2"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintLeft_toRightOf="@+id/medal_preview_1"
                app:layout_constraintRight_toLeftOf="@+id/medal_preview_3"
                app:layout_constraintTop_toTopOf="@+id/live_guideline"/>
            <View
                android:id="@+id/medal_preview_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="3dp"
                app:layout_constraintBottom_toTopOf="@+id/live_guideline2"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintLeft_toRightOf="@+id/medal_preview_2"
                app:layout_constraintRight_toLeftOf="@+id/medal_preview_4"
                app:layout_constraintTop_toTopOf="@+id/live_guideline"/>
            <View
                android:id="@+id/medal_preview_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="3dp"
                app:layout_constraintBottom_toTopOf="@+id/live_guideline2"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toRightOf="@+id/medal_preview_3"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/live_guideline"/>
            <View
                android:id="@+id/medal_preview_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="57dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="29dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/medal_preview_6"
                app:layout_constraintTop_toBottomOf="@+id/medal_preview_1"/>
            <View
                android:id="@+id/medal_preview_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="29dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintLeft_toRightOf="@+id/medal_preview_5"
                app:layout_constraintRight_toLeftOf="@+id/medal_preview_7"
                app:layout_constraintTop_toBottomOf="@+id/medal_preview_1"/>
            <View
                android:id="@+id/medal_preview_7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="29dp"
                android:layout_marginEnd="57dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="75:21"
                app:layout_constraintLeft_toRightOf="@+id/medal_preview_6"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/medal_preview_1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ScrollView
            android:id="@+id/options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="87dp"
            android:layout_below="@+id/preview_panel"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="27dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#4d000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_FANS_CLUB_EDIT_PANEL_COLOR"/>
                <p151v.VScroll_Horizontal
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/colors"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </p151v.VScroll_Horizontal>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#4d000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/LIVE_FANS_CLUB_EDIT_PANEL_ICON"/>
                <p151v.VScroll_Horizontal
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/icons"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </p151v.VScroll_Horizontal>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#4d000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/LIVE_FANS_CLUB_EDIT_PANEL_TEXT"
                    android:layout_alignParentLeft="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/live_black"
                    android:gravity="center_vertical"
                    android:id="@+id/text_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="14dp"/>
            </LinearLayout>
        </ScrollView>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#c7d2db"
            android:id="@+id/network_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_FANS_CLUB_NETWORK_ERROR"
            android:drawableTop="0x7f0822a7"
            android:drawablePadding="6dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/content_thirty">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/content_first"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#99ffffff"
            android:gravity="center"
            android:id="@+id/content_second"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/content_thirty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.live.livingroom.common.fansclub.widget.LiveFansClubMedalEditPanel>
