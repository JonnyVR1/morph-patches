<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginBottom="8dp"
    flatten="true"
    holder="moments.inprofile.MomentsInProfileViewModel">
    <p151v.VImage
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="-8dp"
        android:src="@color/moments_profile_placeholder_color"
        android:scaleType="centerCrop"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#b2ffffff"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/muted_indicator"
        android:background="@drawable/moment_muted_indicator_bg"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginRight="8dp"
        android:text="@string/MOMENTS_THIS_USER_IS_MUTED"
        android:drawableLeft="0x7f0828fd"
        android:drawablePadding="8dp"
        app:typeface="medium"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="97dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/profile_frame"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VDraweeView
                        android:id="@+id/profile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        style="@style/feed_fresco_profile_small"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:id="@+id/verification_icon"
                        android:background="0x7f081e18"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="16dp"/>
                </FrameLayout>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    app:typeface="regular"/>
            </LinearLayout>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/message"
                android:background="@drawable/moments_in_profile_button_rounded"
                android:paddingLeft="12dp"
                android:paddingRight="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:minWidth="98dp"
                android:minHeight="34dp"
                android:text="@string/MOMENTS_USER_MOMENTS_MESSAGE_BUTTON_TITLE"
                android:drawableLeft="0x7f081da2"
                android:drawablePadding="4dp"
                android:layout_below="@+id/profile_frame"
                app:typeface="medium"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
