<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LiveGuardInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment"
    holder="knight.view.LiveGuardInfoView">
    <p151v.VDraweeView
        android:id="@+id/user_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"
        app:roundingBorderColor="#cdd8ff"
        app:roundingBorderWidth="2dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/rank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/rank_title"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/user_icon"
        app:layout_constraintRight_toLeftOf="@+id/guard_value"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#b3ffffff"
        android:id="@+id/rank_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CURRENT_RANK"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintLeft_toLeftOf="@+id/rank"
        app:layout_constraintRight_toRightOf="@+id/rank"
        app:layout_constraintTop_toBottomOf="@+id/rank"/>
    <View
        android:id="@+id/div_left"
        android:background="@drawable/live_bg_white_r0p5_a30"
        android:layout_width="1dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/rank"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/guard_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/guard_title"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/rank"
        app:layout_constraintRight_toLeftOf="@+id/gap_rank"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#b3ffffff"
        android:id="@+id/guard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_GUARD_VALUE"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintLeft_toLeftOf="@+id/guard_value"
        app:layout_constraintRight_toRightOf="@+id/guard_value"
        app:layout_constraintTop_toBottomOf="@+id/guard_value"/>
    <View
        android:id="@+id/div_right"
        android:background="@drawable/live_bg_white_r0p5_a30"
        android:layout_width="1dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/guard_value"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/gap_rank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/gap_rank_title"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/guard_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#b3ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/gap_rank_title"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_DISTANCE_FRONT_RANK"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintLeft_toRightOf="@+id/div_right"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gap_rank"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LiveGuardInfoView>
