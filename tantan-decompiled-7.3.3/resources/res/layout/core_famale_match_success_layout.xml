<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.newanim.FemaleMatchSuccessHelper">
    <com.p051p1.mobile.putong.core.p058ui.match.view.FemaleMatchSuccessLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        flatten="true">
        <View
            android:id="@+id/background"
            android:background="@drawable/core_female_match_success_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svge_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="99dp"
            android:layout_marginRight="70dp">
            <p151v.VText
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="你有一个新配对"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="middle"
                android:layout_gravity="bottom"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="23dp"
                android:text="轻触和 RedBull RedBull RedBull RedBull 聊天"
                android:singleLine="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="middle"
                android:layout_gravity="bottom"
                android:id="@+id/change_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="23dp"
                android:text="轻触和 RedBull RedBull RedBull RedBull 聊天"
                android:singleLine="true"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="20sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/emoji_text"
            android:background="@drawable/core_match_success_emoji_bg"
            android:padding="0dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            app:autoEmojis="true"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </com.p051p1.mobile.putong.core.p058ui.match.view.FemaleMatchSuccessLayout>
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignBottom="@+id/content"
        android:layout_alignStart="@+id/content">
        <p151v.VDraweeView
            android:id="@+id/me_head"
            android:background="@drawable/core_group_chat_join_bg_selected"
            android:layout_width="40dp"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:rotation="-10"
            android:layout_marginStart="20dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <p151v.VDraweeView
            android:id="@+id/other_head"
            android:background="@drawable/core_group_chat_join_bg_selected"
            android:layout_width="40dp"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:rotation="10"
            android:layout_marginStart="40dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="6dp"/>
        <p151v.VDraweeView
            android:id="@+id/change_other_head"
            android:background="@drawable/core_group_chat_join_bg_selected"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:rotation="10"
            android:layout_marginStart="40dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="6dp"/>
    </FrameLayout>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svge_flower"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_alignBottom="@+id/content"/>
</p151v.VRelative>
