<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/core_ai_translate_guide_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="3dp">
    <p151v.VImage
        android:id="@+id/ai_translate_guide_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f080e99"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/black"
        android:id="@+id/ai_translate_guide_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/INTL_TT_AITRANSLATE_GUIDE"
        android:layout_weight="1"
        app:typeface="medium"/>
    <p151v.VImage
        android:id="@+id/ai_translate_guide_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/core_message_notify_close_ic"
        android:scaleType="centerInside"/>
</p151v.VLinear>
