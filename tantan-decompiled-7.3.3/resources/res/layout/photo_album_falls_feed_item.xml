<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumFallsFeedItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="photoalbum.PhotoAlbumFallsFeedItem">
    <p151v.VDraweeView
        android:id="@+id/pic"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:fadeDuration="300"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#de000000"
        android:gravity="center"
        android:id="@+id/content_image"
        android:background="#fbfbfb"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4sp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/photo_album_falls_feed_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="66dp">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/personal_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <p151v.VDraweeView
                android:id="@+id/profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="7dp"
                style="@style/feed_fresco_profile_small"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/distance_and_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="1"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="bottom"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginBottom="34dp"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDy="1"
            android:shadowRadius="1"/>
    </FrameLayout>
    <p151v.VImage
        android:layout_gravity="top|right"
        android:id="@+id/video_flag"
        android:background="0x7f082955"
        android:visibility="gone"
        android:layout_width="21dp"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="9dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.PhotoAlbumFallsFeedItem>
