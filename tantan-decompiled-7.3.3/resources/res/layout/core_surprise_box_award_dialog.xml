<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="dlg.SurpriseBoxAwardDialog">
    <FrameLayout
        android:background="@drawable/core_bg_white_r20"
        android:layout_width="313dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:id="@+id/bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="208dp"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="20dp"/>
        <p151v.VLinear
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="313dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/ll_liked_user"
                android:visibility="visible"
                android:layout_width="313dp"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="left"
                    android:id="@+id/user_me"
                    android:background="@drawable/core_surprise_box_liked_avatar_bg"
                    android:padding="4dp"
                    android:layout_width="98dp"
                    android:layout_height="98dp"
                    android:layout_marginLeft="66dp"
                    android:layout_marginTop="68dp"
                    android:layout_marginBottom="42dp"
                    app:roundAsCircle="true"/>
                <p151v.VDraweeView
                    android:layout_gravity="right"
                    android:id="@+id/user_liked"
                    android:background="@drawable/core_surprise_box_liked_avatar_bg"
                    android:padding="4dp"
                    android:layout_width="98dp"
                    android:layout_height="98dp"
                    android:layout_marginTop="68dp"
                    android:layout_marginRight="67dp"
                    android:layout_marginBottom="42dp"
                    app:roundAsCircle="true"/>
                <p151v.VIcon
                    android:layout_gravity="right"
                    android:id="@+id/close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:src="0x7f0817b6"
                    android:layout_marginEnd="16dp"/>
                <p151v.VIcon
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/heart"
                    android:background="0x7f0817b8"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="138dp"/>
            </FrameLayout>
            <p151v.VFrame
                android:id="@+id/ll_exposure"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:background="@drawable/core_surprise_box_expose_avatar_bg"
                    android:layout_width="76dp"
                    android:layout_height="90dp"
                    android:layout_marginLeft="104dp"
                    android:layout_marginTop="71dp"
                    android:src="@drawable/core_surprise_box_exposure_img"
                    android:rotation="-10"/>
                <p151v.VDraweeView
                    android:id="@+id/exposure_me"
                    android:background="@drawable/core_surprise_box_expose_avatar_bg"
                    android:padding="4dp"
                    android:layout_width="90dp"
                    android:layout_height="115dp"
                    android:layout_marginLeft="116dp"
                    android:layout_marginTop="56dp"
                    android:layout_marginBottom="37dp"
                    android:rotation="7"
                    app:placeholderImage="@color/white"
                    app:roundedCornerRadius="10dp"/>
                <p151v.VImage
                    android:layout_gravity="bottom|right"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="99dp"
                    android:layout_marginBottom="33dp"
                    android:src="0x7f0817ba"/>
            </p151v.VFrame>
            <p151v.VImage
                android:id="@+id/iv_boost"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="208dp"
                android:src="0x7f0817b4"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/core_color_323232"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/core_color_999999"
                android:gravity="center"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="32dp"
                android:layout_marginHorizontal="32dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/main_btn"
                android:background="@drawable/core_bg_fe7e1d_r10"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/core_color_cccccc"
                android:gravity="center"
                android:id="@+id/minor_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="我知道了"/>
            <p151v.VLinear
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_greeting"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="32dp"
                flatten="true">
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_1"
                    android:background="@drawable/core_new_ui_match_success_emoji_bg"
                    android:padding="0dp"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_margin="0dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_2"
                    android:background="@drawable/core_new_ui_match_success_emoji_bg"
                    android:padding="0dp"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_3"
                    android:background="@drawable/core_new_ui_match_success_emoji_bg"
                    android:padding="0dp"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_4"
                    android:background="@drawable/core_new_ui_match_success_emoji_bg"
                    android:padding="0dp"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
