<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="accountnew.loginopt.viewmodel.OriginalSMSActViewModel">
    <p151v.VImage
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:src="0x7f080387"
        android:layout_marginStart="10dp"/>
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:src="@drawable/account_original_sms_icon"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText_NoTopPadding
                android:textSize="24sp"
                android:textColor="#01040d"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="174dp"
                android:text="@string/INTL_MO_REQUEST_TITLE"
                android:paddingEnd="20dp"
                android:layout_marginStart="20dp"
                app:fontWeight="500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4d000000"
                android:gravity="start"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/INTL_MO_REQUEST_SUBTITLE"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:paddingEnd="40dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <p151v.VImage
                android:id="@+id/step_1_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/account_intl_original_sms_dot_icon"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/step_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/step_1"/>
            <p151v.VText_NoTopPadding
                android:textSize="18sp"
                android:textColor="@color/black"
                android:id="@+id/step_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="@string/INTL_MO_REQUEST_STEP1"
                android:layout_marginStart="42dp"
                app:fontWeight="500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4d000000"
                android:id="@+id/step_1_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/INTL_MO_REQUEST_DESCRPTION1"
                android:lineSpacingExtra="2dp"
                android:paddingStart="42dp"
                android:paddingEnd="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_1"/>
            <p151v.VImage
                android:id="@+id/step_2_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/account_intl_original_sms_dot_icon"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/step_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/step_2"/>
            <p151v.VText_NoTopPadding
                android:textSize="18sp"
                android:textColor="@color/black"
                android:id="@+id/step_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:text="@string/INTL_MO_REQUEST_STEP2"
                android:layout_marginStart="42dp"
                app:fontWeight="500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_1_info"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4d000000"
                android:id="@+id/step_2_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/INTL_MO_REQUEST_DESCRPTION2"
                android:lineSpacingExtra="2dp"
                android:paddingStart="42dp"
                android:paddingEnd="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/step_2"/>
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f080b67"
                android:layout_marginVertical="8dp"
                app:layout_constraintBottom_toTopOf="@+id/step_2_dot"
                app:layout_constraintEnd_toEndOf="@+id/step_1_dot"
                app:layout_constraintStart_toStartOf="@+id/step_1_dot"
                app:layout_constraintTop_toBottomOf="@+id/step_1_dot"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </p151v.VScroll>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn"
        android:background="@drawable/common_origin_16_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="44dp"
        android:text="@string/INTL_MO_REQUEST_BUTTON1"
        android:layout_marginHorizontal="20dp"
        app:fontWeight="500"/>
</p151v.VLinear>
