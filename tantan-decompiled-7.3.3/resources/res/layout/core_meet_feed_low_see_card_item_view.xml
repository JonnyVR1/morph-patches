<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="0x7f080e53"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="newmeet.feed.seecard.MeetFeedSeeCardItemView">
    <include
        android:layout_gravity="center"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/core_meet_feed_see_card_item"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/one"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/core_meet_feed_see_card_item"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/two_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <include
            android:layout_gravity="center"
            android:id="@+id/two"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/core_meet_feed_see_card_item"/>
        <LinearLayout
            android:gravity="bottom"
            android:id="@+id/count_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:layout_marginRight="-10dp"
            android:layout_alignTop="@+id/two"
            android:layout_alignRight="@+id/two"
            flatten="true">
            <p151v.VImage
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="0x7f080e5c"/>
            <com.p051p1.mobile.putong.core.newui.newmeet.feed.seecard.StrokeTextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#ffba63"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-5dp"
                android:text="66"
                app:stroke_color="@color/white"
                app:stroke_width="8dp"/>
        </LinearLayout>
    </RelativeLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/three"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/core_meet_feed_see_card_item"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/four"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/core_meet_feed_see_card_item"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/default_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/core_meet_feed_see_card_item_default"/>
</FrameLayout>
