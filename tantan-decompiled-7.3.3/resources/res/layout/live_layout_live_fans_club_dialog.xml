<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common.fansclub"
    holder="FansClubDialogHolder">
    <View
        android:id="@+id/white_background"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <p151v.VImage
        android:id="@+id/fans_club_description"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/white_background"
        app:srcCompat="0x7f0822a0"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="513dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.common.fansclub.widget.LiveFansClubAnchorProfileView
            android:id="@+id/anchor_profile_view"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="fill_vertical"
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxWidth="280dp"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#66000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <p151v.VImage
                        android:id="@+id/fans_medal_image"
                        android:layout_width="75dp"
                        android:layout_height="21dp"/>
                    <p151v.VImage
                        android:id="@+id/setting_button"
                        android:visibility="gone"
                        android:layout_width="25dp"
                        android:layout_height="21dp"
                        android:scaleType="fitXY"
                        android:layout_marginStart="4dp"
                        app:srcCompat="0x7f0822b4"/>
                </LinearLayout>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#fe7e1d"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/desc_text"
                    android:background="@drawable/live_bg_fe7e1d_r12_a10"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="4dp"
                    android:drawableStart="0x7f08233d"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.fansclub.widget.LiveFansClubLevelView
                    android:id="@+id/level_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/task_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:nestedScrollingEnabled="false"/>
                <include
                    android:id="@+id/sweet_company"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="20dp"
                    layout="@layout/live_layout_fans_club_sweet_company"/>
                <include
                    android:id="@+id/events"
                    android:layout_width="match_parent"
                    android:layout_height="390dp"
                    android:nestedScrollingEnabled="false"
                    layout="@layout/live_layout_live_fans_club_event_view"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include
        android:id="@+id/bottom_fans_select"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true"
        layout="@layout/live_fans_club_bottom_select"/>
</androidx.constraintlayout.widget.ConstraintLayout>
