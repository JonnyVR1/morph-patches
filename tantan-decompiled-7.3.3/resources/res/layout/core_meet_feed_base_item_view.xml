<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.feed.MeetFeedBaseItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="25.5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="newmeet.feed.MeetFeedBaseItemView">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/avatar_border"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_frame"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_frame"
        app:layout_constraintRight_toRightOf="@+id/avatar_frame"
        app:layout_constraintTop_toTopOf="@+id/avatar_frame"/>
    <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
        android:id="@+id/avatar_frame"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="21dp"
        android:layout_marginStart="11dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/core_default_head_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/core_default_head_bg"
        app:roundAsCircle="true"/>
    <p151v.VLinear_FillerMeasure
        android:orientation="horizontal"
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        app:fillerIndex="0"
        app:layout_constraintBottom_toTopOf="@+id/relationship"
        app:layout_constraintLeft_toRightOf="@+id/avatar_frame"
        app:layout_constraintRight_toLeftOf="@+id/buttons"
        app:layout_constraintTop_toTopOf="@+id/avatar_frame"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:layout_gravity="left"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:typeface="medium"/>
        <androidx.legacy.widget.Space
            android:layout_gravity="center"
            android:id="@+id/verification_space"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="wrap_content"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/verification_icon"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginHorizontal="2dp"/>
        <androidx.legacy.widget.Space
            android:layout_gravity="center"
            android:id="@+id/o_diamond_space"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="wrap_content"/>
        <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
            android:layout_gravity="center"
            android:id="@+id/o_diamond_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="17dp"/>
    </p151v.VLinear_FillerMeasure>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#66000000"
        android:id="@+id/relationship"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_frame"
        app:layout_constraintLeft_toLeftOf="@+id/info"
        app:layout_constraintTop_toBottomOf="@+id/info"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_frame"
        app:layout_constraintHorizontal_bias="100"
        app:layout_constraintLeft_toRightOf="@+id/info"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar_frame">
        <p151v.VFrame_Shadow
            android:id="@+id/like_or_superlike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:sl_cornerRadius="50dp"
            app:sl_shadowColor="#145d4000"
            app:sl_shadowRadius="4dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/icon"
                android:background="@drawable/core_business_circle_resource"
                android:padding="10dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="0x7f080e5d"
                android:scaleType="fitXY"/>
        </p151v.VFrame_Shadow>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="0x7f080e47"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_frame"
            app:layout_constraintHorizontal_bias="100"
            app:layout_constraintLeft_toRightOf="@+id/button"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar_frame"/>
        <p151v.VFrame_Shadow
            android:id="@+id/btn_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:sl_cornerRadius="14dp"
            app:sl_shadowColor="#145d4000"
            app:sl_shadowRadius="8dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/btn"
                android:background="@drawable/core_meet_feed_view_all_bg"
                android:paddingLeft="15dp"
                android:paddingTop="9dp"
                android:paddingRight="15dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看全部"
                android:paddingHorizontal="15dp"
                android:paddingVertical="9dp"/>
        </p151v.VFrame_Shadow>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/content_parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/avatar_frame"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#fe7e1d"
        android:gravity="center"
        android:id="@+id/notes"
        android:background="@drawable/core_meet_feed_notes_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:drawableLeft="0x7f080e4c"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/content_parent"
        app:layout_constraintRight_toRightOf="@+id/content_parent"/>
    <View
        android:id="@+id/notes_mask"
        android:background="#80ffffff"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/notes"
        app:layout_constraintLeft_toLeftOf="@+id/notes"
        app:layout_constraintRight_toRightOf="@+id/notes"
        app:layout_constraintTop_toTopOf="@+id/notes"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tag_layout"
        android:paddingLeft="16dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/expandable_text"
        app:layout_constraintTop_toBottomOf="@+id/content_parent"/>
    <com.p051p1.mobile.putong.core.newui.newmeet.feed.CoreExpandableTextContainer
        android:id="@+id/expandable_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        app:expandText="展开"
        app:isTextExpandSameLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tag_layout"
        app:maxCollapsedLines="2">
        <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
            android:textSize="14sp"
            android:textColor="#3c3c3c"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="9sp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_orange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </com.p051p1.mobile.putong.core.newui.newmeet.feed.CoreExpandableTextContainer>
</com.p051p1.mobile.putong.core.newui.newmeet.feed.MeetFeedBaseItemView>
