<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageWCInviteAfter xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/core_msg_cell_no_pic_margin"
    android:layout_marginRight="@dimen/core_msg_cell_no_pic_margin"
    flatten="true"
    holder="messages.ItemMessageWCInviteAfter">
    <RelativeLayout
        android:id="@+id/content"
        android:background="@drawable/core_bg_dlg_know_my_self"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/left_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            app:roundedCornerRadius="8dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/complete"
            android:background="@drawable/core_bg_8_ff700b"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="12dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/complete"
            android:layout_toRightOf="@+id/left_icon"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_000000_40"
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/complete"
            android:layout_toRightOf="@+id/left_icon"
            android:layout_below="@+id/title"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageWCInviteAfter>
