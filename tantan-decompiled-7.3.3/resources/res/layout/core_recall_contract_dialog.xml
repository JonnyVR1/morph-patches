<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="renew.RenewPrivilegeRecallDialog">
    <p151v.VImage
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginRight="16dp"
        android:src="0x7f080723"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutrootview"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="63dp"
            flatten="true">
            <p151v.VText
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_gravity="bottom"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_gravity="bottom"
                android:id="@+id/title_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="额外福利"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ff5435"
            android:id="@+id/subtitle"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="8dp"
            android:text="「加速曝光」已失效"/>
        <View
            android:id="@+id/redline"
            android:background="@color/core_pricerecall2_line_bg_tell"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginLeft="26dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="26dp"
            android:layout_marginBottom="40dp"/>
        <TextView
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#ff5435"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:text="当前无需扣款\10开通免密支付即可恢复福利"
            android:lineSpacingExtra="8dp"/>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="#999999"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="16dp"
            android:text="* 加速曝光福利为连续包月会员专享福利 \10   5天后将以￥26/季自动续费"
            android:lineSpacingExtra="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#cc212121"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/deadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="「加速曝光」已失效 6天"/>
        <p151v.VImage
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f080d97"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:id="@+id/btn_pay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <TextView
                android:textSize="15dp"
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/pay_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="支付宝支付"
                android:drawableLeft="0x7f080d95"
                android:drawablePadding="11dp"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="4dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="#ff5435"
                android:layout_gravity="center_vertical"
                android:id="@+id/prom_text"
                android:background="@drawable/core_alipay_sell_rect"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:maxLines="1"
                android:layout_toRightOf="@+id/pay_txt"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:src="0x7f080d93"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/goto_renew"
            android:background="@drawable/core_lowprice_select_tips_updown_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            android:text="立即开通恢复福利"/>
    </LinearLayout>
</FrameLayout>
