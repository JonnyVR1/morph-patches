<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="0x7f080fd5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/img"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="14dp"
        fresco:actualImageScaleType="fitCenter"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/move_btn"
            android:layout_width="68dp"
            android:layout_height="44dp"
            android:text="@string/STICKERS_MOVE_TO_FRONT"
            android:singleLine="true"
            fresco:typeface="medium"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/delete_btn"
            android:layout_width="68dp"
            android:layout_height="44dp"
            android:text="@string/STICKERS_DELETE"
            fresco:typeface="medium"/>
    </LinearLayout>
</LinearLayout>
