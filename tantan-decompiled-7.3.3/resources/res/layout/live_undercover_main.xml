<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.game.undercover.viewmodule.UndercoverMainView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="290dp"
    flatten="true"
    holder="voice.intl.game.undercover.viewmodule.UndercoverMainView">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#daf4ff"
        android:layout_gravity="start"
        android:id="@+id/help_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:drawableLeft="0x7f08234d"
        android:drawablePadding="4dp"
        android:layout_marginStart="13dp"/>
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:src="0x7f08234c"
        android:layout_marginEnd="13dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.game.undercover.viewmodule.UndercoverMainView>
