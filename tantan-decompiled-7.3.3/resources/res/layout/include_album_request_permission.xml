<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/permission_layout"
        android:background="@color/white"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VIcon
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="16dp"
            android:src="0x7f081fa7"
            app:iconStyle="xxSmall"/>
        <p151v.VText_AutoFit
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="@string/INTL_VISUAL_USER_SELECTED_TITLE"
            android:maxLines="1"
            android:layout_weight="1"/>
        <p151v.VButton
            android:layout_gravity="center"
            android:layout_marginRight="20dp"
            android:text="@string/INTL_VISUAL_USER_SELECTED_BTN"
            style="@style/common_button_small_01"/>
    </p151v.VLinear>
</merge>
