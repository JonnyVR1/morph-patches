<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/passby"
    android:paddingTop="0dp"
    flatten="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:id="@+id/times"
        android:background="@color/transparent"
        android:paddingBottom="17dp"
        style="@style/profile_item_title_black_no_bg"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/core_newui_profile_passby_bg"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <p151v.VDraweeView
            android:id="@+id/map_static"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginRight="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingRight="136dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="9dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"/>
        </LinearLayout>
        <p151v.VDraweeView
            android:id="@+id/my_pic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundingBorderWidth="2dp"
            style="@style/core_fresco_profile_white_border"/>
        <p151v.VDraweeView
            android:id="@+id/other_pic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundingBorderWidth="2dp"
            style="@style/core_fresco_profile_white_border"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear_Dividers>
