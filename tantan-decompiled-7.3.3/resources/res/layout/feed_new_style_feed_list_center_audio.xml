<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterAudioView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="photoalbum.feedcenter.FeedCenterAudioView">
    <include layout="@layout/feed_photo_album_activities_time"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/audio_root"
        android:paddingLeft="64dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
            android:id="@+id/moment_expandable_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expandLine="3"
            app:expandText="@string/DISCOVER_MOMENT_SPREAD"
            app:isTextExpandSameLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxCollapsedLines="4">
            <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                android:textSize="16sp"
                android:textColor="#222222"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_orange"
            android:ellipsize="end"
            android:id="@+id/moment_hyperlinks"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:singleLine="true"/>
        <com.p051p1.mobile.putong.feed.newui.view.FeedAudioPlayerView
            android:id="@+id/audio_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moment_expandable_text"
            app:layout_goneMarginTop="0dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_extra_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/audio_divider"
            android:background="#d8d8d8"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </LinearLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterAudioView>
