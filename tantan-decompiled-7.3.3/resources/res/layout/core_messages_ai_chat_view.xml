<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.aichat.AIChatView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    holder="messages.aichat.AIChatView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ai_title"
        android:background="0x7f080eca"
        android:layout_width="82dp"
        android:layout_height="25dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080ec9"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#000000"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:text="恋语助手"/>
    </p151v.VLinear>
    <RelativeLayout
        android:id="@+id/step1"
        android:paddingLeft="16dp"
        android:paddingTop="45dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.p051p1.mobile.putong.core.p058ui.messages.aichat.TextHide
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="让我来帮你分析匹配度，更好与对方聊天"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/loading_point1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/title"
            android:layout_alignTop="@+id/title"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/title">
            <RelativeLayout
                android:id="@+id/analysis_summary"
                android:layout_width="0dp"
                android:layout_height="184dp"
                android:layout_weight="1"
                flatten="true">
                <com.tantan.library.svga.SVGAnimationView
                    android:id="@+id/analysis_summary_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/summary_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    flatten="true">
                    <com.tantan.library.svga.SVGAnimationView
                        android:id="@+id/analysis_summary_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#9c6f7b"
                        android:id="@+id/analysis_summary_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="情感分析 · "/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#9c6f7b"
                        android:gravity="center"
                        android:id="@+id/analysis_summary_times"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="次"/>
                </p151v.VLinear>
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#714454"
                    android:id="@+id/analysis_summary_content"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="帮你看看对方\10在想什么？"
                    android:layout_below="@+id/summary_title_layout"
                    android:lineSpacingExtra="2dp"/>
                <p151v.VLinear
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/analysis_summary_btn"
                    android:background="@drawable/core_chat_ai_step1_button_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    flatten="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0806bb"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#714454"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="分析对话"/>
                </p151v.VLinear>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/analysis_answer"
                android:layout_width="0dp"
                android:layout_height="184dp"
                android:layout_marginLeft="13dp"
                android:layout_weight="1"
                flatten="true">
                <com.tantan.library.svga.SVGAnimationView
                    android:id="@+id/analysis_answer_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/answer_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    flatten="true">
                    <com.tantan.library.svga.SVGAnimationView
                        android:id="@+id/analysis_answer_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#9c6f7b"
                        android:id="@+id/analysis_answer_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="智能话术 · "/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#9c6f7b"
                        android:gravity="center"
                        android:id="@+id/analysis_answer_times"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="次"/>
                </p151v.VLinear>
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#714454"
                    android:id="@+id/analysis_answer_content"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="如何回复能让\10对方满意？"
                    android:layout_below="@+id/answer_title_layout"
                    android:lineSpacingExtra="2dp"/>
                <p151v.VLinear
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/analysis_answer_btn"
                    android:background="@drawable/core_chat_ai_step1_button_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    flatten="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0806bb"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#714454"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="生成话术"/>
                </p151v.VLinear>
            </RelativeLayout>
        </p151v.VLinear>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/step2"
        android:background="0x7f080ec6"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/icon_title"
            android:background="0x7f080eca"
            android:layout_width="82dp"
            android:layout_height="25dp"
            android:layout_marginTop="14dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080ec9"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#000000"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text="恋语助手"/>
        </p151v.VLinear>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/step2_loading_svga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_centerInParent="true"/>
        <com.p051p1.mobile.putong.core.p058ui.messages.aichat.TextHide
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:id="@+id/title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="好的，让我想一想..."
            android:layout_below="@+id/icon_title"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/loading_point2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/title2"
            android:layout_alignTop="@+id/title2"/>
        <RelativeLayout
            android:id="@+id/error_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/title2"
            flatten="true">
            <ImageView
                android:id="@+id/error_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080ecb"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/error_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:src="0x7f080ecc"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textColor="#32323266"
                android:gravity="center"
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载失败，请稍后重试"
                android:layout_below="@+id/error_image"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/step3"
        android:paddingTop="45dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.p051p1.mobile.putong.core.p058ui.messages.aichat.TextHide
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:id="@+id/title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="这是我帮你想到的回复"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/loading_point3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/title3"
            android:layout_alignTop="@+id/title3"/>
        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f080ecb"
            android:layout_alignParentRight="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/title3"/>
        <ImageView
            android:background="0x7f080fd4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.aichat.AIChatView>
