<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.HomeTitleLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/titlebar"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.HomeTitleLayout">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/default_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="true">
        <p151v.VButton
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/position"
            android:background="@drawable/core_home_title_location_bg"
            android:visibility="gone"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:maxWidth="108dp"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableLeft="0x7f0805f3"
            style="@style/common_button_small_03"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/intl_marketing_campaign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintRight_toLeftOf="@+id/surprise_gift_expose"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/view_tarot"
                android:background="@drawable/common_bg_main_tab"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/tarot_top"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/view_tarot"
                app:layout_constraintLeft_toLeftOf="@+id/view_tarot"
                app:layout_constraintRight_toRightOf="@+id/view_tarot"
                app:layout_constraintTop_toTopOf="@+id/view_tarot"/>
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/operating_entrance"
                android:background="@drawable/core_intl_like_minded_btn_selector"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#f85566"
            android:gravity="center_vertical"
            android:id="@+id/surprise_gift_expose"
            android:background="@drawable/core_surprise_gift_boost_bg"
            android:paddingLeft="4dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="加速曝光中"
            android:drawablePadding="8dp"
            android:drawableStart="0x7f0817c2"
            app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
            app:layout_constraintRight_toLeftOf="@+id/female_vip"
            app:layout_constraintTop_toTopOf="@+id/advancing_title"/>
        <p151v.VIcon
            android:layout_gravity="center_vertical"
            android:id="@+id/just_look_verify"
            android:visibility="gone"
            android:src="0x7f080d08"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
            app:layout_constraintRight_toLeftOf="@+id/female_vip"
            app:layout_constraintTop_toTopOf="@+id/advancing_title"
            style="@style/common_icon_small"/>
        <p151v.VIcon
            android:layout_gravity="center_vertical"
            android:id="@+id/female_vip"
            android:visibility="gone"
            android:src="0x7f080856"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
            app:layout_constraintRight_toLeftOf="@+id/boost_content"
            app:layout_constraintTop_toTopOf="@+id/advancing_title"
            style="@style/common_icon_small"/>
        <p151v.VFrame
            android:layout_gravity="center"
            android:id="@+id/intl_top_undo_parent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
            app:layout_constraintRight_toLeftOf="@+id/boost_content"
            app:layout_constraintTop_toTopOf="@+id/advancing_title"
            flatten="true">
            <p151v.VIcon
                android:id="@+id/intl_top_undo"
                android:visibility="gone"
                android:src="@drawable/core_card_intl_top_undo_icon"
                android:scaleType="center"
                style="@style/common_icon_small"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/boost_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/undo_on_top_parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.view.BoostViewContainer
                android:layout_gravity="center"
                android:id="@+id/boost_top"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boostStyle="1"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:id="@+id/undo_on_top_parent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
            app:layout_constraintRight_toLeftOf="@+id/find_user"
            app:layout_constraintTop_toTopOf="@+id/advancing_title"
            flatten="true">
            <p151v.VIcon
                android:id="@+id/undo_on_top"
                android:padding="5dp"
                android:visibility="gone"
                android:src="0x7f08064c"
                android:scaleType="center"
                style="@style/common_icon_small"/>
        </p151v.VFrame>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#fe7e1d"
            android:gravity="center_vertical"
            android:id="@+id/fake_user_top"
            android:background="@drawable/core_fake_user_home_title_bg"
            android:paddingLeft="8dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:text="上传真实头像"
            android:drawablePadding="1dp"
            android:drawableStart="@drawable/core_fake_user_home_title_ic"
            app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
            app:layout_constraintLeft_toRightOf="@+id/position"
            app:layout_constraintTop_toTopOf="@+id/advancing_title"/>
        <FrameLayout
            android:id="@+id/find_user_root"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VIcon
                android:layout_gravity="center_vertical"
                android:id="@+id/find_user"
                android:background="0x7f08090b"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/advancing_title"
                app:layout_constraintRight_toLeftOf="@+id/advancing_title"
                app:layout_constraintTop_toTopOf="@+id/advancing_title"/>
        </FrameLayout>
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:id="@+id/advancing_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <p151v.VIcon
                android:layout_gravity="center_vertical"
                android:id="@+id/advancing_title_icon"
                android:src="0x7f0805b5"
                style="@style/common_icon_small"/>
            <p151v.VOnlineIndicator
                android:layout_gravity="right"
                android:id="@+id/advancing_title_dot"
                android:visibility="gone"
                style="@style/common_online_indicator_01"/>
        </p151v.VFrame>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ViewStub
        android:layout_gravity="center_vertical"
        android:id="@+id/just_real_layout"
        android:layout="@layout/core_just_real_title_layout_opt"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginLeft="10dp"/>
    <ViewStub
        android:layout_gravity="center_vertical"
        android:id="@+id/fake_profile_layout"
        android:layout="@layout/core_expanded_fake_profile_title_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
</com.p051p1.mobile.putong.core.newui.home.views.HomeTitleLayout>
