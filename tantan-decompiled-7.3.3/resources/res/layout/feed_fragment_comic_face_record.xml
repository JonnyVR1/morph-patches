<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="kankan.recorder.ComicFaceRecorderViewModel">
    <android.view.SurfaceView
        android:id="@+id/video_record_surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/camera_top_mask"
        android:layout_width="match_parent"
        android:layout_height="80dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/camera_bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="88dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/camera_show_face_tip"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="180dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/camera_show_face_corner"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="top|left"
                android:background="0x7f0802d3"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <View
                android:layout_gravity="top|right"
                android:background="0x7f0802d3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:rotation="90"/>
            <View
                android:layout_gravity="bottom|left"
                android:background="0x7f0802d3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:rotation="270"/>
            <View
                android:layout_gravity="bottom|right"
                android:background="0x7f0802d3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:rotation="180"/>
        </FrameLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/camera_show_face_tip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="露个脸吧"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/record_focus_view"
        android:visibility="invisible"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="0x7f0802c0"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/record_alert_change_scence_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:text="换个场景拍一拍"
        android:shadowColor="#4f000000"
        android:shadowRadius="10"
        android:drawablePadding="10dp"/>
    <ImageView
        android:id="@+id/camera_close"
        android:paddingLeft="10dp"
        android:paddingTop="12dp"
        android:paddingRight="10dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="0x7f0802bc"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/camera_control_music"
        android:background="@drawable/feed_camera_select_music_bg"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081cb4"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxWidth="100dp"
            android:text="@string/FEED_SELECT_MUSIC"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:shadowColor="#34000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/video_menu_container"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        flatten="true">
        <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
            android:layout_gravity="center"
            android:id="@+id/camera_switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:image_size="32dp"
            app:main_padding="0dp"
            app:src="0x7f081cb7"
            app:text="@string/FEED_CAPTURE_OVERTURN"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
                android:layout_gravity="center_horizontal"
                android:id="@+id/camera_flash"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:image_size="32dp"
                app:main_padding="0dp"
                app:src="0x7f081ca7"
                app:text="@string/FEED_FLASH"/>
        </FrameLayout>
    </LinearLayout>
    <android.view.ViewStub
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/stub_delete_tip"
        android:visibility="gone"
        android:layout="@layout/view_stub_recorder_delete_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="220.5dp"/>
    <com.p051p1.mobile.putong.feed.newui.kankan.view.FeedComicFacePropMenuView
        android:layout_gravity="bottom"
        android:id="@+id/feed_comic_face_prop_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
