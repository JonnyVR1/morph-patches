<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.call.auction.view.LiveVoiceCallAuctionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_black_r16_a20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="FrameLayout"
    app:binding="true"
    flatten="true">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/panel_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"/>
    <include
        android:id="@+id/collapse_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        layout="@layout/live_virtual_voice_panel_collapse_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flatten="true">
        <androidx.constraintlayout.widget.Group
            android:id="@+id/final_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="live_final_relation_layout,live_final_bidder_avatar, live_final_bidder_name, live_final_bidder_value,live_bless_end_layout,live_final_auctioneer_avatar,live_final_auctioneer_name,live_final_auctioneer_value"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/ongoing_auctioneer_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="live_auctioneer_avatar,live_auctioneer_name,live_auctioneer_value"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/ongoing_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="live_bidder_start,live_relation_img,live_relation_name,live_relation_tip,live_bidder_order_1,live_bidder_order_2,live_bidder_order_3"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/top_baseline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/live_bidder_start"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="52dp"
            android:layout_height="34dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_auctioneer_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/live_auctioneer_avatar"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:id="@+id/auction_step_action"
            android:background="@drawable/live_bg_white_r10_a03"
            android:visibility="gone"
            android:layout_width="52dp"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_bidder_start"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/live_final_relation_layout"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/live_final_auctioneer_avatar">
            <p151v.VDraweeView
                android:id="@+id/final_relation_img"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:roundedCornerRadius="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:ellipsize="end"
                android:id="@+id/final_relation_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLength="4"/>
        </p151v.VLinear>
        <p151v.VDraweeView
            android:id="@+id/live_final_bidder_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintWidth_percent="0.248"
            app:roundedCornerRadius="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/live_final_bidder_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/live_final_auctioneer_name"
            app:layout_constraintLeft_toLeftOf="@+id/live_final_bidder_avatar"
            app:layout_constraintRight_toRightOf="@+id/live_final_bidder_avatar"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_40_opacity"
            android:ellipsize="end"
            android:id="@+id/live_final_bidder_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="8"
            app:layout_constraintBaseline_toBaselineOf="@+id/live_final_auctioneer_value"
            app:layout_constraintLeft_toLeftOf="@+id/live_final_bidder_avatar"
            app:layout_constraintRight_toRightOf="@+id/live_final_bidder_avatar"/>
        <p151v.VDraweeView
            android:id="@+id/live_final_bidder_tag"
            android:visibility="gone"
            android:layout_width="29dp"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_final_bidder_name"
            app:layout_constraintRight_toRightOf="@+id/live_final_bidder_name"
            app:layout_constraintTop_toBottomOf="@+id/live_final_bidder_name"/>
        <p151v.VDraweeView
            android:id="@+id/live_final_auctioneer_avatar"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_baseline"
            app:layout_constraintWidth_percent="0.248"
            app:roundedCornerRadius="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/live_final_auctioneer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintRight_toRightOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintTop_toBottomOf="@+id/live_final_auctioneer_avatar"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_40_opacity"
            android:ellipsize="end"
            android:id="@+id/live_final_auctioneer_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintRight_toRightOf="@+id/live_final_auctioneer_avatar"
            app:layout_constraintTop_toBottomOf="@+id/live_final_auctioneer_name"/>
        <p151v.VDraweeView
            android:id="@+id/live_final_auctioneer_tag"
            android:visibility="gone"
            android:layout_width="29dp"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_final_auctioneer_name"
            app:layout_constraintRight_toRightOf="@+id/live_final_auctioneer_name"
            app:layout_constraintTop_toBottomOf="@+id/live_final_auctioneer_name"/>
        <include
            android:id="@+id/live_auctioneer_avatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="17dp"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_baseline"
            app:layout_constraintWidth_percent="0.248"
            flatten="true"
            layout="@layout/live_voice_auction_avatar"/>
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonAnimMaskAvatarView
            android:id="@+id/virtual_avatar_view"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="6dp"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:layout_constraintBottom_toBottomOf="@+id/live_auctioneer_avatar"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="@+id/live_auctioneer_avatar"
            app:layout_constraintStart_toEndOf="@+id/live_auctioneer_avatar"
            app:layout_constraintWidth_percent="0.124"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/live_auctioneer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_auctioneer_avatar"
            app:layout_constraintRight_toRightOf="@+id/live_auctioneer_avatar"
            app:layout_constraintTop_toBottomOf="@+id/live_auctioneer_avatar"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_40_opacity"
            android:ellipsize="end"
            android:id="@+id/live_auctioneer_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="@+id/live_auctioneer_avatar"
            app:layout_constraintRight_toRightOf="@+id/live_auctioneer_avatar"
            app:layout_constraintTop_toBottomOf="@+id/live_auctioneer_name"/>
        <p151v.VDraweeView
            android:id="@+id/live_relation_img"
            android:padding="3dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_auctioneer_avatar"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/live_auctioneer_avatar"
            app:layout_constraintWidth_percent="0.248"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:id="@+id/live_relation_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="4"
            app:layout_constraintBaseline_toBaselineOf="@+id/live_auctioneer_name"
            app:layout_constraintLeft_toLeftOf="@+id/live_relation_img"
            app:layout_constraintRight_toRightOf="@+id/live_relation_img"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_40_opacity"
            android:ellipsize="end"
            android:id="@+id/live_relation_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="8"
            app:layout_constraintBaseline_toBaselineOf="@+id/live_auctioneer_value"
            app:layout_constraintLeft_toLeftOf="@+id/live_relation_img"
            app:layout_constraintRight_toRightOf="@+id/live_relation_img"/>
        <com.p051p1.mobile.putong.live.livingroom.voice.call.auction.view.LevelView
            android:id="@+id/auctioneer_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_auctioneer_value"/>
        <include
            android:id="@+id/live_bidder_order_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            app:layout_constraintDimensionRatio="w,100:74"
            app:layout_constraintEnd_toStartOf="@+id/live_bidder_order_2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auctioneer_level"
            layout="@layout/live_layout_bidder"/>
        <include
            android:id="@+id/live_bidder_order_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintDimensionRatio="w,100:74"
            app:layout_constraintEnd_toStartOf="@+id/live_bidder_order_3"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/live_bidder_order_1"
            app:layout_constraintTop_toBottomOf="@+id/auctioneer_level"
            layout="@layout/live_layout_bidder"/>
        <include
            android:id="@+id/live_bidder_order_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintDimensionRatio="w,100:74"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/live_bidder_order_2"
            app:layout_constraintTop_toBottomOf="@+id/auctioneer_level"
            layout="@layout/live_layout_bidder"/>
        <TextView
            android:textSize="10sp"
            android:gravity="center"
            android:id="@+id/live_auction_gap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_bidder_order_2"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/live_bless_end_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auctioneer_level">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white_40_opacity"
                android:id="@+id/live_auction_end"
                android:background="@drawable/live_bg_white_r10_a03"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="12dp"
                android:text="结束拍卖"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white"
                android:id="@+id/live_bless_start"
                android:background="@drawable/live_bg_fe7e1d_r10"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="祝福他们"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.call.auction.view.LiveVoiceCallAuctionView>
