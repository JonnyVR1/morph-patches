<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemInstantChatGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/tf_rect_light"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemInstantChatGuideView">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/header_pic"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="12dp"
        style="@style/fresco_profile_small"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <p151v.VLinear_FillerMeasure
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:fillerIndex="0">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/core_color_80percent_000000"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/title_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:enableEmojis="true"
                app:typeface="medium"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/pic_tag"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="16dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/pic_verify_logo"
                    android:background="0x7f082957"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"
                    android:scaleType="fitCenter"/>
                <p151v.VDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/wealth_icon"
                    android:visibility="gone"
                    android:layout_width="34dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
        </p151v.VLinear_FillerMeasure>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            app:typeface="regular"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/instant_chat_btn"
        android:layout_width="65dp"
        android:layout_height="24dp"
        android:layout_marginRight="12dp"
        android:src="0x7f080746"
        android:scaleType="centerCrop"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemInstantChatGuideView>
