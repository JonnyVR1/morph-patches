<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_bg_incent_videoresult"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="incentivevideo.IncentVideoResultAct">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0809bd"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/INTL_REWARDED_VIDEO_CONFIRM_TITLE"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/INTL_REWARDED_VIDEO_CONFIRM_SUNTITLE"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#fe7e1d"
        android:gravity="center_horizontal"
        android:id="@+id/tv_continue"
        android:background="@drawable/core_button_incent_result"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="54dp"
        android:text="@string/INTL_REWARDED_VIDEO_CONFIRM_BUTTON"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
