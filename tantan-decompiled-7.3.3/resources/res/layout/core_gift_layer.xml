<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.layer.CoreGiftLayer xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="gift.layer.CoreGiftLayer">
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svga"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.tantanapp.media.ttmediaeffect.video.VideoEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/video_player"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/preview_tip"
            android:background="@drawable/core_gift_preview_tip_bg"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"/>
        <FrameLayout
            android:id="@+id/txh_tip"
            android:background="@drawable/core_gift_preview_thx_bg"
            android:visibility="gone"
            android:layout_width="168dp"
            android:layout_height="48dp">
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="感谢"
                android:drawableLeft="0x7f0808bb"
                android:drawablePadding="2dp"/>
        </FrameLayout>
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="20dp"
            android:src="0x7f0808b8"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.gift.layer.CoreGiftLayer>
