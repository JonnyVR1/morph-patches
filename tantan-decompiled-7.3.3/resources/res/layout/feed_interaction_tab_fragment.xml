<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="photoalbum.interaction.module.fragment.FeedInteractionTabFrag">
    <p151v.VPullDownRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false"
        flatten="true">
        <com.p051p1.mobile.putong.feed.newui.photoalbum.momentdetail.feedlist.FeedMaxHeightRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            useId="true"/>
    </p151v.VPullDownRefreshLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:id="@+id/empty_img"
            android:layout_width="210dp"
            android:layout_height="150dp"
            android:layout_marginTop="167dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#26000000"
            android:gravity="center"
            android:id="@+id/empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</FrameLayout>
