<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_card_cert_dialog_bg"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="dlg.CardCertificationDialog">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VFrame
            android:id="@+id/photo_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/user_avatar"
                android:layout_width="130dp"
                android:layout_height="130dp"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="70dp"/>
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/frame_overlay"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="0x7f0818a8"
                android:layout_marginStart="48dp"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/common_000000_80"
            android:gravity="center"
            android:id="@+id/cert_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/INLT_TTC_CLONE_CERTIFICATION_CONTENT_ONE"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:typeface="medium"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cert_button"
            android:background="@drawable/core_card_cert_dialog_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/INLT_TTC_CLONE_CERTIFICATION_BUTTON_ONE"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f08209f"
        android:layout_marginEnd="16dp"/>
</p151v.VFrame>
