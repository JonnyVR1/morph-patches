<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/core_new_messages_prompt"
    android:paddingLeft="16dp"
    android:paddingTop="15dp"
    android:paddingRight="15dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="4dp">
    <p151v.VFrame
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/tip_iv"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="0x7f082897"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/break_ice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:text="打个招呼吧！"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:src="0x7f082894"/>
    </p151v.VFrame>
    <p151v.VRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"/>
</p151v.VLinear>
