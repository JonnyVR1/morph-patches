<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="ui"
    holder="intl.visitor.IntlVisitorsViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:pointerIcon="text"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/intl_visitors_discount_banner_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/navigation_bar"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/visitors_ll"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/intl_visitors_discount_banner_container"
        flatten="true">
        <p151v.VPullDownRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srlEnableLoadMore="false"
            flatten="true">
            <p151v.VPullUpRecyclerView
                android:id="@+id/visitors"
                android:paddingTop="7dp"
                android:paddingBottom="126dp"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                useId="true"/>
        </p151v.VPullDownRefreshLayout>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="199dp"
        android:layout_below="@+id/intl_visitors_discount_banner_container">
        <ImageView
            android:id="@+id/empty_img"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:src="0x7f081847"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:id="@+id/empty_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/INTL_VAS_VISITOR_NONE"/>
    </p151v.VLinear>
    <FrameLayout
        android:id="@+id/bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:layout_alignParentBottom="true">
        <View
            android:layout_gravity="top"
            android:background="@drawable/core_intl_visitor_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="71dp"/>
        <View
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="55dp"/>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundTextView
            android:textSize="16sp"
            android:textColor="@color/core_color_e6ffffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/get_privilege"
            android:background="#fe7e1d"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="35dp"
            android:text="@string/INTL_PREMIUM_VISITORS_BUTTON_PAY"
            android:textAllCaps="false"
            app:rRadius="10dp"
            app:typeface="medium"/>
    </FrameLayout>
</RelativeLayout>
