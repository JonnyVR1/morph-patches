<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterImageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/new_feed"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.feedcenter.FeedCenterImageNewViewHome">
    <View
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/feed_photo_album_activities_time"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/new_ab_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/moment_living"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.photoalbum.live.LiveTagView
                android:id="@+id/moment_living_tag"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ff3a00"
                android:id="@+id/moment_living_tag_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="6dp"
                android:text="直播中"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#4a4a4a"
                android:ellipsize="end"
                android:id="@+id/moment_living_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:maxLines="1"/>
        </LinearLayout>
        <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
            android:id="@+id/moment_expandable_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:expandLine="3"
            app:expandText="@string/DISCOVER_MOMENT_SPREAD"
            app:isTextExpandSameLine="true"
            app:maxCollapsedLines="4">
            <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_orange"
            android:ellipsize="end"
            android:id="@+id/moment_hyperlinks"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#383e46"
            android:ellipsize="end"
            android:id="@+id/moment_text"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <FrameLayout
            android:id="@+id/images_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/moments_pic_new_feed_with_live"/>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/focus_hint"
                android:background="@drawable/feed_moments_feed_live_tag_bg"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/live_tag"
                android:background="@drawable/feed_live_room_bg_newui"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:minWidth="64dp">
                <com.p051p1.mobile.putong.feed.newui.photoalbum.live.FeedLiveLightView
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="@+id/live_tag_view_group"
                    app:layout_constraintStart_toStartOf="@+id/live_tag_view_group"
                    app:lightWidth="50"
                    app:loopTime="1500"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/live_tag_view_group"
                    android:paddingRight="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    flatten="true">
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/live_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="1dp"
                        android:text="@string/LIVE_LINVING"/>
                    <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                        android:layout_gravity="center"
                        android:id="@+id/live_svg"
                        android:visibility="visible"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <p151v.VImage
                android:layout_gravity="bottom"
                android:id="@+id/image_red_packet_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="6dp"
                android:layout_marginBottom="8dp"
                android:src="0x7f081eb0"
                android:layout_marginStart="6dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
    <View
        android:id="@+id/divider"
        android:background="#d8d8d8"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterImageView>
