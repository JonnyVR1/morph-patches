<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntrancePaymentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/core_privilege_payment_bg"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    flatten="true"
    holder="banner.view.PrivilegeEntrancePaymentView">
    <RelativeLayout
        android:id="@+id/pay_way"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/banner_bottom"
        flatten="true">
        <TextView
            android:textSize="12dp"
            android:textColor="#80000000"
            android:gravity="center"
            android:id="@+id/pay_way_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支付宝"
            android:drawableLeft="0x7f080d95"
            android:drawablePadding="7dp"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="4dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/prom_text"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:layout_toRightOf="@+id/pay_way_txt"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08180a"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/origin_proto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        flatten="true">
        <p151v.VCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/check"
            android:background="@drawable/core_purchase_default_checkbox_bg"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:checked="false"
            android:button="@null"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="8dp"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#33000000"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/member_protocol"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="同意《会员自动续费协议》，到期后以X元/月续订，可随时取消"
            android:maxLines="2"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntrancePaymentView>
