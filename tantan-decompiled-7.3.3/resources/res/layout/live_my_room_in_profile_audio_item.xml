<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.profile.myroom.view.MyRoomInProfileAudioItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    flatten="true"
    folder="page.profile.myroom.view"
    holder="MyRoomInProfileAudioItemView">
    <p151v.VDraweeView
        android:id="@+id/layout_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundedCornerRadius="10dp"/>
    <View
        android:background="@drawable/live_shape_my_room_in_profile_audio_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VImage
        android:id="@+id/audio_top_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/live_vector_room_audio_title_bg"
        app:layout_constraintBottom_toTopOf="@+id/live_top_text"
        app:layout_constraintStart_toStartOf="@+id/live_top_text"/>
    <FrameLayout
        android:id="@+id/audio_online_frame"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="18dp"
        app:layout_constraintBottom_toTopOf="@+id/live_top_text"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/audio_online_svga"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/live_top_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="41dp"
        android:layout_marginRight="20dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/live_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="20dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_top_text"/>
</com.p051p1.mobile.putong.live.external.page.profile.myroom.view.MyRoomInProfileAudioItemView>
