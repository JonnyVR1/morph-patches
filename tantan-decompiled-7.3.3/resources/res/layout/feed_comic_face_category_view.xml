<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="kankan.view.FeedComicFaceCategoryView">
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/feed_comic_face_category_item_left"
        android:layout_width="12dp"
        android:layout_height="12dp"/>
    <ImageView
        android:id="@+id/feed_comic_face_category_icon"
        android:background="@drawable/feed_comic_record_btn_oval"
        android:layout_width="64dp"
        android:layout_height="64dp"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/feed_comic_face_category_item_right"
        android:layout_width="12dp"
        android:layout_height="12dp"/>
</LinearLayout>
