<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_friend_tacit_bottom_sheet_bg"
    android:paddingBottom="28dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="dlg.UXQuestionnaireBottomSheetDialog">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f0818c3"
        android:layout_marginEnd="16dp"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="140dp"
        android:layout_height="110dp"
        android:layout_marginStart="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="22sp"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"/>
    <include
        android:id="@+id/select_content"
        android:visibility="gone"
        layout="@layout/core_ux_questionnaire_select_content"/>
    <include
        android:id="@+id/next_select_content"
        android:visibility="gone"
        layout="@layout/core_ux_questionnaire_next_select_content"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ok_button"
        android:background="@drawable/core_certification_bottom_sheet_button_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:text="继续划卡"
        android:layout_marginHorizontal="20dp"/>
</p151v.VLinear>
