<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.greet.ItemGreetAgreeMatch xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="greet.ItemGreetAgreeMatch"
    innerClass="true">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_greet_agree_match_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:src="0x7f0808cd"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="#e6000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="配对邀请"
                    app:typeface="medium"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="#4c000000"
                    android:id="@+id/tip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/agree"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="同意"
            app:typeface="medium"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.greet.ItemGreetAgreeMatch>
