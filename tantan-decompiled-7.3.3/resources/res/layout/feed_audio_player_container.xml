<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/feed_audio_play_bg"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    flatten="true"
    folder="newui"
    holder="view.FeedAudioPlayerView">
    <p151v.VFrame
        android:id="@+id/play_status"
        android:background="@drawable/feed_audio_status_bg"
        android:layout_width="32dp"
        android:layout_height="38dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading_bar"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="16dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/play_status_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081c66"/>
    </p151v.VFrame>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_02"
        android:id="@+id/playing_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="11dp"
        app:layout_constraintLeft_toRightOf="@+id/play_status"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/play_status"
        app:typeface="medium"/>
    <p151v.VImage
        android:id="@+id/playing_track"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginRight="8dp"
        android:src="0x7f081e1a"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/play_status"
        app:layout_constraintLeft_toLeftOf="@+id/playing_duration"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
