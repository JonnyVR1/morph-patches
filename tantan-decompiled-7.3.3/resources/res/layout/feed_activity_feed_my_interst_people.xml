<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="photoalbum.myInterestPeople.FeedMyInterestPeopleAct">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/new_post_bottom_album_bar_height"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="16dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/empty"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/new_post_bottom_album_bar_height">
        <ImageView
            android:id="@+id/img_empty"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="209dp"
            android:src="0x7f081d24"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#4d323232"
            android:gravity="center"
            android:id="@+id/txt_tip"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="没有更多了，先去冒个泡让更多的人看到你吧"
            android:layout_below="@+id/img_empty"
            android:lineSpacingExtra="4dp"/>
    </RelativeLayout>
</FrameLayout>
