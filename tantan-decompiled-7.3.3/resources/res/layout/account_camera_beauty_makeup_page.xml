<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.account.p055ui.camera.view.AccountBeautyMakeupPageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/account_camera_makeup_menu_root"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="ui"
    holder="camera.view.AccountBeautyMakeupPageView">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/beauty_makeup_main_menu"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/beauty_makeup_sub_menu_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="false">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/beauty_makeup_sub_menu_back"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            flatten="false">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:src="0x7f08016d"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:id="@+id/beauty_makeup_sub_menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="返回"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/beauty_makeup_sub_menu"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </LinearLayout>
</com.p051p1.mobile.putong.account.p055ui.camera.view.AccountBeautyMakeupPageView>
