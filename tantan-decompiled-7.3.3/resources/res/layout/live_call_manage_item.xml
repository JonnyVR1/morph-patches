<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.CallManageItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    flatten="true"
    folder="recreation"
    holder="multiplayerchat.view.CallManageItemView">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="20dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#000"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:maxWidth="142dp"
        android:maxLines="1"
        android:layout_toRightOf="@+id/iv_icon"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#4d212121"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/item_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/iv_arrow"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"/>
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginRight="16dp"
        android:src="0x7f082347"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.CallManageItemView>
