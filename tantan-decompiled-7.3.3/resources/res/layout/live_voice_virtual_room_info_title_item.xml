<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.VirtualRoomInfoTitleItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="89dp"
    flatten="true"
    holder="virtual.roomInfo.view.VirtualRoomInfoTitleItem">
    <p151v.VText
        android:textSize="15dp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:text="房间名称"
        android:layout_marginStart="20dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:background="@drawable/live_bg_white_r10_a03"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp">
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="群名称"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="@color/live_fe7e1d"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="12dp"
            android:text="测试"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.VirtualRoomInfoTitleItem>
