<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.usercard.view.UserCardContributionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/live_bg_white_r16_a03"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    flatten="true"
    folder="common"
    holder="usercard.view.UserCardContributionView">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_gray_8c"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CONTRIBUTE"
        android:layout_weight="1"
        android:layout_marginStart="15dp"/>
    <FrameLayout
        android:id="@+id/first_contribution_layout"
        android:layout_width="30dp"
        android:layout_height="33dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/first_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="0x7f08272d"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="8sp"
            android:textColor="@color/live_8b2e07"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/first_contribution_number"
            android:background="@drawable/live_shape_user_card_contribution_number_first_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:text="0"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/second_contribution_layout"
        android:layout_width="30dp"
        android:layout_height="33dp"
        android:layout_marginLeft="25dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/second_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="0x7f08272e"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="8sp"
            android:textColor="@color/live_3f4b65"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/second_contribution_number"
            android:background="@drawable/live_shape_user_card_contribution_number_second_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:text="0"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/third_contribution_layout"
        android:layout_width="30dp"
        android:layout_height="33dp"
        android:layout_marginLeft="25dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/third_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="0x7f08272f"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="8sp"
            android:textColor="@color/live_7e2300"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/third_contribution_number"
            android:background="@drawable/live_shape_user_card_contribution_number_third_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:text="0"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </FrameLayout>
    <p151v.VImage
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="15dp"
        android:src="0x7f082307"
        android:layout_alignParentRight="true"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.common.usercard.view.UserCardContributionView>
