<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemProfileLikeEntrance xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemProfileLikeEntrance">
    <p151v.VFrame
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/core_profile_like_entrance_ic"/>
        <FrameLayout
            android:layout_gravity="top|right"
            android:id="@+id/avatar_icon_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="-4dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/user_icon"
                android:padding="1dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/white"/>
            <View
                android:id="@+id/background"
                android:background="@drawable/core_2dp_stroke_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </p151v.VFrame>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="收到的称赞"
                android:maxLines="1"
                android:layout_weight="1"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_color_4d000000"
                android:layout_gravity="right"
                android:id="@+id/time_big"
                android:paddingTop="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#999999"
                android:textColorLink="@color/core_msg_cell_link_color"
                android:ellipsize="end"
                android:id="@+id/message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                app:centerEmojis="true"
                app:enableEmojis="true"
                app:typeface="regular"/>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="0dp">
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/red_dot"
                    android:background="@drawable/core_conversation_num_red_dot"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="-4dp"
                    android:minWidth="24dp"
                    android:layout_marginStart="10dp"/>
            </FrameLayout>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemProfileLikeEntrance>
