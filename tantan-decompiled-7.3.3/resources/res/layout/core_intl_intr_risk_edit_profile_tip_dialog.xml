<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.view.IntlProfileIntrRiskTipDialog">
    <View
        android:id="@+id/shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/dialog_view"
        android:background="@drawable/core_dialog_bottom_to_top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VIcon
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f080335"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/tip_icon"
            android:background="0x7f080beb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/close"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/black"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:text="@string/EDIT_SELF_INTRODUTION_RISK_TITLE"
            app:layout_constraintStart_toStartOf="@+id/tip_icon"
            app:layout_constraintTop_toBottomOf="@+id/tip_icon"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_000000_40"
            android:id="@+id/tip_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:text="@string/EDIT_SELF_INTRODUTION_RISK_DESC"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VDraweeView
            android:id="@+id/tip_bg"
            android:layout_width="295dp"
            android:layout_height="182dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tip_content"
            app:placeholderImage="@color/gray_bfbfbf"/>
        <p151v.VText
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:background="@drawable/common_button_btn_gray_small"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="@string/EDIT_SELF_INTRODUTION_RISK_BTN_CANCEL"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sure_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tip_bg"/>
        <p151v.VText
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sure_button"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="@string/EDIT_SELF_INTRODUTION_RISK_BTN_SUBMIT"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cancel_button"
            app:layout_constraintTop_toBottomOf="@+id/tip_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
