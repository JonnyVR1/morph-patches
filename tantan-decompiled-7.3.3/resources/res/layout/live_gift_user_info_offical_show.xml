<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftUserInfoOfficialView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    flatten="true"
    folder="increment.gift.view"
    holder="GiftUserInfoOfficialView">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:background="@drawable/live_bg_fe7e1d_r16"
        android:padding="2dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="117dp"
        android:layout_height="wrap_content"
        android:maxEms="6"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/live_bg_white_r6_a05"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:text="查看资料"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftUserInfoOfficialView>
