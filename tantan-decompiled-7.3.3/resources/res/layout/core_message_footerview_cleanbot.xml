<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.MessageCommunityHintFooterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="#f9f9f9"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.MessageCommunityHintFooterView">
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#b2b2b2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="12dp"
        android:text="@string/HEALTH_CHAT_PROMPT"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#fe7e1d"
        android:id="@+id/prompt_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:text="@string/COMMUNITY_CONVENTION_BUTTON"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.messages.MessageCommunityHintFooterView>
