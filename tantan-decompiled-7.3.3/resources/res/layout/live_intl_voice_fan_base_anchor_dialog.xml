<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="580dp">
        <p151v.VDraweeView
            android:id="@+id/background"
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="right"
            android:id="@+id/faq"
            android:background="0x7f082387"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/top_part"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp">
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:roundAsCircle="true"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white"
                    android:ellipsize="none"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginLeft="72dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="50dp"
                    android:text="兔子喵Hoti的粉丝团"
                    android:singleLine="true"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginLeft="72dp"
                    android:layout_marginTop="31dp">
                    <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                        android:id="@+id/medal"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginRight="12dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/live_white_50_opacity"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/member_num_text"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="权益名称"
                        android:drawablePadding="2dp"/>
                </p151v.VLinear>
            </FrameLayout>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="0x7f082394"
                    android:layout_width="10dp"
                    android:layout_height="18dp"/>
                <com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.GradientTextView
                    android:textSize="14dp"
                    android:textColor="#ff58bc"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_FAN_CLUB_MEMBERS"
                    android:maxLines="1"
                    app:gradientEndColor="#ff6ee2"
                    app:gradientStartColor="#ffd6f7"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="0x7f082395"
                    android:layout_width="10dp"
                    android:layout_height="18dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp">
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/live_selector_intl_voice_fan_base_rank_title_color"
                    android:gravity="center"
                    android:id="@+id/day_rank"
                    android:background="@drawable/live_intl_voice_fan_base_rank_title_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_DAILY_BOARD"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/live_selector_intl_voice_fan_base_rank_title_color"
                    android:gravity="center"
                    android:id="@+id/week_rank"
                    android:background="@drawable/live_intl_voice_fan_base_rank_title_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginLeft="12dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_WEEKLY_BOARD"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/live_selector_intl_voice_fan_base_rank_title_color"
                    android:gravity="center"
                    android:id="@+id/all_rank"
                    android:background="@drawable/live_intl_voice_fan_base_rank_title_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginLeft="12dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_TOTAL_BOARD"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/live_white_50_opacity"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/manage"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/LIVE_VOICE_FUN_CLUB_MANAGE"
                    android:drawableLeft="0x7f08238c"
                    android:drawablePadding="4dp"/>
            </p151v.VLinear>
            <p151v.VRecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"/>
            <include
                android:id="@+id/empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                layout="@layout/live_empty_view"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/manager_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="46dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/manager_left"
                android:background="@drawable/live_bg_47474b_r16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="8dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_CANCEL"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/manager_right"
                android:background="@drawable/live_selector_intl_voice_fan_base_manager_button_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="20dp"
                android:text="@string/LIVE_VOICE_FUN_CLUB_CONFIRM_REMOVAL_HOST"
                android:layout_weight="1"/>
        </p151v.VLinear>
    </FrameLayout>
</p151v.VLinear>
