<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.ParallaxView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content_top"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileImagesItemHolder">
    <FrameLayout
        android:id="@+id/avatar_root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/images_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.profile.views.VPager_SquaredRefactor
                android:id="@+id/images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VPagerCircleIndicator
                android:id="@+id/cpi"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="-30dp"
                style="@style/common_page_circle_indicator_dark"/>
            <View
                android:id="@+id/shadow"
                android:background="0x7f0828c1"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="-8dp"/>
        </LinearLayout>
        <ViewStub
            android:id="@+id/supreme_partner_mysterious_mode_cover"
            android:layout="@layout/core_supreme_partner_mysterious_mode_cover_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <p151v.VDraweeView
            android:id="@+id/group_anonymity_mask"
            android:background="#aaaaaa"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="top|right"
            android:layout_gravity="top|right"
            android:id="@+id/pic_verification_container"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/verification_img"
                android:background="0x7f082957"
                android:padding="3dp"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </LinearLayout>
        <View
            android:id="@+id/image_indicator_bg"
            android:background="@drawable/profile_card_top_rect_bg"
            android:layout_width="match_parent"
            android:layout_height="59dp"/>
        <FrameLayout
            android:id="@+id/image_indicator_wrap"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
                android:layout_gravity="bottom"
                android:id="@+id/image_indicator"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="20dp"
                app:indicatorColor="#19000000"
                app:indicatorMargin="3dp"
                app:indicatorSelectedColor="@color/white"/>
        </FrameLayout>
        <p151v.VImage
            android:layout_gravity="top|left"
            android:id="@+id/profile_back"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="46dp"
            android:src="0x7f081222"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/iv_push_like_male"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="24dp"
            android:layout_marginTop="55dp"
            android:layout_marginRight="16dp"
            android:src="0x7f081592"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/follow_button_top_ab_refactor"
            android:background="@drawable/common_button_btn_orange_medium"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="46dp"
            android:layout_marginRight="56dp"
            android:text="@string/FOLLOW_STATE_WITHOUT_PLUS"/>
        <p151v.VImage
            android:layout_gravity="end|top"
            android:id="@+id/normal_card_edit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/core_profile_edit_card_top"
            app:layout_constraintRight_toRightOf="parent"/>
        <LinearLayout
            android:layout_gravity="end|top"
            android:id="@+id/menu_top_ab_refactor"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="46dp"
            android:layout_marginRight="8dp"
            app:layout_constraintRight_toRightOf="parent">
            <p151v.VImage
                android:layout_gravity="top"
                android:id="@+id/iv_white_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081223"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/live_tag"
            android:visibility="gone"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:layout_marginBottom="36dp">
            <include layout="@layout/core_live_state_view"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="bottom|left"
            android:id="@+id/bottom_newui_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            flatten="true">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/newui_live_layout"
                    android:background="@drawable/core_newui_profile_live_tab_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="6dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    flatten="true">
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.tantan.library.svga.SVGAnimationView
                            android:layout_gravity="center"
                            android:id="@+id/newui_live_tag"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/newui_live_text_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <p151v.VText
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/newui_live_title_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/LIVE_LINVING"/>
                    </LinearLayout>
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:id="@+id/newui_live_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080d5a"/>
                </LinearLayout>
                <FrameLayout
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <include
                        android:layout_gravity="bottom"
                        android:id="@+id/superlike_combo_anim_view"
                        android:visibility="gone"
                        android:layout_width="133dp"
                        android:layout_height="56dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginBottom="13dp"
                        layout="@layout/core_super_like_combo_anim_view"/>
                    <p151v.VImage
                        android:layout_gravity="bottom"
                        android:id="@+id/newui_superlike_tag"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginBottom="13dp"
                        android:src="@drawable/core_newui_profile_superlike_bg"
                        android:scaleType="center"/>
                    <p151v.VImage
                        android:layout_gravity="bottom"
                        android:id="@+id/iv_push_like_female"
                        android:visibility="gone"
                        android:layout_width="200dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginBottom="70dp"
                        android:src="0x7f081585"/>
                </FrameLayout>
                <p151v.VDraweeView
                    android:id="@+id/newui_greeting_tag"
                    android:visibility="gone"
                    android:layout_width="262dp"
                    android:layout_height="101dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>
        <p151v.VFrame
            android:layout_gravity="bottom"
            android:id="@+id/city_centre"
            android:background="@drawable/core_city_centre_profile_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.profile.views.ClipRectFrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/ff_city"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="24dp">
                <p151v.VDraweeView
                    android:id="@+id/content_texture_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="fitXY"
                    app:failureImage="@color/transparent"
                    app:failureImageScaleType="centerInside"
                    app:placeholderImage="@color/transparent"
                    app:placeholderImageScaleType="fitXY"/>
                <View
                    android:id="@+id/content_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="right"
                    android:id="@+id/little_star_svga"
                    android:layout_width="128dp"
                    android:layout_height="match_parent"/>
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="right"
                    android:id="@+id/big_star_svga"
                    android:layout_width="128dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#cce1d1ac"
                    android:ellipsize="end"
                    android:layout_gravity="start"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="城市封面"
                    android:maxLines="1"
                    android:drawablePadding="4dp"
                    android:drawableStart="0x7f08070f"
                    android:layout_marginStart="12dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffdb89"
                    android:ellipsize="end"
                    android:layout_gravity="start|bottom"
                    android:id="@+id/des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1"
                    android:layout_marginStart="12dp"/>
                <com.tantan.library.svga.SVGAnimationView
                    android:id="@+id/svga"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.p051p1.mobile.putong.core.p058ui.profile.views.ClipRectFrameLayout>
        </p151v.VFrame>
        <p151v.VDraweeView
            android:layout_gravity="bottom|left"
            android:id="@+id/decoration_sticker"
            android:visibility="gone"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginLeft="6dp"
            android:scaleType="centerInside"
            app:actualImageScaleType="centerInside"/>
        <p151v.VFrame
            android:id="@+id/bubble_container"
            android:background="@color/transparent"
            android:visibility="visible"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.profile.ParallaxView>
