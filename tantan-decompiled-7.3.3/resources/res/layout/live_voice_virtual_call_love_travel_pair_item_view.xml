<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.travel.VoiceVirtualLoveTeamInfoView xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="155dp"
    android:layout_height="155dp"
    flatten="true"
    holder="virtual.loveplanet.travel.VoiceVirtualLoveTeamInfoView">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/svga"
        android:layout_width="155dp"
        android:layout_height="155dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_white"
        android:ellipsize="marquee"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_tips"
        android:background="0x7f082856"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/live_FFFF16"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_star_value"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="28dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp">
        <include
            android:id="@+id/user_info_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-2dp"
            layout="@layout/live_voice_virtual_call_love_item_info_view"/>
        <include
            android:id="@+id/user_info_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-2dp"
            layout="@layout/live_voice_virtual_call_love_item_info_view"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.travel.VoiceVirtualLoveTeamInfoView>
