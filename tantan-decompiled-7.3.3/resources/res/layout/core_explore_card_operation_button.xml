<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="explore.view.ExploreCardOperationButton">
    <View
        android:id="@+id/normal_state_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/pressed_state_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <p151v.VIcon
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"/>
</p151v.VFrame>
