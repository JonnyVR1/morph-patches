<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.JumpNextView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="@color/live_black_30_opacity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="view"
    holder="JumpNextView">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="310dp"
        android:layout_height="370dp">
        <androidx.cardview.widget.CardView
            android:id="@+id/content_frame"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="38dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:failureImage="@drawable/live_shape_pull_up_bg"
                app:placeholderImage="@drawable/live_shape_pull_up_bg"/>
            <View
                android:layout_gravity="bottom"
                android:background="@color/live_black_30_opacity"
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/gradient_progress_view"
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
        </androidx.cardview.widget.CardView>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#212121"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_gray_99"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/enter_room_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="262dp"
            android:maxLines="2"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/jump"
            android:background="@drawable/live_bg_ff8817_r18"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/LIVE_ROOM_JUNP_NOW"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.view.JumpNextView>
