<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/notify_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/dot"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:scaleType="center"
        android:layout_alignRight="@+id/notify_image"
        android:layout_alignBottom="@+id/notify_image"
        android:layout_alignEnd="@+id/notify_image"/>
    <ImageView
        android:id="@+id/match_from"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:layout_alignRight="@+id/notify_image"
        android:layout_alignBottom="@+id/notify_image"
        android:layout_alignEnd="@+id/notify_image"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/notify_image"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#b3000000"
            android:ellipsize="end"
            android:id="@+id/name_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/scenario_timer"
            android:ellipsize="end"
            android:id="@+id/message_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
