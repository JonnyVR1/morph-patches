<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_share_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/core_share_tip_bg"
        android:layout_width="37dp"
        android:layout_height="5dp"
        android:layout_marginTop="14dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_40percent_000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="分享给好友"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_wechat_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="21dp">
            <p151v.VImage
                android:id="@+id/ll_wechat_share_iv"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f08077c"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_09"
                android:gravity="center"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="微信"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_wechat_friend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_toRightOf="@+id/ll_wechat_share"
            android:layout_marginStart="21dp">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/ll_wechat_friend_iv"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f080780"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_09"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="朋友圈"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_save_pic"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_toRightOf="@+id/ll_wechat_friend"
            android:layout_marginStart="21dp">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/ll_save_pic_iv"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f08077a"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_09"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VRecyclerView
        android:id="@+id/rl_report"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/ll_wechat_friend"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <View
        android:id="@+id/view_line"
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="24dp"
        android:layout_alignParentBottom="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="取消"
        android:layout_below="@+id/view_line"
        app:typeface="medium"/>
</p151v.VLinear>
