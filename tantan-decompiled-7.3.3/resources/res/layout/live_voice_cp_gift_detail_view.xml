<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="virtual.gift.VoiceCpGiftDetailViewModel">
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textColor="@color/white"
        android:id="@+id/gift_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="CP礼物"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center_horizontal"
        android:id="@+id/gift_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="38dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_type"/>
    <p151v.VButton
        android:gravity="center"
        android:id="@+id/send_gift_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_desc"/>
    <View
        android:layout_width="1dp"
        android:layout_height="34dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/send_gift_button"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/send_gift_button"
        app:layout_constraintEnd_toEndOf="@+id/send_gift_button"
        app:layout_constraintStart_toStartOf="@+id/send_gift_button"
        app:layout_constraintTop_toTopOf="@+id/send_gift_button">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/gift_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/gift_cost_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_GAME_PK_TANTAN_B_COUNT"
            android:maxLines="1"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
