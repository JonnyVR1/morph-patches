<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="tarot.TarotReadingDialog">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/tarot_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#ffe19a"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:text="@string/INTL_TAROT_READING_TITLE"
            android:shadowColor="#db000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:lineSpacingExtra="12sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VButton
            android:id="@+id/close"
            android:background="0x7f080c72"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="24dp"
            android:text="@string/INTL_TAROT_READING_TEXT"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#ffe19a"
            android:gravity="center_horizontal"
            android:id="@+id/reading_instruction"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="37dp"
            android:text="@string/INTL_TAROT_READING_INSTRUCTION1"
            android:lineSpacingExtra="8sp"
            app:layout_constraintTop_toBottomOf="@+id/reading"/>
        <p151v.VImage
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080c89"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reading_instruction"/>
        <p151v.VImage
            android:id="@+id/hide_card"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080c69"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image"/>
        <com.p051p1.mobile.putong.core.p058ui.tarot.TarotListView
            android:id="@+id/tarot_layout"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            app:layout_constraintTop_toBottomOf="@+id/image"/>
        <com.p051p1.mobile.putong.core.p058ui.tarot.LineView
            android:id="@+id/lineView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tarot_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/slide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/INTL_TAROT_READING_INSTRUCTION2"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@+id/tarot_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
