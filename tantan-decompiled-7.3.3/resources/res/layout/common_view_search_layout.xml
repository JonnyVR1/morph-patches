<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_layout"
    android:layout_width="match_parent"
    android:layout_height="42dp">
    <p151v.VEditText
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/common_000000_80"
        android:textColorHint="@color/common_000000_20"
        android:id="@+id/edit_text"
        android:background="@drawable/common_view_card_small_01_bg"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:layout_centerVertical="true"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:drawableStart="0x7f0803cf"
        android:paddingStart="8dp"
        android:paddingEnd="34dp"
        android:layout_toStartOf="@+id/cancel"/>
    <FrameLayout
        android:id="@+id/img_cancel_holder"
        android:visibility="invisible"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:layout_centerVertical="true"
        android:layout_alignEnd="@+id/edit_text">
        <p151v.VIcon
            android:layout_gravity="center"
            android:id="@+id/ic_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:iconStyle="xxxSmall"
            app:srcCompat="0x7f0803cb"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/common_grey_03"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ACTION_CANCEL"
        android:layout_centerVertical="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_alignParentEnd="true"/>
</merge>
