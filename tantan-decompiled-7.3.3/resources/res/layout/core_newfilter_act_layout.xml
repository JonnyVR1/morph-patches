<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/common_grey_07"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="settings.filter.newui.NewFilterActViewModel">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <p151v.VImage
            android:layout_gravity="start|center_vertical"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f0811a7"
            android:scaleType="centerCrop"
            android:layout_marginStart="10dp"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/common_exp_black_01"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CORE_LIKED_USER_ACTION_BAR_FILTER"
            android:layout_marginStart="46dp"
            app:typeface="medium"/>
        <View
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/line"
            android:layout_width="1dp"
            android:layout_height="1dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/save"
            android:background="@drawable/core_bg_theme_color_r10"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/CORE_PAYTIPS_MAKE_SURE"
            android:layout_marginEnd="10dp"
            android:paddingHorizontal="12dp"
            app:typeface="medium"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VScroll
            android:id="@+id/scroll"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            flatten="true">
            <p151v.VLinear
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/base_setting"
                    layout="@layout/core_newui_filter_basesetting_new_ui_ab"/>
                <p151v.VLinear
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="#08000000"
                        android:layout_width="60dp"
                        android:layout_height="2dp"
                        android:layout_marginEnd="20dp"/>
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="0x7f0810c2"/>
                    <p151v.VText
                        android:layout_gravity="center_vertical"
                        android:text="SVIP"
                        style="@style/core_newfilter_title_new_ui_ab"/>
                    <p151v.VText
                        android:layout_gravity="center_vertical"
                        android:text="高级筛选"
                        android:layout_marginStart="3dp"
                        style="@style/core_newfilter_title_new_ui_ab"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="#08000000"
                        android:layout_width="60dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="20dp"/>
                </p151v.VLinear>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/common_exp_black_03"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="12dp"
                    android:text="开通SVIP，可解锁更多筛选功能"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:paddingBottom="20dp"
                    style="@style/core_newfilter_view_group">
                    <p151v.VText
                        android:id="@+id/advance_title"
                        android:text="@string/CORE_SVIP_PURCHASE_PRIVILEGE_ADVANCED_FILTER_TITLE"
                        style="@style/core_newfilter_subtitle_new_ui_ab"/>
                    <include
                        android:id="@+id/advance_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/core_newfilter_advancepart_layout_new_ui_ab"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:paddingBottom="16dp"
                    android:clipChildren="false"
                    style="@style/core_newfilter_view_group">
                    <p151v.VText
                        android:id="@+id/zodiac_title"
                        android:text="合适的星座"
                        style="@style/core_newfilter_subtitle_new_ui_ab"/>
                    <FrameLayout
                        android:id="@+id/zodiacs_tags_layout"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.p058ui.settings.filter.tags.TagContainerLayout
                            android:id="@+id/zodiacs_tags"
                            android:clipChildren="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="20dp"
                            app:column="3"
                            app:horSpace="8dp"
                            app:iscenter="true"
                            app:verSpace="8dp"/>
                        <p151v.VText
                            android:textSize="10sp"
                            android:textColor="#fff"
                            android:gravity="center"
                            android:id="@+id/filter_best_zodiacs"
                            android:background="@drawable/core_bg_6_black"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="19dp"/>
                    </FrameLayout>
                </p151v.VLinear>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:paddingBottom="20dp"
                    android:layout_marginBottom="31dp"
                    style="@style/core_newfilter_view_group">
                    <p151v.VText
                        android:id="@+id/privacy_title"
                        android:text="@string/CORE_SVIP_PURCHASE_PRIVILEGE_PRIVACY_PROTECTION_TITLE"
                        style="@style/core_newfilter_subtitle_new_ui_ab"/>
                    <include
                        android:id="@+id/privacy_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        layout="@layout/core_newfilter_privacy_layout_new_ui_ab"/>
                </p151v.VLinear>
            </p151v.VLinear>
        </p151v.VScroll>
    </p151v.VFrame>
</p151v.VLinear>
