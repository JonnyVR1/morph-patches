<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice.intl"
    holder="giftwall.container.VoiceLiveGiftWallViewModel">
    <View
        android:id="@+id/top_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="580dp">
        <RelativeLayout
            android:background="@drawable/live_list_voice_gift_wall_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="560dp"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/iv_back"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:src="0x7f0827a7"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:id="@+id/iv_help"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:src="0x7f0827a6"
                android:layout_marginEnd="6dp"
                android:layout_alignParentEnd="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="72dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/live_white_70_opacity"
                    android:id="@+id/info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_VOICE_GIFTWALL_LIGHTE_GIFT_NUMBER"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/live_67B6FF"
                    android:id="@+id/light_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/live_white_70_opacity"
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/info_container"
                android:layout_centerHorizontal="true"
                app:tabBackground="@android:color/transparent"
                app:tabIndicator="@drawable/live_list_voice_gift_wall_tab_indicator_bg"
                app:tabIndicatorColor="@color/live_67B6FF"
                app:tabIndicatorGravity="bottom"
                app:tabIndicatorHeight="2dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabSelectedTextColor="@color/live_67B6FF"
                app:tabTextSize="@color/live_white_30_opacity"/>
            <View
                android:id="@+id/split"
                android:background="@color/live_white_20_opacity"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/tab"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/split"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/live_bg_191919_r40"
            android:padding="5dp"
            android:layout_width="80dp"
            android:layout_height="80dp">
            <p151v.VDraweeView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:failureImage="@drawable/live_vector_default_avatar_bg"
                app:failureImageScaleType="centerCrop"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/gift_wall_bubble"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="43dp"
            android:layout_marginBottom="16dp"
            flatten="true">
            <FrameLayout
                android:background="0x7f0827a4"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="36dp"
                flatten="true">
                <p151v.VText
                    android:textColor="@color/live_white_80_opacity"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="90dp"
                    android:text="@string/LIVE_VOICE_GIFTWALL_MY_GIFT"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp"/>
            </FrameLayout>
            <p151v.VDraweeView
                android:id="@+id/my_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:failureImage="@drawable/live_vector_default_avatar_bg"
                app:failureImageScaleType="centerCrop"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/live_D2E9FF"
                app:roundingBorderWidth="2dp"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="-6dp"
                android:src="0x7f0827a5"
                android:layout_alignBottom="@+id/my_avatar"
                android:layout_marginEnd="-6dp"
                android:layout_alignEnd="@+id/my_avatar"/>
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>
