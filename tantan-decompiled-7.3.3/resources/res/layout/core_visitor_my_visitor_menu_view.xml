<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.myvisitors.MyVisitorsMenuView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    holder="visitor.myvisitors.MyVisitorsMenuView">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_02"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:text="默认排序"
        app:typeface="medium"/>
    <p151v.VImage
        android:layout_gravity="bottom|right"
        android:id="@+id/filter_ic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:src="0x7f0819ce"
        android:layout_marginEnd="4dp"/>
    <View
        android:layout_gravity="bottom|right"
        android:id="@+id/anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginRight="96dp"
        android:layout_marginBottom="10dp"/>
</com.p051p1.mobile.putong.core.p058ui.visitor.myvisitors.MyVisitorsMenuView>
