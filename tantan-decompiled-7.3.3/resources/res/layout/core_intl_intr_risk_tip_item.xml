<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.IntrRiskTipItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.IntrRiskTipItem">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/tip_content"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:autoLink="web"
            android:layout_gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.IntrRiskTipItem>
