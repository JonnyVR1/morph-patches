<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="purchase.coin.CoinPaymentComponent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/payment_mode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp"
            android:src="0x7f08194a"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/common_grey_01"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:lines="1"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_promotion_text"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/payment_mode_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="24dp"
            android:src="0x7f081955"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:id="@+id/buy_coin"
            android:background="@drawable/core_bg_10_07000000"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:text="充值探币"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:paddingVertical="11dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/charge"
            android:background="@drawable/core_bg_10_fe7e1d"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/charge_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/LIVE_PAY_CONFIRM"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#989898"
        android:textColorLink="#ff5435"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/agreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        app:typeface="medium"/>
</LinearLayout>
