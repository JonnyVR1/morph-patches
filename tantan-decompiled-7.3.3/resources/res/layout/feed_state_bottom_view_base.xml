<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedStateSquareBottomViewItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/msg_root"
