<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.feed.likers.MeetLikersItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="newmeet.feed.likers.MeetLikersItemView">
    <p151v.VImage
        android:id="@+id/img_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f080e6c"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/header_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.newui.newmeet.feed.likers.MeetItemLikerHeadView
            android:id="@+id/title_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.p051p1.mobile.putong.core.newui.newmeet.feed.likers.MeetPromotionItemView
            android:id="@+id/meet_promotion_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <p151v.VPullUpRecyclerView
        android:id="@+id/list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_root"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#f2b35f"
        android:gravity="center"
        android:id="@+id/show_total"
        android:background="@drawable/core_meet_bottom_white_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/list"
        android:letterSpacing="0"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.newui.newmeet.feed.likers.MeetLikersItemView>
