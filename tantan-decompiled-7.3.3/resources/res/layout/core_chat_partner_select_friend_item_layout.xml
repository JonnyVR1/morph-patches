<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:layout_gravity="end"
        android:id="@+id/check"
        android:background="@drawable/core_chat_partner_select_friend_selected_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="50dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="13sp"
        android:textColor="#010101"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="81dp"
        android:maxWidth="70dp"
        android:lines="1"/>
</p151v.VFrame>
