<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMomentGuidePhaseTwo xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        layout="@layout/messages_item_date_header"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content"
        android:background="@drawable/core_moment_guide_item_bg"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="72dp"
            android:layout_height="72dp">
            <p151v.VDraweeView
                android:id="@+id/moment_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f08102a"
                fresco:actualImageScaleType="centerCrop"
                fresco:failureImage="@color/white"
                fresco:failureImageScaleType="centerInside"
                fresco:placeholderImage="@drawable/core_message_comment_guide_default_bg"
                fresco:placeholderImageScaleType="centerInside"
                fresco:roundBottomLeft="true"
                fresco:roundBottomRight="true"
                fresco:roundTopLeft="true"
                fresco:roundTopRight="true"
                fresco:roundedCornerRadius="10dp"/>
            <ImageView
                android:id="@+id/play_btn"
                android:visibility="gone"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="0x7f081028"
                android:scaleType="center"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/moment_more_image_icon"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="6dp"
                android:src="0x7f081025"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#66000000"
                android:id="@+id/title_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_alignParentTop="true"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#e6000000"
                android:ellipsize="end"
                android:id="@+id/moment_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:layout_below="@+id/title_info"/>
            <ImageView
                android:id="@+id/like_btn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="0x7f081022"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMomentGuidePhaseTwo>
