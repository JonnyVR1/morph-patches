<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.chat.view.LiveVoiceVirtualNoticeMsgItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_black_r10_a20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="2dp"
    app:bind_extends="RelativeLayout"
    app:bind_implements="null"
    app:binding="true">
    <com.p051p1.mobile.putong.live.livingroom.voice.chat.view.LiveAvatarClipItemView
        android:id="@+id/avatar_root"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        app:flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"/>
    </com.p051p1.mobile.putong.live.livingroom.voice.chat.view.LiveAvatarClipItemView>
    <p151v.VRelative
        android:background="@drawable/live_bg_white_r8_a20"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignRight="@+id/avatar_root"
        android:layout_alignBottom="@+id/avatar_root">
        <p151v.VImage
            android:background="0x7f082849"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerInParent="true"/>
    </p151v.VRelative>
    <p151v.VLinear
        android:gravity="start"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/avatar_root"
        android:layout_centerVertical="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white_80_opacity"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="PingFangSc-Medium"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="1dp"
            android:fontFamily="PingFangSC-Regular"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.voice.chat.view.LiveVoiceVirtualNoticeMsgItemView>
