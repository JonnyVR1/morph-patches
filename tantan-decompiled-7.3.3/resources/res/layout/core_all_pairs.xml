<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="messages.AllPairsViewModel"
    innerClass="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <p151v.VImage
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081229"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#26000000"
            android:gravity="top|center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tip"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/NO_NEW_MATCH_GUIDE_FOR_FEMALE_GROUP_1_2"
            android:layout_weight="1"
            android:lineSpacingExtra="6dp"/>
    </LinearLayout>
    <p151v.VPullUpRecyclerView
        android:id="@+id/list"
        android:paddingLeft="4dp"
        android:paddingTop="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="8dp"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VProgressBar
        android:id="@+id/progress"
        style="@style/core_loading_block"/>
</p151v.VFrame>
