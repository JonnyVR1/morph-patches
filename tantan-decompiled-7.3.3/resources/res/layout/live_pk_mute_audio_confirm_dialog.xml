<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/dialog"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_black_80_opacity"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VRadioButton
            android:gravity="center"
            android:id="@+id/check"
            android:background="@drawable/live_selector_recharge_item"
            android:clickable="false"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginTop="26dp"
            android:button="@null"
            app:layout_constraintEnd_toStartOf="@+id/check_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/live_black_20_opacity"
            android:gravity="center"
            android:id="@+id/check_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_CONFIRM_DIALOG_CHECKBOX_DESC"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/check"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/check"
            app:layout_constraintTop_toTopOf="@+id/check"/>
        <View
            android:id="@+id/check_box_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/check"
            app:layout_constraintEnd_toEndOf="@+id/check_text"
            app:layout_constraintStart_toStartOf="@+id/check"
            app:layout_constraintTop_toTopOf="@+id/check"/>
        <View
            android:id="@+id/divider"
            android:background="@color/live_gray_97_20_opacity"
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:layout_marginTop="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/check"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_black_40_opacity"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/cancel"
            app:layout_constraintEnd_toStartOf="@+id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/check"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_fe7e1d"
            android:gravity="center"
            android:id="@+id/confirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/ACTION_CONFIRM"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/divider"
            app:layout_constraintTop_toBottomOf="@+id/check"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
