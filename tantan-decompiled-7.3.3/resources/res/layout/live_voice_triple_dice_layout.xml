<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.emoji.VoiceTripleDiceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="voice.intl.emoji"
    holder="VoiceTripleDiceView">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerHorizontal="true"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_2"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-6dp"
        android:layout_below="@+id/svga_1"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_3"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="-4dp"
        android:layout_marginTop="-6dp"
        android:layout_toRightOf="@+id/svga_2"
        android:layout_below="@+id/svga_1"/>
    <p151v.VDraweeView
        android:id="@+id/dice_result1"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerHorizontal="true"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VDraweeView
        android:id="@+id/dice_result2"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-6dp"
        android:layout_below="@+id/dice_result1"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VDraweeView
        android:id="@+id/dice_result3"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="-4dp"
        android:layout_marginTop="-6dp"
        android:layout_toRightOf="@+id/dice_result2"
        android:layout_below="@+id/dice_result1"
        app:actualImageScaleType="centerCrop"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.emoji.VoiceTripleDiceView>
