<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame"
    android:background="#4d000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="profile.newmine.newprofile.SidesSlipViewModel">
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/right_side_slip"
        android:background="@drawable/core_new_my_tab_side_slip_bg"
        android:paddingBottom="14dp"
        android:fitsSystemWindows="true"
        android:clipToPadding="true"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:id="@+id/pinned_header"
            android:visibility="gone"
            layout="@layout/core_new_my_tab_sides_slip_head_item"/>
        <p151v.VLinear
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VRecyclerView
                android:id="@+id/list"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </p151v.VLinear>
    </LinearLayout>
    <View
        android:id="@+id/close_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="280dp"/>
</p151v.VFrame>
