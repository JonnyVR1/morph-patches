<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomTagLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomTagLayout">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/interest_info_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/interest_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"
                android:shadowColor="@color/common_light_02"
                android:shadowDx="1"
                android:shadowDy="1"
                android:lineSpacingExtra="0sp"
                android:lineHeight="20dp"
                app:typeface="regular"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/interest_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lines="1"
                android:singleLine="true"
                android:shadowColor="@color/common_light_02"
                android:shadowDx="1"
                android:shadowDy="1"
                android:lineSpacingExtra="0sp"
                android:lineHeight="20dp"
                app:typeface="regular"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.view.CardLabelShowView
            android:id="@+id/labelshowview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomTagLayout>
