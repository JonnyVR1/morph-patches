<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.active.IntlPartnerActiveCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="active.IntlPartnerActiveCard">
    <p151v.VDraweeView
        android:id="@+id/card_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"/>
    <p151v.VDraweeView
        android:id="@+id/us_card_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <p151v.VDraweeView
        android:id="@+id/card_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="206dp"
        android:layout_alignParentBottom="true"
        app:actualImageScaleType="centerCrop"
        style="@style/core_fresco_base"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <p151v.VLinear
            android:id="@+id/user_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="32sp"
                android:textColor="#ffffff"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="8dp"/>
        </p151v.VLinear>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/desc_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="2"
            android:layout_marginEnd="90dp"/>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_bottom"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:rRadius="14dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_bottom_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/buttons_us"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true">
        <View
            android:id="@+id/like_us"
            android:background="0x7f080b69"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/dislike_us"
            android:background="0x7f080b68"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.active.IntlPartnerActiveCard>
