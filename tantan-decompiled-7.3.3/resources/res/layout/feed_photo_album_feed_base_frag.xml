<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="photoalbum.basefrag.PhotoAlbumFeedBaseFragViewModel"
    useId="true">
    <p151v.VPullDownRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false"
        flatten="true">
        <com.p051p1.mobile.putong.feed.newui.photoalbum.momentdetail.feedlist.FeedMaxHeightRecyclerView
            android:id="@+id/moments"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            useId="true"/>
    </p151v.VPullDownRefreshLayout>
</p151v.VFrame>
