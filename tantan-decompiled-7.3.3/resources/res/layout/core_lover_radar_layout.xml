<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.loveradar.LoveRadarSettingViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/radar_switch_view"
                    layout="@layout/core_lover_radar_switch_layout"/>
                <include
                    android:id="@+id/radar_filter_view"
                    layout="@layout/core_lover_radar_filter_layout"/>
                <View
                    android:background="@color/core_color_3percent_000000"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="16dp"/>
                <include
                    android:id="@+id/radar_greeting_view"
                    layout="@layout/core_lover_radar_greeting_layout"/>
            </p151v.VLinear>
        </androidx.core.widget.NestedScrollView>
        <RelativeLayout
            android:id="@+id/error"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VImage
                android:id="@+id/empty_card_net_error_image"
                android:layout_width="210dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:translationY="-55dp"
                app:srcCompat="@drawable/core_ic_network_not_available"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/empty_card_net_error_image"
                android:translationY="-55dp">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_03"
                    android:gravity="center_horizontal"
                    android:id="@+id/tip"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="28dp"
                    android:text="@string/SUGGEST_USERS_NO_INTERNET_TIPS"
                    app:typeface="medium"/>
                <p151v.VButton
                    android:textSize="16sp"
                    android:id="@+id/reload"
                    android:layout_width="247dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="88dp"
                    android:text="@string/SUGGEST_USERS_NO_INTERNET_RELOAD"
                    style="@style/common_button_large_01"/>
            </p151v.VLinear>
        </RelativeLayout>
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_loading"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            app:cpb_color="@color/tantan_orange"
            app:cpb_stroke_width="6dp"/>
    </p151v.VFrame>
</p151v.VLinear>
