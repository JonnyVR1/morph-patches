<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_bg_white_r20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="32dp"
    android:layout_marginRight="32dp"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.module.LiveMenuDialogHolder"
    app:bind_implements="null"
    app:binding="true">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_gray_32"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/LIVE_MULTI_CALL_NEW_ENTRY_DLG_TITLE"
        android:fontFamily="PingFangSC-Semibold"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_30_opacity"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxWidth="262dp"
        android:text="@string/LIVE_MULTI_CALL_NEW_ENTRY_DLG_CONTENT"
        android:fontFamily="PingFangSC-Medium"/>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:background="0x7f0823f5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/sure"
        android:background="@drawable/live_bg_fe7e1d_r16"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/LIVE_MULTI_CALL_NEW_ENTRY"
        android:fontFamily="PingFangSC-Semibold"/>
</LinearLayout>
