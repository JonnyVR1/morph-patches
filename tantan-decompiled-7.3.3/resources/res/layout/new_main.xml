<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/base_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="main.NewMainViewModel">
    <FrameLayout
        android:id="@+id/root"
        android:background="@color/white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAutofill="noExcludeDescendants"
        flatten="true"
        folder="newui">
        <p151v.AutoVDraweeView
            android:id="@+id/background_texture"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scaleType="fitXY"/>
        <p151v.VFrame
            android:orientation="vertical"
            android:id="@+id/frag_container_root"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <FrameLayout
                android:id="@+id/frag_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="56dp"/>
            <p151v.VLinear
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.bottombar.VBottomBar
                    android:id="@+id/bottombar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"/>
                <com.p051p1.mobile.putong.core.admob.NavigationBarAdView
                    android:id="@+id/bottom_ad_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
        </p151v.VFrame>
        <p151v.VImage
            android:layout_gravity="bottom"
            android:id="@+id/see_like"
            android:visibility="gone"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:src="0x7f081f99"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/see_tips"
            android:background="0x7f0812fb"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:minWidth="60dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VDraweeView
                    android:id="@+id/icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:placeholderImage="@drawable/placeholder_see_bubble_avatar"
                    style="@style/core_fresco_profile_white_tip_border"/>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/online"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="0x7f0829cb"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxWidth="198dp"
                android:text="又有人喜欢你了"/>
        </p151v.VLinear>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/view_tab_blur"
            android:background="@drawable/core_main_tab_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="66dp"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:id="@+id/drawer_left"
        android:background="@drawable/core_user_home_drawer_bg"
        android:paddingTop="60dp"
        android:clickable="true"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/love_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/core_user_home_mode_love_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f0818af"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center"
                android:id="@+id/core_user_home_mode_love_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:minHeight="22dp"
                android:text="想恋爱"
                app:layout_constraintLeft_toRightOf="@+id/core_user_home_mode_love_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_40percent_000000"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="18dp"
                android:text="邂逅更多有趣的灵魂"
                app:layout_constraintLeft_toLeftOf="@+id/core_user_home_mode_love_title"
                app:layout_constraintTop_toBottomOf="@+id/core_user_home_mode_love_title"/>
            <p151v.VImage
                android:id="@+id/core_user_home_mode_love_state"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f0818b8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/marry_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:minHeight="42dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/core_user_home_mode_marry_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f0818b1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/core_color_80percent_000000"
                android:id="@+id/core_user_home_mode_marry_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:minHeight="22dp"
                android:text="想结婚"
                app:layout_constraintLeft_toRightOf="@+id/core_user_home_mode_marry_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_40percent_000000"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="18dp"
                android:text="以结婚为目的"
                app:layout_constraintLeft_toLeftOf="@+id/core_user_home_mode_marry_title"
                app:layout_constraintTop_toBottomOf="@+id/core_user_home_mode_marry_title"/>
            <p151v.VImage
                android:id="@+id/core_user_home_mode_marry_state"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f0818b8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
