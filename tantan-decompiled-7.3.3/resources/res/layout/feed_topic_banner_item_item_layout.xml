<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.view.FeedTopicBannerItemItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    folder="newui"
    holder="view.FeedTopicBannerItemItemView">
    <p151v.VFrame
        android:id="@+id/topic_head_fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/topic_head_image"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"
            style="@style/feed_fresco_base"/>
        <p151v.VDraweeView
            android:id="@+id/topic_head_shadow"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            app:actualImageResource="@color/common_grey_03"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@color/common_grey_03"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"
            style="@style/feed_fresco_base"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/topic_image_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081c53"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/topic_head_fl"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/topic_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/common_grey_03"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/topic_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.5dp"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.view.FeedTopicBannerItemItemView>
