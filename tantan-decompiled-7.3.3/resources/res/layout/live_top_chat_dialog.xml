<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="increment.topchat.TopChatBoardDialog">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/root"
        android:background="@drawable/live_bg_191919_tr24"
        android:layout_width="match_parent"
        android:layout_height="394dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        flatten="true">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="@string/LIVE_TOP_CHAT_TITLE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/back"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="0x7f0826a6"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"/>
        <View
            android:id="@+id/line"
            android:background="@color/live_gray_f9_02_opacity"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_50_opacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/LIVE_TOP_CHAT_SELECT_TIME"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <View
            android:textSize="12sp"
            android:id="@+id/item_one"
            android:background="@drawable/live_selector_top_chat_dialog_item_bg"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toStartOf="@+id/item_two"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <View
            android:id="@+id/item_two"
            android:background="@drawable/live_selector_top_chat_dialog_item_bg"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="45dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/item_one"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <p151v.VDraweeView
            android:id="@+id/item_one_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/item_one"
            app:layout_constraintStart_toStartOf="@+id/item_one"
            app:layout_constraintTop_toTopOf="@+id/item_one"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:id="@+id/item_one_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/item_one_icon"
            app:layout_constraintTop_toTopOf="@+id/item_one_icon"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/item_one_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/item_one_icon"
            app:layout_constraintTop_toBottomOf="@+id/item_one_title"/>
        <p151v.VDraweeView
            android:id="@+id/item_two_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/item_two"
            app:layout_constraintStart_toStartOf="@+id/item_two"
            app:layout_constraintTop_toTopOf="@+id/item_two"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:id="@+id/item_two_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/item_two_icon"
            app:layout_constraintTop_toTopOf="@+id/item_two_icon"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/item_two_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/item_two_icon"
            app:layout_constraintTop_toBottomOf="@+id/item_two_title"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/LIVE_TOP_CHAT_TEXT"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_one"/>
        <p151v.VEditText
            android:textSize="13sp"
            android:textColor="@color/live_white"
            android:textColorHint="@color/live_white_50_opacity"
            android:gravity="center"
            android:id="@+id/editText"
            android:background="@drawable/live_selector_top_chat_dialog_item_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="@string/LIVE_TOP_CHAT_SEND_HINT_TEXT"
            android:maxLines="1"
            android:inputType="text"
            android:textCursorDrawable="@drawable/live_shape_voice_top_notice_input_cursor_style"
            app:layout_constraintTop_toBottomOf="@+id/edit_title"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/live_white_20_opacity"
            android:id="@+id/limit_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/editText"
            app:layout_constraintEnd_toEndOf="@+id/editText"
            app:layout_constraintTop_toTopOf="@+id/editText"/>
        <p151v.VText
            android:enabled="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_storm_danmaku_send_selector"
            android:gravity="center"
            android:id="@+id/send"
            android:background="@drawable/live_selector_top_chat_bt_bg"
            android:paddingTop="1dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="32dp"
            android:text="@string/LIVE_TOP_CHAT_SEND_BUTTON_TEXT"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear>
