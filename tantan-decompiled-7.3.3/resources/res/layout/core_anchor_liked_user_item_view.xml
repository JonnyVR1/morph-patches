<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.likedusers.anchor.AnchorLikedUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="likedusers.anchor.AnchorLikedUserItemView">
    <RelativeLayout
        android:id="@+id/header_content"
        android:clipChildren="false"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="9dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/header_pic"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_centerInParent="true"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/tf_circle_bounded_light"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.core.p058ui.likedusers.anchor.LiveHaloAvatar
            android:id="@+id/header_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:avatarSize="47dp"
            app:haloSize="61dp"/>
        <TextView
            android:textSize="9dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/header_live_tag"
            android:background="@drawable/core_liked_user_live_tag_gradient_bg"
            android:paddingLeft="4dp"
            android:paddingTop="1dp"
            android:paddingRight="4dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_LINVING"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/common_000000_40"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="3dp"
        android:maxWidth="61dp"
        android:maxLines="1"/>
</com.p051p1.mobile.putong.core.p058ui.likedusers.anchor.AnchorLikedUserItemView>
