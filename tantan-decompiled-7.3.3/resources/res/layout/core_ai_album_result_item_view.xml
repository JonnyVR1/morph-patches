<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.aialbum.view.AiAlbumResultItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="172dp"
    android:layout_height="216dp"
    flatten="true"
    folder="ui"
    holder="aialbum.view.AiAlbumResultItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:background="@drawable/core_ai_album_template_item_selector"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="8dp"/>
    <p151v.VImage
        android:id="@+id/download_btn"
        android:background="0x7f080a24"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginBottom="9dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="9dp"
        android:layout_alignParentEnd="true"/>
</com.p051p1.mobile.putong.core.p058ui.aialbum.view.AiAlbumResultItemView>
