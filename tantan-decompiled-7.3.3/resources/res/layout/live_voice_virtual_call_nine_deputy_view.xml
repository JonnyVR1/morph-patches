<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.call.view.VoiceVirtualNineDeputyWidgetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl_deputy"
    android:background="@drawable/live_bg_black_r10_a20"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="virtual.call.view.VoiceVirtualNineDeputyWidgetView">
    <include
        android:id="@+id/vc_deputy_1"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_voice_virtual_call_widget_item_view"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_clear"
        android:background="@drawable/live_bg_white_r8_a05"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/clear_icon"
            android:paddingLeft="2dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f08284c"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/live_white_80_opacity"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_clear"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:text="清除人气值"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/one"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vc_deputy_1"
        flatten="true">
        <include
            android:id="@+id/vc_deputy_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/two"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/one"
        flatten="true">
        <include
            android:id="@+id/vc_deputy_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
        <include
            android:id="@+id/vc_deputy_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_weight="1"
            layout="@layout/live_voice_virtual_call_widget_item_view"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.virtual.call.view.VoiceVirtualNineDeputyWidgetView>
