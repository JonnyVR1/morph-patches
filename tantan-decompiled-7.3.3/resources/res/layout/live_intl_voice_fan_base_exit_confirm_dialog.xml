<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/live_black_30_opacity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/dialog_view"
        android:background="@drawable/live_bg_19191e_r24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="24dp"
                android:maxLines="1"
                android:singleLine="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/live_white_50_opacity"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="24dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/bottom_button"
                android:background="@drawable/live_bg_ff58bc_r16"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/live_white_30_opacity"
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="32dp"/>
        </p151v.VLinear>
    </FrameLayout>
</p151v.VLinear>
