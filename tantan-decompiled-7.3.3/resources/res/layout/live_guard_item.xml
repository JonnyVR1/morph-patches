<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LiveGuardItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    flatten="true"
    folder="increment"
    holder="knight.view.LiveGuardItem">
    <p151v.VDraweeView
        android:id="@+id/user_icon"
        android:layout_width="41dp"
        android:layout_height="41dp"
        android:layout_marginLeft="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:id="@+id/user_icon_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintLeft_toLeftOf="@+id/user_icon"
        app:layout_constraintRight_toRightOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <RelativeLayout
        android:id="@+id/remain_time_root"
        android:background="@drawable/live_bg_c7d8ff_r9"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon_bg"
        app:layout_constraintLeft_toLeftOf="@+id/user_icon_bg"
        app:layout_constraintRight_toRightOf="@+id/user_icon_bg"
        flatten="true">
        <p151v.VImage
            android:id="@+id/guard_time_icon"
            android:background="0x7f08230b"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="1dp"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#3253e1"
            android:id="@+id/remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="1dp"/>
    </RelativeLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#212121"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:maxWidth="150dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/tagsContainer"
        app:layout_constraintLeft_toRightOf="@+id/user_icon_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tagsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/user_icon_bg"
        app:layout_constraintTop_toBottomOf="@+id/name"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/level"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="14dp"
            app:actualImageScaleType="fitXY"/>
        <p151v.VDraweeView
            android:id="@+id/vip"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"
            app:actualImageScaleType="fitXY"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#212121"
        android:layout_gravity="center"
        android:id="@+id/live_spend_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3sp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/live_less_coin"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#f36c4e"
        android:id="@+id/live_less_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3sp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_spend_coin"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/coinGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_less_coin,live_spend_coin"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:id="@+id/new_guard"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_ROOM_ONLINE"
        android:lineSpacingExtra="3sp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.LiveGuardItem>
