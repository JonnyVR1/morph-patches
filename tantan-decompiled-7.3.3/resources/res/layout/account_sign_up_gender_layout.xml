<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:id="@+id/sign_up_top_icon"
        android:layout_width="138dp"
        android:layout_height="120dp"
        android:src="0x7f080201"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="24dp"
        android:textColor="@color/black"
        android:id="@+id/sign_up_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="116dp"
        android:text="请问你的性别是？"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gender_male_btn"
        android:background="@drawable/account_sign_up_male_selected"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_title"/>
    <com.p051p1.mobile.android.p053ui.RoundedView
        android:id="@+id/sign_up_male_line"
        android:background="0x7f080204"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="@+id/gender_male_btn"
        app:roundedCornerRadius="10dp"/>
    <p151v.VImage
        android:id="@+id/sign_up_male_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f080203"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/gender_male_btn"
        app:layout_constraintEnd_toStartOf="@+id/sign_up_male_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gender_male_btn"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black"
        android:id="@+id/sign_up_male_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="男生"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/gender_male_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sign_up_male_icon"
        app:layout_constraintTop_toTopOf="@+id/gender_male_btn"/>
    <View
        android:id="@+id/gender_female_btn"
        android:background="@drawable/account_sign_up_unselect"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/gender_male_btn"/>
    <com.p051p1.mobile.android.p053ui.RoundedView
        android:id="@+id/sign_up_female_line"
        android:background="0x7f080200"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="@+id/gender_female_btn"
        app:roundedCornerRadius="10dp"/>
    <p151v.VImage
        android:id="@+id/sign_up_female_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f0801ff"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/gender_female_btn"
        app:layout_constraintEnd_toStartOf="@+id/sign_up_female_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gender_female_btn"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black"
        android:id="@+id/sign_up_female_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="女生"
        android:textAllCaps="false"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/gender_female_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sign_up_female_icon"
        app:layout_constraintTop_toTopOf="@+id/gender_female_btn"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_000000_40"
        android:gravity="center_vertical"
        android:id="@+id/sign_up_gender_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="性别设置后，无法更改"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/sign_up_gender_tip_icon"
        app:layout_constraintTop_toBottomOf="@+id/gender_female_btn"/>
    <p151v.VImage
        android:id="@+id/sign_up_gender_tip_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f0829f9"
        android:scaleType="fitCenter"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_gender_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sign_up_gender_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
