<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="campus.StudentCardPreviewAct">
    <com.p051p1.mobile.putong.core.p058ui.PhotoPreviewView
        android:orientation="vertical"
        android:id="@+id/student_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:failureImage="0x7f081a6c"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|right"
        android:id="@+id/delete_pic"
        android:background="@drawable/core_student_delete_pic_select"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:minWidth="64dp"
        android:text="@string/ACTION_DELETE"/>
</FrameLayout>
