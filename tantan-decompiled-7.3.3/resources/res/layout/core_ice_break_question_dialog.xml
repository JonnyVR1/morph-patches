<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="icebreak.IceBreakQuestionDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_view"
        android:background="@drawable/core_ice_break_question_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ic_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f0809a4"/>
        <p151v.VImage
            android:id="@+id/image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="0x7f0809a5"
            android:layout_marginStart="40dp"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:layout_gravity="start"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="添加感兴趣的开场白"
            android:layout_marginStart="40dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#66000000"
            android:layout_gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="40dp"
            android:text="离线期间也不错过心动好友，配对后给对方自动发送开场白"
            android:layout_marginHorizontal="40dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp">
            <p151v.VLinear
                android:id="@+id/ll_question_1"
                android:background="@drawable/core_ice_break_question_dialog_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="78dp"
                flatten="true">
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_80"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/question_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="15dp"
                    android:layout_weight="1"
                    android:layout_marginVertical="15dp"/>
                <p151v.VCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/check_box_1"
                    android:background="@drawable/core_ic_break_checkbox_bg"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:checked="false"
                    style="@style/common_checkbox"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/ll_question_2"
                android:background="@drawable/core_ice_break_question_dialog_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="78dp"
                flatten="true">
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_80"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/question_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="15dp"
                    android:layout_weight="1"
                    android:layout_marginVertical="15dp"/>
                <p151v.VCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/check_box_2"
                    android:background="@drawable/core_ic_break_checkbox_bg"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:checked="false"
                    style="@style/common_checkbox"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:id="@+id/ll_question_3"
                android:background="@drawable/core_ice_break_question_dialog_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="78dp"
                flatten="true">
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_80"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/question_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="15dp"
                    android:layout_weight="1"
                    android:layout_marginVertical="15dp"/>
                <p151v.VCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/check_box_3"
                    android:background="@drawable/core_ic_break_checkbox_bg"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:checked="false"
                    style="@style/common_checkbox"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <TextView
            android:enabled="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/open_btn"
            android:background="@drawable/core_post_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="立即添加"/>
    </LinearLayout>
</FrameLayout>
