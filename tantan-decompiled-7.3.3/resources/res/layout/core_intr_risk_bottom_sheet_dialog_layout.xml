<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_friend_tacit_bottom_sheet_bg"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="dlg.IntrRiskBottomSheetDialog">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f080733"
        android:layout_marginEnd="16dp"/>
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/core_intr_risk_bottom_icon"
        android:layout_marginStart="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="22sp"
        android:textColor="#000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/TO_RISK_DETECTION_POPUP_TITLE"
        android:layout_marginStart="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66100e0e"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/TO_RISK_DETECTION_DESC_A"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66100e0e"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/TO_RISK_DETECTION_DESC_B"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/core_certification_bottom_sheet_button_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="31dp"
        android:layout_marginRight="20dp"
        android:text="@string/TO_RISK_DETECTION_BTN_OK"
        android:layout_marginHorizontal="20dp"/>
</p151v.VLinear>
