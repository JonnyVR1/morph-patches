<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_width="1dp"
        android:layout_height="69dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@drawable/core_message_bar_new_reference_bg"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/moment_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:src="0x7f08079f"
        android:layout_marginStart="10dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"
        app:roundedCornerRadius="8dp"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/play_ic"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="0x7f080f79"
        app:layout_constraintBottom_toBottomOf="@+id/moment_image"
        app:layout_constraintEnd_toEndOf="@+id/moment_image"
        app:layout_constraintStart_toStartOf="@+id/moment_image"
        app:layout_constraintTop_toTopOf="@+id/moment_image"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_black_02"
        android:ellipsize="end"
        android:id="@+id/name"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="231dp"
        android:minWidth="89dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintStart_toEndOf="@+id/moment_image"
        app:layout_constraintTop_toTopOf="@+id/bg"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_grey_03"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/content"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:maxWidth="231dp"
        android:minWidth="89dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintBottom_toBottomOf="@+id/bg"
        app:layout_constraintStart_toEndOf="@+id/moment_image"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:typeface="regular"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="0x7f080ead"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
