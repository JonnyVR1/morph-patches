<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/layoutrootview"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="purchase.intlpage.IntlPurchasePageDialog">
    <p151v.VImage
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/close"
                android:padding="6dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="0x7f08152c"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VText
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_80"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="60dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:layout_marginHorizontal="60dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/title_img"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080bca"/>
        </FrameLayout>
        <com.p051p1.mobile.putong.core.p058ui.purchase.intlpage.IntlPurchasePageTabsContainerView
            android:gravity="center_vertical"
            android:id="@+id/tabs_container"
            android:background="@drawable/core_intl_bg_purchase_page_tab"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <p151v.VPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</FrameLayout>
