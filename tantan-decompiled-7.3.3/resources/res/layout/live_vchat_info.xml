<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="internal.vchat"
    holder="view.LiveVChatInfoView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="花好月圆"
            android:maxLines="1"
            app:typeface="medium"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/report_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="1dp"
            android:src="0x7f0826df"/>
    </p151v.VLinear>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="13:02"/>
</com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatInfoView>
