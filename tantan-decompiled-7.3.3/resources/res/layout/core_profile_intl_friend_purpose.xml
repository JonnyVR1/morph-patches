<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_information"
    android:paddingTop="0dp"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileIntlFriendPurposeItemHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/intl_purpose_title_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        flatten="true">
        <p151v.VText
            android:id="@+id/intl_purpose_title"
            android:paddingRight="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_RELATIONSHIP_GOAL_TITLE"
            android:layout_weight="1"
            app:typeface="bold"
            style="@style/profile_item_title_black_no_bg"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/intl_purpose_add_wrap"
            android:paddingTop="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#fe7e1d"
                android:id="@+id/intl_purpose_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_RELATIONSHIP_GOALS_ADD_BTN"
                app:typeface="bold"/>
            <p151v.VImage
                android:id="@+id/intl_purpose_add_img"
                android:background="0x7f080aac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"/>
        </p151v.VLinear>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/intl_purpose_wrap"
        android:background="@drawable/tf_rect_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:layout_gravity="top"
            android:id="@+id/intl_purpose_tip"
            android:text="@string/INTL_RELATIONSHIP_GOAL_FOUND_BTN"
            android:layout_weight="2"
            style="@style/profile_item_item_new_edit"/>
        <p151v.VText
            android:ellipsize="end"
            android:id="@+id/intl_purpose"
            android:paddingLeft="0dp"
            android:layout_weight="3"
            style="@style/profile_item_item_new_edit"/>
    </LinearLayout>
</p151v.VLinear_Dividers>
