<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    holder="accountai.new2021.view.NameView">
    <p151v.VFrame
        android:orientation="horizontal"
        android:id="@+id/vl_birth"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        flatten="true">
        <com.p051p1.mobile.putong.account.p055ui.accountnew.loginopt.NameEditTextOpt
            android:textSize="18dp"
            android:textColor="@color/common_black_01"
            android:textColorHint="@color/common_light_01"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/full_name"
            android:background="@drawable/account_signup_input_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/SIGNUP_INPUT_USERNAME"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/account_signup_ai_cursor"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/iv_refresh_name"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="20dp"
            android:src="0x7f0801e3"
            android:layout_marginStart="8dp"/>
    </p151v.VFrame>
    <p151v.VButton_FakeShadow
        android:id="@+id/next"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="49dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ACTION_CONFIRM"
        style="@style/common_button_large_01"/>
</merge>
