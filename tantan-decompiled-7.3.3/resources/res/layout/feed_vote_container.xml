<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/feed_mine_status_bottom_end_status"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="20dp"
    android:layout_marginRight="16dp"
    flatten="false"
    folder="newui"
    holder="photoalbum.view.FeedCanVoteContentView">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="255dp"
        android:layout_height="21dp"
        android:layout_marginLeft="12dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#4c000000"
        android:ellipsize="end"
        android:id="@+id/people_count"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        android:maxLines="1"/>
    <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedVoteContainer
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#80000000"
        android:gravity="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/post"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text=" 分享我的观点"
        android:drawableLeft="0x7f081f38"
        android:lineSpacingExtra="0sp"
        android:letterSpacing="0"/>
</LinearLayout>
