<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/feed_bottom_comment_view_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/pic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/feed_fresco_profile_small"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/feed_33000000"
        android:gravity="center_vertical"
        android:id="@+id/comment_tv"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:text="@string/COMMENT_DEFAULT_PLACE_HOLDER_TEXT"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/pic"
        app:layout_constraintRight_toLeftOf="@+id/emoji_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/emoji_img"
        android:visibility="gone"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginRight="13dp"
        android:src="0x7f081cf7"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
