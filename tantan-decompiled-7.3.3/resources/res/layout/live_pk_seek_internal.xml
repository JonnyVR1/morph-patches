<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.internal.PkMatchInternalModule">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f08211e"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_PK_SEEKING_TITLE"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_back"/>
        <View
            android:id="@+id/title_space"
            android:background="@color/live_white_03_opacity"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
        <View
            android:id="@+id/space_view"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginBottom="253dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_space"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_svga_view_success"
            android:layout_width="120dp"
            android:layout_height="110dp"
            android:layout_marginTop="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_space"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_svga_view"
            android:layout_width="120dp"
            android:layout_height="110dp"
            android:layout_marginTop="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_space"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/me"
            android:background="@drawable/live_shape_bg_pk_random"
            android:layout_width="115dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="52dp"
            app:layout_constraintEnd_toStartOf="@+id/space_view"
            app:layout_constraintTop_toBottomOf="@+id/title_space">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/me_avatar"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                app:roundAsCircle="true"/>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/me_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="用户昵称昵称昵称"
                android:maxLines="1"
                android:maxEms="6"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/other"
            android:background="@drawable/live_shape_bg_pk_friend"
            android:layout_width="115dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="52dp"
            app:layout_constraintStart_toEndOf="@+id/space_view"
            app:layout_constraintTop_toBottomOf="@+id/title_space">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VDraweeView
                    android:id="@+id/other_avatar"
                    android:visibility="gone"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    app:actualImageScaleType="centerCrop"
                    app:roundAsCircle="true"/>
                <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkMatchProfileBlackView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/match_profile_view"
                    android:visibility="visible"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp">
                    <p151v.VDraweeView
                        android:id="@+id/next_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerInside"
                        app:roundAsCircle="true"/>
                    <p151v.VDraweeView
                        android:id="@+id/current_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerInside"
                        app:roundAsCircle="true"/>
                    <p151v.VImage
                        android:id="@+id/fail_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="0x7f082448"
                        android:scaleType="centerInside"/>
                </com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkMatchProfileBlackView>
            </FrameLayout>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/other_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/LIVE_PK_SEEKING_RESTART_BUTTON_TITLE"
                android:maxLines="1"
                android:maxEms="6"
                android:singleLine="true"/>
        </LinearLayout>
        <Button
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:background="@drawable/live_bg_white_r10_a10"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="164dp"
            android:text="@string/ACTION_CANCEL"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_view"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:layout_gravity="center"
            android:id="@+id/retry_button"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="164dp"
            android:text="@string/LIVE_PK_SEEKING_RESTART_BUTTON_TITLE"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_view"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/live_white_40_opacity"
            android:layout_gravity="center"
            android:id="@+id/match_tip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
