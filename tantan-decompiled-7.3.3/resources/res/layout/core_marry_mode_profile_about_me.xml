<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/core_color_80percent_000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="关于我"
        app:typeface="medium"/>
    <com.p051p1.mobile.putong.core.view.CardLabelShowView2
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        app:itemBackgroundV2="#ffffff"
        app:itemHaveStrokeV2="true"
        app:itemMaxNumberV2="20"
        app:itemStrokeColorV2="#0a000000"
        app:itemStrokeWidthV2="3dp"/>
</p151v.VLinear>
