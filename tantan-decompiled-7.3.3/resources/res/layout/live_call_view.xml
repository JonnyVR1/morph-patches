<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.LiveCallView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="recreation"
    holder="multiplayerchat.view.LiveCallView">
    <FrameLayout
        android:id="@+id/call_anchor_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        flatten="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_anchor"
            android:background="#ff6fb5"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:text="@string/LIVE_CALL_HOST"
            android:maxEms="6"
            android:singleLine="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/call_audience_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        flatten="true">
        <FrameLayout
            android:clipChildren="false"
            android:layout_width="48dp"
            android:layout_height="44dp">
            <p151v.VDraweeView
                android:layout_gravity="start|top"
                android:id="@+id/tv_other_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                app:failureImage="@drawable/live_vector_default_avatar_bg"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="start|top"
                android:id="@+id/tv_sub_anchor"
                android:background="@drawable/live_shape_tv_sub_anchor_round_bg"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:text="2"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_heart_count"
                android:background="@drawable/live_bg_f36c4e_r8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_mute"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginBottom="13dp"
            android:src="0x7f08226f"
            android:layout_marginEnd="46dp"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginBottom="13dp"
            android:src="0x7f08226d"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start|bottom"
            android:id="@+id/tv_follow"
            android:background="@drawable/live_bg_ff8817_r7"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginBottom="13dp"
            android:text="@string/LIVE_FOLLOW"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/iv_send_gift"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginBottom="13dp"
            android:src="0x7f08226e"
            android:layout_marginStart="10dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.LiveCallView>
