<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_tr24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="internal.vchat"
    holder="view.AnchorChatSummaryView">
    <p151v.VImage
        android:id="@+id/report"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f0826de"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="22dp"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="通话结束"
        android:layout_marginStart="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#33000000"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="本次通话数据"
        android:layout_marginStart="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <View
        android:id="@+id/duration_layout"
        android:background="@drawable/live_bg_black_r10_a03"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="24dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/heart_layout"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="#cc000000"
        android:gravity="center"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/duration_layout"
        app:layout_constraintRight_toRightOf="@+id/duration_layout"
        app:layout_constraintTop_toTopOf="@+id/duration_layout"
        app:typeface="medium"/>
    <p151v.VText
        android:id="@+id/duration_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="通话时长"
        app:layout_constraintLeft_toLeftOf="@+id/duration_layout"
        app:layout_constraintRight_toRightOf="@+id/duration_layout"
        app:layout_constraintTop_toBottomOf="@+id/tv_duration"/>
    <View
        android:id="@+id/heart_layout"
        android:background="@drawable/live_bg_black_r10_a03"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="40dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@+id/duration_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/duration_layout"/>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="#cc000000"
        android:gravity="center"
        android:id="@+id/tv_heart"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/heart_layout"
        app:layout_constraintRight_toRightOf="@+id/heart_layout"
        app:layout_constraintTop_toTopOf="@+id/heart_layout"
        app:typeface="medium"/>
    <p151v.VText
        android:id="@+id/heart_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="获得心动值"
        app:layout_constraintLeft_toLeftOf="@+id/heart_layout"
        app:layout_constraintRight_toRightOf="@+id/heart_layout"
        app:layout_constraintTop_toBottomOf="@+id/tv_heart"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="20dp"
        android:text="完成"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
