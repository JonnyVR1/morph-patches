<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="630dp">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="274dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="375:274"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:src="0x7f0822e3"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintLeft_toLeftOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="礼物详情"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintLeft_toLeftOf="@+id/top_bar"
        app:layout_constraintRight_toRightOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <View
        android:id="@+id/current_anchor_status"
        android:background="@drawable/live_bg_25252c_r24"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#4dffffff"
        android:id="@+id/anchor_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/current_anchor_status"
        app:layout_constraintLeft_toLeftOf="@+id/current_anchor_status"
        app:layout_constraintTop_toTopOf="@+id/current_anchor_status"/>
    <p151v.VDraweeView
        android:id="@+id/anchor_avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="14.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/current_anchor_status"
        app:layout_constraintLeft_toRightOf="@+id/anchor_rank"
        app:layout_constraintTop_toTopOf="@+id/current_anchor_status"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14.5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/anchor_avatar"
        app:layout_constraintRight_toLeftOf="@+id/one_click"
        app:layout_constraintTop_toTopOf="@+id/anchor_avatar">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#66ffffff"
            android:ellipsize="end"
            android:id="@+id/anchor_need"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/one_click"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_BUTTON_NAMED"
        android:singleLine="true"
        app:layout_constraintRight_toRightOf="@+id/current_anchor_status"
        app:layout_constraintTop_toTopOf="@+id/current_anchor_status"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="#66ffffff"
        android:gravity="center_vertical"
        android:id="@+id/diamond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="11233"
        android:drawableLeft="0x7f082287"
        android:drawablePadding="2dp"
        app:layout_constraintLeft_toLeftOf="@+id/one_click"
        app:layout_constraintRight_toRightOf="@+id/one_click"
        app:layout_constraintTop_toBottomOf="@+id/one_click"/>
    <p151v.VRecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/current_anchor_status"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
