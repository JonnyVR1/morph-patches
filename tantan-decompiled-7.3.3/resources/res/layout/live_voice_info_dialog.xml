<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.roominfobar.VoiceRoomInfoDialog">
    <View
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/layout_dialog"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:id="@+id/close_iv"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:src="0x7f082802"
            android:layout_alignParentRight="true"/>
        <p151v.VText
            android:textSize="21sp"
            android:textColor="@color/live_black"
            android:id="@+id/chat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="68dp"
            android:text="@string/LIVE_VOICE_EDITE_ROOM_TITLE_TIP"/>
        <FrameLayout
            android:id="@+id/edit_ly"
            android:background="@drawable/live_bg_f9f9f9_r16"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="4dp"
            android:layout_below="@+id/chat_title"
            flatten="true">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#212121"
                android:textColorHint="#26000000"
                android:gravity="center"
                android:id="@+id/title_edit"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:hint="@string/LIVE_VOICE_PREVIEW_PLACEHOLDER"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="textNoSuggestions"
                android:textCursorDrawable="@drawable/live_shape_voice_preview_input_cursor_style"/>
        </FrameLayout>
        <com.p051p1.mobile.putong.live.base.view.MaximumScroll
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="36dp"
            android:layout_below="@+id/edit_ly"
            android:overScrollMode="never"
            app:maxHeight="104dp"
            flatten="true">
            <org.apmem.tools.layouts.FlowLayout
                android:gravity="left"
                android:id="@+id/flow_ly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:weightDefault="1"/>
        </com.p051p1.mobile.putong.live.base.view.MaximumScroll>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#9aa5b1"
            android:id="@+id/no_data_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_PROFILE_DATA_LOAD_FAIL"
            android:layout_centerInParent="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@drawable/live_selector_voice_room_info_dialog_confirm_color"
            android:gravity="center"
            android:id="@+id/live_confirm"
            android:background="@drawable/live_selector_voice_start_live_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="24dp"
            android:text="@string/LIVE_VOICE_EDITE_ROOM_TITLE_CONFIRM"
            android:layout_below="@+id/scroll_view"/>
    </RelativeLayout>
</LinearLayout>
