<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.member.view.MemberLeaderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    flatten="true"
    folder="common"
    holder="member.view.MemberLeaderView">
    <p151v.VRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            app:srcCompat="0x7f0823e0"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4dffffff"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="24dp"
            android:text="@string/LIVE_GUEST_PROFILE_LIST"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/jump"
            android:background="@drawable/live_bg_ff8817_r16"
            android:layout_width="247dp"
            android:layout_height="56dp"
            android:layout_marginTop="50dp"
            android:text="@string/LIVE_GUEST_PROFILE_GIVE_GIFT"
            flatten="true"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.common.member.view.MemberLeaderView>
