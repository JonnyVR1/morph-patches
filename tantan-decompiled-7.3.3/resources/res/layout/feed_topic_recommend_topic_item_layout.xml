<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.view.TopicRecommendTopicItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    folder="newui"
    holder="photoalbum.view.TopicRecommendTopicItemView">
    <p151v.VFrame
        android:id="@+id/topic_head_fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/topic_head_image"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="12dp"
            style="@style/feed_fresco_base"/>
        <p151v.VDraweeView
            android:id="@+id/topic_head_shadow"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            app:actualImageResource="@color/common_grey_03"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@color/common_grey_03"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="12dp"
            style="@style/feed_fresco_base"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/topic_image_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081c53"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        flatten="false">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feed_nearby_topic_color"
            android:ellipsize="end"
            android:id="@+id/topic_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/common_grey_03"
            android:id="@+id/topic_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.photoalbum.view.TopicRecommendTopicItemView>
