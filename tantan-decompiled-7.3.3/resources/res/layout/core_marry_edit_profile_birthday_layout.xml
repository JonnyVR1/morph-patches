<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.birthday.MarryEditProfileBirthdayViewModel">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/first_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/SETTINGS_BIRTHDAY"
            android:layout_centerHorizontal="true"
            app:typeface="medium"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/date_yyyy_mm_dd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="40dp"
            android:layout_below="@+id/first_title"
            flatten="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/core_bg_shadow_with_border"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.profile.loop.input.DateEditTextNew
                    android:id="@+id/date_edit_year"
                    android:background="@color/transparent"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:inputType="number"
                    app:blockSpacing="0dp"
                    app:cursorColor="@color/core_fe7e1d"
                    app:cursorWidth="3dp"
                    app:hintTextColor="@color/core_color_26000000"
                    app:maxLength="4"
                    app:textColor="@color/core_color_e6000000"
                    app:textSize="28sp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/core_color_26000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/EDIT_BIRTHDAY_YEAR"
                    android:lineSpacingExtra="0sp"/>
            </LinearLayout>
            <View
                android:layout_width="10dp"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/core_bg_shadow_with_border"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.profile.loop.input.DateEditTextNew
                    android:id="@+id/date_edit_month"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:inputType="number"
                    app:blockSpacing="0dp"
                    app:cursorColor="@color/core_fe7e1d"
                    app:cursorWidth="3dp"
                    app:hintTextColor="@color/core_color_26000000"
                    app:maxLength="2"
                    app:textColor="@color/core_color_e6000000"
                    app:textSize="28sp"
                    app:type="2"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/core_color_26000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/EDIT_BIRTHDAY_MONTH"
                    android:lineSpacingExtra="0sp"/>
            </LinearLayout>
            <View
                android:layout_width="10dp"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/core_bg_shadow_with_border"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.profile.loop.input.DateEditTextNew
                    android:id="@+id/date_edit_day"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:inputType="number"
                    app:blockSpacing="0dp"
                    app:cursorColor="@color/core_fe7e1d"
                    app:cursorWidth="3dp"
                    app:hintTextColor="@color/core_color_26000000"
                    app:maxLength="2"
                    app:textColor="@color/core_color_e6000000"
                    app:textSize="28sp"
                    app:type="3"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/core_color_26000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/EDIT_BIRTHDAY_DAY"
                    android:lineSpacingExtra="0sp"/>
            </LinearLayout>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_color_ff6244"
            android:gravity="center_vertical"
            android:id="@+id/date_hint"
            android:background="@drawable/core_bg_shadow_with_date_hint"
            android:paddingLeft="8dp"
            android:paddingTop="9dp"
            android:paddingRight="13dp"
            android:paddingBottom="9dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="40dp"
            android:minHeight="30dp"
            android:drawableLeft="0x7f0816b9"
            android:drawablePadding="3dp"
            android:layout_below="@+id/date_yyyy_mm_dd"/>
    </RelativeLayout>
</ScrollView>
