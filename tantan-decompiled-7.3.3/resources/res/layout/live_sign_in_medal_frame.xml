<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.signin.medal.SignInMedalFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.signin.medal"
    holder="SignInMedalFrame">
    <com.p051p1.mobile.putong.live.base.view.DialogTitleBar
        android:id="@+id/dialog_title_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"/>
    <FrameLayout
        android:id="@+id/big_medal"
        android:layout_width="match_parent"
        android:layout_height="166dp"
        android:layout_below="@+id/divider"
        flatten="true">
        <p151v.VPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/left_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="26dp"
            app:srcCompat="0x7f082672"/>
        <p151v.VImage
            android:layout_gravity="end|center_vertical"
            android:id="@+id/right_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="26dp"
            app:srcCompat="0x7f082675"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/small_medal_list"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="-8dp"
        android:layout_below="@+id/big_medal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:layout_marginBottom="9dp"
        android:layout_above="@+id/progress_container"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="75dp"
            android:layout_height="2dp"
            app:srcCompat="0x7f082673"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#fffff1c5"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_SIGN_IN_MEDAL_NEXT_LEVEL"/>
        <p151v.VImage
            android:layout_gravity="end|center_vertical"
            android:layout_width="75dp"
            android:layout_height="2dp"
            app:srcCompat="0x7f082674"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="14dp"
        android:layout_above="@+id/introduction"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.common.signin.medal.MedalProgressView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#ffda2a58"
            android:layout_gravity="center"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#ffca174e"
        android:gravity="center"
        android:id="@+id/introduction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="33dp"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.live.livingroom.common.signin.medal.SignInMedalFrame>
