<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/white"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.input.MarryEditProfileInputViewModel">
    <p151v.VText
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        style="@style/marry_loop_edit_title_text"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4d000000"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxLines="2"/>
            <p151v.VFrame
                android:id="@+id/input_layout"
                android:background="@drawable/core_marry_edit_input_bg"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                flatten="true">
                <p151v.VEditText
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:textColorHint="#26000000"
                    android:gravity="top|left"
                    android:id="@+id/input_text"
                    android:background="#00000000"
                    android:paddingLeft="16dp"
                    android:paddingTop="20dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="55dp"
                    android:layout_width="match_parent"
                    android:layout_height="193dp"
                    android:lines="6"
                    android:textCursorDrawable="@drawable/core_message_input_cursor"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#26000000"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/max_count"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="300"/>
            </p151v.VFrame>
        </p151v.VLinear>
    </ScrollView>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff6464"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/fail_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"/>
    <include
        android:id="@+id/new_case_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        layout="@layout/core_aboutme_new_case_layout"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/stencil_layout"
        android:background="@drawable/core_marry_edit_input_stencil_bg"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        flatten="true">
        <TextView
            android:textSize="13sp"
            android:textColor="#66000000"
            android:id="@+id/stencil_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="参考模版"
            android:drawableLeft="@drawable/core_input_stencil_icon"
            android:drawablePadding="2dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:layout_gravity="end"
            android:id="@+id/stencil_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </p151v.VLinear>
</p151v.VLinear>
