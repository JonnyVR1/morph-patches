<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VRelative
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:id="@+id/tv_protocol_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="账号内钱包结清"/>
        <p151v.VCheckBox
            android:id="@+id/check_protocol_item"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:layout_alignParentEnd="true"
            style="@style/common_checkbox"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#66000000"
            android:id="@+id/tv_protocol_item_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="账号内钱包结清"
            android:layout_below="@+id/tv_protocol_item_title"/>
    </p151v.VRelative>
</p151v.VLinear>
