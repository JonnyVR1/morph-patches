<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    flatten="true"
    holder="dlg.BindPhoneNumberDlg">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#323232"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_TITLE"
            android:maxLines="2"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="32dp"
            android:text="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_SUBTITLE"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/verify"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp">
            <LinearLayout
                android:background="@drawable/core_bind_phone_number_bg"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ccode"
                    android:focusableInTouchMode="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="62dp"
                    android:includeFontPadding="false"
                    android:paddingStart="20dp"/>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:layout_width="7dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="4dp"
                    android:src="0x7f080558"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#f2f2f2"
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"/>
                <p151v.VEditText
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:id="@+id/phone_num"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_PHONE_PLACEHOLDER"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:inputType="phone"
                    android:textCursorDrawable="@drawable/core_bind_phone_cursor"/>
                <FrameLayout
                    android:id="@+id/clear"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="match_parent">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="0x7f080a13"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/core_bind_phone_number_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp">
                <p151v.VEditText
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:id="@+id/code"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_VERIFICATION_CODE_PLACEHOLDER"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:textCursorDrawable="@drawable/core_bind_phone_cursor"
                    android:paddingStart="16dp"/>
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:enabled="false"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/core_intl_facebook_bind_phone_dlg_get_code_text_selector"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/get_code"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="12dp"
                    android:checked="false"
                    android:minWidth="50dp"
                    android:minHeight="34dp"
                    android:text="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_SEND_CODE_BTN"/>
            </LinearLayout>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="@color/common_orange_02"
                android:gravity="center_vertical"
                android:id="@+id/error_code"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_INVALID_CODE_TEXT"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/verify_btn"
            android:background="@drawable/core_intl_bind_phone_dlg_bg_selector"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_VERIFY_BTN"
            style="@style/common_button_large_01"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="14sp"
            android:textColor="@color/core_intl_bind_phone_dlg_skip_text_selector"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="32dp"
            android:text="@string/INTL_TTC_MIGRATION_VERIFY_PHONE_POPUP_SKIP_BTN"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
