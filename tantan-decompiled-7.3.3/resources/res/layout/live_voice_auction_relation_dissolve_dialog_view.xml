<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_view_alert_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="提示"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="32dp"
        android:text="解除关系后，关系卡将在列表中移除，是否解除关系？"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <View
        android:id="@+id/ok_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="32dp"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_dissolve"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="解除"
        app:layout_constraintLeft_toLeftOf="@+id/ok_button"
        app:layout_constraintRight_toRightOf="@+id/ok_button"
        app:layout_constraintTop_toTopOf="@+id/ok_button"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ccffffff"
        android:id="@+id/tv_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        app:layout_constraintLeft_toLeftOf="@+id/ok_button"
        app:layout_constraintRight_toRightOf="@+id/ok_button"
        app:layout_constraintTop_toBottomOf="@+id/tv_dissolve"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_knight"
        android:background="@drawable/live_bg_knight_free_corner_mark"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="29dp"
        android:text="骑士星免费"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#33000000"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16sp"
        android:layout_marginBottom="24dp"
        android:text="取消"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ok_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
