<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true">
    <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageBarMediaItemSquareLayout
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/core_message_bar_media_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageMediaItemImage
                android:id="@+id/media_image"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <p151v.VText
                android:textSize="14dp"
                android:gravity="center"
                android:id="@+id/media_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageBarMediaItemSquareLayout>
    <p151v.VText
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/tips"
        android:background="@drawable/core_love_letter_chat_entry_tips_bg"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_margin="8dp"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        app:lineHeight="14dp"/>
</p151v.VFrame>
