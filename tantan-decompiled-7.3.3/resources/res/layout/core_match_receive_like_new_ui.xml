<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/match_root"
    android:background="#ffddba"
    android:fitsSystemWindows="false"
    android:clickable="true"
    android:clipChildren="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.newanim.MatchReceiveLikeNewUIActViewModel"
    innerClass="true">
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svga_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/top_heart_ic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="19dp"
        android:src="0x7f080dd9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="34sp"
        android:textColor="@color/core_color_80percent_000000"
        android:gravity="center"
        android:id="@+id/pairing"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_heart_ic"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/core_color_60percent_000000"
        android:gravity="center"
        android:id="@+id/match_pairing_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="40dp"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pairing"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/core_color_80percent_000000"
        android:gravity="center"
        android:id="@+id/say_hello"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:typeface="medium"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <p151v.VRelative
        android:id="@+id/match_head_me_container"
        android:background="@drawable/core_match_receive_like_head_me_bg"
        android:layout_width="178dp"
        android:layout_height="178dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/match_head_me"
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:layout_centerInParent="true"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:roundAsCircle="true"/>
    </p151v.VRelative>
    <p151v.VRelative
        android:id="@+id/match_head_other_container"
        android:background="@drawable/core_match_receive_like_head_other_bg"
        android:layout_width="178dp"
        android:layout_height="178dp"
        android:layout_marginTop="92dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/match_head_other"
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:layout_centerInParent="true"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:roundAsCircle="true"/>
    </p151v.VRelative>
    <p151v.VImage
        android:id="@+id/me_head_top_heart_ic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="172dp"
        android:src="0x7f080ddb"
        android:layout_marginStart="132dp"
        app:layout_constraintBottom_toBottomOf="@+id/match_head_me_container"
        app:layout_constraintStart_toStartOf="@+id/match_head_me_container"/>
    <p151v.VImage
        android:id="@+id/me_head_bottom_arrow_ic"
        android:layout_width="104dp"
        android:layout_height="66dp"
        android:layout_marginTop="172dp"
        android:src="0x7f080dda"
        android:layout_marginStart="98dp"
        app:layout_constraintStart_toStartOf="@+id/match_head_me_container"
        app:layout_constraintTop_toTopOf="@+id/match_head_me_container"/>
    <p151v.VDraweeView
        android:id="@+id/other_head_top_like_me_ic"
        android:layout_width="106dp"
        android:layout_height="71dp"
        android:layout_marginBottom="135dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="17dp"
        app:actualImageScaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/match_head_other_container"
        app:layout_constraintEnd_toEndOf="@+id/match_head_other_container"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/core_color_EA9E55"
        android:gravity="center"
        android:id="@+id/bottom_action_btn"
        android:background="@drawable/fake_matchact_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="43dp"
        android:layout_marginRight="43dp"
        android:layout_marginBottom="80dp"
        android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/core_color_50percent_000000"
        android:gravity="center"
        android:id="@+id/bottom_cancel_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_action_btn"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/edit_wrapper"
        android:background="@drawable/core_match_new_ui_edit_shape"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="47dp"
        android:layout_marginRight="40dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/match_head_other_container"
        flatten="true">
        <p151v.VEditText
            android:textSize="16sp"
            android:textColor="@color/common_black_01"
            android:textColorHint="@color/common_grey_03"
            android:ellipsize="end"
            android:id="@+id/edit_text"
            android:background="@null"
            android:paddingLeft="24dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="48dp"
            android:hint="@string/MATCH_BOX_DEFAULT_TEXT"
            android:maxLines="1"
            android:maxLength="1000"
            android:layout_weight="1"
            android:inputType="textAutoCorrect"
            app:typeface="regular"/>
        <p151v.VText
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/text_send"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/MATCH_TEXT_SEND"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:autoSizeMaxTextSize="16sp"/>
    </LinearLayout>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/emoji_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_wrapper"
        flatten="true">
        <FrameLayout
            android:id="@+id/first_emoji_frame"
            android:background="@drawable/core_match_success_emoji_item_background"
            android:layout_width="56dp"
            android:layout_height="56dp"
            flatten="true">
            <p151v.VText
                android:textSize="24sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/first_emoji_text"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </FrameLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/second_emoji_frame"
            android:background="@drawable/core_match_success_emoji_item_background"
            android:layout_width="56dp"
            android:layout_height="56dp"
            flatten="true">
            <p151v.VText
                android:textSize="24sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/second_emoji_text"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </FrameLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/third_emoji_frame"
            android:background="@drawable/core_match_success_emoji_item_background"
            android:layout_width="56dp"
            android:layout_height="56dp"
            flatten="true">
            <p151v.VText
                android:textSize="24sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/third_emoji_text"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </FrameLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/fourth_emoji_frame"
            android:background="@drawable/core_match_success_emoji_item_background"
            android:layout_width="56dp"
            android:layout_height="56dp"
            flatten="true">
            <p151v.VText
                android:textSize="24sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/fourth_emoji_text"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </FrameLayout>
    </p151v.VLinear>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center"
        android:id="@+id/bottom_cancel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emoji_layout"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:src="0x7f080ddc"
        android:layout_marginStart="15.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
