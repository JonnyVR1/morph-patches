<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="advertisingcard.TagAddCardAdapter">
    <p151v.VDraweeView
        android:id="@+id/picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/core_kankan_card_placeholder"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomEnd="true"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundBottomStart="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/new_tag_top_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:src="0x7f081136"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/new_tag_top_icon"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/common_grey_09"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/new_tag_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <include
                android:id="@+id/item_1"
                layout="@layout/core_advertising_virtual_new_tag_add_card_item"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <include
                    android:id="@+id/item_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_advertising_virtual_new_tag_add_card_item"/>
                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/item_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_advertising_virtual_new_tag_add_card_item"/>
            </LinearLayout>
            <include
                android:id="@+id/item_4"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                layout="@layout/core_advertising_virtual_new_tag_add_card_item"/>
            <include
                android:id="@+id/item_5"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                layout="@layout/core_advertising_virtual_new_tag_add_card_item"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_99fec300"
            android:gravity="center"
            android:id="@+id/add_tags"
            android:background="@drawable/core_bg_16_ffeebb"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="40dp"
            android:text="添加到我的标签"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Semibold"
            android:layout_marginHorizontal="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/core_color_80000000"
            android:gravity="center_horizontal"
            android:id="@+id/change_a_batch"
            android:paddingLeft="20dp"
            android:paddingTop="6dp"
            android:paddingRight="20dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="换一批"
            android:drawablePadding="2dp"
            android:drawableStart="0x7f081134"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/new_tag_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
