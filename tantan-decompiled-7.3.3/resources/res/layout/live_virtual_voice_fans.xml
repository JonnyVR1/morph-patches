<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.fans.VoiceVirtualFansView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="virtual.fans.VoiceVirtualFansView">
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/members_count"
        android:background="@drawable/live_shape_voice_call_apply_manager_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="73dp"
        android:layout_height="26dp"
        android:minHeight="26dp"
        android:text="0"
        android:maxLines="1"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/share"
        android:background="@drawable/live_shape_voice_call_apply_manager_bg"
        android:layout_width="73dp"
        android:layout_height="26dp"
        android:layout_marginTop="10dp"
        android:text="邀请"
        android:layout_below="@+id/members_count"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.fans.VoiceVirtualFansView>
