<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:background="0x7f081788"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/playsvga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="24dp"
        android:scaleType="fitCenter"
        android:layout_above="@+id/title"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="22dp"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="长按连送"
        android:layout_above="@+id/content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="本次送你三个超级喜欢，试一下吧"
        android:layout_above="@+id/try_btn"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#19c2f8"
        android:gravity="center"
        android:id="@+id/try_btn"
        android:background="@drawable/core_superlike_upgrade_textbg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="56dp"
        android:layout_marginRight="56dp"
        android:layout_marginBottom="38dp"
        android:text="试一试"
        android:layout_alignParentBottom="true"/>
</p151v.VRelative>
