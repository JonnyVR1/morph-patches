<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.feed.seecard.MeetSeeDefaultCardItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="newmeet.feed.seecard.MeetSeeDefaultCardItem">
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080e5a"
        android:layout_centerInParent="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e6370f00"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="更多喜欢我的人"
        android:layout_above="@+id/subtitle"
        android:layout_centerInParent="true"
        android:rotation="-5"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#4d370f00"
        android:gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="快去打个招呼吧"
        android:layout_above="@+id/stuff"
        android:layout_centerHorizontal="true"
        android:rotation="-5"/>
    <View
        android:id="@+id/stuff"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerInParent="true"
        flatten="true"/>
    <p151v.VImage
        android:id="@+id/avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080e56"
        android:layout_below="@+id/stuff"
        android:layout_centerInParent="true"/>
</com.p051p1.mobile.putong.core.newui.newmeet.feed.seecard.MeetSeeDefaultCardItem>
