<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.greet.ProfileSendGreetView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@drawable/common_new_button_btn_white_medium"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    flatten="true"
    holder="vip.greet.ProfileSendGreetView">
    <p151v.VDraweeView
        android:id="@+id/greet_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="0x7f08148c"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"/>
    <include
        android:textSize="14sp"
        android:layout_gravity="center_vertical"
        android:id="@+id/envelop_say_hai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        layout="@layout/core_vip_greete_textswitcher"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#fe7e1d"
        android:gravity="center_vertical"
        android:id="@+id/send_btn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:drawablePadding="3dp"
        android:layout_marginEnd="16dp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.greet.ProfileSendGreetView>
