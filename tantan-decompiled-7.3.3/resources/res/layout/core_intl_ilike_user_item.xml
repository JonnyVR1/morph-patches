<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.intllikedusers.IntlILikeUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="231dp"
    android:layout_margin="4dp"
    holder="intllikedusers.IntlILikeUserItemView">
    <FrameLayout
        android:id="@+id/card_border_wrapper"
        android:background="@drawable/core_intl_liked_item_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="false">
        <p151v.AutoVDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/white"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="12dp"
            style="@style/core_fresco_base"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/personal_info"
            android:background="@drawable/core_intl_liked_user_item_superliked_gradient"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:paddingHorizontal="8dp"
            flatten="false">
            <p151v.VLinear_FillerMeasure
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="67dp"
                app:fillerIndex="0"
                app:layout_constraintBottom_toTopOf="@+id/left_time"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                flatten="false">
                <p151v.VText_NoTopPadding
                    android:textSize="16sp"
                    android:textColor="#e5ffffff"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:fontWeight="500"/>
                <p151v.VText_NoTopPadding
                    android:textSize="16sp"
                    android:textColor="#e5ffffff"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="3dp"
                    app:fontWeight="500"/>
                <p151v.VImage
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/certification_icon"
                    android:background="0x7f082957"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"/>
            </p151v.VLinear_FillerMeasure>
            <p151v.VText_NoTopPadding
                android:textSize="12sp"
                android:textColor="#b2ffffff"
                android:id="@+id/left_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="47dp"
                app:fontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <p151v.VImage
                android:id="@+id/instant_match_btn"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@+id/action_btn"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="0x7f080d3a"/>
            <p151v.VImage
                android:id="@+id/action_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="0x7f080d3e"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.intllikedusers.IntlILikeUserItemView>
