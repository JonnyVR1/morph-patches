<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/state_info"
    android:paddingLeft="32dp"
    android:paddingTop="6dp"
    android:paddingRight="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    flatten="true"
    holder="greet.GreetMessageStateFourView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="18dp">
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/state_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="1dp"/>
        <View
            android:id="@+id/view1"
            android:background="@drawable/core_greet_state_user_info_bg"
            android:visibility="gone"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_margin="3dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/state_zodiac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="1dp"/>
        <View
            android:id="@+id/view2"
            android:background="@drawable/core_greet_state_user_info_bg"
            android:visibility="gone"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_margin="3dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/state_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="1dp"/>
        <View
            android:id="@+id/view3"
            android:background="@drawable/core_greet_state_user_info_bg"
            android:visibility="gone"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_margin="3dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/state_reson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="1dp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.view.ImFlowView
            android:id="@+id/state_tag"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/state_pic"
        android:background="@drawable/core_greet_head_bg"
        android:paddingLeft="32dp"
        android:paddingTop="16dp"
        android:paddingRight="32dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/vf_state_img0"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/state_user_img0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/white"
                app:failureImageScaleType="centerInside"
                app:placeholderImage="@color/white"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/state_user_video0"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080d14"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/vf_state_img1"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="4dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/state_user_img1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/white"
                app:failureImageScaleType="centerInside"
                app:placeholderImage="@color/white"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/state_user_video1"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080d14"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/vf_state_img2"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="4dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/state_user_img2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/white"
                app:failureImageScaleType="centerInside"
                app:placeholderImage="@color/white"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/state_user_video2"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080d14"/>
            <p151v.VText
                android:textSize="24sp"
                android:textStyle="normal"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/image_more"
                android:background="@drawable/core_greet_state_img_more_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:typeface="medium"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/state_response"
        android:background="@drawable/core_greet_state_response_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/img_response"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginRight="9dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_response"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Regular"/>
    </p151v.VLinear>
</p151v.VLinear>
