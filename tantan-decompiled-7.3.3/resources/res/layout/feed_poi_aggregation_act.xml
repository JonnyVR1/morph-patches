<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fl"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="newui"
    holder="photoalbum.poi.aggregation.FeedPoiAggregationActViewModel">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true"
        useId="true">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:id="@+id/appbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            flatten="true">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:collapsedTitleTextAppearance="@style/TextAppearance.AppCompat.Title"
                app:contentScrim="@color/transparent"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:titleEnabled="false"
                flatten="true">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                    <p151v.VRelative
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <p151v.VImage
                            android:id="@+id/tool_bar_back"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginLeft="8dp"
                            android:src="0x7f081f07"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="@color/feed_e6000000"
                            android:ellipsize="end"
                            android:id="@+id/title_name"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="20dp"
                            android:lines="1"
                            android:layout_toLeftOf="@+id/official_topic_info"
                            android:layout_toRightOf="@+id/tool_bar_back"
                            android:layout_centerVertical="true"/>
                    </p151v.VRelative>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <p151v.VRelative
            android:id="@+id/layout_info"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <RelativeLayout
                android:id="@+id/poi_content_rl"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="12dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/poi_ic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="0x7f081e25"
                    android:layout_centerVertical="true"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:id="@+id/info_content_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_toRightOf="@+id/poi_ic"
                    android:layout_centerVertical="true"
                    flatten="true">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/feed_cc000000"
                        android:ellipsize="end"
                        android:id="@+id/poi_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <p151v.VLinear_FillerMeasure
                        android:gravity="left"
                        android:orientation="horizontal"
                        android:id="@+id/poi_guide_info_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        app:fillerIndex="0"
                        flatten="true">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/feed_4d000000"
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/poi_guide_info"
                            android:paddingBottom="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                        <p151v.VImage
                            android:layout_gravity="center_vertical"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="0x7f081e2a"
                            android:layout_centerVertical="true"/>
                    </p151v.VLinear_FillerMeasure>
                </p151v.VLinear>
            </RelativeLayout>
            <p151v.VLine
                android:id="@+id/layout_info_bottom_line"
                android:background="@color/feed_f9f9f9"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="12dp"
                android:layout_below="@+id/poi_content_rl"/>
        </p151v.VRelative>
        <FrameLayout
            android:id="@+id/moment_frag_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
