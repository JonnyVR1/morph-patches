<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="ui"
    holder="breaking.ProfileLikeLifePhotoAct">
    <View
        android:id="@+id/view"
        android:background="#636363"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_root"
        android:background="@drawable/message_swap_answer_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f082892"
            android:layout_marginEnd="16dp"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svga_box"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <p151v.VFrame
            android:background="@drawable/core_message_bar_input_bg"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            android:paddingVertical="17dp">
            <p151v.VDraweeView
                android:id="@+id/image"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="17dp"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="10dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#66000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="刚刚看过的照片"
                android:includeFontPadding="false"
                android:layout_marginStart="100dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#e5000000"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="夸夸她，开启愉快的聊天吧"
                android:includeFontPadding="false"
                android:layout_marginStart="100dp"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#e5000000"
                android:textColorHint="#33000000"
                android:gravity="start|center_vertical"
                android:id="@+id/edit_text"
                android:background="@drawable/message_swap_answer_dialog_edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="夸夸她的照片"
                android:includeFontPadding="false"
                android:maxLength="60"
                android:inputType="text"
                android:textCursorDrawable="@drawable/core_message_input_cursor"
                android:paddingStart="20dp"
                android:paddingEnd="70dp"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16sp"
                android:textColor="#fe7e1d"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发送"
                android:includeFontPadding="false"
                android:layout_marginEnd="20dp"/>
        </p151v.VFrame>
    </p151v.VLinear>
</p151v.VFrame>
