<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.explore.view.ExploreCardItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="explore.view.ExploreCardItemView">
    <RelativeLayout
        android:id="@+id/content_fl"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/explore_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImageScaleType="centerInside"
            app:placeholderImageScaleType="centerInside"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="18dp"
            style="@style/core_fresco_base"
            useId="true"/>
        <com.p051p1.mobile.putong.core.newui.home.views.SwipeLikeButton
            android:layout_gravity="end"
            android:id="@+id/explore_dislike_icon"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentEnd="true"/>
        <com.p051p1.mobile.putong.core.newui.home.views.SwipeLikeButton
            android:id="@+id/explore_like_icon"
            android:visibility="invisible"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"/>
        <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
            android:id="@+id/image_indicator"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            app:indicatorColor="#33ffffff"
            app:indicatorMargin="6dp"
            app:indicatorSelectedColor="@color/white"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/preview_action_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/card_bottom_container"
            flatten="true">
            <View
                android:id="@+id/explore_action_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <View
                android:id="@+id/explore_action_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <View
            android:id="@+id/explore_card_gradient"
            android:background="@drawable/bg_explore_bottom_gradient"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="38dp"
            android:layout_alignParentBottom="true"/>
        <View
            android:id="@+id/explore_card_black"
            android:background="@drawable/bg_explore_bottom_black"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"/>
        <RelativeLayout
            android:id="@+id/card_bottom_container"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentBottom="true"
            flatten="true">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/explore_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_above="@+id/explore_location"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/explore_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="11dp"
                android:lines="1"
                android:layout_above="@+id/explore_age"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/explore_age"
                android:background="@drawable/core_explore_female_bg"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginBottom="64dp"
                android:drawablePadding="2dp"
                android:layout_alignParentBottom="true"
                android:drawableStart="0x7f080805"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/explore_constellation"
                android:background="@drawable/bg_explore_tags"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:drawablePadding="2dp"
                android:layout_toRightOf="@+id/explore_age"
                android:layout_alignBottom="@+id/explore_age"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="5dp"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
                android:id="@+id/explore_flow_tags"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_alignBottom="@+id/explore_age"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/explore_detail"
                android:layout_toEndOf="@+id/explore_constellation"/>
            <include
                android:id="@+id/explore_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_alignBottom="@+id/explore_age"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/explore_constellation"
                layout="@layout/core_explore_tag_item"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/explore_detail"
                android:background="@drawable/bg_explore_tags"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="查看资料"
                android:drawablePadding="2dp"
                android:layout_alignBottom="@+id/explore_age"
                android:drawableEnd="0x7f08092f"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.newui.explore.view.ExploreCardItemView>
