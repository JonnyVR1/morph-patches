<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="99dp"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/message_sort_default_layout"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="99dp"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/message_sort_default_text"
            android:layout_width="83dp"
            android:layout_height="wrap_content"
            android:maxWidth="112dp"
            android:text="关注"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="0dp"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/img_con"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/message_sort_default_text"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VImage
                android:id="@+id/message_sort_default_check_image"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="0x7f080385"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
