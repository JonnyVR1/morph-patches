<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="accountnew.facebook.FacebookSignUpProfileImageViewModel">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/image"
        android:layout_width="@dimen/facebook_sign_up_profile_image_size"
        android:layout_height="@dimen/facebook_sign_up_profile_image_size"
        android:layout_marginTop="@dimen/facebook_sign_up_profile_image_top"
        android:layout_marginBottom="@dimen/facebook_sign_up_profile_image_bottom"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerCrop"
        app:roundedCornerRadius="@dimen/facebook_sign_up_profile_corner_radius"
        style="@style/account_fresco_base"
        useId="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#19191a"
        android:gravity="center"
        android:id="@+id/guide_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/FB_SIGNUP_CONFIRM_PHOTO_TITLE"
        android:layout_below="@+id/profile"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#8e8e8e"
        android:gravity="top|center_horizontal"
        android:id="@+id/guide_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:text="@string/FB_SIGNUP_CONFIRM_PHOTO_CONTENT"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
    <p151v.VLinear
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/pic_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="30dp"
        android:layout_below="@+id/guide_text"
        android:layout_alignParentBottom="true">
        <p151v.VImage
            android:id="@+id/reference_pic_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:layout_weight="1"/>
        <View
            android:layout_width="20dp"
            android:layout_height="0dp"/>
        <p151v.VImage
            android:id="@+id/reference_pic_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="0x7f0829fe"
            android:scaleType="centerInside"
            android:layout_weight="1"/>
        <View
            android:layout_width="20dp"
            android:layout_height="0dp"/>
        <p151v.VImage
            android:id="@+id/reference_pic_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="0x7f0829ff"
            android:scaleType="centerInside"
            android:layout_weight="1"/>
    </p151v.VLinear>
    <p151v.VButton_FakeShadow
        android:textSize="18sp"
        android:textColor="@color/account_buttons"
        android:gravity="center"
        android:id="@+id/continue_"
        android:background="@drawable/rect_rounded_tantan_orange_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:minHeight="52dp"
        android:text="@string/FB_SIGNUP_CONFIRM_PHOTO_BUTTON_UPLOAD"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#d75744"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/change_photo"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="8dp"
        android:minHeight="50dp"
        android:text="@string/FB_SIGNUP_CONFIRM_PHOTO_BUTTON_CHANGE"
        app:typeface="medium"/>
</p151v.VLinear>
