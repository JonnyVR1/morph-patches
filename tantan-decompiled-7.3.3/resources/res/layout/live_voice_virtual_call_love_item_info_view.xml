<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.travel.VoiceVirtualLoveItemInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="virtual.loveplanet.travel.VoiceVirtualLoveItemInfoView">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/v_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/bg_planet_svga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/user_bg"
        android:background="0x7f082855"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="@+id/v_line"
        app:layout_constraintStart_toStartOf="@+id/v_line"
        app:layout_constraintTop_toTopOf="@+id/fl_head"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/fl_head"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="@+id/v_line"
        app:layout_constraintStart_toStartOf="@+id/v_line"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_horizontal"
            android:id="@+id/svga"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="-10dp"
            android:scaleType="fitXY"/>
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="center_horizontal"
            android:id="@+id/vd_head"
            android:layout_width="58dp"
            android:layout_height="58dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_away"
            android:background="@drawable/live_bg_black_oval_a40"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:text="离席"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_name"
        android:background="@drawable/live_bg_260e5f_r4_a80"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/fl_head"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/v_line"
        app:layout_constraintStart_toStartOf="@+id/v_line"
        app:layout_constraintTop_toTopOf="@+id/fl_head"
        flatten="true">
        <TextView
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/tv_index"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="12dp"
            android:minHeight="12dp"
            android:text="1"
            android:layout_marginEnd="3dp"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white"
            android:gravity="center_vertical"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="虚位以待"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_heart"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/ll_name"
        app:layout_constraintEnd_toEndOf="@+id/v_line"
        app:layout_constraintStart_toStartOf="@+id/v_line"
        app:layout_constraintTop_toBottomOf="@+id/ll_name"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/heart_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="0x7f082851"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/live_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_heart"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:text="0"/>
    </p151v.VLinear>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/selected_tips"
        android:background="0x7f0823dd"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_margin="3dp"
        android:text="已选0号"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/v_line"
        app:layout_constraintStart_toStartOf="@+id/v_line"/>
    <p151v.VFrame
        android:id="@+id/select_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/v_line"
        app:layout_constraintTop_toTopOf="@+id/fl_head"
        flatten="true">
        <p151v.VCheckBox
            android:id="@+id/select_img"
            android:background="@drawable/live_selector_love_planet_pick"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:button="@null"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.travel.VoiceVirtualLoveItemInfoView>
