<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/my_pet"
    android:background="@color/white"
    android:paddingTop="18dp"
    flatten="true"
    holder="profile.profilelist.itemholders.EditProfilePetItemHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:gravity="center_vertical"
            android:id="@+id/edit_title"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:text="我的宠物"
            android:layout_weight="1"
            style="@style/profile_item_title_black_edit"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/pet_more_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="17dp"
            flatten="true">
            <p151v.VText
                android:gravity="center_vertical"
                android:id="@+id/pet_info"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="有宠物"/>
            <ImageView
                android:id="@+id/pet_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08145e"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/pet_type_wrap"
        android:paddingTop="17dp"
        android:layout_height="wrap_content"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="top"
            android:id="@+id/pet_type_tip"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_height="wrap_content"
            android:text="宠物信息"
            android:layout_weight="1"
            style="@style/profile_item_item_new"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/pet_no_pet_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="17dp"
            flatten="true">
            <p151v.VText
                android:layout_gravity="center_vertical"
                android:id="@+id/pet_no_pet_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="有宠物"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08145e"/>
        </LinearLayout>
        <ImageView
            android:gravity="center"
            android:id="@+id/pet_type"
            android:paddingRight="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_profile_edit_data_right_add"/>
    </LinearLayout>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/pet_img"
        android:paddingLeft="20dp"
        android:paddingTop="11dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="top|right"
            android:id="@+id/pet_1"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:roundedCornerRadius="10dp"/>
        <p151v.VDraweeView
            android:layout_gravity="top|right"
            android:id="@+id/pet_2"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:roundedCornerRadius="10dp"/>
        <p151v.VDraweeView
            android:layout_gravity="top|right"
            android:id="@+id/pet_3"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:roundedCornerRadius="10dp"/>
    </p151v.VLinear>
</p151v.VLinear_Dividers>
