<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.loop.profession.ProfileLoopSelectProfessionViewModel"
    innerClass="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VRelative
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/first_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#a9a9a9"
                android:id="@+id/subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_below="@+id/first_title"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="7sp"/>
            <p151v.VFrame
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="100dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/subtitle"
                flatten="true">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/core_profile_curtain_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                        android:layout_gravity="center"
                        android:id="@+id/main_wheel_center_left"
                        android:background="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        aigestudio:wheel_atmospheric="true"
                        aigestudio:wheel_curtain="true"
                        aigestudio:wheel_curtain_color="#f7f7f7"
                        aigestudio:wheel_curtain_height="56dp"
                        aigestudio:wheel_curved="true"
                        aigestudio:wheel_cyclic="false"
                        aigestudio:wheel_item_text_color="@color/core_color_26000000"
                        aigestudio:wheel_selected_item_text_color="@color/common_black_01"/>
                    <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                        android:layout_gravity="center"
                        android:id="@+id/main_wheel_center_right"
                        android:background="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="20dp"
                        android:layout_weight="1"
                        aigestudio:wheel_atmospheric="true"
                        aigestudio:wheel_curtain="true"
                        aigestudio:wheel_curtain_color="#f7f7f7"
                        aigestudio:wheel_curtain_height="56dp"
                        aigestudio:wheel_curved="true"
                        aigestudio:wheel_cyclic="false"
                        aigestudio:wheel_item_text_color="@color/core_color_26000000"
                        aigestudio:wheel_item_text_size="18sp"
                        aigestudio:wheel_selected_item_text_color="@color/common_black_01"/>
                </p151v.VLinear>
            </p151v.VFrame>
        </p151v.VRelative>
    </ScrollView>
    <include
        android:id="@+id/error_net_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="84dp"
        layout="@layout/core_home_net_error_layout"/>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/action_view"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        layout="@layout/core_profile_loop_edit_action_layout"/>
</FrameLayout>
