<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="surpisebox.StartChattingNowDialg">
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/core_bg_white_r20"
        android:layout_width="313dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/ll_liked_user"
            android:visibility="visible"
            android:layout_width="313dp"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/bg"
                android:layout_width="match_parent"
                android:layout_height="193dp"
                app:roundBottomLeft="false"
                app:roundBottomRight="false"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="20dp"/>
            <p151v.VDraweeView
                android:layout_gravity="left"
                android:id="@+id/user_0"
                android:background="@drawable/core_surprise_box_liked_avatar_bg"
                android:padding="3dp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginLeft="54dp"
                android:layout_marginTop="93dp"
                android:layout_marginBottom="20dp"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:layout_gravity="right"
                android:id="@+id/user_1"
                android:background="@drawable/core_surprise_box_liked_avatar_bg"
                android:padding="3dp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="93dp"
                android:layout_marginRight="54dp"
                android:layout_marginBottom="20dp"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/user_2"
                android:background="@drawable/core_surprise_box_liked_avatar_bg"
                android:padding="3dp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="93dp"
                android:layout_marginBottom="20dp"
                app:roundAsCircle="true"/>
            <p151v.VIcon
                android:layout_gravity="right"
                android:id="@+id/close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:src="0x7f0817b6"
                android:layout_marginEnd="16dp"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="18sp"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="即刻开聊"/>
        </FrameLayout>
        <p151v.VLinear
            android:orientation="horizontal"
            android:background="@drawable/common_bg_10_08000000"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/core_color_80percent_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/prompt_chat_statement"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
            <FrameLayout
                android:id="@+id/surprise_box_refresh"
                android:layout_width="58dp"
                android:layout_height="match_parent">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f0817c0"/>
            </FrameLayout>
        </p151v.VLinear>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_40percent_000000"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/main_btn"
            android:background="@drawable/core_bg_fe7e1d_r10"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="向好友打招呼"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
