<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.privilege.QuickChatPrivilegeAnimView">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.445"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_r"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.555"/>
    <FrameLayout
        android:id="@+id/avatar_left_container"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:translationX="-300dp"
        app:layout_constraintRight_toLeftOf="@+id/guideline_r"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true"
        style="@style/vip_alert_avatar_frame_round_bg">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_fresco_profile_white_border"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/avatar_right_container"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:translationX="300dp"
        app:layout_constraintLeft_toRightOf="@+id/guideline_l"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true"
        style="@style/vip_alert_avatar_frame_round_bg">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_right"
            android:layout_width="90dp"
            android:layout_height="90dp"
            style="@style/core_fresco_profile_white_border"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_right_blur"
            android:layout_width="90dp"
            android:layout_height="90dp"
            style="@style/core_fresco_profile_white_border"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/online"
            android:background="@drawable/bg_online_green_in_pay"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-5dp"
            android:text="@string/QUICK_CHAT_BROADCAST_ONLINE"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/hi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:src="0x7f0815b0"
        android:alpha="0"
        android:rotation="30"
        app:layout_constraintBottom_toTopOf="@+id/emoji"
        app:layout_constraintRight_toLeftOf="@+id/avatar_left_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="0x7f0815ae"
        android:alpha="0"
        android:rotation="30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/avatar_left_container"
        app:layout_constraintTop_toBottomOf="@+id/hi"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:src="0x7f0815af"
        android:alpha="0"
        android:rotation="-30"
        app:layout_constraintBottom_toTopOf="@+id/more"
        app:layout_constraintLeft_toRightOf="@+id/avatar_right_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="0x7f0815b1"
        android:alpha="0"
        android:rotation="-30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/avatar_right_container"
        app:layout_constraintTop_toBottomOf="@+id/hello"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="-8dp"
        android:src="0x7f080966"
        android:alpha="0"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/base"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</merge>
