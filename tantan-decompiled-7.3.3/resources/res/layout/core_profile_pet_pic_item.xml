<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="10dp"
    app:layout_constraintDimensionRatio="h,115:163">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:fadeDuration="0"
        app:failureImageScaleType="center"
        app:layout_constraintDimensionRatio="h,105:153"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="center"
        app:roundedCornerRadius="10dp"/>
    <View
        android:id="@+id/core_explore_pet_add_border"
        android:background="0x7f080811"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,105:153"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/core_explore_pet_add_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f08080f"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/core_explore_pet_add_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tag"
        android:background="@drawable/core_bg_6_80000000"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_margin="6dp"
        android:layout_marginTop="6dp"
        android:lines="1"
        android:drawablePadding="2dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#26000000"
        android:id="@+id/core_explore_pet_add_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="添加照片"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/core_explore_pet_add_button"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_add_pet_pic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="core_explore_pet_add_button,core_explore_pet_add_text,core_explore_pet_add_border"
        app:layout_constraintBottom_toBottomOf="@+id/core_explore_pet_add_text"
        app:layout_constraintEnd_toEndOf="@+id/core_explore_pet_add_text"
        app:layout_constraintStart_toStartOf="@+id/core_explore_pet_add_text"
        app:layout_constraintTop_toTopOf="@+id/core_explore_pet_add_button"/>
    <p151v.VImage
        android:id="@+id/replace_pet_pic"
        android:background="@drawable/core_explore_pet_pic_replace_bg"
        android:padding="2dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:src="0x7f080813"
        android:scaleType="fitCenter"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/core_explore_pet_add_border_shader"
        android:background="0x7f080812"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,105:153"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/core_explore_pet_add_button_shader"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f080810"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/core_explore_pet_add_button"
        app:layout_constraintEnd_toEndOf="@+id/core_explore_pet_add_button"
        app:layout_constraintStart_toStartOf="@+id/core_explore_pet_add_button"
        app:layout_constraintTop_toTopOf="@+id/core_explore_pet_add_button"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ff7602"
        android:id="@+id/core_explore_pet_add_text_shader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="添加照片"
        app:layout_constraintBottom_toBottomOf="@+id/core_explore_pet_add_text"
        app:layout_constraintEnd_toEndOf="@+id/core_explore_pet_add_text"
        app:layout_constraintStart_toStartOf="@+id/core_explore_pet_add_text"
        app:layout_constraintTop_toTopOf="@+id/core_explore_pet_add_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_add_pet_pic_shader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="core_explore_pet_add_border_shader,core_explore_pet_add_button_shader,core_explore_pet_add_text_shader"
        app:layout_constraintBottom_toBottomOf="@+id/core_explore_pet_add_text"
        app:layout_constraintEnd_toEndOf="@+id/core_explore_pet_add_text"
        app:layout_constraintStart_toStartOf="@+id/core_explore_pet_add_text"
        app:layout_constraintTop_toTopOf="@+id/core_explore_pet_add_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
