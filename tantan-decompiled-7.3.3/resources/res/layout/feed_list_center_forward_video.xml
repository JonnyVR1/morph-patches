<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterForwardVideoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/new_feed"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.feedcenter.FeedCenterForwardVideoViewHome">
    <View
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/feed_photo_album_activities_time"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/new_ab_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="16dp">
        <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
            android:id="@+id/moment_expandable_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:expandLine="3"
            app:expandText="@string/DISCOVER_MOMENT_SPREAD"
            app:isTextExpandSameLine="true"
            app:maxCollapsedLines="4">
            <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:id="@+id/moment_text"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/delete_forbidden_content"
                android:background="@drawable/feed_bg_rounded_07000"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="295dp"
                android:layout_height="84dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/video_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="0x7f081d0a"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/feed_4c000000"
                    android:ellipsize="end"
                    android:id="@+id/delete_forbidden_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"
                    android:layout_toRightOf="@+id/video_icon"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/video_play_content"
                android:background="@drawable/feed_bg_rounded_07000"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/feed_66000000"
                    android:ellipsize="end"
                    android:id="@+id/forward_moment_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:maxLines="2"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <com.p051p1.mobile.putong.feed.newui.preview.gesture.PlayerViewWithTransAnim
                        android:id="@+id/player_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <include
                        android:id="@+id/cover_for_kitkat"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        layout="@layout/moments_video_new_feed"/>
                </FrameLayout>
            </p151v.VLinear>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_extra_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
    <View
        android:id="@+id/divider"
        android:background="#d8d8d8"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterForwardVideoView>
