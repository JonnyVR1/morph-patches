<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.intlrenew.IntlRenewContractView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/core_intl_renew_privilege_dlg_bg"
    android:layout_width="311dp"
    android:layout_height="wrap_content"
    holder="intlrenew.IntlRenewContractView">
    <FrameLayout
        android:background="@drawable/core_intl_renew_privilege_dlg_top_bg"
        android:layout_width="match_parent"
        android:layout_height="225dp"/>
    <ImageView
        android:id="@+id/noif_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:src="0x7f080bea"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_323232"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="30dp"
        android:text="@string/INTL_VAS_CONTRACT_CALLBACK_TITLE"
        android:layout_below="@+id/noif_iv"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/core_color_66000000"
        android:gravity="center"
        android:id="@+id/describe_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="30dp"
        android:text="@string/INTL_VAS_CONTRACT_CALLBACK_TEXT"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"
        android:lineHeight="20sp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_F0F1F5"
        android:gravity="center"
        android:id="@+id/confirm_tv"
        android:background="@drawable/core_intl_renew_privilege_confirm_bt"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="24dp"
        android:text="@string/INTL_VAS_CONTRACT_CALLBACK_BTN1"
        android:layout_below="@+id/describe_tv"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/core_color_33000000"
        android:id="@+id/cancel_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/INTL_VAS_CONTRACT_CALLBACK_BTN2"
        android:layout_below="@+id/confirm_tv"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.core.p058ui.intlrenew.IntlRenewContractView>
