<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ccffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/music_id"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="music id"/>
    <TextView
        android:id="@+id/music_panel_name"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="music name"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:text="video_volume"/>
    <EditText
        android:id="@+id/music_panel_video_volume"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="50"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:text="music_volume"/>
    <EditText
        android:id="@+id/music_panel_music_volume"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="50"/>
    <com.p051p1.mobile.putong.feed.newui.camera.widget.MusicRangeSeekView
        android:id="@+id/music_panel_seek_view"
        android:layout_width="match_parent"
        android:layout_height="140dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <EditText
            android:gravity="center"
            android:id="@+id/music_panel_start_time"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="start time"
            android:layout_weight="1"/>
        <View
            android:layout_width="100dp"
            android:layout_height="match_parent"/>
        <EditText
            android:gravity="center"
            android:id="@+id/music_panel_stop_time"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="stop time"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/music_panel_ok"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="OK"/>
    <TextView
        android:gravity="center"
        android:id="@+id/music_panel_item_1"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="music1"/>
    <TextView
        android:gravity="center"
        android:id="@+id/music_panel_item_2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="music2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/music_panel_item_3"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="music3"/>
</LinearLayout>
