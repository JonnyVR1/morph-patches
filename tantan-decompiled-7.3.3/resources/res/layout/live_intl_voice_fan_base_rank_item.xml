<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="78dp">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/rank_image"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginLeft="10dp"/>
    <p151v.VText
        android:textSize="13dp"
        android:textColor="@color/live_white_50_opacity"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/rank_text"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white_90_opacity"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:maxWidth="148dp"
            android:maxLines="1"
            android:singleLine="true"/>
        <HorizontalScrollView
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tagsContainer"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/gender"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medal"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"/>
                <p151v.VText
                    android:textSize="11dp"
                    android:textColor="@color/live_white_50_opacity"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/member_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </HorizontalScrollView>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/right_desc_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="11dp"
            android:textColor="@color/live_white_50_opacity"
            android:gravity="center"
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_VOICE_FUN_CLUB_EXPERIENCE_POINTS"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="@color/live_white"
            android:layout_gravity="center"
            android:id="@+id/right_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/live_selector_intl_voice_fan_base_task_button_color"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/button"
        android:background="@drawable/live_selector_intl_voice_fan_base_task_button_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="78dp"/>
    <p151v.VCheckBox
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/check"
        android:background="@drawable/live_selector_intl_voice_fan_base_check_box"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:checked="false"
        android:button="@null"/>
</p151v.VLinear>
