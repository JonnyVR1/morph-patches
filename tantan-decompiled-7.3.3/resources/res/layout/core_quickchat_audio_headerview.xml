<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.QuickChatAudioHeaderView">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="217dp">
        <com.p051p1.mobile.putong.core.p058ui.quickaudio.view.DropDownBgView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:transitionName="share_element"/>
    </p151v.VFrame>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="top"
        android:id="@+id/svga_loading"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:scaleType="centerCrop"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga_hey_tips"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:minHeight="24dp"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/hey_pull"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter"/>
    <include
        android:id="@+id/scroll_view_state"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        layout="@layout/core_auto_scroll_view"/>
    <FrameLayout
        android:id="@+id/oof_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/txt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="300dp"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
    </FrameLayout>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/bottom_pull_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="下拉找到正在等你的人"/>
</merge>
