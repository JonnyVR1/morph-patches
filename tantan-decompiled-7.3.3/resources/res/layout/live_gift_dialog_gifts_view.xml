<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogGiftsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="268dp"
    folder="increment"
    holder="gift.view.GiftDialogGiftsView">
    <ImageView
        android:id="@+id/back_arrow"
        android:padding="9dp"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="0x7f0822c6"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_parent"
        app:layout_constraintEnd_toStartOf="@+id/tablayout_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tablayout_parent"/>
    <View
        android:id="@+id/back_arrow_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_parent"
        app:layout_constraintEnd_toStartOf="@+id/tablayout_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tablayout_parent"/>
    <View
        android:background="@drawable/live_shape_gift_dialog_tab_indicator_bg"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/tablayout_parent"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toStartOf="@+id/entranceView"
        app:layout_constraintStart_toEndOf="@+id/back_arrow"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="15dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:requiresFadingEdge="horizontal"
            android:paddingEnd="8dp"
            android:layout_marginStart="-15dp"
            app:tabBackground="@android:color/transparent"
            app:tabIndicator="@drawable/live_list_gift_dialog_tab_indicator"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorGravity="bottom"
            app:tabIndicatorHeight="3dp"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@android:color/transparent"/>
    </FrameLayout>
    <include
        android:id="@+id/entranceView"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tablayout_parent"
        app:layout_constraintTop_toTopOf="@+id/tablayout_parent"
        layout="@layout/live_gift_dialog_tab_entrance_view"/>
    <p151v.VPager
        android:id="@+id/pager"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tablayout_parent"/>
    <ViewStub
        android:id="@+id/netWorkError"
        android:layout="@layout/live_gift_dialog_content_network_error_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pager"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogGiftsView>
