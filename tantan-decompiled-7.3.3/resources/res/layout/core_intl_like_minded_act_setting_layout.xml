<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VText
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.175"/>
    <com.p051p1.mobile.putong.core.view.banner.Banner
        android:id="@+id/banner"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.56"/>
    <com.p051p1.mobile.putong.core.view.banner.IndicatorView
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.74"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/start_btn"
        android:background="@drawable/core_intl_like_minded_start_btn_selector"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/INTL_SAME_SETTING_START_BTN"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.856"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="#26000000"
        android:gravity="center"
        android:id="@+id/later_btn"
        android:background="@drawable/core_intl_like_minded_btn_selector"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="18dp"
        android:text="@string/INTL_SAME_SETTING_CANCEL_BTN"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
