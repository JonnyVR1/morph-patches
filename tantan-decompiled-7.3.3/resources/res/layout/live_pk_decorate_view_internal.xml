<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkDecorateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    flatten="true"
    folder="recreation"
    holder="pk.view.LivePkDecorateView">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <p151v.VDraweeView
            android:id="@+id/left_image"
            android:layout_width="120dp"
            android:layout_height="42dp"/>
        <p151v.VDraweeView
            android:id="@+id/center_image"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            app:actualImageScaleType="fitXY"/>
        <p151v.VDraweeView
            android:id="@+id/right_image"
            android:layout_width="120dp"
            android:layout_height="42dp"/>
    </LinearLayout>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/top_image"
        android:layout_width="135dp"
        android:layout_height="42dp"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkDecorateView>
