<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.bullet.DefaultBulletView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:background="@drawable/live_shape_ff3a00_gradient_r12"
    android:paddingTop="2.5dp"
    android:paddingBottom="2.5dp"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:layout_marginTop="29dp"
    android:layout_marginBottom="10dp"
    android:paddingStart="8dp"
    android:paddingEnd="5dp"
    android:layout_marginStart="10dp"
    flatten="true"
    folder="increment"
    holder="bullet.DefaultBulletView">
    <p151v.VDraweeView
        android:id="@+id/startIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:ellipsize="marquee"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="212dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/startIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VMarqueeText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:ellipsize="marquee"
        android:id="@+id/marqueeContent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="212dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/startIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/content"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="0x7f0824b9"/>
</com.p051p1.mobile.putong.live.livingroom.increment.bullet.DefaultBulletView>
