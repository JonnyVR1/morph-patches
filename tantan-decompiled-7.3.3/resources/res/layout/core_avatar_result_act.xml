<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="verification.remind.result.AvatarResultViewModel">
    <p151v.VImage
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="375dp"
        android:scaleType="centerCrop"/>
    <p151v.VScroll
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <View
                android:id="@+id/top_view"
                android:layout_width="match_parent"
                android:layout_height="218dp"/>
            <p151v.VFrame
                android:layout_gravity="center_horizontal"
                android:id="@+id/avatar_top"
                android:layout_width="258dp"
                android:layout_height="178dp">
                <p151v.VImage
                    android:id="@+id/avatar_bg_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/avatar_img"
                    android:layout_width="130dp"
                    android:layout_height="161dp"
                    fresco:actualImageScaleType="centerCrop"
                    fresco:roundBottomLeft="true"
                    fresco:roundBottomRight="true"
                    fresco:roundTopLeft="true"
                    fresco:roundTopRight="true"
                    fresco:roundedCornerRadius="10dp"/>
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/status_img"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="0dp"/>
            </p151v.VFrame>
            <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                android:textSize="22dp"
                android:textColor="@color/common_000000_80"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/status_title"
                android:layout_width="wrap_content"
                android:layout_height="31dp"
                android:layout_marginTop="15dp"/>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/common_000000_40"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/status_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="40dp"/>
            <View
                android:id="@+id/line_view"
                android:background="#05000000"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="40dp"/>
            <p151v.VFrame
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="0dp"
                android:layout_marginBottom="40dp"/>
        </p151v.VLinear>
    </p151v.VScroll>
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/action_btn"
        android:background="@drawable/common_button_btn_orange_large"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="继续探索"/>
    <p151v.VImage
        android:id="@+id/close_btn"
        android:padding="8dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/core_avatar_result_close_ic"
        android:scaleType="centerInside"/>
    <p151v.VButton
        android:layout_gravity="right"
        android:id="@+id/debug_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="debug"/>
</p151v.VFrame>
