<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.intlPrivilege.IntlPrivilegeCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="13dp"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    holder="vip.intlPrivilege.IntlPrivilegeCard">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="84dp"
        android:layout_alignParentBottom="true"
        flatten="true">
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/user_privilege"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:lines="2"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="11sp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.vip.intlPrivilege.IntlPrivilegeCard>
