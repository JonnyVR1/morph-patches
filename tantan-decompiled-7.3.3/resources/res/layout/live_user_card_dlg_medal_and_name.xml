<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.usercard.view.UserCardMedalAndNameView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="common"
    holder="usercard.view.UserCardMedalAndNameView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.p051p1.mobile.putong.live.livingroom.royal.LiveGradientTextView
            android:textSize="18sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="7"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="7"
            android:layout_marginStart="5dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/sex"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ll_fans_distance"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/tv_user_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/grade_module"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_50_opacity"
            android:id="@+id/fans_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/grade_module"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </p151v.VLinear>
    <HorizontalScrollView
        android:layout_gravity="center"
        android:scrollbars="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="10dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginBottom="20dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@+id/view_group_medals"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            flatten="true">
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/constellation"
                android:background="@drawable/live_bg_white_r5_a10"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/age_with_gender"
                android:paddingLeft="2dp"
                android:paddingTop="0.5dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp">
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/vip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_5"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </HorizontalScrollView>
</com.p051p1.mobile.putong.live.livingroom.common.usercard.view.UserCardMedalAndNameView>
