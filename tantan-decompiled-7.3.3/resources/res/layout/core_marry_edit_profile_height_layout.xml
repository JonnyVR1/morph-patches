<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.height.MarryEditProfileHeightViewModel"
    innerClass="true">
    <p151v.VRelative
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/first_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            aigestudio:typeface="medium"
            style="@style/marry_loop_edit_title_text"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="填写后可在个人资料页继续编辑"
            android:layout_below="@+id/first_title"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="7sp"/>
        <p151v.VFrame
            android:id="@+id/layout"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="67dp"
            android:layout_below="@+id/first_title"
            android:paddingHorizontal="40dp"
            flatten="true">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/core_profile_pick_middle_bg"
                android:layout_width="match_parent"
                android:layout_height="56dp"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.WheelPicker
                android:layout_gravity="center"
                android:id="@+id/main_wheel_center_left"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                aigestudio:wheel_atmospheric="true"
                aigestudio:wheel_curtain="false"
                aigestudio:wheel_curved="true"
                aigestudio:wheel_cyclic="false"
                aigestudio:wheel_item_text_color="#d0d0d0"
                aigestudio:wheel_selected_item_text_color="#e6000000"
                aigestudio:wheel_visible_item_count="5"/>
        </p151v.VFrame>
    </p151v.VRelative>
</FrameLayout>
