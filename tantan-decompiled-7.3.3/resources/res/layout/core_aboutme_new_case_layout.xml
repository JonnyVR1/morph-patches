<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.view.AboutMeNewCaseLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="view.AboutMeNewCaseLayout">
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#33000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/guide_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_guide"
        android:background="@drawable/core_marry_edit_input_stencil_bg"
        android:paddingLeft="16dp"
        android:paddingTop="20dp"
        android:paddingRight="16dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp">
        <p151v.VLinear
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/avatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginRight="8dp"
                app:roundAsCircle="true"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="14sp"
                    android:textColor="@color/common_black_80"
                    android:ellipsize="end"
                    android:id="@+id/new_case_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#66000000"
                    android:id="@+id/sub_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <TextView
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:layout_gravity="end"
            android:id="@+id/example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.view.AboutMeNewCaseLayout>
