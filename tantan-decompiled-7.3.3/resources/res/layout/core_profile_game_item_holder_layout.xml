<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    flatten="false"
    holder="profile.profilelist.itemholders.ProfileGameItemHolder">
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="18sp"
        android:textColor="#cc000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="游戏日常"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowView
        android:id="@+id/game_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/screenshots"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        flatten="false">
        <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.view.ProfileItemImageView
            android:id="@+id/screenshot_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.view.ProfileItemImageView
            android:id="@+id/screenshot_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.view.ProfileItemImageView
            android:id="@+id/screenshot_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
    </p151v.VLinear>
</p151v.VLinear_Dividers>
