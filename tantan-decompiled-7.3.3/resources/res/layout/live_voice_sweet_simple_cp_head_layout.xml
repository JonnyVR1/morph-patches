<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetCpSimpleHeadView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="0x7f08280e"
    android:layout_width="168dp"
    android:layout_height="60dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetCpSimpleHeadView">
    <p151v.VImage
        android:id="@+id/heart_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="0x7f082826"
        android:layout_centerHorizontal="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_left"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:layout_toLeftOf="@+id/heart_iv"
        android:layout_centerVertical="true"
        app:roundAsCircle="true"
        app:roundingBorderColor="#ffffff"
        app:roundingBorderWidth="1dp"/>
    <p151v.VImage
        android:id="@+id/left_default"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="6dp"
        android:src="0x7f082785"
        android:layout_toLeftOf="@+id/heart_iv"
        android:layout_centerVertical="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:layout_toRightOf="@+id/heart_iv"
        android:layout_centerVertical="true"
        app:roundAsCircle="true"
        app:roundingBorderColor="#ffffff"
        app:roundingBorderWidth="1dp"/>
    <p151v.VImage
        android:id="@+id/right_default"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:src="0x7f082785"
        android:layout_toRightOf="@+id/heart_iv"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetCpSimpleHeadView>
