<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemReceiveLikeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/tf_rect_light"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemReceiveLikeView">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/image_layout"
        android:clipChildren="false"
        android:layout_width="79dp"
        android:layout_height="67dp"
        flatten="true">
        <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
            android:layout_gravity="center"
            android:id="@+id/image_big"
            android:clickable="false"
            android:layout_width="66dp"
            android:layout_height="66dp"/>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/unread_layout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VImage
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/core_unread_dot"
                android:background="@drawable/core_kankan_red_dot_bg"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/unread_text_layout"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            flatten="true">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/unread_text_icon"
                android:background="@drawable/core_bg_conversation_unread"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="24dp"
                android:text="1"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="好友动态"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
    </LinearLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/core_color_4d000000"
            android:layout_gravity="right"
            android:id="@+id/look_over"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/subtitle_red_dot"
            android:background="@drawable/core_conversation_num_red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemReceiveLikeView>
