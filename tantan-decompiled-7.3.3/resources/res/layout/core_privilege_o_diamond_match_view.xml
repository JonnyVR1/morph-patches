<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeODiamondMatchView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="purchase.privilege.PrivilegeODiamondMatchView">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/avatar_right"
        android:background="0x7f081253"
        android:padding="4dp"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="9dp"
        android:layout_marginRight="-40dp"
        app:actualImageScaleType="centerCrop"
        app:roundAsCircle="true"/>
    <p151v.AutoVDraweeView
        android:layout_gravity="center"
        android:id="@+id/avatar_left"
        android:background="0x7f081253"
        android:padding="4dp"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginLeft="-40dp"
        android:layout_marginTop="9dp"
        app:actualImageScaleType="centerCrop"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginBottom="24dp"
        android:src="0x7f081254"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeODiamondMatchView>
