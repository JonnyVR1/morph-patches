<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetCpLimitItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.sweet.view.item.VoiceSweetCpLimitItemView">
    <p151v.VDraweeView
        android:id="@+id/house_drawee_view"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/locked_layout"
        android:background="@drawable/live_shape_voice_sweet_cp_lock_bg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="70dp"
        android:layout_centerHorizontal="true">
        <p151v.VImage
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="11dp"
            android:src="0x7f082834"
            android:scaleType="fitXY"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="11dp"
            android:text="@string/LIVE_VOICE_INTL_PART2"
            android:fontFamily="PingFangSC-Regular"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/time_layout"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/house_drawee_view"
        android:layout_centerHorizontal="true"
        flatten="true">
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/live_fc3d70"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <include
            android:id="@+id/time_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            layout="@layout/live_voice_sweet_time_view_layout"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.item.VoiceSweetCpLimitItemView>
