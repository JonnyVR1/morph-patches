<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VEditText
            android:textSize="16dp"
            android:textColor="@color/common_exp_black_01"
            android:textColorHint="@color/common_exp_black_03"
            android:gravity="top|left"
            android:id="@+id/edit_view"
            android:background="@drawable/exp_profile_loop_text_type_bg"
            android:paddingLeft="20dp"
            android:paddingTop="22dp"
            android:paddingRight="20dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ff6464"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/fail_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"/>
    <FrameLayout
        android:id="@+id/example_layout"
        android:background="@drawable/core_bg_r10_08000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp">
            <p151v.VImage
                android:background="0x7f0807c6"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="13dp"
                android:textColor="@color/common_exp_black_03"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="4dp"
                android:text="参考模板"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="13dp"
            android:textColor="@color/common_black_03"
            android:id="@+id/example_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="42dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="3dp"/>
    </FrameLayout>
</p151v.VLinear>
