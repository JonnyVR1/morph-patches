<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="0x7f080fdb"
        android:layout_marginStart="40dp"/>
    <p151v.VText
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_80"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.86dp"
        android:text="以图换图"
        android:lineSpacingExtra="8dp"
        android:layout_marginStart="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_000000_20"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="40dp"
        android:text="发出或收到该模式下的图片，另一方必须也回复一张图片才能进行查看"
        android:maxLines="2"
        android:lineSpacingExtra="2dp"/>
</p151v.VLinear>
