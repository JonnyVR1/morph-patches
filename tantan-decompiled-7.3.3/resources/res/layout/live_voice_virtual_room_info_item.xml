<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.VoiceVirtualRoomInfoTitleItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    flatten="true"
    holder="virtual.roomInfo.view.VoiceVirtualRoomInfoTitleItem">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/VOICE_VIRTUAL_ROOM_INFO_DIALOG_NAME"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/name_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginStart="96dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/go_arrow"
        app:layout_constraintStart_toEndOf="@+id/title_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="20dp"/>
    <p151v.VImage
        android:id="@+id/go_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f082858"
        android:scaleType="centerCrop"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="20dp"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.VoiceVirtualRoomInfoTitleItem>
