<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="140dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#33000000"
        android:gravity="center"
        android:id="@+id/tint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:text="平台无法100%核验对方信息真实性，请注意交友风险，如遇虚假信息请举报"
        android:layout_marginHorizontal="16dp"/>
    <p151v.VLinear
        android:layout_gravity="center"
        android:id="@+id/report"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08121c"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#dcdcdc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="举报 "
            android:layout_marginStart="12dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="12sp"
            android:textColor="#dcdcdc"
            android:id="@+id/report_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:layout_marginEnd="12dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08121c"/>
    </p151v.VLinear>
</p151v.VLinear>
