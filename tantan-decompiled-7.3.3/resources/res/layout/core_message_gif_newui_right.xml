<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.message.ItemGiftMessageRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    flatten="true"
    holder="gift.message.ItemGiftMessageRight"
    style="@style/core_gift_oldmsg_item">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_msg_bg_radius_10_f9f9f9"
        android:padding="16dp"
        android:visibility="visible"
        android:layout_width="256dp"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/gift_icon"
                android:background="@drawable/core_bg_10_ffffff"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:failureImage="0x7f0808ac"
                app:placeholderImage="0x7f0808ac"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                    android:textSize="15sp"
                    android:textColor="#cc000000"
                    android:id="@+id/gift_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="为你精心挑选了一件礼品"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:id="@+id/value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.gift.message.ItemGiftMessageRight>
