<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.log.SelectLogTimeAct">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:src="0x7f08200b"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#757575"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="49dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="49dp"
        android:text="使用探探中如发生功能异常或者闪退等问题，请上传日志帮助我们更好地定位和解决问题。"
        android:lineSpacingExtra="3dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#757575"
        android:gravity="center"
        android:id="@+id/select_time"
        android:background="@drawable/bg_upload_log_time"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="37dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="37dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/upload"
        android:background="@drawable/bg_upload_file_button"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="37dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="37dp"
        android:text="上传日志"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#bdbdbd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="37dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="37dp"
        android:text="日志中仅包含所选时间段内探探的故障记录、技术数据及其他必须的系统信息，不包含聊天记录等信息。"
        android:lineSpacingMultiplier="1.1"/>
</LinearLayout>
