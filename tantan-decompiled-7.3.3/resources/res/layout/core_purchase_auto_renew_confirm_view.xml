<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.PurchaseAutoRenewConfirmView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.PurchaseAutoRenewConfirmView">
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="0x7f081844"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="32dp"
        android:text="确认开通"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="我已阅读并同意《会员及自动续费协议》，\10 确认开通该服务"
        android:includeFontPadding="false"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="22dp"/>
    <p151v.VButton
        android:ellipsize="end"
        android:id="@+id/confirm_button"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:text="继续开通"
        android:lines="1"
        android:layout_below="@+id/sub_title"
        android:layout_marginHorizontal="32dp"
        style="@style/common_button_large_01"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.PurchaseAutoRenewConfirmView>
