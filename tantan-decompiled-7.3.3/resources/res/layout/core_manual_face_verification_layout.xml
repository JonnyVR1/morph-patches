<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="verification.ManualFaceVerificationViewModel">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:src="0x7f080d9d"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/core_gray_212121"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/SECURITY_AVATAR_VERIFICATION_ALTERNATIVE_SERVICE_READING_TIPS"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <TextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/num1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/num2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"/>
        <TextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/num3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"/>
        <TextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/num4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:padding="-20dp"
        android:layout_width="312dp"
        android:layout_height="312dp"
        android:layout_marginTop="33dp"
        android:foreground="@drawable/core_manual_pic_verification_bg"
        app:cardCornerRadius="156dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true">
        <SurfaceView
            android:layout_gravity="center"
            android:id="@+id/preview"
            android:layout_width="312dp"
            android:layout_height="312dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bg"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:src="#e9e9e9"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_marginTop="20dp"
            android:src="0x7f080d9e"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="16sp"
        android:textColor="#6b6c6c"
        android:layout_gravity="center"
        android:id="@+id/tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"/>
</LinearLayout>
