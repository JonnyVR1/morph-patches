<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogBottomBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    folder="increment"
    holder="gift.view.GiftDialogBottomBar">
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogIndicator
        android:gravity="center_vertical"
        android:id="@+id/indicator"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:fillColor="@color/live_white_60_opacity"
        app:gift_indicator_radius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pageColor="@color/live_white_10_opacity"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white_50_opacity"
        android:gravity="center_vertical"
        android:id="@+id/records"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/LIVE_GIFT_BILL"
        android:lines="1"
        android:layout_centerVertical="true"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/recharge_start_icon"
        android:background="0x7f0822cb"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/charge"
        app:layout_constraintEnd_toStartOf="@+id/charge"
        app:layout_constraintTop_toTopOf="@+id/charge"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/live_ff8817"
        android:gravity="center"
        android:id="@+id/charge"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/LIVE_GIFT_RECHARGE"
        android:lines="1"
        android:drawableEnd="0x7f0822ca"
        android:paddingStart="4dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/live_first_recharge_svga"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_first_recharge"
        app:layout_constraintEnd_toEndOf="@+id/live_first_recharge"
        app:layout_constraintStart_toStartOf="@+id/live_first_recharge"
        app:layout_constraintTop_toTopOf="@+id/live_first_recharge"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_ff8817"
        android:gravity="center"
        android:id="@+id/live_first_recharge"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="@string/LIVE_GIFT_DIALOG_FIRST_RECHARGE_TEXT"
        android:lines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/first_recharge_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_first_recharge,live_first_recharge_svga"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftDialogBottomBar>
