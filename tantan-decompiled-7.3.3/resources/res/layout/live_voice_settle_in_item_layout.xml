<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.membermanager.settlein.MemberManagerSettleItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="voice.membermanager.settlein"
    holder="MemberManagerSettleItemView">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonAnimMaskAvatarView
        android:id="@+id/user_icon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="100dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/cancel_bt"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintStart_toStartOf="@+id/user_name"
        app:layout_constraintTop_toBottomOf="@+id/user_name">
        <View
            android:id="@+id/user_sex"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/user_tag"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="6dp"/>
        <p151v.VDraweeView
            android:id="@+id/level"
            android:layout_width="30dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            app:actualImageScaleType="fitXY"/>
        <p151v.VDraweeView
            android:id="@+id/starlight"
            android:layout_width="30dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            app:actualImageScaleType="fitXY"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/cancel_bt"
        android:background="@drawable/live_bg_white_r10_a05"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="拒绝"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/confirm_bt"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/confirm_bt"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="同意"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/call_bt"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="0dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@drawable/live_selector_voice_ktv_choose_song_bt_text_color"
        android:gravity="center"
        android:id="@+id/call_bt"
        android:background="@drawable/live_selector_voice_ktv_choose_song_bt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.membermanager.settlein.MemberManagerSettleItemView>
