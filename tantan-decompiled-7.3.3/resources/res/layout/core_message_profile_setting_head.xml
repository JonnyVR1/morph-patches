<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.model.view.MessageNewProfileSettingHead xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/head"
    android:layout_width="match_parent"
    android:layout_height="206.5dp"
    flatten="true"
    holder="messages.model.view.MessageNewProfileSettingHead">
    <FrameLayout
        android:id="@+id/profile_image_verfication"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/profile_image"
            android:layout_marginTop="16dp"
            app:foreground="@color/transparent"
            style="@style/message_profile_item_image"/>
        <com.p051p1.mobile.putong.core.p058ui.view.GradientBgButton
            android:layout_gravity="bottom|right"
            android:id="@+id/match_from"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerInside"
            app:iconWidth="6dp"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/profile_image_verfication"
        android:layout_centerHorizontal="true">
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:text=""
            android:maxLines="1"
            android:drawablePadding="4dp"
            app:enableEmojis="true"
            app:typeface="medium"/>
        <p151v.VImage
            android:id="@+id/avatar_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.model.view.MessageNewProfileSettingHead>
