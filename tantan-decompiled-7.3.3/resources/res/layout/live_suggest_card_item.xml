<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <com.p051p1.mobile.putong.live.external.page.swipecard.SpecialAvatarLayout
        android:id="@+id/avatar_layout"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.4"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:id="@+id/avatar_real"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundAsCircle="true"/>
    </com.p051p1.mobile.putong.live.external.page.swipecard.SpecialAvatarLayout>
    <android.widget.Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"/>
    <FrameLayout
        android:id="@+id/svga_container"
        android:background="@drawable/live_bg_fff5ef_r8"
        android:layout_width="25dp"
        android:layout_height="16dp"
        app:layout_constraintEnd_toEndOf="@+id/avatar_layout"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"
        app:layout_constraintTop_toBottomOf="@+id/space">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/svga"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:scaleType="fitXY"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
