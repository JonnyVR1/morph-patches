<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rTopLeftRadius="20dp"
    app:rTopRightRadius="20dp"
    flatten="true"
    holder="intloperation.campingactivity.IntlCampingActivityDlg">
    <p151v.VDraweeView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:layout_constraintDimensionRatio="h,375:475"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <p151v.VDraweeView
        android:id="@+id/title_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="28dp"
        app:actualImageScaleType="fitCenter"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:layout_constraintDimensionRatio="h,132:104"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.352"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <p151v.VDraweeView
        android:id="@+id/activity_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="10dp"
        app:actualImageScaleType="fitCenter"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:layout_constraintDimensionRatio="h,181:166"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.483"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <ImageView
        android:id="@+id/bt_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="18dp"
        android:src="0x7f080a71"
        android:scaleType="centerCrop"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#94000000"
        android:gravity="start"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="37dp"
        android:layout_marginBottom="140dp"
        android:layout_below="@+id/image_container"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_icon"/>
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/bt"
        android:background="#35af6d"
        android:layout_width="276dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="50dp"
        android:text="@string/INTL_ACTIVITIES_PETS_SHOW_CLICK"
        android:layout_below="@+id/desc"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rRadius="16dp"/>
</com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundConstraintLayout>
