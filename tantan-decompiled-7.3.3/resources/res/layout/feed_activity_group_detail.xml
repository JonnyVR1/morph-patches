<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="group.groupdetail.actRender.FeedGroupDetailViewHolder">
    <p151v.VDraweeView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="36dp">
        <TextView
            android:id="@+id/back"
            android:background="0x7f080387"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="12dp"
            android:layout_alignTop="@+id/join"/>
        <TextView
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:id="@+id/navigation_name"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/back"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#80000000"
            android:gravity="center_vertical"
            android:id="@+id/join"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="0sp"
            android:letterSpacing="0"
            app:tabRippleColor="@android:color/transparent"/>
    </RelativeLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        flatten="true">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            flatten="true">
            <RelativeLayout
                android:id="@+id/header"
                android:paddingBottom="22dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll"
                flatten="true">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:paddingTop="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="1"
                    android:lineSpacingExtra="0sp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:id="@+id/brief"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="2"
                    android:layout_below="@+id/title"
                    android:lineSpacingExtra="0sp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/heads"
                    android:paddingTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/brief"
                    flatten="true">
                    <FrameLayout
                        android:paddingLeft="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:id="@+id/head_container3"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginLeft="24dp"
                            flatten="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/head3"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/feed_fresco_profile_small_recommend"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/head_container2"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginLeft="12dp"
                            flatten="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/head2"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/feed_fresco_profile_small_recommend"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/head_container1"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            flatten="true">
                            <p151v.VDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/head1"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/feed_fresco_profile_small_recommend"/>
                        </FrameLayout>
                    </FrameLayout>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="#cc000000"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/people_brief"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="16dp"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:lineSpacingExtra="0sp"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/topic_content"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll"
                flatten="true">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:id="@+id/topic_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="3dp"
                    android:text="热聊话题"
                    android:lineSpacingExtra="0sp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/topic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="100dp"
                app:tabMinWidth="0dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="4dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/feed_e6000000"
                app:tabTextAppearance="@style/feedGroupTitleLayoutTextAppearance"
                app:tabTextColor="@color/common_grey_08"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/post"
        android:background="@drawable/feed_group_detail_bg"
        android:layout_width="165dp"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp">
        <View
            android:background="0x7f081ef9"
            android:layout_width="23dp"
            android:layout_height="23dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#e6ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="分享你的想法"/>
    </LinearLayout>
</FrameLayout>
