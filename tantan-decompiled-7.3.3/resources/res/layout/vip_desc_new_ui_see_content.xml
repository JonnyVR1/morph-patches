<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.result.SeeContent xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    holder="result.SeeContent">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp">
        <p151v.VFrame
            android:id="@+id/content_bg"
            android:background="@drawable/bg_privilege_desc"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            flatten="true">
            <p151v.VLinear
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/match"
                android:background="0x7f082ab0"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:layout_width="199dp"
                android:layout_height="227dp">
                <p151v.VText
                    android:textSize="9.7sp"
                    android:textColor="#757575"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="9dp"
                    android:text="@string/NAVIGATION_MATCHES"/>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:background="@drawable/bg_privilege_see_rec_corners"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_marginRight="11dp">
                    <p151v.VImage
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_margin="9dp"
                        android:src="0x7f082ab1"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/SEE_WHO_LIKED_ME_INTRO_TITLE"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="11dp">
                    <View
                        android:background="@drawable/bg_privilege_see_oval"
                        android:layout_width="23dp"
                        android:layout_height="23dp"/>
                    <p151v.VLinear
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp">
                        <View
                            android:background="#d8d8d8"
                            android:layout_width="53dp"
                            android:layout_height="7.6dp"/>
                        <View
                            android:background="#eeeeee"
                            android:layout_width="53dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"/>
                    </p151v.VLinear>
                </p151v.VLinear>
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="11dp">
                    <View
                        android:background="@drawable/bg_privilege_see_oval"
                        android:layout_width="23dp"
                        android:layout_height="23dp"/>
                    <p151v.VLinear
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp">
                        <View
                            android:background="#d8d8d8"
                            android:layout_width="53dp"
                            android:layout_height="7.6dp"/>
                        <View
                            android:background="#eeeeee"
                            android:layout_width="53dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"/>
                    </p151v.VLinear>
                </p151v.VLinear>
            </p151v.VLinear>
            <p151v.VLinear
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/likers"
                android:background="0x7f082ab0"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="224dp"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="#4a4a4a"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="9dp"
                    android:text="@string/MATCH_LIST_SEE_WHO_LIKED_ME"/>
                <p151v.VImage
                    android:id="@+id/ic_see_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f082041"/>
            </p151v.VLinear>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/description"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.result.SeeContent>
