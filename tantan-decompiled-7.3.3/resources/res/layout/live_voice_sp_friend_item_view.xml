<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.userCard.p068cp.VirtualVoiceSpFriendItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="virtual.userCard.cp"
    holder="VirtualVoiceSpFriendItemView">
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitXY"
        app:failureImage="0x7f08274d"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f08274d"/>
    <View
        android:id="@+id/user_icon_bg"
        android:background="@drawable/live_shape_round_1b1e2a_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintEnd_toEndOf="@+id/user_icon"
        app:layout_constraintStart_toStartOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VDraweeView
        android:id="@+id/user_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"
        app:roundedCornerRadius="100dp"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:text=""
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.userCard.p068cp.VirtualVoiceSpFriendItemView>
