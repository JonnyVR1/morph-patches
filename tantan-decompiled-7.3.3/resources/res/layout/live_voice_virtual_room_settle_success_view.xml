<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.settle.VoiceVirtualSettleSuccessView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="virtual.settle.VoiceVirtualSettleSuccessView">
    <View
        android:id="@+id/bg"
        android:background="@color/live_black_40_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="287dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="21sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_VOICE_NEWCOMER_TASK_RESULT_TITLE"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white_60_opacity"
            android:gravity="center"
            android:id="@+id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/VOICE_VIRTUAL_ROOM_SETTLE_SUCCESS_SUMMARY"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.settle.VoiceVirtualSettleSuccessView>
