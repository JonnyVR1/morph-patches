<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="18dp"
        android:text="@string/VERIFICATION_POPUP_FORCE_TITLE"
        android:maxLines="2"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/popup_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="14dp"
        android:lineSpacingExtra="1.7dp"/>
    <LinearLayout
        android:id="@+id/checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="1.5dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:layout_below="@+id/num_error"
        flatten="true">
        <p151v.VCheckBox
            android:id="@+id/check"
            android:background="@drawable/core_checkbox_bg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="1.5dp"
            android:button="@null"
            android:layout_marginEnd="6dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_33000000"
            android:id="@+id/reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:lineSpacingExtra="1.8dp"/>
    </LinearLayout>
    <p151v.VButton
        android:ellipsize="end"
        android:id="@+id/popup_positive_btn"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="-2dp"
        android:layout_marginRight="32dp"
        android:text="@string/VERIFICATION_CENTER_VERIFICATION_TYPE_DEFAULT_NEW"
        android:lines="1"
        style="@style/common_button_large_01"/>
    <p151v.VButton
        android:textColor="@color/common_grey_03"
        android:ellipsize="end"
        android:id="@+id/popup_change_avatar_btn"
        android:background="@drawable/common_button_btn_gray_small"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/PROFILE_FAKE_ALERT_ACTION"
        android:lines="1"
        style="@style/common_button_large_01"/>
</LinearLayout>
