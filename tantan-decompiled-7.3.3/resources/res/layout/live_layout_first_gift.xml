<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkFirstGiftView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="recreation"
    holder="pk.view.PkFirstGiftView">
    <View
        android:id="@+id/first_gift_bg"
        android:background="@drawable/live_shape_pk_first_gift_icon_bg"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/first_gift_anim"
        android:layout_width="30dp"
        android:layout_height="46dp"
        app:layout_constraintBottom_toBottomOf="@+id/first_gift_bg"
        app:layout_constraintLeft_toLeftOf="@+id/first_gift_bg"
        app:layout_constraintRight_toRightOf="@+id/first_gift_bg"/>
    <p151v.VDraweeView
        android:id="@+id/first_gift_image"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:actualImageScaleType="centerCrop"
        app:failureImageScaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/first_gift_bg"
        app:layout_constraintLeft_toLeftOf="@+id/first_gift_bg"
        app:layout_constraintRight_toRightOf="@+id/first_gift_bg"
        app:layout_constraintTop_toTopOf="@+id/first_gift_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/first_gift_text"
        android:background="@drawable/live_bg_black_r6_a50"
        android:paddingLeft="2dp"
        android:paddingTop="1dp"
        android:paddingRight="2dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minWidth="28dp"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_gift_bg"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkFirstGiftView>
