<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="60dp"
    android:layout_height="wrap_content"
    attachToRoot="true"
    flatten="true"
    folder="newui"
    holder="view.boost.holder.ButtonBoostViewHolder">
    <com.p051p1.mobile.putong.core.p058ui.home.BounceButton
        android:layout_gravity="center"
        android:id="@+id/boost_button"
        android:tag="boost"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerInside"
        app:centerIcon="0x7f081f9a"
        app:centerIconWidth="22dp"
        app:originWidth="60dp"/>
    <FrameLayout
        android:id="@+id/boost_circle"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignTop="@+id/boost_button"
        android:layout_alignBottom="@+id/boost_button"
        android:layout_centerInParent="true"
        android:layout_alignStart="@+id/boost_button"
        android:layout_alignEnd="@+id/boost_button"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.boost.view.OverlapCircleView
            android:layout_gravity="center"
            android:id="@+id/boost_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:borderWidth="0dp"
            app:clockwise="true"
            app:customProgressWidth="5dp"
            app:hasProgress="true"
            app:innerBorderWidth="0dp"
            app:progressColor="#fe7fb1"
            app:progressEndColor="#ef58e0"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#f53087"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/boost_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="6.5x"/>
    </FrameLayout>
</merge>
