<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.toppicks.TopPicksItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/liked_user_item_info_bg"
    android:padding="0.5dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    app:rRadius="10dp"
    holder="toppicks.TopPicksItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bg"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:layout_width="match_parent"
        android:layout_height="93dp"/>
    <p151v.VImage
        android:layout_gravity="bottom|right"
        android:id="@+id/instant_match_btn"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="52dp"
        app:srcCompat="0x7f080d3a"/>
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_margin="8dp">
        <p151v.VRelative
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#b3ffffff"
                android:ellipsize="end"
                android:id="@+id/info_first_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_above="@+id/info_second_line"
                android:layout_marginEnd="8dp"
                android:layout_alignParentStart="true"
                app:typeface="medium"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_toStartOf="@+id/action_btn"
                android:layout_alignParentStart="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#e6ffffff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/info_second_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="20dp"
                    android:lines="1"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#e6ffffff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/info_second_line_age"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="20dp"
                    android:lines="1"
                    android:layout_marginEnd="8dp"
                    app:typeface="medium"/>
            </p151v.VLinear>
        </p151v.VRelative>
        <p151v.VImage
            android:id="@+id/action_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
    </p151v.VLinear>
    <p151v.VRelative
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/active_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:typeface="medium"/>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundTextView
            android:textSize="12sp"
            android:textColor="#fffa8a"
            android:gravity="center"
            android:id="@+id/chat_master"
            android:background="#fe8900"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_VAS_LABLE_TEXT_PICKS"
            android:drawablePadding="4dp"
            android:drawableStart="0x7f081892"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            app:rBottomRightRadius="10dp"
            app:rTopLeftRadius="10dp"
            app:typeface="medium"/>
        <p151v.VImage
            android:id="@+id/verification_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.toppicks.TopPicksItemView>
