<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base"
    android:layout_width="match_parent"
    android:layout_height="190dp">
    <View
        android:id="@+id/match_card_female"
        android:background="0x7f080dd2"
        android:layout_width="340dp"
        android:layout_height="130dp"
        android:translationZ="-2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/match_head_me"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="2dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/match_card_female"
        app:layout_constraintRight_toRightOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/match_card_female"
        app:placeholderImage="@color/common_white"
        app:roundAsCircle="true"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.29"/>
    <p151v.VDraweeView
        android:id="@+id/match_head_other_preView"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="2dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="@+id/match_head_other"
        app:layout_constraintTop_toTopOf="@+id/match_head_other"
        app:roundAsCircle="true"/>
    <p151v.VDraweeView
        android:id="@+id/match_head_other"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="2dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/match_card_female"
        app:layout_constraintLeft_toLeftOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/match_card_female"
        app:roundAsCircle="true"/>
    <FrameLayout
        android:id="@+id/pic_icon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/match_head_other"
        app:layout_constraintRight_toRightOf="@+id/match_head_other">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/pic_icon_outer"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f0805eb"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/pic_icon_inner"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="0x7f0805ea"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <View
        android:id="@+id/online"
        android:background="@drawable/core_free_trial_online"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/match_head_other"
        app:layout_constraintRight_toRightOf="@+id/match_head_other"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/common_normal_title"
        android:gravity="center_vertical"
        android:id="@+id/match_title"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginBottom="1dp"
        android:text="@string/MATCH_NOTIFICATION_FEMALE_HIDDEN_TITLE"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_horizontal"
        app:layout_constraintLeft_toRightOf="@+id/match_head_other"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/guideline_horizontal"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/match_card_female"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/match_card_female"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_normal_title"
        android:id="@+id/match_describe"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/match_head_other"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"/>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svga_bg"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:translationZ="2dp"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
