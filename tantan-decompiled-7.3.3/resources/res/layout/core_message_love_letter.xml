<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.view.ItemLoveLetterMessage xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.view.ItemLoveLetterMessage">
    <com.p051p1.mobile.putong.core.p058ui.messages.view.LoveLetterView
        android:id="@+id/frame_default"
        android:background="0x7f080d74"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                app:srcCompat="0x7f080d7a"/>
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="16sp"
                    android:textColor="@color/common_black_80"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="给你写了一封情书"
                    android:letterSpacing="0.08"
                    app:lineHeight="22dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#fe5f1d"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="轻触打开"
                    android:letterSpacing="0.08"
                    app:lineHeight="20dp"/>
            </p151v.VLinear>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                app:srcCompat="0x7f080d7b"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.p058ui.messages.view.LoveLetterView>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/frame_opened"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:background="@drawable/core_love_letter_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VLinear
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp">
                <p151v.VText
                    android:textSize="14dp"
                    android:textColor="#66000000"
                    android:gravity="center_vertical"
                    android:id="@+id/receiver_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:text="To（   黄雨萱黄雨萱...   ）"/>
                <com.p051p1.mobile.putong.core.view.LetterTextView
                    android:textSize="16sp"
                    android:textColor="@color/common_black_80"
                    android:textColorHint="#33000000"
                    android:id="@+id/edit_text"
                    android:background="@null"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:maxLength="200"
                    android:lineHeight="42dp"/>
                <p151v.VText
                    android:textSize="14dp"
                    android:textColor="#66000000"
                    android:gravity="center"
                    android:id="@+id/sender_name"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="By（   李子维   ）"/>
            </p151v.VLinear>
            <p151v.VImage
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="0x7f080d75"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="13dp"
            android:gravity="center_vertical"
            android:id="@+id/quick_reply"
            android:background="@drawable/core_love_letter_reply_bg"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="感谢他的心意"
            android:drawablePadding="3dp"
            android:drawableStart="0x7f080d85"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.view.ItemLoveLetterMessage>
