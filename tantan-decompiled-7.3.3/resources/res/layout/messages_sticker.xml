<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:paddingTop="?attr/message_page_sticker_padding_top"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemSticker
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        fresco:actualImageScaleType="fitCenter">
        <p151v.VDraweeView
            android:id="@+id/anim_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            fresco:actualImageScaleType="fitCenter"
            style="@style/core_im_fresco_base"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svga_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.p051p1.mobile.putong.core.p058ui.messages.ItemSticker>
</RelativeLayout>
