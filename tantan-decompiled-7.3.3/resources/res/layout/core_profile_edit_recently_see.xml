<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    flatten="true"
    holder="profile.profilelist.itemholders.EditProfileNewRecentlySeeItemHolder"
    style="@style/profile_item_frame_no_padding_new">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/my_literature_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的书影剧"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/my_literature_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08145e"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/add_tip"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="21dp"
        android:layout_marginRight="20dp"
        android:text="添加我的书影剧"
        android:layout_weight="2"
        android:drawableEnd="@drawable/core_profile_edit_data_right_add"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/interest_tip_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        flatten="false">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/interest_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="猜你感兴趣"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08145e"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"/>
</p151v.VLinear_Dividers>
