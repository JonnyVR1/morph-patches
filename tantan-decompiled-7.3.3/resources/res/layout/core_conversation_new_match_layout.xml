<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="messages.newMatch.NewMatchConversationListViewModel">
    <p151v.VRecyclerView
        android:orientation="horizontal"
        android:id="@+id/tab_list"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <p151v.VPullUpRecyclerView
        android:id="@+id/conv_list"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"/>
    <include layout="@layout/core_conversation_new_match_empty_layout"/>
</p151v.VFrame>
