<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.svip.SVIPRefundItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/common_white_01"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    holder="svip.SVIPRefundItemView">
    <TextView
        android:textSize="17sp"
        android:textStyle="normal"
        android:textColor="#212121"
        android:gravity="end"
        android:id="@+id/amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#757575"
        android:id="@+id/pre_symbol"
        android:layout_width="12dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="· "
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/product_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/product_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#757575"
        android:id="@+id/product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="2dp"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/product_time"
        app:layout_constraintLeft_toRightOf="@+id/pre_symbol"
        app:layout_constraintRight_toLeftOf="@+id/amount"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbdbd"
        android:id="@+id/product_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="8dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/amount"
        app:layout_constraintTop_toBottomOf="@+id/product_name"
        app:layout_constraintVertical_chainStyle="packed"/>
</com.p051p1.mobile.putong.core.p058ui.svip.SVIPRefundItemView>
