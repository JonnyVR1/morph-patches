<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/buttons_onebtn_match"
    android:background="@drawable/core_profile_buttons_onebtn_match_bg"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="3dp"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    flatten="true"
    holder="profile.holders.ProfileOneMatchButtons"
    needPublic="true">
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:id="@+id/buttons_onebtn_match_root"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/core_profile_bottom_btn_divider"
        android:showDividers="middle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_goneMarginLeft="0dp"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/like_and_dislike_refactor"
            android:paddingLeft="-10dp"
            android:paddingRight="-10dp"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_marginBottom="3dp"
            flatten="true">
            <p151v.VText
                android:id="@+id/superlike_popup"
                android:background="0x7f082982"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/btn_wrapper"
                android:layout_centerHorizontal="true"/>
            <p151v.VLinear
                android:id="@+id/btn_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                flatten="true">
                <p151v.VFrame_Shadow
                    android:id="@+id/dislike_shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/superlike_shadow"
                    android:layout_alignParentBottom="true"
                    app:sl_cornerRadius="80dp"
                    app:sl_dx="@dimen/core_profile_bottom_dx"
                    app:sl_dy="@dimen/core_profile_bottom_dy"
                    app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                    app:sl_shadowRadius="8dp"
                    flatten="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/dislike"
                        android:background="@drawable/core_newui_profile_btn_dislike_bg"
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <p151v.VImage
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="0x7f081217"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </p151v.VFrame_Shadow>
                <p151v.VFrame_Shadow
                    android:id="@+id/superlike_shadow"
                    android:background="@drawable/core_newui_profile_btn_superlike_bg"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerInParent="true"
                    app:sl_cornerRadius="90dp"
                    app:sl_dx="@dimen/core_profile_bottom_dx"
                    app:sl_dy="@dimen/core_profile_bottom_dy"
                    app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                    app:sl_shadowRadius="8dp"
                    flatten="true">
                    <p151v.VFrame_FlipContainer
                        android:layout_gravity="center"
                        android:id="@+id/superlike"
                        android:background="@drawable/core_newui_profile_btn_superlike_bg"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:mainChildIndex="0"
                        app:otherChildIndex="1"
                        flatten="true">
                        <p151v.VImage
                            android:layout_gravity="center"
                            android:id="@+id/superlike_btn"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="0x7f081219"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                        <p151v.VText
                            android:textSize="22sp"
                            android:textColor="#00adff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/superlike_turn_tv"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="32"
                            app:typeface="medium"/>
                    </p151v.VFrame_FlipContainer>
                </p151v.VFrame_Shadow>
                <p151v.VFrame_Shadow
                    android:id="@+id/like_shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/superlike_shadow"
                    android:layout_alignParentBottom="true"
                    app:sl_cornerRadius="90dp"
                    app:sl_dx="@dimen/core_profile_bottom_dx"
                    app:sl_dy="@dimen/core_profile_bottom_dy"
                    app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                    app:sl_shadowRadius="8dp"
                    flatten="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/like"
                        android:background="@drawable/core_newui_profile_btn_like_bg"
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <p151v.VImage
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="0x7f0820fb"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </p151v.VFrame_Shadow>
            </p151v.VLinear>
        </RelativeLayout>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/shadow_follow_change_like"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="15dp"
            android:elevation="1dp">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/superlike_shadow_follow_change_like"
                android:background="@drawable/core_vip_onebtn_match_exp2_superlike_bg"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f081219"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/like_shadow_follow_change_like"
                android:background="@drawable/core_newui_profile_btn_like_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f0820fb"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VFrame_Shadow
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/superlike_shadow_single"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:sl_cornerRadius="0dp"
            app:sl_dy="0dp"
            app:sl_shadowColor="#fff"
            app:sl_shadowRadius="0dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/superlike_shadow_single_bg"
                android:background="@drawable/core_vip_onebtn_match_exp2_superlike_bg"
                android:layout_width="132dp"
                android:layout_height="48dp"
                android:layout_marginBottom="15dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/superlike_shadow_single_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="20dp"
                    android:src="0x7f081219"
                    android:scaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/superlike_shadow_single_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:text="超级喜欢"/>
            </p151v.VLinear>
        </p151v.VFrame_Shadow>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/match"
            android:background="@drawable/core_vip_onebtn_match_exp2_bg"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:layout_marginBottom="15dp"
            android:elevation="1dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/match_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f08198f"
                android:scaleType="centerCrop"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.widget.LetterRemainingSwitcherView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/match_remaining_switch"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                app:contentTextBold="false"
                app:contentTextColor="#e8ca8a"
                app:contentTextSize="14sp"
                app:interval="2000"/>
        </p151v.VLinear>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
