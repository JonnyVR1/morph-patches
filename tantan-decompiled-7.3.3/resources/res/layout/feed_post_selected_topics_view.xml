<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/selected_header"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="group.dialog.insert.selecteditem.FeedPostSelectedHeader">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selected_title_cl"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_grey_09"
            android:id="@+id/selected_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/FEED_SELECTED_TOPIC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/selected_group_font_string"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="#c4c4c4"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/selected_group_font_string"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/selected_title"
            app:layout_constraintRight_toLeftOf="@+id/selected_group_back_string"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="#c4c4c4"
            android:ellipsize="end"
            android:id="@+id/selected_group_back_string"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/selected_group_font_string"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.apmem.tools.layouts.FlowLayout
        android:id="@+id/selected_topics"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="16dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_09"
        android:id="@+id/recommend_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/FEED_ADD_TOPIC_RECOMMEND"/>
</LinearLayout>
