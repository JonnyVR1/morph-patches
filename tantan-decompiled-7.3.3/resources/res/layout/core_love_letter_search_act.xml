<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="loveletter.search.LoveLetterSearchViewModel">
    <FrameLayout
        android:id="@+id/list_root"
        android:background="@color/common_white"
        android:paddingTop="51dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VRecyclerView
            android:id="@+id/search_list"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/search_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp">
            <p151v.VImage
                android:layout_width="210dp"
                android:layout_height="150dp"
                app:srcCompat="0x7f081649"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/common_light_01"
                android:id="@+id/no_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/SEARCH_RESULT_NONE"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_input_root"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="true">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/core_conv_search_input_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/input_bg_layout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="38dp"
                android:layout_marginRight="32dp"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.messages.emoji.VEditTextEmojiCompat
                    android:textSize="16sp"
                    android:textColor="@color/common_000000_80"
                    android:textColorHint="@color/common_000000_20"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/input_text"
                    android:background="@null"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:hint="@string/SEARCH_GUIDE"
                    android:singleLine="true"
                    android:maxLength="1000"
                    android:lineSpacingExtra="0.5dp"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/core_message_input_cursor"
                    app:enableEmojis="true"
                    app:typeface="regular"/>
            </FrameLayout>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/search_ic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="8dp"
                app:srcCompat="0x7f080756"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/close_ic"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                app:srcCompat="0x7f080fc6"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/common_grey_03"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/cancel_search"
            android:paddingLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/ACTION_CANCEL"/>
    </LinearLayout>
</FrameLayout>
