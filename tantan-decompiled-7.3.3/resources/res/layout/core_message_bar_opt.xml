<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.model.messagebar.MessageBarOpt xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/opti_bar_and_keyboard"
    android:background="@color/common_white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:showDividers="beginning"
    flatten="true"
    holder="messages.model.messagebar.MessageBarOpt">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/surface_view_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="@string/DIMENSION_RATIO"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.messages.model.messagebar.MessageSurfaceAnimContainer
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/surface_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/surface_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <LinearLayout
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:id="@+id/bar_mask_layer"
                        android:background="@drawable/core_message_bar_media_surface_bg"
                        android:layout_width="match_parent"
                        android:layout_height="102dp"
                        android:elevation="1dp"/>
                    <RelativeLayout
                        android:id="@+id/mask_layer"
                        android:background="@drawable/core_message_bar_media_masker_bg"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="0x7f080f61"
                            android:layout_centerInParent="true"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/core_message_bar_media_notice_bubble_bg"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/CAMERA_CANCEL_GUIDE"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </RelativeLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/filter_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:shadowColor="#4a000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"/>
                    <com.p051p1.mobile.putong.core.p058ui.messages.media.widget.FilterScrollMoreViewPager
                        android:id="@+id/change_filter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/common_orange"
                        android:gravity="center_vertical"
                        android:layout_gravity="end"
                        android:id="@+id/count_down_timer"
                        android:background="@drawable/core_message_bar_media_count_down_timer_bg"
                        android:paddingLeft="16dp"
                        android:visibility="gone"
                        android:layout_width="89dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:text="00:00"
                        android:layout_marginEnd="16dp"/>
                    <View
                        android:id="@+id/change_size"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/camera_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:src="0x7f080f68"
                        android:layout_marginEnd="16dp"/>
                    <ImageView
                        android:id="@+id/expand_btn"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:src="0x7f080f5e"
                        android:layout_marginStart="16dp"/>
                </FrameLayout>
            </com.p051p1.mobile.putong.core.p058ui.messages.model.messagebar.MessageSurfaceAnimContainer>
        </FrameLayout>
        <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageBarRootLayout
            android:id="@+id/message_bar_content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            flatten="true">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/input_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/reference_view"
                    android:paddingLeft="@dimen/core_message_bar_reference_padding_left"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/input_bar_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    flatten="true">
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:id="@+id/temp_input_layout"
                        android:visibility="gone"
                        android:layout_width="51dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        flatten="true">
                        <p151v.VText
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:id="@+id/temp_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <View
                            android:layout_gravity="bottom|center_horizontal"
                            android:id="@+id/temp_icon"
                            android:layout_width="31dp"
                            android:layout_height="30dp"
                            android:layout_marginBottom="6dp"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/input_root"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageInputEditRootLayout
                            android:orientation="horizontal"
                            android:id="@+id/message_input_edit_root_layout"
                            android:background="@drawable/core_message_bar_input_bg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            flatten="true">
                            <p151v.VLinear
                                android:gravity="center_vertical"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/input_emoji_text_layout"
                                android:background="@null"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                flatten="true">
                                <com.p051p1.mobile.putong.core.p058ui.messages.emoji.VEditTextEmojiCompat
                                    android:textSize="16sp"
                                    android:textColor="@color/common_black_01"
                                    android:textColorHint="#33000000"
                                    android:gravity="center_vertical"
                                    android:layout_gravity="center"
                                    android:id="@+id/input_text"
                                    android:background="@null"
                                    android:paddingLeft="16dp"
                                    android:paddingTop="9dp"
                                    android:paddingRight="12dp"
                                    android:paddingBottom="9dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:minHeight="42dp"
                                    android:hint="@string/CHAT_INPUT_MESSAGE_CONTENT"
                                    android:maxLength="1000"
                                    android:layout_weight="1"
                                    android:lineSpacingExtra="0.5dp"
                                    android:inputType="textAutoCorrect"
                                    android:textCursorDrawable="@drawable/core_message_input_cursor"
                                    app:enableEmojis="true"
                                    app:typeface="regular"/>
                                <com.tantan.library.svga.SVGAnimationView
                                    android:layout_gravity="bottom"
                                    android:id="@+id/input_ai"
                                    android:visibility="gone"
                                    android:layout_width="29dp"
                                    android:layout_height="29dp"
                                    android:layout_marginTop="1dp"
                                    android:layout_marginRight="2dp"
                                    android:layout_marginBottom="6dp"/>
                                <p151v.VImage
                                    android:layout_gravity="bottom"
                                    android:id="@+id/input_emoji"
                                    android:padding="9dp"
                                    android:visibility="gone"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_marginRight="3dp"
                                    android:src="0x7f0806be"/>
                            </p151v.VLinear>
                            <p151v.VText
                                android:textSize="14dp"
                                android:textColor="@color/core_message_bar_input_empty_send"
                                android:gravity="center"
                                android:layout_gravity="bottom"
                                android:id="@+id/input_text_btn"
                                android:paddingLeft="4dp"
                                android:paddingRight="16dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="42dp"
                                android:text="@string/MESSAGES_SEND"
                                app:typeface="regular"/>
                        </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageInputEditRootLayout>
                        <com.p051p1.mobile.putong.core.p058ui.messages.media.widget.RecorderView
                            android:layout_gravity="bottom"
                            android:id="@+id/camera_function"
                            android:visibility="gone"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginLeft="16dp"
                            android:src="0x7f080f6a"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/common_orange"
                            android:gravity="center"
                            android:layout_gravity="bottom"
                            android:id="@+id/real_shot_send"
                            android:background="@drawable/core_message_media_send_bg"
                            android:visibility="gone"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:text="@string/ACTION_SEND"/>
                    </LinearLayout>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/text_light"
                        android:gravity="center"
                        android:id="@+id/block"
                        android:background="@color/common_white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="45dp"
                        android:text="@string/MESSAGE_LIMITED_TEXT_PLACEHOLDER"
                        android:drawablePadding="6dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/action_layout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>
            </LinearLayout>
            <com.p051p1.mobile.putong.core.p058ui.messages.model.record.view.RecordAnimLayout
                android:layout_gravity="bottom"
                android:id="@+id/record_root"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="132dp"/>
        </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageBarRootLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/notice_bubble"
            android:background="0x7f080eab"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/message_bar_content_root"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#fff"
            android:id="@+id/notice_video"
            android:background="@drawable/core_message_bar_media_notice_bubble_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/CAMERA_CANCEL_GUIDE2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#fff"
            android:textColorHint="#99ffffff"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/single_text"
            android:paddingLeft="32dp"
            android:paddingRight="54dp"
            android:paddingBottom="9dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="48dp"
            android:singleLine="true"
            app:enableEmojis="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/camera_close"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="0x7f080f5c"
            android:layout_marginEnd="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/recover_match"
        android:visibility="gone"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/CORE_SVIP_RECOVER_UNMATCH_BUTTON_REMATCH"
        android:singleLine="true"
        app:typeface="medium"
        style="@style/common_button_large_01"/>
    <com.p051p1.mobile.putong.core.p058ui.messages.KeyboardFrameWithShadowOutside
        android:id="@+id/hidden_slide_out"
        android:background="#f7f7f7"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        flatten="true">
        <ViewStub
            android:id="@+id/ai_chat_view"
            android:background="@color/white"
            android:visibility="gone"
            android:layout="@layout/core_messages_ai_chat_view"
            android:layout_width="match_parent"
            android:layout_height="320dp"/>
    </com.p051p1.mobile.putong.core.p058ui.messages.KeyboardFrameWithShadowOutside>
</com.p051p1.mobile.putong.core.p058ui.messages.model.messagebar.MessageBarOpt>
