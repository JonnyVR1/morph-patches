<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    attachToRoot="true"
    folder="ui"
    holder="hideandseek.IntlHideAndSeekRoleView">
    <p151v.VDraweeView
        android:id="@+id/role_icon"
        android:background="0x7f080abe"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/common_grey_07"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/game_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/role_icon"
        app:layout_constraintStart_toEndOf="@+id/role_icon"
        app:layout_constraintTop_toTopOf="@+id/role_icon">
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/black"
            android:id="@+id/role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/core_33000000"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:id="@+id/count_down"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/role_icon">
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:id="@+id/hour_one"
            android:background="@drawable/core_message_ice_break_state_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:id="@+id/hour_two"
            android:background="@drawable/core_message_ice_break_state_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:id="@+id/minute_one"
            android:background="@drawable/core_message_ice_break_state_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:id="@+id/minute_two"
            android:background="@drawable/core_message_ice_break_state_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:id="@+id/second_one"
            android:background="@drawable/core_message_ice_break_state_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/core_color_4d000000"
            android:gravity="center"
            android:id="@+id/second_two"
            android:background="@drawable/core_message_ice_break_state_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            app:typeface="medium"/>
    </p151v.VLinear>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/caught"
        android:background="@drawable/common_normal_orange_btn_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/INTL_MKT_ACTI_ROLE_MOUSE_CAUGHT"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/role_icon"/>
</merge>
