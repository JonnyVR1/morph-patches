<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.maindialog.LiveGuardPrivilegeRightItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment"
    holder="knight.view.maindialog.LiveGuardPrivilegeRightItem">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/tf_circle_light_shape"
        app:layout_constraintLeft_toLeftOf="@+id/root"
        app:layout_constraintRight_toRightOf="@+id/root"
        app:layout_constraintTop_toBottomOf="@+id/top_bg"
        app:layout_constraintTop_toTopOf="@+id/root"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/white"
        android:id="@+id/remain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#cc3253e1"
        android:gravity="center"
        android:id="@+id/text"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/image"
        app:layout_constraintRight_toRightOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/image"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.maindialog.LiveGuardPrivilegeRightItem>
