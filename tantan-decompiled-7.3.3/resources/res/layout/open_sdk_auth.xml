<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="opensdk.OpenSdkViewModel">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/apply_app_logo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:placeholderImage="@color/common_grey_05"
                app:roundedCornerRadius="6dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4a4a4a"
                android:layout_gravity="center"
                android:id="@+id/hand_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4a4a4a"
            android:id="@+id/user_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="您的昵称、头像、地区、性别及生日"
            android:lineSpacingExtra="5dp"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <p151v.VDraweeView
                android:id="@+id/avatar"
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:placeholderImage="@color/common_grey_05"
                app:roundAsCircle="true"/>
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4a4a4a"
                android:id="@+id/user_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="3dp"
                android:layout_toRightOf="@+id/avatar"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#a99b9b"
                android:id="@+id/user_info_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:text="探探个人信息"
                android:layout_toRightOf="@+id/avatar"
                android:layout_below="@+id/user_name_tv"/>
        </RelativeLayout>
    </LinearLayout>
    <p151v.VText
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/agree_tv"
        android:background="@drawable/open_sdk_button_agree"
        android:paddingLeft="108dp"
        android:paddingTop="13dp"
        android:paddingRight="108dp"
        android:paddingBottom="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="同意"/>
    <p151v.VText
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#a99b9b"
        android:layout_gravity="center"
        android:id="@+id/cancel_tv"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="取消"/>
</LinearLayout>
