<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.archi.dialogcenter.DialogContentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="archi.dialogcenter"
    holder="DialogContentView">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VFrame
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/live_bg_white_tr24"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true"/>
</com.p051p1.mobile.putong.live.livingroom.archi.dialogcenter.DialogContentView>
