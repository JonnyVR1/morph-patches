<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="intlmeet.likers.IntlMeetLikersViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/intl_meet_likers_discount_banner_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_bar"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intl_meet_likers_discount_banner_container">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <include
                android:id="@+id/filter_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_scrollFlags="snap|scroll"
                layout="@layout/core_intl_see_filter_view"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:spanCount="2"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:paddingBottom="40dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/image"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:layout_marginTop="-10dp"
                android:src="0x7f080b47"
                android:scaleType="centerInside"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_000000_40"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/SEE_WHO_LIKED_ME_EMPTY_TEXT"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/empty_radar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/radar_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.041"/>
            <FrameLayout
                android:id="@+id/radar_container"
                android:layout_width="316dp"
                android:layout_height="316dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/radar_guideline">
                <com.p051p1.mobile.putong.core.newui.view.RadarRipple
                    android:id="@+id/radar_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/radar_avatar"
                    android:layout_width="98dp"
                    android:layout_height="98dp"
                    android:outlineSpotShadowColor="#19979797"
                    app:backgroundImage="@color/common_light_04"
                    app:roundingBorderPadding="3dp"
                    style="@style/core_fresco_profile_white_border"/>
            </FrameLayout>
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="#66000000"
                android:gravity="center"
                android:id="@+id/radar_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="-115dp"
                android:layout_marginRight="60dp"
                android:text="@string/INTL_SEE_EMPTY_STATE_TEXT"
                android:lineSpacingExtra="2dp"
                android:layout_marginHorizontal="60dp"
                app:fontWeight="400"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/radar_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VText_NoTopPadding
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/get_privilege"
            android:background="@drawable/core_vip_bg_purchase_dialog_payment_button_svip"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="18dp"
            app:fontWeight="700"
            app:text="成为SVIP超级会员"/>
        <com.p051p1.mobile.putong.core.newui.view.BoostViewContainer
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/boost"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:borderOuterCircle="false"/>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bubble_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="80dp">
            <p151v.VText_NoTopPadding
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/bubble"
                android:background="0x7f0802ab"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/VIP_SEE_BOOST_ACTIVE_BUBBLE"/>
        </FrameLayout>
        <com.sunshine.engine.particle.SceneView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/boost_heart_scene"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="135dp"
            android:layout_marginBottom="50dp"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
