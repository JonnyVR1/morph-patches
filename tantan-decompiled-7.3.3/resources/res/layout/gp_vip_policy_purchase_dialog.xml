<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.PurchaseDialog">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VScroll_Fill_BottomAligned
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/root"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/privilege_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/showcase_root"
                    android:paddingTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-18dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/payment_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </p151v.VScroll_Fill_BottomAligned>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/policy"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#80ffffff"
                android:gravity="center"
                android:id="@+id/renewal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/VIP_ALERT_AUTO_RENEWAL_TITLE"
                android:fontFamily="sans-serif"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#80ffffff"
                android:gravity="center"
                android:id="@+id/renewal_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="-7dp"
                android:layout_marginRight="5dp"
                android:text="@string/GP_ALERT_AUTO_RENEWAL_DETAIL"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:visibility="visible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        android:src="0x7f080bc6"/>
</FrameLayout>
