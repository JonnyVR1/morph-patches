<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemChatUnlockLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.ItemChatUnlockLayout">
    <p151v.VRelative
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp">
        <com.p051p1.mobile.putong.core.newui.talk.view.NewTalkProgressView
            android:id="@+id/progress"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"/>
        <p151v.VDraweeView
            android:id="@+id/other_head"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:cropToPadding="false"
            android:layout_centerInParent="true"
            app:roundAsCircle="true"
            style="@style/core_im_fresco_profile_small"/>
    </p151v.VRelative>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="2dp"
        android:text="已解锁50%"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_grey_03"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="接着聊聊，探索对方闪光点吧"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemChatUnlockLayout>
