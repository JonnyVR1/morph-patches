<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.emoji.CoreCommendHintEmojiView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="emoji.CoreCommendHintEmojiView">
    <RelativeLayout
        android:id="@+id/content"
        android:background="@color/white"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/shadow"
            android:background="#08000000"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:layout_below="@+id/shadow"/>
        <RelativeLayout
            android:id="@+id/sticker_content"
            android:background="@drawable/core_comment_hint_close_bg"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/shadow"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/sticker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_centerInParent="true"
                app:actualImageScaleType="focusCrop"
                app:fadeDuration="0"
                app:failureImageScaleType="center"
                app:placeholderImageScaleType="center"
                app:roundedCornerRadius="10dp"/>
            <p151v.VImage
                android:id="@+id/sticker_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="10dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.emoji.CoreCommendHintEmojiView>
