<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.operation.BoostStartView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment"
    holder="operation.BoostStartView">
    <p151v.VImage
        android:id="@+id/boost_start_round_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0826b4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/boost_start_round_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0826b3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/boost_start_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0826b2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/boost_start_tip_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:src="0x7f0826b5"
        app:layout_constraintBottom_toBottomOf="@+id/boost_start_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="#dbdeff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:text="超级曝光开启"
        app:layout_constraintBottom_toBottomOf="@+id/boost_start_tip_bg"
        app:layout_constraintLeft_toLeftOf="@+id/boost_start_tip_bg"
        app:layout_constraintRight_toRightOf="@+id/boost_start_tip_bg"
        app:layout_constraintTop_toTopOf="@+id/boost_start_tip_bg"/>
    <p151v.VText
        android:textSize="80sp"
        android:textColor="@color/white"
        android:id="@+id/count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/count_down_unit"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="38sp"
        android:textColor="@color/white"
        android:id="@+id/count_down_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:text="s"
        app:layout_constraintBaseline_toBaselineOf="@+id/count_down"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/count_down"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.operation.BoostStartView>
