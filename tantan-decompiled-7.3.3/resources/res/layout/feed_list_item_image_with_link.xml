<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.FeedListImageLinkItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_item_image_link"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.FeedListImageLinkItem">
    <include layout="@layout/feed_photo_album_activities_time"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card"
        android:background="@drawable/feed_list_item_image_with_link_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="16dp">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            app:roundedCornerRadius="10dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="8dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/look"
            android:background="@drawable/feed_list_item_image_with_link_look_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="点击查看"/>
    </LinearLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.FeedListImageLinkItem>
