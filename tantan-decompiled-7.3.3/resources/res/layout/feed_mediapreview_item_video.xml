<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.PictureView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        style="@style/feed_fresco_base"/>
    <p151v.VFrame_ColorFilter
        android:layout_gravity="center"
        android:id="@+id/buttons"
        android:background="@drawable/feed_bg_oval"
        android:padding="15dp"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="28dp"
        useId="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/play"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0802dd"
            useId="true"/>
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:indeterminateOnly="true"
            app:cpb_color="@color/white"
            app:cpb_stroke_percentage="0.1"
            useId="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/pause"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f081cbc"
            useId="true"/>
    </p151v.VFrame_ColorFilter>
</com.p051p1.mobile.putong.feed.p065ui.PictureView>
