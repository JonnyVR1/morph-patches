<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_preview_video"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="preview.uiattach.FeedVideoMediaPreviewUIAttach">
    <View
        android:id="@+id/tool_bar_back_cover"
        android:background="@drawable/feed_preview_tool_bar_cover_back"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/tool_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/feed_preview_tool_bar"/>
    <View
        android:id="@+id/back_cover"
        android:background="@drawable/feed_preview_cover_back"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="false">
        <View
            android:id="@+id/divide"
            android:background="#1effffff"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="16dp"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@+id/divide"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rotate_disc_view"
            app:layout_goneMarginRight="106dp"/>
        <FrameLayout
            android:id="@+id/rotate_disc_view"
            android:layout_width="110dp"
            android:layout_height="100dp"
            android:layout_marginRight="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/divide"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/push_time"
            app:layout_goneMarginBottom="16dp"/>
        <LinearLayout
            android:id="@+id/distance_container"
            android:background="@drawable/feed_video_preview_distance_bg"
            android:paddingLeft="6dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@+id/name"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="@+id/name"
            app:layout_constraintRight_toLeftOf="@+id/recommend_reason_container"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/distance_img"
                android:background="0x7f081dd8"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/distance"
                android:paddingTop="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/recommend_reason_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@+id/name"
            app:layout_constraintLeft_toRightOf="@+id/distance_container"
            app:layout_constraintRight_toLeftOf="@+id/rotate_disc_view"
            app:layout_goneMarginLeft="0dp"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/recommend_reason_txt"
                android:background="@drawable/feed_video_preview_distance_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:maxLines="1"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="17sp"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:id="@+id/push_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@+id/name"
            app:layout_constraintLeft_toRightOf="@+id/name"
            app:layout_constraintRight_toLeftOf="@+id/rotate_disc_view"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#99ffffff"
            android:ellipsize="end"
            android:id="@+id/push_time_and_viewers"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="5dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_goneMarginBottom="16dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/forward_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转发"
            app:layout_constraintBottom_toTopOf="@+id/rotate_disc_view"
            app:layout_constraintLeft_toLeftOf="@+id/forward_icon"
            app:layout_constraintRight_toRightOf="@+id/forward_icon"
            app:layout_goneMarginBottom="16dp"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/forward_icon"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="35dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="3dp"
            android:src="0x7f081e7c"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/forward_count"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/forward_space_view"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toTopOf="@+id/forward_icon"
            app:layout_constraintLeft_toLeftOf="@+id/greet_icon"
            app:layout_constraintRight_toRightOf="@+id/greet_icon"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/greet_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FEED_GREETING"
            app:layout_constraintBottom_toTopOf="@+id/forward_space_view"
            app:layout_constraintLeft_toLeftOf="@+id/greet_icon"
            app:layout_constraintRight_toRightOf="@+id/greet_icon"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/greet_icon"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="35dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="3dp"
            android:src="0x7f081ea2"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/greet_count"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/space_view"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toTopOf="@+id/greet_icon"
            app:layout_constraintLeft_toLeftOf="@+id/comment_icon"
            app:layout_constraintRight_toRightOf="@+id/comment_icon"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/comment_count"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            app:layout_constraintBottom_toTopOf="@+id/space_view"
            app:layout_constraintLeft_toLeftOf="@+id/comment_icon"
            app:layout_constraintRight_toRightOf="@+id/comment_icon"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_icon"
            android:visibility="visible"
            android:layout_width="38dp"
            android:layout_height="35dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="3dp"
            android:src="0x7f081f28"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/comment_count"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/like_count"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="5"
            app:layout_constraintBottom_toTopOf="@+id/comment_icon"
            app:layout_constraintLeft_toLeftOf="@+id/like_icon"
            app:layout_constraintRight_toRightOf="@+id/like_icon"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/like_icon"
            android:visibility="visible"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="3dp"
            android:src="0x7f081f2d"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/like_count"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/head"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginRight="9dp"
            android:layout_marginBottom="22dp"
            app:layout_constraintBottom_toTopOf="@+id/like_icon"
            app:layout_constraintRight_toRightOf="parent"
            style="@style/feed_fresco_profile_small_border"/>
        <p151v.VDraweeView
            android:id="@+id/head_frame"
            android:visibility="gone"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginRight="2.5dp"
            android:layout_marginBottom="15.5dp"
            app:layout_constraintBottom_toTopOf="@+id/like_icon"
            app:layout_constraintRight_toRightOf="parent"
            style="@style/feed_fresco_profile_frame"/>
        <com.p051p1.mobile.putong.feed.newui.view.LiveHeadAnimView
            android:id="@+id/head_live"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginRight="2.5dp"
            android:layout_marginBottom="15.5dp"
            android:layerType="software"
            app:layout_constraintBottom_toTopOf="@+id/like_icon"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/attention_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/attention"
            app:layout_constraintLeft_toLeftOf="@+id/attention"
            app:layout_constraintRight_toRightOf="@+id/attention"
            app:layout_constraintTop_toTopOf="@+id/attention"/>
        <p151v.VText
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/attention"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="28dp"
            android:layout_height="16dp"
            android:layout_marginBottom="18dp"
            android:drawableLeft="0x7f081e7a"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/like_icon"
            app:layout_constraintLeft_toLeftOf="@+id/head"
            app:layout_constraintRight_toRightOf="@+id/head"/>
        <p151v.VImage
            android:id="@+id/attention_after_follow"
            android:layout_width="13dp"
            android:layout_height="13dp"
            app:layout_constraintBottom_toBottomOf="@+id/attention"
            app:layout_constraintLeft_toLeftOf="@+id/attention"
            app:layout_constraintRight_toRightOf="@+id/attention"
            app:layout_constraintTop_toTopOf="@+id/attention"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/input_comment_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        layout="@layout/photo_album_detail_comment_input_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
