<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fra_container"
    android:padding="10dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="语音闪聊"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f080a18"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VRelative
            android:id="@+id/avatar_rel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <p151v.VDraweeView
                android:id="@+id/avatar_me"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="46dp"
                android:layout_alignParentStart="true"
                app:actualImageScaleType="centerCrop"
                app:roundAsCircle="true"/>
            <p151v.VFrame
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginEnd="46dp">
                <p151v.VDraweeView
                    android:id="@+id/avatar_other"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:roundAsCircle="true"/>
                <com.tantan.library.svga.SVGAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/wave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:scaleType="fitXY"/>
            </p151v.VFrame>
        </p151v.VRelative>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="150dp"
            android:text="温暖的声音在等你"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="#66000000"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="开始语音闪聊，立刻与温暖的声音相遇"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toEndOf="@+id/fra_avatar"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e89e4d"
            android:gravity="center"
            android:id="@+id/chat"
            android:background="@drawable/core_bg_qaudio_broadcast_acc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="16dp"
            android:text="立刻开聊"
            android:layout_marginHorizontal="14dp"
            android:layout_marginVertical="16dp"/>
    </p151v.VLinear>
</FrameLayout>
