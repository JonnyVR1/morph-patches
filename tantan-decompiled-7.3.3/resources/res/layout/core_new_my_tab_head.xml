<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/head_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="profile.newmine.newprofile.block.DefaultUserInfoView">
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="90dp"
            android:layout_height="130dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            app:roundedCornerRadius="10dp"/>
        <com.p051p1.mobile.putong.core.newui.view.RoundedRectangleProgressView
            android:id="@+id/rectangle_progress"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="130dp"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/edit_profile"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081016"
            android:scaleType="fitXY"
            android:paddingStart="10dp"
            android:paddingEnd="5dp"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/new_edit_profile_layout"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/new_edit_profile"
                android:background="@drawable/core_me_edit_icon_bg"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:text="资料"
                android:drawableStart="@drawable/core_new_mine_tab_edit_icon"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_desc_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        flatten="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/name_container"
            android:paddingTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintLeft_toRightOf="@+id/avatar_container"
            app:layout_constraintTop_toTopOf="@+id/avatar_container"
            flatten="true">
            <p151v.VText
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_80"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/MENU_VIEW_PROFILE"
                android:singleLine="true"
                android:layout_weight="1"
                app:typeface="medium"/>
            <p151v.VImage
                android:id="@+id/avatar_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
            <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                android:id="@+id/odiamond_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
            <p151v.VImage
                android:id="@+id/img_vip"
                android:layout_width="38dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:id="@+id/desc_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:layout_marginEnd="24dp"/>
        <include
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_fans_follow_layout"/>
        <View
            android:id="@+id/change_state_container_weight"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="34dp">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/change_state_container"
                android:background="@drawable/core_state_card_bg_small_02"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/icon_change_state"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/core_color_66000000"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_change_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </p151v.VLinear>
            <include
                android:id="@+id/square_enter"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                layout="@layout/core_status_square_enter_view"/>
            <include
                android:id="@+id/state_post"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                layout="@layout/core_my_tab_status_post_view"/>
        </p151v.VLinear>
    </LinearLayout>
</LinearLayout>
