<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="gift.act.GiftRankShareDlg">
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/root"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VFrame
                android:id="@+id/capture"
                android:background="@drawable/core_vip_giftwallopt_sharedlg_bg"
                android:layout_width="match_parent"
                android:layout_height="323dp"
                flatten="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="28dp">
                    <p151v.VDraweeView
                        android:id="@+id/head"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:roundingBorderWidth="1dp"
                        style="@style/core_fresco_profile_white_border"/>
                    <p151v.VText
                        android:textSize="17sp"
                        android:textColor="#212121"
                        android:ellipsize="end"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="1dp"
                        android:maxWidth="200dp"
                        android:text="软萌小可爱"
                        android:singleLine="true"
                        app:layout_constraintBottom_toBottomOf="@+id/head"
                        app:layout_constraintLeft_toRightOf="@+id/head"
                        app:layout_constraintTop_toTopOf="@+id/head"
                        app:typeface="medium"/>
                    <p151v.VImage
                        android:layout_width="23dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="10dp"
                        android:src="0x7f0808c4"
                        android:scaleType="centerCrop"
                        app:layout_constraintLeft_toRightOf="@+id/head"
                        app:layout_constraintTop_toBottomOf="@+id/head"/>
                    <p151v.VFrame
                        android:orientation="horizontal"
                        android:background="@drawable/core_vip_giftwallopt_sharedlg_tip_bg"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="21dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/head">
                        <p151v.VLinear
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <p151v.VText
                                android:textSize="20sp"
                                android:textColor="#fff4e5"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:id="@+id/city"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="12dp"
                                android:text="北京市"
                                android:singleLine="true"
                                android:layout_weight="1"
                                app:typeface="medium"/>
                            <p151v.VText
                                android:textSize="20sp"
                                android:textColor="#fff4e5"
                                android:gravity="center"
                                android:id="@+id/rank"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="12dp"
                                android:text="第10名"
                                app:typeface="medium"/>
                        </p151v.VLinear>
                    </p151v.VFrame>
                    <p151v.VImage
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginTop="0dp"
                        android:src="0x7f0808c1"
                        android:scaleType="centerCrop"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/head"/>
                    <p151v.VLinear
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="117dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:background="0x7f0808c2"
                            android:layout_width="15dp"
                            android:layout_height="8dp"/>
                        <p151v.VText
                            android:textSize="15sp"
                            android:textColor="#212121"
                            android:gravity="center_horizontal"
                            android:id="@+id/count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:text="累计收到礼物230个"
                            app:typeface="medium"/>
                        <View
                            android:background="0x7f0808c3"
                            android:layout_width="15dp"
                            android:layout_height="8dp"/>
                    </p151v.VLinear>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <p151v.VImage
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="0x7f0808bc"
                    android:scaleType="centerCrop"/>
                <p151v.VImage
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f0808bd"
                    android:scaleType="centerCrop"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:orientation="horizontal"
                android:background="#fff"
                android:paddingLeft="28dp"
                android:paddingTop="18dp"
                android:paddingRight="26dp"
                android:paddingBottom="17dp"
                android:layout_width="match_parent"
                android:layout_height="77dp">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:id="@+id/to_share"
                    android:background="@drawable/core_vip_giftwallopt_sharedlg_btn_bg"
                    android:layout_width="122dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="11dp"
                    android:text="分享到微信"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:id="@+id/to_save"
                    android:background="@drawable/core_vip_giftwallopt_sharedlg_btn_bg"
                    android:layout_width="122dp"
                    android:layout_height="42dp"
                    android:text="保存到相册"
                    app:typeface="medium"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:src="0x7f0808c0"
            android:scaleType="centerCrop"/>
    </p151v.VLinear>
</p151v.VFrame>
