<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/post_group_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.postguide.FeedPostGuideOneView">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/scenario_entrance_title_light"
        android:id="@+id/post_today_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="11dp"
        android:text="@string/FEED_TODAY"
        android:layout_alignParentTop="true"/>
    <p151v.VFrame
        android:background="@drawable/feed_post_guide_one_bg"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="12dp"
        android:layout_toRightOf="@+id/post_today_title">
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="0x7f081e45"
                android:scaleType="centerCrop"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_orange"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/post_feed_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="发布动态认识更多新朋友"
                android:singleLine="true"/>
        </p151v.VLinear>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/anim_iv"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="0x7f081e43"
            android:scaleType="center"/>
    </p151v.VFrame>
</p151v.VRelative>
