<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.quickaudio.view.QuickAudioCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    holder="quickaudio.view.QuickAudioCardView">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:background="@drawable/core_bg_card_quick_audio_shape"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080521"/>
        <p151v.VImage
            android:layout_gravity="top|left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="169dp"
            android:src="0x7f080522"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080523"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <p151v.VImage
            android:id="@+id/title_img"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:srcCompat="0x7f08097c"/>
        <p151v.VText
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="语音闪聊"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/common_black_04"
            android:gravity="center_horizontal"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="他和你还蛮合适的，去和他聊聊吧！"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar_bg"
        android:layout_width="345dp"
        android:layout_height="345dp"
        android:layout_marginTop="145dp"
        android:layout_marginBottom="0dp"
        android:src="0x7f0804ca"
        android:scaleType="fitXY"/>
    <p151v.VRelative
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar_parent"
        android:clipChildren="false"
        android:layout_width="220dp"
        android:layout_height="317dp"
        android:layout_marginTop="168dp"
        android:layout_marginBottom="0dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="16dp"/>
        <View
            android:background="@drawable/core_heartbeat_avatar_cover_max"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:alpha="0.5"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:text="在线"
            android:drawableLeft="0x7f0809f5"
            android:drawablePadding="3dp"
            android:layout_alignLeft="@+id/avatar"
            android:layout_alignTop="@+id/avatar"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:background="@drawable/core_bg_impress_signal_card_info"
            android:paddingTop="60dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            flattern="true">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:maxWidth="150dp"
                android:singleLine="true"
                android:drawablePadding="4dp"/>
            <p151v.VText
                android:textSize="11sp"
                android:textStyle="normal"
                android:textColor="#ccffffff"
                android:id="@+id/name_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"
                android:singleLine="true"
                app:typeface="medium"/>
        </p151v.VLinear>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/wave"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"/>
    </p151v.VRelative>
    <FrameLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e89e4d"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/chat_match_btn"
            android:background="@drawable/core_quickchat_fuliao_tag_bg_audio_btn"
            android:layout_width="247dp"
            android:layout_height="56dp"
            android:layout_marginBottom="40dp"
            android:text="立即接听"
            app:typeface="medium"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.quickaudio.view.QuickAudioCardView>
