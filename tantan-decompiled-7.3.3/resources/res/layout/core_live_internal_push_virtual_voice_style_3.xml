<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalBigStyle3VirtualVoicePushView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="0x7f080877"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui.home.bubble"
    holder="internalpush.LiveInternalBigStyle3VirtualVoicePushView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/background_view"
            android:background="@drawable/core_internal_push_bubble_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_online"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="13dp"
            android:text="实时群聊"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/core_live_internal_push_online_bg"
            android:layout_marginStart="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f080a18"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/tv_online"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_online"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/button"
            app:layout_constraintTop_toBottomOf="@+id/tv_online">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:maxLines="2"/>
            <include
                android:layout_gravity="center_horizontal"
                android:id="@+id/avatar_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                layout="@layout/core_live_widget_avatar_number_view"/>
        </p151v.VLinear>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/button"
            android:background="@drawable/core_internal_push_bubble_button_bg"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalBigStyle3VirtualVoicePushView>
