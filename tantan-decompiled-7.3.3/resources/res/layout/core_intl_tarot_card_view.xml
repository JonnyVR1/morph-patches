<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.tarot.TarotInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="tarot.TarotInfoView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/common_card_image_holder_full_round"
            app:failureImageScaleType="centerInside"
            app:layout_constraintHeight_percent="0.6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="20dp"
            style="@style/core_fresco_base"
            useId="true"/>
        <p151v.VButton
            android:id="@+id/close"
            android:background="0x7f080c72"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="120dp"
            app:layout_constraintBottom_toBottomOf="@+id/image"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/info_layout"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintTop_toBottomOf="@+id/space"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout
                android:orientation="horizontal"
                android:id="@+id/order_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:measureLayoutOrientation="horizontal"
                app:measureReverse="true"
                flatten="true">
                <p151v.VText
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <p151v.VText
                    android:textSize="24sp"
                    android:textColor="#ffffff"
                    android:id="@+id/age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"/>
            </com.p051p1.mobile.putong.core.newui.view.LinearMeasureOrderLayout>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ccffffff"
                android:id="@+id/zodiac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                app:layout_constraintLeft_toLeftOf="@+id/order_layout"
                app:layout_constraintTop_toBottomOf="@+id/order_layout"/>
            <RelativeLayout
                android:id="@+id/card_layout"
                android:background="@drawable/core_intl_tarot_info_bg"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="16dp"
                app:layout_constraintTop_toBottomOf="@+id/order_layout"
                flatten="true">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#ffe19a"
                    android:ellipsize="end"
                    android:id="@+id/type"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:singleLine="true"
                    android:layout_marginStart="16dp"/>
                <org.apmem.tools.layouts.FlowLayout
                    android:orientation="horizontal"
                    android:id="@+id/tags"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/type"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:scrollbarStyle="insideInset"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="#ffffff"
                    android:id="@+id/desc"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:lines="4"
                    android:layout_below="@+id/tags"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/image_layout"
                android:layout_width="74dp"
                android:layout_height="114dp"
                android:layout_marginRight="32dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/zodiac"
                flatten="true">
                <ImageView
                    android:id="@+id/tarot_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VText
                    android:textSize="10sp"
                    android:textColor="#ffe19a"
                    android:id="@+id/reversed"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/INTL_TAROT_CARD_POSITION_REVERSED"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <p151v.VText
                    android:textSize="10sp"
                    android:textColor="#ffe19a"
                    android:id="@+id/upright"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/INTL_TAROT_CARD_POSITION_UPRIGHT"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#ffffff"
                android:id="@+id/branding"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="17dp"
                android:text="@string/INTL_TAROT_SELFCARD_BRANDINGTEXT"
                android:drawableLeft="0x7f080c8f"
                android:drawablePadding="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/save_pic"
        android:background="@drawable/core_intl_tarot_bt_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="26dp"
        android:layout_below="@+id/constrain_layout">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/INTL_TAROT_SELFCARD_BUTTON"
            android:drawableLeft="0x7f080c8b"
            android:drawablePadding="10dp"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/normal_operation"
        android:layout="@layout/core_intl_tarot_card_operation_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_alignParentBottom="true"/>
    <ViewStub
        android:id="@+id/usa_operation"
        android:layout="@layout/core_intl_tarot_card_us_operation_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.core.p058ui.tarot.TarotInfoView>
