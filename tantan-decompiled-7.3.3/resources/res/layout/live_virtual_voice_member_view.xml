<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.ktv.member.VirtualVoiceMembersView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="LinearLayout"
    app:binding="true">
    <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
        android:id="@+id/memberSwallowView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:flatten="true">
        <p151v.VRecyclerView
            android:id="@+id/rv_member_list"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="62dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:requiresFadingEdge="horizontal"/>
    </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/member_count"
        android:background="@drawable/live_bg_black_r10_a20"
        android:layout_width="wrap_content"
        android:layout_height="39dp"
        android:minWidth="32dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.ktv.member.VirtualVoiceMembersView>
