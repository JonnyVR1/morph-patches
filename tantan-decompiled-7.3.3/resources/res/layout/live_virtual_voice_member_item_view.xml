<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.ktv.member.item.VirtualVoiceMemberItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="46dp"
    android:layout_height="wrap_content"
    app:bind_extends="ConstraintLayout"
    app:bind_implements="null"
    app:binding="true">
    <View
        android:id="@+id/background"
        android:background="@drawable/live_bg_black_oval_a20"
        android:layout_width="33dp"
        android:layout_height="33dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/state"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <p151v.VFrame
        android:id="@+id/state_container"
        android:layout_width="20dp"
        android:layout_height="13dp"
        android:layout_marginTop="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/state_background"
            android:layout_width="20dp"
            android:layout_height="13dp"
            app:actualImageScaleType="fitCenter"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/mute_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="0x7f0827e4"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/volume_svg"
            android:layout_width="18dp"
            android:layout_height="11dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:id="@+id/index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="-1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/state_container"/>
    <View
        android:id="@+id/place_line"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="26dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_cp"
        android:layout_width="56dp"
        android:layout_height="29dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/place_line"
        app:layout_constraintRight_toLeftOf="@+id/place_line"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.ktv.member.item.VirtualVoiceMemberItemView>
