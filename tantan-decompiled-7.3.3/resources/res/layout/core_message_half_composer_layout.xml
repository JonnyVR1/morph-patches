<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/composer_root"
    android:background="#33000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.MessageHalfPageComposerAct">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/input_root"
        android:background="@color/common_white"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageInputEditRootLayout
            android:orientation="horizontal"
            android:id="@+id/message_input_edit_root_layout"
            android:background="@drawable/core_message_composer_input_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.messages.emoji.VEditTextEmojiCompat
                android:textSize="16sp"
                android:textColor="@color/common_black_01"
                android:textColorHint="@color/common_grey_04"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/input_text"
                android:background="@null"
                android:paddingLeft="16dp"
                android:paddingTop="9dp"
                android:paddingRight="12dp"
                android:paddingBottom="9dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:hint="@string/CHAT_INPUT_MESSAGE_CONTENT"
                android:singleLine="false"
                android:maxLength="1000"
                android:layout_weight="1"
                android:lineSpacingExtra="0.5dp"
                android:textCursorDrawable="@drawable/core_message_input_cursor"
                app:enableEmojis="true"
                app:typeface="regular"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/core_message_bar_input_empty_send"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/input_text_btn"
                android:paddingLeft="4dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-0.5dp"
                android:minHeight="42dp"
                android:text="@string/MESSAGES_SEND"
                app:typeface="regular"/>
        </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageInputEditRootLayout>
    </LinearLayout>
</FrameLayout>
