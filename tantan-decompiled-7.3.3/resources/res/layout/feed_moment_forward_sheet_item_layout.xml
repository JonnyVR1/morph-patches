<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedMomentForwardSheetItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/range_ll"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.view.FeedMomentForwardSheetItemView">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/feed_nearby_topic_color"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_03"
            android:id="@+id/subTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <p151v.VCheckBox
        android:id="@+id/check_box"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/common_checkbox"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedMomentForwardSheetItemView>
