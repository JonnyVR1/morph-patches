<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.view.TopicRecommendTopicView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="16dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.view.TopicRecommendTopicView">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/topic_recommend_ll"
        android:background="@color/moments_feed_optimize_comment_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/feed_e6000000"
            android:id="@+id/module_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="22dp"
            android:text="相关推荐"/>
        <p151v.VRecyclerView
            android:id="@+id/recommend_topic_rv"
            android:paddingTop="18dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.photoalbum.view.TopicRecommendTopicView>
