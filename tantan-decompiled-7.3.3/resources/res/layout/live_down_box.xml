<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="105dp"
    android:layout_height="105dp"
    flatten="true"
    folder="common.dynamic.downbox.item"
    holder="DownBoxViewModel">
    <p151v.VDraweeView
        android:id="@+id/center_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/over_image"
        app:layout_constraintLeft_toLeftOf="@+id/over_image"
        app:layout_constraintRight_toRightOf="@+id/over_image"
        app:layout_constraintTop_toTopOf="@+id/over_image"/>
    <p151v.VDraweeView
        android:id="@+id/over_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/guide_image"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
