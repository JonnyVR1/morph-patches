<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/live_bg_black_r16_a50"
    android:layout_width="225dp"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:background="@drawable/live_shape_bg_custom_toast"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        app:roundedCornerRadius="8dp"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/count"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="-4dp"
        android:minWidth="18dp"
        android:layout_alignTop="@+id/icon"
        android:lineSpacingExtra="0dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginEnd="-6dp"
        android:layout_alignEnd="@+id/icon"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@android:color/white"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@+id/icon"/>
</p151v.VRelative>
