<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/live_shape_fans_club_advance_task_item_bg"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginRight="16dp"
    android:layout_marginStart="16dp">
    <View
        android:id="@+id/circle"
        android:background="@drawable/live_bg_white_oval_a20"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"/>
    <View
        android:background="@drawable/live_bg_white_r2_a20"
        android:layout_width="144dp"
        android:layout_height="14dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_alignTop="@+id/circle"
        android:layout_toEndOf="@+id/circle"/>
    <View
        android:id="@+id/desc"
        android:background="@drawable/live_bg_white_r2_a20"
        android:layout_width="80dp"
        android:layout_height="14dp"
        android:layout_alignBottom="@+id/circle"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/circle"/>
    <View
        android:id="@+id/line"
        android:background="#31ffffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/desc"
        android:layout_marginHorizontal="10dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_below="@+id/line">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/advance_task_reward"
            android:background="@drawable/live_bg_white_r2_a20"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginRight="10dp"
            android:layout_marginStart="10dp"/>
    </FrameLayout>
</RelativeLayout>
