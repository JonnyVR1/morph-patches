<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_profile_edit_item_image_view_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.views.EditProfileGameImageView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/upload_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081462"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/photo_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/red"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="12dp"/>
        <p151v.VImage
            android:layout_gravity="end|bottom"
            android:id="@+id/delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:src="0x7f081456"
            android:layout_marginEnd="8dp"/>
    </p151v.VFrame>
</p151v.VFrame>
