<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.giftwallnew.LiveGiftWallV2Dialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@color/live_19191e"
        android:layout_width="match_parent"
        android:layout_height="630dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="274dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <View
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_GIFT_WALL_TITLE"
        app:layout_constraintBottom_toBottomOf="@+id/title_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_layout"/>
    <p151v.VImage
        android:id="@+id/help"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f0822ea"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_layout"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/card_bg"
                android:layout_width="match_parent"
                android:layout_height="143dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:actualImageScaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VDraweeView
                android:id="@+id/big_icon_img"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="15dp"
                app:actualImageScaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="@+id/card_bg"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VDraweeView
                android:id="@+id/user_icon"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="@+id/card_bg"
                app:layout_constraintTop_toTopOf="@+id/card_bg"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toTopOf="@+id/card_progress_bg"
                app:layout_constraintStart_toEndOf="@+id/user_icon"
                app:layout_constraintTop_toTopOf="@+id/user_icon"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/card_progress_bg"
                android:layout_width="133dp"
                android:layout_height="14dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/user_icon"
                app:layout_constraintStart_toEndOf="@+id/user_icon"
                app:layout_constraintTop_toBottomOf="@+id/user_name"/>
            <View
                android:id="@+id/card_progress_layer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="14dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_progress_bg"
                app:layout_constraintEnd_toEndOf="@+id/card_progress_bg"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/card_progress_bg"
                app:layout_constraintTop_toTopOf="@+id/card_progress_bg"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center"
                android:id="@+id/progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_progress_bg"
                app:layout_constraintStart_toStartOf="@+id/card_progress_bg"
                app:layout_constraintTop_toTopOf="@+id/card_progress_bg"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/medal_bg"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                app:layout_constraintBottom_toBottomOf="@+id/user_name"
                app:layout_constraintEnd_toStartOf="@+id/big_icon_img"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/user_name"
                app:layout_constraintTop_toTopOf="@+id/user_name"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/user_medal_bg"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:minWidth="34dp"
                    app:actualImageScaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VDraweeView
                    android:id="@+id/user_medal_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:minWidth="14dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/user_medal_level"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="@+id/medal_bg"
                    app:layout_constraintTop_toTopOf="@+id/user_medal_bg"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/live_white_80_opacity"
                    android:gravity="center"
                    android:id="@+id/user_medal_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/user_medal_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="3dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center"
                android:id="@+id/gift_count_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="礼物收集"
                app:layout_constraintBottom_toBottomOf="@+id/card_bg"
                app:layout_constraintEnd_toStartOf="@+id/divider_line_one"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/card_bg"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:gravity="center"
                android:id="@+id/gift_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="@+id/gift_count_title"
                app:layout_constraintEnd_toEndOf="@+id/gift_count_title"
                app:layout_constraintStart_toStartOf="@+id/gift_count_title"/>
            <View
                android:id="@+id/divider_line_one"
                android:background="@color/live_white_05_opacity"
                android:layout_width="1dp"
                android:layout_height="33dp"
                android:layout_marginBottom="19dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_bg"
                app:layout_constraintEnd_toStartOf="@+id/divider_line_two"
                app:layout_constraintStart_toStartOf="@+id/card_bg"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:gravity="center"
                android:id="@+id/gift_skin_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="@+id/gift_skin_title"
                app:layout_constraintEnd_toEndOf="@+id/divider_line_two"
                app:layout_constraintStart_toStartOf="@+id/divider_line_one"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center"
                android:id="@+id/gift_skin_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="礼物皮肤"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_bg"
                app:layout_constraintEnd_toStartOf="@+id/gift_skin_more"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/divider_line_one"/>
            <ImageView
                android:id="@+id/gift_skin_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f0822f3"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/gift_skin_title"
                app:layout_constraintEnd_toStartOf="@+id/divider_line_two"
                app:layout_constraintStart_toEndOf="@+id/gift_skin_title"
                app:layout_constraintTop_toTopOf="@+id/gift_skin_title"/>
            <View
                android:id="@+id/divider_line_two"
                android:background="@color/live_white_05_opacity"
                android:layout_width="1dp"
                android:layout_height="33dp"
                android:layout_marginBottom="19dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_bg"
                app:layout_constraintEnd_toEndOf="@+id/card_bg"
                app:layout_constraintStart_toEndOf="@+id/divider_line_one"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:gravity="center"
                android:id="@+id/gift_set_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="@+id/gift_set_title"
                app:layout_constraintEnd_toEndOf="@+id/card_bg"
                app:layout_constraintStart_toStartOf="@+id/divider_line_two"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center"
                android:id="@+id/gift_set_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="礼物套系"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/card_bg"
                app:layout_constraintEnd_toEndOf="@+id/card_bg"
                app:layout_constraintEnd_toStartOf="@+id/gift_set_more"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/divider_line_two"/>
            <ImageView
                android:id="@+id/gift_set_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f0822f3"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/gift_set_title"
                app:layout_constraintEnd_toEndOf="@+id/card_bg"
                app:layout_constraintStart_toEndOf="@+id/gift_set_title"
                app:layout_constraintTop_toTopOf="@+id/gift_set_title"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_40_opacity"
                android:id="@+id/new_gift_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="礼物上新"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_bg"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/new_gift_recycler"
                android:layout_width="0dp"
                android:layout_height="146dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/new_gift_title"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_40_opacity"
                android:id="@+id/picks_gift_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="礼物返场"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/new_gift_recycler"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/picks_gift_recycler"
                android:layout_width="0dp"
                android:layout_height="146dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/picks_gift_title"/>
            <p151v.VRelative
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/picks_gift_recycler"
                app:layout_goneMarginTop="12dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gift_list_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </p151v.VRelative>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
