<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsFilterItemAgeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="visitor.VisitorsFilterItemAgeView">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#66000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="年龄筛选"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:id="@+id/age_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="medium"/>
    </LinearLayout>
    <p151v.VRangeSlider
        android:id="@+id/search_ages"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="-5dp"
        android:layout_marginRight="2dp"
        style="@style/CommonSliderStyle"/>
</com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsFilterItemAgeView>
