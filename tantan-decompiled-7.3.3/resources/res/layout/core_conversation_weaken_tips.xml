<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationWeakenView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.ConversationWeakenView">
    <p151v.VLinear
        android:id="@+id/weaken_layout"
        android:background="@drawable/core_chat_ai_send_moment_shape"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/core_notice_split"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#cc000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/weaken_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="弱化展示超过7天的未读消息提醒，"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#fe7e1d"
            android:layout_gravity="center_vertical"
            android:id="@+id/weaken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一键弱化"/>
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/core_notice_split_close"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.ConversationWeakenView>
