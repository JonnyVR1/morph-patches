<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.receivegift.ReceiveGiftUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginEnd="6dp"
    flatten="true"
    folder="increment"
    holder="gift.receivegift.ReceiveGiftUserItemView">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonAnimMaskAvatarView
        android:layout_gravity="center"
        android:id="@+id/head"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="centerCrop"
        app:roundAsCircle="true"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/select"
        android:background="@drawable/live_selector_gift_receive_user_item_selector"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="3dp"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/name"
        android:background="@drawable/live_selector_gift_receive_user_item_bottom_name"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginBottom="2dp"
        android:paddingStart="5dp"
        android:paddingEnd="4dp"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.receivegift.ReceiveGiftUserItemView>
