<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_ai_translate_dlg_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="20sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/INTL_TT_AITRANSLATE_SETTING_SUBPAGE_LANGUAGELIST_TITLE"
            app:typeface="bold"/>
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/close_btn"
            android:background="0x7f080a79"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <p151v.VRecyclerView
        android:id="@+id/language_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
</p151v.VLinear>
