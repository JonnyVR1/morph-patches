<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/intl_vip_frame"
    android:background="@drawable/profile_vip_bg"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:visibility="visible"
    android:minHeight="64dp"
    holder="profile.profilelist.itemholders.ProfileVIPBannerItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:scaleType="fitXY"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_weight="1"/>
    <p151v.VImage
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/view"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="22dp"/>
</p151v.VLinear>
