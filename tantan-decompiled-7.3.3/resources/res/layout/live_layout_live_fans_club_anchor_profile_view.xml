<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common.fansclub.widget"
    holder="LiveFansClubAnchorProfileView">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/image_holder"
        android:background="@drawable/live_bg_white_oval"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="3dp"
            app:roundAsCircle="true"/>
    </FrameLayout>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="280dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_holder"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/count_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:drawablePadding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name_text"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linear_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/count_text"
        flatten="true">
        <p151v.VImage
            android:id="@+id/fans_medal_image"
            android:layout_width="75dp"
            android:layout_height="21dp"/>
        <p151v.VImage
            android:id="@+id/setting_button"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="21dp"
            android:scaleType="fitXY"
            android:layout_marginStart="4dp"
            app:srcCompat="0x7f0822b4"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
