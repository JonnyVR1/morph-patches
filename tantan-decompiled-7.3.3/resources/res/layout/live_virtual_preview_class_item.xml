<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/live_selector_virtual_preview_template_bg"
    android:layout_width="76dp"
    android:layout_height="86dp">
    <View
        android:id="@+id/content_bg"
        android:background="@drawable/live_bg_1aff831e_r7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="17dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ccffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="57dp"/>
</p151v.VFrame>
