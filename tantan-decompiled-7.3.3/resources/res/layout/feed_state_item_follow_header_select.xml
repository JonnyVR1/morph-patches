<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="10dp"
    folder="newui"
    holder="status.entrance.followheader.FeedStateHeaderSelectItem">
    <View
        android:id="@+id/bg_view"
        android:background="@drawable/feed_share_state_bg_oval_select"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/state"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_view"
        app:layout_constraintLeft_toLeftOf="@+id/bg_view"
        app:layout_constraintRight_toRightOf="@+id/bg_view"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="normal"
        android:textColor="@color/feed_4c000000"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="48dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/bg_view"
        app:layout_constraintRight_toRightOf="@+id/bg_view"
        app:layout_constraintTop_toBottomOf="@+id/bg_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
