<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallAudienceView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_tr24"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bind_extends="ConstraintLayout"
    app:binding="true"
    app:flatten="true">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:flatten="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/audience_list"
            android:paddingBottom="6dp"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="62dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"
            useId="true"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <include
        android:id="@+id/rv_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/refresh"
        app:layout_constraintLeft_toLeftOf="@+id/refresh"
        app:layout_constraintRight_toRightOf="@+id/refresh"
        app:layout_constraintTop_toTopOf="@+id/refresh"
        layout="@layout/live_empty_view"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallAudienceView>
