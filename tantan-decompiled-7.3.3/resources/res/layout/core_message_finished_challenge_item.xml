<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.expirence.view.ItemFinishedChallengeView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent"
    android:paddingLeft="@dimen/core_msg_cell_no_pic_margin"
    android:paddingTop="10dp"
    android:paddingRight="@dimen/core_msg_cell_no_pic_margin"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/core_msg_cell_no_pic_margin"
    flatten="true"
    folder="newui"
    holder="messages.expirence.view.ItemFinishedChallengeView">
    <RelativeLayout
        android:id="@+id/content"
        android:background="@drawable/core_bg_dlg_know_my_self"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/left_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="0x7f08159b"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/complete"
            android:layout_toRightOf="@+id/left_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="15dp">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="你的真相测试已完成"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_09"
                android:ellipsize="end"
                android:id="@+id/sub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="告诉对方更多真相"
                android:maxLines="1"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/complete"
            android:background="@drawable/core_bg_8_ff700b"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="去邀请"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="12dp"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.newui.messages.expirence.view.ItemFinishedChallengeView>
