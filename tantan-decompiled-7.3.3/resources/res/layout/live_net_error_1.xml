<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/view_group_network_error"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_network_error"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:scaleType="fitXY"
            app:srcCompat="0x7f08240c"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white_20_opacity"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_network_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/LIVE_EXITRETENTION_NONETWORK"
            android:layout_below="@+id/img_network_error"/>
    </p151v.VLinear>
</FrameLayout>
