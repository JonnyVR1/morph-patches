<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.preview.VoiceMicHelpDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.preview.VoiceMicHelpDialogView">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        flatten="true">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/live_black_80_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="麦位说明"
            android:singleLine="true"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_black_40_opacity"
            android:id="@+id/radio_mic_desc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="9Mic：All gifts in the room will be shared with the host."
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_black_40_opacity"
            android:id="@+id/nine_mic_desc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="9Mic：All gifts in the room will be shared with the host."
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_black_40_opacity"
            android:id="@+id/ten_mic_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="10Mic：Gifts in the room will be divided among the recipients."
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="247dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/LIVE_VOICE_ROOM_TYPE_ALREADY_KNOW"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.preview.VoiceMicHelpDialogView>
