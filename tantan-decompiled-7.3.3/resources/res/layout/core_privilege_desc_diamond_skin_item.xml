<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.item.PrivilegeDescListDiamondSkinItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.privilege.content.item.PrivilegeDescListDiamondSkinItem">
    <FrameLayout
        android:id="@+id/frame"
        android:background="@drawable/core_privilege_desc_item_ic_bg_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="24dp"
        android:minHeight="68dp"
        android:layout_marginHorizontal="16dp"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/root"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="6dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            flatten="true">
            <FrameLayout
                android:id="@+id/icon_layout"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:rotation="-6"
                    app:roundedCornerRadius="5dp"/>
                <p151v.VImage
                    android:id="@+id/skin_mask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f081274"/>
                <p151v.VImage
                    android:layout_gravity="right"
                    android:id="@+id/skin_mask_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:src="0x7f081273"/>
            </FrameLayout>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toStartOf="@+id/price"
                android:layout_toEndOf="@+id/icon_layout">
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#e6000000"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_toEndOf="@+id/icon_layout"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/describe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_below="@+id/title"
                    android:layout_toStartOf="@+id/price"
                    android:layout_toEndOf="@+id/icon_layout"/>
            </p151v.VLinear>
            <p151v.VSwitchButton
                android:id="@+id/check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:VSwitchActiveColor="#a06a20"/>
        </p151v.VRelative>
    </FrameLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/line"
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.item.PrivilegeDescListDiamondSkinItem>
