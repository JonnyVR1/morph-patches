<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.userCard.middle.VoiceVirtualUserCardMiddleItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    app:bind_extends="ConstraintLayout"
    app:bind_implements="null"
    app:binding="true">
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/left_user_icon_bg"
        android:background="@drawable/live_shape_round_1b1e2a_bg"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/left_user_icon"
        app:layout_constraintEnd_toEndOf="@+id/left_user_icon"
        app:layout_constraintStart_toStartOf="@+id/left_user_icon"
        app:layout_constraintTop_toTopOf="@+id/left_user_icon"/>
    <p151v.VDraweeView
        android:id="@+id/left_user_icon"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:roundedCornerRadius="100dp"/>
    <View
        android:id="@+id/right_user_icon_bg"
        android:background="@drawable/live_shape_round_1b1e2a_bg"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/right_user_icon"
        app:layout_constraintEnd_toEndOf="@+id/right_user_icon"
        app:layout_constraintStart_toStartOf="@+id/right_user_icon"
        app:layout_constraintTop_toTopOf="@+id/right_user_icon"/>
    <p151v.VDraweeView
        android:id="@+id/right_user_icon"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:roundedCornerRadius="100dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_white_30_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/amount"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.userCard.middle.VoiceVirtualUserCardMiddleItemView>
