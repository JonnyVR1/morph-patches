<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.VerificationTagView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="16dp"
    android:minWidth="76dp"
    flatten="true"
    folder="newui"
    holder="home.VerificationTagView">
    <Space
        android:id="@+id/space"
        android:layout_width="4dp"
        android:layout_height="16dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#54c7fc"
        android:gravity="center"
        android:id="@+id/verification_tag_text"
        android:background="@drawable/core_pic_verification_tag_bg"
        android:paddingLeft="11dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="12dp"
        android:text="真实头像"
        app:typeface="medium"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/verification_tag_img"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="4dp"
        android:src="0x7f082957"/>
</com.p051p1.mobile.putong.core.newui.home.VerificationTagView>
