<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="87dp"
    android:layout_height="100dp">
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/bg_view"
        android:layout_width="75dp"
        android:layout_height="75dp"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="10dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/bg_view_select_live_view"
        android:background="@drawable/live_voice_game_mode_item_line_bg"
        android:visibility="gone"
        android:layout_width="75dp"
        android:layout_height="75dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/bg_view_select_view"
        android:background="@drawable/live_voice_game_mode_item_bg"
        android:visibility="gone"
        android:layout_width="75dp"
        android:layout_height="75dp"/>
    <TextView
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
