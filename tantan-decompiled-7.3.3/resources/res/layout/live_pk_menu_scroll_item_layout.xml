<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkScorllItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.view.PkScorllItemView">
    <TextView
        android:textSize="12sp"
        android:textColor="#f57c00"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/right_arrow"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:src="0x7f082479"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkScorllItemView>
