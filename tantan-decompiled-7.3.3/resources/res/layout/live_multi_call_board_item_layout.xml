<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiPk.dialog.view.MultiCallPkBoardItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="recreation.multiPk.dialog.view"
    holder="MultiCallPkBoardItemView">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/avatar_group"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffdd19"
        android:gravity="center"
        android:id="@+id/ranking"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/avatar_group"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_group"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:id="@+id/iv_mvp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0823fd"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_group"
        app:layout_constraintEnd_toEndOf="@+id/avatar_group"
        app:layout_constraintStart_toStartOf="@+id/avatar_group"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_90_opacity"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxWidth="148dp"
        android:maxLines="1"
        android:maxEms="10"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tagsContainer"
        app:layout_constraintEnd_toStartOf="@+id/right_desc"
        app:layout_constraintStart_toEndOf="@+id/avatar_group"
        app:layout_goneMarginBottom="25dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tagsContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_desc"
        app:layout_constraintStart_toEndOf="@+id/avatar_group"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/medalFirst"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            app:actualImageScaleType="fitCenter"/>
        <p151v.VDraweeView
            android:id="@+id/medalSecond"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginStart="5dp"
            app:actualImageScaleType="fitCenter"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#80ffffff"
        android:gravity="center_vertical"
        android:id="@+id/right_desc"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiPk.dialog.view.MultiCallPkBoardItemView>
