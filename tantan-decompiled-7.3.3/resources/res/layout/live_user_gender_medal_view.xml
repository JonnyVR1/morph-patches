    android:id="@+id/root"
    android:background="@drawable/live_bg_f83899_r5"
    android:layout_width="wrap_content"
    android:layout_height="14dp"
    android:paddingStart="1dp"
    android:paddingEnd="4dp"
    folder="increment"
    holder="leaderboard.hourleaderboard.mainland.LiveGenderMedalView">
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/gender"
        android:layout_width="12dp"
        android:layout_height="12dp"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/age"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.LiveGenderMedalView>
