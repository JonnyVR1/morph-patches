<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.IntlNewUIFilterBaseSetting xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="settings.filter.newui.IntlNewUIFilterBaseSetting">
    <p151v.VFrame
        android:id="@+id/my_location"
        android:background="@drawable/tf_rect_light"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081f64"
            android:layout_marginEnd="12dp"/>
        <p151v.VLinear
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/black"
                android:layout_gravity="right"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/SETTINGS_LOCATION_TYPE_CURRENT"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_color_4d000000"
                android:layout_gravity="right"
                android:id="@+id/current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/SETTINGS_LOCATION_DETAIL_UNKNOWN"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SETTINGS_LOCATION"
            android:layout_marginStart="20dp"
            app:typeface="medium"/>
    </p151v.VFrame>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_no_location_permission_tips"
        android:background="#0ffe7e1d"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        flatten="false">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="0x7f0820e4"
            android:layout_marginStart="20dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_orange"
            android:id="@+id/ll_no_location_permission_tips_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/LOCATION_INTL_ABNORMAL_HINT"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:id="@+id/age_text"
            style="@style/intl_core_newfilter_value_tip"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SETTINGS_AGE"
            app:typeface="medium"/>
    </p151v.VFrame>
    <p151v.VRangeSlider
        android:id="@+id/show_ages"
        android:layout_marginTop="16dp"
        android:valueFrom="16"
        android:valueTo="50"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        style="@style/CommonSliderStyle"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:id="@+id/distance_text"
            style="@style/intl_core_newfilter_value_tip"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_distance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SETTINGS_DISTANCE"
            app:typeface="medium"/>
    </p151v.VFrame>
    <p151v.VSlider
        android:value="36"
        android:id="@+id/search_distance"
        android:layout_marginTop="16dp"
        android:valueFrom="0"
        android:valueTo="100"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        style="@style/CommonSliderStyle"/>
    <p151v.VListCell
        android:id="@+id/auto_distance"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:listcell_subtitle="@string/SETTINGS_AUTO_DISTANCE_INFO"
        app:listcell_subtitle_color="@color/common_grey_12"
        app:listcell_title="@string/SETTINGS_AUTO_DISTANCE_TITLE"
        app:listcell_title_color="@color/common_black_02"
        app:listcell_title_size="15sp"
        style="@style/core_newfilter_cell"/>
    <p151v.VFrame
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:id="@+id/gender"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <p151v.VText
                android:text="@string/SETTINGS_SHOW_GENDER"
                android:layout_marginStart="20dp"
                style="@style/intl_core_newfilter_value_tip"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/current_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f081f64"
                android:layout_marginEnd="12dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/gender_normal"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:layout_gravity="left"
                android:layout_marginTop="16dp"
                android:text="@string/SETTINGS_SHOW_GENDER"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                style="@style/intl_core_newfilter_value_tip"/>
            <com.p051p1.mobile.putong.core.p058ui.settings.filter.tags.TagContainerLayout
                android:id="@+id/gender_choose"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:column="3"
                app:iscenter="true"
                app:verSpace="10dp"/>
        </p151v.VLinear>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.IntlNewUIFilterBaseSetting>
