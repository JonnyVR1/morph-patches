<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.giftRecord.VoiceGiftRecordUserView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="4dp">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/head"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerCrop"
        app:roundAsCircle="true"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/select"
        android:background="@drawable/live_selector_gift_receive_user_item_selector"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/name"
        android:background="@drawable/live_selector_gift_receive_user_item_bottom_name"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:paddingStart="5dp"
        android:paddingEnd="4dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.giftRecord.VoiceGiftRecordUserView>
