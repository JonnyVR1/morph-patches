<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.basebuild.notice.VoiceLookTopNoticeDialog xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="basebuild.notice.VoiceLookTopNoticeDialog">
    <View
        android:id="@+id/empty"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/live_bg_white_tr24"
        android:paddingLeft="20dp"
        android:paddingRight="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="155dp">
        <TextView
            android:textSize="21sp"
            android:textStyle="normal"
            android:textColor="#e6000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/LIVE_VOICE_TOP_NOTICE_TITLE"/>
        <EditText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/live_black"
            android:id="@+id/room_notice"
            android:background="@null"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="58dp"
            android:maxHeight="515dp"
            android:text="@string/LIVE_VOICE_TOP_NOTICE_ROOM_DEFAULT_TEXT"
            android:cursorVisible="false"
            android:inputType="textMultiLine"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.basebuild.notice.VoiceLookTopNoticeDialog>
