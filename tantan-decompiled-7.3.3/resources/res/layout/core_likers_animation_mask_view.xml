<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersAnimationMaskView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#b3000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="vip.likers.LikersAnimationMaskView">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/card_left"
        android:layout_width="166dp"
        android:layout_height="216dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/image2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            fresco:actualImageScaleType="centerCrop"
            fresco:failureImage="@color/white"
            fresco:failureImageScaleType="centerCrop"
            fresco:placeholderImage="@color/white"
            fresco:placeholderImageScaleType="centerCrop"
            fresco:roundedCornerRadius="5dp"
            style="@style/core_fresco_base"/>
        <p151v.VImage
            android:id="@+id/newly"
            android:visibility="gone"
            android:drawingCacheQuality="high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f082ab2"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/dislike"
            android:visibility="invisible"
            android:drawingCacheQuality="high"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="0x7f081204"/>
        <p151v.VImage
            android:layout_gravity="left"
            android:id="@+id/like"
            android:visibility="invisible"
            android:drawingCacheQuality="high"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="0x7f081205"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#4a4a4a"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="181dp"
            android:layout_marginRight="10dp"
            android:text="@string/LANDING_TANTAN"
            android:maxLines="1"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/anim_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="16dp"
        android:text="@string/SEE_WHO_LIKED_ME_GUIDE_SWIPE_TEXT"
        android:lineSpacingMultiplier="1.3"/>
</com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersAnimationMaskView>
