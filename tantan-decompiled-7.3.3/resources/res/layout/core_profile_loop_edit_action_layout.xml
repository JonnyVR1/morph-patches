<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileLoopActionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    flatten="true"
    holder="profile.views.ProfileLoopActionLayout">
    <View
        android:background="@drawable/core_loop_edit_shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp">
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/core_profile_loop_jump_btn"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/jump_btn"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/EDIT_PROFILE_SKIP"/>
        <p151v.VButton
            android:layout_gravity="center"
            android:id="@+id/next_btn"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/ACTION_NEXT"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            style="@style/common_button_small_01"/>
    </FrameLayout>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/next_btn_large"
        android:background="@drawable/core_loop_input_action_next_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="32dp"
        android:text="@string/ACTION_NEXT"
        android:layout_marginHorizontal="20dp"/>
</com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileLoopActionLayout>
