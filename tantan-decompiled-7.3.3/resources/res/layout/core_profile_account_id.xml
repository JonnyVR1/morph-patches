<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/publicId"
    android:paddingTop="0dp"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VText
        android:textColor="@color/common_black_02"
        android:id="@+id/tantan_id_tip"
        android:background="@color/transparent"
        android:text="@string/PROFILE_SECTION_HEADER_ACCOUNT"
        style="@style/profile_item_title_black"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66000000"
            android:gravity="center_vertical"
            android:id="@+id/tantan_id_text"
            android:paddingLeft="20dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/PROFILE_ACCOUNT_TANTANID"
            android:layout_weight="1"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/tantan_id_number"
            android:paddingLeft="16dp"
            android:paddingRight="20dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            app:typeface="regular"/>
    </LinearLayout>
</p151v.VLinear_Dividers>
