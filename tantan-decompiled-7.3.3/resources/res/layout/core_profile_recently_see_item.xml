<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileRecentlyNewItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/content_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.views.ProfileRecentlyNewItem">
    <RelativeLayout
        android:id="@+id/literature_container"
        android:layout_width="120dp"
        android:layout_height="160dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/white"
            app:failureImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"/>
        <FrameLayout
            android:background="@drawable/core_profile_new_recently_item_top_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:alpha="0.3"/>
        <FrameLayout
            android:background="@drawable/core_profile_new_recently_item_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_alignParentBottom="true"/>
        <p151v.VImage
            android:id="@+id/add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginRight="7dp"
            android:src="@drawable/core_profile_edit_data_right_add"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/type_watch_container"
            android:background="@drawable/core_profile_recently_type_watch_bg"
            android:visibility="gone"
            android:layout_width="54dp"
            android:layout_height="24dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_alignParentTop="true"
            flatten="false">
            <p151v.VImage
                android:id="@+id/type_watch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/watch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/watch_common_title"
            android:background="@drawable/core_profile_recently_common_watch_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="8dp"/>
        <p151v.VImage
            android:id="@+id/type_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_above="@+id/kind"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"
            android:singleLine="true"
            android:layout_toRightOf="@+id/type_image"
            android:layout_alignTop="@+id/type_image"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/kind"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="8dp"
            android:singleLine="true"
            android:layout_above="@+id/blank_view"
            android:layout_marginHorizontal="8dp"/>
        <View
            android:id="@+id/blank_view"
            android:layout_width="wrap_content"
            android:layout_height="8dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/space_view"
        android:layout_width="8dp"
        android:layout_height="160dp"
        android:layout_toRightOf="@+id/literature_container"/>
    <FrameLayout
        android:id="@+id/right_arrow"
        android:background="@drawable/core_profile_recently_arrow_bg"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="160dp"
        android:layout_toRightOf="@+id/space_view">
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_profile_edit_right_arrow"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileRecentlyNewItem>
