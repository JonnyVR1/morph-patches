<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeConfirmDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.privilege.PrivilegeConfirmDialog">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:gravity="top|center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="继续开通"
        android:fontFamily="sans-serif-medium"
        android:lineHeight="25sp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="top|center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="23dp"
        android:text="同意会员协议，享34%优惠和最高3倍加速曝光"
        android:layout_marginHorizontal="23dp"
        android:lineHeight="20sp"/>
    <p151v.VText
        android:textStyle="bold"
        android:id="@+id/get"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="32dp"
        android:text="确认"
        android:layout_marginHorizontal="32dp"
        app:typeface="regular"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#26000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/dismiss"
        android:background="@drawable/tf_rect_rounded_light"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="狠心拒绝"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeConfirmDialog>
