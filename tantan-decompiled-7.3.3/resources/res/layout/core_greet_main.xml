<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/greet_root_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="greet.GreetActViewModel">
    <View
        android:id="@+id/greet_close_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="true"/>
    <p151v.VFrame
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/core_greet_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/greet_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <RelativeLayout
                android:id="@+id/greet_list_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="64dp"
                flatten="true">
                <p151v.VFrame
                    android:id="@+id/list_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/greet_bottom_layout"
                    flatten="true">
                    <p151v.VList
                        android:id="@+id/greet_list"
                        android:paddingBottom="20dp"
                        android:scrollbars="none"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:listSelector="@color/transparent"
                        android:transcriptMode="normal"
                        android:divider="@null"
                        android:dividerHeight="0dp"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/tips_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/greet_bottom_layout"
                    android:layout_alignParentEnd="true"/>
                <RelativeLayout
                    android:id="@+id/greet_bottom_layout"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    flatten="true">
                    <p151v.VRecyclerView
                        android:id="@+id/quick_reply"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="8dp"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:id="@+id/greet_bottom_input_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="8dp"
                        android:layout_below="@+id/quick_reply"
                        android:layout_toStartOf="@+id/tips_hello"
                        android:layout_alignParentStart="true"
                        flatten="true">
                        <p151v.VImage
                            android:layout_gravity="center"
                            android:id="@+id/greet_im_gift_icon"
                            android:background="@drawable/core_im_greeting_action_send_bg"
                            android:padding="9dp"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="0x7f0809e2"
                            android:scaleType="centerCrop"
                            android:layout_marginEnd="6dp"/>
                        <p151v.VLinear
                            android:orientation="horizontal"
                            android:id="@+id/greet_bottom_text_input_layout"
                            android:background="@drawable/core_im_greeting_action_send_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <p151v.VEditText
                                android:textSize="14sp"
                                android:textColor="@color/common_000000_80"
                                android:textColorHint="@color/common_000000_20"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/edit_greet"
                                android:background="@null"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="40dp"
                                android:maxLines="3"
                                android:maxLength="1000"
                                android:layout_weight="1"
                                android:inputType="textMultiLine"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"/>
                            <p151v.VText
                                android:textSize="14sp"
                                android:textColor="@color/core_im_greeting_input_btn_color"
                                android:gravity="center"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/send"
                                android:padding="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="发送"
                                android:layout_marginEnd="16dp"
                                app:typeface="medium"/>
                        </p151v.VLinear>
                    </p151v.VLinear>
                    <p151v.VImage
                        android:id="@+id/tips_hello"
                        android:background="@drawable/core_immersion_video_bg_12_f9f9f9"
                        android:padding="9dp"
                        android:visibility="gone"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginBottom="10dp"
                        android:src="0x7f0809ec"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </RelativeLayout>
        </p151v.VFrame>
        <p151v.VFrame
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="144dp">
            <p151v.VFrame
                android:id="@+id/greet_top_layout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                flatten="true">
                <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
                    android:layout_gravity="center"
                    android:id="@+id/greet_user_image"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="13dp"
                    app:actualImageScaleType="centerCrop"
                    app:failureImage="@color/white"
                    app:failureImageScaleType="centerInside"
                    app:placeholderImage="@color/white"
                    app:placeholderImageScaleType="centerInside"
                    app:roundAsCircle="true"/>
                <p151v.VImage
                    android:layout_gravity="left"
                    android:id="@+id/greet_user_icon"
                    android:background="@drawable/core_greet_hand_ic_bg"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="36dp"
                    android:src="0x7f0808d3"
                    android:scaleType="centerInside"
                    android:layout_marginStart="43dp"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#e6000000"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/greet_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="70dp"
                    android:layout_marginRight="100dp"
                    android:stackFromBottom="true"
                    android:lines="1"
                    app:typeface="medium"/>
                <p151v.VIcon
                    android:layout_gravity="center"
                    android:id="@+id/close"
                    android:src="0x7f0808d0"
                    android:layout_marginEnd="16dp"
                    style="@style/common_icon_small"/>
                <p151v.VIcon
                    android:layout_gravity="center"
                    android:id="@+id/report"
                    android:src="0x7f0808db"
                    android:layout_marginEnd="56dp"
                    style="@style/common_icon_small"/>
            </p151v.VFrame>
        </p151v.VFrame>
    </p151v.VFrame>
</p151v.VFrame>
