<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.operations.VoiceOperationsItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/iconContainer"
    android:layout_width="44dp"
    android:layout_height="44dp">
    <p151v.VDraweeView
        android:id="@+id/iconImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:scaleType="fitCenter"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svgaView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp"/>
    <View
        android:layout_gravity="top|right"
        android:id="@+id/redDot"
        android:background="@drawable/live_bg_ff6464_oval"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="3dp"/>
    <p151v.VText
        android:textSize="8dp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/numberBadge"
        android:background="@drawable/live_bg_ff6464_r4"
        android:paddingBottom="0.5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:minWidth="11dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"/>
    <com.p051p1.mobile.putong.live.livingroom.view.LiveHorizontalAutoScrollView
        android:textSize="7dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/titleText"
        android:background="@drawable/live_bg_black_r4_a40"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:maxLines="1"
        app:contentTextColor="@color/live_white_80_opacity"
        app:contentTextSize="7dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.operations.VoiceOperationsItemView>
