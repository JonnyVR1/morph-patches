<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="487dp"
    flatten="true"
    folder="common"
    holder="member.MemberDialog">
    <include
        android:id="@+id/animView"
        layout="@layout/live_hour_leader_board_top_anim_view"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:tabBackground="@color/transparent"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/live_list_members_indicator"
            app:tabIndicatorColor="@color/live_white_80_opacity"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/live_white_80_opacity"
            app:tabTextAppearance="@style/live_member_tab_theme"
            app:tabTextColor="@color/live_white_50_opacity"
            flatten="true"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/member_rules"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="11dp"
            android:src="0x7f0823e1"
            android:layout_marginEnd="16dp"/>
        <View
            android:layout_gravity="bottom"
            android:background="#05f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>
    </FrameLayout>
    <p151v.VPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="62dp"
        android:layout_weight="1"
        flatten="true"/>
</p151v.VFrame>
