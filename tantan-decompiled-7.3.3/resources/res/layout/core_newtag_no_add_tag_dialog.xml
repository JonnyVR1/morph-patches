<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true">
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/core_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="429dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:src="0x7f08122a"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_323232"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂不添加标签？"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_999999"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:text="个人标签已全面升级，原有标签已被清空。添加新的标签可以更好地展现你的魅力。"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/add_tag"
            android:background="@drawable/core_bg_fe7e1d_r16"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="去添加"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_cccccc"
            android:gravity="center"
            android:id="@+id/no_add_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="暂不添加"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
