<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.picks.view.header.PicksStateExpandView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="0x7f081348"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.picks.view.header.PicksStateExpandView">
    <LinearLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="9dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/title_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08134a"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="每日心动"
            android:lineSpacingExtra="0sp"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp"
            android:src="0x7f081349"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <p151v.VPullUpRecyclerView
        android:id="@+id/list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="391dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/title_layout"
        android:layout_marginHorizontal="10dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="#ff658d"
        android:layout_gravity="center"
        android:id="@+id/goto_picks"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="查看全部"
        android:layout_below="@+id/list"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="0sp"
        android:paddingHorizontal="10dp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.picks.view.header.PicksStateExpandView>
