<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_r16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#323232"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="43dp"
            android:text="@string/LIVE_SLIDE_CARD_TIPS_CONTENT"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="17dp">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#838383"
                android:gravity="center"
                android:id="@+id/keep_mute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_SLIDE_CARD_TIPS_CLOSE"
                android:layout_weight="1"/>
            <View
                android:background="#33979797"
                android:layout_width="1dp"
                android:layout_height="20dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#fe7e1d"
                android:gravity="center"
                android:id="@+id/switch_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_SLIDE_CARD_TIPS_OPEN"
                android:layout_weight="1"/>
        </p151v.VLinear>
    </p151v.VLinear>
</p151v.VFrame>
