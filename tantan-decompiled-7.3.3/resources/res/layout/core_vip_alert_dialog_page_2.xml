<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.VipIntroPage2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.VipIntroPage2">
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="4dp"
        android:drawablePadding="6dp"
        app:typeface="regular"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/bg"
        android:layout="@layout/vip_alert_dialog_page_top_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <ViewStub
        android:id="@+id/vip_badge"
        android:layout="@layout/core_vip_alert_dialog_page_2_vip_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/vip_super_like"
        android:layout="@layout/vip_alert_dialog_page_2_super_like"
        android:layout_width="200dp"
        android:layout_height="@dimen/vip_alert_dynamic_content_height"
        android:layout_marginTop="16dp"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/vip_undo"
        android:layout="@layout/vip_alert_dialog_page_2_vip_undo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vip_alert_dynamic_content_height"
        android:layout_marginTop="16dp"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/vip_location"
        android:layout="@layout/vip_alert_dialog_page_2_vip_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/vip_unlimited_likes"
        android:layout="@layout/vip_alert_dialog_page_2_vip_unlimited_likes"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vip_alert_dynamic_content_height"
        android:layout_marginTop="16dp"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/vip_letter"
        android:layout="@layout/letter_privilege_count_component"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vip_alert_dynamic_content_height"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"/>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/svip"
        android:layout="@layout/svip_alert_dialog_page"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vip_alert_dynamic_content_height"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"/>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:id="@+id/txt_digest"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="13dp"
        android:text="@string/VIP_ALERT_DIGEST_UNDO"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/text_medium"
        android:gravity="center"
        android:id="@+id/txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="13dp"
        android:text="@string/VIP_ALERT_CONTENT_UNDO"
        android:maxLines="2"
        android:lineSpacingExtra="3sp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.VipIntroPage2>
