<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.group.dialog.insert.twolevellinkage.FeedPostTopicItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="20dp"
    folder="newui"
    holder="group.dialog.insert.twolevellinkage.FeedPostTopicItemView">
    <p151v.VFrame
        android:id="@+id/topic_head_fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/topic_head_image"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"
            style="@style/feed_fresco_base"/>
        <p151v.VDraweeView
            android:id="@+id/topic_head_shadow"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            app:actualImageResource="@color/common_grey_03"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@color/common_grey_03"
            app:placeholderImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"
            style="@style/feed_fresco_base"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/topic_image_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081c53"/>
    </p151v.VFrame>
    <p151v.VRelative
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="16dp"
        android:layout_toLeftOf="@+id/check_box"
        android:layout_toRightOf="@+id/topic_head_fl"
        android:layout_centerVertical="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/topic_name_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="false">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/topic_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/group_txt"
                android:background="@drawable/feed_post_topic_group_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/anonymous_txt"
                android:background="@drawable/feed_post_bg_anonymous_topic"
                android:paddingLeft="5dp"
                android:paddingTop="0dp"
                android:paddingRight="5dp"
                android:paddingBottom="0dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:text="匿名"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/common_grey_03"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/topic_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:layout_below="@+id/topic_name_ll"/>
    </p151v.VRelative>
    <p151v.VCheckBox
        android:id="@+id/check_box"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:checked="false"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/common_checkbox"/>
</com.p051p1.mobile.putong.feed.newui.group.dialog.insert.twolevellinkage.FeedPostTopicItemView>
