<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="recharge.LocalFastRechargeDialog">
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f0822b6"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_fffbeb"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/LIVE_FIRST_RECHARGE_DESC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/old_first_recharge_question_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="0x7f0824b3"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_feddc4"
        android:id="@+id/time_text"
        android:background="@drawable/live_bg_fe2554_r12_a20"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/LIVE_FIRST_RECHARGE_DURATION"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_fff8d7"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/LIVE_FIRST_RECHARGE_SUCCESS_DESC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_text"/>
    <p151v.VImage
        android:layout_width="60dp"
        android:layout_height="16dp"
        android:src="0x7f0824b1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/sub_title"
        app:layout_constraintEnd_toStartOf="@+id/sub_title"
        app:layout_constraintTop_toTopOf="@+id/sub_title"/>
    <p151v.VImage
        android:layout_width="60dp"
        android:layout_height="16dp"
        android:src="0x7f0824b2"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/sub_title"
        app:layout_constraintStart_toEndOf="@+id/sub_title"
        app:layout_constraintTop_toTopOf="@+id/sub_title"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginTop="14dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title">
        <include
            android:id="@+id/fast_gift_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/live_first_recharge_gift_item"/>
        <include
            android:id="@+id/fast_gift_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            layout="@layout/live_first_recharge_gift_item"/>
        <include
            android:id="@+id/fast_gift_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/live_first_recharge_gift_item"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
