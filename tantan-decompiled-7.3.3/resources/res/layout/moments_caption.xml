<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="moments.caption.CaptionViewModel">
    <p151v.VScroll
        android:scrollbarStyle="outsideOverlay"
        android:paddingLeft="16dp"
        android:paddingTop="28dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_weight="100">
        <p151v.VEditText
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_light"
            android:gravity="top|left"
            android:id="@+id/edit_field"
            android:background="@null"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/MOMENTS_CAPTION_INPUT_HINT"
            android:maxLength="2000"
            android:inputType="textMultiLine"
            android:textCursorDrawable="0x7f082a1a"
            app:typeface="regular"/>
    </p151v.VScroll>
    <p151v.VText
        android:id="@+id/alert_text"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        style="@style/edit_text_indicator"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/images"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/low_alert"
            android:background="#f7f7f7"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/USER_INFO_CHECK_MOMENT_HINT_TITLE"
            android:maxLines="2"
            android:drawablePadding="10dp"/>
        <View style="@style/feed_settings_divider"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_light"
            android:gravity="center_vertical"
            android:id="@+id/location"
            android:background="@drawable/tf_rect_light"
            android:paddingLeft="16dp"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/MOMENTS_CAPTION_ADD_LOCATION_CELL_TITLE"
            android:singleLine="true"
            android:drawableLeft="0x7f0828fb"
            android:drawablePadding="40dp"
            app:typeface="regular"/>
    </LinearLayout>
</LinearLayout>
