<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.aichat.AIChatMessageAnalysisItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="32dp"
    android:paddingTop="18dp"
    android:paddingRight="32dp"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.aichat.AIChatMessageAnalysisItem">
    <RelativeLayout
        android:id="@+id/content_layout"
        android:background="@drawable/core_message_aichat_layout_bg"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f080ecf"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_toRightOf="@+id/icon"
            android:layout_alignTop="@+id/icon"
            android:layout_alignBottom="@+id/icon"/>
        <com.p051p1.mobile.putong.core.p058ui.messages.aichat.TextTypeView
            android:textSize="16dp"
            android:textColor="#cc000000"
            android:id="@+id/content"
            android:background="@drawable/core_message_aichat_content_bg"
            android:paddingLeft="16dp"
            android:paddingTop="11dp"
            android:paddingRight="16dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="加载失败，请稍后重试"
            android:minLines="1"
            android:layout_below="@+id/title"
            android:lineSpacingExtra="2dp"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svga_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/content"
            android:layout_alignTop="@+id/content"
            android:layout_alignBottom="@+id/content"/>
    </RelativeLayout>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/feedback"
        android:background="@drawable/core_message_aichat_feedback_bg"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="34dp"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/content_layout"
        android:layout_alignRight="@+id/content_layout"
        flatten="true">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/feedback_unlike"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_below="@+id/content_layout"
            android:layout_alignRight="@+id/content_layout">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080fe7"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="无用"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/feedback_like"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_below="@+id/content_layout"
            android:layout_alignRight="@+id/content_layout">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080f4a"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="有用"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.aichat.AIChatMessageAnalysisItem>
