<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.icebreak.IceBreakQuestionCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    folder="newui"
    holder="icebreak.IceBreakQuestionCard">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="0x7f0809a6"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:src="0x7f0809a7"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="心动开场白"
            android:lineHeight="31dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/sub_title"
            android:paddingLeft="52dp"
            android:paddingRight="52dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="添加你感兴趣的开场白，离线期间给新配对好友自动发送"
            android:paddingHorizontal="52dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffaa04"
            android:gravity="center"
            android:id="@+id/submit"
            android:background="@drawable/core_dice_guide_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="40dp"
            android:text="立即添加"
            android:layout_marginHorizontal="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="8dp"
            app:layout_constraintBottom_toTopOf="@+id/submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sub_title">
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/question_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VLinear
                    android:id="@+id/ll_question_1"
                    android:background="0x7f0809aa"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/question_1_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="16dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="16dp"/>
                    <p151v.VCheckBox
                        android:layout_gravity="center_vertical"
                        android:id="@+id/check_box_1"
                        android:background="@drawable/core_ic_break_checkbox_bg"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:checked="false"
                        android:layout_alignParentRight="true"
                        style="@style/common_checkbox"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/ll_question_2"
                    android:background="0x7f0809ab"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/question_2_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="16dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="16dp"/>
                    <p151v.VCheckBox
                        android:layout_gravity="center_vertical"
                        android:id="@+id/check_box_2"
                        android:background="@drawable/core_ic_break_checkbox_bg"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:checked="false"
                        style="@style/common_checkbox"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/ll_question_3"
                    android:background="0x7f0809ac"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/common_black_80"
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/question_3_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="16dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="16dp"/>
                    <p151v.VCheckBox
                        android:layout_gravity="center_vertical"
                        android:id="@+id/check_box_3"
                        android:background="@drawable/core_ic_break_checkbox_bg"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:checked="false"
                        style="@style/common_checkbox"/>
                </p151v.VLinear>
            </p151v.VLinear>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.newui.icebreak.IceBreakQuestionCard>
