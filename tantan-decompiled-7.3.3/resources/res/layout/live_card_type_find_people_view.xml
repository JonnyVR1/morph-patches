<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.people.LivePeopleCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/user_avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/live_bg_f7f7f7_r4"
        app:failureImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_bg_f7f7f7_r10"
        app:roundedCornerRadius="10dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tips_layout"
        android:background="@drawable/live_bg_black_r6_a30"
        android:paddingLeft="6dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_vertical"
            android:id="@+id/attribute_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"/>
    </p151v.VLinear>
    <View
        android:background="@drawable/live_shape_bg_99000000_80000000_00000000_botttomr10"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/user_avatar"
        app:layout_constraintRight_toRightOf="@+id/user_avatar"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxEms="7"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/user_content"
        app:layout_constraintLeft_toLeftOf="@+id/user_content"/>
    <p151v.VDraweeView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:id="@+id/user_tagicon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_name"
        app:layout_constraintLeft_toRightOf="@+id/user_name"
        app:layout_constraintTop_toTopOf="@+id/user_name"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#b3ffffff"
        android:id="@+id/user_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.people.LivePeopleCardView>
