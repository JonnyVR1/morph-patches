<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    flatten="false"
    holder="profile.profilelist.itemholders.ProfileEditNewTagsItemHolder">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        flatten="false">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/PROFILE_SECTION_HEADER_PERSONALITY"
            android:layout_weight="1"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08145e"
            android:layout_weight="0"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
        android:id="@+id/tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/add_tag_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        flatten="false">
        <p151v.VText
            android:textSize="15sp"
            android:textColorHint="@color/common_black_80"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/add_tag_title"
            android:background="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/PROFILE_TAGS_CATEGORY_PERSONALITY_PLACEHOLDER"
            android:layout_weight="1"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/core_profile_edit_data_right_add"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/view_all"
        android:background="@drawable/core_profile_new_tag_item_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="10dp"
        android:paddingVertical="10dp"
        flatten="false">
        <p151v.VImage
            android:id="@+id/more_icon"
            android:background="@drawable/core_profile_new_tag_view_all_icon_bg"
            android:paddingTop="9dp"
            android:paddingBottom="7dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="0x7f08111f"
            android:paddingStart="9dp"
            android:paddingEnd="7dp"/>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_text_e6000000"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/view_all_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看全部"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#66000000"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_lable_layout"
        android:background="@drawable/core_bg_10_fff3e5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        flatten="true">
        <p151v.VText
            android:textSize="14dp"
            android:id="@+id/add_button"
            android:layout_height="34dp"
            android:layout_marginRight="16dp"
            android:text="去添加"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/common_button_small_01"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/core_color_80percent_000000"
            android:id="@+id/head_title"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="90dp"
            android:text="为我的标签添加生活照"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="13dp"
            android:textColor="@color/core_color_40percent_000000"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="90dp"
            android:text="遇见兴趣相投的人，获得更多配对"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/head_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear_Dividers>
