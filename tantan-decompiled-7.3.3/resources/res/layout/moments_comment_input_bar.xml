<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/comment_bar"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <View
        android:layout_gravity="bottom"
        android:background="0x7f0828c1"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <p151v.VEditText
            android:textSize="14sp"
            android:textColorHint="@color/text_light"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:background="@null"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="4dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/MESSAGES_TEXTFIELD_PLACEHOLDER"
            android:maxLines="3"
            android:maxLength="180"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            app:typeface="regular"
            style="@style/v_edit_text"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/orange_disabled_light"
            android:gravity="center"
            android:id="@+id/send"
            android:background="@drawable/tf_rect_light"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/MESSAGES_SEND"
            android:singleLine="true"
            android:textAllCaps="true"
            app:typeface="medium"/>
    </LinearLayout>
    <View
        android:id="@+id/lock_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="-48dp"/>
</LinearLayout>
