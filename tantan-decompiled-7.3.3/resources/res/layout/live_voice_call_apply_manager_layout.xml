<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.applymanager.VoiceLiveApplyManagerEnterViewModel xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="42dp"
    flatten="true"
    folder="voice"
    holder="applymanager.VoiceLiveApplyManagerEnterViewModel">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/live_shape_voice_call_apply_manager_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="6dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/LIVE_VOICE_APPLICATION"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/red_dot"
        android:background="@drawable/live_bg_ff6464_r10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxHeight="20dp"
        android:minWidth="20dp"
        android:text="0"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.applymanager.VoiceLiveApplyManagerEnterViewModel>
