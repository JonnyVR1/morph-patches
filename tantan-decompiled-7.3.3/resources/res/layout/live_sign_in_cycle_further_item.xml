<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.signin.main.SignInCycleFurtherView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/live_shape_sign_in_cycle_further_item_bg"
    android:layout_width="62dp"
    android:layout_height="94dp"
    flatten="true"
    folder="common.signin.main"
    holder="SignInCycleFurtherView">
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@android:color/white"
        android:id="@+id/day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/gift_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="30dp"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/gift_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.signin.main.SignInCycleFurtherView>
