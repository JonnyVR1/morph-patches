<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_r10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_black_80_opacity"
            android:id="@+id/tv_game_over"
            android:paddingLeft="22dp"
            android:paddingTop="8dp"
            android:paddingRight="22dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="终止游戏"/>
        <p151v.VText
            android:textColor="@color/live_black_80_opacity"
            android:id="@+id/tv_game_reset"
            android:paddingLeft="22dp"
            android:paddingTop="8dp"
            android:paddingRight="22dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置游戏"/>
        <p151v.VText
            android:textColor="@color/live_black_80_opacity"
            android:id="@+id/tv_game_rule"
            android:paddingLeft="22dp"
            android:paddingTop="8dp"
            android:paddingRight="22dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="游戏说明"/>
    </p151v.VLinear>
</p151v.VFrame>
