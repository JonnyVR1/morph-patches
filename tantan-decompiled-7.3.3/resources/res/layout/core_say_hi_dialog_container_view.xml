<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.sayHi.view.SayHiDialogContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="sayHi.view.SayHiDialogContainer">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/say_hi_anim_rl"
        android:background="@drawable/core_say_hi_dialog_content_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/say_hi_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/dialog_rl"
        android:background="@drawable/core_say_hi_dialog_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:id="@+id/right_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f08163b"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/head_anim"
            android:layout_width="199dp"
            android:layout_height="157dp"
            android:layout_marginTop="40dp"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_B14BB3"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:layout_below="@+id/head_anim"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_40percent_B14BB3"
            android:ellipsize="end"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_value_one"
            android:background="@drawable/core_say_hi_dialog_item_unselected_bg"
            android:paddingLeft="22dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/sub_title"
            android:layout_centerHorizontal="true"
            flatten="true">
            <p151v.VImage
                android:id="@+id/item_value_one_ic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f081640"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/core_color_80percent_D05CD3"
                android:ellipsize="end"
                android:id="@+id/item_value_one_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                app:autoEmojis="true"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_value_two"
            android:background="@drawable/core_say_hi_dialog_item_unselected_bg"
            android:paddingLeft="22dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/item_value_one"
            android:layout_centerHorizontal="true"
            flatten="true">
            <p151v.VImage
                android:id="@+id/item_value_two_ic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f081640"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/core_color_80percent_D05CD3"
                android:ellipsize="end"
                android:id="@+id/item_value_two_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                app:autoEmojis="true"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_value_three"
            android:background="@drawable/core_say_hi_dialog_item_unselected_bg"
            android:paddingLeft="22dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/item_value_two"
            android:layout_centerHorizontal="true"
            flatten="true">
            <p151v.VImage
                android:id="@+id/item_value_three_ic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f081640"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/core_color_80percent_D05CD3"
                android:ellipsize="end"
                android:id="@+id/item_value_three_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                app:autoEmojis="true"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"/>
        </p151v.VLinear>
        <FrameLayout
            android:id="@+id/input_content"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="32dp"
            android:layout_below="@+id/item_value_three">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="@color/core_color_80percent_D05CD3"
                android:textColorHint="@color/core_color_40percent_D05CD3"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/input_edit"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="60dp"
                android:maxLines="1"
                android:maxLength="20"
                android:inputType="text"
                app:autoEmojis="true"
                app:enableApngEmojis="true"
                app:enableEmojis="true"
                app:largeEmojis="true"
                flatten="true"/>
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/core_color_FF84FB"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="发送"
                android:singleLine="true"/>
        </FrameLayout>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.sayHi.view.SayHiDialogContainer>
