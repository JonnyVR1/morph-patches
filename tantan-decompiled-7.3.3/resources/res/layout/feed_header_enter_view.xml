<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.view.FeedUserHeaderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="view.FeedUserHeaderView">
    <p151v.VLinear
        android:gravity="center"
        android:id="@+id/header1_ll"
        android:background="@drawable/bg_round_white"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        useId="true">
        <p151v.VDraweeView
            android:id="@+id/header1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:roundAsCircle="true"
            useId="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:id="@+id/header2_ll"
        android:background="@drawable/bg_round_white"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        useId="true">
        <p151v.VDraweeView
            android:id="@+id/header2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:roundAsCircle="true"
            useId="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:id="@+id/header3_ll"
        android:background="@drawable/bg_round_white"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginLeft="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        useId="true">
        <p151v.VDraweeView
            android:id="@+id/header3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:roundAsCircle="true"
            useId="true"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.feed.newui.view.FeedUserHeaderView>
