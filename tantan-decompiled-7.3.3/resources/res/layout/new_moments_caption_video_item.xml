<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.mediapicker.NewCaptionVideoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roundedCornerRadius="10dp"
        style="@style/feed_post_fresco_moment_small"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/play"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/feed_message_video_play_icon"/>
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/loading"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="10dp"
        android:indeterminateOnly="true"
        app:cpb_color="#d34530"
        app:cpb_stroke_percentage="0.1"/>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="5dp"
        android:src="0x7f081e5f"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/delete_new_ui_ab"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="6dp"
        android:src="0x7f081e60"
        android:scaleType="fitXY"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/feed_post_bg_selected_video_cover"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/FEED_POST_CHOOSE_VIDEO_COVER"/>
</com.p051p1.mobile.putong.feed.newui.mediapicker.NewCaptionVideoView>
