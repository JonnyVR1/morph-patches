<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.widget.RotatingDiscView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.widget.RotatingDiscView">
    <com.sunshine.engine.particle.SceneView
        android:layout_gravity="bottom|right"
        android:id="@+id/scene"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginRight="6dp"/>
    <FrameLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/layout_disc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="18dp"
        flatten="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_disc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0829b9"
            style="@style/feed_rotating_disc"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/iv_album_image"
            android:layout_width="32.5dp"
            android:layout_height="32.5dp"
            style="@style/feed_rotating_disc"/>
        <p151v.VHollowCircleDraweeView
            android:layout_gravity="center"
            android:id="@+id/iv_ui1_follow_image"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            style="@style/feed_rotating_disc"/>
    </FrameLayout>
</com.p051p1.mobile.putong.feed.newui.camera.widget.RotatingDiscView>
