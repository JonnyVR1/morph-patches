<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.VoiceCardAnchorLevelView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_r16"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    app:layout_gravity="center"
    folder="voice"
    holder="usercard.view.VoiceCardAnchorLevelView">
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/level_rl"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/level_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopEnd="true"
            app:roundTopStart="true"
            app:roundedCornerRadius="16dp"
            flatten="true"/>
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerVertical="true"
            app:actualImageScaleType="fitXY"/>
        <p151v.VText
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_toRightOf="@+id/icon"
            android:inputType="number"/>
        <p151v.VMarqueeText
            android:textSize="10sp"
            android:textColor="@color/live_white"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/LIVE_ANCHOR_RANK"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon"
            android:layout_below="@+id/level"
            android:marqueeRepeatLimit="1"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/exp_rl"
        android:background="@drawable/live_shape_user_card_anchor_level_stroke"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/exp_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopEnd="true"
            app:roundTopStart="true"
            app:roundedCornerRadius="16dp"
            flatten="true"/>
        <p151v.VFrame
            android:id="@+id/shadow_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            flatten="true">
            <View
                android:id="@+id/shadow_line"
                android:layout_width="0dp"
                android:layout_height="match_parent"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:gravity="center_horizontal"
            android:id="@+id/exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_70_opacity"
            android:gravity="center_horizontal"
            android:id="@+id/gap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/LIVE_NEED_HEARTBEAT_TO_LEVEL_UP"
            android:layout_below="@+id/exp"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center_horizontal"
            android:id="@+id/full"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_USER_FULL_SCALE"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
</com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.VoiceCardAnchorLevelView>
