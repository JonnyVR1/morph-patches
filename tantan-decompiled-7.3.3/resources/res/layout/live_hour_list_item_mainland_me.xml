<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.HourBoardMainlandMeItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_25252c_r24"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    folder="increment"
    holder="leaderboard.hourleaderboard.mainland.HourBoardMainlandMeItemView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/rank"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="52dp"
            fresco:failureImage="@drawable/live_vector_default_avatar_bg"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"
            fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
            fresco:roundAsCircle="true"/>
        <include
            android:id="@+id/live_tag"
            android:layout_width="21dp"
            android:layout_height="15dp"
            android:layout_marginTop="44dp"
            fresco:layout_constraintEnd_toEndOf="@+id/avatar"
            fresco:layout_constraintStart_toStartOf="@+id/avatar"
            fresco:layout_constraintTop_toTopOf="@+id/avatar"
            layout="@layout/live_hour_board_list_mainland_living_view"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            fresco:layout_constraintBottom_toTopOf="@+id/live_gender"
            fresco:layout_constraintEnd_toStartOf="@+id/heart"
            fresco:layout_constraintStart_toEndOf="@+id/avatar"
            fresco:layout_constraintTop_toTopOf="parent"
            fresco:layout_constraintVertical_chainStyle="packed"/>
        <include
            android:id="@+id/live_gender"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintStart_toStartOf="@+id/name"
            fresco:layout_constraintTop_toBottomOf="@+id/name"
            layout="@layout/live_user_gender_medal_view"/>
        <p151v.VDraweeView
            android:id="@+id/live_level"
            android:layout_width="32dp"
            android:layout_height="14dp"
            android:layout_marginStart="5dp"
            fresco:actualImageScaleType="fitXY"
            fresco:layout_constraintBottom_toBottomOf="@+id/live_gender"
            fresco:layout_constraintStart_toEndOf="@+id/live_gender"
            fresco:layout_constraintTop_toTopOf="@+id/live_gender"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/medal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            fresco:constraint_referenced_ids="live_gender, live_level"/>
        <p151v.VProgressBar
            android:id="@+id/live_progressBar"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="30dp"
            fresco:layout_constraintEnd_toStartOf="@+id/heart"
            fresco:layout_constraintStart_toStartOf="@+id/name"
            fresco:layout_constraintTop_toBottomOf="@+id/name"
            style="@style/live_hour_board_mainland_progress_horizontal"/>
        <com.p051p1.mobile.putong.live.livingroom.view.rollview.LiveTextRollView
            android:layout_gravity="center"
            android:id="@+id/live_roll_text"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_marginStart="6dp"
            fresco:contentTextColor="@color/live_white_40_opacity"
            fresco:contentTextSize="9sp"
            fresco:layout_constraintBottom_toBottomOf="@+id/live_progressBar"
            fresco:layout_constraintEnd_toEndOf="@+id/live_progressBar"
            fresco:layout_constraintStart_toStartOf="@+id/live_progressBar"
            fresco:layout_constraintTop_toTopOf="@+id/live_progressBar"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/progress_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            fresco:constraint_referenced_ids="live_progressBar, live_roll_text"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="end|center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintEnd_toEndOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.HourBoardMainlandMeItemView>
