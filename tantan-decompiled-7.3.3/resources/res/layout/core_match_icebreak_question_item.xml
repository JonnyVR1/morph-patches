<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="43dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="43dp"
    android:layout_marginBottom="5dp"
    android:layout_marginHorizontal="43dp"
    android:layout_marginVertical="5dp">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_cc000000"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/question"
        android:background="@drawable/core_match_ice_break_emoji_item_background"
        android:paddingLeft="20dp"
        android:paddingTop="17dp"
        android:paddingRight="20dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:layout_alignTop="@+id/exclusive_icon"
        android:paddingHorizontal="20dp"
        android:paddingVertical="17dp"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:largeEmojis="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:layout_gravity="top|right"
        android:id="@+id/exclusive_icon"
        android:background="@drawable/core_match_ice_break_exclusive_item_background"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="专属"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="9dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"/>
</RelativeLayout>
