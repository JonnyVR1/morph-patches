<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.voiceslipcard.chatroom.LiveVoiceActivitiesEntryOriginStyleTwo xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/live_list_voice_activities_entry_read_bg"
    android:layout_width="wrap_content"
    android:layout_height="70dp"
    flatten="true"
    folder="voiceslipcard"
    holder="chatroom.LiveVoiceActivitiesEntryOriginStyleTwo">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_margin="8dp"/>
    <p151v.VMarqueeText
        android:textSize="14sp"
        android:textColor="@color/live_black"
        android:ellipsize="marquee"
        android:id="@+id/title_text"
        android:layout_width="79dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="79dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/svga"
        android:layout_alignTop="@+id/svga"
        android:marqueeRepeatLimit="marquee_forever"
        android:fontFamily="PingFangSC-Semibold"
        android:layout_marginEnd="18dp"/>
    <p151v.VMarqueeText
        android:textSize="11sp"
        android:textColor="#929292"
        android:ellipsize="marquee"
        android:id="@+id/desc_text"
        android:layout_width="79dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxWidth="79dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/svga"
        android:layout_below="@+id/title_text"
        android:marqueeRepeatLimit="marquee_forever"
        android:fontFamily="PingFangSC-Regular"
        android:layout_marginEnd="18dp"/>
</com.p051p1.mobile.putong.live.external.voiceslipcard.chatroom.LiveVoiceActivitiesEntryOriginStyleTwo>
