<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomExpandedBasicInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomExpandedBasicInfoView">
    <p151v.VText
        android:textSize="26sp"
        android:textColor="@color/core_color_323232"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/name"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        app:typeface="medium"
        style="@style/core_card_text"/>
    <p151v.VText
        android:textSize="26sp"
        android:textColor="@color/core_color_323232"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:typeface="medium"
        style="@style/core_card_text"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/pic_tag_icon"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="0x7f0818bf"
        android:layout_marginStart="6dp"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/pic_tag_small_intl"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/vip_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/wealth_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"/>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomExpandedBasicInfoView>
