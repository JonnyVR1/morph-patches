<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/core_recorder_media_dlg_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close_dlg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            app:srcCompat="@drawable/core_update_avatar_dlg_delete"/>
        <p151v.VText
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="上传更多照片"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#999999"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="分享更多照片有更大概率获得喜欢！"/>
        <FrameLayout
            android:id="@+id/content_layout"
            android:paddingTop="22dp"
            android:paddingBottom="64dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@drawable/core_btn_done_text_color_selector"
            android:gravity="center"
            android:id="@+id/done"
            android:background="@drawable/core_btn_done_bg_selector"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="46dp"
            android:text="完成"/>
    </LinearLayout>
</FrameLayout>
