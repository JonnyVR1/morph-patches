<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/tips_img"
            android:layout_width="35dp"
            android:layout_height="35dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_33000000"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tips_txt"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最有趣的旅行照"
        android:paddingHorizontal="10dp"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_33000000"
        android:gravity="center"
        android:id="@+id/tips_picture_integrity"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text=""/>
</p151v.VLinear>
