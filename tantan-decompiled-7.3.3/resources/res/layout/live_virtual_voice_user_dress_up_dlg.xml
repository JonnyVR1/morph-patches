<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="@drawable/live_bg_191919_tr24"
    android:layout_width="match_parent"
    android:layout_height="464dp"
    flatten="true"
    folder="virtual.userCard.dressup"
    holder="VirtualUserDressUpViewDlg">
    <com.p051p1.mobile.putong.live.base.view.DialogTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="61dp"/>
    <View
        android:id="@+id/top_divider"
        android:background="@color/live_white_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"/>
    <p151v.VRecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/recycler"
        android:paddingTop="10dp"
        android:paddingBottom="30dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="0x7f0823e0"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white_30_opacity"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="24dp"
            android:text="暂未佩戴任何装扮"/>
    </p151v.VLinear>
</LinearLayout>
