<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/media"
    android:background="#f4f4f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:divider="@drawable/messages_media_divider_vertical"
    android:showDividers="middle">
    <LinearLayout style="@style/messages_media_col">
        <p151v.VLinear
            android:id="@+id/mild_question"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/messages_media_item_frame">
            <p151v.VImage
                android:src="0x7f0828ca"
                style="@style/core_messages_media_item_image"/>
            <p151v.VText
                android:text="@string/INTERACTION_MILD_QUESTION"
                style="@style/core_messages_media_item_text"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:id="@+id/camera"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/messages_media_item_frame">
            <p151v.VImage
                android:src="0x7f0828c4"
                style="@style/core_messages_media_item_image"/>
            <p151v.VText
                android:text="@string/INTERACTION_CAMERA"
                style="@style/core_messages_media_item_text"/>
        </p151v.VLinear>
    </LinearLayout>
    <LinearLayout style="@style/messages_media_col">
        <p151v.VLinear
            android:id="@+id/intimate_question"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/messages_media_item_frame">
            <p151v.VImage
                android:src="0x7f0828c7"
                style="@style/core_messages_media_item_image"/>
            <p151v.VText
                android:text="@string/INTERACTION_INTIMATE_QUESTION"
                style="@style/core_messages_media_item_text"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/location"
            android:layout_height="0dp"
            android:layout_weight="1"
            flatten="true"
            style="@style/messages_media_item_frame">
            <p151v.VLinear
                android:layout_gravity="center"
                android:background="@color/transparent"
                style="@style/messages_media_item_frame">
                <p151v.VImage
                    android:src="0x7f0828c8"
                    style="@style/core_messages_media_item_image"/>
                <p151v.VText
                    android:text="@string/INTERACTION_SEND_LOCATION"
                    style="@style/core_messages_media_item_text"/>
            </p151v.VLinear>
        </p151v.VFrame>
    </LinearLayout>
    <LinearLayout style="@style/messages_media_col">
        <p151v.VLinear
            android:id="@+id/picture"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/messages_media_item_frame">
            <p151v.VImage
                android:src="0x7f0828c9"
                style="@style/core_messages_media_item_image"/>
            <p151v.VText
                android:text="@string/INTERACTION_SEND_PHOTO"
                style="@style/core_messages_media_item_text"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/voice_call"
            android:layout_height="0dp"
            android:layout_weight="1"
            flatten="true"
            style="@style/messages_media_item_frame">
            <p151v.VLinear
                android:layout_gravity="center"
                android:background="@color/transparent"
                style="@style/messages_media_item_frame">
                <p151v.VImage
                    android:src="0x7f081007"
                    style="@style/core_messages_media_item_image"/>
                <p151v.VText
                    android:text="@string/VOICE_CALL_BUTTON"
                    style="@style/core_messages_media_item_text"/>
            </p151v.VLinear>
        </p151v.VFrame>
    </LinearLayout>
</LinearLayout>
