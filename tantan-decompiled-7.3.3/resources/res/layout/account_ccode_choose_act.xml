<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="accountnew.loginopt.viewmodel.CCodeChooseViewModel">
    <p151v.VRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bg"/>
    <include
        android:id="@+id/top"
        flatten="true"
        layout="@layout/account_sign_common_top_view"/>
    <View
        android:id="@+id/top_bg"
        android:background="@color/common_white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/top"/>
    <p151v.VSearchBar
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/LOGIN_SEARCH_COUNTRY"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@+id/top_bg"
        app:searchbar_cancel_behavior="behavior_extinct"/>
</androidx.constraintlayout.widget.ConstraintLayout>
