<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.panel.NewGiftPanelItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="0x7f0808a3"
    android:clipChildren="true"
    android:clipToPadding="false"
    android:layout_width="155dp"
    android:layout_height="220dp"
    android:layout_marginLeft="-16dp"
    holder="gift.panel.NewGiftPanelItemView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="125dp"
        android:layout_height="190dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/item_bg"
            android:background="@drawable/core_gift_newpanel_item_default_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"/>
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="93dp"
            android:layout_height="93dp"
            android:layout_marginTop="28dp"
            app:failureImage="@drawable/ic_core_gift_new_loading"
            app:failureImageScaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name_unselected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="5dp"
            android:maxLines="1"
            android:lines="1"
            android:lineSpacingExtra="0sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            app:typeface="medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/coin_unselected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="5dp"
            android:text="9探探币"
            android:lineSpacingExtra="0sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name_unselected"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/selected_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#212121"
                android:ellipsize="end"
                android:id="@+id/name_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:maxLines="1"
                android:lines="1"
                android:lineSpacingExtra="0sp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#ff3a00"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/send"
                android:background="@drawable/core_gift_newpanel_item_send_bg"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:text="赠送"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="8sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tag"
            android:background="@drawable/core_gift_newpanel_item_tag_bg"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/cover"
            android:background="@drawable/core_gift_newpanel_item_cover_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.gift.panel.NewGiftPanelItemView>
