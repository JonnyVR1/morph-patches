<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.intlmeet.tribe.IntlTribeGroupPurse xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="146dp"
    android:layout_height="194dp"
    folder="newui"
    holder="intlmeet.tribe.IntlTribeGroupPurse">
    <p151v.VDraweeView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:roundedCornerRadius="20dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/like_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp">
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="@color/black"
            android:id="@+id/like_count"
            android:background="@drawable/core_intl_tribe_like_bg"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:drawableStart="@drawable/core_intl_tribe_like_icon"
            android:paddingStart="5dp"
            android:paddingEnd="6dp"
            android:paddingVertical="1dp"
            app:fontWeight="500"/>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_intl_tribe_like_tag_icon"/>
    </p151v.VLinear>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:scaleType="center"/>
    <p151v.VText_NoTopPadding
        android:textSize="19sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="83dp"
        android:minHeight="40dp"
        android:maxLines="2"
        android:lineSpacingExtra="-1dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/user_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="148dp">
        <p151v.AutoVDraweeView
            android:id="@+id/user_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:roundedCornerRadius="6dp"/>
        <p151v.AutoVDraweeView
            android:id="@+id/user_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            app:roundedCornerRadius="6dp"/>
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/count"
            android:background="@drawable/core_bg_white_r6"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="20dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="4dp"
            app:fontWeight="500"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.intlmeet.tribe.IntlTribeGroupPurse>
