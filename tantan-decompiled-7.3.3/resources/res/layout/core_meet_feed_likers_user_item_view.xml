<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.feed.likers.MeetLikersUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="newmeet.feed.likers.MeetLikersUserItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/verification_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>
    <p151v.VText
        android:id="@+id/left_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VRelative
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="9dp"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_card_user_text_color_b2ffffff"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:layout_above="@+id/name"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:lines="1"
            android:layout_toLeftOf="@+id/action_btn"
            android:layout_alignLeft="@+id/age"
            android:layout_alignParentBottom="true"/>
        <p151v.VImage
            android:id="@+id/action_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            app:srcCompat="0x7f080e79"/>
    </p151v.VRelative>
    <View
        android:id="@+id/mask"
        android:background="@drawable/core_svip_liked_user_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/core_fresco_base"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/dislike"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081204"/>
    <p151v.VImage
        android:layout_gravity="left"
        android:id="@+id/like"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081205"/>
</com.p051p1.mobile.putong.core.newui.newmeet.feed.likers.MeetLikersUserItemView>
