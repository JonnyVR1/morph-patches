<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.MusicAggregateHeader xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#333333"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    flatten="true"
    folder="newui"
    holder="camera.MusicAggregateHeader">
    <ImageView
        android:id="@+id/music_aggregate_header_background"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="138dp"
        android:layout_height="138dp"
        android:layout_marginTop="46dp">
        <p151v.VDraweeView
            android:id="@+id/music_aggregate_cover"
            android:background="@drawable/music_aggregate_cover_background"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundAsCircle="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/music_aggregate_player_control"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="0x7f082915"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="194dp"
        android:layout_marginRight="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff3a00"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/music_aggregate_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:maxWidth="140dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/music_aggregate_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/music_aggregate_desc"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="221dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="15dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
</com.p051p1.mobile.putong.feed.newui.camera.MusicAggregateHeader>
