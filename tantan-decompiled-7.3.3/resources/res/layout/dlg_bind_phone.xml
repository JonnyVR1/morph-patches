<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="32dp"
        android:text="@string/CORE_VOICE_PROMPT_NOT_BIND_PHONE"
        android:lines="1"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/oneclick"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:text="186****4417"
        android:lines="1"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="30dp"
        android:text="@string/CORE_VOICE_SHOW_BIND_PHONE_TOAST"
        android:lineSpacingExtra="3dp"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/verify"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="12dp">
        <LinearLayout
            android:background="@drawable/common_card_middle_02_bg"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/common_black_01"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/ccode"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="70dp"
                android:includeFontPadding="false"
                android:drawableRight="0x7f080558"
                android:paddingStart="14dp"/>
            <p151v.VEditText
                android:textSize="16dp"
                android:textColor="@color/common_black_01"
                android:textColorHint="@color/common_grey_04"
                android:gravity="center_vertical"
                android:id="@+id/username"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/SIGNUP_PHONE_NUMBER"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:maxLength="14"
                android:layout_weight="1"
                android:inputType="phone"
                android:textCursorDrawable="@drawable/core_bind_phone_cursor"
                android:paddingStart="20dp"/>
        </LinearLayout>
        <FrameLayout
            android:background="@drawable/common_card_middle_02_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp">
            <p151v.VEditText
                android:textSize="16dp"
                android:textColor="@color/common_black_01"
                android:textColorHint="@color/common_grey_04"
                android:gravity="center_vertical"
                android:id="@+id/code"
                android:background="@null"
                android:paddingRight="108dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/ENTER_VERIFICATION_CODE"
                android:singleLine="true"
                android:inputType="number"
                android:textCursorDrawable="@drawable/core_bind_phone_cursor"
                android:paddingStart="20dp"/>
            <p151v.VText
                android:enabled="false"
                android:textSize="16dp"
                android:textColor="@color/core_bind_phone_dlg_send_btn_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/get_code"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginRight="12dp"
                android:checked="false"
                android:minHeight="34dp"
                android:text="@string/SIGNUP_GET_CODE"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="@color/common_red"
            android:gravity="center_vertical"
            android:id="@+id/error_code"
            android:background="@drawable/core_sign_input_error_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:drawablePadding="7dp"
            android:drawableStart="0x7f0816b7"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <p151v.VButton
        android:id="@+id/positive_primary"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="32dp"
        style="@style/common_button_large_01"/>
    <p151v.VButton
        android:textColor="@color/common_grey_04"
        android:id="@+id/positive_secondary"
        android:background="@drawable/core_bind_phone_dlg_other_bg"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="32dp"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_04"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/nega"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rule"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="22dp">
        <p151v.VCheckBox
            android:id="@+id/check_box"
            style="@style/common_checkbox"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/common_light_01"
            android:textColorHighlight="@color/transparent"
            android:textColorLink="@color/common_grey_02"
            android:id="@+id/rule_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text=""
            android:minLines="2"
            android:includeFontPadding="false"
            android:translationY="-2dp"/>
    </LinearLayout>
</LinearLayout>
