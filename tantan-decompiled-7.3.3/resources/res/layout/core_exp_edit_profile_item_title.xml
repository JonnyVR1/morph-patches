<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="28dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:gravity="center_vertical"
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="28dp"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/title_right_arrow"
            android:background="0x7f082061"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
    <p151v.VLinear
        android:id="@+id/sub_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/exp_core_profile_integrity_opt"/>
    </p151v.VLinear>
</p151v.VLinear>
