<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/base_root"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.profilelist.imp.ProfileListFragLocalEditImpl">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/edit_profile_navigation_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"
        app:title="@string/NEW_PROFILE_PICTURE_EDIT"/>
    <p151v.VFrame
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/space_view"
            android:background="#fff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="500dp"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:tabBackground="@color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@color/transparent"/>
        <p151v.VFrame
            android:id="@+id/preview_root"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VProgressBar
                android:id="@+id/preview_loading_block"
                android:visibility="visible"
                style="@style/core_loading_block"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/root"
            android:background="@color/white"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VProgressBar
                android:id="@+id/loading_block"
                style="@style/core_loading_block"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/list_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/core_profile_top_warn_layout"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/profile_list"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
            </p151v.VLinear>
        </p151v.VFrame>
    </p151v.VFrame>
</p151v.VLinear>
