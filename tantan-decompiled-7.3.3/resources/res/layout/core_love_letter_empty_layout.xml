<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.loveletter.LoveLetterEmptyLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="208dp">
    <p151v.AutoVDraweeView
        android:id="@+id/empty_pic"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="18dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#4d323232"
        android:gravity="center_horizontal"
        android:id="@+id/empty_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="暂无配对\10去划卡认识新朋友吧"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/empty_btn"
        android:background="@drawable/core_o_diamond_visitor_guide_btn"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="16dp"
        android:text="去划卡"/>
</com.p051p1.mobile.putong.core.newui.loveletter.LoveLetterEmptyLayout>
