<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.titleline.LiveTitleLineCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="9dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:background="@drawable/live_shape_card_title_line_bg_dark"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="16dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="40dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white_40_opacity"
            android:layout_gravity="center"
            android:id="@+id/content_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.titleline.LiveTitleLineCardView>
