<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.active.SpotlightActiveCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="active.SpotlightActiveCard">
    <p151v.VDraweeView
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"/>
    <TextView
        android:textSize="32sp"
        android:textColor="#ffffff"
        android:gravity="top|center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.08"/>
    <p151v.VDraweeView
        android:id="@+id/desc_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:layout_constraintDimensionRatio="359:330"
        app:layout_constraintHeight_percent="0.526"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintWidth_default="percent"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="top|center_horizontal"
        android:id="@+id/desc_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc_img"/>
    <p151v.VImage
        android:layout_gravity="bottom"
        android:id="@+id/btn_bottom"
        android:background="0x7f080aaa"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.904"
        app:layout_goneMarginEnd="24dp"
        style="?android:attr/borderlessButtonStyle"/>
    <p151v.VImage
        android:id="@+id/iv_close"
        android:background="0x7f080cd3"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_bottom"
        app:layout_constraintTop_toTopOf="@+id/btn_bottom"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ff6002"
        android:id="@+id/btn_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="@+id/btn_bottom"
        app:layout_constraintRight_toRightOf="@+id/btn_bottom"
        app:layout_constraintTop_toTopOf="@+id/btn_bottom"/>
</com.p051p1.mobile.putong.core.p058ui.active.SpotlightActiveCard>
