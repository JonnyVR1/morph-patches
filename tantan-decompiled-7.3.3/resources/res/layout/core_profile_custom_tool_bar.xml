<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_tool_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    flatten="true"
    holder="profile.views.ProfileCustomBar">
    <View
        android:id="@+id/bar_bg"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/normal_bar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <ImageView
            android:id="@+id/normal_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="0x7f080387"/>
        <p151v.VLinear_FillerMeasure
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/name_container"
            android:paddingTop="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            app:fillerIndex="0"
            app:layout_constraintBottom_toBottomOf="@+id/normal_back"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/normal_back"
            app:layout_constraintRight_toLeftOf="@+id/button_follow"
            app:layout_constraintTop_toTopOf="@+id/normal_back"
            flatten="true">
            <p151v.VText
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/name_tv"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:singleLine="true"
                app:typeface="medium"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/avatar_icon"
                android:paddingLeft="4dp"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
            <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                android:layout_gravity="center"
                android:id="@+id/odiamond_label"
                android:paddingLeft="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/img_vip"
                android:paddingLeft="4dp"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="20dp"/>
        </p151v.VLinear_FillerMeasure>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/name"
            android:paddingTop="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/normal_back"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/normal_back"
            app:layout_constraintRight_toLeftOf="@+id/button_follow"
            app:layout_constraintTop_toTopOf="@+id/normal_back"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/orange"
            android:gravity="center"
            android:id="@+id/button_follow"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginRight="16dp"
            android:text="@string/FOLLOW_STATE_WITHOUT_PLUS"
            app:layout_constraintBottom_toBottomOf="@+id/normal_back"
            app:layout_constraintRight_toLeftOf="@+id/normal_menu"
            app:layout_constraintTop_toTopOf="@+id/normal_back"/>
        <p151v.VImage
            android:id="@+id/normal_menu"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="12dp"
            android:src="0x7f081505"
            app:layout_constraintBottom_toBottomOf="@+id/normal_back"
            app:layout_constraintRight_toLeftOf="@+id/normal_bar_edit"
            app:layout_constraintTop_toTopOf="@+id/normal_back"/>
        <p151v.VImage
            android:id="@+id/normal_bar_edit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/core_profile_edit_bar_top"
            app:layout_constraintBottom_toBottomOf="@+id/normal_back"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/normal_back"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bottom_divider"
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
