<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identity_ocr_result_title"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_result_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="@dimen/identity_ocr_main_margin_left"
                android:src="@drawable/identity_ocr_img_comm_close_black"/>
            <View
                android:id="@+id/identity_ocr_result_close"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"/>
        </FrameLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:id="@+id/rl_result_tips"
                        android:background="#ededed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                            android:textColor="#000000"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="15dp"
                            android:layout_marginBottom="10dp"
                            android:text="@string/identity_ocr_result_top_tips"
                            android:layout_toLeftOf="@+id/view_result_tips"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="20dp"
                            android:src="@drawable/identity_ocr_img_comm_close_grey"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <View
                            android:id="@+id/view_result_tips"
                            android:layout_width="40dp"
                            android:layout_height="50dp"
                            android:layout_alignParentRight="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/identity_ocr_main_margin_left">
                        <ImageView
                            android:id="@+id/identity_ocr_id_card_front_default"
                            android:layout_width="wrap_content"
                            android:layout_height="100dp"
                            android:layout_marginBottom="@dimen/identity_ocr_main_margin_left"
                            android:scaleType="fitXY"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/identity_ocr_result_page_card_item_height">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                                    android:textColor="#000000"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/identity_ocr_result_id_id"
                                    android:layout_weight="4"/>
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#8f191f25"
                                    android:gravity="right"
                                    android:id="@+id/identity_ocr_result_id_id"
                                    android:background="#ffffff"
                                    android:paddingRight="10dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_weight="6"/>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginRight="1dp"
                                    android:src="@drawable/identity_ocr_id_next_icon"/>
                            </LinearLayout>
                            <View
                                android:background="#ededed"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/identity_ocr_result_page_card_item_height">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                                    android:textColor="#000000"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/identity_ocr_result_id_personal_name"
                                    android:layout_weight="4"/>
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#8f191f25"
                                    android:gravity="right"
                                    android:id="@+id/identity_ocr_result_id_personal_name"
                                    android:background="#ffffff"
                                    android:paddingRight="10dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_weight="6"/>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginRight="1dp"
                                    android:src="@drawable/identity_ocr_id_next_icon"/>
                            </LinearLayout>
                            <View
                                android:background="#ededed"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/identity_ocr_result_page_card_item_height">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                                    android:textColor="#000000"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/identity_ocr_result_id_sex"
                                    android:layout_weight="4"/>
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#8f191f25"
                                    android:gravity="right"
                                    android:id="@+id/identity_ocr_result_id_sex"
                                    android:background="#ffffff"
                                    android:paddingRight="10dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_weight="6"/>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginRight="1dp"
                                    android:src="@drawable/identity_ocr_id_next_icon"/>
                            </LinearLayout>
                            <View
                                android:id="@+id/view_name_code"
                                android:background="#ededed"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/identity_ocr_result_page_card_item_height">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                                    android:textColor="#000000"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/identity_ocr_result_id_nationality"
                                    android:layout_weight="4"/>
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#8f191f25"
                                    android:gravity="right"
                                    android:id="@+id/identity_ocr_result_id_nationality"
                                    android:background="#ffffff"
                                    android:paddingRight="10dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_weight="6"/>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginRight="1dp"
                                    android:src="@drawable/identity_ocr_id_next_icon"/>
                            </LinearLayout>
                            <View
                                android:background="#ededed"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/identity_ocr_result_page_card_item_height">
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                                    android:textColor="#000000"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/identity_ocr_result_id_address"
                                    android:layout_weight="4"/>
                                <TextView
                                    android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                    android:textColor="#8f191f25"
                                    android:gravity="right"
                                    android:id="@+id/identity_ocr_result_id_address"
                                    android:background="#ffffff"
                                    android:paddingRight="10dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:layout_weight="6"/>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginRight="1dp"
                                    android:src="@drawable/identity_ocr_id_next_icon"/>
                            </LinearLayout>
                        </LinearLayout>
                        <Button
                            android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                            android:textColor="#ffffff"
                            android:layout_gravity="center"
                            android:id="@+id/identity_ocr_result_ok"
                            android:background="@drawable/identity_result_round_shape"
                            android:layout_width="180dp"
                            android:layout_height="45dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/identity_ocr_result_btn_txt"/>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/identity_loading_overlay"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:background="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.8"/>
                </FrameLayout>
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
    <com.idv.identity.platform.IdentityAlertOverlay
        android:id="@+id/identity_alert_overlay"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.idv.identity.platform.iOSLoadingView
        android:layout_gravity="center"
        android:id="@+id/iosLoadingView"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</FrameLayout>
