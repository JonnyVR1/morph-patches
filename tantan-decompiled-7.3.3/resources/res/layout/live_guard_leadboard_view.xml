<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.LiveGuardLeadBoardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="knight.view.leaderboard.LiveGuardLeadBoardView">
    <p151v.VImage
        android:id="@+id/title_bg"
        android:background="@drawable/live_list_guard_dialog_leadboard_header_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/live_guard_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f082689"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_guard_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_guard_name"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/live_guard_name"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/LIVE_GUARD_BOARD"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/live_guard_about"
        android:background="0x7f08268c"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_bg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_bg"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/board_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bg"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.LiveGuardLeadBoardView>
