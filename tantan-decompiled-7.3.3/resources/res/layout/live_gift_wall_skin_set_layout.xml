<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="gift.giftwallnew.skin.LiveGiftWallSkinDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="#111019"
        android:layout_width="match_parent"
        android:layout_height="630dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/bg_svg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,375:274"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <FrameLayout
        android:id="@+id/title_bg"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        app:layout_constraintTop_toTopOf="@+id/bg"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="12dp"
            android:text="至臻礼物"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="36dp"
            android:text="1/8"/>
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f0822f2"
            android:layout_marginStart="16dp"/>
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:layout_width="167dp"
            android:layout_height="8.3dp"
            android:layout_marginTop="58dp"
            android:src="0x7f0822f6"/>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:paddingTop="13dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bg">
        <p151v.VLinear
            android:id="@+id/mini_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            flatten="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_all"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_light"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已点亮"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_selector_80_40_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tab_dark"
                android:background="@drawable/live_selector_voice_gift_wall_local_tab_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未点亮"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/empty_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="0x7f0823e0"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white_40_opacity"
                android:gravity="center_horizontal"
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="24dp"
                android:text="尚未收到礼物，快去收集吧"/>
        </p151v.VLinear>
        <p151v.VRecyclerView
            android:id="@+id/allRecyclerView"
            android:paddingBottom="50dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>
        <p151v.VRecyclerView
            android:id="@+id/lightRecyclerView"
            android:paddingBottom="50dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>
        <p151v.VRecyclerView
            android:id="@+id/darkRecyclerView"
            android:paddingBottom="50dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
