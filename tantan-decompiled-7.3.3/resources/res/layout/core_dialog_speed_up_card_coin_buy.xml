<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VRelative
        android:background="0x7f080535"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/speed_up_coin_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:src="0x7f08094a"
            android:layout_marginStart="20dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="7天有效"
            android:layout_toEndOf="@+id/speed_up_coin_buy"/>
        <p151v.VImage
            android:id="@+id/speed_up_card_coin_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="0x7f080949"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:rotation="-5">
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081332"/>
            <p151v.VText
                android:textSize="16.8sp"
                android:textColor="@color/core_gray_4c4c4c"
                android:layout_gravity="center_horizontal"
                android:id="@+id/speed_up_coin_buy_icon_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="加速卡"/>
        </p151v.VFrame>
    </p151v.VRelative>
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#323232"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="购买次数"
            android:layout_marginStart="20dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <include
                android:id="@+id/speed_up_coin_buy_one"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/core_dialog_speed_up_card_coin_buy_item"/>
            <include
                android:id="@+id/speed_up_coin_buy_ten"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                layout="@layout/core_dialog_speed_up_card_coin_buy_item"/>
            <include
                android:id="@+id/speed_up_coin_buy_twenty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                layout="@layout/core_dialog_speed_up_card_coin_buy_item"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/speed_up_coin_buy_btn"
            android:background="@drawable/core_message_bar_new_reference_bg"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="35dp"
            android:text="立即购买"
            android:layout_marginHorizontal="20dp"
            android:paddingVertical="17dp"/>
    </p151v.VLinear>
</p151v.VLinear>
