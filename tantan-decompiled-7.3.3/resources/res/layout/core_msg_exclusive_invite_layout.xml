<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemExclusiveInviteLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="@drawable/core_exclusive_msg_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="12dp"
            android:src="0x7f0807b1"/>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="14dp">
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/common_black_02"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:text="1v1专属聊天邀请"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/common_grey_03"
                android:gravity="center_vertical"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="3dp"
                android:text="是否愿意30分钟内，只和我聊？"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/action_btn"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="接受邀请 42s"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemExclusiveInviteLayout>
