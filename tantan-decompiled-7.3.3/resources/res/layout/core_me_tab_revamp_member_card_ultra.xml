<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/test1_ultra_card"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="320dp"
    android:layout_height="104dp">
    <p151v.VDraweeView
        android:id="@+id/test1_ultra_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"
        app:roundedCornerRadius="18dp"/>
    <p151v.VDraweeView
        android:layout_gravity="start|top"
        android:id="@+id/test1_ultra_card_bg_line"
        android:visibility="gone"
        android:layout_width="184dp"
        android:layout_height="150dp"
        app:actualImageScaleType="fitXY"/>
    <p151v.VDraweeView
        android:layout_gravity="start|top"
        android:id="@+id/test1_ultra_card_title"
        android:layout_width="200dp"
        android:layout_height="50dp"
        app:actualImageScaleType="fitXY"/>
    <p151v.VText_NoTopPadding
        android:textSize="10sp"
        android:layout_gravity="start|bottom"
        android:id="@+id/test1_ultra_card_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:maxLines="2"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="114dp"
        app:fontWeight="400"/>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="end|top"
        android:id="@+id/test1_ultra_card_svga"
        android:layout_width="84dp"
        android:layout_height="84dp"/>
    <p151v.VDraweeView
        android:layout_gravity="end|top"
        android:id="@+id/test1_ultra_card_icon"
        android:visibility="gone"
        android:layout_width="84dp"
        android:layout_height="84dp"
        app:actualImageScaleType="fitCenter"/>
</p151v.VFrame>
