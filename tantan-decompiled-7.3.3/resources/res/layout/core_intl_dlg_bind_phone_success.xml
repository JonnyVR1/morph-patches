<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    flatten="true"
    holder="dlg.IntlFacebookBindPhoneSuccessDlg">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:layout_width="160dp"
            android:layout_height="142dp"
            android:layout_marginTop="36dp"
            android:src="0x7f08098b"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/WECHAT_BIND_SUCCESS"
            android:maxLines="2"/>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/positive_primary"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp"
            android:text="@string/MESSAGES_CONFIRM"
            style="@style/common_button_large_01"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
