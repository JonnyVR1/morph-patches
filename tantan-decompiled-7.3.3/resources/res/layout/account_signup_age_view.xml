<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    holder="accountai.new2021.view.AgeView">
    <p151v.VFrame
        android:orientation="horizontal"
        android:id="@+id/vl_birth"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        flatten="true">
        <p151v.VEditText
            android:textSize="18dp"
            android:textColor="@color/common_black_01"
            android:textColorHint="@color/common_light_01"
            android:id="@+id/edit_age"
            android:background="@drawable/account_signup_input_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:textCursorDrawable="@drawable/account_signup_ai_cursor"/>
        <p151v.VText
            android:textSize="18dp"
            android:textColor="@color/common_light_01"
            android:layout_gravity="center"
            android:id="@+id/day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="24dp"
            android:text="@string/AI_SIGNUP_AGE_INPUT_UNIT_NEW"
            android:layout_marginStart="8dp"
            app:typeface="medium"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/hint_birth"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <p151v.VButton_FakeShadow
        android:id="@+id/next"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ACTION_CONFIRM"
        style="@style/common_button_large_01"/>
</merge>
