<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fl"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="newui"
    holder="photoalbum.feed.personalfeed.PersonalPhotoAlbumFeedFragViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:background="#e9000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:pointerIcon="text"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/base_frag_container"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_bar"/>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:id="@+id/btn_container"
        android:background="#00000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom|center_horizontal"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/attention"
                android:background="@drawable/feed_personal_follow_btn_bg"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/greet">
                <p151v.VImage
                    android:id="@+id/attention_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:src="0x7f081d26"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/attention_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/greet"
                android:background="@drawable/feed_personal_greet_bg"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:layout_constraintLeft_toRightOf="@+id/attention"
                app:layout_constraintRight_toRightOf="parent">
                <p151v.VImage
                    android:id="@+id/greet_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:src="0x7f081d28"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/greet_tv"
                    android:background="@drawable/feed_personal_greet_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/FEED_GREETING"
                    app:layout_constraintLeft_toRightOf="@+id/attention"
                    app:layout_constraintRight_toRightOf="parent"/>
            </p151v.VLinear>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VRelative
            android:gravity="bottom"
            android:id="@+id/send_message_container"
            android:background="#00000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VButton
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/send_message"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="@string/ACTION_SEND_MESSAGE"
                android:layout_toLeftOf="@+id/un_match_container"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                style="@style/common_button_large_01"/>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/un_match_container"
                android:background="@drawable/feed_personal_follow_bg_select"
                android:paddingLeft="21dp"
                android:paddingRight="21dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginRight="12dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/un_match_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:src="0x7f081d27"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/common_grey_04"
                    android:gravity="center"
                    android:id="@+id/un_match"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="@string/FOLLOW_STATE_EACH_NEWUI"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:background="#00000000"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginLeft="12dp"
                android:layout_toRightOf="@+id/send_message"
                android:layout_centerVertical="true">
                <p151v.VImage
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="13dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="13dp"
                    android:layout_marginBottom="8dp"
                    android:src="0x7f081e0f"/>
            </p151v.VLinear>
        </p151v.VRelative>
        <p151v.VRelative
            android:gravity="bottom"
            android:id="@+id/post_container"
            android:background="#00000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VButton
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/post"
                android:background="@drawable/feed_personal_follow_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/FEED_POST_MOMENT"
                android:layout_centerInParent="true"/>
        </p151v.VRelative>
    </p151v.VFrame>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/btn_moment_like"
        android:background="0x7f081e08"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="164dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/like"
            android:background="@drawable/like_bg_profile_persion_shape"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/greet_envelop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080308"/>
        </p151v.VLinear>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/greet_envelop"
            android:background="@drawable/feed_persion_greet_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <p151v.VDraweeView
                android:id="@+id/greet_tag"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:layout_centerVertical="true"
                app:roundAsCircle="true"/>
            <com.p051p1.mobile.putong.newui.view.CoreAutoScrollTextView
                android:textSize="14sp"
                android:textColor="#26000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/letter_remaining_switcher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="打个招呼给她"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="23dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#26000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/envelop_say_hai"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="打个招呼给她"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffc318"
                android:gravity="center_vertical"
                android:id="@+id/send_btn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/FEED_GREETING"
                android:drawablePadding="3dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
