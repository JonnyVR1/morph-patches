<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    flatten="true"
    folder="newui"
    holder="profile.newmine.newprofile.mytab.MyTabContentViewModel">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/task_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.newui.newmeet.feed.view.MeetItemEntryHeadViewMyTabStyle
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="14dp"
            android:layout_marginHorizontal="14dp"/>
        <FrameLayout
            android:id="@+id/task_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="8dp"/>
    </LinearLayout>
    <include
        android:id="@+id/likers_item_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        flatten="true"
        layout="@layout/core_meet_feed_likers_item_view"/>
    <include
        android:id="@+id/nearby_item_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        flatten="true"
        layout="@layout/core_meet_feed_nearby_item_view"/>
    <p151v.VFrame
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_network_error"
            android:layout_width="220dp"
            android:layout_height="150dp"
            app:srcCompat="@drawable/core_member_empty_result"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#323232"
            android:gravity="center"
            android:id="@+id/tv_network_tips"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="155dp"
            android:layout_marginRight="28dp"
            android:text="暂无更多内容"
            app:typeface="medium"/>
    </p151v.VFrame>
</LinearLayout>
