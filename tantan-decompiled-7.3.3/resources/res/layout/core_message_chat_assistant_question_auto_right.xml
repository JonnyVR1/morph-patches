<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemChatAssistantQuestionAutoRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_new_messages_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="10dp">
        <p151v.VRelative
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp">
            <p151v.VImage
                android:id="@+id/icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/core_message_chat_helper_icon_big"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_66000000"
                android:id="@+id/question_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="向他提了一个你感兴趣的问题"
                android:layout_below="@+id/title"
                android:layout_centerVertical="true"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/icon"/>
        </p151v.VRelative>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/question_layout"
            android:background="@drawable/core_bg_10_ffffff"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_cc000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080ed0"
                android:layout_marginStart="6dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemChatAssistantQuestionAutoRight>
