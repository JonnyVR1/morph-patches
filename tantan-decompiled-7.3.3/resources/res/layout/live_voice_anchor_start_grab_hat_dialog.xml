<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="grabhat.view.AnchorStartGameViewMode">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/live_bg_19191e_tr24"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="62dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:text="@string/LIVE_GRAB_HAT_BECOME_CP"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/rule"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f0827b1"/>
        </FrameLayout>
        <View
            android:background="@drawable/live_bg_white_r3_a03"
            android:layout_width="match_parent"
            android:layout_height="3dp"/>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="395dp"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:textColor="#ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/LIVE_HEADLINE_THEME_RULE_TEXT"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="@color/live_white_60_opacity"
                    android:id="@+id/desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/LIVE_AUDIO_CROWN_HOST_RULE2"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:background="@drawable/live_bg_white_r14_a05"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/LIVE_MVP_CP_HEAD_FRAME"
                        android:drawableLeft="0x7f0827af"
                        android:drawableRight="0x7f0827b0"
                        android:drawablePadding="12dp"/>
                    <p151v.VDraweeView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/decorate_view"
                        android:layout_width="375dp"
                        android:layout_height="81dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"/>
                </p151v.VLinear>
            </LinearLayout>
        </ScrollView>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/start"
            android:background="@drawable/live_bg_ff698f_r14"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="37dp"
            android:layout_marginBottom="12dp"
            android:text="@string/LIVE_GAME_OPEN"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
