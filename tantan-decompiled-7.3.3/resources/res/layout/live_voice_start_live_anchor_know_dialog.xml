<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#4c000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="VoiceCreateRoomDialog">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_r20"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        flatten="true">
        <TextView
            android:textSize="18dp"
            android:textStyle="normal"
            android:textColor="#323232"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/LIVE_VOICE_CREATE_ROOM_DIALOG_TITLE"/>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            flatten="true">
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="#999999"
                android:id="@+id/rule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="8dp"/>
        </ScrollView>
        <TextView
            android:textSize="16dp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/argue_continue"
            android:background="@drawable/live_bg_fe7e1d_r16"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="19dp"
            android:text="@string/LIVE_VOICE_CREATE_ROOM_DIALOG_ARGUE_BUTTON"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="normal"
            android:textColor="#cccccc"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/LIVE_VOICE_CREATE_ROOM_DIALOG_CLOSE"/>
    </LinearLayout>
</FrameLayout>
