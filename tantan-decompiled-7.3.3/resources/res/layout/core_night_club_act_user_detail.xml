<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/core_intl_night_club_act_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="ui"
    holder="nightclub.view.NightClubUserDetailViewModel">
    <p151v.AutoVDraweeView
        android:id="@+id/top_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintDimensionRatio="375:125"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.AutoVDraweeView
        android:id="@+id/bottom_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="375:150"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:src="0x7f080c72"
        android:scaleType="center"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="28dp"
        android:textStyle="bold"
        android:textColor="#fe33a4"
        android:gravity="center"
        android:id="@+id/iv_icon"
        android:background="0x7f080b64"
        android:layout_width="218dp"
        android:layout_height="36dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66801dfe"
        android:gravity="center"
        android:id="@+id/tv_tip_content"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:text="@string/INTL_SPOTLIGHT_INSTRUCT"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        app:typeface="medium"/>
    <View
        android:id="@+id/image_border"
        android:background="#9964d8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="37dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_content"/>
    <p151v.VPager
        android:id="@+id/images"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_content"/>
    <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
        android:layout_gravity="bottom"
        android:id="@+id/image_indicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:indicatorColor="#33ffffff"
        app:indicatorMargin="3dp"
        app:indicatorSelectedColor="@color/white"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"
        app:layout_constraintTop_toTopOf="@+id/images"/>
    <View
        android:background="@drawable/core_spotlight_grey_bg"
        android:layout_width="0dp"
        android:layout_height="176dp"
        app:layout_constraintBottom_toBottomOf="@+id/images"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"/>
    <include
        android:id="@+id/card_baseinfo_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/usercontent_view"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"
        layout="@layout/core_card_bottom_basic_info"/>
    <include
        android:id="@+id/usercontent_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="88dp"
        app:layout_constraintBottom_toBottomOf="@+id/images"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"
        layout="@layout/core_card_user_content_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_sendmsg"
        android:background="@drawable/core_intl_purple_801dfe_radius_14"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="56dp"
        android:text="@string/INTL_MKT_TWCLUB_LIKE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:typeface="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
