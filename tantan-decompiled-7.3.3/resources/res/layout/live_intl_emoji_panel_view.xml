<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.VoiceGiftWallTabLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/tab_layout"
        android:background="@color/transparent"
        android:fadingEdgeLength="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:requiresFadingEdge="horizontal"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="0dp"
        app:tabMaxWidth="0dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="2dp"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="@color/transparent"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="11dp">
        <p151v.VRecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/dynamic_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VRecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/random_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</p151v.VLinear>
