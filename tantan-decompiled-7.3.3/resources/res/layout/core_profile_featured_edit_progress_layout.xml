<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_featured_progress"
    android:background="@drawable/core_profile_featured_progress_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="42dp"
    android:layout_marginRight="20dp"
    android:minHeight="60dp"
    flatten="true">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp">
        <com.p051p1.mobile.putong.core.p058ui.profile.views.RingProgressBarView
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:circle_radius="17.5dp"
            app:stroke_width="3dp"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/core_profile_featured_progress_img"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:layout_marginEnd="10dp"
            app:typeface="medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:ellipsize="end"
            android:layout_gravity="bottom"
            android:id="@+id/sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="12dp"
            android:text="全部完成即可解锁精选，认识更多优质朋友"
            android:maxLines="1"
            android:layout_marginEnd="10dp"
            app:typeface="medium"/>
    </p151v.VLinear>
</p151v.VFrame>
