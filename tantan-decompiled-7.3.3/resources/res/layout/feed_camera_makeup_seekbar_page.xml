<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.widget.FeedMakeupSeekbarPageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/feed_camera_makeup_menu_root"
    android:background="#00ffffff"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.widget.FeedMakeupSeekbarPageView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="bottom"
        android:id="@+id/makeup_filter_seekbar_layout"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <View
            android:id="@+id/camera_makeup_filter_empty"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/makeup_filter_seekbar"/>
        <com.p051p1.mobile.putong.feed.newui.camera.widget.FeedTextSeekBar
            android:id="@+id/makeup_filter_seekbar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/camera_makeup_filter_empty"
            app:layout_constraintRight_toLeftOf="@+id/makeup_filter_seekbar_title"
            app:layout_constraintTop_toTopOf="parent"
            app:progressDrawable="@drawable/feed_camera_filter_seek_bar"
            app:progressHeight="4dp"
            app:textBgHeight="30dp"
            app:textBgWidth="40dp"
            app:textColor="#ffffff"
            app:textPaddingTop="10dp"
            app:textSize="16sp"
            app:thumb="@drawable/feed_camera_filter_seek_bar_thumb"
            app:thumbHeight="32dp"
            app:thumbWidth="23dp"/>
        <p151v.VText
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/makeup_filter_seekbar_title"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="滤镜"
            app:layout_constraintBottom_toBottomOf="@+id/makeup_filter_seekbar"
            app:layout_constraintLeft_toRightOf="@+id/makeup_filter_seekbar"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="bottom"
        android:id="@+id/makeup_all_seekbar_layout"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VImage
            android:id="@+id/makeup_compare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:src="0x7f081ca1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/makeup_all_seekbar"/>
        <com.p051p1.mobile.putong.feed.newui.camera.widget.FeedTextSeekBar
            android:id="@+id/makeup_all_seekbar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/makeup_compare"
            app:layout_constraintRight_toLeftOf="@+id/makeup_all_seekbar_title"
            app:progressDrawable="@drawable/feed_camera_filter_seek_bar"
            app:progressHeight="4dp"
            app:textBgHeight="30dp"
            app:textBgWidth="40dp"
            app:textColor="#ffffff"
            app:textPaddingTop="10dp"
            app:textSize="16sp"
            app:thumb="@drawable/feed_camera_filter_seek_bar_thumb"
            app:thumbHeight="32dp"
            app:thumbWidth="23dp"/>
        <p151v.VText
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/makeup_all_seekbar_title"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="整妆"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/makeup_all_seekbar"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.feed.newui.camera.widget.FeedMakeupSeekbarPageView>
