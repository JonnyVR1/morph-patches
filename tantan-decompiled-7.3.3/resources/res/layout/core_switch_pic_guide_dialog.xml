<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/core_message_switch_pic_guide_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:background="0x7f080fda"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/popup_pagers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VPager
            android:id="@+id/popup_pager"
            android:layout_width="match_parent"
            android:layout_height="245dp"
            android:overScrollMode="never"/>
        <p151v.VPagerCircleIndicator
            android:layout_gravity="start"
            android:id="@+id/popup_indicator"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="32dp"
            app:fillColor="@color/common_orange"
            app:pageColor="@color/common_light_02"
            app:radius="3.5dp"/>
    </p151v.VLinear>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/common_white_01"
        android:gravity="center"
        android:id="@+id/go_use"
        android:background="@drawable/common_button_btn_orange_small"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="32dp"
        android:text="去使用"
        android:layout_below="@+id/img"/>
</p151v.VLinear>
