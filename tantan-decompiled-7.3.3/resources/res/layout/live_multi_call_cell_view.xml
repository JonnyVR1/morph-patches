<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.view.MultiCallCellTopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="recreation"
    holder="multiCall.view.MultiCallCellTopView">
    <p151v.VFrame
        android:id="@+id/layout_voice_call"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@color/live_white_05_opacity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.view.LiveWaveVoiceView
            android:layout_gravity="center"
            android:id="@+id/volume_wave"
            android:layout_width="36dp"
            android:layout_height="24dp"
            app:lineColor="#80ffffff"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_call_join"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/join_call_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="0x7f0823e9"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/join_call_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/LIVE_MULTI_CALL_APPLY_CALL"
            android:maxLines="1"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_leave"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/leave_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="0x7f0823f2"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/leave_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/LIVE_MULTI_CALL_OTHER_PAUSE"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/call_position"
        android:background="@drawable/live_bg_black_r7_a40"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/lead_role"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:text="@string/LIVE_MULTI_CALL_LEAD_ROLE"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:gravity="center"
        android:id="@+id/mute"
        android:background="@drawable/live_bg_black_r7_a40"
        android:padding="1.5dp"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:src="0x7f0823f4"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_mask"
        android:background="@drawable/live_shape_multi_call_cell_bottom_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1566"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:id="@+id/user_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/follow"
        app:layout_constraintEnd_toStartOf="@+id/follow"
        app:layout_goneMarginBottom="8dp"
        app:layout_goneMarginEnd="8dp"/>
    <p151v.VImage
        android:id="@+id/follow"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="8dp"
        android:src="0x7f0823ed"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/heart_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/pk_points"
        android:background="@drawable/live_bg_black_r6_a40"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="旁观者"
        android:drawablePadding="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/svga_target_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toStartOf="@+id/pk_points"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/effect_svga"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/pk_points"
        app:layout_constraintStart_toStartOf="@+id/svga_target_space"/>
    <p151v.VDraweeView
        android:id="@+id/join_avatar"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/join_hint"
        android:paddingTop="4dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:maxWidth="110dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Semibold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/join_avatar"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.view.MultiCallCellTopView>
