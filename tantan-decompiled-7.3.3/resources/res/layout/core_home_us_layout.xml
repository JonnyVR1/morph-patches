<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.operation.HomeViewUSLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="home.card.operation.HomeViewUSLayout">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_us_profile"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_viewprofile"
            android:background="@drawable/core_bg_view_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="92dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_viewprofile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_US_VIEWPROFILE"
            android:includeFontPadding="false"
            android:drawableRight="0x7f080796"
            android:drawablePadding="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_viewprofile"
            app:layout_constraintLeft_toLeftOf="@+id/view_viewprofile"
            app:layout_constraintRight_toRightOf="@+id/view_viewprofile"
            app:layout_constraintTop_toTopOf="@+id/view_viewprofile"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:id="@+id/buttons_us_temp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="27dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/immediately_match_temp"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#d26efa"
            app:buttonColorStart="#d26efa"
            app:icon="@drawable/core_intl_top_immediately_match"
            app:iconWidth="32dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/superlike_us_temp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#2bccff"
            app:buttonColorStart="#2bccff"
            app:icon="0x7f08178b"
            app:iconWidth="25dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/like_us_temp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_like_end"
            app:buttonColorStart="@color/core_card_ic_us_like_start"
            app:icon="0x7f0820fb"
            app:iconWidth="25dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/dislike_us_temp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_dislike"
            app:buttonColorStart="@color/core_card_ic_us_dislike"
            app:icon="0x7f081a79"
            app:iconWidth="20dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/undo_us_temp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_undo"
            app:buttonColorStart="@color/core_card_ic_us_undo"
            app:icon="0x7f082a77"
            app:iconHeight="20dp"
            app:iconWidth="26dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:id="@+id/buttons_us_card"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="27dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/immediately_match_card"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#ffffff"
            app:buttonColorStart="#ffffff"
            app:buttonFillBounds="true"
            app:icon="0x7f081fc8"
            app:iconWidth="49.5dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/compliment_card"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#ffffff"
            app:buttonColorStart="#ffffff"
            app:buttonFillBounds="true"
            app:icon="0x7f080a8a"
            app:iconWidth="49.5dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/superlike_us_card"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#ffffff"
            app:buttonColorStart="#ffffff"
            app:buttonFillBounds="true"
            app:icon="0x7f081fcb"
            app:iconWidth="49.5dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/like_us_card"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#ffffff"
            app:buttonColorStart="#ffffff"
            app:buttonFillBounds="true"
            app:icon="0x7f081fc6"
            app:iconWidth="49.5dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/dislike_us_card"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#ffffff"
            app:buttonColorStart="#ffffff"
            app:buttonFillBounds="true"
            app:icon="0x7f081fc4"
            app:iconWidth="49.5dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/undo_us_card"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#ffffff"
            app:buttonColorStart="#ffffff"
            app:buttonFillBounds="true"
            app:icon="0x7f081fcc"
            app:iconWidth="49.5dp"/>
    </LinearLayout>
    <p151v.VLinear
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="bottom"
        android:id="@+id/buttons_us_new"
        android:background="@drawable/core_profile_buttons_bg_expand"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="142dp">
        <p151v.VLinear
            android:id="@+id/btn_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_alignParentBottom="true"
            flatten="true">
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/dislike_shadow"
                android:background="@drawable/core_card_profile_expand_btn_bg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/dislike_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="0x7f081fc4"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
                android:id="@+id/superlike_shadow"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerInside"
                android:layout_marginEnd="20dp"
                app:buttonColorEnd="#ffffff"
                app:buttonColorStart="#ffffff"
                app:icon="0x7f081fcb"
                app:iconHeight="50dp"
                app:iconWidth="50dp"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/like_shadow"
                android:background="@drawable/core_card_profile_expand_btn_bg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/like_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="0x7f081fc6"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <p151v.VLinear
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/match"
                android:background="@drawable/core_card_btn_match_bg"
                android:layout_width="122dp"
                android:layout_height="50dp"
                android:layout_marginBottom="1dp"
                android:elevation="1dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="0x7f081fc7"
                    android:scaleType="centerCrop"/>
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="16sp"
                    android:textColor="#f9e7ff"
                    android:gravity="center"
                    android:id="@+id/match_remaining_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_TTC_INSTANT_MATCH_BTN"
                    android:layout_marginStart="6dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.card.operation.HomeViewUSLayout>
