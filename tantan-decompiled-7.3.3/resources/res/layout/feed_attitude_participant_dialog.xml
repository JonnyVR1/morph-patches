<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/feed_rounded_dialog_indicator"
            android:layout_width="37dp"
            android:layout_height="5dp"
            android:layout_marginTop="15dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/feed_e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="50dp"
            android:text="表态的人"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feed_4c000000"
            android:id="@+id/cancel_attitude"
            android:background="@drawable/feed_bg_rounded_07000"
            android:paddingLeft="15dp"
            android:paddingTop="8dp"
            android:paddingRight="15dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:layout_marginRight="20dp"
            android:text="取消表态"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp">
        <View
            android:background="@color/feed_07000000"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignParentBottom="true"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            app:tabBackground="@color/transparent"
            app:tabIndicatorColor="@color/feed_fe7e1d"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="@color/transparent"/>
    </RelativeLayout>
    <com.p051p1.mobile.putong.feed.newui.photoalbum.attitude.participant.BottomSheetNestedProxyView
        android:id="@+id/nested_proxy_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.p051p1.mobile.putong.feed.newui.photoalbum.attitude.participant.BottomSheetNestedProxyView>
</LinearLayout>
