<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/self_introduction"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileIntroductionItemHolder">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#e6000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/PROFILE_SELF_INTRODUCTION"
        android:layout_marginStart="20dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</p151v.VLinear_Dividers>
