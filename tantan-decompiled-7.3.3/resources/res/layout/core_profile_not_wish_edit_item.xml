<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_do_not_wish"
    android:background="@color/white"
    android:paddingTop="18dp"
    flatten="true"
    holder="profile.profilelist.itemholders.EditDoNotWishItemHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:id="@+id/do_not_wish_title"
            android:paddingTop="0dp"
            android:layout_width="0dp"
            android:text="我不希望你"
            android:layout_weight="1"
            style="@style/profile_item_title_black_edit"/>
        <ImageView
            android:id="@+id/edit_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081495"
            android:layout_marginEnd="20dp"/>
    </p151v.VLinear>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_do_not_wish_edit"
        flatten="true"
        style="@style/profile_item_info">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:id="@+id/do_not_wish_title_edit"
            android:text="添加我不喜欢的类型"
            android:layout_weight="1"
            style="@style/profile_item_item_new"/>
        <ImageView
            android:gravity="center"
            android:paddingRight="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_profile_edit_data_right_add"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_black_80"
        android:layout_gravity="center_vertical"
        android:id="@+id/do_not_wish_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="20dp"/>
</p151v.VLinear_Dividers>
