<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="gift.opt.GiftPanelViewModel">
    <FrameLayout
        android:id="@+id/bg"
        android:background="@color/transparent"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-220dp"
        android:layout_marginBottom="-20dp"
        android:layout_above="@+id/bottom"
        flatten="true">
        <include
            android:id="@+id/gift_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="-25dp"
            layout="@layout/core_gift_layer"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/gift_tip"
            android:background="@drawable/core_gift_newpanel_tip"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="8dp"
            android:text="这是女生们最中意的礼物"
            android:maxLines="1"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bottom"
        android:background="@drawable/core_gift_panel_bottom_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        flatten="true">
        <View
            android:id="@+id/bubble_anchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="28dp"/>
        <p151v.VProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="visible"
            android:layout_marginTop="24dp"
            style="@style/core_loading_block"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/top_ctrl_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                layout="@layout/core_gift_panel_top_bar"/>
            <p151v.VPager
                android:layout_gravity="top"
                android:id="@+id/pager"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="161dp"/>
        </LinearLayout>
    </FrameLayout>
</p151v.VRelative>
