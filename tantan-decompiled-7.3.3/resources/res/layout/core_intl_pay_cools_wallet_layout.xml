<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.wallet.TanTanCoinPayCoolsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#161313"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_below="@+id/coin"
    app:rRadius="12dp"
    app:rStrokeColor="#1fffeed6"
    app:rStrokeWidth="1dp"
    flatten="true"
    holder="wallet.TanTanCoinPayCoolsView"
    innerClass="true">
    <p151v.AutoVDraweeView
        android:id="@+id/icon"
        android:layout_width="81dp"
        android:layout_height="66dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/price"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:layout_toEndOf="@+id/icon">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#f2d9bb"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TANTANCOIN"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#b3e6caab"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/INTL_WALLET_PREMIUM_SKU_SUBTITLE"
            app:typeface="medium"/>
    </p151v.VLinear>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#e6caab"
        android:gravity="center"
        android:id="@+id/price"
        android:background="0x7f080b6e"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        android:minWidth="78dp"
        android:text="@string/TANTANCOIN_RECHARGE_BUTTON"
        android:layout_alignParentEnd="true"/>
</com.p051p1.mobile.putong.core.p058ui.wallet.TanTanCoinPayCoolsView>
