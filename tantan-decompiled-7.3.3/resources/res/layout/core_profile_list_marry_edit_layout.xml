<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingTop="24dp"
    android:paddingBottom="5dp"
    holder="profile.profilelist.itemholders.ProfileMarryEditItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VFrame
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_80"
            android:id="@+id/title"
            android:paddingLeft="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完善更多婚恋资料，帮你寻找理想伴侣"
            app:typeface="regular"/>
        <p151v.VImage
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08145e"
            android:layout_marginEnd="20dp"/>
    </p151v.VFrame>
</p151v.VLinear_Dividers>
