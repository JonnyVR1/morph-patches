<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#2a2f37"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/navigation_space"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:id="@+id/scanning_view"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_ADD_MUSIC_SCAN"
        app:layout_constraintBottom_toBottomOf="@+id/navigation_space"
        app:layout_constraintRight_toRightOf="@+id/navigation_space"
        app:layout_constraintTop_toTopOf="@+id/navigation_space"/>
    <p151v.VImage
        android:id="@+id/back_view"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:src="0x7f082366"
        app:layout_constraintBottom_toBottomOf="@+id/navigation_space"
        app:layout_constraintLeft_toLeftOf="@+id/navigation_space"
        app:layout_constraintTop_toTopOf="@+id/navigation_space"/>
    <p151v.VText
        android:textSize="21sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_ADD_MUSIC"
        app:layout_constraintBottom_toBottomOf="@+id/navigation_space"
        app:layout_constraintLeft_toRightOf="@+id/back_view"
        app:layout_constraintTop_toTopOf="@+id/navigation_space"/>
    <p151v.VImage
        android:id="@+id/live_empty_icon"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="88dp"
        android:src="0x7f082370"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_space"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#4dffffff"
        android:gravity="center"
        android:id="@+id/live_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="48dp"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_ADD_MUSIC_EMPTY_ANDROID"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_empty_icon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/empty_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_empty_icon,live_empty_text"/>
    <p151v.VRecyclerView
        android:id="@+id/live_music_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="114dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_space"
        app:layout_constraintVertical_bias="0"/>
    <View
        android:background="@drawable/live_shape_intl_music_bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="102dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VButton
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/live_add_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_ADD_MUSIC_CONFIRM_ADD"
        app:layout_constraintBottom_toTopOf="@+id/live_scanning_tip"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66ffffff"
        android:gravity="center"
        android:id="@+id/live_scanning_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_LOCAL_MUSIC_PLAY_ADD_MUSIC_DISCLAIMER"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/content_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_add_button,live_scanning_tip,live_music_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
