<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.group.GroupSuggestItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/suggest_layout"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    flatten="true"
    folder="newui"
    holder="group.GroupSuggestItemView">
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:id="@+id/group_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1">
        <com.p051p1.mobile.putong.core.p058ui.messages.view.GroupAvatarView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/group_avatar"
            android:layout_width="66dp"
            android:layout_height="66dp"/>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/layout_group_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:singleLine="true"
                android:lineSpacingExtra="4sp"
                android:fontFamily="PingFangSC-Medium"
                android:lineHeight="20sp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#66000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:layout_marginTop="2dp"
                android:lines="1"/>
            <com.p051p1.mobile.putong.core.newui.group.ChatGroupTags
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:id="@+id/tags"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="6dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/apply"
        android:background="@drawable/core_group_suggest_btn_new_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:text="加入"/>
</com.p051p1.mobile.putong.core.newui.group.GroupSuggestItemView>
