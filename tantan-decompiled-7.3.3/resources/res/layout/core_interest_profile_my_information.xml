<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:id="@+id/my_information_title"
        android:paddingLeft="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/PROFILE_INFO"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/about_me_one_wrap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:layout_gravity="top"
            android:id="@+id/about_me_one_tip"
            android:text="@string/PROFILE_PERSONAL_INFO_ABOUT_ME"
            android:layout_weight="2"
            style="@style/profile_item_item_new_edit"/>
        <p151v.VText
            android:ellipsize="end"
            android:id="@+id/about_me_one"
            android:paddingLeft="0dp"
            android:hint="@string/PROFILE_PERSONAL_INFO_ABOUT_ME"
            android:layout_weight="3"
            style="@style/profile_item_item_new_edit"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/zodiac_type_wrap"
        android:visibility="gone"
