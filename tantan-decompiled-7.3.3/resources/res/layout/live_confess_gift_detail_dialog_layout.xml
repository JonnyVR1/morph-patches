<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/blank_space"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg_view"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="393dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/receive_gift_user_avatar"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_view"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:id="@+id/gift_image_bg"
        android:layout_width="46dp"
        android:layout_height="46dp"
        app:layout_constraintBottom_toBottomOf="@+id/receive_gift_user_avatar"
        app:layout_constraintEnd_toEndOf="@+id/receive_gift_user_avatar"/>
    <p151v.VDraweeView
        android:id="@+id/gift_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_image_bg"
        app:layout_constraintEnd_toEndOf="@+id/gift_image_bg"
        app:layout_constraintStart_toStartOf="@+id/gift_image_bg"
        app:layout_constraintTop_toTopOf="@+id/gift_image_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/LIVE_CONFESS_GIFT_TEXT"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/receive_gift_user_avatar"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_50_opacity"
        android:ellipsize="end"
        android:id="@+id/gift_text_1"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:text="@string/LIVE_CONFESS_GIFT_DESC_TEXT_1"
        android:maxLines="2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/receive_gift_user_avatar"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_50_opacity"
        android:ellipsize="end"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/LIVE_CONFESS_GIFT_DESC_TEXT_2"
        android:maxLines="2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_text_1"/>
    <p151v.VButton
        android:gravity="center"
        android:id="@+id/send_love_gift_button"
        android:background="@color/live_fe7e1d"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="58dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintStart_toStartOf="@+id/bg_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/gift_name_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/send_love_gift_button"
        app:layout_constraintStart_toStartOf="@+id/send_love_gift_button"
        app:layout_constraintTop_toTopOf="@+id/send_love_gift_button"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/gift_cost_text"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/LIVE_GAME_PK_TANTAN_B_COUNT"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/send_love_gift_button"
        app:layout_constraintEnd_toEndOf="@+id/send_love_gift_button"
        app:layout_constraintStart_toStartOf="@+id/send_love_gift_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
