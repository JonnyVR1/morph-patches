<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiPk.multiPkPlaying.MultiPkTimerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="16dp"
    flatten="true"
    folder="recreation"
    holder="multiPk.multiPkPlaying.MultiPkTimerView">
    <View
        android:id="@+id/left_line"
        android:background="@drawable/live_shape_multi_pk_points_left_line_bg"
        android:layout_width="0dp"
        android:layout_height="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_line"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/right_line"
        android:background="@drawable/live_shape_multi_pk_points_right_line_bg"
        android:layout_width="0dp"
        android:layout_height="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_line"/>
    <View
        android:id="@+id/time_view_alpha"
        android:background="@drawable/live_bg_ff4081_r13_a70"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/timer_text"
        app:layout_constraintEnd_toEndOf="@+id/timer_bg"
        app:layout_constraintStart_toStartOf="@+id/timer_bg"
        app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    <View
        android:id="@+id/time_view_bg"
        android:background="@drawable/live_bg_212121_r10"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/timer_text"
        app:layout_constraintEnd_toEndOf="@+id/timer_bg"
        app:layout_constraintStart_toStartOf="@+id/timer_bg"
        app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    <p151v.VImage
        android:id="@+id/timer_bg"
        android:layout_width="86dp"
        android:layout_height="16dp"
        android:src="0x7f082401"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VImage
        android:id="@+id/timer_icon"
        android:layout_width="15dp"
        android:layout_height="10dp"
        android:src="0x7f082402"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/timer_bg"
        app:layout_constraintEnd_toStartOf="@+id/timer_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/timer_bg"
        app:layout_constraintTop_toTopOf="@+id/timer_bg"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:id="@+id/timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@+id/timer_bg"
        app:layout_constraintEnd_toEndOf="@+id/timer_bg"
        app:layout_constraintStart_toEndOf="@+id/timer_icon"
        app:layout_constraintTop_toTopOf="@+id/timer_bg"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiPk.multiPkPlaying.MultiPkTimerView>
