<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.privilege.SVIPPrivilegeComponent">
    <p151v.VImage
        android:id="@+id/privilege_odiamond_decorate"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f081250"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="#ebb958"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/privilege_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="16dp"
            android:lines="1"
            android:drawablePadding="6dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#b2fcd072"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/privilege_summarize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"/>
        <p151v.VPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:overScrollMode="never"/>
        <p151v.VPagerCircleIndicator
            android:layout_gravity="center_horizontal"
            android:id="@+id/indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        <com.p051p1.mobile.putong.core.p058ui.view.VPagerNewCircleIndicator
            android:layout_gravity="center_horizontal"
            android:id="@+id/new_circle_indicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/lowprice_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</FrameLayout>
