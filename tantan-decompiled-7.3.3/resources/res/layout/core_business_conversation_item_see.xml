<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.business.BusinessConversationView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/tf_rect_light"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.business.BusinessConversationView">
    <p151v.VDraweeView
        android:id="@+id/avatar_image"
        android:background="@drawable/core_conversation_local_see_bg"
        android:padding="7dp"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginTop="7.5dp"
        android:layout_marginBottom="6.5dp"
        android:layout_marginStart="9dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"
        style="@style/core_conversation_profile_small"/>
    <ImageView
        android:id="@+id/right_bottom_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:src="0x7f080e3f"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintRight_toRightOf="@+id/avatar_image"/>
    <FrameLayout
        android:id="@+id/img_center_layout"
        android:layout_width="51dp"
        android:layout_height="51dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_image"
        app:layout_constraintRight_toRightOf="@+id/avatar_image"
        app:layout_constraintTop_toTopOf="@+id/avatar_image"
        flatten="true">
        <ViewStub
            android:id="@+id/switch_avatar_stub"
            android:layout="@layout/core_new_switch_frame_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/num_ticker_stub"
            android:layout="@layout/core_see_text_number_anim_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/anim_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <p151v.VFrame
        android:id="@+id/rt_layout"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="29dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintStart_toStartOf="@+id/avatar_image"
        flatten="true">
        <p151v.VText_AutoFit
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/head_like_num"
            android:background="@drawable/core_see_change_head_num_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="24dp"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/red_dot_num"
            android:background="@drawable/core_bg_conversation_unread"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="24dp"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/avatar_red_dot"
            android:background="@drawable/core_match_reminder_bg"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="1dp"/>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center"
            android:id="@+id/anim_badge_view"
            android:background="@drawable/core_business_anim_icon_bg"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/picks_ic"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081340"/>
    </p151v.VFrame>
    <ViewStub
        android:id="@+id/look_up_stub"
        android:layout="@layout/core_see_look_up_layout"
        android:inflatedId="@+id/look_up_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/icon_top_right"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="42dp"
        android:layout_marginStart="39dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_image"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8.5dp"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_image"
        app:layout_constraintLeft_toRightOf="@+id/avatar_image"
        app:layout_constraintRight_toLeftOf="@+id/look_up_stub"
        app:layout_constraintTop_toTopOf="@+id/avatar_image">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/core_vip_normal_title_text_color"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/SEE_PURCHASE_MIN_TITLE"
            android:maxLines="1"
            app:enableEmojis="true"
            app:typeface="medium"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#fe7e1d"
                android:id="@+id/status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/divider_dot"
                android:background="@drawable/core_meet_subtitle_divider_dot_live"
                android:visibility="gone"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_vip_normal_subtitle_text_color"
                android:textColorLink="@color/core_msg_cell_link_color"
                android:ellipsize="end"
                android:id="@+id/sub_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/MATCH_LIST_SEE_WHO_LIKED_ME_DETAIL"
                android:maxLines="1"
                android:layout_weight="1"
                app:enableEmojis="true"
                app:typeface="regular"/>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="2dp">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/red_dot"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"/>
            </FrameLayout>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_vip_normal_black_light_color"
        android:id="@+id/latest_meet_feed_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.newui.messages.business.BusinessConversationView>
