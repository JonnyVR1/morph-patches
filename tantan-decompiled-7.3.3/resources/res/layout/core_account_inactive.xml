<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="account.AccountInactiveActViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <ScrollView style="@style/core_account_scroll">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_grey_02"
                android:id="@+id/tip"
                android:background="@color/white"
                android:paddingLeft="20dp"
                android:paddingTop="13dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/list"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="@color/common_grey_01"
                android:textColorHint="#d0d0d0"
                android:gravity="start"
                android:id="@+id/feedback_edit"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:hint="请输入具体原因..."
                android:maxLength="500"
                android:inputType="textMultiLine"/>
        </LinearLayout>
    </ScrollView>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:id="@+id/confirm"
        android:text="提交"
        style="@style/core_account_continue_button"/>
</p151v.VLinear>
