<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.dialog.announcement.AnnouncementView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="300dp"
    app:bind_extends="LinearLayout"
    app:binding="true">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_40_opacity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="编辑公告"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/live_white_80_opacity"
        android:textColorHint="@color/live_white_40_opacity"
        android:gravity="top"
        android:id="@+id/input_notice_text"
        android:background="@drawable/live_bg_white_r10_a03"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:minHeight="100dp"
        android:hint="写下你的群公告"
        android:layout_weight="1"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/live_shape_voice_top_notice_input_cursor_style"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/go"
        android:background="@drawable/live_selector_voice_functions_confirm_bt_bg"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="33dp"
        android:text="开始吧"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.dialog.announcement.AnnouncementView>
