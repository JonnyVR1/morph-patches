<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/empty_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/empty_pic"
            android:background="@drawable/core_multiple_filer_no_result"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="40dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4d323232"
            android:gravity="center_horizontal"
            android:id="@+id/empty_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无新配对\10去划卡认识新朋友吧"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/empty_btn"
            android:background="@drawable/core_o_diamond_visitor_guide_btn"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="20dp"
            android:text="去划卡"/>
    </p151v.VLinear>
</p151v.VFrame>
