<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_share_message_to_friend_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/core_share_message_to_friend_sheet_indicator_bg"
            android:layout_width="37dp"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"/>
        <p151v.VText
            android:textSize="24sp"
            android:textColor="#e6000000"
            android:id="@+id/title"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:text="@string/CHAT_GROUP_ADD_CHOOSE_FRIEND"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#4c000000"
            android:id="@+id/subtitle"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="每次分享最多选择5位好友"/>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="87dp">
            <p151v.VRecyclerView
                android:id="@+id/friend_list"
                android:paddingBottom="40dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="300dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#4c323232"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/empty_hint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="你暂时还没有好友"
                android:drawableTop="0x7f0816b5"
                android:drawablePadding="2dp"
                android:lineSpacingExtra="6sp"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/core_share_message_to_friend_bottom_cover_bg"
        android:layout_width="match_parent"
        android:layout_height="130dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_bottom"
        android:background="@drawable/core_share_message_to_friend_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="39dp"
        android:text="分享"/>
</p151v.VFrame>
