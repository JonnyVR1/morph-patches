<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/test1_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <p151v.AutoVDraweeView
            android:id="@+id/test1_avatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:id="@+id/test1_avatar_edit"
            android:padding="1dp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="0x7f080b59"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/test1_avatar"
            app:layout_constraintRight_toRightOf="@+id/test1_avatar"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/test1_name_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toRightOf="@+id/test1_avatar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/test1_avatar">
            <p151v.VText_NoTopPadding
                android:textSize="20sp"
                android:textColor="@color/core_color_010101"
                android:ellipsize="end"
                android:id="@+id/test1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:singleLine="true"
                app:fontWeight="700"/>
            <p151v.VImage
                android:id="@+id/test1_verification_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f082957"
                android:scaleType="fitXY"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/test1_subscription_btn"
            android:background="@drawable/core_me_tab_revamp_subscription_outline_bg"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toRightOf="@+id/test1_avatar"
            app:layout_constraintTop_toBottomOf="@+id/test1_name_row">
            <p151v.VImage
                android:id="@+id/test1_sub_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f080e18"
                android:scaleType="fitCenter"
                android:layout_marginEnd="4dp"/>
            <p151v.VText_NoTopPadding
                android:textSize="11sp"
                android:textColor="#f1bf00"
                android:id="@+id/test1_sub_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontWeight="700"/>
        </p151v.VLinear>
        <p151v.VOnlineIndicator
            android:id="@+id/test1_sub_dot"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:translationX="4dp"
            android:translationY="-4dp"
            app:layout_constraintRight_toRightOf="@+id/test1_subscription_btn"
            app:layout_constraintTop_toTopOf="@+id/test1_subscription_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear>
