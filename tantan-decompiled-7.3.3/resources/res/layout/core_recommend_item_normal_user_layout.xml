<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.RecommendNormalUserView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/online_item"
    android:clipChildren="false"
    android:layout_width="65dp"
    android:layout_height="87dp"
    android:layout_marginEnd="9dp"
    folder="newui"
    holder="messages.RecommendNormalUserView">
    <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
        android:layout_gravity="center_horizontal"
        android:id="@+id/image"
        android:clickable="true"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="7dp"
        app:placeholderImage="0x7f08160e"
        app:show_audio_chat_frame="false"/>
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/head_layout"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginTop="7dp"
        flatten="true">
        <p151v.VRelative
            android:layout_gravity="center_horizontal"
            android:id="@+id/vre_online_match"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="3dp">
            <com.p051p1.mobile.putong.core.newui.talk.view.NewTalkProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
            <p151v.VDraweeView
                android:id="@+id/image2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:cropToPadding="false"
                android:layout_centerInParent="true"
                app:roundAsCircle="true"
                style="@style/core_fresco_profile_small"/>
        </p151v.VRelative>
        <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_avatar"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:avatarSize="44dp"
            app:haloSize="55dp"/>
        <p151v.VFrame
            android:layout_gravity="center_horizontal"
            android:id="@+id/chat_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/chat_label_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081613"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="9sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/chat_label_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="即刻闪聊"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="13sp"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.core.newui.messages.RecommendNormalUserView>
