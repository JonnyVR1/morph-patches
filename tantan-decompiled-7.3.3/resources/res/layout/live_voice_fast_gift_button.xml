<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.bottom.VoiceFastGiftView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fast_gift"
    android:visibility="invisible"
    android:layout_width="36dp"
    android:layout_height="60dp"
    flatten="true"
    holder="voice.bottom.VoiceFastGiftView">
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/combo"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:background="@drawable/live_bg_black_r20_a20"
        android:padding="4dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/combo"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.operation.countdown.FastGiftCountDownView
        android:layout_gravity="center_horizontal"
        android:id="@+id/countDownView"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        app:countdownTime="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/combo"
        app:ringEndColor="#1eadff"
        app:ringStartColor="#8adfff"
        app:ringWidth="2"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/price"
        android:background="@drawable/live_shape_voice_fast_gift_price_round_bg"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/red_dot"
        android:background="@drawable/live_bg_ff3938_r3"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        app:layout_constraintRight_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
</com.p051p1.mobile.putong.live.livingroom.voice.bottom.VoiceFastGiftView>
