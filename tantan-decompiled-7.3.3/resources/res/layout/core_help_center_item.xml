<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/tf_rect_light"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#212121"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/text"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:drawableRight="@drawable/ic_arrow_right_light"
        android:drawablePadding="30dp"
        android:layout_weight="100"
        android:drawableEnd="@drawable/ic_arrow_right_light"
        app:vectorDrawableRight="@drawable/ic_arrow_right_light"/>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/dot"
        android:background="@drawable/messages_bar_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_margin="40dp"/>
</p151v.VFrame>
