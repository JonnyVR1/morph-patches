<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.HomeErrorNetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/error_net_cover"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    useRefId="true">
    <p151v.VImage
        android:id="@+id/empty_card_net_error_image"
        android:layout_width="210dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:translationY="-55dp"
        app:srcCompat="@drawable/core_ic_network_not_available"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/empty_card_net_error_image"
        android:translationY="-55dp">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_03"
            android:gravity="center_horizontal"
            android:id="@+id/tip"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:text="@string/SUGGEST_USERS_NO_INTERNET_TIPS"
            app:typeface="medium"/>
        <p151v.VButton
            android:textSize="16sp"
            android:id="@+id/reload"
            android:layout_width="247dp"
            android:layout_height="56dp"
            android:layout_marginTop="88dp"
            android:text="@string/SUGGEST_USERS_NO_INTERNET_RELOAD"
            style="@style/common_button_large_01"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.newui.home.HomeErrorNetView>
