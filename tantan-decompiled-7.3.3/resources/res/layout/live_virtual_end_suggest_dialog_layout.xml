<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/blank_space"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/root_view"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/image_view"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/live_white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/image_text"
                android:background="@drawable/live_bg_fe7e1d_r5"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="12dp"
                android:src="0x7f082750"/>
        </FrameLayout>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/live_black_80_opacity"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_black_40_opacity"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sub_title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:maxLines="2"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/confirm_button"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="32dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/live_fe7e1d"
                android:id="@+id/count_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/live_black_20_opacity"
                android:id="@+id/count_down_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
