<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_feed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    flatten="true"
    folder="newui"
    holder="topic.qatopic.QATopicTowOptionVoteView">
    <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQaBgRelativeLayout
        android:orientation="horizontal"
        android:id="@+id/vote_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <View
            android:id="@+id/vote_bg_one"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/vote_bg_two"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"/>
    </com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQaBgRelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQaTwoOptionTopicItem
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/vote_feed_one_ghost"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <View
            android:layout_gravity="center_vertical"
            android:background="#0c000000"
            android:visibility="gone"
            android:layout_width="2dp"
            android:layout_height="16dp"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQaTwoOptionTopicItem
                android:layout_gravity="center"
                android:id="@+id/vote_feed_two_ghost"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/vote_ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <FrameLayout
            android:id="@+id/container_first"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQaTwoOptionTopicItem
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/vote_feed_one"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/vote_center"
            android:background="#0c000000"
            android:visibility="gone"
            android:layout_width="2dp"
            android:layout_height="16dp"/>
        <FrameLayout
            android:id="@+id/container_second"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.topic.qatopic.FeedQaTwoOptionTopicItem
                android:layout_gravity="center"
                android:id="@+id/vote_feed_two"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"/>
        </FrameLayout>
    </LinearLayout>
</p151v.VFrame>
