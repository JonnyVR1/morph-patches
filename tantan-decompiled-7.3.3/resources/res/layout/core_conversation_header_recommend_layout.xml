<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationHeadRecommendLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_message_head"
    android:visibility="gone"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="171dp"
    flatten="true"
    folder="newui"
    holder="messages.ConversationHeadRecommendLayout">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header_title_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        flatten="true">
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:id="@+id/svga_star_layout"
            android:visibility="gone"
            android:layout_width="33dp"
            android:layout_height="30dp"
            android:layout_marginLeft="5dp"
            flatten="true">
            <com.tantan.library.svga.SVGAnimationView
                android:layout_gravity="bottom"
                android:id="@+id/svga_star"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/common_orange"
            android:layout_gravity="center_vertical"
            android:id="@+id/new_match"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/NAVIGATION_MATCHES"
            app:enableEmojis="true"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/recommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/REGULATION_1"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/all_match"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="全部"/>
    </p151v.VLinear>
    <ViewStub
        android:id="@+id/stub_only_boost"
        android:layout="@layout/core_chat_only_boost"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="37dp"
        android:layout_marginRight="12dp"/>
    <p151v.VRecyclerView
        android:id="@+id/recommend_list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_marginTop="37dp"
        android:layout_below="@+id/header_title_layout"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga"
        android:layout_width="115dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="15dp"
        android:layout_alignBottom="@+id/recommend_list"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/view_bottom_line"
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationHeadRecommendLayout>
