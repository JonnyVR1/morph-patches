<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.moments.MomentActivitiesView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="moments.MomentActivitiesView">
    <FrameLayout
        android:id="@+id/comment_frame"
        android:background="@drawable/tf_rect_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="96dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp">
                <p151v.VDraweeView
                    android:id="@+id/profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    style="@style/feed_fresco_profile_small"/>
                <p151v.VImage
                    android:layout_gravity="bottom|right"
                    android:id="@+id/verification_icon"
                    android:background="0x7f081e18"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/text_medium"
                    android:ellipsize="end"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="4"
                    android:drawableLeft="0x7f081da1"
                    android:drawablePadding="5dp"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/text_light"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="13dp"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="top|right"
            android:id="@+id/moment_frame"
            android:background="@color/button_white"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:foreground="@drawable/tf_rect_roundedsmall_light"/>
        <p151v.VButton
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/attention"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:singleLine="true"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="@drawable/moments_comment_detail_item_divider"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</com.p051p1.mobile.putong.feed.p065ui.moments.MomentActivitiesView>
