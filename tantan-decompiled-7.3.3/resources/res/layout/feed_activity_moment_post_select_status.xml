<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="mediapicker.post.state.FeedMomentPostSelectStatusViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/state_ll"
        android:background="@drawable/feed_moment_post_state_bottom_to_top_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/state_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <View
                android:layout_gravity="center"
                android:id="@+id/view_line"
                android:background="@drawable/common_handlebar_handler"
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="26dp"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="20sp"
                android:textColor="@color/feed_black_010101"
                android:id="@+id/state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@+id/view_line"
                android:layout_centerHorizontal="true"/>
        </p151v.VRelative>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:divider="@null"
            android:layout_weight="1"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/feed_66000000"
        android:layout_gravity="top|right"
        android:id="@+id/clear_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text="清空状态"/>
    <View
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="88dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/feed_gray_fafafa"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/post"
        android:background="@drawable/feed_comment_send_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ACTION_CONFIRM"/>
</p151v.VFrame>
