<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.view.WechatNotifyBannerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/pic_cert_guide"
    android:background="@drawable/core_pic_cert_guide_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="view.WechatNotifyBannerView">
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="0x7f081a20"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="8dp"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#cc000000"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#fe7e1d"
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开启微信通知"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/bottom_top_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_weight="1"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:src="0x7f081a1d"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.core.newui.view.WechatNotifyBannerView>
