<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.account.view.AccountView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    holder="account.view.AccountView">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/account_pic_root"
        android:layout_width="94dp"
        android:layout_height="94dp"
        flatten="true">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="80dp"
            android:layout_height="80dp">
            <ImageView
                android:background="@drawable/core_account_add"
                android:padding="25dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f0829db"/>
            <RelativeLayout
                android:layout_width="80dp"
                android:layout_height="80dp">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/account_pic"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    fresco:roundedCornerRadius="40dp"/>
                <ImageView
                    android:id="@+id/delete_cur_account"
                    android:paddingLeft="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="0x7f0829df"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/SWITCH_ACCOUNT_ADD_ACCOUNT"
        android:maxLines="1"
        android:maxEms="7"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/status"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <View
            android:background="@drawable/messages_bar_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"/>
        <TextView
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/SWITCH_ACCOUNT_CURRENT_ACCOUNT"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.account.view.AccountView>
