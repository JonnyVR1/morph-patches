<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.loveletter.LoveLetterCenterTextLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="16dp"
        android:textColor="@color/core_color_80percent_000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text1"
        android:layout_width="match_parent"
        android:layout_height="22dp"/>
    <View
        android:id="@+id/line1"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="50dp"/>
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/layout2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="50dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="22dp"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="10dp"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            android:singleLine="true"/>
    </p151v.VLinear>
    <View
        android:id="@+id/line2"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="50dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="13dp"
        android:textColor="@color/core_color_80percent_000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text3"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="13dp"/>
    <View
        android:id="@+id/line3"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="50dp"/>
</com.p051p1.mobile.putong.core.newui.loveletter.LoveLetterCenterTextLayout>
