<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.liveend.VoiceLiveEndPageView">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/heart_beat_value_layout"
        android:background="@drawable/live_bg_black_r10_a40"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <p151v.VImage
            android:id="@+id/icon"
            android:background="0x7f08278b"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="12dp"/>
        <p151v.VText
            android:textColor="#a8aab0"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:paddingTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:text="@string/LIVE_VOICE_SUM"/>
        <p151v.VText
            android:textColor="#a8aab0"
            android:gravity="end|center_vertical"
            android:id="@+id/heart_beat_value"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"/>
    </p151v.VLinear>
    <p151v.smart_refresh.SmartRefreshLayout
        android:id="@+id/refreshLayout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/heart_beat_value_layout"
        flatten="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.smart_refresh.SmartRefreshLayout>
    <ImageView
        android:id="@+id/emptyImage"
        android:background="0x7f082789"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/live_white_30_opacity"
        android:id="@+id/emptyText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/emptyImage"
        android:layout_centerHorizontal="true"/>
</p151v.VRelative>
