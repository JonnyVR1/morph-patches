<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:clipChildren="false"
    holder="account.GPBindPhoneNumberInputAct"
    style="@style/core_account_root">
    <p151v.VScroll style="@style/core_account_scroll">
        <LinearLayout
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            style="@style/core_account_frame">
            <p151v.VImage
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:layout_marginTop="48dp"
                android:src="0x7f0808c9"
                android:adjustViewBounds="true"/>
            <p151v.VText
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/lable_red"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/GP_BIND_PHONE_NUMBER"/>
            <p151v.VText
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/bind_phone_desc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/GP_BIND_MOBILE_NOTICE"/>
            <LinearLayout
                android:id="@+id/bind_number_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VMaterialEdit_FakeSpinner
                    android:id="@+id/bind_ccode"
                    style="@style/core_account_spinner"/>
                <p151v.VMaterialEdit
                    android:id="@+id/bind_number"
                    android:focusable="true"
                    android:hint="@string/SIGNUP_PHONE_NUMBER"
                    style="@style/core_account_username"/>
            </LinearLayout>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:id="@+id/continue_"
        android:text="@string/ACTION_CONTINUE"
        style="@style/core_account_continue_button"/>
</p151v.VLinear>
