<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.voiceslipcard.chatroom.LiveVoiceActivitiesEntryUnRead xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_list_voice_activities_entry_unread_bg"
    android:layout_width="wrap_content"
    android:layout_height="70dp"
    flatten="true"
    folder="voiceslipcard"
    holder="chatroom.LiveVoiceActivitiesEntryUnRead">
    <p151v.VDraweeView
        android:id="@+id/drawee_view"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_margin="8dp"
        android:layout_centerVertical="true"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/live_shape_banner_profile_placeholder"
        app:roundedCornerRadius="8dp"/>
    <p151v.VMarqueeText
        android:textSize="14sp"
        android:textColor="@color/live_black"
        android:ellipsize="marquee"
        android:id="@+id/title_text"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:singleLine="true"
        android:layout_alignTop="@+id/drawee_view"
        android:marqueeRepeatLimit="marquee_forever"
        android:fontFamily="PingFangSC-Semibold"
        android:layout_toEndOf="@+id/drawee_view"/>
    <p151v.VMarqueeText
        android:textSize="11sp"
        android:textColor="#929292"
        android:ellipsize="marquee"
        android:id="@+id/desc_text"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        android:layout_below="@+id/title_text"
        android:marqueeRepeatLimit="marquee_forever"
        android:fontFamily="PingFangSC-Regular"
        android:layout_toEndOf="@+id/drawee_view"/>
    <p151v.VFrame
        android:id="@+id/img_close_container"
        android:clickable="true"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_toRightOf="@+id/title_text"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/iv_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            app:srcCompat="0x7f082758"/>
    </p151v.VFrame>
    <View
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/img_close"/>
</com.p051p1.mobile.putong.live.external.voiceslipcard.chatroom.LiveVoiceActivitiesEntryUnRead>
