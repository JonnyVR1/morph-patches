<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/live_intl_voice_fan_base_popup_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#bc3270"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/item1"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="92dp"
            android:text="@string/LIVE_VOICE_CP_GAME_RULE"/>
        <View
            android:background="#1abc3270"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#bc3270"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/item2"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="92dp"
            android:text="@string/LIVE_VOICE_CANCEL_RELATIONSHIP"/>
    </p151v.VLinear>
</p151v.VFrame>
