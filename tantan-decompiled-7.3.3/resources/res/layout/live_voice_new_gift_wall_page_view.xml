<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="600dp">
    <p151v.VDraweeView
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,375:274"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f0822e3"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintStart_toStartOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_VOICE_GIFTWALL_GIFT_LIGHTED"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintLeft_toLeftOf="@+id/top_view"
        app:layout_constraintRight_toRightOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <p151v.VImage
        android:id="@+id/answer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="18dp"
        android:src="0x7f0822ef"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintRight_toRightOf="@+id/top_view"
        app:layout_constraintTop_toTopOf="@+id/top_view"/>
    <include
        android:id="@+id/user_info_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/top_view"
        layout="@layout/live_voice_gift_wall_user_info_view"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_info_view">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:background="@color/transparent"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@color/transparent"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <include
                    android:id="@+id/week_star_champion_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/live_voice_new_gift_wall_week_star_champion_view"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp">
                <com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.VoiceGiftWallTabLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tab_layout"
                    android:background="@color/transparent"
                    android:fadingEdgeLength="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="8dp"
                    android:requiresFadingEdge="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/sort_layout"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="0dp"
                    app:tabMinWidth="0dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="2dp"
                    app:tabPaddingStart="0dp"
                    app:tabRippleColor="@color/transparent"/>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/sort_layout"
                    android:background="@drawable/live_bg_white_r10_a03"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#99ffffff"
                        android:id="@+id/sort_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:text="价格递增"/>
                    <p151v.VImage
                        android:id="@+id/sort_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="5dp"
                        android:src="0x7f0827ac"/>
                </p151v.VLinear>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <p151v.VRecyclerView
            android:id="@+id/content_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/float_btn_bg"
        android:background="0x7f082408"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <p151v.VDraweeView
            android:id="@+id/me_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ccffffff"
            android:id="@+id/me_gift_wall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            android:text="@string/LIVE_VOICE_GIFTWALL_MY_GIFT"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
