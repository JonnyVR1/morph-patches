<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/certification_bottom_sheet"
    android:background="@drawable/core_certification_bottom_sheet_bg"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f080684"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_behind"
        android:layout_width="155dp"
        android:layout_height="226dp"
        android:layout_marginTop="56dp"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="138dp"
        android:layout_height="200dp"
        android:layout_marginTop="80dp"
        android:layout_marginStart="72dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/common_light_04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/common_light_04"
        app:roundedCornerRadius="14dp"
        app:roundingBorderColor="@color/white"
        app:roundingBorderPadding="1dp"
        app:roundingBorderWidth="4dp"/>
    <p151v.VLinear
        android:id="@+id/certification_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="#cc000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <View
        android:id="@+id/blank"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/button"
        android:background="@drawable/core_certification_bottom_sheet_button_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blank">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:id="@+id/button_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我也认证"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#ccffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="认证后被将优先推荐"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
