<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/pic_item_root"
        android:layout_width="86dp"
        android:layout_height="86dp">
        <p151v.AutoVDraweeView
            android:id="@+id/pic_item_image"
            android:layout_width="86dp"
            android:layout_height="86dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/core_message_ideal_pic_item_default_bg"
            app:roundedCornerRadius="9dp"/>
        <p151v.VText
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/pic_item_label_text"
            android:background="@drawable/core_message_ideal_pic_label_bg"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:singleLine="true"/>
    </FrameLayout>
</FrameLayout>
