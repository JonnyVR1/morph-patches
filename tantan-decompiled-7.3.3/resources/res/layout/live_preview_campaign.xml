<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.LivePreviewCampaignView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="LivePreviewCampaignView">
    <RelativeLayout
        android:id="@+id/recruit_anchor_setting"
        android:background="@drawable/live_bg_black_r10_a20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/campaign_title"
            android:background="@drawable/live_bg_black_r10_a20"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:maxLines="1"
            android:layout_centerVertical="true"/>
        <com.p051p1.mobile.putong.live.livingroom.view.AutoRollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="44dp"
            android:layout_toRightOf="@+id/campaign_title"
            android:layout_centerVertical="true"
            app:contentTextColor="@color/white"
            app:contentTextSize="12sp"/>
        <FrameLayout
            android:gravity="center"
            android:id="@+id/campaign_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="0x7f0824a5"/>
        </FrameLayout>
    </RelativeLayout>
</com.p051p1.mobile.putong.live.livingroom.view.LivePreviewCampaignView>
