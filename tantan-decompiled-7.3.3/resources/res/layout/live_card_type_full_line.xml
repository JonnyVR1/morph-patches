<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.LiveFullLineFeedCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_voice_new_full_line_card_bg"
    android:layout_width="match_parent"
    android:layout_height="97dp"
    android:layout_margin="4dp">
    <p151v.VDraweeView
        android:id="@+id/left_image"
        android:layout_width="67dp"
        android:layout_height="77dp"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"/>
    <p151v.VMarqueeText
        android:textSize="16sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/top_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/left_image"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#7a7a7a"
        android:id="@+id/mid_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/left_image"
        app:layout_constraintTop_toBottomOf="@+id/top_text"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/left_image"
        app:layout_constraintRight_toRightOf="parent">
        <p151v.VDraweeView
            android:id="@+id/bottom_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            app:roundAsCircle="true"/>
        <p151v.VMarqueeText
            android:textSize="13sp"
            android:textColor="#7a7a7a"
            android:ellipsize="marquee"
            android:id="@+id/bottom_text"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="5dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#7a7a7a"
            android:gravity="end"
            android:id="@+id/corner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.LiveFullLineFeedCardView>
