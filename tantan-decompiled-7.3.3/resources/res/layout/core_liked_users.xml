<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="likedusers.LikedUsersViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/anchor_list"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VFrame
        android:id="@+id/root"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VFrame
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/empty"
                android:paddingBottom="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f0809e0"
                    android:scaleType="centerInside"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/CORE_SVIP_BROWSE_LIKED_LIST_EMPTY_REMIND"/>
            </LinearLayout>
            <p151v.VProgressBar
                android:id="@+id/progress"
                style="@style/core_loading_block"/>
        </p151v.VFrame>
        <p151v.VPullUpRecyclerView
            android:id="@+id/list"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="80dp"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/list_foreground"
            android:background="#80000000"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_gravity="top"
            android:id="@+id/filter_bar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_liked_user_filter_bar"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/get_privilege"
            android:background="@drawable/core_newui_fakelikers_buy_btn_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="@string/SVIP_PRIVILEGE_BROWSE_LIKED_TITLE_LOCAL"
            android:shadowColor="#1e000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/get_privilege_for_show_anchor_ab"
            android:background="@drawable/core_liked_user_buy_btn_gradient_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/get_privilege_for_show_anchor_ab_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CORE_LIKED_USER_PAGE_TITLE"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_99ffffff"
                android:gravity="center"
                android:id="@+id/get_privilege_for_show_anchor_ab_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="再次打动喜欢的人，配对率提升5倍"
                android:layout_below="@+id/get_privilege_for_show_anchor_ab_title"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </p151v.VFrame>
</p151v.VLinear>
