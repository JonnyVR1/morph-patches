<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.loop.input.ProfileLoopVerificationViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/first_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="20dp"
            android:text="完成头像本人认证"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:text="使用五官清晰正面照完成认证，解锁专属权益"
            android:layout_marginHorizontal="40dp"/>
        <p151v.VLinear
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="38dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="16dp"
                app:srcCompat="0x7f080d70"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="15sp"
                    android:textColor="@color/common_black_80"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更快认识合适的人"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="获得只看认证用户、优先推荐等权益"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="16dp"
                app:srcCompat="0x7f080d71"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="15sp"
                    android:textColor="@color/common_black_80"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="隐私保护升级"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="认证后，你的真实信息将被更好保护"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="16dp"
                app:srcCompat="0x7f080d72"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="15sp"
                    android:textColor="@color/common_black_80"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在所有人中脱颖而出"
                    android:maxLines="1"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点亮认证徽章，露出认证身份"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VLinear>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/action_view"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        layout="@layout/core_profile_loop_edit_action_layout"/>
</FrameLayout>
