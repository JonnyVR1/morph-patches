<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemODiamondVisitorGuideMessage xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemODiamondVisitorGuideMessage">
    <p151v.VRelative
        android:background="@drawable/core_message_o_diamond_visitor_guide_bg"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="20dp"
        flatten="true">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f081243"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="68dp">
            <p151v.VLinear
                android:layout_width="136dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#cc000000"
                    android:id="@+id/guide_title"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:lineHeight="21dp"/>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="12dp"
                    android:layout_height="21dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:src="0x7f08128f"
                    android:layout_marginHorizontal="2dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#cc000000"
                    android:id="@+id/guide_title_end"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:text="次"
                    android:lineHeight="21dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:id="@+id/guide_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:text="最近访问时间"
                    android:lineHeight="18.2dp"/>
                <p151v.VImage
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginLeft="2dp"
                    android:src="0x7f08128e"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/pin"
            android:background="@drawable/core_o_diamond_visitor_guide_btn"
            android:layout_width="53dp"
            android:layout_height="34dp"
            android:text="解密"
            android:layout_centerVertical="true"
            android:layout_marginEnd="46dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f08135e"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemODiamondVisitorGuideMessage>
