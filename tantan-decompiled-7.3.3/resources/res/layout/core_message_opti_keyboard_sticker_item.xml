<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/wrapper"
    android:background="@drawable/core_message_opti_meme_bg"
    android:padding="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView xmlns:fresco="http://schemas.android.com/apk/res-auto"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="64dp"
        android:maxHeight="64dp"
        android:layout_weight="1"
        fresco:actualImageScaleType="fitCenter"
        style="@style/core_im_fresco_base"/>
    <p151v.VText
        android:textSize="13dp"
        android:textColor="#cc010101"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
</p151v.VLinear>
