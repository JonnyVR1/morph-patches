<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="svip.guide.SVIPIntlGuideViewModel">
    <p151v.VImage
        android:id="@+id/core_vimage"
        android:layout_width="182dp"
        android:layout_height="72dp"
        android:layout_marginLeft="37dp"
        android:layout_marginTop="45dp"
        android:src="0x7f0817da"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/new_online"
        android:background="0x7f0817d8"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW"
        app:layout_constraintStart_toEndOf="@+id/core_vimage"
        app:layout_constraintTop_toTopOf="@+id/core_vimage"
        app:typeface="medium"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="78dp"
        android:layout_marginBottom="100dp">
        <p151v.VImage
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0817d9"
            android:scaleType="centerCrop"/>
        <p151v.VRecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="53dp"/>
    </FrameLayout>
    <View
        android:background="@drawable/core_svip_guide_shadow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#999999"
        android:id="@+id/skip"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="12dp"
        android:text="@string/GUESS_ACTION_SKIP"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/bottom_botton"
        android:background="@drawable/core_svip_guide_botton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="35dp"
        android:layout_marginBottom="27dp"
        android:text="@string/CORE_SVIP_GUIDE_VIEW_DETAILS"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
