<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemLoveBuzzUnlockSuccess xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.ItemLoveBuzzUnlockSuccess">
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/left_head"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:id="@+id/right_head"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="-8dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="4dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_01"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/INTL_BUZZ_IM_UNLOCK_SUCCESS_TITLE"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_80000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/INTL_BUZZ_IM_UNLOCK_SUCCESS_DESCRIPTION"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:typeface="regular"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemLoveBuzzUnlockSuccess>
