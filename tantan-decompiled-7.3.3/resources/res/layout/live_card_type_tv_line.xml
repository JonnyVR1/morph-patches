<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.tvline.LiveTvLineCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="@dimen/live_square_item_base_margin"
    android:layout_marginEnd="@dimen/live_square_item_base_margin">
    <include
        android:layout_gravity="top|left"
        android:id="@+id/main_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_card_type_tv_main_item"/>
    <include
        android:layout_gravity="top|right"
        android:id="@+id/ext_item1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        layout="@layout/live_card_type_tv_ext_item"/>
    <include
        android:layout_gravity="bottom|right"
        android:id="@+id/ext_item2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        layout="@layout/live_card_type_tv_ext_item"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.tvline.LiveTvLineCardView>
