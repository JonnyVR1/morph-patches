<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.close.VoiceCloseView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    flatten="true"
    holder="voice.intl.close.VoiceCloseView">
    <p151v.VImage
        android:id="@+id/voiceOpenMenu"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="0x7f08275b"/>
    <p151v.VImage
        android:id="@+id/collapse"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f082353"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voiceOpenMenu"
        app:layout_constraintRight_toLeftOf="@+id/voiceOpenMenu"
        app:layout_constraintTop_toTopOf="@+id/voiceOpenMenu"/>
    <p151v.VImage
        android:id="@+id/share"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f082752"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/collapse"
        app:layout_constraintRight_toLeftOf="@+id/collapse"
        app:layout_constraintTop_toTopOf="@+id/collapse"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.close.VoiceCloseView>
