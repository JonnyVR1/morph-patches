<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="183dp"
    android:layout_height="48dp"
    android:layout_marginEnd="-3dp"
    flatten="true"
    folder="intl.common"
    holder="newnotification.IntlLiveNewNotificationViewModel">
    <View
        android:background="@drawable/live_shape_intl_new_notification_view_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:id="@+id/head_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="5dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="8dp"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga_player"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"/>
    </p151v.VFrame>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@+id/head_container">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            flatten="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="two-line text combination"
                android:singleLine="true"/>
            <p151v.VMarqueeText
                android:textSize="10sp"
                android:textColor="@color/live_white_80_opacity"
                android:ellipsize="marquee"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="180dp"
                android:text="two-line text combination"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/space_view"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="0dp"/>
            <ImageView
                android:id="@+id/close"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="visible"
                android:layout_width="27dp"
                android:layout_height="36dp"
                android:src="0x7f08237c"
                android:paddingStart="3dp"
                android:paddingEnd="8dp"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
