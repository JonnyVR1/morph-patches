<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/student_verify"
    android:background="@drawable/profile_student_verification_bg"
    android:paddingLeft="16dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:visibility="visible"
    android:minHeight="40dp"
    holder="profile.profilelist.itemholders.ProfileStudentVerifyItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VImage
        android:id="@+id/flag"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="0x7f082047"
        android:scaleType="fitXY"/>
    <p151v.VImage
        android:id="@+id/arrow"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="18dp"
        android:src="0x7f080246"
        android:scaleType="fitXY"
        android:layout_alignParentRight="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#dcffffff"
        android:ellipsize="end"
        android:id="@+id/verify_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_toRightOf="@+id/flag"/>
</RelativeLayout>
