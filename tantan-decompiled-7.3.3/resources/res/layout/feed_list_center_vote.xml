<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterVoteView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/new_feed"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.feedcenter.FeedCenterVoteViewHome">
    <View
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/feed_photo_album_activities_time"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/new_ab_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginRight="16dp">
        <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
            android:id="@+id/moment_expandable_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="3dp"
            app:expandLine="3"
            app:expandText="@string/DISCOVER_MOMENT_SPREAD"
            app:isTextExpandSameLine="true"
            app:maxCollapsedLines="4">
            <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                android:textSize="15sp"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#383e46"
            android:ellipsize="end"
            android:id="@+id/moment_text"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedCanVoteContentView
            android:id="@+id/vote_ll_qa"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vote_ll"
            android:background="@drawable/feed_vote_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/vote_feed_one"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                layout="@layout/vote_feed_item"/>
            <include
                android:id="@+id/vote_feed_two"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                layout="@layout/vote_feed_item"/>
            <include
                android:id="@+id/vote_feed_three"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                layout="@layout/vote_feed_item"/>
            <include
                android:id="@+id/vote_feed_four"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                layout="@layout/vote_feed_item"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_03"
                android:ellipsize="end"
                android:layout_gravity="right"
                android:id="@+id/vote_counter_text"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.3dp"/>
        </LinearLayout>
    </p151v.VLinear>
    <View
        android:id="@+id/divider"
        android:background="#d8d8d8"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedcenter.FeedCenterVoteView>
