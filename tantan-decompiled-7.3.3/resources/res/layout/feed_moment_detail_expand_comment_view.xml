<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.momentdetail.feedlist.MomentDetailExpandCommentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_expand_bottom"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.momentdetail.feedlist.MomentDetailExpandCommentView">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:id="@+id/show_expand"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="展开更多评论"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:id="@+id/show_narrow"
        android:background="0x7f081d85"
        android:layout_width="9dp"
        android:layout_height="6dp"
        android:layout_marginLeft="9dp"
        android:layout_toRightOf="@+id/show_expand"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.momentdetail.feedlist.MomentDetailExpandCommentView>
