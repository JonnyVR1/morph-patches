<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.view.FeedActivityPostTipsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="view.FeedActivityPostTipsView">
    <p151v.VDraweeView
        android:id="@+id/activity_image"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="10dp"
        android:layout_centerVertical="true"
        app:roundAsCircle="false"
        app:roundedCornerRadius="4dp"
        style="@style/feed_fresco_profile_small"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/activity_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="12dp"
        android:maxWidth="170dp"
        android:text="去发布"
        android:maxLines="1"
        android:layout_toRightOf="@+id/activity_image"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.feed.newui.view.FeedActivityPostTipsView>
