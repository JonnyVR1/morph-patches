<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#fffaf9"
    android:fitsSystemWindows="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.newanim.MatchIceBreakViewModel"
    innerClass="true">
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svga_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VRelative
        android:id="@+id/match_head_me_container"
        android:layout_width="138dp"
        android:layout_height="148dp"
        android:layout_marginTop="80dp"
        app:layout_constraintRight_toRightOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/match_head_me"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:id="@+id/super_love_heart_me"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="0x7f080df0"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </p151v.VRelative>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <p151v.VRelative
        android:enabled="false"
        android:id="@+id/match_head_other_container"
        android:clickable="false"
        android:layout_width="138dp"
        android:layout_height="148dp"
        android:layout_marginTop="80dp"
        app:layout_constraintLeft_toLeftOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/match_head_other"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:id="@+id/super_love_heart_other"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="0x7f080def"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <p151v.VFrame
            android:id="@+id/pic_icon"
            android:visibility="gone"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            flatten="true">
            <p151v.VIcon
                android:layout_gravity="center"
                android:id="@+id/pic_icon_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f0805eb"
                android:scaleType="fitXY"/>
            <p151v.VIcon
                android:layout_gravity="center"
                android:id="@+id/pic_icon_inner"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="0x7f0805ea"
                android:scaleType="fitXY"/>
        </p151v.VFrame>
        <View
            android:id="@+id/online"
            android:background="@drawable/core_free_trial_online"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="23dp"
            android:layout_marginBottom="23dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </p151v.VRelative>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/core_text_e6000000"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="40dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/match_head_me_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/middle_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        flatten="true">
        <p151v.VRecyclerView
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/question_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/exclusive_container"
            android:background="@drawable/core_match_ice_break_exclusive_background"
            android:paddingLeft="20dp"
            android:paddingTop="11dp"
            android:paddingRight="20dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="43dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="43dp"
            android:layout_marginHorizontal="43dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="11dp"
            flatten="true">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/exclusive_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f080dd1"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/core_color_4d000000"
                    android:layout_gravity="center"
                    android:id="@+id/exclusive_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置专属破冰问题"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cancel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/edit_wrapper"
            android:background="@drawable/core_match_new_ui_edit_shape"
            android:paddingLeft="20dp"
            android:paddingTop="17dp"
            android:paddingRight="20dp"
            android:paddingBottom="17dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="43dp"
            android:layout_marginRight="43dp"
            android:layout_marginBottom="32dp"
            android:layout_marginHorizontal="43dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="17dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/common_grey_03"
                android:ellipsize="end"
                android:id="@+id/edit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="说点什么"
                android:maxLines="1"
                app:typeface="regular"/>
        </LinearLayout>
        <p151v.VRecyclerView
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/emoji_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
    <p151v.VButton_FakeShadow
        android:textColor="@color/common_grey_01"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="46dp"
        android:text="继续匹配"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
