<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.MomentsHomeCardExpandedHolder">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/moment_root"
        android:background="@drawable/core_bg_20_ffffff"
        android:paddingTop="24dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/moment_head"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="14sp"
                android:textColor="@color/core_color_50percent_000000"
                android:id="@+id/moment_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_TTC_CLONE_SWIPE_PAGE_MOMENTS_TITLE"
                android:layout_weight="1"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="13sp"
                android:textColor="@color/core_4d000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/FEED_TOPIC_VIEW_MORE"/>
        </p151v.VLinear>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pic_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/draweeView1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/draweeView2"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/core_color_f7f7f7"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="12dp"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/draweeView2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/draweeView1"
                app:layout_constraintRight_toLeftOf="@+id/draweeView3"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/core_color_f7f7f7"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="12dp"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/draweeView3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/draweeView2"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/core_color_f7f7f7"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="12dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pic_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/draweeView4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/draweeView5"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/core_color_f7f7f7"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="12dp"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/draweeView5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/draweeView4"
                app:layout_constraintRight_toLeftOf="@+id/draweeView6_container"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/core_color_f7f7f7"
                app:placeholderImageScaleType="centerInside"
                app:roundedCornerRadius="12dp"/>
            <p151v.VFrame
                android:id="@+id/draweeView6_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/draweeView5"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="12dp"
                flatten="true">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/draweeView6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:placeholderImage="@color/core_color_f7f7f7"
                    app:placeholderImageScaleType="centerInside"
                    app:roundedCornerRadius="12dp"/>
                <p151v.VFrame
                    android:id="@+id/excessive_sign"
                    android:background="@drawable/core_bg_10_80000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                        android:textSize="19dp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6+"/>
                </p151v.VFrame>
            </p151v.VFrame>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundFrameLayout
            android:id="@+id/text_dynamics"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            app:rRadius="12dp">
            <include layout="@layout/core_insert_moment_text_item"/>
        </com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundFrameLayout>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_000000_30"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:text="@string/TTC_INTL_CLONE_PROFILE_NOMOMENTS_HOST"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:drawableStart="0x7f081fc3"/>
    </p151v.VLinear>
</p151v.VFrame>
