<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memoji_act_root"
    android:background="@color/core_color_897DA7"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="lovebuzz.memoji.MemojiBuzzViewModel">
    <FrameLayout
        android:id="@+id/memoji_buzz_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="end|top"
        android:id="@+id/self_surface_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/avatar_mask_bg"
            android:background="@color/core_color_66000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/memoji_search_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
