<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatRechargeItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_shape_fast_recharge_item_bg_unselected"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="internal.vchat"
    holder="view.LiveVChatRechargeItemView">
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:id="@+id/live_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/live_price"
        app:layout_constraintEnd_toStartOf="@+id/live_ttb"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#212121"
        android:id="@+id/live_ttb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_TANTAN_COIN_RECHARGE"
        app:layout_constraintBottom_toBottomOf="@+id/live_coin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/live_coin"
        app:layout_constraintTop_toTopOf="@+id/live_coin"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_coin"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/custom"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/LIVE_CUSTOMIZE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_coin,live_ttb,live_price"/>
</com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatRechargeItemView>
