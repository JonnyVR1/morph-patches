<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemChristmasMatch xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemChristmasMatch"
    innerClass="true">
    <p151v.VLinear
        android:orientation="horizontal"
        android:background="@drawable/core_message_item_christmas_match_bg"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/activity_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/core_default_head_bg"
            app:placeholderImage="@drawable/core_default_head_bg"
            app:roundedCornerRadius="8dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#e6000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/activity_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            app:typeface="medium"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemChristmasMatch>
