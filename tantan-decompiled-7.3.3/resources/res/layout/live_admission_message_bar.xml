<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.AdmissionMessageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="12dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="AdmissionMessageView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="22dp">
        <p151v.VDraweeView
            android:id="@+id/bg"
            android:layout_width="0dp"
            android:layout_height="22dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/grade"
            android:layout_width="32dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/avatar_frame"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/grade"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="5dp"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/grade"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.live.livingroom.royal.LiveGradientTextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxEms="7"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="10dp"
            android:text="@string/LIVE_COMING"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/admission_float_bg"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="60dp"/>
</com.p051p1.mobile.putong.live.livingroom.view.AdmissionMessageView>
