<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.group.GroupSetMemberItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.group.GroupSetMemberItemView"
    innerClass="true">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VFrame_Squared
            android:id="@+id/frame_member"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="9dp"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/img_member"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="0x7f08095c"
                app:placeholderImage="0x7f08095c"
                app:roundAsCircle="true"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/group_identity"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </p151v.VFrame_Squared>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#505050"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/tv_member_name"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            android:lines="1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.group.GroupSetMemberItemView>
