<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="kankan.view.FeedComicFaceItemView">
    <p151v.VDraweeView
        android:id="@+id/feed_comic_face_item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toRightOf="@+id/feed_comic_face_item_left"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <ImageView
        android:id="@+id/feed_comic_face_item_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/feed_comic_face_item_icon"
        app:layout_constraintLeft_toLeftOf="@+id/feed_comic_face_item_icon"
        app:layout_constraintRight_toRightOf="@+id/feed_comic_face_item_icon"
        app:layout_constraintTop_toTopOf="@+id/feed_comic_face_item_icon"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/feed_comic_face_item_left"
        android:layout_width="7dp"
        android:layout_height="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/feed_comic_face_item_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/feed_comic_face_item_right"
        android:layout_width="7dp"
        android:layout_height="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/feed_comic_face_item_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
