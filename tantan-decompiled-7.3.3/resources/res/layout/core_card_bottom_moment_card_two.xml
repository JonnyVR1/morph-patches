<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomMomentCardTwoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomMomentCardTwoView">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <include
        android:id="@+id/user_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_card_user_content_view"/>
    <com.p051p1.mobile.putong.core.view.MaximumScroll
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        app:maxHeight="105dp"
        flatten="true">
        <com.p051p1.mobile.putong.newui.view.VExpandableTextContainer
            android:id="@+id/moment_expandable_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expandText="全文"
            app:isTextExpandSameLine="true"
            app:maxCollapsedLines="2">
            <com.p051p1.mobile.putong.newui.view.InnerClickSpanTextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1dp"
                android:fontFamily="PingFangSC-Medium"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_orange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="PingFangSC-Medium"/>
        </com.p051p1.mobile.putong.newui.view.VExpandableTextContainer>
    </com.p051p1.mobile.putong.core.view.MaximumScroll>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomMomentCardTwoView>
