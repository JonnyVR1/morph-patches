<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/wrapper"
    android:background="@drawable/core_my_custom_meme_item_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView xmlns:fresco="http://schemas.android.com/apk/res-auto"
        android:orientation="horizontal"
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="13dp"
        fresco:actualImageScaleType="fitCenter"
        style="@style/core_im_fresco_base"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/status_text"
        android:background="#99000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="13dp"/>
    <p151v.VCheckBox
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:layout_gravity="top|right"
        android:id="@+id/right_top_btn"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:button="@drawable/core_my_custom_meme_manage_icon"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/right_top_text"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"/>
</FrameLayout>
