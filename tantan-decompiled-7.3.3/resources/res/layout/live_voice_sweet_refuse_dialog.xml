<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_voice_sweet_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="209dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetRefuseDialog">
    <p151v.VImage
        android:id="@+id/close_iv"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:src="0x7f082820"
        android:layout_alignParentRight="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#f8591c"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="56dp"
        android:layout_marginRight="30dp"
        android:text="@string/LIVE_VOICE_CP_SORRY"
        android:layout_below="@+id/instuction_ll"
        android:fontFamily="PingFangSC-Regular"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ok_btn"
        android:background="@drawable/live_shape_voice_sweet_btn_bg"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginBottom="35dp"
        android:text="@string/LIVE_VOICE_CP_RETRY"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSc-Medium"/>
</p151v.VRelative>
