<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/post_group_view"
    android:background="@drawable/feed_post_guide_three_bg"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.postguide.FeedPostGuideThreeView">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/feed_33000000"
        android:ellipsize="end"
        android:id="@+id/post_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="16dp"
        android:text="发布动态认识更多新朋友"
        android:singleLine="true"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/post_guide_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081e4b"
            android:scaleType="centerInside"/>
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:src="0x7f081e49"
            android:scaleType="centerInside"/>
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:src="0x7f081e47"
            android:scaleType="centerInside"/>
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:src="0x7f081e4a"
            android:scaleType="centerInside"/>
    </p151v.VLinear>
</p151v.VLinear>
