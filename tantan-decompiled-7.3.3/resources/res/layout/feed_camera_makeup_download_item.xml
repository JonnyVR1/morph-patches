<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.widget.MakeupDownloadItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/camera_makeup_download_item_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="camera.widget.MakeupDownloadItemView">
    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/camera_makeup_image"
            android:background="@drawable/feed_camera_effect_bg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="center"
            app:actualImageResource="@drawable/feed_camera_effect_bg"
            app:roundedCornerRadius="12dp"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/camera_makeup_download_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:src="0x7f081caa"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/camera_makeup_select"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/feed_camera_filter_item_selected"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/camera_makeup_name"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="filter name"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/camera_makeup_value"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="30"/>
</com.p051p1.mobile.putong.feed.newui.camera.widget.MakeupDownloadItemView>
