<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="487dp"
    flatten="true"
    folder="virtual"
    holder="board.accompany.AccompanyDialog">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp">
        <com.google.android.material.tabs.TabLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/tabLayout"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            app:tabBackground="@color/transparent"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/live_list_members_indicator"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMinWidth="10dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/white"
            app:tabSelectedTextSize="16dp"
            app:tabTextAppearance="@style/live_voice_flower_board_tab_theme"
            app:tabTextColor="@color/live_white_40_opacity"
            app:tabTextSize="14sp"
            flatten="true"/>
        <View
            android:layout_gravity="bottom"
            android:background="#05f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <p151v.VPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_weight="1"
        flatten="true"/>
</p151v.VFrame>
