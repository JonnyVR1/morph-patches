<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="purchase.diamond.IntlDiamondPrivilegeComponent">
    <p151v.VHandleBar
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_black_01"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/TANTAN_DIAMOND_RECARGE_TITLE"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_02"
        android:gravity="center"
        android:id="@+id/remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/privilege"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:minHeight="44dp"
        flatten="true">
        <p151v.VIcon
            android:layout_gravity="center_vertical"
            android:id="@+id/privilege_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="8dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#2bccff"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/privilege_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
