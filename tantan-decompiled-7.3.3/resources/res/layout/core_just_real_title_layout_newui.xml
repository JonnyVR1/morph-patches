<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.justreal.JustRealHomeTitleNewUiLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingRight="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="150dp"
    android:layout_height="34dp"
    flatten="true"
    folder="newui"
    holder="home.justreal.JustRealHomeTitleNewUiLayout">
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center_vertical"
        android:id="@+id/real_svga"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/real_svga_ic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:alpha="0"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="12dp"
        android:textColor="#ff000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/default_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:text="只看认证用户"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/real_num_root_layout"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="32dp"
        android:alpha="0"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="12dp"
            android:textColor="#ff000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/real_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="只看认证用户，可划卡"/>
        <com.p051p1.mobile.putong.core.newui.home.justreal.JustRealNumContentLayout
            android:id="@+id/real_num_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                android:textSize="12dp"
                android:textColor="#ff000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/real_num_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                android:textSize="12dp"
                android:textColor="#ff000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/real_num_latest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
        </com.p051p1.mobile.putong.core.newui.home.justreal.JustRealNumContentLayout>
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="12dp"
            android:textColor="#ff000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/real_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="张"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.justreal.JustRealHomeTitleNewUiLayout>
