<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.packetgift.progress.view.PacketProgressBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="20dp"
    flatten="true"
    folder="increment"
    holder="gift.packetgift.progress.view.PacketProgressBar">
    <p151v.VFrame
        android:id="@+id/progressBarParent"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            style="@style/live_gift_packet_progress_horizontal"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga_progress"
            android:visibility="invisible"
            android:layout_width="169dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/complete_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/svga_complete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_50_opacity"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_GIFT_DIALOG_PACKET_BULLET_REWARD_TEXT"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="center"
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.packetgift.progress.view.PacketProgressBar>
