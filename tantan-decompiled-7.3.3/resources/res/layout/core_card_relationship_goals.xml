<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/my_information"
    android:background="@drawable/core_bg_20_ffffff"
    android:paddingTop="24dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.RelationshipGoalsExpandedHolder">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/intl_purpose_title_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="14sp"
            android:textColor="@color/core_color_50percent_000000"
            android:id="@+id/intl_purpose_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_CLONE_SWIPE_PAGE_RELATIONSHIP_GOAL_TITLE"
            android:layout_weight="1"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/intl_purpose_add_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="13sp"
                android:textColor="#ff702d"
                android:id="@+id/intl_purpose_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_RELATIONSHIP_GOALS_ADD_BTN"/>
        </p151v.VLinear>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/intl_purpose_wrap"
        android:background="@drawable/tf_rect_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/intl_purpose_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="20sp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/intl_purpose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:typeface="bold"/>
    </LinearLayout>
</p151v.VLinear>
