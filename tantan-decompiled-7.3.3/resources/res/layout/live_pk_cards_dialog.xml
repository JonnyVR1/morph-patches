<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.module.PkCardsDialogModule">
    <View
        android:id="@+id/view_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="300dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="61dp">
            <p151v.VImage
                android:id="@+id/iv_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f082457"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_alignParentStart="true"/>
            <p151v.VImage
                android:id="@+id/iv_rule"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f082458"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/live_white_80_opacity"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PK道具卡"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="@color/live_white_03_opacity"
            android:layout_width="match_parent"
            android:layout_height="3dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cards_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:layout_marginStart="12dp"/>
    </p151v.VLinear>
</p151v.VLinear>
