<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="9dp"
    android:layout_marginRight="9dp">
    <p151v.VFrame_Squared
        android:id="@+id/frame_square"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:failureImage="0x7f08095c"
            app:placeholderImage="0x7f08095c"
            style="@style/core_im_fresco_profile_small"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/group_identity"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VFrame_Squared>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#505050"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        app:typeface="regular"/>
</p151v.VLinear>
