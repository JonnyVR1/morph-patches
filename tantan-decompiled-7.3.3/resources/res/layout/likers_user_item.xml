<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/new_ui_likers_item_info_bg"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    android:layout_margin="5dp"
    holder="vip.likers.LikersItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="5dp"
        style="@style/core_fresco_base"/>
    <p151v.VImage
        android:id="@+id/newly"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f082ab2"/>
    <LinearLayout
        android:gravity="top|right"
        android:layout_gravity="top|right"
        android:id="@+id/pic_verification_container"
        android:visibility="invisible"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/verification_icon"
            android:background="0x7f082957"
            android:padding="3dp"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/dislike"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081204"/>
    <p151v.VImage
        android:layout_gravity="left"
        android:id="@+id/like"
        android:visibility="invisible"
        android:drawingCacheQuality="high"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f081205"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/usa_like_btn"
        android:visibility="gone"
        android:drawingCacheQuality="high"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="82dp"
        android:layout_marginRight="7dp"
        android:src="0x7f0829d0"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/usa_dislike_btn"
        android:visibility="gone"
        android:drawingCacheQuality="high"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="138dp"
        android:layout_marginRight="7dp"
        android:src="0x7f0829cc"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="182dp">
        <p151v.VLinear_FillerMeasure
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:fillerIndex="0">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#4a4a4a"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#4a4a4a"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/age"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/icon"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </p151v.VLinear_FillerMeasure>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/fuzzy_personal_info"
        android:background="@drawable/likers_fuzzy_personal_info"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <View
            android:background="@drawable/likers_fuzzy_personal_info_line_1"
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginTop="24dp"/>
        <View
            android:background="@drawable/likers_fuzzy_personal_info_line_2"
            android:layout_width="70dp"
            android:layout_height="8dp"
            android:layout_marginTop="40dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/full_card"
        android:background="@drawable/likers_gradient_personal_info_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/SEE_LIST_SORT_ACTIVITY"
            android:drawableLeft="@drawable/core_likers_active_dot"
            android:drawablePadding="4dp"/>
        <p151v.VLinear_FillerMeasure
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:fillerIndex="0"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/see_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重生的小胖, 21"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/see_age"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/match_from"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="4dp"/>
        </p151v.VLinear_FillerMeasure>
        <p151v.VLinear_FillerMeasure
            android:layout_gravity="bottom"
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:fillerIndex="1"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/job"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </p151v.VLinear_FillerMeasure>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.likers.LikersItemView>
