<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.intlUpgrade.IntlUpgradePurchaseSheetItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.intlUpgrade.IntlUpgradePurchaseSheetItemView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/core_intl_upgrade_premium_item_select"
        android:layout_width="match_parent"
        android:layout_height="98dp">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_01"
            android:gravity="center"
            android:id="@+id/hot_tag"
            android:background="@drawable/core_bg_privilege_price_vip_tag"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:text="INTL_UPGRADE_SKU_TAG"
            android:singleLine="true"
            android:paddingHorizontal="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/common_grey_01"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hot_tag"
            app:layout_goneMarginTop="25dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#ffe7aa"
            android:gravity="bottom"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:singleLine="true"
            app:layout_constraintBottom_toTopOf="@+id/origin_price"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#4dffe7aa"
            android:gravity="bottom"
            android:id="@+id/origin_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/price"
            app:layout_constraintVertical_chainStyle="packed"
            app:typeface="regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.intlUpgrade.IntlUpgradePurchaseSheetItemView>
