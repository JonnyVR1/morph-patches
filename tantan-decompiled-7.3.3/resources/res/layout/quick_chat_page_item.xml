<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    attachToRoot="true"
    holder="quickaudio.newquickchat.secondfloor.item.QuickChatPageItem">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/rootView"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="161dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66ffffff"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:lineHeight="22.4dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#33ffffff"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="16dp"
            android:lineHeight="18.2dp"/>
        <p151v.VImage
            android:id="@+id/head_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="0x7f0815ac"
            android:layout_marginStart="16dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/real_head_icon"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.messages.anim.view.widget.ImageXfermodeView
                android:id="@+id/user_model_1"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerHorizontal="true"
                app:roundAsCircle="true"/>
            <com.p051p1.mobile.putong.core.newui.messages.anim.view.widget.ImageXfermodeView
                android:id="@+id/user_model_2"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-4dp"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:id="@+id/user_model_3"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-4dp"
                app:roundAsCircle="true"/>
        </p151v.VLinear>
    </p151v.VLinear>
</merge>
