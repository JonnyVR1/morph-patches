<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.likedusers.LikedUserHeaderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="likedusers.LikedUserHeaderView">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#8e8e93"
        android:gravity="center"
        android:id="@+id/content"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:text="@string/CORE_SVIP_BROWSE_LIKED_REMIND_TOP"
        android:lineSpacingExtra="4dp"
        app:typeface="medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_frame"
        android:paddingTop="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content_frame_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            style="@style/core_vip_normal_title_style"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_vip_normal_subtitle_text_color"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content_frame_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:maxLines="2"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.likedusers.LikedUserHeaderView>
