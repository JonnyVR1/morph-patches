<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/comment_bar"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/shadow"
        android:background="#f7f7f7"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="3dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/root"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <p151v.VEditText
            android:textSize="14sp"
            android:textColorHint="@color/text_light"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:background="@null"
            android:paddingLeft="20dp"
            android:paddingTop="6dp"
            android:paddingRight="4dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/HINT_SAY_SOMETHING"
            android:maxLines="3"
            android:maxLength="180"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            app:typeface="regular"
            style="@style/v_edit_text"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feed_input_orange_disabled_light"
            android:gravity="center"
            android:id="@+id/send"
            android:background="@drawable/tf_rect_light"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/MESSAGES_SEND"
            android:singleLine="true"
            android:textAllCaps="true"
            app:textAllCaps="false"/>
    </LinearLayout>
    <p151v.VLinear
        android:id="@+id/emoji_ll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
