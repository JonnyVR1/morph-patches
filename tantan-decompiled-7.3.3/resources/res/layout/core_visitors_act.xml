<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="visitor.VisitorsViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/bar"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:title="我的访客"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:background="@drawable/core_fun_tab_bg"
            android:visibility="visible"
            android:fadingEdgeLength="0dp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:requiresFadingEdge="horizontal"
            app:tabBackground="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="#fe7e1d"
            app:tabIndicatorGravity="bottom"
            app:tabIndicatorHeight="3dp"
            app:tabMaxWidth="0dp"
            app:tabMinWidth="0dp"
            app:tabMode="fixed"
            app:tabRippleColor="@android:color/transparent"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VLinear>
    <p151v.VRelative
        android:gravity="center_horizontal"
        android:id="@+id/no_permission"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/permission_img"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="134dp"
            android:src="0x7f0819db"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_e6000000"
            android:id="@+id/permission_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/permission_img"
            android:layout_centerHorizontal="true"
            android:fontFamily="PingFangSc-Medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_03"
            android:gravity="center_horizontal"
            android:id="@+id/permission_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/permission_subtitle"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="15dp"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/core_color_f9f9f9"
            android:gravity="center"
            android:id="@+id/permission_btn"
            android:background="@drawable/core_visitor_setting_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:text="开启访客"
            android:layout_alignParentBottom="true"/>
    </p151v.VRelative>
</FrameLayout>
