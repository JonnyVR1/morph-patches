<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_player_root"
    android:paddingLeft="10dp"
    android:layout_width="203dp"
    android:layout_height="70dp"
    android:layout_margin="12dp"
    flatten="false"
    folder="newui"
    holder="view.FeedGlobalPlayerView">
    <FrameLayout
        android:id="@+id/audio_head_container"
        android:layout_width="51dp"
        android:layout_height="51dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="false">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/audio_player_head"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:roundAsCircle="true"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading_view"
            android:visibility="visible"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateDrawable="@drawable/feed_global_player_loading"
            android:indeterminateDuration="600"/>
        <com.p051p1.mobile.putong.feed.newui.view.progressbar.FeedProgressBar
            android:layout_gravity="center"
            android:id="@+id/audio_play_progress_bar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:feedProgressStrokeWidth="3dp"
            app:feedProgressType="CIRCLE"
            app:feedTopProgressColor="@color/common_orange"
            app:feedUnderPaintColor="#f2f2f2"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/feed_player_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/audio_head_container"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/audio_like_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/audio_comment_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/audio_like_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="19dp"
            android:src="0x7f081d10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/audio_comment_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
