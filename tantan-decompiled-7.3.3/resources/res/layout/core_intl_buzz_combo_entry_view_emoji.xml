<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="224dp"
    attachToRoot="true"
    folder="ui"
    holder="lovebuzz.widget.MemojiBuzzComboEntranceView">
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/content_root"
        android:background="@color/white"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp">
        <p151v.VFrame
            android:layout_gravity="center_horizontal"
            android:id="@+id/preview_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/content_bg"
            android:background="0x7f080a52"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:background="0x7f080a53"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginTop="55dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="33dp"
            android:text="@string/INTL_BUZZ_MEMOJI_TITLE1"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_color_99ffffff"
            android:ellipsize="end"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="15dp"
            android:maxLines="2"
            app:typeface="regular"/>
    </p151v.VFrame>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/red_dot"
        android:background="@drawable/core_intl_love_buzz_red_dot_with_entrance"
        android:visibility="visible"
        android:layout_width="20dp"
        android:layout_height="20dp"/>
</merge>
