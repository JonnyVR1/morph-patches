<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemPromptIntl xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.ItemPromptIntl">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/part1"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="16dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f081627"/>
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/messages_prompt_top_trigon"/>
            <p151v.VFrame
                android:background="@drawable/messages_prompt_intl_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/prevent_harass_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="14dp"
                        android:text="@string/BOTHER_PROMPT_DESCRIPTION"
                        android:lineSpacingExtra="2dp"
                        app:typeface="regular"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        flatten="true">
                        <View
                            android:background="#e1e1e1"
                            android:layout_width="match_parent"
                            android:layout_height="1px"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="46dp">
                            <p151v.VText
                                android:textSize="15sp"
                                android:textColor="@color/common_orange"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/prevent_harass_action_yes"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="@string/BOTHER_PROMPT_BUTTON_YES"
                                android:layout_weight="1"
                                app:typeface="medium"/>
                            <View
                                android:background="#e1e1e1"
                                android:layout_width="1px"
                                android:layout_height="match_parent"/>
                            <p151v.VText
                                android:textSize="15sp"
                                android:textColor="@color/common_orange"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/prevent_harass_action_no"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="@string/BOTHER_PROMPT_BUTTON_NO"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/part1_done"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#b8b8b8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="14dp"
                        android:text="@string/BOTHER_PROMPT_DESCRIPTION"
                        android:lineSpacingExtra="2dp"
                        app:typeface="regular"/>
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#b8b8b8"
                        android:gravity="center_vertical"
                        android:id="@+id/part_status"
                        android:layout_width="wrap_content"
                        android:layout_height="47dp"
                        android:layout_marginLeft="16dp"/>
                </LinearLayout>
            </p151v.VFrame>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/part2"
            android:paddingBottom="14dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="16dp"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f081627"/>
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/messages_prompt_top_trigon"/>
            <p151v.VFrame
                android:background="@drawable/messages_prompt_intl_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/report_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="14dp"
                        android:text="@string/REPORT_PROMPT_DESCRIPTION"
                        android:lineSpacingExtra="2dp"
                        app:typeface="regular"/>
                    <View
                        android:background="#e1e1e1"
                        android:layout_width="match_parent"
                        android:layout_height="1px"/>
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="@color/common_orange"
                        android:gravity="center"
                        android:id="@+id/report_yes"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:text="@string/REPORT_PROMPT_BUTTON_YES"
                        app:typeface="medium"/>
                    <View
                        android:background="#e1e1e1"
                        android:layout_width="match_parent"
                        android:layout_height="1px"/>
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="@color/common_orange"
                        android:gravity="center"
                        android:id="@+id/report_no"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:text="@string/REPORT_PROMPT_BUTTON_NO"
                        app:typeface="medium"/>
                </LinearLayout>
                <p151v.VLinear
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/part2_done"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#b8b8b8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="14dp"
                        android:text="@string/REPORT_PROMPT_DESCRIPTION"
                        android:lineSpacingExtra="2dp"
                        app:typeface="regular"/>
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#b8b8b8"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/REPORT_PROMPT_BUTTON_NO"/>
                </p151v.VLinear>
            </p151v.VFrame>
        </LinearLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemPromptIntl>
