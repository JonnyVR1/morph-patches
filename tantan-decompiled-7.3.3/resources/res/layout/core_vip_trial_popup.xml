<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    holder="trial.VipTrialPopup">
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/common_view_popup_bg"
        android:layout_width="311dp"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="#323232"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="限时特惠"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:typeface="medium"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="279dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp">
            <p151v.VFrame
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="0x7f0819bd"/>
                <p151v.VImage
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="0x7f0819bb"
                    android:scaleType="centerCrop"/>
                <View
                    android:layout_gravity="end"
                    android:background="0x7f0819bc"
                    android:layout_width="3dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:background="0x7f0819c0"
                android:paddingLeft="10dp"
                android:paddingTop="23dp"
                android:paddingBottom="25.5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    app:typeface="medium"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_width="263dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp"
            android:text="立即领取"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="0x7f0819b9"/>
</p151v.VFrame>
