<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/test1_benefits_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="22dp">
        <p151v.VText_NoTopPadding
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/test1_benefits_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_BENEFITS_DESCRIPTION_LIST_TITLE"
            android:layout_weight="1"
            app:fontWeight="700"/>
        <p151v.VText_NoTopPadding
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/test1_benefits_you_title"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="@string/INTL_BENEFITS_DESCRIPTION_LIST_YOU"
            app:fontWeight="700"/>
        <p151v.VText_NoTopPadding
            android:textSize="12sp"
            android:textColor="#ffc904"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/test1_benefits_target_title"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="VIP"
            android:maxLines="2"
            android:lineSpacingExtra="0dp"
            app:fontWeight="700"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/test1_benefits_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
</p151v.VLinear>
