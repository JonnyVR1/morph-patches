<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/linear_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="profile.understandme.BusinessWebViewViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textColor="#9aa5b1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pull_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="此页面由武志红心理提供"/>
        <com.p051p1.mobile.putong.core.newui.profile.understandme.PullFrameLayout
            android:id="@+id/pull_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <com.p051p1.mobile.putong.app.web.WebViewX
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.p051p1.mobile.putong.core.newui.profile.understandme.PullFrameLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <include
            android:id="@+id/error"
            android:visibility="invisible"
            layout="@layout/core_business_web_error"/>
        <include
            android:id="@+id/refresh"
            android:visibility="gone"
            layout="@layout/core_business_web_refresh"/>
    </FrameLayout>
</p151v.VLinear>
