<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="group.GroupCreateNameViewModel"
    innerClass="true">
    <p151v.VScroll
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="88dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#222222"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_NAME_PHOTO"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#a8a8a8"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="20dp"
                android:text="@string/CHAT_GROUP_NAME_AND_PHOTO"/>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center_horizontal"
                android:id="@+id/avatar_card"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="30dp"
                app:cardCornerRadius="80dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <p151v.VImage
                    android:id="@+id/avatar_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/core_group_create_avatar"/>
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="20dp">
                <p151v.VEditText
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:textColorHint="#d0d0d0"
                    android:gravity="center_vertical"
                    android:id="@+id/name"
                    android:background="@drawable/core_group_create_edit_text_background"
                    android:paddingLeft="12dp"
                    android:paddingRight="44dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/GROUPCHAT_SET_GROUP_NAME_REMIND"
                    android:maxLength="15"
                    android:inputType="text"/>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/name_clear"
                    android:padding="12dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/core_group_create_edit_text_clear"/>
            </FrameLayout>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/next"
        android:background="@drawable/core_group_create_button_background"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="10dp"
        android:text="@string/CHAT_GROUP_NAME_AND_NEXT"/>
    <p151v.VFrame
        android:background="@drawable/core_group_create_actionbar_background"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VImage
            android:id="@+id/actionbar_back"
            android:padding="16dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/core_actionbar_back"/>
    </p151v.VFrame>
</p151v.VFrame>
