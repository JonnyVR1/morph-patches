<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/input_root"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.TagGuidePicViewModel">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close_btn"
            android:padding="6dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="0x7f082986"
            android:scaleType="centerInside"/>
        <p151v.VButton
            android:textSize="14sp"
            android:layout_gravity="center"
            android:id="@+id/finish_button"
            android:layout_height="34dp"
            android:layout_marginRight="12dp"
            android:text="@string/ACTION_DONE"
            style="@style/common_button_small_01"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/input_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/continue_add_btn"
        android:background="@drawable/core_equity_profile_edit_button_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="继续添加"
        android:layout_marginHorizontal="20dp"/>
</FrameLayout>
