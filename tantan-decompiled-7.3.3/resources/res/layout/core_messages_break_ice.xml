<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemBreakIceMessage xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemBreakIceMessage">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/break_ice_content"
        android:background="@drawable/core_new_messages_prompt"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="10dp"
        flatten="true">
        <p151v.VFrame
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp">
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/svga_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
            <p151v.VImage
                android:id="@+id/normal_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f080ec1"
                android:scaleType="fitCenter"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#66000000"
                android:id="@+id/break_ice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="2dp"/>
            <p151v.VImage
                android:layout_gravity="right"
                android:id="@+id/close"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="-1dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="-1dp"
                android:src="0x7f082894"/>
        </p151v.VFrame>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/break_ice_message1_layout"
            android:background="@drawable/core_bg_10_ffffff"
            android:paddingLeft="16dp"
            android:paddingTop="8.5dp"
            android:paddingRight="12dp"
            android:paddingBottom="8.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_black_02"
                android:layout_gravity="center_vertical"
                android:id="@+id/break_ice_message1_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/break_ice_message1_send"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="5dp"
                android:src="0x7f080ebf"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/break_ice_message2_layout"
            android:background="@drawable/core_bg_10_ffffff"
            android:paddingLeft="16dp"
            android:paddingTop="8.5dp"
            android:paddingRight="12dp"
            android:paddingBottom="8.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_black_02"
                android:layout_gravity="center_vertical"
                android:id="@+id/break_ice_message2_content"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/break_ice_message2_send"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080ebf"
                android:layout_marginStart="5dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemBreakIceMessage>
