<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="384dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetBindCpDialog">
    <View
        android:id="@+id/bg_view"
        android:background="@drawable/live_shape_voice_sweet_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="34dp"/>
    <View
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/bg_view"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_view"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_centerHorizontal="true"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"
        app:roundingBorderColor="#ffffff"
        app:roundingBorderWidth="2dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#f8591c"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="20dp"
        android:singleLine="true"
        android:layout_below="@+id/avatar_view"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSc-Medium"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#f8831c"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSC-Regular"/>
    <include
        android:id="@+id/head_view"
        android:layout_width="335dp"
        android:layout_height="100dp"
        android:layout_marginTop="18dp"
        android:layout_below="@+id/sub_title"
        android:layout_centerHorizontal="true"
        layout="@layout/live_voice_sweet_cp_head_layout"/>
    <View
        android:id="@+id/anchor_View"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#323333"
        android:gravity="center"
        android:id="@+id/cancel_btn"
        android:background="@drawable/live_shape_voice_sweet_nomal_btn_bg"
        android:layout_width="164dp"
        android:layout_height="55dp"
        android:layout_marginTop="31dp"
        android:layout_marginRight="3dp"
        android:text="@string/LIVE_VOICE_CP_LET_ME_THINK"
        android:layout_toLeftOf="@+id/anchor_View"
        android:layout_below="@+id/head_view"
        android:fontFamily="PingFangSc-Medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ok_btn"
        android:background="@drawable/live_shape_voice_sweet_light_btn_bg"
        android:layout_width="164dp"
        android:layout_height="55dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="31dp"
        android:text="@string/LIVE_VOICE_CP_SEND_GIFT_TO_INVITE"
        android:layout_toRightOf="@+id/anchor_View"
        android:layout_below="@+id/head_view"
        android:fontFamily="PingFangSc-Medium"/>
</p151v.VRelative>
