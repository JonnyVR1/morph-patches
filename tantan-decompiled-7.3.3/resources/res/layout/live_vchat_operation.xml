<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatOptView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="internal.vchat"
    holder="view.LiveVChatOptView">
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/count_down_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/video_bt"
        app:layout_constraintEnd_toEndOf="@+id/hang_up_btn"
        app:layout_constraintStart_toStartOf="@+id/hang_up_btn"/>
    <com.p051p1.mobile.putong.live.external.internal.vchat.LiveVChatOptItemView
        android:id="@+id/video_bt"
        android:background="@color/green"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="34dp"
        android:layout_marginRight="6dp"
        app:layout_constraintEnd_toStartOf="@+id/mic_bt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/count_down_text"
        app:layout_goneMarginTop="0dp"/>
    <com.p051p1.mobile.putong.live.external.internal.vchat.LiveVChatOptItemView
        android:id="@+id/mic_bt"
        android:background="@color/green"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        app:layout_constraintEnd_toStartOf="@+id/recharge_bt"
        app:layout_constraintStart_toEndOf="@+id/video_bt"
        app:layout_constraintTop_toTopOf="@+id/video_bt"/>
    <com.p051p1.mobile.putong.live.external.internal.vchat.LiveVChatOptItemView
        android:id="@+id/recharge_bt"
        android:background="@color/green"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        app:layout_constraintEnd_toStartOf="@+id/gift"
        app:layout_constraintStart_toEndOf="@+id/mic_bt"
        app:layout_constraintTop_toTopOf="@+id/video_bt"/>
    <com.p051p1.mobile.putong.live.external.internal.vchat.LiveVChatOptItemView
        android:layout_gravity="center_horizontal"
        android:id="@+id/gift"
        android:background="@color/green"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/recharge_bt"
        app:layout_constraintTop_toTopOf="@+id/video_bt"
        app:layout_goneMarginStart="0dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/hang_up_btn"
        android:background="@drawable/live_bg_ff6464_r32"
        android:padding="6dp"
        android:layout_width="104dp"
        android:layout_height="64dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/live_vector_vchat_opt_bt_hung_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_bt"
        app:layout_goneMarginStart="0dp"/>
</com.p051p1.mobile.putong.live.external.internal.vchat.view.LiveVChatOptView>
