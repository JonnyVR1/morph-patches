<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_voice_room_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="false"
    folder="newui"
    holder="photoalbum.livevoiceroom.FeedLiveVoiceRoomView">
    <p151v.VDraweeView
        android:id="@+id/item_background"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/tag_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <ImageView
                android:id="@+id/iv_voice_mask"
                android:visibility="gone"
                android:layout_width="@dimen/feed_live_voice_mask_width"
                android:layout_height="17dp"
                android:src="0x7f081d5d"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/feature_room"
                android:background="0x7f081f31"
                android:paddingLeft="6dp"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="62dp"
                android:layout_height="17dp"
                android:layout_marginLeft="10dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_voice_game_mask"
                android:background="0x7f081d5c"
                android:paddingLeft="6dp"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:id="@+id/voice_room_tag"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            app:layout_constraintLeft_toRightOf="@+id/tag_group"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:id="@+id/voice_room_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="7dp"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/head_one"
            app:layout_constraintTop_toBottomOf="@+id/voice_room_tag"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:id="@+id/voice_room_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_room_title"/>
        <p151v.VDraweeView
            android:id="@+id/head_third"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/voice_room_title"
            app:roundedCornerRadius="12dp"
            app:roundingBorderColor="#80ffffff"
            app:roundingBorderPadding="1dp"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/head_two"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            app:layout_constraintRight_toRightOf="@+id/head_third"
            app:layout_constraintTop_toTopOf="@+id/head_third"
            app:roundedCornerRadius="12dp"
            app:roundingBorderColor="#80ffffff"
            app:roundingBorderPadding="1dp"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/head_one"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            app:layout_constraintRight_toRightOf="@+id/head_two"
            app:layout_constraintTop_toTopOf="@+id/head_two"
            app:roundedCornerRadius="12dp"
            app:roundingBorderColor="#80ffffff"
            app:roundingBorderPadding="1dp"
            app:roundingBorderWidth="1dp"/>
        <FrameLayout
            android:id="@+id/message_root_container"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/voice_room_location"
            flatten="true"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
