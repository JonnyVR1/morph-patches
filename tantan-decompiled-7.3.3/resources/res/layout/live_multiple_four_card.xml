<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f082275"
        android:scaleType="centerCrop"/>
    <p151v.VImage
        android:id="@+id/iv_top_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:src="0x7f082277"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/tv_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="内容精选"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top_icon"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/tv_top_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="实时互动 声临其境"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_title"/>
    <p151v.VImage
        android:id="@+id/iv_bg1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f082276"
        android:scaleType="fitXY"
        android:rotation="-6"
        app:layout_constraintBottom_toBottomOf="@+id/item_1"
        app:layout_constraintEnd_toEndOf="@+id/item_1"
        app:layout_constraintStart_toStartOf="@+id/item_1"
        app:layout_constraintTop_toTopOf="@+id/item_1"/>
    <p151v.VImage
        android:id="@+id/iv_bg2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f082276"
        android:scaleType="fitXY"
        android:rotation="-6"
        app:layout_constraintBottom_toBottomOf="@+id/item_2"
        app:layout_constraintEnd_toEndOf="@+id/item_2"
        app:layout_constraintStart_toStartOf="@+id/item_2"
        app:layout_constraintTop_toTopOf="@+id/item_2"/>
    <p151v.VImage
        android:id="@+id/iv_bg3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f082276"
        android:scaleType="fitXY"
        android:rotation="-6"
        app:layout_constraintBottom_toBottomOf="@+id/item_3"
        app:layout_constraintEnd_toEndOf="@+id/item_3"
        app:layout_constraintStart_toStartOf="@+id/item_3"
        app:layout_constraintTop_toTopOf="@+id/item_3"/>
    <p151v.VImage
        android:id="@+id/iv_bg4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f082276"
        android:scaleType="fitXY"
        android:rotation="-6"
        app:layout_constraintBottom_toBottomOf="@+id/item_4"
        app:layout_constraintEnd_toEndOf="@+id/item_4"
        app:layout_constraintStart_toStartOf="@+id/item_4"
        app:layout_constraintTop_toTopOf="@+id/item_4"/>
    <com.p051p1.mobile.putong.live.external.page.swipecard.MultipleLiveFourItem
        android:id="@+id/item_1"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/item_3"
        app:layout_constraintEnd_toStartOf="@+id/item_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_sub"/>
    <com.p051p1.mobile.putong.live.external.page.swipecard.MultipleLiveFourItem
        android:id="@+id/item_2"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_1"
        app:layout_constraintTop_toTopOf="@+id/item_1"/>
    <com.p051p1.mobile.putong.live.external.page.swipecard.MultipleLiveFourItem
        android:id="@+id/item_3"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/item_1"
        app:layout_constraintStart_toStartOf="@+id/item_1"
        app:layout_constraintTop_toBottomOf="@+id/item_1"/>
    <com.p051p1.mobile.putong.live.external.page.swipecard.MultipleLiveFourItem
        android:id="@+id/item_4"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_3"
        app:layout_constraintEnd_toEndOf="@+id/item_2"
        app:layout_constraintStart_toStartOf="@+id/item_2"
        app:layout_constraintTop_toTopOf="@+id/item_3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
