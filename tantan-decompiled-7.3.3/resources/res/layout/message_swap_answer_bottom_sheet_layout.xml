<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="ui"
    holder="breaking.SwapAnswerBottomSheetAct">
    <View
        android:id="@+id/view"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_root"
        android:background="@drawable/message_swap_answer_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f082892"
            android:layout_marginEnd="16dp"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/svga_box"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:paddingHorizontal="40dp"
            android:lineHeight="32dp"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:id="@+id/refresh_btn"
            android:background="@drawable/message_swap_answer_dialog_refresh_bg"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/refresh_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0828b8"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="12sp"
                android:textColor="#66000000"
                android:gravity="center"
                android:id="@+id/refresh_tv"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="换一换"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="33dp">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#e5000000"
                android:textColorHint="#33000000"
                android:gravity="start|center_vertical"
                android:id="@+id/edit_text"
                android:background="@drawable/message_swap_answer_dialog_edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="输入答案，双方回答后解锁"
                android:includeFontPadding="false"
                android:maxLength="60"
                android:inputType="text"
                android:textCursorDrawable="@drawable/core_message_input_cursor"
                android:paddingStart="20dp"
                android:paddingEnd="70dp"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16sp"
                android:textColor="#fe7e1d"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发送"
                android:includeFontPadding="false"
                android:layout_marginEnd="20dp"/>
        </p151v.VFrame>
    </p151v.VLinear>
</p151v.VFrame>
