<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_width="1dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@drawable/core_message_bar_new_reference_bg"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/core_view"
        android:background="@drawable/core_message_bar_new_reference_line_bg"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="11dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_color_99000000"
        android:ellipsize="end"
        android:id="@+id/name"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="271dp"
        android:minWidth="129dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintStart_toEndOf="@+id/core_view"
        app:layout_constraintTop_toTopOf="@+id/bg"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_black_02"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/content"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxWidth="271dp"
        android:minWidth="129dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:autoEmojis="true"
        app:enableEmojis="true"
        app:layout_constraintBottom_toBottomOf="@+id/bg"
        app:layout_constraintStart_toEndOf="@+id/core_view"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:typeface="regular"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="0x7f080ead"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
