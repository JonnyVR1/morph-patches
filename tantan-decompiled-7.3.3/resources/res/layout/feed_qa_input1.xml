<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="topic.qatopic.FeedChangeQATopicInputJoinView">
    <View
        android:id="@+id/keyboard_layer_view"
        android:background="#4d000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/moment_bar_parent"
        android:background="@drawable/feed_qa_topic_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close_moment_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:src="0x7f081e89"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/moment_bar"
            android:background="@color/white"
            android:paddingLeft="40dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="144dp">
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:text="参与话题"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#212121"
                android:textColorHint="#d0d0d0"
                android:gravity="top|left"
                android:id="@+id/text"
                android:background="@null"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginRight="20dp"
                android:hint="分享你的观点，可以获得更大曝光..."
                android:maxLines="4"
                android:maxLength="300"
                android:inputType="textMultiLine"
                android:textCursorDrawable="0x7f082a1a"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/send"
                    android:background="@drawable/feed_qa_topic_send_bg_new"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="@string/FEED_RELEASE_NEW"
                    android:singleLine="true"
                    android:drawableRight="0x7f081e69"
                    android:drawablePadding="6dp"
                    android:textAllCaps="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:typeface="medium"/>
                <p151v.VImage
                    android:id="@+id/topic_img"
                    android:visibility="gone"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/feed_post_qa_moment_selector_topic"
                    app:layout_constraintBottom_toBottomOf="@+id/send"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/send"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#979898"
                    android:id="@+id/topic_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="分享我的投票"
                    app:layout_constraintBottom_toBottomOf="@+id/send"
                    app:layout_constraintLeft_toRightOf="@+id/topic_img"
                    app:layout_constraintTop_toTopOf="@+id/send"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
