<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.VirtualVoiceUserCardMedalAndNameView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="voice"
    holder="usercard.view.VirtualVoiceUserCardMedalAndNameView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxEms="7"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/gender_age"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:paddingStart="1dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="5dp">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/gender"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/view_group_medals_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_white_50_opacity"
                android:id="@+id/relationship_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/split"
                android:background="@drawable/live_bg_8c8c8e_oval"
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginStart="6dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_white_50_opacity"
                android:id="@+id/city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_white_50_opacity"
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/view_group_medals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/user_level"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="14dp"
                fresco:actualImageScaleType="fitCenter"/>
            <p151v.VDraweeView
                android:id="@+id/starlight"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="14dp"
                android:layout_marginStart="5dp"
                fresco:actualImageScaleType="fitCenter"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/room_identity"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginStart="5dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:id="@+id/constellation"
                android:background="@drawable/live_bg_white_r5_a10"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <p151v.VDraweeView
                android:id="@+id/vip"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
            <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                android:id="@+id/medal_view_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.voice.usercard.view.VirtualVoiceUserCardMedalAndNameView>
