<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_bg_16_ffe9a8"
    android:paddingLeft="10dp"
    android:paddingTop="10dp"
    android:paddingRight="20dp"
    android:paddingBottom="10dp"
    android:layout_width="wrap_content"
    android:layout_height="60dp">
    <p151v.VDraweeView
        android:id="@+id/new_tag_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/white"
        app:roundBottomEnd="true"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundBottomStart="true"
        app:roundedCornerRadius="8dp"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/core_color_b3000000"
        android:ellipsize="end"
        android:id="@+id/new_tag_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/new_tag_add_user"
        app:layout_constraintLeft_toRightOf="@+id/new_tag_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/core_color_4d000000"
        android:ellipsize="end"
        android:id="@+id/new_tag_add_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/new_tag_icon"
        app:layout_constraintTop_toBottomOf="@+id/new_tag_title"
        app:layout_constraintVertical_chainStyle="packed"
        app:typeface="regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
