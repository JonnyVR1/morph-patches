<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="intl.view.widgets"
    holder="IntlVoiceActivitiesInChatView">
    <p151v.VFrame
        android:layout_gravity="center"
        android:clipChildren="false"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="9.5dp"
        android:layout_marginRight="9.5dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/staticIcon"
            android:clickable="true"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:actualImageResource="0x7f082755"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.live.base.view.LiveHaloAvatar
            android:layout_gravity="center"
            android:id="@+id/singleAvatar"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:avatarSize="45dp"
            app:haloEndColor="#fe7e1d"
            app:haloSize="55dp"
            app:haloStartColor="#fe7e1d"
            app:innerStrokeWidth="3dp"
            app:outerStrokeWidth="3dp"/>
        <com.p051p1.mobile.putong.live.external.intl.view.widgets.ClipLayout
            android:layout_gravity="center"
            android:id="@+id/dynamicAvatarGroup"
            android:visibility="gone"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:shapeType="circle"/>
        <p151v.VImage
            android:layout_gravity="end|top"
            android:id="@+id/redDot"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/live_shape_circle_red_dot"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_weight="1"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/LIVE_VOICE_CELL_TITLE"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_black_40_opacity"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/LIVE_VOICE_CELL_CONTENTB"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/check"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="55dp"
            android:text="@string/LIVE_VOICE_CELL_BUTTON"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/live_black_40_opacity"
            android:layout_gravity="end"
            android:id="@+id/time_big"
            android:paddingTop="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>/&gt; 
    </p151v.VFrame>
</merge>
