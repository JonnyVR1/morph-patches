<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="0x7f0829f8"/>
    <p151v.VDraweeView
        android:id="@+id/me_icon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="24sp"
        android:textColor="#212121"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="25dp"
        app:typeface="medium"/>
    <p151v.VButton
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/login"
        android:background="@drawable/common_button_btn_orange_large"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:layout_marginTop="35dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="33dp"
        app:typeface="regular"/>
</p151v.VLinear>
