<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationHeadBackUserTipLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_card_bg_medium_02"
    android:clipChildren="false"
    android:layout_width="236dp"
    android:layout_height="114dp"
    folder="newui"
    holder="messages.ConversationHeadBackUserTipLayout">
    <p151v.VImage
        android:id="@+id/first_hand_img"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:src="0x7f08090d"
        android:layout_marginStart="12dp"/>
    <View
        android:id="@+id/first_user_img_bg"
        android:background="@drawable/core_growth_back_user_icon_bg"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="42dp"/>
    <p151v.VDraweeView
        android:id="@+id/first_user_img"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="45dp"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <View
        android:id="@+id/second_user_img_bg"
        android:background="@drawable/core_growth_back_user_icon_bg"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="72dp"/>
    <p151v.VDraweeView
        android:id="@+id/second_user_img"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="75dp"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#cc000000"
        android:id="@+id/tv_back_user_message_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="终于等到你，欢迎回来！"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#66000000"
        android:id="@+id/tv_back_user_message_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:text="来看看你不在的时候，发生了什么？"
        android:layout_marginStart="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationHeadBackUserTipLayout>
