<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.officialshow.showlist.OfficialShowPlayBillView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_bg_b3000000_r10"
    android:visibility="gone"
    android:layout_width="145dp"
    android:layout_height="wrap_content"
    flatten="true"
    holder="officialshow.showlist.OfficialShowPlayBillView">
    <TextView
        android:textSize="10dp"
        android:textColor="@color/live_white"
        android:gravity="center_vertical"
        android:id="@+id/menu_title"
        android:background="@drawable/live_bg_black_tr10_a20"
        android:paddingLeft="10dp"
        android:paddingRight="7dp"
        android:layout_width="145dp"
        android:layout_height="30dp"
        android:text="节目单"
        android:drawableRight="0x7f082426"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fix_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/title"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.live.base.view.LiveMainlandTagView
            android:layout_gravity="center"
            android:id="@+id/live_tag"
            android:background="@drawable/live_shape_activity_living_tag_bg"
            android:visibility="visible"
            android:layout_width="18dp"
            android:layout_height="12dp"
            android:layout_marginTop="21dp"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintLeft_toLeftOf="@+id/avatar"
            app:layout_constraintRight_toRightOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="title"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toTopOf="@+id/desc"
            app:layout_constraintLeft_toRightOf="@+id/avatar"
            app:layout_constraintRight_toLeftOf="@+id/follow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/live_white_60_opacity"
            android:ellipsize="end"
            android:id="@+id/desc"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="desc"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/title"
            app:layout_constraintRight_toRightOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/follow"
            android:background="@drawable/live_bg_fe7e1d_r5"
            android:layout_width="26dp"
            android:layout_height="15dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="8dp"
            android:text="关注"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:visibility="visible"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"/>
</com.p051p1.mobile.putong.live.livingroom.officialshow.showlist.OfficialShowPlayBillView>
