<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="pk.module.PkMatchModule">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_tr8"
        android:layout_width="match_parent"
        android:layout_height="230dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="12dp"
                android:src="0x7f082446"/>
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#f57c00"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_PK_SEEKING_TITLE"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="128dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/me"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1">
                    <p151v.VDraweeView
                        android:layout_gravity="center"
                        android:id="@+id/me_avatar"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        app:roundAsCircle="true"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/me_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="用户昵称昵称昵称"
                        android:maxLines="1"
                        android:maxEms="6"
                        android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/other"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VDraweeView
                            android:layout_gravity="center"
                            android:id="@+id/other_avatar"
                            android:visibility="gone"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            app:actualImageScaleType="centerCrop"
                            app:roundAsCircle="true"/>
                        <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkMatchProfileView
                            android:layout_gravity="center"
                            android:id="@+id/match_profile_view"
                            android:visibility="visible"
                            android:layout_width="70dp"
                            android:layout_height="70dp">
                            <p151v.VImage
                                android:id="@+id/next_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerInside"/>
                            <p151v.VImage
                                android:id="@+id/current_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerInside"/>
                            <p151v.VImage
                                android:id="@+id/fail_image_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="0x7f082461"
                                android:scaleType="centerInside"/>
                            <p151v.VImage
                                android:layout_gravity="center"
                                android:id="@+id/fail_image_face"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:src="0x7f082462"
                                android:scaleType="centerInside"/>
                            <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkMatchProfileMaskView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkMatchProfileView>
                    </FrameLayout>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/other_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/LIVE_PK_SEEKING_RESTART_BUTTON_TITLE"
                        android:maxLines="1"
                        android:maxEms="6"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
            <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
                android:layout_gravity="center_horizontal"
                android:id="@+id/center_svga_view"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginTop="21dp"/>
            <com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkMatchLoadView
                android:layout_gravity="center_horizontal"
                android:id="@+id/load_view"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginTop="21dp"/>
        </FrameLayout>
        <Button
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:background="@drawable/live_shape_pk_seek_button"
            android:text="@string/LIVE_CANCEL_MATCH"
            android:textAllCaps="false"
            style="@style/live_pk_bottom_button_style"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:layout_gravity="center"
            android:id="@+id/retry_button"
            android:background="@drawable/live_bg_fe7e1d_r16"
            android:text="@string/LIVE_PK_SEEKING_RESTART_BUTTON_TITLE"
            android:textAllCaps="false"
            style="@style/live_pk_bottom_button_style"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#212121"
            android:layout_gravity="center"
            android:id="@+id/match_tip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
</LinearLayout>
