<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="status.aquare.FeedStatusListTabFrag">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <com.p051p1.mobile.putong.feed.newui.status.entrance.followheader.FeedVDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/head"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedLinearWithExtraIconsView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="30dp"
            app:fillerIndex="0"
            flatten="false">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/feed_nearby_topic_color"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedLinearWithExtraIconsView>
        <com.p051p1.mobile.putong.feed.newui.status.display.card.VPagerWithDefaultSize
            android:layout_gravity="center_horizontal"
            android:id="@+id/pager"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:layout_weight="1"
            android:overScrollMode="never"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/empty"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        flatten="true">
        <ImageView
            android:id="@+id/empty_img"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#323232"
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/empty_img"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
