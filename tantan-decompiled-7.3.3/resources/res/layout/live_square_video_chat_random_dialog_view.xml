<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.live.square.fragments.videochat.dialog.LiveVideoChatRandomDialog xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal.live.square"
    holder="fragments.videochat.dialog.LiveVideoChatRandomDialog">
    <View
        android:id="@+id/background"
        android:background="@color/live_black_40_opacity"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_tr24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="48dp"
            android:src="0x7f082739"/>
        <TextView
            android:textSize="22dp"
            android:textColor="@color/live_black_80_opacity"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="31dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="8dp"
            android:text="随机匹配剩余次数：0"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center_vertical"
            android:id="@+id/desc1"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:text="文本1"
            android:drawableLeft="0x7f082738"
            android:drawablePadding="4dp"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center_vertical"
            android:id="@+id/desc2"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:text="文本2"
            android:drawableLeft="0x7f082738"
            android:drawablePadding="4dp"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center_vertical"
            android:id="@+id/desc3"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:text="文本3"
            android:drawableLeft="0x7f082738"
            android:drawablePadding="4dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="立即发起"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.external.internal.live.square.fragments.videochat.dialog.LiveVideoChatRandomDialog>
