<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.likeminded.LikeMindedCardTabView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_intl_like_minded_card_tab_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    flatten="true"
    holder="likeminded.LikeMindedCardTabView">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/image"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:actualImageScaleType="centerInside"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerCrop"
        style="@style/core_fresco_base"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="17dp"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.core.p058ui.likeminded.LikeMindedCardTabView>
