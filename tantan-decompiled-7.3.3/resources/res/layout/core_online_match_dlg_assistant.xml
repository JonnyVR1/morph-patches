<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VHandleBar
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:src="0x7f0812f4"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#323232"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="小助手提醒"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/gray_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="放宽原有年龄筛选条件，匹配率翻倍"/>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <p151v.VText
                android:text="@string/SETTINGS_AGE"
                style="@style/core_newfilter_subtitle"/>
            <TextView
                android:id="@+id/age_text"
                style="@style/core_newfilter_value_tip"/>
        </p151v.VFrame>
        <p151v.VRangeSlider
            android:id="@+id/show_ages"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="-5dp"
            android:layout_marginRight="20dp"
            android:valueFrom="16"
            android:valueTo="50"
            android:layout_marginHorizontal="20dp"
            style="@style/core_newfilter_slider"/>
        <p151v.VButton
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/start"
            android:background="@drawable/core_online_match_dlg_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="开启配对"
            android:layout_marginHorizontal="20dp"/>
    </p151v.VLinear>
</p151v.VLinear>
