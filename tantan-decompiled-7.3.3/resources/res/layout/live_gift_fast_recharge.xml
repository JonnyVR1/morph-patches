<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="recharge.BaseFastRechargeDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="59dp"
        app:layout_constraintBottom_toTopOf="@+id/fast_recharge_constrain"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.recharge.CustomClickConstraintLayout
        android:id="@+id/fast_recharge_constrain"
        android:background="@drawable/live_bg_white_tr24"
        android:paddingTop="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/local_first_recharge_sub_title"
            android:background="@drawable/live_bg_ffe6ae_r16"
            android:visibility="gone"
            android:layout_width="256dp"
            android:layout_height="27dp"
            android:layout_marginTop="43dp"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toTopOf="@+id/remain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/fast_recharge_constrain"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_ffeca4"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/local_first_recharge_sub_title_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/LIVE_NEW_FIRST_RECHARGE_DIALOG_SUB_TITLE"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_ffeca4"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/local_first_recharge_sub_title_time_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </p151v.VFrame>
        <p151v.VImage
            android:id="@+id/question_icon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f082410"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/local_first_recharge_sub_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/local_first_recharge_sub_title"/>
        <p151v.VFrame
            android:id="@+id/local_first_recharge_top_view"
            android:paddingBottom="116dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="336dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/LIVE_DEPOSIT_TANTAN_COIN"
            app:layout_constraintBottom_toTopOf="@+id/remain"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_a36313"
            android:id="@+id/remain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/top_left"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <include
            android:id="@+id/top_left"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_left"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/top_center"
            layout="@layout/live_gift_fast_item"/>
        <include
            android:id="@+id/top_center"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintLeft_toRightOf="@+id/top_left"
            app:layout_constraintRight_toLeftOf="@+id/top_right"
            app:layout_constraintTop_toTopOf="@+id/top_left"
            layout="@layout/live_gift_fast_item"/>
        <include
            android:id="@+id/top_right"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            app:layout_constraintLeft_toRightOf="@+id/top_center"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_left"
            layout="@layout/live_gift_fast_item"/>
        <include
            android:id="@+id/bottom_left"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginLeft="16dp"
            app:layout_constraintBottom_toTopOf="@+id/pay_group"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/bottom_center"
            layout="@layout/live_gift_fast_item"/>
        <include
            android:id="@+id/bottom_center"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintLeft_toRightOf="@+id/bottom_left"
            app:layout_constraintRight_toLeftOf="@+id/bottom_right"
            app:layout_constraintTop_toTopOf="@+id/bottom_left"
            layout="@layout/live_gift_fast_item"/>
        <include
            android:id="@+id/bottom_right"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            app:layout_constraintLeft_toRightOf="@+id/bottom_center"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_left"
            layout="@layout/live_gift_fast_item"/>
        <p151v.VFrame
            android:id="@+id/pay_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_center"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/local_first_recharge_sub_dialog"
            android:paddingTop="23dp"
            android:paddingBottom="25dp"
            android:visibility="gone"
            android:layout_width="148dp"
            android:layout_height="144dp"
            android:paddingStart="28dp"
            app:layout_constraintEnd_toEndOf="@+id/local_first_recharge_sub_title"
            app:layout_constraintStart_toStartOf="@+id/local_first_recharge_sub_title"
            app:layout_constraintTop_toBottomOf="@+id/local_first_recharge_sub_title"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_ff4747"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:text="全部好礼"
                android:layout_weight="1"/>
            <include
                android:id="@+id/sub_first_gift_one"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_weight="1"
                layout="@layout/live_new_first_recharge_sub_gift_item"/>
            <include
                android:id="@+id/sub_first_gift_two"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_weight="1"
                layout="@layout/live_new_first_recharge_sub_gift_item"/>
            <include
                android:id="@+id/sub_first_gift_three"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                layout="@layout/live_new_first_recharge_sub_gift_item"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.live.livingroom.increment.recharge.CustomClickConstraintLayout>
    <p151v.VDraweeView
        android:id="@+id/title_img"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@+id/shadow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
