<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.setting.hideavatar.view.HideAvatarItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_hide_avatar_pager_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="page.setting"
    holder="hideavatar.view.HideAvatarItemView">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#212121"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/duration"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:layout_marginTop="11dp"
        android:maxLines="1"
        android:drawableStart="0x7f0826d8"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="33dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/select_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="24dp"
        android:src="0x7f0826d7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/lock_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="24dp"
        android:src="0x7f0826d1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="244dp"
        android:layout_height="152dp"
        android:layout_marginTop="25dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration"
        app:placeholderImage="0x7f0822c4"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#212121"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="21dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/gray_999999"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VButton
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/action_button"
        android:background="@drawable/live_bg_ff8817_r16"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="@color/gray_999999"
        android:gravity="center"
        android:id="@+id/tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="22dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_button"/>
</com.p051p1.mobile.putong.live.external.page.setting.hideavatar.view.HideAvatarItemView>
