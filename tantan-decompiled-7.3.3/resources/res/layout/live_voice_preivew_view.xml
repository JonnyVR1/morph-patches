<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.preview.VoicePreviewViewModel xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="#cc121522"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.preview.VoicePreviewViewModel">
    <p151v.VRelative
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:id="@+id/close"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:src="0x7f0827f5"
            android:layout_alignParentTop="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:textColor="@color/live_white"
            android:id="@+id/room_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_VOICE_CREATE"
            android:layout_below="@+id/close"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66ffffff"
            android:id="@+id/sub_title"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/room_title"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_fl"
            android:background="@drawable/live_bg_white_r16_a05"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/sub_title"
            flatten="true">
            <p151v.VEditText
                android:textSize="16dp"
                android:textColor="@color/live_white"
                android:textColorHint="#33ffffff"
                android:id="@+id/pre_et_title"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:hint="@string/LIVE_VOICE_PREVIEW_PLACEHOLDER"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="10"
                android:inputType="textNoSuggestions"
                android:textCursorDrawable="@drawable/live_shape_voice_preview_input_cursor_style"/>
            <p151v.VEditText
                android:textSize="16dp"
                android:textColor="@color/live_white"
                android:textColorHint="#33ffffff"
                android:id="@+id/next_et_title"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:hint="@string/LIVE_VOICE_PREVIEW_PLACEHOLDER"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="10"
                android:inputType="textNoSuggestions"
                android:textCursorDrawable="@drawable/live_shape_voice_preview_input_cursor_style"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white"
            android:id="@+id/last_room_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="20dp"
            android:text="@string/LIVE_VOICE_PREVIEW_LAST_ROOM_TITLE"
            android:layout_below="@+id/edit_fl"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/last_room_title"
            android:background="@drawable/live_selector_voice_last_title_bg"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:text="大家一起聊聊世界杯"
            android:layout_below="@+id/last_room_tv"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white"
            android:id="@+id/label_tv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="20dp"
            android:text="@string/LIVE_VOICE_PREVIEW_TOPIC_TIP"
            android:layout_below="@+id/last_room_title"/>
    </p151v.VRelative>
    <p151v.VScroll
        android:id="@+id/scroll_layout"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/container"
        android:overScrollMode="never"
        flatten="true">
        <org.apmem.tools.layouts.FlowLayout
            android:gravity="left"
            android:id="@+id/flow_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:weightDefault="1"/>
    </p151v.VScroll>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/mic_layout_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="22dp"
        android:layout_above="@+id/tv_create_room"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_ROOM_TYPE"
                android:singleLine="true"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/mic_help"
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:src="0x7f0827f6"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/micModelContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@drawable/live_selector_voice_create_room_button_text_color"
        android:gravity="center"
        android:id="@+id/tv_create_room"
        android:background="@drawable/live_selector_create_voice_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="21dp"
        android:text="@string/LIVE_VOICE_CREATE"
        android:layout_above="@+id/notify_and_mask_ly"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/notify_and_mask_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/notify_fan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_VOICE_PREVIEW_OPEN_PUSH_NOTIFY_FANS"
            android:singleLine="true"
            android:drawableLeft="@drawable/live_selector_voice_preview"
            android:drawablePadding="8dp"
            android:layout_marginStart="31dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:gravity="center_vertical"
            android:id="@+id/voice_mask"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_VOICE_PREVIEW_MASK_MODE"
            android:drawableLeft="@drawable/live_selector_voice_preview"
            android:drawablePadding="8dp"
            android:layout_marginStart="31dp"
            android:layout_marginEnd="20dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.preview.VoicePreviewViewModel>
