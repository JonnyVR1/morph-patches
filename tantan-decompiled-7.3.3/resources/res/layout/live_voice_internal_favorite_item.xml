<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.virtualVoice.favoritevoice.VoiceInternalFavoriteItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_black_r6_a03"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="87dp"
    android:layout_marginLeft="12dp"
    android:layout_marginEnd="12dp"
    folder="internal.virtualVoice.favoritevoice"
    holder="VoiceInternalFavoriteItemView"
    intlSrc="true">
    <com.p051p1.mobile.putong.p070ui.MultipleChatIconView
        android:id="@+id/avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.p051p1.mobile.putong.live.base.view.LiveMainlandTagView
        android:id="@+id/living_view"
        android:layout_width="21dp"
        android:layout_height="15dp"
        android:layout_marginTop="43dp"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:maxLines="1"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="80dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        android:layout_weight="1"
        android:textDirection="ltr"
        android:layout_marginEnd="12dp"
        app:centerEmojis="true"
        app:enableEmojis="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:ellipsize="end"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:singleLine="true"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/go_live_room"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="52dp"
        android:layout_height="34dp"
        android:text="进房"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.external.internal.virtualVoice.favoritevoice.VoiceInternalFavoriteItemView>
