<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="16dp"
        android:textColor="@color/common_exp_black_01"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="20dp"/>
    <FrameLayout
        android:id="@+id/add_introduction"
        android:background="@drawable/core_exp_bg_profile_edit_btn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="16dp"
            android:textColor="@color/common_exp_black_01"
            android:layout_gravity="center"
            android:id="@+id/add_introduction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加自我介绍"/>
    </FrameLayout>
</p151v.VLinear>
