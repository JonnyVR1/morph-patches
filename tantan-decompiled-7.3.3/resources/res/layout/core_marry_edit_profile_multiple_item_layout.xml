        android:textSize="16sp"
        android:textColor="#cc000000"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textFontWeight="500"
        app:typeface="medium"/>
</p151v.VFrame>
