<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="intltribe.IntlTribeSlideViewModel"
    useRefId="true">
    <p151v.VFrame
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/empty_card"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            layout="@layout/core_empty_card_layout_intl_tribe"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/loading"
            android:focusable="false"
            android:clickable="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-100dp">
            <p151v.VFrame_Squared
                android:id="@+id/radar"
                android:layout_width="match_parent"
                android:layout_height="416dp"
                android:layout_centerInParent="true">
                <com.p051p1.mobile.putong.core.p058ui.RadarRipple
                    android:id="@+id/ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:layout_width="@dimen/radar_image_size"
                    android:layout_height="@dimen/radar_image_size"
                    android:outlineSpotShadowColor="#19979797"
                    app:backgroundImage="@color/common_light_04"
                    app:roundingBorderPadding="3dp"
                    style="@style/core_fresco_profile_white_border"/>
            </p151v.VFrame_Squared>
        </RelativeLayout>
        <p151v.VRelative
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/back"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:src="0x7f080ca6"
                android:layout_centerVertical="true"/>
            <p151v.VImage
                android:id="@+id/exit"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:src="0x7f080ca7"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </p151v.VRelative>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"/>
            <p151v.VText
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <include
        android:id="@+id/location"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="65dp"
        layout="@layout/no_location_info"/>
    <p151v.VFrame
        android:id="@+id/card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="119dp"
        flatten="true">
        <p151v.VFrame
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:paddingLeft="8dp"
            android:paddingTop="23dp"
            android:paddingRight="8dp"
            android:paddingBottom="49dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true"/>
    </p151v.VFrame>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_us_profile"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_viewprofile"
            android:background="@drawable/core_bg_view_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="92dp"
            android:layout_marginBottom="70dp"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_viewprofile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_US_VIEWPROFILE"
            android:includeFontPadding="false"
            android:drawableRight="0x7f080795"
            android:drawablePadding="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_viewprofile"
            app:layout_constraintLeft_toLeftOf="@+id/view_viewprofile"
            app:layout_constraintRight_toRightOf="@+id/view_viewprofile"
            app:layout_constraintTop_toTopOf="@+id/view_viewprofile"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:id="@+id/buttons_us"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="70dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/immediately_match"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#d26efa"
            app:buttonColorStart="#d26efa"
            app:icon="@drawable/core_intl_top_immediately_match"
            app:iconWidth="32dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/superlike_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#2bccff"
            app:buttonColorStart="#2bccff"
            app:icon="0x7f08178b"
            app:iconWidth="25dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/like_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_like_end"
            app:buttonColorStart="@color/core_card_ic_us_like_start"
            app:icon="0x7f0820fb"
            app:iconWidth="25dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/dislike_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_dislike"
            app:buttonColorStart="@color/core_card_ic_us_dislike"
            app:icon="0x7f081a79"
            app:iconWidth="20dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/undo_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_undo"
            app:buttonColorStart="@color/core_card_ic_us_undo"
            app:icon="0x7f082a77"
            app:iconHeight="20dp"
            app:iconWidth="26dp"/>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/superlike_combo_anim_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_super_like_combo_anim_view"/>
</FrameLayout>
