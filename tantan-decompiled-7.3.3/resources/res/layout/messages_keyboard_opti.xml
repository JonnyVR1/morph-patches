<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.Keyboard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/core_message_bar_input_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.Keyboard">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/opti_hlist_wrapper"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            flatten="true">
            <p151v.VList_Horizontal
                android:id="@+id/opti_hlist"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <com.google.android.material.appbar.AppBarLayout
                android:orientation="vertical"
                android:id="@+id/opti_app_bar_layout"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp"
                flatten="true">
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/opti_tab_layout"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    app:layout_scrollFlags="snap|enterAlways|scroll"
                    app:tabIndicator="@drawable/core_message_multi_emoji_tab"
                    app:tabIndicatorFullWidth="false"
                    app:tabRippleColor="@color/transparent"
                    flatten="true"/>
            </com.google.android.material.appbar.AppBarLayout>
            <p151v.VPager
                android:id="@+id/opti_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.Keyboard>
