<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemProfileLike xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true">
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemText
        android:textColorLink="@color/white"
        android:autoLink="web"
        android:id="@+id/text"
        android:paddingTop="?attr/right_msg_top_padding"
        android:paddingBottom="?attr/right_msg_bottom_padding"
        android:lineSpacingExtra="1.5dp"
        android:paddingStart="?attr/right_msg_left_padding"
        android:paddingEnd="?attr/right_msg_right_padding"
        app:enableEmojis="true"
        app:largeEmojis="true"
        style="@style/messages_item_right"/>
    <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/content_layout"
        android:background="@drawable/core_bg_18_f9f9f9"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="?attr/core_msg_right_profileLike_margin_top"
        android:layout_marginEnd="?attr/core_msg_right_profileLike_margin_end"
        app:isLeft="false">
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp">
            <p151v.VDraweeView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundBottomLeft="true"
                app:roundBottomRight="true"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="8dp"
                app:roundingBorderWidth="0dp"/>
            <p151v.VImage
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"/>
        </p151v.VFrame>
        <p151v.VLinear
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="14dp">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:lineSpacingExtra="2sp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/common_grey_03"
                android:ellipsize="end"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemProfileLike>
