<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.NewFilterGenderItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/core_newui_filter_zodiacs_item_bg"
    android:clipChildren="false"
    android:layout_width="102dp"
    android:layout_height="102dp"
    attachToRoot="true"
    holder="settings.filter.newui.NewFilterGenderItem">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/img"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/core_newfilter_choose_male_seletor"
            android:scaleType="centerCrop"/>
        <p151v.VText_AutoFit
            android:textSize="14sp"
            android:textColor="@color/core_newui_filter_check_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/choose_ic"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="-12dp"
        android:layout_marginRight="-12dp"
        android:src="0x7f0811e9"
        android:scaleType="centerCrop"/>
</com.p051p1.mobile.putong.core.p058ui.settings.filter.newui.NewFilterGenderItem>
