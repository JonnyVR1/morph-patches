<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.view.VoiceVirtualLovePlanetWidgetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_bg_black_r10_a20"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="virtual.loveplanet.view.VoiceVirtualLovePlanetWidgetView">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/bg_svga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/info_line"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="35dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center_horizontal"
        android:id="@+id/svga"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/info_line"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/host_avatar"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/info_line"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/ll_host_tag"
        android:background="@drawable/live_bg_260e5f_r4_a80"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="@+id/host_avatar"
        app:layout_constraintStart_toStartOf="@+id/host_avatar"
        app:layout_constraintTop_toBottomOf="@+id/info_line"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_host_tag"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="2dp"
            android:src="0x7f082850"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/host_tag"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="主持"
            android:paddingStart="1dp"
            android:paddingEnd="4dp"/>
    </p151v.VLinear>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/info_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="恋爱星球"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toTopOf="@+id/info_line"
        app:layout_constraintStart_toEndOf="@+id/host_avatar"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/game_step_1"
        android:background="@drawable/live_bg_745aff_r4_a20"
        android:paddingTop="1.5dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="自我介绍"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/host_avatar"
        app:layout_constraintTop_toBottomOf="@+id/info_line"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/game_step_2"
        android:background="@drawable/live_bg_745aff_r4_a20"
        android:paddingTop="1.5dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="星动选择"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/game_step_1"
        app:layout_constraintTop_toBottomOf="@+id/info_line"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/game_step_3"
        android:background="@drawable/live_bg_745aff_r4_a20"
        android:paddingTop="1.5dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="公布星动"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/game_step_2"
        app:layout_constraintTop_toBottomOf="@+id/info_line"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/game_step_4"
        android:background="@drawable/live_bg_745aff_r4_a20"
        android:paddingTop="1.5dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="浪漫旅行"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/game_step_3"
        app:layout_constraintTop_toBottomOf="@+id/info_line"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/mvp_avatar"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/info_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/info_line"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/ll_mvp"
        android:background="@drawable/live_bg_260e5f_r4_a80"
        android:layout_width="44dp"
        android:layout_height="16dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="@+id/mvp_avatar"
        app:layout_constraintStart_toStartOf="@+id/mvp_avatar"
        app:layout_constraintTop_toBottomOf="@+id/info_line"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_mvp"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="2dp"
            android:src="0x7f082854"/>
        <com.p051p1.mobile.putong.live.livingroom.view.FocusTextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/mvp_tag"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="32dp"
            android:text="MVP"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingStart="1dp"
            android:paddingEnd="2dp"/>
    </p151v.VLinear>
    <View
        android:id="@+id/divide_line"
        android:background="@color/live_white_05_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="37dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@+id/info_line"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/action"
        android:background="@drawable/live_bg_white_r10_a10"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="加入游戏"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide_line"/>
    <ImageView
        android:id="@+id/more_action"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:src="0x7f0823d9"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide_line"/>
    <FrameLayout
        android:id="@+id/content_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="231dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.loveplanet.view.VoiceVirtualLovePlanetWidgetView>
