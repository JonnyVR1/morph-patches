<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.view.VChatBeautyFilterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal.vchat"
    holder="view.VChatBeautyFilterView"
    useRefId="true">
    <com.p051p1.mobile.putong.live.livingroom.common.bottom.filter.view.OnFlingFrameLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        flatten="true">
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/filter_label"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:maxLines="1"
            android:singleLine="true"
            android:shadowColor="#4c000000"
            android:shadowRadius="2"
            android:layout_marginStart="16dp"/>
    </com.p051p1.mobile.putong.live.livingroom.common.bottom.filter.view.OnFlingFrameLayout>
    <p151v.VRelative
        android:id="@+id/seek_bar_second_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:layout_marginBottom="-20dp"
        android:layout_marginEnd="60dp"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/name_label_second"
            android:layout_width="52dp"
            android:layout_height="50dp"
            android:text="@string/LIVE_BEAUTY_MAKEUP"
            android:shadowColor="#4c000000"
            android:shadowRadius="2"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"/>
        <com.p051p1.mobile.putong.live.livingroom.common.bottom.filter.view.TextSeekBar
            android:id="@+id/seek_bar_second"
            android:tag="makeupstyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-12dp"
            android:layout_toEndOf="@+id/name_label_second"/>
    </p151v.VRelative>
    <p151v.VRelative
        android:id="@+id/seek_bar_layout"
        android:background="@drawable/live_shape_beauty_seek_bar_bg"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginBottom="-15dp"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/name_label"
            android:layout_width="52dp"
            android:layout_height="50dp"
            android:shadowColor="#4c000000"
            android:shadowRadius="2"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"/>
        <com.p051p1.mobile.putong.live.livingroom.common.bottom.filter.view.TextSeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-12dp"
            android:layout_toStartOf="@+id/right_layout"
            android:layout_toEndOf="@+id/name_label"/>
        <FrameLayout
            android:id="@+id/right_layout"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            flatten="true">
            <com.p051p1.mobile.putong.live.livingroom.common.bottom.filter.view.ContrastView
                android:layout_gravity="center_vertical"
                android:id="@+id/contrast"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/live_vector_beauty_contrast"
                android:layout_marginEnd="6dp"/>
        </FrameLayout>
    </p151v.VRelative>
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_tr8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/live_beauty_filter_menu_tab_margin"
                android:layout_marginEnd="@dimen/live_beauty_filter_menu_tab_margin"
                app:tabBackground="@color/transparent"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/live_shape_beauty_indicator"
                app:tabIndicatorColor="@color/black"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="2dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@color/transparent"
                app:tabSelectedTextColor="@color/black"
                app:tabTextAppearance="@style/live_beauty_tab_theme"
                app:tabTextColor="#999999"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/reset"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp">
                <p151v.VImage
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/live_vector_beauty_dialog_reset"/>
                <p151v.VText
                    android:textSize="@dimen/live_beauty_filter_menu_reset_textsize"
                    android:textColor="#bfbfbf"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_BEAUTY_RESET"
                    android:layout_marginStart="2dp"/>
            </p151v.VLinear>
        </RelativeLayout>
        <View
            android:background="#ebebeb"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <p151v.VPagerNoPage
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="115dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.external.internal.vchat.view.VChatBeautyFilterView>
