<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/feed_interested_entrance_bg"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="15dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="4dp"
    folder="newui"
    holder="photoalbum.photoalbumactivities.FeedAlbumInterestedEntranceView">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true">
        <p151v.VFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VFrame
                android:id="@+id/pic_three_fl"
                android:background="@drawable/feed_interested_entrance_pic_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="36dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/pic_three"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    style="@style/feed_fresco_profile_small_recommend"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/pic_two_fl"
                android:background="@drawable/feed_interested_entrance_pic_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="18dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/pic_two"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    style="@style/feed_fresco_profile_small_recommend"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/pic_one_fl"
                android:background="@drawable/feed_interested_entrance_pic_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/pic_one"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    style="@style/feed_fresco_profile_small_recommend"/>
            </p151v.VFrame>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/feed_e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="对你感兴趣的人"
            app:typeface="medium"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/feed_e6000000"
            android:id="@+id/count_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="20dp"
            android:src="0x7f081d43"/>
    </p151v.VLinear>
</p151v.VRelative>
