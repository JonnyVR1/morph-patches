<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/comment_bar"
    android:background="@color/white"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/shadow"
        android:background="#07000000"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/root"
            android:background="@drawable/common_moment_detail_commend_bg"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="13dp">
            <com.p051p1.mobile.putong.newui.view.MessageInputEditView
                android:textSize="16sp"
                android:textColor="#e6000000"
                android:textColorHint="@color/text_light"
                android:layout_gravity="center_vertical"
                android:id="@+id/text"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/HINT_SAY_SOMETHING"
                android:maxLines="3"
                android:maxLength="180"
                android:layout_weight="1"
                android:inputType="textMultiLine"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                app:enableEmojis="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/emoji_img"
                app:layout_constraintTop_toTopOf="parent"
                app:typeface="regular"
                style="@style/v_edit_text"/>
            <p151v.VImage
                android:id="@+id/emoji_img"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="0x7f0807a8"
                android:layout_marginEnd="17dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/send"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/send"
                android:background="@drawable/core_comment_send_bg"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="12dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/MESSAGES_SEND"
                android:singleLine="true"
                android:textAllCaps="true"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textAllCaps="false"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VLinear
            android:gravity="center"
            android:id="@+id/update_greet_ll"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="16dp">
            <p151v.VImage
                android:id="@+id/greet_img"
                android:visibility="visible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/common_commend_update_greet_selector"
                android:scaleType="centerCrop"
                app:layout_constraintLeft_toLeftOf="@+id/text"
                app:layout_constraintTop_toBottomOf="@+id/text"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#33000000"
                android:id="@+id/greet_tv"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="同步发送至打招呼私信"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/greet_img"
                app:layout_constraintLeft_toRightOf="@+id/greet_img"
                app:layout_constraintTop_toTopOf="@+id/greet_img"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VLinear
        android:id="@+id/emoji_ll"
        android:background="#f7f7f7"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
