<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.relationshiplooking.RelationshipLookingViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftIcon="0x7f080387"/>
        <p151v.VText
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/INTL_VOICETRICK_INLT_TTC_CLONE_FILTER_TWO"
            app:typeface="medium"/>
        <com.p051p1.mobile.putong.core.p058ui.settings.filter.tags.TagContainerLayout
            android:id="@+id/relationship_tags"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:column="2"
            app:iscenter="true"
            app:verSpace="11dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/color_text_ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/save_btn"
        android:background="@drawable/core_push_button_bg_orange"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ACTION_SAVE"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</p151v.VFrame>
