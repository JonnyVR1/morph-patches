<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.MusicItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/music_center_item"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="camera.MusicItemView">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="12dp">
            <p151v.VDraweeView
                android:id="@+id/music_center_item_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                fresco:failureImage="0x7f08291c"
                fresco:placeholderImage="0x7f08291c"
                fresco:roundedCornerRadius="2dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/music_center_item_control"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f082924"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#383e46"
                    android:ellipsize="end"
                    android:id="@+id/music_center_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:layout_weight="0"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#383e46"
                    android:layout_gravity="center"
                    android:id="@+id/music_center_item_name_postfix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/FEED_ORIGINAL_SOUNDTRACK"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#9aa5b1"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/music_center_item_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#9aa5b1"
                android:layout_gravity="bottom"
                android:id="@+id/music_center_item_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:text="xxxxxxxxx"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/music_center_item_favor"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:layout_marginRight="10dp"
            android:src="0x7f082920"
            android:scaleType="fitCenter"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/music_center_item_detail"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:src="0x7f08291e"
            android:scaleType="fitCenter"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/music_center_item_select"
        android:background="@drawable/music_item_select"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="16dp"
        android:text="@string/CONFIRM_USE_THE_FUNCTION"/>
    <View
        android:layout_gravity="bottom"
        android:background="#e2e9ee"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
</com.p051p1.mobile.putong.feed.newui.camera.MusicItemView>
