<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.notification.NotificationOptViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VProgressBar
            android:id="@+id/loading_block"
            style="@style/core_loading_block"/>
        <p151v.VScroll
            android:id="@+id/scroll"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:id="@+id/notification_title"
                    android:layout_marginTop="8dp"
                    android:text="推送通知设置"
                    style="@style/core_settings_header0"/>
                <p151v.VFrame
                    android:id="@+id/notification_manager"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:layout_marginBottom="0dp"
                            android:text="接收通知"
                            style="@style/core_settings_primary"/>
                        <p151v.VText
                            android:id="@+id/setting_describe"
                            android:paddingTop="5dp"
                            android:paddingBottom="0dp"
                            android:layout_width="wrap_content"
                            android:text="开启通知提醒，不错过重要消息"
                            style="@style/settings_small_des"/>
                    </LinearLayout>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:id="@+id/notification_state"
                            android:paddingRight="0dp"
                            android:layout_width="wrap_content"
                            style="@style/settings_small_des"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:src="0x7f081f64"
                            style="@style/core_settings_arrow"/>
                    </p151v.VLinear>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/notification_show_previews"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_gravity="center_vertical"
                        android:text="@string/SETTINGS_MESSAGE_PREVIEW_DETAIL"
                        style="@style/core_settings_header1"/>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/notification_ring_toggle"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_gravity="center_vertical"
                        android:text="提示音"
                        style="@style/core_settings_header1"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:src="0x7f081f64"
                        style="@style/core_settings_arrow"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/notification_vibration_toggle"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:layout_gravity="center_vertical"
                        android:text="振动"
                        style="@style/core_settings_header1"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:src="0x7f081f64"
                        style="@style/core_settings_arrow"/>
                </p151v.VFrame>
                <View
                    android:layout_marginTop="12dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:id="@+id/chat_notification"
                    android:layout_marginTop="8dp"
                    android:text="消息通知"
                    style="@style/core_settings_header0"/>
                <p151v.VFrame
                    android:id="@+id/new_match_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:layout_marginBottom="0dp"
                            android:text="新配对通知"
                            style="@style/core_settings_primary"/>
                        <p151v.VText
                            android:paddingTop="5dp"
                            android:paddingBottom="0dp"
                            android:layout_width="wrap_content"
                            android:text="关闭后，有新配对时不再提示"
                            style="@style/settings_small_des"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/chat_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:layout_marginBottom="0dp"
                            android:text="对话消息通知"
                            style="@style/core_settings_primary"/>
                        <p151v.VText
                            android:paddingTop="5dp"
                            android:paddingBottom="0dp"
                            android:layout_width="wrap_content"
                            android:text="关闭后，有新的对话消息时不再提示"
                            style="@style/settings_small_des"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/greet_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="打招呼通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/team_account_notify"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="官方账号通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:id="@+id/team_account_state"
                            android:paddingRight="0dp"
                            android:layout_width="wrap_content"
                            style="@style/settings_small_des"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:src="0x7f081f64"
                            style="@style/core_settings_arrow"/>
                    </p151v.VLinear>
                </p151v.VFrame>
                <View
                    android:layout_marginTop="12dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:id="@+id/moment_notification"
                    android:layout_marginTop="8dp"
                    android:text="动态通知"
                    style="@style/core_settings_header0"/>
                <p151v.VFrame
                    android:id="@+id/moment_update_notify"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="动态更新通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:id="@+id/moment_update_state"
                            android:paddingRight="0dp"
                            android:layout_width="wrap_content"
                            style="@style/settings_small_des"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:src="0x7f081f64"
                            style="@style/core_settings_arrow"/>
                    </p151v.VLinear>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/moment_comment_notify"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="评论通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:id="@+id/moment_comment_state"
                            android:paddingRight="0dp"
                            android:layout_width="wrap_content"
                            style="@style/settings_small_des"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:src="0x7f081f64"
                            style="@style/core_settings_arrow"/>
                    </p151v.VLinear>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/moment_like_notify"
                    flatten="true"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="点赞通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:id="@+id/moment_like_state"
                            android:paddingRight="0dp"
                            android:layout_width="wrap_content"
                            style="@style/settings_small_des"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:src="0x7f081f64"
                            style="@style/core_settings_arrow"/>
                    </p151v.VLinear>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/like_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="谁通过动态喜欢了我"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <View
                    android:id="@+id/divider"
                    android:layout_marginTop="12dp"
                    style="@style/core_settings_divider"/>
                <p151v.VText
                    android:id="@+id/more_notify_setting"
                    android:layout_marginTop="8dp"
                    android:text="更多通知"
                    style="@style/core_settings_header0"/>
                <p151v.VFrame
                    android:id="@+id/oof_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="极限四选一通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/state_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="状态消息通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/chat_partner_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="聊天搭子通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/group_chat_notify"
                    style="@style/core_settings_clickable_item">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="60dp"
                        android:layout_marginEnd="60dp"
                        style="@style/core_settings_stacked_frame">
                        <p151v.VText
                            android:text="群聊通知"
                            style="@style/core_settings_header1"/>
                    </LinearLayout>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/chat_enter_as_send"
                    style="@style/core_settings_clickable_item">
                    <p151v.VText
                        android:text="@string/SETTINGS_PRESS_ENTER_TO_SEND"
                        style="@style/core_settings_header1"/>
                    <p151v.VSwitch style="@style/core_settings_item_switch"/>
                </p151v.VFrame>
            </LinearLayout>
        </p151v.VScroll>
    </p151v.VFrame>
</p151v.VLinear>
