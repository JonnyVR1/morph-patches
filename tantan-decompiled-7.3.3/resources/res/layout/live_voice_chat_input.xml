<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.chat.view.VoiceChatKeyboardRoot xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/input_layout_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.chat.view.VoiceChatInputView">
    <FrameLayout
        android:id="@+id/layout_input_empty"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/input_parent_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:translationY="220dp"
            flatten="true">
            <include
                android:id="@+id/input_chat_tip_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                layout="@layout/live_voice_chat_input_tips"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/voice_input_panel_root"
                android:background="@drawable/live_bg_19191e_tr24"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="62dp">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/input_layout"
                        android:background="@drawable/live_bg_white_r10_a03"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1">
                        <p151v.VEditText
                            android:textSize="14dp"
                            android:textColor="@color/white"
                            android:textColorHint="#66ffffff"
                            android:gravity="center_vertical"
                            android:id="@+id/edit_text"
                            android:background="@null"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/LIVE_PLEASE_TALK_SOMTHING"
                            android:maxLines="2"
                            android:layout_weight="1"
                            app:enableEmojis="true"
                            app:typeface="regular"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/emoji_view"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="8.8dp"
                            android:src="0x7f08228f"/>
                    </LinearLayout>
                    <p151v.VText
                        android:enabled="false"
                        android:textSize="15sp"
                        android:textColor="#33ffffff"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/done"
                        android:background="@drawable/live_selector_new_chat_input_done"
                        android:layout_width="60dp"
                        android:layout_height="38dp"
                        android:layout_marginRight="12dp"
                        android:text="@string/LIVE_SEND_MESSAGE"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/emoji_root"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    flatten="true">
                    <p151v.VPager
                        android:id="@+id/opti_pager"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never"/>
                </FrameLayout>
            </LinearLayout>
        </p151v.VLinear>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.chat.view.VoiceChatKeyboardRoot>
