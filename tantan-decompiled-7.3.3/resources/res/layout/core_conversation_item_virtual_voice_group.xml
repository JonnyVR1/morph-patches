<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemVirtualVoiceGroupView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemVirtualVoiceGroupView">
    <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
        android:id="@+id/halo_bg"
        android:visibility="invisible"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginStart="9dp"
        app:avatarSize="47dp"
        app:haloEndColor="#35d3ff"
        app:haloSize="61dp"
        app:haloStartColor="#35d3ff"
        app:isStartAnimator="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.p070ui.MultipleChatIconView
        android:id="@+id/avatar"
        android:layout_width="47dp"
        android:layout_height="47dp"
        app:layout_constraintBottom_toBottomOf="@+id/halo_bg"
        app:layout_constraintEnd_toEndOf="@+id/halo_bg"
        app:layout_constraintStart_toStartOf="@+id/halo_bg"
        app:layout_constraintTop_toTopOf="@+id/halo_bg"
        app:roundAsCircle="true"/>
    <p151v.VImage
        android:gravity="center"
        android:id="@+id/new_state_red_dot"
        android:background="@drawable/core_match_reminder_bg"
        android:visibility="visible"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/unread_text_root"
        android:background="@drawable/core_bg_conversation_unread_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="35dp"
        app:layout_constraintStart_toStartOf="@+id/halo_bg"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/unread_text_icon"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="24dp"
            android:text=""/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:maxLines="1"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintEnd_toStartOf="@+id/end_layout"
        app:layout_constraintStart_toEndOf="@+id/halo_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:layout_weight="1"
        android:textDirection="ltr"
        android:layout_marginEnd="9dp"
        app:centerEmojis="true"
        app:enableEmojis="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/end_layout"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:typeface="regular"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/end_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:layout_marginEnd="12dp"
            app:typeface="regular"/>
        <p151v.VLinear
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/silent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0810c6"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginStart="10dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/check"
        android:background="@drawable/core_add_tag_entry_bg"
        android:visibility="invisible"
        android:layout_width="55dp"
        android:layout_height="41dp"
        android:text="查看"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemVirtualVoiceGroupView>
