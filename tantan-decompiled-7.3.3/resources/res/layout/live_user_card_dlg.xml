<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="common"
    holder="usercard.UserCardDialog">
    <View
        android:id="@+id/card"
        android:background="@drawable/live_bg_191919_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_view"
        app:layout_constraintTop_toTopOf="@+id/head_image_layout"
        flatten="true"/>
    <include
        android:id="@+id/user_card_skin_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/top_placeholder"
        ignore="true"
        layout="@layout/live_user_card_skin_view"/>
    <Space
        android:id="@+id/top_placeholder"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toTopOf="@+id/card"
        ignore="true"/>
    <FrameLayout
        android:id="@+id/head_image_layout"
        android:background="0x7f0826c3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toTopOf="@+id/medal_and_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/pic_verification"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="19dp"
            android:layout_marginBottom="12dp"/>
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="bottom|right"
            android:id="@+id/small_image"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="-12dp"
            android:layout_marginBottom="12dp"/>
    </FrameLayout>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/guard_image"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/head_image_layout"
        app:layout_constraintLeft_toLeftOf="@+id/head_image_layout"/>
    <include
        android:id="@+id/medal_and_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/grade_module"
        app:layout_goneMarginBottom="30dp"
        flatten="true"
        layout="@layout/live_user_card_dlg_medal_and_name"/>
    <p151v.VLinear
        android:gravity="center"
        android:id="@+id/grade_module"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/guard_root"
        flatten="true">
        <include
            android:id="@+id/user_level"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            layout="@layout/live_card_user_level"/>
        <include
            android:id="@+id/anchor_level"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="9dp"
            layout="@layout/live_card_anchor_level"/>
        <include
            android:id="@+id/fans_level"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            layout="@layout/live_card_fans_level"/>
        <include
            android:id="@+id/family_group"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            flatten="true"
            layout="@layout/live_voice_card_family_group_enter_view"/>
    </p151v.VLinear>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/guard_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/grade_module"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/new_gift_wall"
        flatten="true">
        <include
            android:id="@+id/guard_module"
            android:visibility="visible"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            layout="@layout/live_guard_entrance_view"/>
    </LinearLayout>
    <include
        android:id="@+id/new_gift_wall"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/contribution_list"
        layout="@layout/live_new_gift_wall_entrance_view_layout"/>
    <include
        android:id="@+id/contribution_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/mystery_text"
        layout="@layout/live_user_card_dlg_contribution"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center_horizontal"
        android:id="@+id/mystery_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="32dp"
        android:minHeight="44dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_action_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_view"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/at_him"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/join_call"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/send_gift"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_SEND_GIFT"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/attention"
            android:background="@drawable/live_bg_ff8817_r16"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_FOLLOW"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/go_live_room"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/fansgroup"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_FANSGROUP_TITLE"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/tv_change_mask"
            android:background="@drawable/live_bg_white_r16_a10"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/LIVE_VOICE_MASK_CHANGE"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
    <View
        android:id="@+id/bottom_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VImage
        android:gravity="center"
        android:id="@+id/manage_img"
        android:layout_width="18dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:src="0x7f082346"
        app:layout_constraintRight_toRightOf="@+id/card"
        app:layout_constraintTop_toTopOf="@+id/card"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/card"
        app:layout_constraintTop_toTopOf="@+id/card"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/guard"
            android:background="@drawable/live_bg_black_r11_a10"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="5dp"
            android:maxWidth="116dp"
            android:maxLines="1"
            android:layout_alignParentLeft="true"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center"
            android:id="@+id/super_manager"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginLeft="12dp"
            android:text="管理"
            android:drawablePadding="4dp"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#9aa5b1"
        android:gravity="center"
        android:id="@+id/no_data_hint"
        android:background="@drawable/live_bg_white_tr24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="356dp"
        android:text="@string/LIVE_PROFILE_DATA_LOAD_FAIL"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
