<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_speed_up_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="quickaudio.card.SpeedUpCardViewModel">
    <p151v.VRelative
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VImage
            android:id="@+id/speed_up_cord_close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="0x7f080987"
            android:layout_marginStart="16dp"/>
        <p151v.VImage
            android:id="@+id/speed_up_card_help_btn"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:src="0x7f080988"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/speed_up_card_btns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginRight="46dp"
        android:layout_marginBottom="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/core_gray_4c4c4c"
            android:gravity="center"
            android:id="@+id/speed_up_card_buy_btn"
            android:background="@drawable/core_bg_speed_up_card_buy_btn"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="立刻购买"
            android:layout_weight="1"
            android:paddingVertical="16dp"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/speed_up_card_use_btn"
            android:background="@drawable/core_bg_speed_up_card_use_btn"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="开始使用"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:paddingVertical="16dp"/>
    </p151v.VLinear>
    <p151v.VRelative
        android:orientation="vertical"
        android:id="@+id/speed_up_card_layout"
        android:background="0x7f080531"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="480dp"
        android:layout_marginBottom="30dp"
        android:layout_above="@+id/speed_up_card_btns"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="30sp"
            android:textColor="@color/white"
            android:id="@+id/speed_up_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="加速卡"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/white"
            android:id="@+id/speed_up_card_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="优先推荐快人一步"
            android:layout_below="@+id/speed_up_card_title"
            android:layout_centerHorizontal="true"/>
        <p151v.VFrame
            android:id="@+id/card_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:rotation="-5">
            <p151v.VImage
                android:layout_width="158dp"
                android:layout_height="210dp"
                android:src="0x7f081332"/>
            <p151v.VText
                android:textSize="21.6sp"
                android:textColor="@color/core_gray_4c4c4c"
                android:layout_gravity="center_horizontal"
                android:id="@+id/center_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="加速卡"/>
            <p151v.VText
                android:textSize="21sp"
                android:textColor="@color/core_gray_4c4c4c"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/speed_up_card_remain"
                android:background="0x7f081334"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-25dp"
                android:text="5"
                android:layout_marginEnd="-25dp"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/speed_up_card_use_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="38756人正在使用该道具"
            android:layout_above="@+id/speed_up_card_hey"
            android:layout_centerHorizontal="true"/>
        <p151v.VImage
            android:id="@+id/speed_up_card_hey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:src="0x7f081333"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </p151v.VRelative>
</androidx.constraintlayout.widget.ConstraintLayout>
