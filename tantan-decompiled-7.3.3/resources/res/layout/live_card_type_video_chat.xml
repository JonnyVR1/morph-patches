<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.vchat.card.videoChat.LiveVideoChatCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="422dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="@dimen/live_square_item_base_margin"
    android:layout_marginEnd="@dimen/live_square_item_base_margin">
    <p151v.VDraweeView
        android:id="@+id/cover_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:id="@+id/mask_static_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/mask_dynamic_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="fitXY"/>
    <p151v.VLinear
        android:id="@+id/container_label_a"
        android:background="@drawable/live_bg_fe7e1d_r6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/a_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="2dp"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/a_title"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:singleLine="true"
            android:maxLength="12"
            android:layout_marginHorizontal="6dp"/>
    </p151v.VLinear>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/live_shape_bg_video_chat_half_cover"
        android:layout_width="match_parent"
        android:layout_height="150dp"/>
    <com.p051p1.mobile.putong.live.external.internal.vchat.card.videoChat.LiveVideoChatStatusView
        android:layout_gravity="top|right"
        android:id="@+id/status_view"
        android:background="@drawable/live_bg_white_r6_a20"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="74dp"
        android:layout_weight="1">
        <p151v.VLinear
            android:id="@+id/tag_layout"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp"/>
        <p151v.VText
            android:textSize="24dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:maxLines="1"
            android:singleLine="true"
            app:typeface="medium"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:maxLines="1"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/go_btn"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="5dp"
            android:src="0x7f08273b"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffcba5"
            android:layout_gravity="center_vertical"
            android:id="@+id/discount_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.external.internal.vchat.card.videoChat.LiveVideoChatCardView>
