<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemPendingPayment xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemPendingPayment">
    <RelativeLayout
        android:id="@+id/content_layout"
        android:background="?attr/message_bubble_bg_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:id="@+id/top_bg_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f080fac"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/title_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="13dp"
            android:src="0x7f080fab"/>
        <p151v.VText
            android:textSize="16sp"
            android:id="@+id/subtitle_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:layout_below="@+id/title_iv"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/content_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/UNKNOWN_MESSAGE_CONTENT"
            android:maxLines="3"
            android:layout_below="@+id/top_bg_iv"
            android:lineSpacingExtra="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <RelativeLayout
            android:id="@+id/pay_method"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/content_tv"
            flatten="true">
            <p151v.VImage
                android:id="@+id/pay_method_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="13dp"
                android:src="0x7f081972"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#80000000"
                android:gravity="center"
                android:id="@+id/pay_method_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="支付宝"
                android:drawablePadding="6dp"
                android:layout_toRightOf="@+id/pay_method_icon"
                android:layout_centerVertical="true"
                app:typeface="medium"/>
            <ImageView
                android:id="@+id/pay_method_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:src="0x7f080fb3"
                android:scaleType="center"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/button"
            android:background="@drawable/core_message_action_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:text="查看会员权益"
            android:layout_below="@+id/pay_method"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </RelativeLayout>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/pay_protocol_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        flatten="true">
        <p151v.VCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/check"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="8dp"
            android:checked="false"
            style="@style/core_svip_year_checkbox"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#33000000"
            android:id="@+id/agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemPendingPayment>
