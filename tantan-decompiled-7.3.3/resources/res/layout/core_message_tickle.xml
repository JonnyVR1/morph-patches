<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemTickle xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tickle_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tickle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:typeface="medium"
            style="@style/core_im_msg_cell_text_tips"/>
        <p151v.VText
            android:textColor="@color/common_grey_09"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tickle_setting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/core_im_msg_cell_text_tips"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemTickle>
