<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkSuggestItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="recreation"
    holder="pk.view.PkSuggestItemView">
    <p151v.VDraweeView
        android:id="@+id/iv_head"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/tv_pk_invite"
        android:layout_toRightOf="@+id/iv_head">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/live_black"
                android:ellipsize="end"
                android:id="@+id/tv_anchor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxEms="6"
                android:singleLine="true"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_anchor_age"
                android:background="@drawable/live_bg_85b9f2_r2"
                android:paddingLeft="2dp"
                android:paddingRight="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:drawableLeft="0x7f08246f"
                android:drawablePadding="1dp"
                android:lineSpacingExtra="1sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/tv_anchor_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pk_invite"
        android:background="@drawable/live_shape_ff3a00_gradient_r6"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.PkSuggestItemView>
