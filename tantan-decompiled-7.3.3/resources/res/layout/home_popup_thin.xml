<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="popup.ProfileThinPopup">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/profile_image_frame"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="50dp"
            android:layout_weight="7">
            <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/profile_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/core_fresco_base"/>
            </com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="@dimen/margin_xlarge"
            android:layout_weight="4">
            <p151v.VText
                android:gravity="center"
                android:layout_gravity="top|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginRight="72dp"
                android:text="@string/UPDATE_PROFILE_TITLE"
                style="@style/core_popup_title"/>
            <p151v.VText
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="54dp"
                android:text="@string/UPDATE_PROFILE_INFORMATION"
                style="@style/core_popup_content"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_standard"
            android:layout_weight="7">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VButton_FakeShadow
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/update_profile_button"
                    android:background="@drawable/rect_rounded_tantan_orange"
                    android:visibility="invisible"
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:text="@string/UPDATE_PROFILE_BUTTON"
                    style="@style/core_main_button"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_tv_keep_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:layout_marginBottom="40dp"
                    android:text="@string/MATCH_BUTTON_KEEP_PLAYING"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_MovableImage
        android:id="@+id/ic_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0829b1"/>
    <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_MovableImage
        android:id="@+id/ic_capper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0829b2"
        android:animateLayoutChanges="true"/>
    <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_MovableImage
        android:id="@+id/ic_vintage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0829b5"/>
    <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_MovableImage
        android:id="@+id/ic_coffe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0829b0"
        android:animateLayoutChanges="true"/>
    <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_MovableImage
        android:id="@+id/ic_sushi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0829b4"/>
    <com.p051p1.mobile.putong.core.p058ui.popup.ProfileThinPopup_MovableImage
        android:id="@+id/ic_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0829b3"/>
</FrameLayout>
