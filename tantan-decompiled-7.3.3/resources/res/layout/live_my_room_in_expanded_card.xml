<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.profile.myroom.view.MyRoomInExpandedCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_marginTop="16dp"
    flatten="true"
    folder="page.profile.myroom.view"
    holder="MyRoomInExpandedCard">
    <p151v.VFrame
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/layout_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/common_000000_20"
            app:placeholderImage="@color/common_000000_20"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/anim_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"/>
        <View
            android:id="@+id/start_blur"
            android:background="@drawable/live_shape_my_room_in_newui_live_my_room_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/avatar_layout"
                android:background="@drawable/live_shape_my_room_in_newui_avatar_default_bg"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:actualImageScaleType="centerCrop"
                    app:roundedCornerRadius="10dp"/>
            </FrameLayout>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/live_top_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_ffffff"
                    android:ellipsize="end"
                    android:id="@+id/live_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"/>
            </p151v.VLinear>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/live_tag"
                android:background="@drawable/live_shape_living_back"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="2dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableRight="0x7f0826a1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </p151v.VLinear>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.external.page.profile.myroom.view.MyRoomInExpandedCard>
