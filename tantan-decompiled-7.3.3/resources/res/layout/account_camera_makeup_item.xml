<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.account.p055ui.camera.view.AccountMakeupItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/camera_makeup_item_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="camera.view.AccountMakeupItemView">
    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/camera_makeup_image_local"
            android:background="@drawable/account_camera_effect_bg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:actualImageResource="@drawable/account_camera_effect_bg"
            app:roundedCornerRadius="12dp"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/camera_makeup_image_remote"
            android:background="@drawable/account_camera_effect_bg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="center"
            app:actualImageResource="@drawable/account_camera_effect_bg"
            app:roundedCornerRadius="12dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/camera_makeup_select"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/account_camera_filter_item_selected"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/camera_makeup_name"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="filter name"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/camera_makeup_value"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="30"/>
</com.p051p1.mobile.putong.account.p055ui.camera.view.AccountMakeupItemView>
