<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:padding="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.model.MessageMomentExpandViewModel">
    <FrameLayout
        android:id="@+id/media_pager_root"
        android:background="0x7f080f75"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        flatten="true">
        <p151v.VPager
            android:id="@+id/media_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
            android:id="@+id/image_indicator"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="16dp"
            app:indicatorColor="#19000000"
            app:indicatorMargin="3dp"
            app:indicatorSelectedColor="@color/white"/>
        <p151v.VRelative
            android:id="@+id/moment_info_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/bottom_shadow_bg"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                app:actualImageScaleType="fitXY"
                app:roundedCornerRadius="20dp"/>
            <p151v.VImage
                android:id="@+id/likedBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="62dp"
                android:src="0x7f080f76"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
            <p151v.VImage
                android:id="@+id/commentBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="20dp"
                android:src="0x7f080f70"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/info_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="70dp"
                android:layout_marginBottom="20dp"
                android:layout_alignParentBottom="true"
                flatten="true">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#99ffffff"
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/moment_info_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"/>
            </p151v.VLinear>
        </p151v.VRelative>
    </FrameLayout>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/close"
        android:layout_width="83dp"
        android:layout_height="64dp"
        android:layout_marginTop="-12dp"
        android:src="0x7f080f6f"/>
</p151v.VLinear>
