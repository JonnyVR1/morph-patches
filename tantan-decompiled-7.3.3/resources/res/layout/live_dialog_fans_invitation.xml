<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/live_bg_white_r20"
    android:layout_width="311dp"
    android:layout_height="472dp"
    flatten="true"
    folder="common.fansclub.submodule.recall"
    holder="FansInvitationTipsDialog">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#323232"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:singleLine="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#999999"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/LIVE_FANSCLUB_FANS_PREVIEW"/>
    <p151v.VImage
        android:background="0x7f082344"
        android:layout_width="match_parent"
        android:layout_height="109dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VImage
        android:background="0x7f082345"
        android:layout_width="match_parent"
        android:layout_height="133dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/select_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/select_btn"
            android:background="@drawable/live_selector_select_btn"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#cccccc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_FANSCLUB_FANS_NO_HINT"
            android:layout_marginStart="4dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/invitation_btn"
        android:background="@drawable/live_selector_button_recall"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/LIVE_FANSCLUB_FANS_INVITATION"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
</p151v.VLinear>
