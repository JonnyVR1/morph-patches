<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.call.view.VoiceVirtualNineDeputyItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="83dp"
    android:layout_height="112dp"
    flatten="true"
    holder="virtual.call.view.VoiceVirtualNineDeputyItemView">
    <FrameLayout
        android:id="@+id/fl_head"
        android:layout_width="wrap_content"
        android:layout_height="55dp"
        android:layout_centerHorizontal="true"
        flatten="true">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/live_bg_white_oval_a10"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_add"
            android:padding="7dp"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="0x7f082772"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/svga"
            android:layout_width="76dp"
            android:layout_height="76dp"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/background"
            android:layout_width="57dp"
            android:layout_height="57dp"/>
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:layout_gravity="center"
            android:id="@+id/vd_head"
            android:layout_width="73dp"
            android:layout_height="73dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mask"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/live_bg_black_oval_a60"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_40_opacity"
            android:layout_gravity="center"
            android:id="@+id/tv_away"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="离开"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/fl_head"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:background="@drawable/live_bg_white_r3_a20"
            android:padding="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp">
            <p151v.VDraweeView
                android:id="@+id/state"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="0x7f08284a"/>
            <TextView
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_index"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="12dp"
                android:text="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"/>
        </p151v.VLinear> &gt; 
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户昵称…"
            android:maxEms="4"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_heart"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_name"
        android:layout_centerHorizontal="true"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/heart_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="0x7f08284b"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/live_white_40_opacity"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_heart"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:text="0"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_cp"
        android:layout_width="70dp"
        android:layout_height="36dp"
        android:layout_marginTop="-10dp"
        android:scaleType="fitXY"
        android:translationY="-3dp"
        android:layout_marginStart="-35dp"
        android:layout_alignParentStart="true"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.call.view.VoiceVirtualNineDeputyItemView>
