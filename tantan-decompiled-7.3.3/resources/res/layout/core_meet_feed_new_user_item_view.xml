<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="newmeet.feed.user.newui.NewMeetFeedUserItemView">
    <p151v.VPager
        android:id="@+id/images_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
        android:id="@+id/image_indicator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:indicatorColor="#33ffffff"
        app:indicatorMargin="4dp"
        app:indicatorSelectedColor="@color/white"/>
    <TextView
        android:id="@+id/left_top_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="19dp"
        android:text=""
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <View
        android:id="@+id/strut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_centerInParent="true"
        flatten="true"/>
    <View
        android:id="@+id/action_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/strut"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/action_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/strut"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/banner"
        android:background="#73000000"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12sp"
            android:textColor="#ccffffff"
            android:id="@+id/guide_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:drawablePadding="5dp"
            android:layout_weight="1"
            android:lineSpacingExtra="4sp"/>
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="0x7f080e74"/>
    </LinearLayout>
</RelativeLayout>
