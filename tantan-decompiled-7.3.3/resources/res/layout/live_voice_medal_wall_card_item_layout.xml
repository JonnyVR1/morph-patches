<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.giftwalllocal.medallabel.MedalLabelItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="264dp"
    flatten="true"
    folder="virtual.giftwalllocal.medallabel"
    holder="MedalLabelItemView">
    <p151v.VDraweeView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="242dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/title_img"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="70dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/title_svga_view"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:id="@+id/reward_text"
        android:paddingTop="38dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="领取"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/sub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="73dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/gift_item_one"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/gift_item_one"
        android:layout_width="0dp"
        android:layout_height="127dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gift_item_two"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_one_icon"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:layout_marginTop="14dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_one_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="小飞棍"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_one_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="X1"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/gift_item_two"
        android:layout_width="0dp"
        android:layout_height="127dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_item_one"
        app:layout_constraintEnd_toStartOf="@+id/gift_item_three"
        app:layout_constraintStart_toEndOf="@+id/gift_item_one"
        app:layout_constraintTop_toTopOf="@+id/gift_item_one"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_two_icon"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:layout_marginTop="14dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_two_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="小飞棍"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_two_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="X1"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/gift_item_three"
        android:layout_width="0dp"
        android:layout_height="127dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_item_one"
        app:layout_constraintEnd_toStartOf="@+id/gift_item_four"
        app:layout_constraintStart_toEndOf="@+id/gift_item_two"
        app:layout_constraintTop_toTopOf="@+id/gift_item_one"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_three_icon"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:layout_marginTop="14dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_three_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="小飞棍"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_three_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="X1"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/gift_item_four"
        android:layout_width="0dp"
        android:layout_height="127dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_item_one"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gift_item_three"
        app:layout_constraintTop_toTopOf="@+id/gift_item_one"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_four_icon"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:layout_marginTop="14dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_four_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="小飞棍"/>
        <p151v.VText
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_four_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="X1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.virtual.giftwalllocal.medallabel.MedalLabelItemView>
