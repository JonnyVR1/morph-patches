<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.IntlCoinPurchaseSheetItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.IntlCoinPurchaseSheetItemView">
    <p151v.VRelative
        android:id="@+id/content"
        android:background="@drawable/core_intl_vip_bg_purchase_coin_item_select"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="5dp">
        <p151v.VRelative
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/common_black_02"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/coin_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:autoSizeStepGranularity="1sp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/coin_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:layout_below="@+id/coin_count"
                android:layout_centerHorizontal="true"/>
        </p151v.VRelative>
    </p151v.VRelative>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/hot_tag"
        android:layout_width="60dp"
        android:layout_height="33dp"
        android:src="0x7f080a7a"
        android:scaleType="fitXY"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.IntlCoinPurchaseSheetItemView>
