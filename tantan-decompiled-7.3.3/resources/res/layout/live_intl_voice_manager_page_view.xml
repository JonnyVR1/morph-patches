<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="intl.manager.invite.IntlVoiceLiveManagerInvitePageView">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyView"
            android:visibility="visible"
            android:layout_width="100dp"
            android:layout_height="75dp"
            android:src="0x7f082397"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white_30_opacity"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/LIVE_VOICE_INVITE_MANAGER_EMPTY_TIP"
            android:lineSpacingExtra="0sp"/>
    </LinearLayout>
    <p151v.smart_refresh.SmartRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.smart_refresh.SmartRefreshLayout>
</merge>
