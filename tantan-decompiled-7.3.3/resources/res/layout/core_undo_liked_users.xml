<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="ui.likedusers.tablayout.undolike"
    holder="UnDoLikedUsersViewModel">
    <p151v.VFrame
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0809e0"
                android:scaleType="centerInside"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="还没有无感的人，快去滑卡寻找新朋友吧！"/>
        </LinearLayout>
        <p151v.VProgressBar
            android:id="@+id/progress"
            style="@style/core_loading_block"/>
    </p151v.VFrame>
    <p151v.VPullUpRecyclerView
        android:id="@+id/list"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="80dp"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/get_privilege_btn"
        android:background="@drawable/core_undo_liked_user_buy_btn_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="32dp"
        android:text="解锁反悔特权"
        android:layout_centerHorizontal="true"/>
</p151v.VFrame>
