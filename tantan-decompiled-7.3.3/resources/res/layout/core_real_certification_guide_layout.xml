<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationRealEcrGuideLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/core_bg_10_fff2e8"
    android:padding="12dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="12dp"
    flatten="true"
    folder="newui"
    holder="messages.ConversationRealEcrGuideLayout">
    <p151v.VFrame
        android:layout_gravity="center_vertical"
        android:id="@+id/head_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:layout_weight="0"
        flatten="true">
        <p151v.VFrame
            android:background="@drawable/core_bg_15_7_percent_fe7e1d"
            android:layout_width="30dp"
            android:layout_height="30dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/img_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:roundAsCircle="true"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:background="@drawable/core_bg_15_7_percent_fe7e1d"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="22dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/img_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:roundAsCircle="true"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:background="@drawable/core_bg_15_7_percent_fe7e1d"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="18dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/img_3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:roundAsCircle="true"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:background="@drawable/core_bg_15_7_percent_fe7e1d"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="18dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/img_4"
                android:background="@drawable/core_cert_image_guide_bg"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:roundAsCircle="true"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="15sp"
            android:textColor="#000000"
            android:ellipsize="end"
            android:id="@+id/ver_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#4d000000"
            android:ellipsize="end"
            android:id="@+id/ver_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="14sp"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:background="@drawable/core_chat_partner_status_container_bg"
        android:layout_width="63dp"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:text="查看"
        android:layout_weight="0"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationRealEcrGuideLayout>
