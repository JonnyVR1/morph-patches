<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="530dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetMyHouseDialog">
    <p151v.VImage
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:src="0x7f08281d"
        android:scaleType="fitXY"/>
    <View
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/bg_img"/>
    <include
        android:id="@+id/house_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="28dp"
        layout="@layout/live_voice_sweet_house_layout"/>
    <include
        android:id="@+id/limit_house_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="28dp"
        layout="@layout/live_voice_sweet_limited_time_house_layout"/>
    <p151v.VImage
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="0x7f0827de"
        android:layout_centerHorizontal="true"/>
    <include
        android:id="@+id/tabView"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_centerHorizontal="true"
        layout="@layout/live_voice_sweet_tab_layout"/>
    <p151v.VImage
        android:id="@+id/back_iv"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="32dp"
        android:src="0x7f082824"/>
</p151v.VRelative>
