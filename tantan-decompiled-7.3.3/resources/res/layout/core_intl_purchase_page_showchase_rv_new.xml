<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vpPrices"
        android:paddingLeft="20dp"
        android:paddingRight="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
    <com.p051p1.mobile.putong.core.p058ui.view.circleindicator.CircleIndicator2
        android:layout_gravity="center_horizontal"
        android:id="@+id/vp_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:ci_animator="@anim/null_anim"
        app:ci_height="8dp"
        app:ci_margin="4dp"
        app:ci_width="8dp"/>
    <p151v.VText
        android:textSize="11sp"
        android:id="@+id/upgrade_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"/>
</p151v.VLinear>
