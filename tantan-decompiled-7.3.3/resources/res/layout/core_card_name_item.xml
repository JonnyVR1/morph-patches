<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_bg_20_ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.NameHomeCardExpandedHolder">
    <p151v.VLinear
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="23dp"
        android:paddingRight="24dp"
        android:paddingBottom="23dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="23dp">
        <include
            android:id="@+id/card_bottom_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/core_card_bottom_expanded_basic_info"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#00d251"
                android:ellipsize="end"
                android:gravity="start|bottom"
                android:id="@+id/new_here_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_TTC_CLONE_SWIPE_TAG_NEW_HERE"
                android:singleLine="true"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_000000_40"
                android:layout_gravity="center"
                android:id="@+id/new_here_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                app:typeface="regular"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_000000_40"
                android:ellipsize="end"
                android:gravity="start|bottom"
                android:id="@+id/location_and_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:typeface="regular"/>
            <com.p051p1.mobile.android.p053ui.RoundedView
                android:layout_gravity="center"
                android:id="@+id/gp_hide_active_time_guide_dot"
                android:background="#ff702d"
                android:visibility="gone"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ff702d"
                android:ellipsize="end"
                android:gravity="start|bottom"
                android:id="@+id/gp_hide_active_time_guide_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hide Active"
                android:singleLine="true"
                app:typeface="medium"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VDraweeView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/wealth_icon_new"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"/>
</p151v.VFrame>
