<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.myvisitors.MyVisitorRecoverHideFootPrintView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="visitor.myvisitors.MyVisitorRecoverHideFootPrintView">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            android:layout_marginBottom="39dp"
            android:src="0x7f0819da"
            android:layout_centerHorizontal="true"
            android:layout_marginVertical="39dp"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:maxLines="2"
            android:layout_marginHorizontal="32dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:lineSpacingExtra="4dp"
            android:layout_marginHorizontal="32dp"/>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/confirm"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/confirm_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="9dp"
                android:fontFamily="sans-serif"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/confirm_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:fontFamily="sans-serif"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/v_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <p151v.VCheckBox
                android:id="@+id/check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:checked="true"
                android:button="@null"
                style="@style/common_checkbox"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_04"
                android:layout_gravity="center_vertical"
                android:id="@+id/reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="0x7f080335"
        android:layout_marginEnd="16dp"/>
</com.p051p1.mobile.putong.core.p058ui.visitor.myvisitors.MyVisitorRecoverHideFootPrintView>
