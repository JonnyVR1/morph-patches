<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="citytop.CityTopLikersViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VFrame
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VFrame
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/empty"
                android:paddingBottom="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VImage
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f0809e0"
                    android:scaleType="centerInside"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="暂无新请求"/>
            </p151v.VLinear>
            <p151v.VProgressBar
                android:id="@+id/progress"
                style="@style/core_loading_block"/>
        </p151v.VFrame>
        <p151v.VPullUpRecyclerView
            android:id="@+id/list"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="80dp"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</p151v.VLinear>
