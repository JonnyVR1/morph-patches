<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.addressbook.loveradar.RadarSwitchView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.loveradar.RadarSwitchView">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/switch_card_layout"
        android:layout_width="match_parent"
        android:layout_height="111dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/switch_card_layout_icon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginLeft="16dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="18dp"
                android:textColor="@color/core_color_80percent_000000"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/core_color_40percent_000000"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.newui.view.LoveRadarSwitchView
            android:id="@+id/switch_view"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.messages.addressbook.loveradar.RadarSwitchView>
