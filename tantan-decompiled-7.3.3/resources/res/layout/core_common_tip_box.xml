<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemCommonTipBox xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemCommonTipBox">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_new_messages_prompt"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="32dp">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/left_icon"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:scaleType="center"
                app:roundedCornerRadius="12dp"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_color_cc000000"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC-Medium"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/core_color_66000000"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC-Regular"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="14sp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/button"
            android:background="@drawable/core_messages_warming_up_bubble_btn_bg"
            android:paddingLeft="12dp"
            android:paddingTop="9dp"
            android:paddingRight="12dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:fontFamily="PingFangSC-Medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemCommonTipBox>
