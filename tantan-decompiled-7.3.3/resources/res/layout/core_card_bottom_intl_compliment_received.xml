<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomIntlComplimentReceivedLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomIntlComplimentReceivedLayout">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/compliment_tag_root"
            android:background="@drawable/core_bg_intl_compliment_received_tag"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/overlap_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VImage
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/compliment_icon"
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:src="0x7f080a7e"/>
                    <p151v.AutoVDraweeView
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/photo_thumbnail"
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:rotation="8"
                        android:layout_marginStart="23dp"
                        android:elevation="1dp"
                        app:roundedCornerRadius="7dp"
                        app:roundingBorderColor="#362f27"
                        app:roundingBorderWidth="2dp"/>
                </FrameLayout>
                <p151v.VText_NoTopPadding
                    android:textSize="16sp"
                    android:textColor="#f9ce67"
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_HOME_CARD_COMPLIMENT_TITLE"
                    android:layout_marginStart="8dp"
                    app:fontWeight="500"/>
            </p151v.VLinear>
            <p151v.VText_NoTopPadding
                android:textSize="15sp"
                android:textColor="#362f27"
                android:gravity="center"
                android:id="@+id/click_view_btn"
                android:background="@drawable/core_bg_intl_compliment_btn"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/INTL_HOME_CARD_COMPLIMENT_BTN"
                app:fontWeight="500"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomIntlComplimentReceivedLayout>
