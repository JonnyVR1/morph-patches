<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_like_root"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="profile.expandprofilelike.ExpandProfileLikeActViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/profile_like_content_root"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear_FillerMeasure
            android:id="@+id/profile_like_name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            app:fillerIndex="0"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="24dp"
                android:textColor="@color/common_black_80"
                android:ellipsize="end"
                android:id="@+id/profile_like_name"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:singleLine="true"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="24dp"
                android:textColor="@color/common_black_80"
                android:gravity="center"
                android:id="@+id/profile_like_age"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginLeft="6dp"/>
        </p151v.VLinear_FillerMeasure>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/profile_like_name_container_v2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="24dp"
                android:textColor="@color/common_black_80"
                android:ellipsize="end"
                android:id="@+id/profile_like_name_v2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="15dp"
                android:textColor="@color/core_color_30percent_000000"
                android:id="@+id/profile_like_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/profile_like_content_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="249dp"
            android:layout_marginTop="12dp"
            android:translationZ="0.1dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/moving_par"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/common_black_02"
                android:textColorHint="#33000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/profile_like_content"
                android:background="@drawable/core_kankan_action_send_bg"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="40dp"
                android:paddingHorizontal="20dp"/>
            <com.p051p1.mobile.putong.core.newui.profile.expandprofilelike.view.ProfileLikeRemainingSwitcherView
                android:textSize="16sp"
                android:id="@+id/profile_like_send"
                android:background="@drawable/core_pofile_like_send_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="40dp"
                android:textAlignment="center"
                app:contentTextSize="16sp"
                app:repeatCount="1"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16sp"
                android:textColor="@color/core_color_30percent_000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/profile_like_cancel"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="取消"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VFrame
        android:id="@+id/close_input_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/like_bottom_input_layout"
        android:background="@drawable/core_expand_profile_like_input_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        flatten="true">
        <p151v.VEditText
            android:textSize="16sp"
            android:textColor="@color/common_black_02"
            android:textColorHint="#33000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_like"
            android:background="@null"
            android:paddingLeft="20dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="50"
            android:layout_weight="1"
            android:inputType="textAutoCorrect"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="@color/core_greet_input_btn_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/send"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="15dp"
            android:text="发送"
            app:typeface="medium"/>
    </p151v.VLinear>
</p151v.VFrame>
