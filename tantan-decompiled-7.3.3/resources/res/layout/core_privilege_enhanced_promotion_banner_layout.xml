<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEnhancedPromotionBannerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="banner.view.PrivilegeEnhancedPromotionBannerView">
    <RelativeLayout
        android:id="@+id/banner_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/banner_header_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="10dp"/>
        <ImageView
            android:id="@+id/texture"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:src="0x7f081978"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/privilege_type_ic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f081975"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/privilege_type_name_ic"
            android:layout_width="59dp"
            android:layout_height="21dp"
            android:src="0x7f081976"
            android:layout_toRightOf="@+id/privilege_type_ic"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/go"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="8dp"
            android:src="0x7f081977"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/banner_content"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_below="@+id/banner_header"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/banner_content_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="false"
            app:roundTopRight="false"
            app:roundedCornerRadius="10dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/buy_btn"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <p151v.VText
                android:textSize="21sp"
                android:textColor="#c37a4d"
                android:ellipsize="end"
                android:id="@+id/promotion_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="季卡立减234元"
                android:lines="1"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99c37a4d"
                android:ellipsize="end"
                android:id="@+id/promotion_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="现价199元，原价234元"
                android:lines="1"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#98572f"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/buy_btn"
            android:background="@drawable/core_vip_mytab_banner_enhanced_promotion_buy_btn_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="16dp"
            android:text="立即购买"
            android:lines="1"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:typeface="medium"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/banner_bottom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/banner_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/banner_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="10dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#99c37a4d"
            android:ellipsize="end"
            android:id="@+id/promotion_end_time_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="优惠23:39后过期，马上购买，配对概率翻倍"
            android:lines="1"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider_line"
        android:background="#0dc37a4d"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="125dp"
        android:layout_marginRight="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_protocol"
        android:background="@drawable/core_privilege_enty_banner_protocol"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/banner_bottom"
        flatten="true">
        <RelativeLayout
            android:id="@+id/rl_pay"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <TextView
                android:textSize="12dp"
                android:textColor="#80000000"
                android:gravity="center"
                android:id="@+id/tv_pay_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-3dp"
                android:text="支付宝"
                android:drawableLeft="0x7f080d95"
                android:drawablePadding="7dp"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="4dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="#ff5435"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_prom"
                android:background="@drawable/core_alipay_sell_rect"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:maxLines="1"
                android:layout_toRightOf="@+id/tv_pay_method"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="#ff5435"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_prom_right"
                android:background="@drawable/core_alipay_sell_rect"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/pay_arrow"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/pay_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08180a"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/protocal_containner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="7dp"
            flatten="true">
            <p151v.VCheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/check_y"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="8dp"
                android:checked="false"
                style="@style/core_svip_year_checkbox"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#33000000"
                android:layout_gravity="center"
                android:id="@+id/tv_protocol"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="同意《会员自动续费协议》，到期后以X元/月续订，可随时取消"/>
        </p151v.VLinear>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_origin_proto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/banner_bottom"
        flatten="true">
        <RelativeLayout
            android:id="@+id/pay_way"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/banner_bottom"
            flatten="true">
            <TextView
                android:textSize="12dp"
                android:textColor="#80000000"
                android:gravity="center"
                android:id="@+id/pay_way_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支付宝"
                android:drawableLeft="0x7f080d95"
                android:drawablePadding="7dp"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="4dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="#ff5435"
                android:layout_gravity="center_vertical"
                android:id="@+id/prom_text"
                android:background="@drawable/core_alipay_sell_rect"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:maxLines="1"
                android:layout_toRightOf="@+id/pay_way_txt"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08180a"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/origin_proto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            flatten="true">
            <p151v.VCheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/check"
                android:background="@drawable/core_purchase_default_checkbox_bg"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:checked="false"
                android:button="@null"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="8dp"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/member_protocol"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="同意《会员自动续费协议》，到期后以X元/月续订，可随时取消"
                android:maxLines="2"
                android:alpha="0.2"/>
        </LinearLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEnhancedPromotionBannerView>
