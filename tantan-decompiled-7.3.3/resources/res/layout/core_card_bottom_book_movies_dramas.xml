<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.RecentBookMoviesDramas xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.RecentBookMoviesDramas">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="94dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <include
            android:id="@+id/card_user_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="94dp"
            layout="@layout/core_card_user_content_view"/>
        <FrameLayout
            android:id="@+id/recent_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            flatten="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container"
                android:background="@drawable/core_bg_book_movies_dramas_item"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="12dp"
                flatten="true">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginLeft="10dp">
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_icon_bg_1"
                        android:visibility="gone"
                        android:layout_width="41dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="6dp"
                        app:actualImageScaleType="centerCrop"
                        app:backgroundImage="@color/core_color_33ffffff"
                        app:roundedCornerRadius="8dp"
                        style="@style/core_fresco_base"/>
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_icon_bg_2"
                        android:visibility="gone"
                        android:layout_width="41dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="3dp"
                        app:actualImageScaleType="centerCrop"
                        app:backgroundImage="@color/core_color_80ffffff"
                        app:roundedCornerRadius="8dp"
                        style="@style/core_fresco_base"/>
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_icon"
                        android:layout_width="41dp"
                        android:layout_height="54dp"
                        app:actualImageScaleType="centerCrop"
                        app:failureImage="@color/white"
                        app:failureImageScaleType="centerInside"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:placeholderImage="@color/core_kankan_card_placeholder"
                        app:placeholderImageScaleType="centerInside"
                        app:roundedCornerRadius="6dp"
                        style="@style/core_fresco_base"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="14dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/core_text_e6ffffff"
                        android:ellipsize="end"
                        android:id="@+id/desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_desc_click"
                    android:background="@drawable/core_bg_book_movies_dramas_item_click"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="31dp"
                    android:layout_marginRight="12dp"
                    android:maxLength="3"
                    app:layout_constraintBottom_toBottomOf="@+id/desc_women"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/name_women"/>
            </LinearLayout>
        </FrameLayout>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.RecentBookMoviesDramas>
