<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/test1_instant_match_card"
    android:background="@drawable/core_me_tab_revamp_iap_card_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="0dp"
    android:layout_height="80dp"
    android:layout_weight="1">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/test1_instant_match_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="0x7f080e08"
            android:scaleType="fitCenter"/>
        <p151v.VText_NoTopPadding
            android:textSize="10sp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/test1_instant_match_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:layout_marginBottom="8dp"
            android:text="@string/INTL_TTC_ULTRA_INSTANTMATCH_TITLE"
            android:maxLines="1"
            app:fontWeight="500"/>
    </p151v.VLinear>
    <p151v.VText_NoTopPadding
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/test1_instant_match_badge"
        android:background="@drawable/core_me_tab_revamp_iap_badge_count_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="-2dp"
        android:minWidth="16dp"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginEnd="-2dp"
        app:fontWeight="700"/>
    <p151v.VImage
        android:layout_gravity="end|top"
        android:id="@+id/test1_instant_match_lock_badge"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="-6dp"
        android:src="@drawable/core_me_tab_revamp_iap_lock_badge"
        android:scaleType="fitCenter"
        android:layout_marginEnd="-6dp"/>
</p151v.VFrame>
