<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.wengweng.WengwengPullHeadAnim">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svg"
        android:visibility="gone"
        android:layout_width="210dp"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/user_model"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="2dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_me"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/white"
            app:roundingBorderWidth="2dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="11dp"
        android:textColor="#bd9150"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/bottom_pull_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_BUZZ_MESSAGES_TAB_TITLE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</merge>
