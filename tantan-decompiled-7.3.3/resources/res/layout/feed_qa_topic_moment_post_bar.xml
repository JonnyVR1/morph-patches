<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.QAMomentPostBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.QAMomentPostBar">
    <FrameLayout
        android:id="@+id/state_fl"
        android:background="#ff5c31"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        flatten="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/moment_upload_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="96dp"
            android:text="@string/FEED_POST_FAILED_RETRY"
            android:maxLines="2"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/moment_upload_retry"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="53dp"
            android:src="0x7f081e8d"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/moment_upload_delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:src="0x7f081e8b"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/moment_upload_shadow"
        android:background="@drawable/feed_qa_topic_rect_rounded_progress_gradient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        flatten="true">
        <ProgressBar
            android:layout_gravity="bottom"
            android:id="@+id/moment_upload_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            android:max="500"
            android:progress="0"
            android:progressDrawable="@drawable/feed_qa_topic_moment_upload_progress"
            style="?android:attr/progressBarStyleHorizontal"/>
    </FrameLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.QAMomentPostBar>
