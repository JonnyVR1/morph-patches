<?xml version="1.0" encoding="utf-8"?>
<p151v.VScroll xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/common_black_01"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/PRIVACY_POLICY_DLG_FIRST_TITLE"/>
        <p151v.VScroll
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/scroll_privacy_policy"
            android:orientation="vertical"
            android:paddingLeft="26dp"
            android:layout_width="match_parent"
            android:layout_height="316dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="5dp">
            <p151v.VLinear
                android:gravity="left"
                android:orientation="vertical"
                android:paddingRight="18dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_02"
                    android:id="@+id/tv_user_agreement_privacy_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/PRIVACY_POLICY_DLG_FIRST_CONTENT_WITH_LINK"
                    android:lineSpacingExtra="1dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/PRIVACY_POLICY_DLG_FIRST_CONTENT_1"
                    android:lineSpacingExtra="1dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/PRIVACY_POLICY_DLG_FIRST_CONTENT_2"
                    android:lineSpacingExtra="1dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/PRIVACY_POLICY_DLG_FIRST_CONTENT_3"
                    android:lineSpacingExtra="1dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/PRIVACY_POLICY_DLG_FIRST_CONTENT_4"
                    android:lineSpacingExtra="1dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/PRIVACY_POLICY_DLG_FIRST_CONTENT_5"
                    android:lineSpacingExtra="1dp"/>
            </p151v.VLinear>
        </p151v.VScroll>
    </LinearLayout>
</p151v.VScroll>
