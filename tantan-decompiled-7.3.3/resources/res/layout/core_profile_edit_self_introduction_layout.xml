<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/self_introduction"
    android:background="@color/white"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.itemholders.EditProfileIntroductionItemHolder">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:gravity="center_vertical"
            android:id="@+id/edit_title"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_height="24dp"
            android:text="@string/PROFILE_SELF_INTRODUCTION"
            android:layout_weight="1"
            style="@style/profile_item_title_black_edit"/>
        <ImageView
            android:id="@+id/update"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081495"
            android:layout_marginEnd="20dp"/>
    </p151v.VLinear>
    <include layout="@layout/core_profile_integrity_opt"/>
    <p151v.VText
        android:layout_gravity="center_vertical"
        android:id="@+id/content"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ADD_SELF_INTRODUCTION"
        android:drawableEnd="@drawable/core_profile_edit_data_right_add"
        app:typeface="regular"
        style="@style/profile_item_item_new"/>
</p151v.VLinear_Dividers>
