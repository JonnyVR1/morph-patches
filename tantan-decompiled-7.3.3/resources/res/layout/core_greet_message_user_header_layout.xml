<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_new"
    android:background="@drawable/core_new_message_head_bg"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="25dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="25dp"
    android:layout_marginRight="25dp"
    holder="greet.GreetMessageUserHeaderLayout">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/head_layout"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="10dp"
        flatten="false">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/head_img_1"
            android:visibility="gone"
            android:layout_width="86dp"
            android:layout_height="88dp"
            android:layout_marginTop="3dp"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <View
            android:id="@+id/head_space_1"
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/head_img_2"
            android:layout_width="86dp"
            android:layout_height="88dp"
            android:layout_marginTop="3dp"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <View
            android:id="@+id/head_space_2"
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/head_img_3"
            android:layout_width="86dp"
            android:layout_height="88dp"
            android:layout_marginTop="3dp"
            android:scaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/location_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/core_message_head_location_icon"
            useId="true"/>
        <p151v.VText
            android:textColor="#99000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/location_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/meet_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/meet_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/core_message_head_meet_icon"
            useId="true"/>
        <p151v.VText
            android:textColor="#99000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/meet_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tag_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/core_message_head_tag_icon"
            useId="true"/>
        <p151v.VText
            android:textColor="#99000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tag_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/topic_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/core_message_head_topic_icon"
            useId="true"/>
        <p151v.VText
            android:textColor="#99000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/topic_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
