<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/primary_button"
        android:background="@drawable/core_intl_button_compliment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="5dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/get_ultra_premium"
        android:background="@drawable/core_intl_button_premium"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        flatten="true">
        <p151v.VImage
            android:gravity="center_horizontal"
            android:id="@+id/get_ultra_premium_iv"
            android:background="0x7f080b81"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#ffe59d"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/get_ultra_premium_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_PREMIUM_COMPLIMENT_GET"
                android:lines="1"/>
            <p151v.VText
                android:textSize="11sp"
                android:textStyle="normal"
                android:textColor="#ffe59d"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/get_ultra_premium_sub_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_PREMIUM_WHISPER_GET"
                android:lines="1"/>
        </LinearLayout>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#33000000"
        android:textColorLink="#fe7e1d"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/agreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:typeface="medium"/>
</LinearLayout>
