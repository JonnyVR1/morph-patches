<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.quickaudio.party.AudioQuickChatPartyJoinInDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_vieww"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="quickaudio.party.AudioQuickChatPartyJoinInDialogView">
    <FrameLayout
        android:background="@drawable/core_bg_audio_quickchat_party_join_dialog_top"
        android:layout_width="match_parent"
        android:layout_height="208dp">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/top_icon"
            android:layout_width="175dp"
            android:layout_height="175dp"
            android:layout_marginTop="20dp"
            app:actualImageScaleType="centerCrop"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/white"
            app:placeholderImageScaleType="centerInside"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_80percent_000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="极速约会报名成功"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="星期三19:00-22:00，来探探一起狂欢"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="离活动开始还有"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <View
            android:id="@+id/reference"
            android:layout_width="1px"
            android:layout_height="1px"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/day_time_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/hour_time_container"
            android:layout_marginEnd="32dp"
            flatten="true">
            <p151v.VText
                android:textSize="21sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:id="@+id/day_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="天"
                android:layout_below="@+id/day_time_txt"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/hour_time_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/reference"
            android:layout_marginEnd="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="21sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:id="@+id/hour_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时"
                android:layout_below="@+id/hour_time_txt"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/minutes_time_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/reference"
            android:layout_marginStart="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="21sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:id="@+id/minutes_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分"
                android:layout_below="@+id/minutes_time_txt"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/second_time_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/minutes_time_container"
            android:layout_marginStart="32dp"
            flatten="true">
            <p151v.VText
                android:textSize="21sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:id="@+id/second_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="秒"
                android:layout_below="@+id/second_time_txt"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.quickaudio.party.AudioQuickChatPartyJoinInDialogView>
