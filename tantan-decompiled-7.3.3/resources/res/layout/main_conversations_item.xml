<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.main.ConversationView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bg"
    android:background="@drawable/tf_rect_dark"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="main.ConversationView">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="8dp">
        <p151v.VDraweeView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/image"
            android:padding="2dp"
            android:clickable="true"
            android:layout_width="46dp"
            android:layout_height="46dp"
            style="@style/core_im_fresco_profile_small"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/image_border"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="46dp"/>
        <p151v.TickerView
            android:id="@+id/ticker"
            android:layout_width="46dp"
            android:layout_height="46dp"/>
        <ImageView
            android:id="@+id/heart_single_1"
            style="@style/heart_single"/>
        <ImageView
            android:id="@+id/heart_single_2"
            style="@style/heart_single"/>
        <ImageView
            android:id="@+id/heart_single_3"
            style="@style/heart_single"/>
        <ImageView
            android:id="@+id/heart_single_4"
            style="@style/heart_single"/>
        <com.p051p1.mobile.putong.core.p058ui.view.GradientBgButton
            android:layout_gravity="bottom|right"
            android:id="@+id/match_from"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="centerInside"
            app:borderColor="@color/white"
            app:borderSize="1.5dp"
            app:iconWidth="12dp"/>
        <p151v.VDraweeView
            android:layout_gravity="bottom|right"
            android:id="@+id/match_from_drawee"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_white_01"
            android:layout_gravity="center"
            android:id="@+id/liked_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:layout_centerVertical="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">
            <p151v.VLinear_FillerMeasure
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_weight="100"
                app:fillerIndex="1">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/common_grey_05"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:enableEmojis="true"
                    app:typeface="regular"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/vip_icon"
                    android:layout_width="25dp"
                    android:layout_height="12dp"
                    android:src="0x7f082aa5"
                    android:scaleType="fitCenter"/>
            </p151v.VLinear_FillerMeasure>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/status"
                android:visibility="visible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/main_conversations_item_unread"
                android:scaleType="centerInside"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_02"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            app:enableEmojis="true"
            app:typeface="regular"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/send_money"
        android:background="0x7f080297"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:text="@string/SEND_LUCKY_MONEY"/>
</com.p051p1.mobile.putong.core.p058ui.main.ConversationView>
