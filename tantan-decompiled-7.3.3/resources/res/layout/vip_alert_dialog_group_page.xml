<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.VipIntroGroupPage xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="vip.VipIntroGroupPage">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <FrameLayout
            android:layout_width="142dp"
            android:layout_height="97dp">
            <ImageView
                android:id="@+id/first_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="0x7f08295a"/>
            <p151v.VImage
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/identify_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="10dp"/>
        </FrameLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#e0a030"
            android:gravity="center"
            android:id="@+id/first_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/center_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:layout_toRightOf="@+id/left"
        android:layout_alignTop="@+id/left"
        android:layout_alignBottom="@+id/left">
        <ImageView
            android:id="@+id/center_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_orange_plus"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/center_layout"
        android:layout_alignTop="@+id/left"
        android:layout_alignBottom="@+id/left">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="142dp"
            android:layout_above="@+id/second_title"
            android:layout_alignRight="@+id/second_title"
            android:layout_alignParentLeft="true">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="52dp"
                android:layout_height="52dp">
                <FrameLayout
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/dg_svip_see_oval_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    flatten="true">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/second_iv"
                        android:clickable="false"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="0x7f0803de"
                        style="@style/core_fresco_profile_small"/>
                </FrameLayout>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/second_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"/>
            </FrameLayout>
        </FrameLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#8a000000"
            android:gravity="center"
            android:id="@+id/second_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.VipIntroGroupPage>
