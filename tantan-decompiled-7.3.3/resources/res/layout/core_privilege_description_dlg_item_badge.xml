<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilege.dlg.PrivilegeContentDlgItemBadgeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/badge"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="vip.privilege.dlg.PrivilegeContentDlgItemBadgeView">
    <p151v.VImage
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:src="0x7f081405"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:background="@drawable/core_privilege_dlg_badge_avatat_bg"
        android:padding="3dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="115dp"
        android:layout_height="153dp"
        android:layout_marginLeft="65dp"
        android:layout_marginTop="35dp">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="8dp"/>
        <View
            android:background="@drawable/core_privilege_dlg_badge_avatat_mask"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_alignParentBottom="true"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            android:layout_alignParentBottom="true"/>
        <p151v.VImage
            android:id="@+id/icon"
            android:layout_width="51dp"
            android:layout_height="29dp"
            android:layout_marginLeft="-14dp"
            android:layout_marginBottom="30dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.privilege.dlg.PrivilegeContentDlgItemBadgeView>
