<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@drawable/core_intl_pet_photo_rule_bg"
    android:paddingBottom="67dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rTopLeftRadius="20dp"
    app:rTopRightRadius="20dp">
    <p151v.VFrame
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <p151v.VButton
            android:id="@+id/back"
            android:background="0x7f080b70"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#67559a"
            android:layout_gravity="center"
            android:id="@+id/rule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="活動介紹"/>
    </p151v.VFrame>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#574390"
        android:id="@+id/rule_time_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="活動時間："
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#67529a"
        android:id="@+id/rule_time_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="12/23 00:00 - 01/05 23:59"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#574390"
        android:id="@+id/rule_play_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="玩法說明："
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#67529a"
        android:id="@+id/rule_play_desc_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="1. 在活動期間12/23 00:00 - 01/05 23:59，上傳並替換與萌寵合拍的照片，即可參與活動。"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#67529a"
        android:id="@+id/rule_play_desc_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="2. 根據上傳合拍報名活動，最終將由探探隨機挑選5-10名用戶獲得優質獎勵三件套。"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#67529a"
        android:id="@+id/rule_play_desc_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="3. 獲獎者將於活動截止後的2日內收到官方郵件，確認出席後於01/07在台北和平東路寵物餐廳，與百萬明星藝人互動，進行線下寵物聚會及獲得萌寵禮包。"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#67529a"
        android:id="@+id/rule_play_desc_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="4. 最新活動資訊追蹤官方Instagram @tantanapp_tw。"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#67529a"
        android:id="@+id/rule_play_desc_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="5. 本活動中如有未盡事宜，官方保留解釋活動內容及修改、終止進行之權利。"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#574390"
        android:id="@+id/rule_reward_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="活動獎勵："
        android:layout_marginStart="20dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/reward_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/reward">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/reward_img1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/transparent"
                app:failureImageScaleType="centerInside"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/transparent"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ef4783"
                android:id="@+id/reward_desc_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="明星互動"
                android:lines="2"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <p151v.VDraweeView
                android:id="@+id/reward_img2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/transparent"
                app:failureImageScaleType="centerInside"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/transparent"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ef4783"
                android:gravity="center_horizontal"
                android:id="@+id/reward_desc_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="線下寵物聚會"
                android:lines="2"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/reward_img3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/transparent"
                app:failureImageScaleType="centerInside"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/transparent"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ef4783"
                android:id="@+id/reward_desc_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="萌寵禮包"
                android:lines="2"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundLinearLayout>
