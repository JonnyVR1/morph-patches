<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.seepop.NewLikeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="seepop.NewLikeView">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:adjustViewBounds="true"
        app:actualImageScaleType="fitXY"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VRelative
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            flatten="true">
            <p151v.VFrame
                android:id="@+id/layout_single"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/single_image"
                    android:background="0x7f0811d2"
                    android:paddingLeft="14dp"
                    android:paddingTop="17dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="17dp"
                    android:layout_width="114dp"
                    android:layout_height="144dp"
                    app:roundedCornerRadius="10dp"/>
                <p151v.VImage
                    android:layout_gravity="bottom|right"
                    android:layout_width="22dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="21dp"
                    android:layout_marginBottom="25dp"
                    android:src="0x7f0811d3"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/layout_double"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VFrame
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="81dp"
                    android:rotation="-6">
                    <p151v.VDraweeView
                        android:id="@+id/double_left"
                        android:background="0x7f0811d2"
                        android:paddingLeft="14dp"
                        android:paddingTop="17dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="17dp"
                        android:layout_width="114dp"
                        android:layout_height="144dp"
                        app:roundedCornerRadius="10dp"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:layout_width="22dp"
                        android:layout_height="14dp"
                        android:layout_marginRight="21dp"
                        android:layout_marginBottom="25dp"
                        android:src="0x7f0811d3"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="81dp"
                    android:rotation="6">
                    <p151v.VDraweeView
                        android:id="@+id/double_right"
                        android:background="0x7f0811d2"
                        android:paddingLeft="14dp"
                        android:paddingTop="17dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="17dp"
                        android:layout_width="114dp"
                        android:layout_height="144dp"
                        app:roundedCornerRadius="10dp"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:layout_width="22dp"
                        android:layout_height="14dp"
                        android:layout_marginRight="21dp"
                        android:layout_marginBottom="25dp"
                        android:src="0x7f0811d3"/>
                </p151v.VFrame>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/layout_three"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VFrame
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="140dp"
                    android:rotation="-6">
                    <p151v.VDraweeView
                        android:id="@+id/three_left"
                        android:background="0x7f0811d2"
                        android:paddingLeft="12dp"
                        android:paddingTop="15dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="15dp"
                        android:layout_width="102dp"
                        android:layout_height="129dp"
                        app:roundedCornerRadius="9dp"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:layout_width="22dp"
                        android:layout_height="14dp"
                        android:layout_marginRight="21dp"
                        android:layout_marginBottom="25dp"
                        android:src="0x7f0811d3"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="140dp"
                    android:layout_marginTop="15dp"
                    android:rotation="6">
                    <p151v.VDraweeView
                        android:id="@+id/three_right"
                        android:background="0x7f0811d2"
                        android:paddingLeft="12dp"
                        android:paddingTop="15dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="15dp"
                        android:layout_width="102dp"
                        android:layout_height="129dp"
                        app:roundedCornerRadius="9dp"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:layout_width="22dp"
                        android:layout_height="14dp"
                        android:layout_marginRight="19dp"
                        android:layout_marginBottom="23dp"
                        android:src="0x7f0811d3"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VDraweeView
                        android:id="@+id/three_center"
                        android:background="0x7f0811d2"
                        android:paddingLeft="14dp"
                        android:paddingTop="17dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="17dp"
                        android:layout_width="114dp"
                        android:layout_height="144dp"
                        app:roundedCornerRadius="10dp"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:layout_width="22dp"
                        android:layout_height="14dp"
                        android:layout_marginRight="21dp"
                        android:layout_marginBottom="25dp"
                        android:src="0x7f0811d3"/>
                </p151v.VFrame>
            </p151v.VFrame>
        </p151v.VRelative>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#999999"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="18dp"
            android:lineSpacingExtra="5sp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/positive"
            android:background="@drawable/core_newlike_botton"
            android:paddingTop="14dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="5sp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#999999"
            android:gravity="center"
            android:id="@+id/negative"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/NEW_LIKE_KILL_BUTTUN"
            android:lineSpacingExtra="5sp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.seepop.NewLikeView>
