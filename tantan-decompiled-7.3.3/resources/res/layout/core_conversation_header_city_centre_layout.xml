<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationCityCentreCardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/city_contre_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="messages.ConversationCityCentreCardLayout">
    <FrameLayout
        android:id="@+id/back_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <View
            android:background="@drawable/core_city_centre_top_card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/background_flow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08070a"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/card_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_alignLeft="@+id/back_ground"
        android:layout_alignRight="@+id/back_ground"
        flatten="true">
        <FrameLayout
            android:id="@+id/head_layout"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerVertical="true"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/head"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/frame"
                android:background="0x7f080704"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/info_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/head_layout"
            android:layout_centerVertical="true"
            flatten="true">
            <TextView
                android:textSize="15sp"
                android:textColor="#cce1d1ac"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#66e1d1ac"
                android:ellipsize="end"
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <p151v.VMarqueeText
                android:textSize="13sp"
                android:textColor="#ffdb89"
                android:ellipsize="marquee"
                android:id="@+id/des"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
        </p151v.VLinear>
    </RelativeLayout>
    <View
        android:id="@+id/line"
        android:background="@drawable/core_city_centre_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/card_layout"
        android:layout_alignLeft="@+id/back_ground"
        android:layout_alignRight="@+id/back_ground"/>
    <RelativeLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/line"
        android:layout_alignLeft="@+id/back_ground"
        android:layout_alignRight="@+id/back_ground"
        flatten="true">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/core_city_centre_bg_icon"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#cce1d1ac"
            android:id="@+id/city_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="城市封面"
            android:layout_toRightOf="@+id/icon"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/chat_bt"
            android:background="@drawable/core_city_centre_chat_bg"
            android:layout_width="72dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:text="和他聊聊"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/chat_big_bt"
            android:background="@drawable/core_city_centre_chat_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:text="我要上封面"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignLeft="@+id/back_ground"
        android:layout_alignRight="@+id/back_ground"
        android:layout_alignBottom="@+id/bottom_layout"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationCityCentreCardLayout>
