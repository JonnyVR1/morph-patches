<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.chat.view.VoiceChatItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.chat.view.VoiceChatItemView">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_message"
        android:paddingLeft="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/avatar"
        flatten="true">
        <include
            android:id="@+id/item_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            layout="@layout/live_voice_chat_atom_item"/>
        <include
            android:id="@+id/item_2"
            android:background="@drawable/live_bg_black_r10_a20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            layout="@layout/live_voice_chat_atom_item"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.voice.chat.view.VoiceChatItemView>
