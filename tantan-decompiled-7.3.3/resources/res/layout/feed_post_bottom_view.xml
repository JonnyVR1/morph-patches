<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="mediapicker.post.bottom.FeedPostBottomView">
    <com.p051p1.mobile.putong.feed.newui.mediapicker.post.bottom.FeedPostBottomTitleTagsView
        android:id="@+id/title_tags_fl"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/nearby_topics_fl"/>
    <com.p051p1.mobile.putong.feed.newui.mediapicker.post.bottom.FeedPostBottomTopicView
        android:id="@+id/nearby_topics_fl"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/post_bottom_fl_fl"
        flatten="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/new_post_album"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="14dp"
            android:src="@drawable/feed_new_post_album_selector"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/new_post_camera"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/feed_new_post_camera_selector"/>
            <com.p051p1.mobile.putong.feed.newui.photoalbum.redpointview.FeedRedDotView
                android:layout_gravity="top|right"
                android:id="@+id/camera_mask_red_point"
                android:visibility="invisible"
                android:layout_width="13dp"
                android:layout_height="13dp"
                app:feedDotDrawableOvalColor="#ff3228"
                app:feedDotDrawableRingColor="#ffffff"
                app:feedDotDrawableRingWidth="1.5dp"
                app:feedDotDrawableWidth="13dp"
                app:feedRedDotType="FEED_POST_SHOOT_POINT"/>
        </FrameLayout>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/new_post_audio"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp"
            android:src="@drawable/feed_new_post_audio_selector"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/new_post_location"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp"
            android:src="@drawable/feed_new_post_location_selector"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/at_iv"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/feed_post_at_selector"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/topic_iv"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp"
            android:src="0x7f081e76"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/feed_4d000000"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/moment_visible_range_tv"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="公开"
            android:drawablePadding="3dp"
            android:layout_weight="1"
            android:drawableEnd="0x7f081d90"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/post_bottom_fl_fl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <FrameLayout
            android:id="@+id/post_bottom_fl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.mediapicker.post.bottom.FeedPostBottomAlbumView
                android:id="@+id/album_frag_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.feed.newui.mediapicker.post.bottom.FeedPostBottomAudioView
                android:id="@+id/bottom_extra_container"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:id="@+id/bottom_recording_cover"
        android:background="@color/feed_post_bg_audio_cover"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="false"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
