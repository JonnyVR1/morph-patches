<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/common_intl_friend_purpose_item_bg"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginTop="12dp">
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"/>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="@color/black"
        android:layout_gravity="center_vertical"
        android:id="@+id/key_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        app:fontWeight="500"/>
</p151v.VLinear>
