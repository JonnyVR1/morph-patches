<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="mediaoperation.cropper.NewAlbumCropperAct">
    <com.p051p1.mobile.android.p053ui.cropiwa.CropIwaView
        android:id="@+id/crop_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="50dp"
        app:ci_draw_grid_dashed="true"/>
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/loading"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:indeterminateOnly="true"
        app:cpb_color="@color/tantan_orange"
        app:cpb_stroke_percentage="0.1"/>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/rotate"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:src="0x7f08033c"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/crop_prompt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f082967"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="为保证卡片展示完整，请将人物主体放在虚线框内"
            android:layout_marginStart="3dp"/>
    </p151v.VLinear>
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/cancel"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f08033a"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/putong_common_cropper_reset_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FEED_CAPTURE_RESTORE"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/confirm"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="12dp"
            android:src="0x7f08033b"/>
    </FrameLayout>
</FrameLayout>
