<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.voiceslipcard.popularroom.group.LiveGroupChatItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    flatten="true"
    folder="voiceslipcard"
    holder="popularroom.group.LiveGroupChatItemView">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="5dp"
        android:src="0x7f082814"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/black"
            android:id="@+id/leftTopTag"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="优质"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/voiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="死蹲唠嗑选手通宵我不配用爱情，这是啥玩意你说奇不奇怪呢，不奇怪，哈哈哈哈"
            android:maxLines="2"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/black"
            android:id="@+id/leftBottomTag"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="闲聊唠嗑"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="4dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/headerContainer"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.external.voiceslipcard.popularroom.group.LiveGroupChatItemView>
