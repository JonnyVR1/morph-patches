<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.base.room.RoomView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="base.room.RoomView">
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_bg_view"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_player_view"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/push_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_room_pusher_view"/>
    <View
        android:id="@+id/player_mask"
        android:background="@drawable/live_list_bg_live_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/rtc_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_rtc_error_view"/>
    <p151v.VFrame
        android:id="@+id/fl_clear_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/bottom_layer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            flatten="true">
            <include
                android:id="@+id/jump_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="10dp"
                layout="@layout/live_jump_room"/>
            <include
                android:id="@+id/live_pk"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="316dp"
                android:layout_marginTop="159dp"
                android:layout_centerHorizontal="true"
                flatten="true"
                layout="@layout/live_pk_view"/>
            <include
                android:id="@+id/live_pk_internal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="316dp"
                android:layout_marginTop="159dp"
                android:layout_centerHorizontal="true"
                flatten="true"
                layout="@layout/live_pk_view_internal"/>
            <include
                android:id="@+id/live_multi_call"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="150dp"
                android:layout_centerHorizontal="true"
                flatten="true"
                layout="@layout/live_multi_call_top_view"/>
            <include
                android:id="@+id/live_multi_pk_points"
                android:background="@color/red"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="-16dp"
                android:layout_alignTop="@+id/live_multi_call"
                android:layout_centerHorizontal="true"
                flatten="true"
                layout="@layout/live_multi_pk_points_layout"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/live_white_80_opacity"
                android:gravity="center"
                android:id="@+id/super_manager"
                android:background="@drawable/live_bg_black_r12_a15"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="60dp"
                android:layout_marginRight="12dp"
                android:text="管理"
                android:layout_below="@+id/live_avatar_layout"
                android:layout_alignParentEnd="true"/>
            <include
                android:id="@+id/live_call"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="268dp"
                android:layout_marginTop="163dp"
                android:layout_centerHorizontal="true"
                flatten="true"
                layout="@layout/live_call_view"/>
            <p151v.VFrame
                android:id="@+id/live_avatar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/jump_room"
                flatten="true">
                <include
                    android:id="@+id/live_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/live_avatar_margin_start"
                    layout="@layout/live_avatar"/>
            </p151v.VFrame>
            <p151v.VRelative
                android:id="@+id/board_entry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/live_avatar_layout"
                android:layout_marginStart="12dp"
                flatten="true">
                <include
                    android:id="@+id/announcement_entry"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    layout="@layout/live_announcement_entry"/>
                <p151v.VFrame
                    android:id="@+id/hour_board_entry_root"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@+id/announcement_entry"
                    flatten="true">
                    <include
                        android:id="@+id/hour_board_entry"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        layout="@layout/live_hour_leader_board_entry"/>
                    <include
                        android:id="@+id/hour_board_new_entry"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        layout="@layout/live_hour_leader_board_new_entry"/>
                </p151v.VFrame>
                <FrameLayout
                    android:id="@+id/star_board_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_toEndOf="@+id/hour_board_entry_root"
                    flatten="true">
                    <include
                        android:id="@+id/star_board_entry"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        layout="@layout/live_star_board_entry"/>
                    <include
                        android:id="@+id/intl_star_board_entry"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        layout="@layout/live_intl_star_board_entry"/>
                </FrameLayout>
            </p151v.VRelative>
            <include
                android:id="@+id/sticker_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/live_room_sticker_container"/>
            <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
                android:id="@+id/operation_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/board_entry"
                android:layout_marginStart="11dp"
                flatten="true">
                <include
                    android:id="@+id/live_operation_entry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/live_operation_entry"/>
            </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
            <include
                android:id="@+id/live_bullet"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-22dp"
                android:layout_below="@+id/live_avatar_layout"
                layout="@layout/live_bullet_notice_container_view"/>
            <include
                android:id="@+id/live_sider_entry_view"
                android:visibility="invisible"
                android:layout_width="115dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/live_avatar_layout"
                android:layout_alignParentEnd="true"
                layout="@layout/live_layout_live_sider_entry"/>
            <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
                android:id="@+id/fans_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/jump_room"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/live_avatar_layout"
                android:layout_alignParentEnd="true">
                <include
                    android:id="@+id/live_fans"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/live_fans"/>
            </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
            <include
                android:id="@+id/live_call_widget"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="89dp"
                android:layout_marginBottom="170dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                layout="@layout/live_call_widget_view"/>
            <include
                android:orientation="vertical"
                android:id="@+id/live_campaigns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="60dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="12dp"
                flatten="true"
                layout="@layout/live_campaign_view"/>
            <com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView
                android:id="@+id/chat_layout"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginBottom="10dp"
                android:layout_alignParentBottom="true">
                <include
                    android:id="@+id/live_chat"
                    android:visibility="gone"
                    android:layout_width="248dp"
                    android:layout_height="wrap_content"
                    layout="@layout/live_chat"/>
            </com.p051p1.mobile.putong.live.livingroom.view.TouchSwallowView>
            <com.p051p1.mobile.putong.live.livingroom.common.chat.danmaku.show.DanmakuViewPort
                android:layout_gravity="bottom"
                android:id="@+id/danmaku_viewport"
                android:layout_width="match_parent"
                android:layout_height="144dp"
                android:layout_marginBottom="10dp"
                android:layout_above="@+id/chat_layout"/>
        </p151v.VRelative>
        <LinearLayout
            android:layout_gravity="end|bottom"
            android:orientation="vertical"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginBottom="50dp">
            <include
                android:id="@+id/newCombo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="-50dp"
                android:layout_marginStart="40dp"
                layout="@layout/live_intl_gift_combo_view"/>
        </LinearLayout>
        <p151v.VFrame
            android:id="@+id/middle_layer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <include
                android:id="@+id/gift_layer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/live_gift_layer"/>
            <include
                android:id="@+id/top_effect_layer"
                layout="@layout/live_top_effect_layer"/>
        </p151v.VFrame>
        <p151v.VRelative
            android:id="@+id/topside_layer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <include
                android:id="@+id/live_chat_entry"
                android:visibility="gone"
                android:layout_width="248dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginBottom="10dp"
                android:layout_alignParentBottom="true"
                layout="@layout/live_chat_input_entry"/>
            <include
                android:id="@+id/live_bottom"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="56dp"
                android:layout_alignParentEnd="true"
                layout="@layout/live_bottom"/>
            <com.p051p1.mobile.putong.live.livingroom.common.bubble.LiveBubbleView
                android:id="@+id/live_bubble"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="252dp"
                android:layout_alignParentBottom="true">
                <FrameLayout
                    android:id="@+id/gift_trays_layout"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/gift_trays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        layout="@layout/live_gift_trays"/>
                </FrameLayout>
                <include
                    android:id="@+id/admission"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_marginTop="-13dp"
                    layout="@layout/live_gift_trays_admission"/>
            </p151v.VLinear>
            <View
                android:id="@+id/shadow"
                android:background="@color/live_black_60_opacity"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:layout_gravity="center"
                    android:id="@+id/pre_operation_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/live_pre_operation_anim_view"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/notification_view"
                android:visibility="visible"
                android:layout_width="183dp"
                android:layout_height="48dp"
                android:layout_marginTop="-64dp"
                android:layout_alignTop="@+id/gift_trays_layout"
                android:layout_marginEnd="-3dp"
                android:layout_alignParentEnd="true"/>
            <p151v.VRelative
                android:gravity="center"
                android:id="@+id/close_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentEnd="true"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/live_close"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    app:srcCompat="0x7f0824c3"/>
            </p151v.VRelative>
        </p151v.VRelative>
        <com.p051p1.mobile.putong.live.livingroom.increment.gift.game.GameEffectView
            android:layout_gravity="center"
            android:id="@+id/game_player"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VFrame
            android:id="@+id/super_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
    <p151v.VRelative
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/close_layout_clear"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="44dp"
            android:layout_height="38dp"
            app:srcCompat="0x7f0824c3"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.live.livingroom.base.room.RoomView>
