<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="account.PasswordChangeViewModel"
    style="@style/core_account_root">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VScroll style="@style/core_account_scroll">
        <LinearLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clipToPadding="false"
            style="@style/core_account_frame">
            <TextView
                android:textSize="16sp"
                android:textColor="#9d9d9d"
                android:id="@+id/send_code_warm"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/SETTING_MODIFY_PWD_SEND_CODD_TO"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#de000000"
                    android:id="@+id/phone_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="+86 15572733661"
                    android:layout_centerVertical="true"/>
                <p151v.VButton_FakeShadowSmall
                    android:textColor="@color/white"
                    android:id="@+id/send_code"
                    android:background="@drawable/core_setting_account_get_code"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/SIGNUP_GET_CODE"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/v_button"/>
            </RelativeLayout>
            <p151v.VMaterialEdit
                android:id="@+id/change_pwd_code"
                android:layout_marginTop="16dp"
                android:hint="@string/SETTING_COMFIRM_CODE"
                android:maxLength="20"
                android:inputType="number"
                app:met_floatingLabel="none"
                app:met_floatingLabelText=""
                app:met_minCharacters="4"
                style="@style/core_account_code_min_length"/>
            <p151v.VMaterialEdit
                android:id="@+id/new_password"
                android:layout_marginTop="-10dp"
                android:hint="@string/SETTING_NEW_PWD"
                android:maxLength="20"
                app:met_floatingLabel="none"
                app:met_floatingLabelText=""
                style="@style/core_account_password_min_length"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="@color/common_orange"
                android:id="@+id/error_code"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/PASSWORD_DIFFICULTY_ERROR"/>
            <p151v.VText
                android:id="@+id/hint"
                android:padding="0dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/PASSWORD_DIFFICULTY"
                style="@style/settings_small_des"/>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:id="@+id/done"
        android:text="@string/ACTION_DONE"
        style="@style/core_account_continue_button"/>
</p151v.VLinear>
