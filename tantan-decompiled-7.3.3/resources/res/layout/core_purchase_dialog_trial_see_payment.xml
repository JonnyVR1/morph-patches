<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.mediator.payment.PurchasePaymentTrialSeeComponent">
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/get_privilege_text"
        android:background="@drawable/core_limited_trial_see_purchase_dialog_button_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_09"
        android:layout_gravity="center_horizontal"
        android:id="@+id/origin_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:alpha="0.4"/>
    <View
        android:id="@+id/divider"
        android:background="@color/common_000000_05"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/pay_method"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_black_04"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:lines="1"
            android:layout_marginStart="12dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_promotion"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_promotion_right"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_arrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="0x7f080d4c"/>
    </LinearLayout>
</LinearLayout>
