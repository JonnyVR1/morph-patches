<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/intl_whisper_tab_discount_banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.p051p1.mobile.putong.core.newui.messages.anim.view.PullQuickChatLayout
                android:id="@+id/whisper_pull_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <p151v.VList
                    android:id="@+id/whisper_list"
                    android:paddingTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:listSelector="@color/transparent"
                    android:divider="@null"
                    android:dividerHeight="0dp"/>
            </com.p051p1.mobile.putong.core.newui.messages.anim.view.PullQuickChatLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <p151v.VImage
                    android:layout_width="220dp"
                    android:layout_height="150dp"
                    android:src="0x7f0809a3"/>
                <p151v.VText_NoTopPadding
                    android:textSize="14sp"
                    android:textColor="#66323232"
                    android:gravity="center"
                    android:id="@+id/empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="95dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="95dp"
                    android:text="@string/INTL_WHISPER_TAB_BLANK_TEXT"
                    android:layout_marginHorizontal="95dp"
                    android:lineHeight="20dp"
                    app:fontWeight="400"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <com.sunshine.engine.particle.SceneView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/whisper_boost_scene"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="135dp"
        android:layout_marginBottom="50dp"/>
    <com.p051p1.mobile.putong.core.newui.view.BoostViewContainer
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/whisper_boost"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:borderOuterCircle="false"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bottom_unlock_btn"
        android:background="@drawable/core_whisper_btn_unlock_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/core_ic_whisper_btn_unlock_icon"/>
            <p151v.VText_NoTopPadding
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/INTL_WHISPER_TAB_UNLOCK_BTN"
                app:fontWeight="600"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
