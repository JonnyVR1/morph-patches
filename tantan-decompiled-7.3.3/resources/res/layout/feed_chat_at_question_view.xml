<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/at_question_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="mediapicker.chatat.ChatAtQuestionViewModel">
    <p151v.VRelative
        android:background="0x7f081e2d"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp">
        <ImageView
            android:id="@+id/answer_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="7dp"
            android:src="0x7f081e3f"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:id="@+id/answer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="猜你想问"
            android:layout_toRightOf="@+id/answer_iv"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:divider="@null"
            android:layout_below="@+id/answer_iv"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </p151v.VRelative>
    <View
        android:id="@+id/adjustKeyboard"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:layout_below="@+id/recyclerView"/>
</p151v.VLinear>
