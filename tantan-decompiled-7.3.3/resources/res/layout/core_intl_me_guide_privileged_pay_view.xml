<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.newme.ProfilePrivilegePayGuide xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="profile.newme.ProfilePrivilegePayGuide">
    <p151v.VDraweeView
        android:id="@+id/privilege_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#9e5701"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toTopOf="@+id/desc"
        app:layout_constraintEnd_toStartOf="@+id/buy"
        app:layout_constraintStart_toEndOf="@+id/privilege_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="#9e5701"
        android:gravity="start"
        android:id="@+id/desc"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="15dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="15dp"
        app:autoSizeMaxTextSize="14dp"
        app:autoSizeMinTextSize="8dp"
        app:autoSizeStepGranularity="1dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buy"
        app:layout_constraintStart_toEndOf="@+id/privilege_icon"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#9e5701"
        android:gravity="center"
        android:id="@+id/buy"
        android:background="@drawable/core_intl_me_vip_buy_bt"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/INTL_RENEW_GUIDING_BANNER_BTN"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="bold"/>
</com.p051p1.mobile.putong.core.newui.profile.newme.ProfilePrivilegePayGuide>
