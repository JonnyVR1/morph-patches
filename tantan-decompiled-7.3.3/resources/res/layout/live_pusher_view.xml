<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.base.pusher.LivePusherView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="base"
    holder="pusher.LivePusherView">
    <FrameLayout
        android:id="@+id/pusher_texture_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:id="@+id/local_texture_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true"/>
        <FrameLayout
            android:id="@+id/remote_texture_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true"/>
        <View
            android:background="@drawable/live_list_bg_live_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/water_mark_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="77dp"
        android:layout_marginRight="10dp"
        flatten="true">
        <p151v.VText
            android:textSize="6sp"
            android:textStyle="bold"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:id="@+id/water_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="0.5"
            android:shadowRadius="0"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/water_mark_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_vector_water_mark_cn"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/water_mark"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/loading"
        android:layout="@layout/live_loading_view"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
    <ViewStub
        android:id="@+id/error_stub"
        android:layout="@layout/live_net_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.livingroom.base.pusher.LivePusherView>
