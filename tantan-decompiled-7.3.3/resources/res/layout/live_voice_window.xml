<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.other.voicewindow.VoiceWindowView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="other.voicewindow"
    holder="VoiceWindowView">
    <View
        android:layout_gravity="center"
        android:id="@+id/wave_bottom"
        android:background="@drawable/live_shape_voice_window_wave_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/wave_top"
        android:background="@drawable/live_shape_voice_window_wave_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/avatar"
        android:background="@drawable/live_shape_voice_window_bg"
        android:padding="1px"
        android:layout_width="48dp"
        android:layout_height="48dp"
        fresco:actualImageScaleType="centerCrop"
        fresco:failureImage="@drawable/live_vector_default_avatar_bg"
        fresco:failureImageScaleType="centerCrop"
        fresco:roundingBorderColor="@color/white"
        fresco:roundingBorderWidth="1.5dp"
        style="@style/live_fresco_profile_small"/>
    <p151v.VText
        android:textSize="10dp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/text"
        android:background="@drawable/live_shape_voice_window_text_bg"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="22dp"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:elevation="2dp"/>
</com.p051p1.mobile.putong.live.livingroom.other.voicewindow.VoiceWindowView>
