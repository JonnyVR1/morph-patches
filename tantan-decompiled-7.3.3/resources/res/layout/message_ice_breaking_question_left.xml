<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemIceBreakingQuestion xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="?attr/message_bubble_bg_left"
    android:minWidth="244dp"
    style="@style/core_messages_questions">
    <View
        android:id="@+id/start_line"
        android:background="@drawable/core_ice_breaking_line_bg"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="9dp"
        app:layout_constraintBottom_toTopOf="@+id/line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        ignore="true"/>
    <p151v.VText
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/notice"
        android:tag="left"
        android:background="@drawable/core_message_ice_breaking_question_item_bg"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="他回答了你的问题"
        android:lineSpacingExtra="0sp"
        android:paddingStart="24dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/start_line"
        app:layout_constraintTop_toTopOf="@+id/start_line"/>
    <p151v.VText
        android:id="@+id/question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_line"
        app:layout_constraintTop_toBottomOf="@+id/notice"/>
    <View
        android:id="@+id/line"
        android:background="#e9e9e9"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/question"
        ignore="true"/>
    <include
        android:id="@+id/answer"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/line"
        layout="@layout/messages_text_left"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemIceBreakingQuestion>
