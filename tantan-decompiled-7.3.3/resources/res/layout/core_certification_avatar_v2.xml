<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/core_certification_avatar_verify_bg_v2"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    flatten="true">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp">
        <p151v.VImage
            android:id="@+id/icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/core_certification_avatar_icon_small_v2"/>
        <p151v.VText_NoTopPadding
            android:textSize="22sp"
            android:textColor="#cc000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="头像本人认证"
            android:layout_marginStart="4dp"
            app:fontWeight="500"/>
    </p151v.VLinear>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#66000000"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="使用五官清晰正面照完成认证"
        app:fontWeight="400"/>
    <p151v.VFrame
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <p151v.VImage
            android:id="@+id/avatar_bg"
            android:layout_width="259dp"
            android:layout_height="174dp"
            android:src="@drawable/core_certification_center_avatar_bg_v2_1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="141dp"
            android:layout_height="174dp"
            app:actualImageScaleType="centerCrop"
            app:roundBottomLeft="true"
            app:roundBottomRight="true"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="10dp"/>
        <p151v.VText_NoTopPadding
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/label"
            android:background="@drawable/core_avatar_confirm_waring_tips_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp"
            android:text="认证成功率低"
            android:drawableLeft="@drawable/core_avatar_confirm_warning_ic"
            android:drawablePadding="2dp"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/un_verify_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        flatten="false">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:layout_marginHorizontal="28dp">
            <View
                android:background="@color/common_light_03"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="#66000000"
                android:id="@+id/benefits_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="完成认证后，解锁5项权益"
                android:layout_marginHorizontal="10dp"/>
            <View
                android:background="@color/common_light_03"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tip_container"
            android:background="@drawable/core_bg_r10_08000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tip_avatar_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:ellipsize="end"
                    android:id="@+id/tip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="完成认证，立即收到她们的喜欢"
                    android:lines="1"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:ellipsize="end"
                    android:id="@+id/tip_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="3人邀请你认证，通过后自动喜欢你"
                    android:lines="1"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VRecyclerView
            android:orientation="horizontal"
            android:id="@+id/privilege_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <p151v.VRecyclerView
            android:orientation="horizontal"
            android:id="@+id/tip_privilege_list"
            android:background="@drawable/core_bg_r10_08000000"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:paddingStart="10dp"
            android:layout_marginHorizontal="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/tip_show_privilege"
            android:background="@drawable/core_bg_12_0d000000"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:text="更多5项权益"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/core_certification_center_more_privilege_icon"
            android:paddingHorizontal="10dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/tip_hide_privilege"
            android:background="@drawable/core_bg_12_0d000000"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:text="收起"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/core_certification_center_close_privilege_icon"
            android:paddingHorizontal="10dp"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/title_strategy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="35dp"
            android:layout_marginRight="28dp"
            android:layout_marginHorizontal="28dp">
            <View
                android:background="@color/common_light_03"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="#66000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="认证攻略"
                android:layout_marginHorizontal="10dp"/>
            <View
                android:background="@color/common_light_03"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <p151v.VFrame
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.AutoVDraweeView
                    android:id="@+id/example_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:roundedCornerRadius="10dp"/>
                <p151v.VText_NoTopPadding
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/label_1_icon"
                    android:background="@drawable/core_avatar_example_bg"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="清晰五官"
                    android:drawablePadding="2dp"
                    android:drawableStart="@drawable/core_avatar_example_yes"
                    android:paddingHorizontal="6dp"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <p151v.AutoVDraweeView
                    android:id="@+id/example_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:roundedCornerRadius="10dp"/>
                <p151v.VText_NoTopPadding
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/label_2_icon"
                    android:background="@drawable/core_avatar_example_bg"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="光线明亮"
                    android:drawablePadding="2dp"
                    android:drawableStart="@drawable/core_avatar_example_yes"
                    android:paddingHorizontal="6dp"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <p151v.AutoVDraweeView
                    android:id="@+id/example_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:roundedCornerRadius="10dp"/>
                <p151v.VText_NoTopPadding
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/label_3_icon"
                    android:background="@drawable/core_avatar_example_bg"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="遮挡五官"
                    android:drawablePadding="2dp"
                    android:drawableStart="@drawable/core_avatar_example_no"
                    android:paddingHorizontal="6dp"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <p151v.AutoVDraweeView
                    android:id="@+id/example_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:roundedCornerRadius="10dp"/>
                <p151v.VText_NoTopPadding
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/label_4_icon"
                    android:background="@drawable/core_avatar_example_bg"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="脸占比小"
                    android:drawablePadding="2dp"
                    android:drawableStart="@drawable/core_avatar_example_no"
                    android:paddingHorizontal="6dp"/>
            </p151v.VFrame>
        </p151v.VLinear>
        <p151v.VText_NoTopPadding
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/core_low_photo_bottom_sheet_photo_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="16dp"
            android:text="更换照片，完成认证"
            android:layout_marginHorizontal="16dp"
            app:fontWeight="500"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/verify_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        flatten="false">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:layout_marginHorizontal="28dp">
            <View
                android:background="@color/common_light_03"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="#66000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="获得权益后提升数据"
                android:layout_marginHorizontal="10dp"/>
            <View
                android:background="@color/common_light_03"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.VText_NoTopPadding
                    android:textSize="20sp"
                    android:textColor="#1fbaff"
                    android:id="@+id/extra_swipe_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0次"
                    app:fontWeight="600"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="额外右滑"/>
            </p151v.VLinear>
            <View
                android:background="#0d000000"
                android:layout_width="1dp"
                android:layout_height="29dp"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.VText_NoTopPadding
                    android:textSize="20sp"
                    android:textColor="#1fbaff"
                    android:id="@+id/extra_recommend_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0次"
                    app:fontWeight="600"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="额外推荐"/>
            </p151v.VLinear>
            <View
                android:background="#0d000000"
                android:layout_width="1dp"
                android:layout_height="29dp"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.VText_NoTopPadding
                    android:textSize="20sp"
                    android:textColor="#1fbaff"
                    android:id="@+id/verify_user_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0次"
                    app:fontWeight="600"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="推荐认证用户"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VText_NoTopPadding
            android:textSize="14sp"
            android:textColor="#66000000"
            android:id="@+id/more_privilege"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="更多权益"
            android:drawablePadding="4dp"
            android:drawableEnd="@drawable/core_certification_center_more_privilege_icon"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/hide_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="35dp"
                android:layout_marginRight="28dp"
                android:layout_marginHorizontal="28dp">
                <View
                    android:background="@color/common_light_03"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <p151v.VText
                    android:textSize="12dp"
                    android:textColor="#66000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:text="其他权益"
                    android:layout_marginHorizontal="10dp"/>
                <View
                    android:background="@color/common_light_03"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <p151v.VRelative
                    android:id="@+id/privacy_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"
                    flatten="false">
                    <ImageView
                        android:id="@+id/icon_1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/core_certification_center_icon_1"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@+id/icon_1">
                        <p151v.VText_NoTopPadding
                            android:textSize="15sp"
                            android:textColor="#cc000000"
                            android:id="@+id/title_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="隐私保护设置"
                            app:fontWeight="500"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#66000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="你决定谁能看到你，保护隐私"/>
                    </p151v.VLinear>
                    <ImageView
                        android:id="@+id/privacy_setting_1_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080661"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </p151v.VRelative>
                <p151v.VRelative
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp">
                    <ImageView
                        android:id="@+id/icon_2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/core_certification_center_icon_2"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@+id/icon_2">
                        <p151v.VText_NoTopPadding
                            android:textSize="15sp"
                            android:textColor="#cc000000"
                            android:id="@+id/title_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="只看认证用户"
                            app:fontWeight="500"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#66000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="滑卡只看已完成头像认证的用户"/>
                    </p151v.VLinear>
                </p151v.VRelative>
                <p151v.VRelative
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp">
                    <ImageView
                        android:id="@+id/icon_3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/core_certification_center_icon_3"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@+id/icon_3">
                        <p151v.VText_NoTopPadding
                            android:textSize="15sp"
                            android:textColor="#cc000000"
                            android:id="@+id/title_3"
