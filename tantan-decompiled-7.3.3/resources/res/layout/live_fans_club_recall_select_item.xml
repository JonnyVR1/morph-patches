<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <p151v.VImage
        android:id="@+id/select_btn"
        android:background="@drawable/live_selector_select_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="24dp"
        android:layout_toEndOf="@+id/select_btn"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/online_view"
        android:background="@drawable/live_shape_icon_online"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_alignBottom="@+id/avatar"
        android:layout_marginEnd="6dp"
        android:layout_alignEnd="@+id/avatar"/>
    <p151v.VRelative
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/avatar">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#e6000000"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxEms="6"
                android:singleLine="true"/>
            <p151v.VDraweeView
                android:id="@+id/fans_level"
                android:layout_width="50dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"/>
            <p151v.VDraweeView
                android:id="@+id/user_level"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/layout"
            android:layout_alignStart="@+id/layout"/>
    </p151v.VRelative>
</p151v.VRelative>
