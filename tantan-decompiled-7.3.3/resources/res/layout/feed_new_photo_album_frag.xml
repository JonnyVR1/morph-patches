<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="photoalbum.discovery.NewPhotoAlbumFrag">
    <com.p051p1.mobile.putong.feed.newui.photoalbum.DiscoveryPager
        android:id="@+id/new_photo_album_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/activities_fl"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginRight="4dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        flatten="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/activity_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081cfa"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/activity_count"
            android:background="@drawable/feed_explore_tb_activity_num"
            android:paddingLeft="7dp"
            android:paddingTop="1dp"
            android:paddingRight="7dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:minWidth="20dp"
            android:minHeight="20dp"/>
    </p151v.VFrame>
</RelativeLayout>
