<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stock_fake_guide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:cardBackgroundColor="#08000000"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="11sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="请立即更换真实头像，以免影响你在划卡的曝光"
            android:lines="1"
            android:drawablePadding="7dp"
            android:drawableStart="@drawable/core_stock_fake_user_my_tab_banner_icon"
            android:layout_marginStart="12dp"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
