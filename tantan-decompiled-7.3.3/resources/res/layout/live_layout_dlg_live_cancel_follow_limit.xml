<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/live_bg_white_r8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/img_close"
        android:padding="5dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:tint="#c7d2db"
        app:srcCompat="0x7f082326"/>
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="22dp"
        android:scaleType="fitXY"
        app:srcCompat="0x7f0826bb"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="40dp"
        android:text="@string/LIVE_CLICK_FOLLOW"/>
    <p151v.VText
        android:textSize="17sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/unban_follow"
        android:background="@drawable/live_shape_ff3a00_gradient_r6"
        android:paddingLeft="37dp"
        android:paddingTop="12dp"
        android:paddingRight="37dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="24dp"
        android:text="@string/LIVE_CANCLE_FOLLOW_LIMIT"/>
</LinearLayout>
