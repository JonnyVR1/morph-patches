<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:divider="@drawable/core_profile_tag_divider"
    android:showDividers="middle"
    holder="profile.views.UserTagsView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pic_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="68dp">
        <View
            android:id="@+id/pic_tag_bg"
            android:background="@drawable/core_pic_tag_bg_new"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="8.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#54c7fc"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/pic_tag_tip"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/core_profile_tag_height"
            android:layout_marginLeft="3dp"
            android:text="真实头像"
            app:layout_constraintLeft_toRightOf="@+id/pic_tag_ic"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/pic_tag_ic"
            android:background="0x7f0818bf"
            android:layout_width="18dp"
            android:layout_height="@dimen/core_profile_tag_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tantan_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="68dp">
        <View
            android:id="@+id/tantan_tag_bg"
            android:background="@drawable/core_tantan_tag_bg_new"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="7.875dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#ff8d00"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tantan_tag_tip"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="4dp"
            android:text="真人实名"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tantan_tag_ic"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/tantan_tag_ic"
            android:background="0x7f0818c0"
            android:layout_width="15.75dp"
            android:layout_height="@dimen/core_profile_tag_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VText
        android:textSize="11.5sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/student_tag"
        android:background="@drawable/core_student_verification_tag_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/core_profile_tag_height"
        android:minWidth="46dp"
        android:text="学生"
        android:drawableLeft="@drawable/core_profile_school_tag_ic"
        android:drawablePadding="4dp"/>
    <p151v.VImage
        android:gravity="center"
        android:id="@+id/vip_tag"
        android:background="0x7f0819ad"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="37.125dp"
        android:minHeight="@dimen/core_profile_tag_height"/>
</LinearLayout>
