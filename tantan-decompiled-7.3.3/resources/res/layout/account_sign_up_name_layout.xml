<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:id="@+id/sign_up_top_icon"
        android:layout_width="138dp"
        android:layout_height="120dp"
        android:src="0x7f080206"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="24dp"
        android:textColor="@color/black"
        android:id="@+id/sign_up_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="116dp"
        android:layout_marginRight="40dp"
        android:text="我们该如何称呼你？"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/common_000000_70"
        android:id="@+id/sign_up_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="40dp"
        android:text="试着写下朋友们对你的称呼，让我们也能像朋友一样与你互动"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_title"/>
    <View
        android:id="@+id/sign_up_error_text_bg"
        android:background="@drawable/common_card_middle_error_remind_bg"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginTop="51dp"
        app:layout_constraintEnd_toEndOf="@+id/sign_up_name"
        app:layout_constraintStart_toStartOf="@+id/sign_up_name"
        app:layout_constraintTop_toTopOf="@+id/sign_up_name"/>
    <com.p051p1.mobile.putong.account.p055ui.accountnew.loginopt.NameEditTextOpt
        android:textSize="18dp"
        android:textColor="@color/black"
        android:textColorHint="@color/common_000000_40"
        android:gravity="center_vertical"
        android:id="@+id/sign_up_name"
        android:background="@drawable/account_signup_input_bg_v2"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="40dp"
        android:hint="@string/SIGNUP_INPUT_USERNAME"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/account_signup_ai_cursor"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_subtitle"/>
    <p151v.VImage
        android:id="@+id/sign_up_refresh_name"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="64dp"
        android:src="0x7f0801e3"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_name"
        app:layout_constraintEnd_toEndOf="@+id/sign_up_name"
        app:layout_constraintTop_toTopOf="@+id/sign_up_name"/>
    <View
        android:id="@+id/sign_up_error_bg"
        android:background="@drawable/sign_up_nick_error_bg"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_name"
        app:layout_constraintEnd_toEndOf="@+id/sign_up_name"
        app:layout_constraintStart_toStartOf="@+id/sign_up_name"
        app:layout_constraintTop_toTopOf="@+id/sign_up_name"/>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#ff6464"
        android:gravity="center"
        android:id="@+id/sign_up_error_text"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:drawableStart="0x7f0801f2"
        app:layout_constraintEnd_toEndOf="@+id/sign_up_name"
        app:layout_constraintStart_toStartOf="@+id/sign_up_name"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_name"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/sign_up_error_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sign_up_error_text,sign_up_error_bg,sign_up_error_text_bg"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/sign_up_gender_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="34dp"
        android:text="仅支持中英文和空格，不支持特殊符号"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/sign_up_gender_tip_icon"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_error_text"/>
    <p151v.VImage
        android:id="@+id/sign_up_gender_tip_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f0829f9"
        android:scaleType="fitCenter"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_gender_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sign_up_gender_tips"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="34dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_gender_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
