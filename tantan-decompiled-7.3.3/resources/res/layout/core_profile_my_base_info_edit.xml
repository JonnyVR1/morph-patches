<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_basic_info_edit"
    android:background="@color/white"
    android:paddingTop="18dp"
    flatten="true"
    holder="profile.holders.ProfileBaseInfoEditHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VText
        android:id="@+id/edit_title"
        android:paddingTop="0dp"
        android:text="@string/PROFILE_BASIC_INFO"
        style="@style/profile_item_title_black_edit"/>
    <RelativeLayout
        android:id="@+id/nickname"
        android:paddingLeft="20dp"
        android:layout_marginTop="4dp"
        style="@style/profile_item_info">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_80"
            android:id="@+id/nickname_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SIGNUP_NICKNAKE_PLACEHOLDER"
            android:layout_centerVertical="true"/>
        <p151v.VImage
            android:id="@+id/nickname_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/core_profile_edit_right_arrow"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/nickname_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="116dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/nickname_arrow"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:paddingLeft="20dp"
        style="@style/profile_item_info">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_80"
            android:id="@+id/birthday_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SETTINGS_BIRTHDAY"
            android:layout_centerVertical="true"/>
        <p151v.VImage
            android:id="@+id/birthday_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/core_profile_edit_right_arrow"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/birthdate"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="116dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/birthday_arrow"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:paddingLeft="20dp"
        style="@style/profile_item_info">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_80"
            android:id="@+id/gender_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SETTINGS_YOUR_GENDER"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_toLeftOf="@+id/gender_image"
            android:layout_centerVertical="true"/>
        <p151v.VImage
            android:id="@+id/gender_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:src="0x7f081489"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/divider_layout"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="20dp">
        <View
            android:background="@drawable/core_profile_newui_edit_item_normal"
            android:layout_width="match_parent"
            android:layout_height="3dp"/>
    </LinearLayout>
</p151v.VLinear_Dividers>
