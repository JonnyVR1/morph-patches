<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemTantanTeamAnswer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="?attr/message_bubble_bg_left"
    android:paddingLeft="18dp"
    android:paddingTop="9.5dp"
    android:paddingRight="14dp"
    android:paddingBottom="9.5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemTantanTeamAnswer">
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemText
        android:textSize="@dimen/message_text_size"
        android:textColor="@color/text_dark"
        android:textColorLink="#1565c0"
        android:autoLink="web"
        android:id="@+id/answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        app:enableEmojis="true"
        app:largeEmojis="true"/>
    <p151v.VLinear
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="5dp">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/answer_useless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp">
            <p151v.VImage
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/core_tantanteam_answer_useless"
                android:layout_marginEnd="7dp"/>
            <p151v.VText
                android:enabled="true"
                android:textSize="14sp"
                android:textColor="@color/core_tantanteam_answer_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_CHAT_FEEDBACK_BAD"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/answer_useful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/core_tantanteam_answer_use"
                android:layout_marginEnd="7dp"/>
            <p151v.VText
                android:enabled="true"
                android:textSize="14sp"
                android:textColor="@color/core_tantanteam_answer_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_CHAT_FEEDBACK_GOOD"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemTantanTeamAnswer>
