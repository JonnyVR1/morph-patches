<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    holder="purchase.mediator.payment.PurchasePaymentUpgradeComponent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/pay_method"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_02"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:lines="1"
            android:layout_marginStart="10dp"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_promotion"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_promotion_right"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f081955"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/get_privilege"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/get_privilege_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
    </p151v.VLinear>
</LinearLayout>
