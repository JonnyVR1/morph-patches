<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/icon"
        android:layout_width="144dp"
        android:layout_height="132dp">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/out"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:cropToPadding="false"
            app:buttonColorEnd="@color/superlike_bg"
            app:buttonColorStart="@color/superlike_bg_light"
            app:icon="0x7f08178b"
            app:iconWidth="54dp"
            app:shadowEnable="true"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/count"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginRight="-12dp"
            android:layout_marginBottom="4dp"
            android:scaleType="centerInside"
            android:layout_alignRight="@+id/out"
            android:layout_alignBottom="@+id/out"
            android:layout_alignEnd="@+id/out"
            app:buttonColorEnd="#ec553e"
            app:buttonColorStart="#ec553e"
            app:centerText="x0"
            app:centerTextColor="@color/white"
            app:centerTextSize="24sp"
            app:shadowEnable="true"/>
    </RelativeLayout>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="#4d000000"
        android:id="@+id/timer"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/icon"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
