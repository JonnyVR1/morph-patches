<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomIntlLiveLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomIntlLiveLayout">
    <p151v.VFrame
        android:id="@+id/intl_living_card_bt_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        flatten="false">
        <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
            android:id="@+id/intl_living_card_bt_anim"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="291dp"
            android:layout_height="82dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toTopOf="@+id/card_bottom_info"/>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/intl_living_card_bt"
            android:background="@color/transparent"
            android:layout_width="259dp"
            android:layout_height="50dp">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/intl_living_card_bt_text"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LIVECARD_ENTER"
                android:drawableRight="0x7f080ac6"
                android:drawablePadding="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/intl_living_card_bt_anim"
                app:layout_constraintDimensionRatio="H,259:50"
                app:layout_constraintEnd_toEndOf="@+id/intl_living_card_bt_anim"
                app:layout_constraintStart_toStartOf="@+id/intl_living_card_bt_anim"
                app:layout_constraintTop_toTopOf="@+id/intl_living_card_bt_anim"
                app:typeface="medium"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="50dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/intl_living_card_bt_root"
        android:layout_marginStart="16dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <View
        android:id="@+id/info_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomIntlLiveLayout>
