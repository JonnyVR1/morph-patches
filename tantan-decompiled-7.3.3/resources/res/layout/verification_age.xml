<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="verification.age.AgeVerificationViewModel"
    innerClass="true">
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/age_container"
            android:paddingBottom="111dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/choose_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                flatten="true">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/AGE_CHECK_SELECT_TYPE_TITLE"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/AGE_CHECK_CHECK_CENTER_CONTENT"/>
                <p151v.VFrame
                    android:id="@+id/choose_type_car"
                    android:background="@drawable/core_verification_age_type_choose_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp">
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:background="0x7f08093a"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="20dp"/>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/AGE_CHECK_SELECT_TYPE_OPTION1"
                        android:layout_marginStart="79dp"
                        app:typeface="medium"/>
                    <p151v.VImage
                        android:layout_gravity="end|center_vertical"
                        android:background="0x7f0802ef"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/choose_type_passport"
                    android:background="@drawable/core_verification_age_type_choose_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp">
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:background="0x7f08093c"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="20dp"/>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/AGE_CHECK_SELECT_TYPE_OPTION2"
                        android:layout_marginStart="79dp"
                        app:typeface="medium"/>
                    <p151v.VImage
                        android:layout_gravity="end|center_vertical"
                        android:background="0x7f0802ef"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"/>
                </p151v.VFrame>
                <p151v.VFrame
                    android:id="@+id/choose_type_insurance"
                    android:background="@drawable/core_verification_age_type_choose_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp">
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:background="0x7f08093b"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="20dp"/>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/AGE_CHECK_SELECT_TYPE_OPTION3"
                        android:layout_marginStart="79dp"
                        app:typeface="medium"/>
                    <p151v.VImage
                        android:layout_gravity="end|center_vertical"
                        android:background="0x7f0802ef"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"/>
                </p151v.VFrame>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/AGE_CHECK_SELECT_TYPE_TIPS"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/upload_certificate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                flatten="true">
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:id="@+id/check_before_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/AGE_CHECK_BEFOR_SUBMIT_TITLE"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:id="@+id/check_before_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/AGE_CHECK_BEFOR_SUBMIT_CONTENT"/>
                <p151v.VFrame
                    android:layout_width="192dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="9dp"
                    flatten="true">
                    <p151v.VDraweeView
                        android:id="@+id/upload_img"
                        android:background="@drawable/core_verification_age_upload_img_placeholder"
                        android:layout_width="192dp"
                        android:layout_height="144dp"
                        app:actualImageScaleType="centerCrop"
                        app:roundedCornerRadius="8dp"/>
                    <p151v.VImage
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/ic_upload_img"
                        android:background="0x7f080939"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="46dp"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#ff4449"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_upload_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="79dp"
                        android:text="@string/AGE_CHECK_CLICK_TO_UPLOAD"/>
                    <p151v.VButton
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="bottom"
                        android:id="@+id/double_check1_select_again_btn"
                        android:background="@drawable/core_verification_age_reupload_btn"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/AGE_CHECK_DOUBLE_CHECK_STEP1_BUTTON_SELECT_AGAIN"/>
                </p151v.VFrame>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#7c7c7c"
                    android:gravity="center"
                    android:id="@+id/double_check1_tips"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/AGE_CHECK_DOUBLE_CHECK_STEP1_TIPS"/>
                <ViewStub
                    android:id="@+id/photo_guide_stub"
                    android:layout="@layout/verification_age_photo_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:id="@+id/check_double2_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="@string/AGE_CHECK_DOUBLE_CHECK_STEP2_TITLE"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#ff4449"
                    android:gravity="center"
                    android:id="@+id/check_double2_birthday"
                    android:background="@drawable/core_verification_age_birthday_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:id="@+id/check_double2_content"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/AGE_CHECK_DOUBLE_CHECK_STEP2_CONTENT"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/submit_suc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="153dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <p151v.VImage
                    android:background="0x7f08093e"
                    android:layout_width="142dp"
                    android:layout_height="82dp"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="#212121"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/AGE_CHECK_SUBMIT_SUCCEED_TITLE"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/AGE_CHECK_SUBMIT_SUCCEED_CONTENT"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:id="@+id/submit_btn_c"
        android:background="@drawable/core_verification_age_submit_btn_c_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        flatten="true">
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/submit_btn"
            android:background="@drawable/core_verification_age_upload_btn_bg"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:text="@string/AGE_CHECK_BEFOR_SUBMIT_BUTTON"/>
    </p151v.VFrame>
</p151v.VFrame>
