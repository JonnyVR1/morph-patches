<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.LiveGiftTrayView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_tray"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="80dp"
    flatten="true"
    folder="view"
    holder="LiveGiftTrayView">
    <include
        android:id="@+id/tray_bg"
        android:layout_width="230dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_gift_tray_bg"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tray_bg"
        app:layout_constraintLeft_toLeftOf="@+id/tray_bg"
        app:layout_constraintTop_toTopOf="@+id/tray_bg"/>
    <p151v.VDraweeView
        android:id="@+id/avatar_tag"
        android:layout_width="38dp"
        android:layout_height="12dp"
        android:layout_marginTop="32dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        app:placeholderImageScaleType="fitXY"/>
    <com.p051p1.mobile.putong.live.livingroom.royal.LiveGradientTextView
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/gift_text"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toLeftOf="@+id/gift_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/gift_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/user_name"
        app:layout_constraintRight_toRightOf="@+id/user_name"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <p151v.VDraweeView
        android:id="@+id/gift_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="138dp"
        app:actualImageScaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/tray_bg"
        app:layout_constraintLeft_toLeftOf="@+id/tray_bg"
        app:layout_constraintTop_toTopOf="@+id/tray_bg"
        app:placeholderImage="0x7f0822c4"/>
    <p151v.VImage
        android:id="@+id/named_bg"
        android:layout_width="33dp"
        android:layout_height="14dp"
        android:src="0x7f0822d9"
        app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
        app:layout_constraintEnd_toEndOf="@+id/gift_icon"
        app:layout_constraintStart_toStartOf="@+id/gift_icon"/>
    <p151v.VText
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/live_ffe981"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/named_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1.5dp"
        android:maxWidth="30dp"
        android:text="@string/LIVE_GIFT_NAMED_TEXT"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/named_bg"
        app:layout_constraintEnd_toEndOf="@+id/named_bg"
        app:layout_constraintStart_toStartOf="@+id/named_bg"
        app:layout_constraintTop_toTopOf="@+id/named_bg"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/comboLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tray_bg"
        app:layout_constraintLeft_toRightOf="@+id/gift_icon"
        app:layout_constraintTop_toTopOf="@+id/tray_bg"
        flatten="true">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/combo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_GIFT_TRAY_COMBO_X"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/white"
            android:id="@+id/comboNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/granule"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="@+id/tray_bg"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/reward_anim"
        android:layout_width="180dp"
        android:layout_height="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="@+id/gift_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/contribute_tag"
        android:layout_width="44dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
        app:layout_constraintLeft_toLeftOf="@+id/gift_icon"
        app:layout_constraintRight_toRightOf="@+id/gift_icon"/>
</com.p051p1.mobile.putong.live.livingroom.view.LiveGiftTrayView>
