<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="18sp"
            android:textColor="#cc000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/FROM_RISK_USER_ALERT_TITLE"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/button"
            android:background="@drawable/common_button_btn_gray_small"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/FROM_RISK_NOTICE_POPUP_BTN"/>
    </p151v.VLinear>
</p151v.VLinear>
