<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="account.AccountProtocolActViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#66000000"
        android:id="@+id/tv_protocol_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="3dp"
        android:text="请确认您的账号注销条件"
        android:singleLine="true"
        android:layout_below="@+id/navigation_bar"/>
    <p151v.VRecyclerView
        android:id="@+id/rl_protocol"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_confirm_layout"
        android:layout_below="@+id/tv_protocol_tip"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/ll_confirm_layout"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        android:layout_alignParentBottom="true">
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_protocol_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp">
            <p151v.VCheckBox
                android:id="@+id/privacy_check"
                style="@style/common_checkbox"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#33000000"
                android:id="@+id/tv_protocol_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginBottom="4dp"
                android:text="我已阅读并同意《探探注销账户须知》"/>
        </p151v.VLinear>
        <p151v.VButton
            android:id="@+id/btn_cancel_log_out"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="20dp"
            android:text="取消注销"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#66000000"
            android:layout_gravity="center"
            android:id="@+id/tv_confirm_log_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="确定注销"/>
    </p151v.VLinear>
</p151v.VRelative>
