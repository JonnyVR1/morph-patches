<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.youthvip.view.YouthVipBasePrivilegeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/core_youth_vip_locaton_item_bg"
    android:layout_width="match_parent"
    android:layout_height="231dp"
    flatten="true"
    folder="newui"
    holder="youthvip.view.YouthVipBasePrivilegeView">
    <p151v.VDraweeView
        android:layout_gravity="end"
        android:id="@+id/texture"
        android:layout_width="171dp"
        android:layout_height="231dp"
        app:actualImageScaleType="fitXY"
        app:roundedCornerRadius="10dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="3dp"
            android:maxLines="1"/>
        <ImageView
            android:id="@+id/model_icon"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/go_btn"
            android:background="@drawable/core_bg_white_r10"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="26dp"
            android:maxLines="1"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.youthvip.view.YouthVipBasePrivilegeView>
