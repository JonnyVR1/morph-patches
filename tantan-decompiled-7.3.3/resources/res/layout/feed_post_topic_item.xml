<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:background="@drawable/feed_post_bg_topic_rect_rounded"
    android:paddingRight="14dp"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    folder="newui"
    holder="topic.topiclist.NewPostTopicItemView">
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/activity_txt"
        android:background="@drawable/feed_post_bg_activity_topic"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="8dp"
        android:text="#活动"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/feed_post_tv_topic_item_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/selected_topic"
        android:paddingLeft="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/anonymous_txt"
        android:background="@drawable/feed_post_bg_anonymous_topic"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        android:text="匿名"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/activity_line"
        android:background="@color/feed_0D000000"
        android:visibility="gone"
        android:layout_width="1.5dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/activity_info_ic"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        android:src="0x7f081c4f"
        android:scaleType="fitXY"/>
</p151v.VLinear>
