<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="preview.forward.ForwardVideoMomentActViewModel">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/bottom_sheet_behavior_container"
            android:background="@drawable/feed_dialog_bottom_to_top_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:behavior_hideable="true"
            app:behavior_peekHeight="204dp"
            app:layout_behavior="@string/bottom_sheet_behavior"
            flatten="true">
            <View
                android:layout_gravity="center_horizontal"
                android:background="@drawable/feed_rounded_dialog_indicator"
                android:layout_width="37dp"
                android:layout_height="5dp"
                android:layout_marginTop="15dp"/>
            <RelativeLayout
                android:background="@drawable/feed_bg_rounded_f9f9f9"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="20dp">
                <p151v.VEditText
                    android:textSize="14sp"
                    android:textColor="@color/feed_cc000000"
                    android:textColorHint="@color/feed_26000000"
                    android:gravity="start"
                    android:id="@+id/edit_text"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="说说你的看法..."
                    android:maxLength="180"/>
            </RelativeLayout>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/feed_4d000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="转发视频不会展示在你的个人主页"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp">
                <p151v.VCheckBox
                    android:id="@+id/check_box"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    style="@style/common_checkbox"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/feed_4d000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:text="同时评论"
                    android:layout_toRightOf="@+id/check_box"
                    android:layout_centerVertical="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/feed_fe7e1d"
                    android:id="@+id/send_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="转发"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </p151v.VLinear>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <View
        android:id="@+id/adjustKeyboard"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</p151v.VLinear>
