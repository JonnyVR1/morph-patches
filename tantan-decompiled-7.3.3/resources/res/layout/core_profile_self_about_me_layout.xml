<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/self_about_me"
    android:background="@color/white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileAboutMeItemHolder">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/common_black_02"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/PROFILE_PERSONAL_INFO_ABOUT_ME"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/common_grey_09"
                android:layout_gravity="center_vertical"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowView
                android:id="@+id/tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VRecyclerView
                android:orientation="horizontal"
                android:id="@+id/photo_list"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <include
                android:id="@+id/photo_error_info"
                android:visibility="gone"
                flatten="true"
                layout="@layout/core_profile_self_about_me_photo_error_info"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/bubble_container"
            android:background="@color/transparent"
            android:visibility="visible"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</p151v.VLinear_Dividers>
