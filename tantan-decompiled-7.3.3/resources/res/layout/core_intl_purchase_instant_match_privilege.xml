<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="purchase.intlInstantChat.InstantMatchPrivilegeComponent">
    <p151v.AutoVDraweeView
        android:id="@+id/remote_purchase_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="fitXY"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomEnd="false"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="20dp"/>
    <p151v.VImage
        android:id="@+id/image_purchase"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VRelative
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/image_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="3dp"
            android:src="0x7f080a79"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true"/>
    </p151v.VRelative>
    <p151v.VImage
        android:id="@+id/image_feature"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="22dp"
        android:scaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_view"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/feature_name_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/image_feature"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#4d000000"
        android:gravity="center"
        android:id="@+id/promotional_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/feature_name_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
