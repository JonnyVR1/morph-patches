<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="verification.CertificationCenterViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VScroll
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/certification_tip_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <p151v.VImage
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:src="0x7f0806b0"
                    android:layout_marginStart="12dp"
                    android:layout_marginVertical="12dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#4d000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="认证收集信息仅用于系统对比，不会向外展示"
                    android:layout_marginStart="4dp"/>
            </p151v.VLinear>
            <include
                android:id="@+id/avatar_container"
                layout="@layout/core_certification_avatar"/>
            <include
                android:id="@+id/identify_container"
                layout="@layout/core_certification_identity"/>
            <include
                android:id="@+id/student_container"
                layout="@layout/core_certification_student"/>
            <include
                android:id="@+id/ctdid_container"
                layout="@layout/core_certification_ctdid"/>
        </p151v.VLinear>
    </p151v.VScroll>
</p151v.VLinear>
