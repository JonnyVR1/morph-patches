<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.meet.likers.items.MeetLikersNewLikersItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    folder="newui"
    holder="meet.likers.items.MeetLikersNewLikersItem">
    <p151v.VFrame
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundAsCircle="true"/>
        <p151v.VIcon
            android:layout_gravity="bottom|right"
            android:id="@+id/icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginBottom="2dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="2dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="5dp"
        android:lines="1"/>
</com.p051p1.mobile.putong.core.newui.meet.likers.items.MeetLikersNewLikersItem>
