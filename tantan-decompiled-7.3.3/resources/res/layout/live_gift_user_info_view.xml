<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftUserInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    app:bind_extends="ConstraintLayout"
    app:binding="true">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/sp_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_iv_head,live_tv_name"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/live_iv_head"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:id="@+id/live_tv_name"
        android:layout_width="117dp"
        android:layout_height="wrap_content"
        android:maxEms="6"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_iv_head"
        app:layout_constraintStart_toEndOf="@+id/live_iv_head"
        app:layout_constraintTop_toTopOf="@+id/live_iv_head"/>
    <ImageView
        android:id="@+id/live_indicator"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="0x7f0822cf"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_iv_head"
        app:layout_constraintLeft_toRightOf="@+id/live_tv_name"
        app:layout_constraintTop_toTopOf="@+id/live_iv_head"/>
    <View
        android:id="@+id/user"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_iv_head"
        app:layout_constraintEnd_toEndOf="@+id/live_indicator"
        app:layout_constraintStart_toStartOf="@+id/live_iv_head"
        app:layout_constraintTop_toTopOf="@+id/live_iv_head"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="center"
        android:id="@+id/tv_user_info"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="@string/LIVE_USER_INFO"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_iv_head"
        app:layout_constraintEnd_toStartOf="@+id/tv_contribute"
        app:layout_constraintTop_toTopOf="@+id/live_iv_head"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_contribute"
        android:paddingLeft="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="@string/LIVE_CONTRIBUTE"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_iv_head"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/live_iv_head"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.view.GiftUserInfoView>
