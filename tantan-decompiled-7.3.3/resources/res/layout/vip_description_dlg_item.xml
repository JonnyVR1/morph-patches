<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.result.VipContentDlgItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="result.VipContentDlgItemView">
    <p151v.VText
        android:textSize="20sp"
        android:textColor="#4a4a4a"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ff5435"
        android:layout_gravity="center_horizontal"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/content_bg"
        android:layout_width="331dp"
        android:layout_height="290dp"
        android:layout_marginTop="8dp">
        <p151v.VDraweeView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_fresco_base"/>
        <p151v.VRelative
            android:layout_gravity="center"
            android:id="@+id/badge"
            android:background="0x7f08029e"
            android:layout_width="210dp"
            android:layout_height="280dp">
            <p151v.VDraweeView
                android:id="@+id/badge_avatar"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"
                app:roundedCornerRadius="5dp"/>
            <FrameLayout
                android:paddingBottom="7dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/badge_avatar">
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VLinear_FillerMeasure
                        android:id="@+id/userinfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fillerIndex="0"
                        flatten="true">
                        <p151v.VText
                            android:textSize="15sp"
                            android:textColor="#db5c48"
                            android:ellipsize="end"
                            android:id="@+id/name"
                            android:paddingRight="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"/>
                        <p151v.VImage
                            android:id="@+id/vip_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_toRightOf="@+id/name"
                            app:srcCompat="@drawable/vip_status_vip"/>
                    </p151v.VLinear_FillerMeasure>
                    <View
                        android:id="@+id/icon_1"
                        android:background="@drawable/icon_privilege_badge_rec"
                        android:layout_width="20dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="7dp"
                        android:layout_below="@+id/userinfo"/>
                    <View
                        android:id="@+id/icon_2"
                        android:background="@drawable/icon_privilege_badge_rec"
                        android:layout_width="20dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="7dp"
                        android:layout_toRightOf="@+id/icon_1"
                        android:layout_below="@+id/userinfo"/>
                </RelativeLayout>
            </FrameLayout>
        </p151v.VRelative>
        <p151v.VFrame
            android:layout_gravity="center"
            android:id="@+id/location"
            android:background="0x7f080269"
            android:visibility="gone"
            android:layout_width="210dp"
            android:layout_height="280dp">
            <p151v.VFrame
                android:layout_gravity="center"
                android:id="@+id/location_avatar_bg"
                android:background="0x7f080268"
                android:layout_width="92dp"
                android:layout_height="98dp"
                android:layout_marginLeft="-10dp"
                android:layout_marginTop="-10dp"
                flatten="true">
                <p151v.AutoVDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/location_avatar"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    style="@style/core_fresco_profile_small"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/location_content_bg"
                android:background="0x7f08028c"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="17dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/location_icon"
                    android:layout_width="14dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:src="0x7f08203d"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/BEIJING_CITY"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/SETTINGS_LOCATION_TYPE_ROAMING"
                        android:singleLine="true"/>
                </p151v.VLinear>
            </p151v.VLinear>
        </p151v.VFrame>
        <p151v.VFrame
            android:layout_gravity="center"
            android:id="@+id/content"
            android:layout_width="210dp"
            android:layout_height="280dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_grey_03"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:lines="3"/>
</com.p051p1.mobile.putong.core.p058ui.result.VipContentDlgItemView>
