<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_tr24"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true"
    app:flatten="true">
    <include
        android:id="@+id/connection_icon_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_multi_call_connection_icon_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/apply_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/LIVE_MULTI_CALL_APPLY_TITLE"
        android:fontFamily="PingFangSC-Medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/connection_icon_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/voice_call"
        android:background="@drawable/live_bg_ff8817_r16"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:text="@string/LIVE_MULTI_CALL_VOICE_CALL"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/video_call"
        app:layout_constraintTop_toBottomOf="@+id/apply_title"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/video_call"
        android:background="@drawable/live_bg_f83899_r16"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="9dp"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_MULTI_CALL_VIDEO_CALL"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/voice_call"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_call"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/apply_join"
        android:background="@drawable/live_bg_white_r16_a10"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_MULTI_CALL_CONFIRM_JOIN"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/apply_title"/>
    <View
        android:layout_width="1dp"
        android:layout_height="33dp"
        android:layout_marginTop="90dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/apply_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
