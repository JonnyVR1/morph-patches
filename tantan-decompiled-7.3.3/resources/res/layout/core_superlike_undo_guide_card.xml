<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.home.virtualcard.SuperLikeOrUndoGuideCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    holder="home.virtualcard.SuperLikeOrUndoGuideCardView">
    <View
        android:id="@+id/card_bg"
        android:background="0x7f0812f1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sunshine.engine.bone.StageView
        android:id="@+id/stage_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="188dp"
            android:layout_height="188dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="21sp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/guide_title"
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:layout_marginTop="34dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/guide_desc"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginTop="4dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#54c7fc"
            android:gravity="center"
            android:id="@+id/button"
            android:background="@drawable/core_guide_card_btn_bg"
            android:layout_width="247dp"
            android:layout_height="56dp"
            android:layout_marginTop="35dp"
            android:text="好的"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.home.virtualcard.SuperLikeOrUndoGuideCardView>
