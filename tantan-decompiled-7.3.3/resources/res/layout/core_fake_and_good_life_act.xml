<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/common_handlebar_bg"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f080898"
            android:scaleType="centerInside"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
        <p151v.VImage
            android:id="@+id/tip"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="48dp"
            android:src="0x7f0818a3"
            android:layout_marginStart="40dp"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/core_color_80percent_000000"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/GUIDE_UPLOAD_PHOTO_TITLE"
            android:maxLines="3"
            android:layout_below="@+id/tip"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:background="@color/white"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="120dp"
            android:layout_below="@+id/title"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp">
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:id="@+id/avatar_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VDraweeView
                        android:id="@+id/avatar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:roundedCornerRadius="100dp"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/core_color_66000000"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/received_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"/>
                </p151v.VLinear>
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/avatar_layout"/>
                <p151v.VPagerCircleIndicator
                    android:id="@+id/viewpager_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_below="@+id/viewpager"
                    app:centered="true"
                    app:fillColor="@color/common_orange"
                    app:pageColor="#0c000000"
                    app:radius="4dp"/>
            </p151v.VLinear>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <p151v.VText
            android:textColor="@color/white"
            android:id="@+id/change"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_marginBottom="32dp"
            android:text="@string/GUIDE_UPLOAD_PHOTO_BUTTON"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:typeface="medium"
            style="@style/common_button_large"/>
    </RelativeLayout>
</RelativeLayout>
