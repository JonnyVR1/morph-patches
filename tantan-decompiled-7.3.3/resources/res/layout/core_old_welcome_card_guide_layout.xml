<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_poi_card_send_greeting_view_bg"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <p151v.VDraweeView
        android:id="@+id/first_user_img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <View
        android:background="@drawable/core_oof_card_guide_bg"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="38dp"/>
    <p151v.VDraweeView
        android:id="@+id/second_user_img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="41dp"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <View
        android:background="@drawable/core_oof_card_guide_bg"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="63dp"/>
    <p151v.VDraweeView
        android:id="@+id/third_user_img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="66dp"
        fresco:actualImageScaleType="centerCrop"
        fresco:roundAsCircle="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/send"
        android:background="@drawable/common_button_btn_orange_small"
        android:layout_width="53dp"
        android:layout_height="34dp"
        android:text="欢迎"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:id="@+id/content_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:layout_toStartOf="@+id/send"
        android:layout_toEndOf="@+id/third_user_img"/>
</RelativeLayout>
