<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/head_root"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    flatten="true"
    holder="messages.model.inner.MessageUserHeaderViewModel">
    <p151v.VProgressBar
        android:layout_gravity="center"
        android:id="@+id/header_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        app:cpb_colors="@array/core_loading_colors"/>
    <FrameLayout
        android:id="@+id/default_header_content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/self_introduction"
            android:paddingTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            flatten="true">
            <include
                android:id="@+id/match_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="4dp"
                layout="@layout/core_message_header_match_time_layout"/>
            <include
                android:id="@+id/date_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                layout="@layout/messages_item_date_header"/>
            <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageUserHeaderLayout
                android:orientation="horizontal"
                android:id="@+id/message_user_header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:orientation="vertical"
                android:id="@+id/message_know_him_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                layout="@layout/core_message_know_him_info_layout"/>
            <include
                android:id="@+id/marry_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"
                layout="@layout/core_message_header_marry_layout"/>
            <ViewStub
                android:id="@+id/online_match_head_new_new_ui"
                android:layout="@layout/core_new_onlinematch_new_ui_msg_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ViewStub
                android:id="@+id/male_chat_guide"
                android:layout="@layout/core_male_chat_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"/>
            <ViewStub
                android:id="@+id/love_buzz_head_new"
                android:layout="@layout/core_intl_love_buzz_msg_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:id="@+id/message_read_state_tip_gp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="54dp"
                android:layout_marginTop="5dp"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/message_read_state_tip_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                flatten="true">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CORE_SVIP_READ_MESSAGE_REMIND_TITLE"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/message_read_state_tip"
                    android:background="0x7f080505"
                    android:paddingLeft="15dp"
                    android:paddingTop="6dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/CORE_SVIP_READ_MESSAGE_REMIND_SUBTITLE"
                    android:drawableLeft="0x7f082015"
                    android:drawablePadding="3dp"/>
            </LinearLayout>
            <p151v.VText
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/svip_match_from_boost"
                android:background="@drawable/core_messages_message_date_header"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/SVIP_MATCH_FROM_BOOST"
                app:typeface="regular"
                style="@style/core_messages_date_header"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/layout_block_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="57dp"
                android:layout_marginBottom="18dp">
                <include layout="@layout/intl_messages_block_hint"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/layout_block_hint_opt"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="57dp"
                android:layout_marginBottom="18dp">
                <include layout="@layout/core_messages_block_hint_opt"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_block_vip_pass"
                android:background="@drawable/core_chat_block_pass_bg"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="57dp"
                android:layout_marginBottom="18dp">
                <p151v.VImage
                    android:id="@+id/vip_badge"
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:src="0x7f0819ab"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#af7814"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/MESSAGE_LIMITED_NEW_VIP_NOTICE"/>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/see_letter_layout"
                android:background="@drawable/core_theme_profile_gerrt_match_bg"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="57dp"
                android:layout_marginBottom="18dp">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_gravity="center"
                    android:id="@+id/see_letter_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/female_chat_guide_notice"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:minHeight="24dp"
                android:lineSpacingExtra="12sp"
                android:layout_marginStart="58dp"
                android:layout_marginEnd="58dp"/>
            <ViewStub
                android:id="@+id/female_chat_guide_exp1"
                android:layout="@layout/core_female_chat_guide_exp1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="58dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="58dp"/>
            <ViewStub
                android:id="@+id/female_chat_guide_exp2"
                android:layout="@layout/core_female_chat_guide_exp2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="58dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="58dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#4c000000"
                android:gravity="center"
                android:id="@+id/tv_know_label"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="测测社交性格，帮你匹配最契合的伙伴！\10立即测试"
                android:lineHeight="18dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#4c000000"
                android:gravity="center"
                android:id="@+id/o_diamond_visitor_guide"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="她疯狂访问了你245次 \10最近一次访问时间为2024年5月23日12:30"
                android:lineHeight="18dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
