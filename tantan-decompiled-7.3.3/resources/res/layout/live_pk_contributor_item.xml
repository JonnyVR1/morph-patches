<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.ContributorItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="recreation"
    holder="pk.view.ContributorItemView">
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/rank"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="0x7f08245e"/>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/ring"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5.5dp"
        android:layout_marginBottom="4.5dp"
        android:src="@drawable/live_shape_pk_contribution_host_ring"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="6.5dp"
        android:layout_marginBottom="5.5dp">
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            fresco:actualImageScaleType="centerInside"
            fresco:failureImage="@drawable/live_vector_default_avatar_bg"
            fresco:failureImageScaleType="centerInside"
            fresco:placeholderImage="0x7f08245f"
            fresco:roundAsCircle="true"
            fresco:roundingBorderColor="#fff"
            fresco:roundingBorderWidth="0dp"/>
        <View
            android:id="@+id/gray"
            android:background="@drawable/live_shape_pk_contributor_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/mvp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:src="0x7f082407"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.ContributorItemView>
