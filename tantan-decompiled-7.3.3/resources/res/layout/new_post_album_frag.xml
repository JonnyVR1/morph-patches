<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="mediapicker.NewPostAlbumFrag">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VRecyclerView
            android:id="@+id/photo_recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/tool_bar"
        android:background="0x7f081e35"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:gravity="center_vertical"
            android:id="@+id/title_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/IMAGE_ALBUM_TITLE"/>
        <ImageView
            android:id="@+id/title_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            app:srcCompat="0x7f081e5d"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/no_permission"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="56dp"
            app:srcCompat="0x7f081d35"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/feed_33000000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/FEED_POST_ALBUM_OPEN_PERMISSION"
            android:maxLines="3"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_open_permission_confirm"
            android:background="@drawable/feed_open_permission_confirm_bg"
            android:paddingLeft="22dp"
            android:paddingTop="10dp"
            android:paddingRight="22dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/FEED_POST_ALBUM_OPEN_PERMISSION_CONFIRM"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
