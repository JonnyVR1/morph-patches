<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/content_top_frame"
    android:background="@drawable/background_faq"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="helpcenter.HelpCenterFrag">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"
        app:title="@string/HELP_CENTER_HOME_TITLE"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="192dp">
        <p151v.VText
            android:id="@+id/space"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"/>
        <p151v.VText
            android:textSize="28sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="@string/HELP_CENTER_WE_ARE_HERE_TO_HELP"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/text_white"
            android:gravity="center"
            android:id="@+id/status_tips"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"
            android:text="@string/HELP_CENTER_YOUR_ACCOUNT_STATUS"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/text_white"
            android:gravity="center"
            android:id="@+id/status"
            android:background="@drawable/help_status_green"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="invisible"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            app:typeface="medium"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#8a8a8a"
        android:gravity="center"
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/LANDING_TANTAN"
        app:typeface="regular"/>
</p151v.VLinear>
