<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/core_color_60percent_000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="dlg.SurpriseBoxDialogV2">
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svga_box"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="5dp"
        android:scaleType="centerCrop"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/toplight"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="433dp"
        android:scaleType="centerCrop"
        android:alpha="0"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="205dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="20sp"
            android:textColor="@color/common_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/surprise_box_title"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="惊喜礼盒免费领取"
            android:alpha="0"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_50percent_FFFFFF"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/surprise_box_desc"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="8dp"
            android:text="为你精选一份交友神器助你畅聊"
            android:alpha="0"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/close"
        android:background="0x7f0817b5"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="127dp"/>
</FrameLayout>
