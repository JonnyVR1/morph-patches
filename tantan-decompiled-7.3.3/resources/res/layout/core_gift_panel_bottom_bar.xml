<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.opt.view.GiftPanelBottomBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    holder="gift.opt.view.GiftPanelBottomBar">
    <p151v.VPagerCircleIndicator
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fillColor="#ff8817"
        app:pageColor="#1a000000"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ff8817"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/charge"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="充值"
        android:drawablePadding="1dp"
        android:drawableEnd="0x7f0808b3"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.gift.opt.view.GiftPanelBottomBar>
