<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_group_view"
    android:background="@drawable/feed_post_guide_one_bg"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.postguide.FeedPostGuideTwoView">
    <p151v.VDraweeView
        android:id="@+id/post_iv"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="12dp"
        android:layout_centerVertical="true"
        app:roundAsCircle="false"
        app:roundedCornerRadius="10dp"
        style="@style/feed_fresco_profile_small"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/post_feed_tv"
        android:background="@drawable/feed_bg_rounded_fe7e1d"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:maxWidth="100dp"
        android:text="去发布"
        android:maxLines="1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/post_guide_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/post_feed_tv"
        android:layout_toRightOf="@+id/post_iv"
        android:layout_centerVertical="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布动态认识更多新朋友"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:id="@+id/post_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="配对成功的概率提升66%"
            android:singleLine="true"/>
    </p151v.VLinear>
</p151v.VRelative>
