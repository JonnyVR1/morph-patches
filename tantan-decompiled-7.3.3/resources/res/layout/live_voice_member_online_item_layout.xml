<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.membermanager.online.MemberOnLineItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="voice.membermanager.online"
    holder="MemberOnLineItemView">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonAnimMaskAvatarView
        android:id="@+id/user_icon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.royal.LiveGradientTextView
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/user_sex"
        app:layout_constraintEnd_toStartOf="@+id/right_desc"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/user_sex"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintEnd_toStartOf="@+id/user_tag"
        app:layout_constraintStart_toStartOf="@+id/user_name"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/user_tag"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_sex"
        app:layout_constraintStart_toEndOf="@+id/user_sex"
        app:layout_constraintTop_toTopOf="@+id/user_sex"/>
    <p151v.VDraweeView
        android:id="@+id/level"
        android:layout_width="30dp"
        android:layout_height="14dp"
        android:layout_marginLeft="6dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/user_tag"
        app:layout_constraintStart_toEndOf="@+id/user_tag"
        app:layout_constraintTop_toTopOf="@+id/user_tag"/>
    <p151v.VDraweeView
        android:id="@+id/starlight"
        android:layout_width="30dp"
        android:layout_height="14dp"
        android:layout_marginLeft="6dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/level"
        app:layout_constraintStart_toEndOf="@+id/level"
        app:layout_constraintTop_toTopOf="@+id/level"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@drawable/live_selector_voice_ktv_choose_song_bt_text_color"
        android:gravity="center"
        android:id="@+id/right_desc"
        android:background="@drawable/live_selector_voice_ktv_choose_song_bt"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.membermanager.online.MemberOnLineItemView>
