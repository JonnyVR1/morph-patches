<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"
        app:title="@string/HELP_CENTER_HOME_TITLE"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/center_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</p151v.VLinear>
