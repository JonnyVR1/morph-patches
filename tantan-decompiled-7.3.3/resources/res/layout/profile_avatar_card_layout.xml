<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.photo.AvatarCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="profile.photo.AvatarCard">
    <p151v.VFrame
        android:id="@+id/frame"
        android:background="@drawable/core_profile_media_record_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="9dp"
        android:layout_marginEnd="10dp"
        flatten="false"
        style="@style/core_fresco_base">
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/tip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            flatten="false">
            <p151v.VImage
                android:layout_gravity="center_horizontal"
                android:id="@+id/tip_img"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_33000000"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tip_text"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="10dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/core_color_33000000"
                android:gravity="center"
                android:id="@+id/tip_integrity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </p151v.VLinear>
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="8dp"
            style="@style/core_fresco_base"/>
        <View
            android:id="@+id/mask"
            android:background="#80ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <p151v.VImage
            android:layout_gravity="end|bottom"
            android:id="@+id/icon_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/core_crop_pic_delete"
            android:scaleType="fitXY"
            android:layout_marginEnd="8dp"/>
        <p151v.VImage
            android:layout_gravity="bottom"
            android:id="@+id/icon_video"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="8dp"
            android:src="0x7f081187"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/icon_illegal"
            android:background="@drawable/core_profile_recorder_card_illegal_bg"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:text="@string/HIGH_RISH_MESSAGE_BLOCK_TIP"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"/>
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/top_left_icon"
            android:background="@drawable/core_bg_6_66000000"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:text="首图"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="30dp"
            android:paddingHorizontal="8dp"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tag"
            android:background="@drawable/core_bg_6_ffffff"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:layout_marginHorizontal="6dp"
            android:paddingHorizontal="8dp"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="#fffe7e1d"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/add_tag"
            android:background="@drawable/core_bg_6_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:text="添加标签"
            android:maxLines="1"
            android:drawableLeft="@drawable/core_profile_add_tag_icon"
            android:drawablePadding="2dp"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:layout_marginHorizontal="6dp"
            app:fontWeight="500"/>
        <p151v.VFrame_Anim
            android:layout_gravity="center"
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/failure"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/core_profile_edit_error"
                android:scaleType="fitXY"/>
            <p151v.VProgressBar
                android:layout_gravity="center"
                android:id="@+id/uploading"
                android:visibility="invisible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateOnly="true"
                app:cpb_color="@color/tantan_orange"
                app:cpb_stroke_percentage="0.1"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/success"
                android:visibility="invisible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f082971"/>
        </p151v.VFrame_Anim>
        <p151v.VText
            android:textSize="80sp"
            android:textColor="@color/red"
            android:layout_gravity="center"
            android:id="@+id/test_position"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.profile.photo.AvatarCard>
