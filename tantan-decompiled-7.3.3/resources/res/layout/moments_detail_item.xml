<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.moments.CommentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/moments_feed_comment_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="moments.CommentView">
    <FrameLayout
        android:id="@+id/item"
        android:background="@drawable/tf_rect_light"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/profile"
            android:layout_width="@dimen/moments_like_comment_profile_size"
            android:layout_height="@dimen/moments_like_comment_profile_size"
            android:layout_marginLeft="22dp"
            style="@style/feed_fresco_profile_small"/>
        <p151v.VImage
            android:id="@+id/verification_icon"
            android:background="0x7f081e18"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="16dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/text_medium"
            android:ellipsize="end"
            android:id="@+id/comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="68dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="35dp"/>
        <include
            android:layout_gravity="center"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="14dp"
            layout="@layout/feed_messages_sending_or_error"/>
    </FrameLayout>
    <View
        android:id="@+id/item_divider"
        android:background="@color/moment_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="72dp"/>
    <FrameLayout
        android:id="@+id/load_more_group"
        android:background="@drawable/tf_rect_light"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <View
            android:background="@color/moment_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_nice_blue_01"
            android:gravity="center"
            android:id="@+id/load_more"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </FrameLayout>
    <include
        android:visibility="gone"
        layout="@layout/moments_item_divider"/>
</com.p051p1.mobile.putong.feed.p065ui.moments.CommentView>
