<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemPictureTextLeft xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="?attr/message_bubble_bg_left"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemPictureTextLeft">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.AutoVDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="210dp"
            android:layout_height="210dp"/>
        <p151v.AutoVDraweeView
            android:id="@+id/image_2"
            android:visibility="gone"
            android:layout_width="108dp"
            android:layout_height="165dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/other_infos"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:autoLink="web"
            android:id="@+id/text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="3"
            android:lineSpacingExtra="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/button"
            android:background="@drawable/core_message_action_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#27000000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cancel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="2sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemPictureTextLeft>
