<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.liveend.VoiceEndFireListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:layout_marginTop="11dp"
    android:layout_marginBottom="5dp"
    folder="voice.intl.liveend"
    holder="VoiceEndFireListItemView">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="16dp"
        style="@style/live_fresco_profile_small"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/nickname"
        android:layout_width="146dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:layout_toRightOf="@+id/avatar"
        tools:text="AL Doris"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="normal"
        android:textColor="#99ffffff"
        android:id="@+id/time"
        android:layout_width="146dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:layout_toRightOf="@+id/avatar"
        android:layout_below="@+id/nickname"
        android:lineSpacingExtra="0sp"
        tools:text="陪伴5分钟"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/notice_status"
        android:background="@drawable/live_bg_white_r12_a05"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        tools:text="回关"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.liveend.VoiceEndFireListItemView>
