<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.SayHiBubbleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <p151v.VDraweeView
        android:id="@+id/live_greeting_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_5fbaff"
        android:gravity="start|center_vertical"
        android:id="@+id/live_greeting_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="start|center_vertical"
        android:id="@+id/live_greeting_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
    <p151v.VButton
        android:textSize="11sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/live_greeting_btn"
        android:background="@drawable/live_bg_fe7e1d_r6"
        android:paddingTop="4dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="7dp"/>
</com.p051p1.mobile.putong.live.livingroom.view.SayHiBubbleView>
