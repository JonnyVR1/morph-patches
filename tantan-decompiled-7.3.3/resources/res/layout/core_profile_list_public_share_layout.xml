<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shareId"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="profile.profilelist.itemholders.ProfileShareIdItemHolder">
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#fe7e1d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="推荐"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#fe7e1d"
            android:ellipsize="end"
            android:id="@+id/tv_share_usename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:maxWidth="144dp"
            android:text="Vavo Lin1111"
            android:singleLine="true"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#fe7e1d"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="给好友"
            android:singleLine="true"
            android:maxLength="8"
            app:typeface="medium"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#fe7e1d"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_share_name_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="听听朋友们对ta的看法"
        android:singleLine="true"
        app:typeface="medium"/>
    <View
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>
</p151v.VLinear_Dividers>
