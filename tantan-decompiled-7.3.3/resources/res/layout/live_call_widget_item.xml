<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.CallWidgetItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="recreation"
    holder="multiplayerchat.view.CallWidgetItemView">
    <FrameLayout
        android:id="@+id/avatar_container"
        android:background="@drawable/live_bg_white_oval_a20"
        android:layout_width="42dp"
        android:layout_height="42dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            fresco:actualImageScaleType="centerCrop"
            fresco:failureImage="@drawable/live_vector_default_avatar_bg"
            fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
            fresco:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/live_bg_black_oval_a50"/>
        <p151v.VText
            android:textSize="8dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/index"
            android:background="@drawable/live_bg_434346_r3_a90"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="-2dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/close"
            android:background="0x7f082286"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="-2dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/state"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/add"
            android:padding="5dp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="0x7f082252"/>
        <View
            android:id="@+id/voice_bg"
            android:background="@drawable/live_shape_call_voice_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/iv_voice"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="8dp"
            android:layout_marginBottom="7dp"/>
    </FrameLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#f3c906"
        android:gravity="center"
        android:id="@+id/point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:maxLines="1"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiplayerchat.view.CallWidgetItemView>
