<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_call_root"
    android:background="0x7f080cf5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="lovebuzz.voice.call.VoiceBuzzCallViewModel">
    <p151v.VImage
        android:id="@+id/vb_report"
        android:background="0x7f080cf8"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/vb_zoom"
        android:background="0x7f080cfa"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vb_report"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/vb_svg_bg"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vb_report"/>
    <p151v.VDraweeView
        android:id="@+id/vb_peer_avatar"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginStart="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/vb_svg_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vb_svg_bg"
        app:placeholderImage="0x7f080b0a"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderWidth="2dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/vb_peer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:maxEms="8"
        app:layout_constraintEnd_toEndOf="@+id/vb_peer_avatar"
        app:layout_constraintStart_toStartOf="@+id/vb_peer_avatar"
        app:layout_constraintTop_toBottomOf="@+id/vb_peer_avatar"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/vb_peer_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="8dp"
        app:layout_constraintEnd_toEndOf="@+id/vb_peer_avatar"
        app:layout_constraintStart_toStartOf="@+id/vb_peer_avatar"
        app:layout_constraintTop_toBottomOf="@+id/vb_peer_name"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/vb_peer_region"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toEndOf="@+id/vb_peer_info"
        app:layout_constraintStart_toStartOf="@+id/vb_peer_info"
        app:layout_constraintTop_toBottomOf="@+id/vb_peer_info"/>
    <p151v.VDraweeView
        android:id="@+id/vb_mee_avatar"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginEnd="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/vb_svg_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vb_svg_bg"
        app:placeholderImage="0x7f080b0a"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderWidth="2dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/vb_me_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/INTL_BUZZ_VOICE_CALLING_ME"
        app:layout_constraintEnd_toEndOf="@+id/vb_mee_avatar"
        app:layout_constraintStart_toStartOf="@+id/vb_mee_avatar"
        app:layout_constraintTop_toBottomOf="@+id/vb_mee_avatar"
        app:typeface="medium"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/vb_peer_tag_root"
        android:background="@drawable/core_intl_shape_voice_buzz_tags_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="94dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/vb_svg_bg">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_white_02"
            android:gravity="center"
            android:id="@+id/vb_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="8dp"
            android:layout_marginStart="20dp"
            app:layout_constraintEnd_toEndOf="@+id/vb_mee_avatar"
            app:layout_constraintStart_toStartOf="@+id/vb_mee_avatar"
            app:layout_constraintTop_toBottomOf="@+id/vb_mee_avatar"
            app:typeface="medium"/>
        <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.BuzzFlowTagsView
            android:id="@+id/tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_white_02"
        android:gravity="center"
        android:id="@+id/vb_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_BUZZ_VOICE_CALLING_INTRO"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_root"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:typeface="regular"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.LoveBuzzMatchView
        android:id="@+id/match_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/progress_root"
        android:background="@drawable/core_intl_shape_buzz_progress_bg"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/vb_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.p051p1.mobile.putong.core.p058ui.lovebuzz.widget.zebraprogress.ZebraProgress
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_progress"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:progress_background="@color/transparent"
            app:progress_max="100"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/countdown_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_root"
        app:layout_constraintEnd_toEndOf="@+id/progress_root"
        app:layout_constraintTop_toTopOf="@+id/progress_root"/>
    <com.p051p1.mobile.putong.core.p058ui.lovebuzz.voice.view.VoiceBuzzCallControlView
        android:id="@+id/vb_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
