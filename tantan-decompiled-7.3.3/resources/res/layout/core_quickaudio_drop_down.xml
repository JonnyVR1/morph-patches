<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#00ffffff"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="quickaudio.DropDownViewModel">
    <com.p051p1.mobile.putong.core.p058ui.quickaudio.view.TouchPullViewLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.quickaudio.view.DropDownBgView
            android:id="@+id/dropdown_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:id="@+id/header_img"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="128dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundingBorderWidth="4dp"
            style="@style/core_fresco_profile_white_border"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_scene_entry"
            android:background="@drawable/core_bg_scene_select"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="85dp"
            android:paddingHorizontal="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/header_img"
            flatten="true">
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="0x7f080982"
                android:layout_marginVertical="3dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#333232"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_scene_con"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加速卡"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
            <p151v.VImage
                android:id="@+id/img_scene_con"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080946"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.quickaudio.view.DropDownRadarView
            android:id="@+id/loading_view"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_marginBottom="128dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:normalMode="true"/>
        <com.p051p1.mobile.putong.core.p058ui.quickaudio.view.DropDownRadarView
            android:id="@+id/loading_img"
            android:visibility="gone"
            android:layout_width="640dp"
            android:layout_height="640dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:normalMode="false"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:id="@+id/loading_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="140dp"
            android:text="正在搜索语音匹配…"
            android:alpha="0.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="488dp"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_top_hey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp">
                <p151v.VImage
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f080927"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:id="@+id/tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="你又来看我啦"
                    style="@style/core_vip_normal_title_style"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="20sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_hey_loading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp"
                android:text="收获好感\10从介绍自己开始"/>
        </p151v.VFrame>
        <p151v.VImage
            android:id="@+id/close"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:layout_marginRight="16dp"
            android:src="0x7f080955"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/ll_btns"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="108dp"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_btns_online"
                android:background="@drawable/core_bg_drop_down_btn"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:paddingStart="20dp"
                android:layout_marginStart="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ll_btns_audio"
                flatten="true">
                <p151v.VImage
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:src="0x7f080957"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:id="@+id/tv_online"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="在线闪聊"
                    style="@style/core_vip_normal_title_style"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/core_vip_normal_subtitle_text_color"
                    android:id="@+id/tv_online_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="0sp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_btns_audio"
                android:background="@drawable/core_bg_drop_down_btn"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:paddingStart="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ll_btns_online"
                app:layout_constraintRight_toLeftOf="@+id/ll_btns_heartbeat"
                flatten="true">
                <p151v.VImage
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:src="0x7f080954"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:id="@+id/tv_quick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="语音闪聊"
                    style="@style/core_vip_normal_title_style"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/core_vip_normal_subtitle_text_color"
                    android:id="@+id/tv_quick_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:lineSpacingExtra="0sp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_btns_heartbeat"
                android:background="@drawable/core_bg_drop_down_btn"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:paddingStart="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ll_btns_audio"
                app:layout_constraintRight_toRightOf="parent"
                flatten="true">
                <p151v.VImage
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    app:srcCompat="@drawable/core_ic_drop_down_heartbeat"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:textColor="@color/common_black_02"
                    android:id="@+id/tv_heartbeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="@string/HEART_ENTRANCE_TITLE"
                    android:singleLine="true"
                    style="@style/core_vip_normal_title_style"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/core_vip_normal_subtitle_text_color"
                    android:id="@+id/tv_heartbeat_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/HEART_ENTRANCE_SUB_TITLE"
                    android:singleLine="true"
                    android:lineSpacingExtra="0sp"/>
            </p151v.VLinear>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_to_top"
            android:background="@drawable/core_bg_drop_down_totop"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true">
            <View
                android:layout_gravity="center_horizontal"
                android:background="@drawable/core_ic_drop_down_totop"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"/>
            <p151v.VText
                android:textSize="17sp"
                android:textColor="#33000000"
                android:gravity="center_horizontal"
                android:id="@+id/tv_to_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="回到消息"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/ll_scene"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true">
            <p151v.VHandleBar
                android:layout_width="match_parent"
                android:layout_height="28dp"/>
            <p151v.VLinear
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#b2b2b2"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用道具卡，畅享极致闪聊"
                    android:drawablePadding="8dp"
                    android:drawableStart="0x7f081330"
                    android:drawableEnd="0x7f081331"/>
                <p151v.VRelative
                    android:background="@drawable/core_bg_online_speed"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_margin="21dp">
                    <p151v.VImage
                        android:id="@+id/scene_ic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:src="0x7f080981"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="18dp"
                        android:layout_marginVertical="14dp"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@+id/scene_ic">
                        <p151v.VText
                            android:textSize="16sp"
                            android:textColor="@color/common_black_02"
                            android:id="@+id/scene_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="加速卡"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="#43c21f"
                            android:id="@+id/scene_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="当前剩余 3 次"
                            android:layout_below="@+id/scene_title"/>
                    </p151v.VLinear>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/scene_go"
                        android:background="@drawable/core_bg_online_speed_use"
                        android:paddingLeft="20dp"
                        android:paddingTop="10dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="20dp"
                        android:text="去使用"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"/>
                </p151v.VRelative>
            </p151v.VLinear>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.p058ui.quickaudio.view.TouchPullViewLayout>
</FrameLayout>
