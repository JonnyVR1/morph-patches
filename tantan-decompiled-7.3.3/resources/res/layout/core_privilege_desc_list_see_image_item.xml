<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeDescListSeeImageItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    holder="purchase.privilege.PrivilegeDescListSeeImageItem">
    <p151v.AutoVDraweeView
        android:id="@+id/avatar"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:layout_centerVertical="true"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="10dp"/>
    <p151v.VLinear_FillerMeasure
        android:orientation="horizontal"
        android:id="@+id/info"
        android:background="@drawable/core_privilege_desc_see_item_name_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="90dp"
        android:layout_height="24dp"
        android:layout_alignBottom="@+id/avatar"
        app:fillerIndex="0">
        <p151v.VText
            android:textSize="10dp"
            android:textColor="@color/common_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <p151v.VText
            android:textSize="10dp"
            android:textColor="@color/common_white"
            android:layout_gravity="center"
            android:id="@+id/age"
            android:paddingLeft="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear_FillerMeasure>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/visitor_info"
        android:background="@drawable/core_privilege_desc_see_item_name_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/avatar">
        <p151v.VText
            android:textSize="10dp"
            android:textStyle="normal"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/visit_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/avatar"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeDescListSeeImageItem>
