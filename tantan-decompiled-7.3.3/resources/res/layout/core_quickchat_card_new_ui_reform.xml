<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.onlinematch.view.OnlineMatchNewUiCardViewReform xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_vieww"
    android:background="@color/gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    holder="onlinematch.view.OnlineMatchNewUiCardViewReform">
    <p151v.VDraweeView
        android:id="@+id/quick_chat_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"
        app:placeholderImage="@color/gray"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:src="0x7f0815ee"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:text="闪聊匹配"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/core_color_40percent_FFFFFF"
        android:layout_gravity="center_horizontal"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:text="别让缘分错过，恭喜你们成功匹配"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/quick_chat_pop_container"
            android:background="0x7f0815e9"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            flatten="true">
            <ImageView
                android:id="@+id/quick_chat_pop_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="11dp"
                android:layout_marginTop="9dp"
                android:src="0x7f0815e8"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/quick_chat_pop_info"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="35dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="12dp"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <ImageView
                android:layout_width="35dp"
                android:layout_height="139dp"
                android:layout_marginTop="33dp"
                android:layout_marginRight="236dp"
                android:src="0x7f0815f0"
                app:layout_constraintRight_toRightOf="@+id/user_profile_root"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_width="58dp"
                android:layout_height="169dp"
                android:layout_marginLeft="218dp"
                android:layout_marginTop="40dp"
                android:src="0x7f0815f1"
                app:layout_constraintLeft_toLeftOf="@+id/user_profile_root"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/user_profile_root"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="210dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.onlinematch.view.OnlineMatchNewUiCardUserAvatarLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/me_user_profile_layout"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:rotation="-8"
                    flatten="true">
                    <p151v.VDraweeView
                        android:id="@+id/me_user_iamge"
                        android:layout_width="131dp"
                        android:layout_height="180dp"
                        app:actualImageScaleType="centerCrop"
                        app:failureImage="@color/gray"
                        app:placeholderImage="@color/gray"
                        app:roundedCornerRadius="10dp"/>
                </com.p051p1.mobile.putong.core.p058ui.onlinematch.view.OnlineMatchNewUiCardUserAvatarLayout>
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/other_user_profile_layout"
                    android:clipChildren="false"
                    android:layout_width="131dp"
                    android:layout_height="180dp"
                    android:layout_marginLeft="110dp"
                    android:rotation="8"
                    flatten="true">
                    <p151v.VDraweeView
                        android:id="@+id/other_user_iamge"
                        android:layout_width="131dp"
                        android:layout_height="180dp"
                        app:actualImageScaleType="centerCrop"
                        app:failureImage="@color/gray"
                        app:placeholderImage="@color/gray"
                        app:roundedCornerRadius="10dp"/>
                    <View
                        android:background="@drawable/core_quickchat_reform_card_online_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="36dp"
                        android:layout_alignParentBottom="true"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="32dp"
                        android:text="当前在线"
                        android:layout_alignParentBottom="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/core_color_60percent_FFFFFF"
                        android:id="@+id/user_name_age_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </p151v.VLinear>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/go_chat_btn"
        android:background="@drawable/core_bg_white_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="56dp"
        android:layout_marginRight="56dp"
        android:layout_marginBottom="40dp"
        android:text="立即和她聊"/>
</com.p051p1.mobile.putong.core.p058ui.onlinematch.view.OnlineMatchNewUiCardViewReform>
