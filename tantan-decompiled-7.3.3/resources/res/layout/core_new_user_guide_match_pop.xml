<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/common_white"
        android:ellipsize="end"
        android:id="@+id/bubble_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:maxWidth="208dp"
        android:text="你的新配对被折叠在这里啦\10跟她打个招呼吧！"
        android:maxLines="3"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/right_icon"
        android:background="@drawable/core_bg_intl_boost_price_tag"
        android:paddingLeft="10dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="10dp"
        app:enableApngEmojis="true"
        app:enableEmojis="true"
        app:largeEmojis="true"/>
</p151v.VLinear>
