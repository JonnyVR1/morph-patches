<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.call.applymic.VoiceNineMicApplyChooseViewModel">
    <View
        android:id="@+id/view_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="282dp">
        <View
            android:layout_gravity="center_horizontal"
            android:background="#80ffffff"
            android:layout_width="37dp"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#80ffffff"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LIVE_VOICE_ROOM_TYPE_APPLY_FOR_ON"/>
        <View
            android:background="#05f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="23dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#33ffffff"
            android:gravity="center"
            android:id="@+id/boss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/LIVE_VOICE_ROOM_TYPE_BOSS"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/guest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/LIVE_VOICE_ROOM_TYPE_GUEST"/>
        <View
            android:background="#05f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#33ffffff"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/LIVE_VOICE_ROOM_TYPE_CANCLE"/>
    </LinearLayout>
</LinearLayout>
