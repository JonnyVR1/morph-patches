<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.group.GroupNicknameSetViewModel"
    innerClass="true">
    <p151v.VFrame
        android:background="@drawable/core_set_group_name_bg"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/group_member_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="0x7f08095c"
            app:placeholderImage="0x7f08095c"
            app:roundAsCircle="true"/>
        <p151v.VEditText
            android:textSize="17sp"
            android:textStyle="normal"
            android:textColor="#222222"
            android:textColorHint="#d0d0d0"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_set_nickname"
            android:background="@null"
            android:paddingLeft="10dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="32dp"
            android:singleLine="true"
            android:maxLength="15"
            android:focusedByDefault="true"
            app:met_clearButton="true"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/clear"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="@drawable/core_group_create_edit_text_clear"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#a8a8a8"
        android:layout_gravity="right"
        android:id="@+id/tv_nickname_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="7dp"
        android:text="0/15"/>
</p151v.VLinear>
