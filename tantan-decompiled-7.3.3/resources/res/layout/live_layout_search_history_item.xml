<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.square.search.history.LiveSearchHistoryItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    flatten="true"
    folder="square.search.history"
    holder="LiveSearchHistoryItemView">
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12.5dp"
        android:layout_marginBottom="11.5dp"
        app:srcCompat="0x7f0824d9"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_gray_32"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="72dp"
        android:layout_toEndOf="@+id/icon"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="0x7f0824d8"/>
</com.p051p1.mobile.putong.live.external.square.search.history.LiveSearchHistoryItemView>
