<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.chat.LiveChatItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common"
    holder="chat.LiveChatItem">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:layout_marginBottom="1.5dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.view.AutoRefreshTextView
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/flow_content"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="25dp"
            android:layout_weight="1"
            android:lineSpacingExtra="1dp"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
        <View
            android:id="@+id/anchor_right"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="10dp"
            android:layout_weight="0"/>
    </LinearLayout>
    <p151v.VDraweeView
        android:layout_gravity="end|top"
        android:id="@+id/corner_icon"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.chat.LiveChatItem>
