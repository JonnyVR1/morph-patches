<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/core_intl_discount_entry_root"
        android:background="@drawable/core_bg_intl_discount_entry_banner_theme3"
        android:paddingTop="@dimen/core_intl_discount_entry_theme2_pad_top_no_sub"
        android:paddingBottom="@dimen/core_intl_discount_entry_theme2_pad_bottom_no_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/core_intl_discount_entry_theme2_min_height"
        android:paddingStart="@dimen/core_intl_discount_entry_theme2_pad_h"
        android:paddingEnd="@dimen/core_intl_discount_entry_theme2_pad_h">
        <p151v.AutoVDraweeView
            android:id="@+id/core_intl_discount_entry_badge_text"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:maxWidth="44dp"
            android:maxHeight="44dp"
            android:contentDescription="@null"
            android:rotation="-12"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <p151v.VText_NoTopPadding
                android:textSize="13sp"
                android:textColor="@color/core_intl_discount_entry_theme3_title"
                android:ellipsize="end"
                android:id="@+id/core_intl_discount_entry_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:maxLines="2"
                app:fontWeight="600"/>
            <p151v.VText_NoTopPadding
                android:textSize="10sp"
                android:textColor="@color/core_intl_discount_entry_theme3_subtitle"
                android:ellipsize="end"
                android:id="@+id/core_intl_discount_entry_subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:maxLines="2"
                app:fontWeight="400"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/core_intl_discount_entry_timer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <p151v.VText_NoTopPadding
                    android:textSize="11sp"
                    android:textColor="@color/core_intl_discount_entry_theme3_title"
                    android:gravity="center"
                    android:id="@+id/core_intl_discount_entry_timer_h"
                    android:background="@drawable/core_bg_intl_discount_entry_timer_digit_t2"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="22dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="14sp"
                    android:textColor="@color/core_intl_discount_entry_theme3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_marginStart="4dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="11sp"
                    android:textColor="@color/core_intl_discount_entry_theme3_title"
                    android:gravity="center"
                    android:id="@+id/core_intl_discount_entry_timer_m"
                    android:background="@drawable/core_bg_intl_discount_entry_timer_digit_t2"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="22dp"
                    android:minHeight="16dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="14sp"
                    android:textColor="@color/core_intl_discount_entry_theme3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_marginStart="4dp"
                    app:fontWeight="700"/>
                <p151v.VText_NoTopPadding
                    android:textSize="11sp"
                    android:textColor="@color/core_intl_discount_entry_theme3_title"
                    android:gravity="center"
                    android:id="@+id/core_intl_discount_entry_timer_s"
                    android:background="@drawable/core_bg_intl_discount_entry_timer_digit_t2"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="22dp"
                    android:minHeight="16dp"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    app:fontWeight="700"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VImage
            android:id="@+id/core_intl_discount_entry_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f080aa3"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>
    </p151v.VLinear>
</merge>
