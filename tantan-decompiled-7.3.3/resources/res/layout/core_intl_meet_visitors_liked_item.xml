<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.intlmeet.visitor.IntlMeetLikedItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="intlmeet.visitor.IntlMeetLikedItemView">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/divider"
            android:background="#f9f9f9"
            android:layout_width="match_parent"
            android:layout_height="3dp"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <p151v.VDraweeView
                android:id="@+id/header_pic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="26dp"
                style="@style/fresco_profile_small"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="29dp"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                flatten="true">
                <p151v.VLinear_FillerMeasure
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    app:fillerIndex="0">
                    <p151v.VText
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/title_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:enableEmojis="true"
                        app:typeface="medium"/>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/pic_tag_big"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginRight="4dp">
                        <p151v.VImage
                            android:layout_gravity="center"
                            android:id="@+id/pic_verify_logo"
                            android:background="0x7f082957"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginLeft="4dp"
                            android:scaleType="fitCenter"/>
                        <p151v.VImage
                            android:layout_gravity="center"
                            android:id="@+id/svip_tag"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:layout_marginLeft="4dp"/>
                    </p151v.VLinear>
                </p151v.VLinear_FillerMeasure>
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/like"
                        android:background="@drawable/core_member_newui_btn_like_bg"
                        android:layout_width="14dp"
                        android:layout_height="14dp">
                        <p151v.VImage
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="0x7f0820fb"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <p151v.VText
                        android:textSize="11sp"
                        android:textColor="#4d000000"
                        android:ellipsize="end"
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:maxLines="1"
                        app:typeface="medium"/>
                </p151v.VLinear>
            </p151v.VLinear>
            <p151v.VImage
                android:id="@+id/action_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="5dp"
                android:src="0x7f080b3f"/>
        </p151v.VLinear>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="375dp"
            android:layout_marginBottom="25dp">
            <p151v.VDraweeView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@drawable/common_card_image_holder_full_round"
                app:failureImageScaleType="centerInside"
                app:placeholderImage="@color/white"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"
                useId="true"/>
        </p151v.VFrame>
    </p151v.VLinear>
    <View
        android:id="@+id/maskView"
        android:background="#88ffffff"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="bottom|right"
        android:orientation="horizontal"
        android:id="@+id/match"
        android:background="@drawable/core_intl_vip_onebtn_match_bg"
        android:layout_width="132dp"
        android:layout_height="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="41dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/match_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="0x7f080ce3"
            android:scaleType="centerCrop"/>
        <com.p051p1.mobile.putong.core.p058ui.vip.widget.LetterRemainingSwitcherView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/match_remaining_switch"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:contentTextBold="false"
            app:contentTextColor="#f9e7ff"
            app:contentTextSize="14sp"
            app:interval="2000"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.intlmeet.visitor.IntlMeetLikedItemView>
