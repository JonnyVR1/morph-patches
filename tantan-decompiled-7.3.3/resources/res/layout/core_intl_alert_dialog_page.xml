<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.GPVipIntroPage xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="vip.GPVipIntroPage">
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#462d00"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#462d00"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/privilege_index"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="1dp"
        android:drawablePadding="1dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="127dp"
            flatten="true">
            <p151v.VRelative
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <p151v.AutoVDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/bg_drawee"
                    android:layout_width="match_parent"
                    android:layout_height="127dp"
                    android:scaleType="fitCenter"
                    app:actualImageScaleType="fitCenter"
                    style="@style/core_fresco_base"/>
                <p151v.VImage
                    android:id="@+id/identify_icon"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginBottom="10dp"
                    android:src="0x7f082959"
                    android:layout_alignBottom="@+id/icon_image"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </p151v.VRelative>
            <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
                android:layout_gravity="center"
                android:id="@+id/bg_gradient"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:shadowEnable="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/icon"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <ViewStub
            android:id="@+id/three_pic_rect"
            android:layout="@layout/picks_showcase_composite_picture"
            android:layout_width="210dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/enhance_prompt"
            android:visibility="gone"
            android:layout_width="87dp"
            android:layout_height="28dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="40dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="40dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_black_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_digest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="6dp"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_grey_09"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="18dp"
        android:maxLines="2"
        android:lineSpacingExtra="3sp"/>
</com.p051p1.mobile.putong.core.p058ui.vip.GPVipIntroPage>
