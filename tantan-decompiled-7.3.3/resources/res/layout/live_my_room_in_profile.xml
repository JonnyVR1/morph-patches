<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingBottom="5dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="page.profile.myroom"
    holder="MyRoomInProfileViewModel">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/my_room_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="@string/LIVE_PROFILE_MY_ROOM"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#33000000"
        android:id="@+id/setting"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_PROFILE_MY_ROOM_SETTING"
        app:layout_constraintBottom_toBottomOf="@+id/my_room_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/my_room_title"/>
    <ViewStub
        android:id="@+id/single_item"
        android:layout="@layout/live_my_room_in_profile_single_item"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_room_title"/>
    <ViewStub
        android:id="@+id/double_item"
        android:layout="@layout/live_my_room_in_profile_double_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_room_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
