<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/live_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voiceslipcard"
    holder="activity.LiveVoiceActivitiesListViewModel">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:background="@color/transparent"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.p051p1.mobile.putong.live.external.view.widgets.SwipeRefreshList
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true">
                <p151v.VRecyclerView
                    android:orientation="vertical"
                    android:id="@+id/recycler_view"
                    android:visibility="invisible"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    useId="true"/>
            </com.p051p1.mobile.putong.live.external.view.widgets.SwipeRefreshList>
            <p151v.VRelative
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/view_group_network_error"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/img_network_error"
                    android:layout_width="220dp"
                    android:layout_height="150dp"
                    android:scaleType="fitXY"
                    android:layout_centerHorizontal="true"
                    app:srcCompat="0x7f0827e0"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#d8d8d8"
                    android:id="@+id/tv_network_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/LIVE_THE_CURRENT_NETWORK_IS_UNAVAILABLE"
                    android:layout_below="@+id/img_network_error"
                    android:layout_centerHorizontal="true"/>
            </p151v.VRelative>
            <p151v.VRelative
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/view_group_no_live_activity"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/img_no_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f082756"
                    android:layout_centerHorizontal="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#4d323232"
                    android:gravity="center"
                    android:id="@+id/no_live_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="暂无数据"
                    android:layout_below="@+id/img_no_live"
                    android:layout_centerHorizontal="true"/>
            </p151v.VRelative>
        </FrameLayout>
    </LinearLayout>
</p151v.VFrame>
