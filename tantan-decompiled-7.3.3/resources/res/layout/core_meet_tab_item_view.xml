<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.newmeet.NewMeetTabItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="newmeet.NewMeetTabItemView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/content_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/core_vip_fun_tab_selector"
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11111"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.legacy.widget.Space
            android:id="@+id/red_dot_reference_point"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/title_tv"
            app:layout_constraintRight_toRightOf="@+id/title_tv"/>
        <p151v.VOnlineIndicator
            android:id="@+id/red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            app:indicatorStyle="style01"
            app:layout_constraintLeft_toRightOf="@+id/red_dot_reference_point"
            app:layout_constraintTop_toTopOf="@+id/red_dot_reference_point"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/num_badge_tv"
            android:background="@drawable/core_o_diamond_visitor_badge_num_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginBottom="10dp"
            android:minWidth="22dp"
            android:text="99+"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="@+id/title_tv"
            app:layout_constraintLeft_toRightOf="@+id/red_dot_reference_point"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.newui.newmeet.NewMeetTabItemView>
