<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    flatten="true"
    folder="internal.live.square"
    holder="fragments.livevideo.LiveSquareLiveVideoFrag">
    <p151v.VPullDownRefreshLayout
        android:id="@+id/swipe_refresh"
        android:background="@color/live_19191e"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableAutoLoadMore="false"
        app:srlEnableHeaderTranslationContent="false"
        app:srlEnableLoadMore="true"
        app:srlFooterHeight="40dp"
        app:srlHeaderHeight="88dp"
        app:srlHeaderInsetStart="100dp"
        flatten="true"
        useId="true">
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VRecyclerView
                android:id="@+id/room_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                useId="true"/>
            <p151v.VLinear
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true"
                useId="true">
                <p151v.VImage
                    android:id="@+id/iv_empty"
                    android:layout_width="220dp"
                    android:layout_height="150dp"
                    useId="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/live_white_80_opacity"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    useId="true"/>
            </p151v.VLinear>
        </p151v.VFrame>
    </p151v.VPullDownRefreshLayout>
</p151v.VFrame>
