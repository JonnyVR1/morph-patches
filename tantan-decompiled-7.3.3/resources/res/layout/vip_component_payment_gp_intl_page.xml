<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.intlpage.IntlGPPaymentPageComponent">
    <p151v.VFrame
        android:id="@+id/upgrade_root"
        android:background="@drawable/core_vip_bg_purchase_dialog_payment_button_vip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        flatten="true">
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/upgrade_svga"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:scaleType="fitXY"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/upgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:stateListAnimator="@anim/widget_button_sla_mini"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#cc000000"
                android:layout_gravity="center"
                android:id="@+id/upgrade_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:id="@+id/upgrade_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/primary"
        android:background="@drawable/core_vip_bg_purchase_dialog_payment_button_vip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:minHeight="56dp"
        android:stateListAnimator="@anim/widget_button_sla_mini"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/p_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            app:typeface="medium"/>
        <p151v.VFrame
            android:layout_gravity="center_horizontal"
            android:id="@+id/save"
            android:background="0x7f082987"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:stateListAnimator="@anim/widget_button_sla_mini">
            <p151v.VText
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/m_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:gravity="center"
        android:id="@+id/negative"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ACTION_CANCEL"/>
</LinearLayout>
