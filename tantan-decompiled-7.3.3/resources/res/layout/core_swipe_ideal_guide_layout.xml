<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.dialogs.IdealGuideDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_view"
        android:background="@drawable/core_ideal_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ic_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f080952"/>
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="140dp"
            android:layout_height="110dp"
            android:layout_marginStart="40dp"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="start"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp"
            android:text="还没找到感兴趣的人吗？"
            android:layout_marginHorizontal="40dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#66000000"
            android:layout_gravity="start"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="40dp"
            android:text="选择你的理想型，我们会优先推荐符合你喜好的人"
            android:layout_marginHorizontal="40dp"/>
        <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
            android:id="@+id/tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp"/>
        <TextView
            android:enabled="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/open_btn"
            android:background="@drawable/core_post_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="保存"/>
    </LinearLayout>
</FrameLayout>
