<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.square.search.recent.LiveSearchRecentItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="square.search.recent"
    holder="LiveSearchRecentItemView">
    <p151v.VDraweeView
        android:id="@+id/cover"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/live_shape_search_recent_image_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:placeholderImage="@drawable/live_shape_search_recent_image_default"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="6.8dp"/>
    <RelativeLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:background="@drawable/live_shape_search_recent_text_bg"
        android:layout_width="140dp"
        android:layout_height="140dp">
        <p151v.VText
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/common_white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/fans_count"
            android:layout_alignParentStart="true"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/common_white"
            android:gravity="end"
            android:id="@+id/fans_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="6dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.live.external.square.search.recent.LiveSearchRecentItemView>
