<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.mediapicker.InstaMediaItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/tf_rect_light"
    folder="newui"
    holder="mediapicker.InstaMediaItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:background="@color/mediapicker_image_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:actualImageScaleType="centerCrop"
        fresco:failureImage="0x7f081a6c"/>
    <ImageView
        android:layout_gravity="bottom|left"
        android:id="@+id/video_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="12dp"
        android:src="0x7f082a85"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:layout_gravity="bottom|right"
        android:id="@+id/duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="5dp"/>
    <View
        android:id="@+id/mask"
        android:background="#7f000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.p051p1.mobile.putong.feed.newui.mediapicker.MarkView
        android:layout_gravity="top|right"
        android:id="@+id/check"
        android:visibility="invisible"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"/>
</com.p051p1.mobile.putong.feed.newui.mediapicker.InstaMediaItemView>
