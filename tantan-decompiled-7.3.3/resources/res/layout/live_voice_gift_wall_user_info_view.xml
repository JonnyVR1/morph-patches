<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.VoiceGiftWallUserInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/user_info_bg"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginTop="10dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/user_avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="@+id/user_info_bg"
        app:layout_constraintTop_toTopOf="@+id/user_info_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="20dp"
        android:text="大耳朵贝贝"
        android:singleLine="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/user_avatar"
        app:layout_constraintRight_toLeftOf="@+id/grade_icon"
        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
    <com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.RoundedProgressBar
        android:id="@+id/upgrade_progress"
        android:layout_width="140dp"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/user_avatar"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="#66ffffff"
        android:id="@+id/upgrade_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/upgrade_progress"
        app:layout_constraintLeft_toLeftOf="@+id/upgrade_progress"
        app:layout_constraintTop_toTopOf="@+id/upgrade_progress"/>
    <p151v.VDraweeView
        android:id="@+id/grade_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginRight="10dp"
        app:layout_constraintRight_toRightOf="@+id/user_info_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line"
        android:background="#08ffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintTop_toBottomOf="@+id/user_avatar"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66ffffff"
        android:id="@+id/light_count_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="@string/LIVE_OWND_GIFT_NUM"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/user_info_bg"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:id="@+id/light_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="@+id/user_info_bg"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
</com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.VoiceGiftWallUserInfoView>
