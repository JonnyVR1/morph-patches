<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="630dp">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="375:274"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:src="0x7f0822e3"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintLeft_toLeftOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_WEEK_STAR_HALE"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintLeft_toLeftOf="@+id/top_bar"
        app:layout_constraintRight_toRightOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66ffffff"
        android:id="@+id/last_week_top3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_LAST_WEEK_TOP_THREE_HALE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <p151v.VImage
        android:layout_width="37dp"
        android:layout_height="8dp"
        android:layout_marginRight="8dp"
        android:src="0x7f08285c"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="@+id/last_week_top3"
        app:layout_constraintRight_toLeftOf="@+id/last_week_top3"
        app:layout_constraintTop_toTopOf="@+id/last_week_top3"/>
    <p151v.VImage
        android:layout_width="37dp"
        android:layout_height="8dp"
        android:layout_marginLeft="8dp"
        android:src="0x7f08285c"
        android:alpha="0.3"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/last_week_top3"
        app:layout_constraintLeft_toRightOf="@+id/last_week_top3"
        app:layout_constraintTop_toTopOf="@+id/last_week_top3"/>
    <include
        android:id="@+id/top1_view"
        android:layout_width="133dp"
        android:layout_height="205dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/last_week_top3"
        layout="@layout/live_voice_gift_wall_week_star_hall_top_item_view"/>
    <include
        android:id="@+id/top2_view"
        android:layout_width="101dp"
        android:layout_height="173dp"
        app:layout_constraintBottom_toBottomOf="@+id/top1_view"
        app:layout_constraintRight_toLeftOf="@+id/top1_view"
        layout="@layout/live_voice_gift_wall_week_star_hall_top_item_view"/>
    <include
        android:id="@+id/top3_view"
        android:layout_width="101dp"
        android:layout_height="173dp"
        app:layout_constraintBottom_toBottomOf="@+id/top1_view"
        app:layout_constraintLeft_toRightOf="@+id/top1_view"
        layout="@layout/live_voice_gift_wall_week_star_hall_top_item_view"/>
    <View
        android:id="@+id/current_anchor_status"
        android:background="@drawable/live_bg_25252c_r24"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#4dffffff"
        android:id="@+id/anchor_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/current_anchor_status"
        app:layout_constraintLeft_toLeftOf="@+id/current_anchor_status"
        app:layout_constraintTop_toTopOf="@+id/current_anchor_status"/>
    <p151v.VDraweeView
        android:id="@+id/anchor_avatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="14.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/current_anchor_status"
        app:layout_constraintLeft_toRightOf="@+id/anchor_rank"
        app:layout_constraintTop_toTopOf="@+id/current_anchor_status"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="7sp"
        android:textColor="#ffffff"
        android:background="@drawable/live_bg_fe7e1d_r4"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CURRENT_ANCHOR"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/anchor_avatar"
        app:layout_constraintRight_toRightOf="@+id/anchor_avatar"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14.5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/anchor_avatar"
        app:layout_constraintRight_toLeftOf="@+id/anchor_unlock_status"
        app:layout_constraintTop_toTopOf="@+id/anchor_avatar">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/anchor_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#66ffffff"
            android:ellipsize="end"
            android:id="@+id/anchor_need"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#66ffffff"
        android:id="@+id/anchor_unlock_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/current_anchor_status"
        app:layout_constraintRight_toRightOf="@+id/current_anchor_status"
        app:layout_constraintTop_toTopOf="@+id/current_anchor_status"/>
    <p151v.VRecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/current_anchor_status"
        app:layout_constraintTop_toBottomOf="@+id/top1_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
