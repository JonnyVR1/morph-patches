<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.MusicCenterAct">
    <FrameLayout
        android:background="@drawable/bg_music_center_top"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/music_center_close"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0802bb"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#383e46"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FEED_CAPTURE_MUSIC_LIBRARY"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/music_center_recycle_view"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <include
            android:id="@+id/music_network_error_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/music_network_error_layout"/>
    </FrameLayout>
</LinearLayout>
