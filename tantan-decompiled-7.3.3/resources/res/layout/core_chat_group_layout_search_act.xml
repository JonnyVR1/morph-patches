<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="group.GroupSearchListViewModel">
    <RelativeLayout
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/img_network_error"
            android:layout_width="102dp"
            android:layout_height="80dp"
            android:scaleType="fitXY"
            android:tint="#e9e9e9"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/core_im_network_not_available"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/gray_999999"
            android:id="@+id/tv_network_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="当前网络不可用"
            android:layout_below="@+id/img_network_error"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#4a95e2"
            android:id="@+id/tv_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击刷新"
            android:layout_below="@+id/tv_network_tips"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_input_root"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            flatten="true">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:background="@drawable/core_conv_search_input_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/input_bg_layout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="38dp"
                    android:layout_marginRight="32dp"
                    flatten="true">
                    <com.p051p1.mobile.putong.core.p058ui.messages.emoji.VEditTextEmojiCompat
                        android:textSize="16sp"
                        android:textColor="@color/common_000000_80"
                        android:textColorHint="@color/common_000000_20"
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/input_text"
                        android:background="@null"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="42dp"
                        android:hint="@string/CHAT_GROUP_SHURU_QUNID"
                        android:singleLine="true"
                        android:maxLength="1000"
                        android:lineSpacingExtra="0.5dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:textCursorDrawable="@drawable/core_message_input_cursor"
                        app:enableEmojis="true"
                        app:typeface="regular"/>
                </FrameLayout>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_ic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="8dp"
                    app:srcCompat="0x7f080756"/>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/close_ic"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    app:srcCompat="0x7f080fc6"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="@color/common_grey_03"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cancel_search"
                android:paddingLeft="12dp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/ACTION_CANCEL"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/group_chat_wrap"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#c4c4c4"
                android:id="@+id/group_chat_suggest"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="11dp"
                android:text="@string/CHAT_GROUP_SEARCH_RECOMMEND"/>
            <com.p051p1.mobile.putong.core.newui.group.GroupSuggestLayout
                android:orientation="vertical"
                android:id="@+id/suggest_group_tags"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/group_chat_suggest"/>
        </RelativeLayout>
        <p151v.VRecyclerView
            android:orientation="vertical"
            android:id="@+id/recycler_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
</FrameLayout>
