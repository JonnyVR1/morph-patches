<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.quickaudio.party.AudioQuickChatPartyInvitationCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    folder="ui"
    holder="quickaudio.party.AudioQuickChatPartyInvitationCardView">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:background="@drawable/core_bg_card_audio_quickchat_party"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:layout_gravity="bottom"
            android:id="@+id/bg_bottom_icon"
            android:layout_width="190dp"
            android:layout_height="148dp"
            app:actualImageScaleType="centerCrop"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"/>
        <p151v.VDraweeView
            android:layout_gravity="end"
            android:id="@+id/bg_top_icon"
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:actualImageScaleType="centerCrop"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"/>
    </p151v.VFrame>
    <p151v.VRelative
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/title_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:src="0x7f0815d5"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_80percent_000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="极速约会"
            android:layout_below="@+id/title_icon"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_40percent_000000"
            android:gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="每周三19:00-22:00"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"/>
        <p151v.VDraweeView
            android:id="@+id/campaign_icon"
            android:layout_width="299dp"
            android:layout_height="250dp"
            android:layout_centerInParent="true"
            app:actualImageScaleType="centerCrop"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_40percent_000000"
            android:gravity="center_horizontal"
            android:id="@+id/campaign_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="活动开始时我们会发送提醒"
            android:layout_above="@+id/send_btn"
            android:layout_centerHorizontal="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_80percent_000000"
            android:gravity="center"
            android:id="@+id/send_btn"
            android:background="@drawable/core_card_button_bg_white_normal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="40dp"
            android:text="我要参加"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.quickaudio.party.AudioQuickChatPartyInvitationCardView>
