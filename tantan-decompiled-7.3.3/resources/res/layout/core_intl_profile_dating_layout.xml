<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    attachToRoot="true"
    folder="newui"
    holder="profile.newme.DatingViewLayout">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/my_location"
            android:background="@drawable/tf_rect_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/core_color_cc000000"
                android:text="@string/SETTINGS_LOCATION"
                style="@style/core_settings_header1"/>
            <p151v.VLinear
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="40dp">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/core_color_cc000000"
                    android:layout_gravity="right"
                    android:id="@+id/location_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/SETTINGS_LOCATION_TYPE_CURRENT"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/core_color_4d000000"
                    android:layout_gravity="right"
                    android:id="@+id/current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/SETTINGS_LOCATION_DETAIL_UNKNOWN"/>
            </p151v.VLinear>
            <ImageView
                android:layout_gravity="center"
                android:src="0x7f081f64"
                style="@style/core_settings_arrow"/>
        </p151v.VFrame>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_no_location_permission_tips"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="false">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_color_4d000000"
                android:id="@+id/ll_no_location_permission_tips_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="未开启定位权限，当前定位可能存在偏差"
                android:includeFontPadding="false"/>
            <View
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/base_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <FrameLayout
                android:id="@+id/distance_info_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="false">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_color_cc000000"
                    android:text="@string/SETTINGS_DISTANCE"
                    style="@style/core_settings_header1"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_color_cc000000"
                    android:layout_gravity="right"
                    android:id="@+id/distance_text_base"
                    style="@style/core_settings_header1"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/distance_bar_ll_base"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                flatten="false">
                <ImageView
                    android:visibility="gone"
                    app:srcCompat="@drawable/settings_distance_short_ic"
                    style="@style/core_settings_small_icon"/>
                <SeekBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/search_distance_base"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/v_seekbar"/>
                <ImageView
                    android:visibility="gone"
                    app:srcCompat="@drawable/settings_distance_long_ic"
                    style="@style/core_settings_small_icon"/>
            </LinearLayout>
            <p151v.VFrame
                android:id="@+id/auto_distance_base"
                android:layout_marginTop="0dp"
                style="@style/core_settings_clickable_item">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/core_settings_stacked_frame">
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="@color/core_color_cc000000"
                        android:layout_marginBottom="0dp"
                        android:text="@string/SETTINGS_AUTO_DISTANCE_TITLE"
                        style="@style/core_settings_primary"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="@color/core_color_4d000000"
                        android:paddingTop="5dp"
                        android:paddingBottom="0dp"
                        android:layout_width="wrap_content"
                        android:text="@string/SETTINGS_AUTO_DISTANCE_INFO"
                        style="@style/settings_small_des"/>
                </LinearLayout>
                <p151v.VSwitch style="@style/core_settings_item_switch"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/show_gender_base"
                android:background="@drawable/tf_rect_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_color_cc000000"
                    android:layout_gravity="center_vertical"
                    android:text="@string/SETTINGS_SHOW_GENDER"
                    style="@style/core_settings_header1"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/core_color_4d000000"
                    android:layout_gravity="center"
                    android:id="@+id/text_base"
                    android:text="@string/SETTINGS_SHOW_GENDER_BOTH"
                    style="@style/settings_highlighted"/>
            </p151v.VFrame>
            <FrameLayout
                android:id="@+id/age_fl_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                flatten="false">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_color_cc000000"
                    android:text="@string/SETTINGS_AGE"
                    style="@style/core_settings_header1"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_color_cc000000"
                    android:layout_gravity="right"
                    android:id="@+id/age_text_base"
                    style="@style/core_settings_header1"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/age_bar_ll_base"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                flatten="false">
                <ImageView
                    android:visibility="gone"
                    app:srcCompat="@drawable/settings_age_young_ic"
                    style="@style/core_settings_small_icon"/>
                <com.p051p1.mobile.putong.core.p058ui.settings.AgeRangeSeekBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/show_ages_base"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/v_seekbar"/>
                <ImageView
                    android:visibility="gone"
                    app:srcCompat="@drawable/settings_age_old_ic"
                    style="@style/core_settings_small_icon"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
