<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/click_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <View
                android:id="@+id/view_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <View
                android:id="@+id/view_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </p151v.VLinear>
        <View
            android:id="@+id/card_details"
            android:layout_width="match_parent"
            android:layout_height="150dp"/>
    </LinearLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:paddingBottom="3dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:elevation="10dp">
        <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
            android:id="@+id/image_indicator"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="11dp"
            app:indicatorColor="@color/core_indicator_33ffffff"
            app:indicatorMargin="3dp"
            app:indicatorSelectedColor="@color/common_white"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <p151v.VText
                android:textStyle="normal"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_1"
                android:visibility="invisible"
                android:layout_marginLeft="11dp"
                android:maxWidth="220dp"
                android:maxLines="1"
                app:typeface="medium"
                style="@style/core_card_small_tag"/>
            <p151v.VText
                android:textStyle="normal"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_2"
                android:visibility="invisible"
                android:layout_marginLeft="4dp"
                android:maxWidth="220dp"
                android:maxLines="1"
                app:typeface="medium"
                style="@style/core_card_small_tag"/>
            <p151v.VText
                android:textStyle="normal"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tag_3"
                android:visibility="invisible"
                android:layout_marginLeft="4dp"
                android:maxWidth="220dp"
                android:maxLines="1"
                app:typeface="medium"
                style="@style/core_card_small_tag"/>
        </LinearLayout>
    </p151v.VLinear>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/ad_pic_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/ad_content"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/ad_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/white"
                app:failureImageScaleType="centerInside"
                app:placeholderImage="@color/core_kankan_card_placeholder"
                app:placeholderImageScaleType="centerInside"
                app:roundBottomEnd="false"
                app:roundBottomLeft="false"
                app:roundBottomRight="false"
                app:roundBottomStart="false"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="20dp"
                style="@style/core_fresco_base"/>
            <com.p051p1.mobile.putong.core.p058ui.advertisingcard.AdvertisPlayVideoView
                android:id="@+id/video_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <p151v.VProgressBar
                android:layout_gravity="center"
                android:id="@+id/ad_loading"
                android:visibility="invisible"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateOnly="true"
                android:layout_centerInParent="true"
                app:cpb_color="@color/white"
                app:cpb_stroke_percentage="0.1"
                useId="true"/>
        </p151v.VRelative>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/ad_bottom_container"
            android:paddingLeft="12dp"
            android:paddingTop="56dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/swipe_right_guide"
                android:background="@drawable/core_adcard_swipe_guide_blur_bg"
                android:visibility="gone"
                android:layout_width="194dp"
                android:layout_height="78dp"
                android:layout_marginBottom="46dp">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/common_white"
                    android:gravity="center"
                    android:id="@+id/tv_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableRight="0x7f0816bd"
                    android:drawablePadding="4dp"
                    android:lineSpacingExtra="6sp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <p151v.VDraweeView
                    android:id="@+id/ad_icon_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:placeholderImageScaleType="centerInside"
                    app:roundedCornerRadius="8dp"/>
                <p151v.VDraweeView
                    android:id="@+id/ad_icon_2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    app:placeholderImageScaleType="centerInside"
                    app:roundedCornerRadius="8dp"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:id="@+id/ad_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="12dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/new_album_item_text_reset"
                android:ellipsize="end"
                android:id="@+id/ad_des_0"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/ad_des_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"/>
            <TextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/action"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="69dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bottom_books_movies_dramas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/advertising_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp">
                        <ImageView
                            android:id="@+id/advertising_start_0"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:id="@+id/advertising_normal_0"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <p151v.VText
                        android:textSize="14sp"
                        android:gravity="center"
                        android:id="@+id/button_0"
                        android:padding="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/advertising_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="9dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp">
                        <ImageView
                            android:id="@+id/advertising_start_1"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:id="@+id/advertising_normal_1"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <p151v.VText
                        android:textSize="14sp"
                        android:gravity="center"
                        android:id="@+id/button_1"
                        android:padding="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/advertising_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="9dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp">
                        <ImageView
                            android:id="@+id/advertising_start_2"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:id="@+id/advertising_normal_2"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <p151v.VText
                        android:textSize="14sp"
                        android:gravity="center"
                        android:id="@+id/button_2"
                        android:padding="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
