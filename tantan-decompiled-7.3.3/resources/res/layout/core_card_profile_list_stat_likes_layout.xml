<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/stat_likes"
    android:background="@drawable/core_bg_12_ffffff"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.ProfileListStatLikesCardExpandeHolder">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f080f28"
            android:layout_marginStart="20dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_80percent_000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="100"
            android:layout_marginStart="8dp"/>
        <p151v.VButton
            android:textSize="13sp"
            android:textColor="#f08016"
            android:gravity="center"
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160dp"
            android:minWidth="85dp"
            android:text="@string/PROFILE_SHARE_LIKES_BUTTON"
            android:singleLine="true"
            android:textAllCaps="true"
            android:paddingEnd="19dp"
            app:typeface="medium"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_50percent_000000"
        android:id="@+id/guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/PROFILE_GET_MORE_LIKES_TIPS"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="19dp"/>
</p151v.VLinear>
