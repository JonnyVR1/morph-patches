<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.fans.LiveFansItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:clipChildren="false"
    android:layout_width="40dp"
    android:layout_height="@dimen/live_fans_height"
    flatten="true"
    folder="common"
    holder="fans.LiveFansItem">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:layout_gravity="center"
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/svga"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <TextView
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="none"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/reward_point"
        android:background="@drawable/live_bg_black_r5_a40"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.live.livingroom.common.fans.LiveFansItem>
