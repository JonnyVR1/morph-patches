<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="photoalbum.feed.PhotoAlbumFeedFragViewModel"
    useId="true">
    <RelativeLayout
        android:id="@+id/title_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="#ff450e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/MOMENTS_TITLE"
            android:layout_centerVertical="true"/>
        <p151v.VImage
            android:id="@+id/moment_upload"
            android:background="@drawable/tf_circle_light"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="0x7f0828e3"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <View
            android:background="#19000000"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <include
        android:id="@+id/moment_upload_bar"
        layout="@layout/moment_post_bar"/>
    <com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedDraftView
        android:id="@+id/draft_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/bubble_view_fl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:id="@+id/base_frag_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</p151v.VLinear>
