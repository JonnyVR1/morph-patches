<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="intlmeet.ilike.IntlILikeViewModel">
    <FrameLayout
        android:id="@+id/intl_meet_ilike_discount_banner_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VFrame
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp">
                <p151v.VImage
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f080ae9"
                    android:scaleType="centerInside"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#66323232"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="110dp"
                    android:layout_marginTop="42dp"
                    android:layout_marginRight="110dp"
                    android:text="@string/INTL_SUPERLIKE_FUNCTION_INTRODUCTION"
                    android:layout_marginHorizontal="110dp"/>
            </LinearLayout>
        </p151v.VFrame>
        <p151v.VPullUpRecyclerView
            android:id="@+id/list"
            android:paddingLeft="4dp"
            android:paddingTop="5dp"
            android:paddingRight="4dp"
            android:paddingBottom="91dp"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="@color/common_black_80"
        android:gravity="center"
        android:id="@+id/get_privilege"
        android:background="@drawable/core_intl_meet_ilike_button_premium"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/INTL_I_LIKE_UNCLOCK_BTN"
        android:textAllCaps="false"
        android:layout_marginHorizontal="20dp"
        app:fontWeight="500"/>
</p151v.VLinear>
