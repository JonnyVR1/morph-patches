<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/top_area"
        android:layout_width="110dp"
        android:layout_height="96dp">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar_bg"
            android:layout_width="96dp"
            android:layout_height="96dp"
            style="@style/vip_alert_avatar_frame_round_bg">
            <p151v.AutoVDraweeView
                android:layout_gravity="center"
                android:id="@+id/avatar"
                android:layout_width="82dp"
                android:layout_height="82dp"
                style="@style/core_fresco_profile_white_border"/>
        </FrameLayout>
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:src="0x7f0818ea"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_origin_01"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="70dp"
        android:lines="1"
        android:drawablePadding="8dp"
        app:vectorDrawableRight="@drawable/vip_status_vip"/>
</LinearLayout>
