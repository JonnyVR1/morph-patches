<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.member.voiceleaderboard.VoiceLiveMemberItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="voice"
    holder="member.voiceleaderboard.VoiceLiveMemberItem">
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="start"
        android:id="@+id/svga"
        android:visibility="visible"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffdd19"
        android:gravity="center"
        android:id="@+id/ranking"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar_group"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="75dp"
        android:layout_marginEnd="95dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.royal.LiveGradientTextView
            android:textSize="15sp"
            android:textColor="@color/live_white_90_opacity"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="2dp"
            android:maxWidth="148dp"
            android:maxLines="1"
            android:singleLine="true"/>
        <HorizontalScrollView
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tagsContainer"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                flatten="true">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:id="@+id/gender_age"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:layout_marginEnd="6dp">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/gender"
                        android:layout_width="14dp"
                        android:layout_height="14dp"/>
                    <p151v.VText
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/age"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="2dp"/>
                </p151v.VLinear>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/constellation"
                    android:visibility="gone"
                    android:layout_width="35dp"
                    android:layout_height="14dp"/>
                <p151v.VDraweeView
                    android:id="@+id/level"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="14dp"
                    fresco:actualImageScaleType="fitXY"/>
                <p151v.VDraweeView
                    android:id="@+id/vip"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"
                    fresco:actualImageScaleType="fitXY"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalFirst"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalSecond"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalThird"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalFour"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
            </p151v.VLinear>
        </HorizontalScrollView>
        <p151v.VImage
            android:id="@+id/mystery_icon"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="0x7f08240a"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#80ffffff"
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/right_desc"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.member.voiceleaderboard.VoiceLiveMemberItem>
