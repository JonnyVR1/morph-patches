<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="48dp"
    android:minHeight="48dp">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.MysteryAvatarView
        android:id="@+id/real_avatar_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:failureImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga_avatar_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75"/>
    <p151v.VDraweeView
        android:id="@+id/static_cover_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/dynamic_cover_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.view.CircularProgressView
        android:id="@+id/countDownProgressView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:backColor="@color/transparent"
        app:backWidth="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/real_avatar_view"
        app:layout_constraintEnd_toEndOf="@+id/real_avatar_view"
        app:layout_constraintStart_toStartOf="@+id/real_avatar_view"
        app:layout_constraintTop_toTopOf="@+id/real_avatar_view"
        app:progColor="@color/live_fe7e1d"
        app:progWidth="3dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/dynamic_cover_svga_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
