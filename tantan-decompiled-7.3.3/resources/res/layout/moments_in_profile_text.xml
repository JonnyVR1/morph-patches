<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_frame"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="moments.inprofile.MomentsInProfileTextActViewModel">
    <p151v.VScroll
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/text_medium"
            android:id="@+id/text"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="76dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:typeface="regular"/>
    </p151v.VScroll>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="64dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/comment_frame"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/comment"
            android:background="@drawable/moments_feed_button_rounded"
            android:layout_width="96dp"
            android:layout_height="32dp"
            android:layout_marginRight="8dp">
            <p151v.VText
                android:layout_gravity="center"
                android:text="@string/MOMENTS_BUTTON_COMMENT_TITLE"
                android:drawableLeft="0x7f0828f2"
                android:drawablePadding="6dp"
                style="@style/feed_moment_comment_button_text"/>
        </FrameLayout>
        <include
            android:layout_gravity="center"
            android:layout_width="96dp"
            android:layout_height="32dp"
            layout="@layout/moments_comment_like"/>
        <FrameLayout
            android:layout_gravity="center"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VFrame
                android:layout_gravity="center"
                android:id="@+id/comments_detail"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="0x7f0828ee"
                    android:drawablePadding="6dp"
                    app:typeface="medium"/>
                <p151v.VImage_Squared
                    android:layout_gravity="center"
                    android:background="@drawable/tf_circle_bounded_light"
                    android:duplicateParentState="true"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>
            </p151v.VFrame>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
