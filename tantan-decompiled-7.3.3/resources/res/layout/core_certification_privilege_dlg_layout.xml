<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_certification_bottom_sheet_bg"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="verification.CertPrivilegeDlg">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/collapse"
        android:background="@drawable/core_privilege_desc_dlg_collapse"
        android:layout_width="30dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"/>
    <p151v.VPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="330dp"/>
    <p151v.VPagerCircleIndicator
        android:id="@+id/pager_indicator"
        android:background="@drawable/transparent"
        android:layout_width="wrap_content"
        android:layout_height="7dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="11dp"
        app:fillColor="@color/common_orange"
        app:pageColor="@color/common_light_01"
        app:radius="3dp"/>
    <p151v.VText_NoTopPadding
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/core_low_photo_bottom_sheet_photo_button_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="43dp"
        android:layout_marginRight="20dp"
        android:text="立即认证"
        android:layout_marginEnd="9dp"
        android:layout_marginHorizontal="20dp"
        app:fontWeight="600"/>
</p151v.VLinear>
