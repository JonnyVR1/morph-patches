<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="supreme.SupremeListViewModel">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VFrame
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VProgressBar
                android:id="@+id/progress"
                style="@style/core_loading_block"/>
        </p151v.VFrame>
        <RelativeLayout
            android:id="@+id/rl_error_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:translationY="-55dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/img_network_error"
                android:layout_width="210dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/core_member_network_not_available"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/common_grey_03"
                android:gravity="center"
                android:id="@+id/tv_network_tips"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="28dp"
                android:text="你的网络好像出错了..."
                android:layout_below="@+id/img_network_error"
                android:layout_centerHorizontal="true"
                app:typeface="medium"/>
            <p151v.VButton
                android:textSize="16sp"
                android:id="@+id/reload"
                android:layout_width="247dp"
                android:layout_height="56dp"
                android:layout_marginTop="88dp"
                android:text="重新加载"
                android:layout_below="@+id/tv_network_tips"
                android:layout_centerHorizontal="true"
                style="@style/common_button_large_01"/>
        </RelativeLayout>
        <include
            android:layout_gravity="top"
            android:id="@+id/countdown"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_supreme_list_countdown_view"/>
        <FrameLayout
            android:id="@+id/fl_content_layout"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VPullUpRecyclerView
                android:id="@+id/list"
                android:paddingLeft="4dp"
                android:paddingTop="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffdea1"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/get_privilege"
                android:background="0x7f08178d"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="18dp"
                android:text="申请至尊合伙人"/>
        </FrameLayout>
    </p151v.VFrame>
</p151v.VLinear>
