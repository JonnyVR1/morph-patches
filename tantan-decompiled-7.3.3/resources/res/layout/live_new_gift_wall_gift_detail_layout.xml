<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.giftwallnew.giftdetail.LiveGiftWallDetailDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@color/live_19191e"
        android:layout_width="match_parent"
        android:layout_height="630dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/image_bg"
        android:layout_width="match_parent"
        android:layout_height="274dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="21dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_bg"/>
    <p151v.VDraweeView
        android:textSize="9sp"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/sub_title_image"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VDraweeView
        android:id="@+id/gift_tray"
        android:layout_width="0dp"
        android:layout_height="185dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title_image"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/gift_tray_svga"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="185dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gift_tray"/>
    <p151v.VImage
        android:id="@+id/back_bt"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f0822f2"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <p151v.VDraweeView
        android:id="@+id/gift_img"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <include
        android:id="@+id/five_star"
        android:layout_width="0dp"
        android:layout_height="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_img"
        app:layout_constraintWidth_default="wrap"
        layout="@layout/live_gift_wall_five_star_view"/>
    <TextView
        android:textColor="@color/live_white_20_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/gift_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_img"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_bg"
        android:background="@drawable/live_bg_white_r10_a05"
        android:layout_width="match_parent"
        android:layout_height="79dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_source"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/named_user_icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="0x7f0822e9"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:id="@+id/named_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/named_hint"
            app:layout_constraintStart_toEndOf="@+id/named_user_icon"
            app:layout_constraintTop_toTopOf="@+id/named_user_icon"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center"
            android:id="@+id/named_hint"
            android:background="@drawable/live_bg_fe7e1d_r4"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:text="独家冠名"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/named_user_icon"
            app:layout_constraintStart_toEndOf="@+id/named_user_icon"
            app:layout_constraintTop_toBottomOf="@+id/named_user_name"/>
        <View
            android:id="@+id/line"
            android:background="@color/live_white_05_opacity"
            android:layout_width="1dp"
            android:layout_height="33dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/star_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="点亮足迹"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/user_icon3"
            app:layout_constraintStart_toStartOf="@+id/user_icon3"
            app:layout_constraintTop_toBottomOf="@+id/user_icon3"/>
        <p151v.VDraweeView
            android:id="@+id/user_icon1"
            android:background="0x7f0822e5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon3"
            app:layout_constraintEnd_toEndOf="@+id/user_icon2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toTopOf="@+id/user_icon3"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundedCornerRadius="100dp"
            app:roundingBorderColor="@color/live_373741"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_icon2"
            android:background="0x7f0822e5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon3"
            app:layout_constraintEnd_toEndOf="@+id/user_icon3"
            app:layout_constraintTop_toTopOf="@+id/user_icon3"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundedCornerRadius="100dp"
            app:roundingBorderColor="@color/live_373741"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_icon3"
            android:background="0x7f0822e5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/star_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/line"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundedCornerRadius="100dp"
            app:roundingBorderColor="@color/live_373741"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_icon4"
            android:background="0x7f0822e5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon3"
            app:layout_constraintStart_toStartOf="@+id/user_icon3"
            app:layout_constraintTop_toTopOf="@+id/user_icon3"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundedCornerRadius="100dp"
            app:roundingBorderColor="@color/live_373741"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_icon5"
            android:background="0x7f0822e5"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:scaleType="fitXY"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_icon3"
            app:layout_constraintStart_toStartOf="@+id/user_icon4"
            app:layout_constraintTop_toTopOf="@+id/user_icon3"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitCenter"
            app:roundAsCircle="true"
            app:roundedCornerRadius="100dp"
            app:roundingBorderColor="@color/live_373741"
            app:roundingBorderWidth="1dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_bg_normal"
        android:background="@drawable/live_bg_white_r10_a05"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_bg"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/normal_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点亮足迹"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line_normal"
            android:background="@color/live_white_05_opacity"
            android:layout_width="1dp"
            android:layout_height="33dp"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/normal_hint"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/user_normal_icon1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/line_normal"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/live_white_05_opacity"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_normal_icon2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon3"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon1"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/live_white_05_opacity"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_normal_icon3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon4"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon2"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/live_white_05_opacity"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_normal_icon4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon5"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon3"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/live_white_05_opacity"
            app:roundingBorderWidth="1dp"/>
        <p151v.VDraweeView
            android:id="@+id/user_normal_icon5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon4"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="0x7f0822f4"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            app:roundingBorderColor="@color/live_white_05_opacity"
            app:roundingBorderWidth="1dp"/>
        <View
            android:background="0x7f082414"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon2"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon1"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="0x7f082414"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon3"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon2"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="0x7f082414"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon4"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon3"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="0x7f082414"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_normal_icon5"
            app:layout_constraintStart_toEndOf="@+id/user_normal_icon4"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/gifts_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="礼物配置"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_bg_normal"/>
    <include
        android:id="@+id/gift_item1"
        android:layout_width="0dp"
        android:layout_height="102dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/gift_item2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_bg_normal"
        layout="@layout/live_gift_wall_detail_skin_select_item"/>
    <include
        android:id="@+id/gift_item2"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="102dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/gift_item3"
        app:layout_constraintStart_toEndOf="@+id/gift_item1"
        app:layout_constraintTop_toBottomOf="@+id/card_bg_normal"
        layout="@layout/live_gift_wall_detail_skin_select_item"/>
    <include
        android:id="@+id/gift_item3"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="102dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gift_item2"
        app:layout_constraintTop_toBottomOf="@+id/card_bg_normal"
        layout="@layout/live_gift_wall_detail_skin_select_item"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/bt"
        android:background="@drawable/live_selector_multi_pk_start"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
