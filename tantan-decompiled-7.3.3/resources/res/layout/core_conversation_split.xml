<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationFoldView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.ConversationFoldView">
    <FrameLayout
        android:id="@+id/fold_layout"
        android:paddingLeft="12dp"
        android:paddingTop="16dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textColor="#66000000"
            android:id="@+id/fold_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7日前的消息"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fold"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/core_split_conv_open"/>
    </FrameLayout>
    <include
        android:id="@+id/weaken_layout"
        layout="@layout/core_conversation_weaken_tips"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationFoldView>
