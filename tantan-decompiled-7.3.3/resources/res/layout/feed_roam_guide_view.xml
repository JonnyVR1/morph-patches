<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedRoamGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingLeft="64dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.view.FeedRoamGuideView">
    <RelativeLayout
        android:id="@+id/guide_root"
        android:background="@drawable/feed_roam_location_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        flatten="false">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="11dp"
            android:src="0x7f081ec7"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_orange"
            android:ellipsize="end"
            android:id="@+id/guide_info_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/guide_user_icon_home"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:id="@+id/guide_user_icon_home"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="30dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            flatten="false">
            <p151v.VDraweeView
                android:id="@+id/guide_user_avatar_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:id="@+id/guide_user_avatar_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:id="@+id/guide_user_avatar_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                app:roundAsCircle="true"/>
            <p151v.VDraweeView
                android:id="@+id/guide_user_avatar_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentRight="true"
                app:roundAsCircle="true"/>
        </RelativeLayout>
        <p151v.VImage
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="8dp"
            android:src="0x7f081ec9"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.view.FeedRoamGuideView>
