<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.IntlConversationOnlyBoostView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_bg_only_boost"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    flatten="true"
    folder="newui"
    holder="messages.IntlConversationOnlyBoostView">
    <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
        android:id="@+id/iv_boost"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#66000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="24dp"
        android:text="@string/INTL_SPOTLIGHT_BLANKINTRO"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_boost"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.newui.messages.IntlConversationOnlyBoostView>
