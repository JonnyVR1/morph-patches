<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemLimitTimePic xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemLimitTimePic">
    <FrameLayout
        android:background="@drawable/core_msg_switch_image_cell_bg"
        android:padding="1dp"
        android:layout_width="140dp"
        android:layout_height="140dp">
        <p151v.VDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VLinear
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/limit_pic_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/limit_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f080f50"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/limit_des"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:text="未读将过期"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/limit_time"
                android:background="@drawable/bg_message_pic_limit_time"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="3dp"
                android:drawableStart="0x7f080f4b"
                android:paddingStart="3dp"
                android:paddingEnd="5dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/limit_expired_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/expired_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f080f4d"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#b3ffffff"
                android:gravity="center"
                android:id="@+id/expired_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="已过期"/>
        </p151v.VLinear>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="#33000000"
        android:id="@+id/read_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemLimitTimePic>
