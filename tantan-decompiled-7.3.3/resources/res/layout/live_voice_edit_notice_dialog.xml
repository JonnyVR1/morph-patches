<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.basebuild.notice.VoiceEditNoticeDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="basebuild.notice.VoiceEditNoticeDialog">
    <View
        android:id="@+id/empty"
        android:background="@color/live_black_40_opacity"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/empty_anchor"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/empty_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/container"/>
    <RelativeLayout
        android:id="@+id/container"
        android:background="@drawable/live_bg_19191e_tr24"
        android:paddingLeft="20dp"
        android:paddingRight="28dp"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <TextView
            android:textSize="21sp"
            android:textStyle="normal"
            android:textColor="#e6000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/LIVE_VOICE_TOP_NOTICE_EDIT_NOTICE_TITLE"/>
        <TextView
            android:textSize="21sp"
            android:textStyle="normal"
            android:textColor="#4d000000"
            android:id="@+id/can_input_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_toRightOf="@+id/title"
            android:layout_alignTop="@+id/title"/>
        <p151v.VFrame
            android:id="@+id/edit_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_below="@+id/title"
            flatten="true">
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="@color/live_black"
                android:textColorHint="#4d000000"
                android:gravity="top"
                android:id="@+id/input_notice_text"
                android:background="@null"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="189dp"
                android:hint="@string/LIVE_VOICE_TOP_NOTICE_EDIT_NOTICE_HINT"
                android:inputType="textMultiLine"
                android:textCursorDrawable="@drawable/live_shape_voice_top_notice_input_cursor_style"/>
        </p151v.VFrame>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/complete_update"
            android:background="@drawable/live_shape_voice_top_notice_complete_input_sure_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/ACTION_CONFIRM"
            android:layout_below="@+id/edit_layout"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.basebuild.notice.VoiceEditNoticeDialog>
