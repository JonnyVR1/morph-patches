<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetCpView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetCpView">
    <com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetSmoothSpeedRecycle
        android:id="@+id/cp_recycle"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="242dp"
        android:layout_marginTop="33dp"
        android:divider="@null"
        android:overScrollMode="never"/>
    <p151v.VRelative
        android:id="@+id/brand_layout"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        flatten="true">
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#f8591c"
            android:id="@+id/level_name"
            android:background="0x7f08281e"
            android:paddingLeft="6dp"
            android:paddingTop="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_VOICE_CP_HOUSE_LEVEL"
            android:fontFamily="PingFangSC-Medium"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#f8591c"
            android:id="@+id/hosue_level"
            android:paddingTop="17dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"
            android:fontFamily="PingFangSC-Medium"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="#f8591c"
            android:id="@+id/reward_tv"
            android:background="0x7f08281f"
            android:paddingLeft="6dp"
            android:paddingTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/LIVE_VOICE_CP_HOUSE_REWARDS"
            android:fontFamily="PingFangSC-Medium"/>
        <p151v.VImage
            android:id="@+id/reward_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="65dp"
            android:layout_marginTop="45dp"
            android:src="0x7f082838"/>
    </p151v.VRelative>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#99f8591c"
        android:gravity="center"
        android:id="@+id/my_task_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="20dp"
        android:singleLine="true"
        android:layout_below="@+id/cp_recycle"
        android:layout_centerHorizontal="true"
        android:fontFamily="PingFangSC-Medium"/>
    <p151v.VRecyclerView
        android:id="@+id/users_task_recycle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/my_task_title"
        android:overScrollMode="never"/>
    <include
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="295dp"
        android:layout_centerHorizontal="true"
        layout="@layout/live_voice_sweet_error_layout"/>
    <com.p051p1.mobile.putong.live.livingroom.virtual.roomInfo.view.SvgAndImageView
        android:id="@+id/newEntraceView"
        android:visibility="invisible"
        android:layout_width="41dp"
        android:layout_height="41dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="11dp"
        android:layout_alignParentEnd="true"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.sweet.view.VoiceSweetCpView>
