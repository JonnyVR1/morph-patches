<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.TreasureBoxView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="44dp"
    android:layout_height="38dp"
    flatten="true"
    folder="common"
    holder="bottom.TreasureBoxView">
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:background="@drawable/live_bg_black_r12_a15"
        android:layout_width="44dp"
        android:layout_height="38dp"
        android:scaleType="center"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="30dp"
        android:layout_height="14dp"
        android:layout_marginTop="20dp">
        <com.p051p1.mobile.putong.live.base.view.CountdownGiftProgressView
            android:id="@+id/progress"
            android:layout_width="30dp"
            android:layout_height="14dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/time"
        android:layout_width="30dp"
        android:layout_height="14dp"
        android:layout_marginTop="20dp"/>
    <View
        android:layout_gravity="top|right"
        android:id="@+id/red_dot"
        android:background="@drawable/live_bg_ff3938_r3"
        android:visibility="visible"
        android:layout_width="8dp"
        android:layout_height="8dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.TreasureBoxView>
