<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pic_verify"
    android:background="@drawable/pic_verification_bg"
    android:paddingLeft="16dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:visibility="visible"
    android:minHeight="40dp"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileVerifyViewHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VImage
        android:id="@+id/pic_verify_flag"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="0x7f082095"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"/>
    <p151v.VImage
        android:id="@+id/pic_verify_arrow"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginRight="18dp"
        android:src="0x7f080246"
        android:scaleType="fitXY"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#dcffffff"
        android:id="@+id/pic_verify_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_toLeftOf="@+id/pic_verify_arrow"
        android:layout_toRightOf="@+id/pic_verify_flag"
        android:layout_centerVertical="true"/>
</RelativeLayout>
