<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.LiveGiftWallGiftListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment"
    holder="gift.giftwallnew.LiveGiftWallGiftListItemView">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/more_bt"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f0822f3"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group1"
        android:layout_width="0dp"
        android:layout_height="109dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toStartOf="@+id/group2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/live_item1_bg"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintCircleRadius="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/unlock_mask1"
            android:background="@drawable/live_bg_19191e_r10_a60"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_item1_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item1_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item1_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item1_bg"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/live_item1_svga_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/live_item1_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item1_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item1_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item1_bg"/>
        <View
            android:id="@+id/live_user_icon1_bg"
            android:visibility="gone"
            android:layout_width="19dp"
            android:layout_height="19dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_user_icon1"
            app:layout_constraintEnd_toEndOf="@+id/live_user_icon1"
            app:layout_constraintStart_toStartOf="@+id/live_user_icon1"
            app:layout_constraintTop_toTopOf="@+id/live_user_icon1"/>
        <p151v.VDraweeView
            android:id="@+id/live_user_icon1"
            android:visibility="gone"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/live_item1_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item1_bg"
            app:roundAsCircle="true"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_item1_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item1_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item1_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item1_bg">
            <p151v.VDraweeView
                android:id="@+id/live_gift_icon1"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:id="@+id/live_gift_name1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"/>
            <include
                android:id="@+id/live_gift_five_star1"
                android:layout_width="wrap_content"
                android:layout_height="11.2dp"
                android:layout_marginTop="5.4dp"
                layout="@layout/live_gift_wall_five_star_view"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group2"
        android:layout_width="0dp"
        android:layout_height="109dp"
        android:layout_marginLeft="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/group3"
        app:layout_constraintStart_toEndOf="@+id/group1"
        app:layout_constraintTop_toTopOf="@+id/group1"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/live_item2_bg"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/unlock_mask2"
            android:background="@drawable/live_bg_19191e_r10_a60"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_item2_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item2_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item2_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item2_bg"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/live_item2_svga_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/live_item2_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item2_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item2_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item2_bg"/>
        <View
            android:id="@+id/live_user_icon2_bg"
            android:visibility="gone"
            android:layout_width="19dp"
            android:layout_height="19dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/live_user_icon2"
            app:layout_constraintEnd_toEndOf="@+id/live_user_icon2"
            app:layout_constraintStart_toStartOf="@+id/live_user_icon2"
            app:layout_constraintTop_toTopOf="@+id/live_user_icon2"/>
        <p151v.VDraweeView
            android:id="@+id/live_user_icon2"
            android:visibility="gone"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/live_item2_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item2_bg"
            app:roundAsCircle="true"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_item2_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item2_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item2_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item2_bg">
            <p151v.VDraweeView
                android:id="@+id/live_gift_icon2"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:id="@+id/live_gift_name2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"/>
            <include
                android:id="@+id/live_gift_five_star2"
                android:layout_width="wrap_content"
                android:layout_height="11.2dp"
                android:layout_marginTop="5.4dp"
                layout="@layout/live_gift_wall_five_star_view"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group3"
        android:layout_width="0dp"
        android:layout_height="109dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/group2"
        app:layout_constraintTop_toTopOf="@+id/group1"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/live_item3_bg"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintCircleRadius="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/unlock_mask3"
            android:background="@drawable/live_bg_19191e_r10_a60"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_item3_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item3_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item3_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item3_bg"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/live_item3_svga_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/live_item3_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item3_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item3_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item3_bg"/>
        <View
            android:id="@+id/live_user_icon3_bg"
            android:visibility="gone"
            android:layout_width="19dp"
            android:layout_height="19dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_user_icon3"
            app:layout_constraintEnd_toEndOf="@+id/live_user_icon3"
            app:layout_constraintStart_toStartOf="@+id/live_user_icon3"
            app:layout_constraintTop_toTopOf="@+id/live_user_icon3"/>
        <p151v.VDraweeView
            android:id="@+id/live_user_icon3"
            android:visibility="gone"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/live_item3_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item3_bg"
            app:roundAsCircle="true"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_item3_bg"
            app:layout_constraintEnd_toEndOf="@+id/live_item3_bg"
            app:layout_constraintStart_toStartOf="@+id/live_item3_bg"
            app:layout_constraintTop_toTopOf="@+id/live_item3_bg">
            <p151v.VDraweeView
                android:id="@+id/live_gift_icon3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:actualImageScaleType="fitXY"
                app:roundingBorderColor="@color/live_transparent"
                app:roundingBorderWidth="1dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/live_white_80_opacity"
                android:id="@+id/live_gift_name3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"/>
            <include
                android:id="@+id/live_gift_five_star3"
                android:layout_width="wrap_content"
                android:layout_height="11.2dp"
                android:layout_marginTop="5.4dp"
                layout="@layout/live_gift_wall_five_star_view"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.LiveGiftWallGiftListItemView>
