<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ff19191e"
    android:layout_width="match_parent"
    android:layout_height="480dp">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/LIVE_MLN_GUEST_LIST_TITLE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="20dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <p151v.VDraweeView
        android:id="@+id/refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="20dp"
        android:src="0x7f0823a3"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <View
        android:id="@+id/line"
        android:background="#0df9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/user_list"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:id="@+id/count_popularity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_list"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gift_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/count_popularity"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/full_emptyView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyView"
            android:visibility="visible"
            android:layout_width="100dp"
            android:layout_height="75dp"
            android:src="0x7f082397"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white_30_opacity"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/LIVE_MLN_GUEST_LIST_NO_ONE_SEND"
            android:lineSpacingExtra="0sp"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/gift_emptyView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/count_popularity">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:visibility="visible"
            android:layout_width="100dp"
            android:layout_height="75dp"
            android:src="0x7f082397"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white_30_opacity"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/LIVE_MLN_GUEST_LIST_NO_ONE_SEND"
            android:lineSpacingExtra="0sp"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
