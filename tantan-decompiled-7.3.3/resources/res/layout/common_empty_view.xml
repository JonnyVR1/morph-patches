<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.CommonEmptyView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.CommonEmptyView">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/img_empty"
        android:layout_width="220dp"
        android:layout_height="150dp"
        android:src="0x7f081fde"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#9aa5b1"
        android:gravity="center"
        android:id="@+id/txt_tip"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/MOMENT_ME_NO_MOMENT"
        android:lineSpacingExtra="4dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.CommonEmptyView>
