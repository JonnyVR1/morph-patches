<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.drawgift.DrawGiftContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.drawgift.DrawGiftContainer">
    <View
        android:id="@+id/top_bg"
        android:background="@color/live_black_30_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/top_layer"
        android:background="#d9000000"
        android:layout_width="match_parent"
        android:layout_height="99dp"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#7fffffff"
        android:id="@+id/moban"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/LIVE_GIFT_DRAW"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_layer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_goneMarginBottom="12dp"/>
    <p151v.VImage
        android:id="@+id/icon_first"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginLeft="10dp"
        android:src="0x7f082288"
        app:layout_constraintBottom_toBottomOf="@+id/moban"
        app:layout_constraintLeft_toRightOf="@+id/moban"
        app:layout_constraintTop_toTopOf="@+id/moban"/>
    <p151v.VImage
        android:id="@+id/icon_second"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginLeft="10dp"
        android:src="0x7f08228a"
        app:layout_constraintLeft_toRightOf="@+id/icon_first"
        app:layout_constraintTop_toTopOf="@+id/icon_first"/>
    <p151v.VImage
        android:id="@+id/icon_third"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginLeft="10dp"
        android:src="0x7f08228b"
        app:layout_constraintLeft_toRightOf="@+id/icon_second"
        app:layout_constraintTop_toTopOf="@+id/icon_first"/>
    <p151v.VImage
        android:id="@+id/icon_forth"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginLeft="10dp"
        android:src="0x7f082289"
        app:layout_constraintLeft_toRightOf="@+id/icon_third"
        app:layout_constraintTop_toTopOf="@+id/icon_first"/>
    <p151v.VImage
        android:id="@+id/close"
        android:padding="10dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:src="0x7f0822c7"
        app:layout_constraintBottom_toBottomOf="@+id/moban"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/moban"/>
    <p151v.VImage
        android:id="@+id/undo"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="0x7f0822ce"
        app:layout_constraintRight_toLeftOf="@+id/close"
        app:layout_constraintTop_toTopOf="@+id/close"/>
    <p151v.VImage
        android:id="@+id/delete"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="0x7f0822c8"
        app:layout_constraintRight_toLeftOf="@+id/undo"
        app:layout_constraintTop_toTopOf="@+id/close"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.drawgift.DrawPanelView
        android:id="@+id/panel"
        android:background="@drawable/live_shape_draw_dialog_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_top_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_layer"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/guide_svga"
        android:layout_width="270dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="@+id/panel"
        app:layout_constraintLeft_toLeftOf="@+id/panel"
        app:layout_constraintRight_toRightOf="@+id/panel"
        app:layout_constraintTop_toTopOf="@+id/panel"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:id="@+id/guide_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="241dp"
        android:text="@string/LIVE_GIFT_DRAW_DESCRIBE_NEW"
        app:layout_constraintLeft_toLeftOf="@+id/panel"
        app:layout_constraintRight_toRightOf="@+id/panel"
        app:layout_constraintTop_toTopOf="@+id/guide_svga"/>
    <View
        android:id="@+id/bottom_top_bg"
        android:background="@color/live_black_50_opacity"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        app:layout_constraintTop_toTopOf="@+id/bottom_top_space"/>
    <View
        android:id="@+id/bottom_bg"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/send_space"/>
    <Space
        android:id="@+id/bottom_top_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bg"/>
    <Space
        android:id="@+id/send_space"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toTopOf="@+id/send_hint"/>
    <p151v.VText
        android:textSize="20dp"
        android:textColor="@color/white"
        android:id="@+id/send_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_pager"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VPager
        android:id="@+id/gift_pager"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/records"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <p151v.VPagerCircleIndicator
        android:id="@+id/indicator"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:fillColor="#b3ffffff"
        app:layout_constraintBottom_toBottomOf="@+id/records"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/records"
        app:pageColor="#33ffffff"
        app:radius="3dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/records"
        android:layout_width="52dp"
        android:layout_height="50dp"
        android:text="@string/LIVE_GIFT_BILL"
        android:lines="1"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ff8817"
        android:gravity="center"
        android:id="@+id/charge"
        android:layout_width="52dp"
        android:layout_height="50dp"
        android:text="@string/LIVE_GIFT_RECHARGE"
        android:lines="1"
        android:drawableEnd="0x7f0822ca"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.drawgift.DrawGiftContainer>
