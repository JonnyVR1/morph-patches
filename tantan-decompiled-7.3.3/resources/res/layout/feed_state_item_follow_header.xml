<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="14dp"
    folder="newui"
    holder="status.entrance.followheader.FeedStateHeaderItem">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.p051p1.mobile.putong.feed.newui.status.entrance.followheader.FeedVDraweeView
            android:id="@+id/head"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/feed_nearby_topic_color"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="48dp"
            android:maxLines="1"/>
    </p151v.VLinear>
    <p151v.VDraweeView
        android:id="@+id/state_bg"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="23dp"/>
    <p151v.VDraweeView
        android:id="@+id/state_bg_two"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginLeft="29dp"
        android:layout_marginTop="26dp"/>
    <p151v.VDraweeView
        android:id="@+id/state"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="27dp"/>
</p151v.VFrame>
