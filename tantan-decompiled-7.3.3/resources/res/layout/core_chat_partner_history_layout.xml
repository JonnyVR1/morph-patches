<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="partner.ChatPartnerHistoryViewModel">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f0806d1"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="21sp"
            android:textColor="#cc000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信号记录"
            android:layout_marginStart="4dp"/>
    </p151v.VLinear>
    <p151v.VRecyclerView
        android:orientation="vertical"
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="54dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0806d3"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#26000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="暂无记录"/>
    </p151v.VLinear>
</p151v.VFrame>
