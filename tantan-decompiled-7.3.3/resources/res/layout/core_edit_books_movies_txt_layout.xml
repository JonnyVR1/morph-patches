<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/book_movies"
    android:background="@color/white"
    android:paddingTop="15dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.profilelist.itemholders.EditBookMoviesTxtExpandedHolder"
    needPublic="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="我的书影剧"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            app:fontWeight="600"/>
        <p151v.VImage
            android:id="@+id/book_movies_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08145e"
            android:layout_marginEnd="20dp"/>
    </p151v.VLinear>
    <p151v.VRecyclerView
        android:orientation="vertical"
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="20dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/add_books_movies_dramas"
        android:background="@drawable/core_bg_10_000000_stroke_3percent000000_w_3"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="14dp">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f08144e"/>
        <p151v.VText_NoTopPadding
            android:textSize="14sp"
            android:textColor="#cc000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="16dp"
            android:text="添加书影剧"
            android:layout_weight="500"/>
    </p151v.VLinear>
</p151v.VLinear_Dividers>
