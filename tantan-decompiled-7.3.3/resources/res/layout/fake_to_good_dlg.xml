<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="180dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/fake_forbidden_back_shape"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:layout_marginRight="50dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/me"
                android:layout_width="110dp"
                android:layout_height="110dp"
                fresco:roundAsCircle="true"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/fake_forbidden_back_shape"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:layout_marginLeft="50dp">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/other"
                android:layout_width="110dp"
                android:layout_height="110dp"
                fresco:roundAsCircle="true"/>
        </FrameLayout>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f081f68"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="19sp"
        android:textColor="#de000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/FAKE2GOOD_DIALOG_TITLE"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#8a000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/FAKE2GOOD_DIALOG_SUBTITLE"/>
</LinearLayout>
