<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal.vchat.module.webview"
    holder="LiveVChatWebViewDialog">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.webview.LiveMkWebView
            android:scrollbarSize="0px"
            android:id="@+id/liveWebView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="1px"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f0803d5"/>
    </androidx.cardview.widget.CardView>
</p151v.VFrame>
