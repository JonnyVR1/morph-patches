<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/root"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="138dp"
    flatten="true"
    holder="profile.profilelist.buttons.layout.expanded.ExpNormalButtonLayout">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/buttons_bg"
        android:background="@drawable/core_profile_buttons_bg_expand"
        android:layout_width="match_parent"
        android:layout_height="138dp"/>
    <p151v.VLinear
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:divider="@drawable/core_profile_botton_exp_divider_normal"
        android:showDividers="middle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_goneMarginLeft="0dp">
        <RelativeLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/like_and_dislike_refactor"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VLinear
                android:id="@+id/btn_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@drawable/core_profile_botton_exp_divider_normal"
                android:layout_alignParentBottom="true"
                android:showDividers="middle"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot
                    android:id="@+id/dislike_shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    app:opBgColor="#bfc6ce"
                    app:squareModel="true"
                    flatten="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/dislike"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        flatten="true">
                        <p151v.VImage
                            android:id="@+id/dislike_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="0x7f081147"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot>
                <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot
                    android:id="@+id/superlike_shadow"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerInParent="true"
                    app:opBgColor="#5978fc"
                    app:squareModel="true"
                    flatten="true">
                    <p151v.VFrame_FlipContainer
                        android:layout_gravity="center"
                        android:id="@+id/superlike"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        flatten="true">
                        <p151v.VImage
                            android:layout_gravity="center"
                            android:id="@+id/superlike_btn"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="0x7f08205d"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                        <p151v.VText
                            android:textSize="22sp"
                            android:textColor="#5978fc"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/superlike_turn_tv"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="32"
                            app:typeface="medium"/>
                    </p151v.VFrame_FlipContainer>
                </com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot>
                <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot
                    android:id="@+id/like_shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/superlike_shadow"
                    android:layout_alignParentBottom="true"
                    app:opBgColor="#eb1a7c"
                    app:squareModel="true"
                    flatten="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/like"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        flatten="true">
                        <p151v.VImage
                            android:id="@+id/like_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="0x7f082059"
                            android:scaleType="centerCrop"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot>
            </p151v.VLinear>
        </RelativeLayout>
        <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/superlike_shadow_single"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:opBgColor="#5978fc"
            app:squareModel="false"
            flatten="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:layout_width="132dp"
                android:layout_height="48dp">
                <p151v.VImage
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="20dp"
                    android:src="0x7f08205d"
                    android:scaleType="centerCrop"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:id="@+id/superlike_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:text="超级喜欢"/>
            </p151v.VLinear>
        </com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot>
        <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonLinearRoot
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/match"
            android:layout_width="132dp"
            android:layout_height="48dp"
            app:opBgColorLinear="#2d1a07"
            app:squareModelLinear="false"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f08205a"
                android:scaleType="centerCrop"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.widget.LetterRemainingSwitcherView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/match_remaining_switch"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                app:contentTextBold="true"
                app:contentTextColor="#e8ca8a"
                app:contentTextSize="14sp"
                app:interval="2000"/>
        </com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonLinearRoot>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/chat_shadow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        app:opBgColor="#ff700a"
        app:squareModel="true"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/chat_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/chat_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f081446"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </com.p051p1.mobile.putong.core.p058ui.profile.profilelist.buttons.layout.expanded.view.ExpProfileOpButtonRoot>
</FrameLayout>
