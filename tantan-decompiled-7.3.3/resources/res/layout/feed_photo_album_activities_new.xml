<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="photoalbum.photoalbumactivities.tab.FeedPhotoAlbumActivitiesContainTabViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:pointerIcon="text"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.feed.newui.photoalbum.photoalbumactivities.PhotoAlbumInterestedHeaderView
        android:id="@+id/head_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginRight="12dp">
        <com.p051p1.mobile.putong.feed.newui.photoalbum.photoalbumactivities.tab.FeedActivitiesTabLayout
            android:layout_gravity="center"
            android:id="@+id/tabs"
            android:background="@color/white"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:tabBackground="@color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="0dp"
            app:tabMinWidth="50dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/transparent"
            style="@style/feedNoPaddingTabLayout"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#fe7e1d"
            android:layout_gravity="center"
            android:id="@+id/flower_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="0x7f081eb1"/>
    </FrameLayout>
    <p151v.VPager
        android:id="@+id/pager"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</p151v.VLinear>
