<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.voice.entry.VoiceConversationsEntry xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversation_entry_all_layout"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="voice"
    holder="entry.VoiceConversationsEntry">
    <RelativeLayout
        android:id="@+id/conversation_entry_main_layout"
        android:background="0x7f08277e"
        android:paddingLeft="34dp"
        android:layout_width="214dp"
        android:layout_height="72dp"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/voice_title"
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/LIVE_VOICE_CHAT_ROOM_PAGE"
            android:lines="1"/>
        <p151v.VMarqueeText
            android:textSize="12sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="marquee"
            android:id="@+id/voice_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:maxWidth="105dp"
            android:text="@string/LIVE_VOICE_MANY_PEOPLE_ONLINE_CHAT"
            android:singleLine="true"
            android:layout_below="@+id/voice_title"
            android:layout_alignLeft="@+id/voice_title"
            android:marqueeRepeatLimit="marquee_forever"/>
        <com.p051p1.mobile.putong.live.external.voice.entry.VoiceFeedEntryFloatingAnim
            android:id="@+id/voice_user_avatar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/voice_des"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <p151v.VImage
            android:id="@+id/voice_default_avatar"
            android:background="@drawable/live_shape_voice_conversation_entry_avatar_bg"
            android:padding="2dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="7dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="0x7f082781"/>
    </RelativeLayout>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/num_red_dot"
        android:background="@drawable/live_shape_bg_activities_red_dot_text"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="4dp"
        android:minWidth="17dp"
        android:minHeight="17dp"/>
    <p151v.VImage
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="5dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/live_shape_circle_red_dot"/>
</com.p051p1.mobile.putong.live.external.voice.entry.VoiceConversationsEntry>
