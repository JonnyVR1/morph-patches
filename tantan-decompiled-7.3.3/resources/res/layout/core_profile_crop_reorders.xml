<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/crop_linear"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#d34530"
        android:id="@+id/pic_text"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/NEW_PROFILE_PICTURE_EDIT_TITLE"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.MediaReorderCards
        android:id="@+id/reorders"
        android:paddingLeft="20dp"
        android:paddingTop="0dp"
        android:paddingRight="10dp"
        android:paddingBottom="0dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/pic_text"
        app:cardNums="6"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/avatar_tag"
        android:background="@drawable/core_crop_profile_tag_bg"
        android:paddingLeft="7dp"
        android:paddingTop="5dp"
        android:paddingRight="7dp"
        android:paddingBottom="5dp"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="6dp"
        android:text="@string/EDIT_PROFILE_USER_COVER_TEXT"
        android:layout_alignLeft="@+id/reorders"
        android:layout_alignTop="@+id/reorders"
        android:paddingHorizontal="7dp"
        android:paddingVertical="5dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_grey_04"
        android:gravity="center"
        android:id="@+id/crop_tip_text"
        android:paddingTop="4dp"
        android:paddingBottom="22dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/NEW_PROFILE_PICTURE_DRAG_HINT"
        android:layout_below="@+id/reorders"/>
</RelativeLayout>
