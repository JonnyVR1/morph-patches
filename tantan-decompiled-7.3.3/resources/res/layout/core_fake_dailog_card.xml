<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.fakecard.FakeDailogCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    holder="fakecard.FakeDailogCard">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VDraweeView
            android:id="@+id/fake_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/iv_icon"
            android:background="0x7f08081c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dailog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="30dp"
            android:text="@string/INTL_FAKEUSER_NOTICECARD_TITLE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#66000000"
            android:gravity="center_horizontal"
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="20dp"
            android:text="@string/INTL_FAKEUSER_NOTICECARD_TEXT"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dailog_title"/>
        <p151v.VDraweeView
            android:id="@+id/fake_center_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_update"
            app:layout_constraintDimensionRatio="359:286"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#f2aa7e"
            android:gravity="center"
            android:id="@+id/tv_update"
            android:background="@drawable/core_fake_dailog_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="39dp"
            android:text="@string/INTL_FAKEUSER_NOTICECARD_BUTTON"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.fakecard.FakeDailogCard>
