<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.PictureView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="PictureView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"
        useId="true"/>
    <p151v.VDraweeView
        android:id="@+id/image_center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"
        useId="true"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/image_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_mon"
        android:background="@color/core_color_4c000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/mon_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="137dp"
            android:src="0x7f080979"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#66ffffff"
            android:id="@+id/mon_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="聊满20回合就可以解锁对方头像了"/>
    </LinearLayout>
    <include layout="@layout/media_control_button"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/left_top_images"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        useId="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/online_tag"
            android:background="@drawable/core_svip_online_tag_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="8dp"
            android:minHeight="24dp"
            android:text="@string/HOME_TAB_ONLINE"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/picture_count"
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:paddingRight="7dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            android:drawableLeft="0x7f0805e3"
            android:drawablePadding="5dp"
            app:typeface="medium"
            useId="true"/>
        <p151v.VImage
            android:id="@+id/moments"
            android:padding="3dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            android:src="0x7f08095f"
            useId="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ccffffff"
            android:gravity="center_vertical"
            android:layout_gravity="top|right"
            android:id="@+id/passby"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:minHeight="24dp"
            android:drawableLeft="0x7f0802db"
            android:drawablePadding="6dp"
            app:typeface="regular"
            useId="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/heart_confession"
        android:background="@drawable/core_svip_letter_bg_gradient"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="189dp"
        android:alpha="0"
        flatten="true"
        useId="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/heart_confession_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:singleLine="true"
            android:drawableLeft="0x7f0817fa"
            android:drawablePadding="4dp"
            useId="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/heart_confession_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:singleLine="true"
            useId="true"/>
    </LinearLayout>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_upload_photo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="false">
        <p151v.VImage
            android:id="@+id/profile_equity_icon"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/core_card_upload_photo_icon"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/profile_equity_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="20dp"
            android:text="再上传2张照片\10即可查看他的全部照片"
            android:includeFontPadding="false"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/profile_equity_btn"
            android:background="@drawable/common_button_btn_orange_medium"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="立即上传"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"/>
        <p151v.VImage
            android:id="@+id/upload_photo_top_image"
            android:layout_width="56dp"
            android:layout_height="68dp"
            android:src="0x7f0814d4"
            android:layout_alignParentTop="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#f6f7f8"
            android:gravity="center"
            android:id="@+id/upload_photo_tips"
            android:layout_width="246dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="32dp"
            android:text="@string/INVISIBLE_PHOTO_TIP"/>
        <RelativeLayout
            android:id="@+id/upload_photo_click"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VButton
                android:textSize="16sp"
                android:textColor="#f6f7f8"
                android:gravity="center"
                android:id="@+id/upload_photo"
                android:background="@drawable/common_button_btn_orange_medium"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/INVISIBLE_PHOTO_PROFILE_BUTTON"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </p151v.VLinear>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/ll_big_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginRight="20dp"
        flatten="true">
        <View
            android:id="@+id/view_top_large"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="18dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/iv_right_largetag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <p151v.VDraweeView
        android:layout_gravity="end"
        android:id="@+id/peg_tag"
        android:visibility="gone"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="20dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
</com.p051p1.mobile.putong.core.p058ui.PictureView>
