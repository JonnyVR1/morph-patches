<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemFeedStates xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true">
    <FrameLayout
        android:id="@+id/state"
        android:background="@drawable/core_group_msg_left_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="?attr/core_msg_layout_padding_left">
        <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/state_content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:isLeft="true">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginVertical="10dp">
                <p151v.VDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/emoji"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    app:roundBottomLeft="true"
                    app:roundBottomRight="true"
                    app:roundTopLeft="true"
                    app:roundTopRight="true"
                    app:roundedCornerRadius="@dimen/core_common_radius"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="14dp">
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="@color/core_gray_4c4c4c"
                        android:ellipsize="end"
                        android:id="@+id/emoji_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxWidth="192dp"
                        android:singleLine="true"/>
                </p151v.VLinear>
            </p151v.VLinear>
        </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/empty_state"
        android:background="@drawable/core_messages_feed_states_empty_backgroud"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="?attr/core_msg_layout_padding_left">
        <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth
            android:gravity="center_vertical"
            android:id="@+id/state_empty_content"
            android:layout_width="144dp"
            android:layout_height="match_parent"
            app:isLeft="true">
            <p151v.VImage
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="0x7f08075b"
                android:layout_marginStart="10dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="#33000000"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态已结束"
                android:layout_marginStart="4dp"/>
        </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth>
    </FrameLayout>
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemText
        android:textColorLink="@color/white"
        android:autoLink="web"
        android:id="@+id/text"
        android:paddingTop="?attr/left_msg_top_padding"
        android:paddingBottom="?attr/left_msg_bottom_padding"
        android:lineSpacingExtra="1.5dp"
        android:paddingStart="?attr/left_msg_left_padding"
        android:paddingEnd="?attr/left_msg_right_padding"
        app:enableEmojis="true"
        app:largeEmojis="true"
        style="@style/messages_item_left"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemFeedStates>
