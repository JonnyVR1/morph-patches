<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedBasicInfoRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.ProfileListAdmobCardExpandeHolder">
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundFrameLayout
        android:id="@+id/ad_container"
        android:background="@color/color_text_ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rRadius="16dp"/>
    <com.p051p1.mobile.putong.core.util.view.RoundTextView
        android:textSize="11sp"
        android:textColor="@color/color_text_ffffff"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/tv_ad"
        android:background="@color/common_000000_30"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:layout_margin="8dp"
        android:text="AD"
        app:rRadius="6dp"/>
</com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedBasicInfoRootLayout>
