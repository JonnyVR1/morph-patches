<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="view.SvipTrialDlg">
    <p151v.VFrame
        android:layout_gravity="center"
        android:background="@drawable/common_view_popup_bg"
        android:layout_width="311dp"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="0x7f081844"/>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">
            <p151v.VText
                android:textSize="18sp"
                android:textColor="#323232"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="限时特惠"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:typeface="medium"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="0x7f081843"
                android:layout_width="279dp"
                android:layout_height="90dp"
                android:layout_marginTop="20dp">
                <p151v.VImage
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_marginLeft="11dp"
                    android:src="0x7f081845"
                    android:scaleType="centerCrop"/>
                <View
                    android:background="@drawable/core_svip_trail_item"
                    android:layout_width="3dp"
                    android:layout_height="54dp"
                    android:layout_marginLeft="11dp"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp">
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="#cc000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:text="1元秒杀7天SVIP"
                        app:typeface="medium"/>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#66000000"
                        android:id="@+id/sub_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1元秒杀7天SVIP"
                        app:typeface="medium"/>
                </p151v.VLinear>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn"
                android:background="@drawable/common_button_btn_orange_medium"
                android:layout_width="263dp"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="32dp"
                android:text="立即领取"/>
        </p151v.VLinear>
    </p151v.VFrame>
</p151v.VFrame>
