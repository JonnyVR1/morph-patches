<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="mediaoperation.mediapicker.MediaPickerFrag">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/tool_bar"
        android:background="@drawable/album_preview_head_bg"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">
        <ImageView
            android:id="@+id/title_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:src="0x7f0803a8"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/title_name"
            android:background="@drawable/tf_circle_light"
            android:paddingRight="1dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="21dp"
            android:maxWidth="240dp"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/title_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f082903"
            android:layout_toRightOf="@+id/title_name"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <include
        layout="@layout/include_album_request_permission"
        merge="true"/>
    <FrameLayout
        android:id="@+id/album_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VRecyclerView
            android:id="@+id/photo_recycler_view"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="50dp"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/folder_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/common_folder_select_view"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:id="@+id/bottom_bar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            flatten="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:gravity="center"
                android:id="@+id/preview"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ACTION_PREVIEW"/>
            <p151v.VButton
                android:textSize="14sp"
                android:textColor="@color/button_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/title_done"
                android:background="@drawable/common_post_media_btn_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/common_button_small"/>
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>
