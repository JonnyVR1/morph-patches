<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice"
    holder="grabhat.view.GrabHatMatchedViewModel">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/live_bg_19191e_tr24"
        android:paddingBottom="46dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/LIVE_CONGRATULATE_MATCH"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="64dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="64dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/match_container"
            android:background="@drawable/live_bg_white_r14_a05"
            android:paddingTop="20dp"
            android:paddingBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@+id/content"
            flatten="true">
            <View
                android:id="@+id/left_bg"
                android:background="0x7f0822f8"
                android:layout_width="134dp"
                android:layout_height="61dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/matched_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
                android:id="@+id/cp_left"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:layout_constraintRight_toRightOf="@+id/left_bg"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/matched_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0822f7"
                app:layout_constraintBottom_toBottomOf="@+id/left_bg"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/left_bg"/>
            <View
                android:id="@+id/right_bg"
                android:background="0x7f0822f9"
                android:layout_width="134dp"
                android:layout_height="61dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/matched_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
                android:id="@+id/cp_right"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:layout_constraintLeft_toLeftOf="@+id/right_bg"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
