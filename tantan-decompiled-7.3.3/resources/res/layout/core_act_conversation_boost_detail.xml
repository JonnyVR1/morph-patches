<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="messages.ConversationBoostDetailAct">
    <p151v.VDraweeView
        android:id="@+id/vd_spotlight_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="39dp"
        android:src="0x7f080562"
        android:scaleType="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:background="0x7f0816e4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/tv_tip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/INTL_SPOTLIGHT_NAME"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/tv_tip_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="20dp"
        android:text="@string/INTL_SPOTLIGHT_INSTRUCT"
        android:includeFontPadding="false"
        android:lineHeight="23dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_title"/>
    <p151v.VPager
        android:id="@+id/images"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="35dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="146dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_content"/>
    <com.p051p1.mobile.putong.core.newui.home.NewPictureContainerIndicator
        android:layout_gravity="bottom"
        android:id="@+id/image_indicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:indicatorColor="#33ffffff"
        app:indicatorMargin="3dp"
        app:indicatorSelectedColor="@color/white"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"
        app:layout_constraintTop_toTopOf="@+id/images"/>
    <View
        android:background="@drawable/core_spotlight_grey_bg"
        android:layout_width="0dp"
        android:layout_height="176dp"
        app:layout_constraintBottom_toBottomOf="@+id/images"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"/>
    <include
        android:id="@+id/card_baseinfo_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/usercontent_view"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"
        layout="@layout/core_card_bottom_basic_info"/>
    <include
        android:id="@+id/usercontent_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/images"
        app:layout_constraintLeft_toLeftOf="@+id/images"
        app:layout_constraintRight_toRightOf="@+id/images"
        layout="@layout/core_card_user_content_view"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#45d2ff"
        android:gravity="center"
        android:id="@+id/tv_sendmsg"
        android:background="@drawable/core_spotlight_sendmsg"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="64dp"
        android:text="@string/MATCH_BUTTON_START_A_CONVERSATION"
        app:layout_constraintTop_toBottomOf="@+id/images"/>
</androidx.constraintlayout.widget.ConstraintLayout>
