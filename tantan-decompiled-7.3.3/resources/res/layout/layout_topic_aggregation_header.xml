<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="topic.topicaggregation.TopicAggregationHeaderView">
    <p151v.VDraweeView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/feed_picks_showcase_composite_picture_load_fail"
        app:failureImageScaleType="centerCrop"
        app:placeholderImage="@color/picks_showcase_dialog_top_image_default_color"
        app:placeholderImageScaleType="centerCrop"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="12dp">
        <p151v.VDraweeView
            android:id="@+id/topic_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4a4a4a"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/FEED_TANTAN_TOPIC"
            android:layout_weight="1"
            android:lineSpacingExtra="0sp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#aaaaaa"
            android:layout_gravity="center_vertical"
            android:id="@+id/create_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#4a4a4a"
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"/>
    <View
        android:background="#f8f7f7"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="15dp"/>
</LinearLayout>
