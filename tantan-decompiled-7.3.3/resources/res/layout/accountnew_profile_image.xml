<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:importantForAutofill="noExcludeDescendants"
    holder="accountnew.SignUpProfileImageViewModel"
    style="@style/account_account_root">
    <p151v.VScroll
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/buttons"
        android:layout_below="@+id/toolbar"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="24dp"
                android:textColor="@color/common_black_01"
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="92dp"
                android:text="@string/SIGN_UP_IMAGE_UPLOAD_TITLE"
                app:layout_constraintTop_toBottomOf="@+id/toolbar"
                app:typeface="medium"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/add_photo"
                android:background="@drawable/common_card_middle_02_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/label"
                flatten="true">
                <p151v.VImage
                    android:layout_width="match_parent"
                    android:layout_height="206dp"
                    android:src="0x7f080140"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/common_grey_03"
                    android:gravity="center"
                    android:id="@+id/guide_text"
                    android:paddingLeft="23dp"
                    android:paddingRight="23dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/SIGN_UP_IMAGE_UPLOAD_CONTENT"/>
                <p151v.VText
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/account_signup_semi_round_red_bg"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/SIGN_UP_PHOTO_HINT"/>
            </p151v.VLinear>
            <p151v.VDraweeView
                android:id="@+id/profile"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="344dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/label"
                app:roundedCornerRadius="16dp"
                flatten="true"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:background="@drawable/common_view_card_middle_01_bg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/add_photo">
                <p151v.VImage
                    android:id="@+id/model_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="0x7f080136"
                    android:scaleType="centerInside"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp"/>
                <p151v.VImage
                    android:id="@+id/model_mid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="0x7f080131"
                    android:scaleType="centerInside"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp"/>
                <p151v.VImage
                    android:id="@+id/model_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="0x7f08013f"
                    android:scaleType="centerInside"
                    android:layout_weight="1"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/buttons"
        android:background="@color/white"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <p151v.VText
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ACTION_START_TANTAN"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textColor="@color/common_orange"
            android:gravity="center"
            android:id="@+id/pic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/FB_SIGNUP_CONFIRM_PHOTO_BUTTON_CHANGE"/>
    </p151v.VLinear>
    <include
        android:id="@+id/toolbar"
        flatten="true"
        layout="@layout/account_sign_common_top_view"/>
</p151v.VRelative>
