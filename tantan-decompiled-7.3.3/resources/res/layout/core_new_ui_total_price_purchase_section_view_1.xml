<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUITotalPricePurchaseSectionView1 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.showcase.NewUITotalPricePurchaseSectionView1">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="121dp"
        android:layout_marginTop="12dp"
        flatten="true">
        <p151v.VText
            android:textSize="28sp"
            android:textColor="@color/core_vip_normal_title_text_color"
            android:gravity="center"
            android:id="@+id/quantity"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <FrameLayout
            android:id="@+id/top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            flatten="true">
            <p151v.VText_AutoFit
                android:textSize="13sp"
                android:textColor="@color/common_grey_01"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/top_price"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:typeface="medium"/>
            <p151v.VText_AutoFit
                android:textSize="13sp"
                android:textColor="@color/common_grey_01"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/top_price_promotion"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:typeface="medium"/>
        </FrameLayout>
        <Space
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <p151v.VText_AutoFit
            android:textSize="13sp"
            android:textColor="@color/common_grey_02"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:singleLine="true"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/label"
        android:paddingTop="1dp"
        android:visibility="invisible"
        android:layout_width="74dp"
        android:layout_height="24dp"
        android:maxLines="1"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUITotalPricePurchaseSectionView1>
