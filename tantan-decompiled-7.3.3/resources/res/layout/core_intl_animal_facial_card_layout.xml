<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.animalfacial.AnimalFacialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="0x7f080a25"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:paddingStart="4dp"
    android:paddingEnd="12dp"
    app:rRadius="25dp"
    flatten="true"
    holder="animalfacial.AnimalFacialCardView">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/image"
        android:background="@drawable/core_intl_anim_facial_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:actualImageScaleType="centerInside"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerCrop"
        app:roundAsCircle="true"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="24sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"/>
</com.p051p1.mobile.putong.core.p058ui.animalfacial.AnimalFacialCardView>
