<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        layout="@layout/messages_item_date_header"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/header_tip"
        android:background="@drawable/messages_message_recall"
        android:paddingLeft="9dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="10dp"
        app:typeface="medium"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/content_wrapper"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VRelative
            android:gravity="center_vertical"
            android:id="@+id/check_box_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignTop="@+id/profile_image_verfication"
            android:layout_alignBottom="@+id/profile_image_verfication"
            android:layout_alignParentLeft="true"
            android:layout_marginHorizontal="12dp">
            <p151v.VCheckBox
                android:id="@+id/pick_message"
                android:background="@drawable/core_message_select_checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@null"/>
        </p151v.VRelative>
        <p151v.VProgressBar
            android:id="@+id/sending"
            android:layout_marginEnd="?attr/message_send_error_margin"
            android:layout_toStartOf="@+id/message_container"
            style="@style/core_msg_sending_progress_style"/>
        <RelativeLayout
            android:id="@+id/message_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-4dp"
            android:layout_toStartOf="@+id/profile_image_verfication">
            <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/message_page_profile_right_pic_margin"
                app:isLeft="false">
                <include
                    android:layout_gravity="right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/core_ai_translate_msg_item"/>
                <p151v.VText
                    android:layout_gravity="right"
                    android:id="@+id/sent_from"
                    android:layout_marginBottom="6dp"
                    style="@style/core_messages_sent_from"/>
            </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth>
            <ImageView
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/error"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/core_msg_err_margin_top"
                android:src="?attr/message_send_error_icon"
                android:scaleType="centerCrop"
                android:layout_marginEnd="?attr/core_msg_err_margin_end"
                android:layout_toStartOf="@+id/frame"
                app:typeface="medium"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/profile_image_verfication"
            android:paddingTop="?attr/message_page_profile_right_pic_margin_top"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            style="?attr/message_avatar_style">
            <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
                android:id="@+id/profile_image"
                android:layout_marginTop="-4.5dp"
                app:show_audio_chat_frame="true"
                style="@style/core_message_item_right_image_frame"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/verification_icon"
                android:background="0x7f082957"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                useId="true"/>
        </FrameLayout>
    </RelativeLayout>
    <include
        android:layout_gravity="right"
        android:id="@+id/audio_translation"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="52dp"
        layout="@layout/core_audio_translation_view"/>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/read_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="52dp"
        flatten="true">
        <p151v.VText
            android:textSize="10sp"
            android:textStyle="normal"
            android:textColor="#33000000"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/left_read_state_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lines="1"
            android:layout_marginStart="4dp"/>
        <com.p051p1.mobile.putong.core.p058ui.messages.view.IntlMessageReadReceiptsView
            android:layout_gravity="center_vertical"
            android:id="@+id/intl_read_receipts"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/read_state_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:src="0x7f080fbe"/>
        <p151v.VText
            android:textSize="10sp"
            android:textStyle="normal"
            android:textColor="#33000000"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/read_state_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lines="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_greet_match"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="78dp"
        android:layout_marginRight="78dp"
        android:layout_marginBottom="10dp">
        <include layout="@layout/core_greet_match"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/footer_tip"
        android:background="@drawable/messages_message_recall"
        android:paddingLeft="9dp"
        android:paddingTop="4dp"
        android:paddingRight="9dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="14dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/footer_see_letter"
        android:background="@drawable/core_theme_profile_gerrt_match_bg"
        android:paddingLeft="9dp"
        android:paddingTop="4dp"
        android:paddingRight="9dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="10dp"
        android:text="@string/INTL_LETTER_AGAIN_SEND_TOAST"
        app:typeface="medium"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/layout_block_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="57dp"
        android:layout_marginRight="57dp"
        android:layout_marginBottom="10dp">
        <include layout="@layout/intl_messages_block_hint"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/quickaudio_tip"
        android:layout="@layout/core_messages_quickaudo_disturb_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="2dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageRight>
