<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.views.OnlineMatchDlgItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="dlg.views.OnlineMatchDlgItemView">
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:layout_width="74dp"
        android:layout_height="74dp">
        <com.p051p1.mobile.putong.core.newui.talk.view.NewTalkProgressView
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/header_img"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:cropToPadding="false"
            android:layout_centerInParent="true"
            app:placeholderImage="0x7f0812e7"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"
            style="@style/core_fresco_profile_small"/>
        <View
            android:layout_gravity="bottom|right"
            android:id="@+id/dot"
            android:background="@drawable/core_dlg_online_green_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="10dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxWidth="90dp"
        android:text="罗恩蛋糕"
        android:lines="1"/>
</com.p051p1.mobile.putong.core.p058ui.dlg.views.OnlineMatchDlgItemView>
