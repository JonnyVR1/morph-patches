<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.wealth.GiftWealthLevelView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    flatten="true"
    folder="increment"
    holder="gift.wealth.GiftWealthLevelView">
    <View
        android:id="@+id/progressBarBg"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/noble_entrance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/progressBarLayer"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/progressBarBg"
        app:layout_constraintEnd_toEndOf="@+id/progressBarBg"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/progressBarBg"
        app:layout_constraintTop_toTopOf="@+id/progressBarBg"/>
    <p151v.VDraweeView
        android:id="@+id/first_icon"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginStart="3dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/progressBarBg"
        app:layout_constraintStart_toStartOf="@+id/progressBarBg"
        app:layout_constraintTop_toTopOf="@+id/progressBarBg"/>
    <p151v.VDraweeView
        android:id="@+id/second_icon"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginStart="3dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/progressBarBg"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/help"
        android:layout_width="18dp"
        android:layout_height="14dp"
        android:src="0x7f0822f5"
        android:scaleType="fitXY"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/progressBarBg"
        app:layout_constraintEnd_toEndOf="@+id/progressBarBg"
        app:layout_constraintTop_toTopOf="@+id/progressBarBg"/>
    <include
        android:id="@+id/noble_entrance"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_gift_dialog_wealth_level_nobel_view"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tips"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/help"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tips_second"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/help"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/notice"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/help"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/first_icon"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.wealth.GiftWealthLevelView>
