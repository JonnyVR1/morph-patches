<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.recommend.view.NewMatchItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="65dp"
    android:layout_height="87dp"
    android:layout_marginEnd="9dp"
    folder="newui"
    holder="messages.recommend.view.NewMatchItemLayout">
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/first_avatar"
        android:clickable="false"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="7dp"
        android:alpha="1"
        style="@style/fresco_profile_small"/>
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/second_avatar"
        android:clickable="false"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="7dp"
        android:alpha="0"
        style="@style/fresco_profile_small"/>
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:id="@+id/chat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="39dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/chat_label_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08160c"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="9sp"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/chat_label_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="新配对"/>
    </p151v.VFrame>
    <com.p051p1.mobile.putong.core.newui.view.ShimmerOptLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/shimmer_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="13sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </com.p051p1.mobile.putong.core.newui.view.ShimmerOptLayout>
</com.p051p1.mobile.putong.core.newui.messages.recommend.view.NewMatchItemLayout>
