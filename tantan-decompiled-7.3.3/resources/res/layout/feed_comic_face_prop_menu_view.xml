<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    flatten="true"
    folder="newui"
    holder="kankan.view.FeedComicFacePropMenuView">
    <p151v.VText
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/feed_comic_face_time_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/feed_comic_face_record_btn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.p051p1.mobile.putong.feed.newui.kankan.view.FeedCircleProgressBar
        android:id="@+id/feed_comic_face_prop_selected"
        android:visibility="invisible"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/feed_comic_face_prop_view_pager"
        app:layout_constraintLeft_toLeftOf="@+id/feed_comic_face_prop_view_pager"
        app:layout_constraintRight_toRightOf="@+id/feed_comic_face_prop_view_pager"
        app:layout_constraintTop_toTopOf="@+id/feed_comic_face_prop_view_pager"
        app:normalColor="#fe7e1d"
        app:normalRadius="24dp"
        app:normalStrokeWidth="2.5dp"/>
    <com.p051p1.mobile.putong.feed.newui.kankan.view.FeedCircleProgressBar
        android:id="@+id/feed_comic_face_record_btn"
        android:clickable="true"
        android:layout_width="104dp"
        android:layout_height="104dp"
        app:layout_constraintBottom_toBottomOf="@+id/feed_comic_face_category_list"
        app:layout_constraintLeft_toLeftOf="@+id/feed_comic_face_category_list"
        app:layout_constraintRight_toRightOf="@+id/feed_comic_face_category_list"
        app:layout_constraintTop_toTopOf="@+id/feed_comic_face_category_list"
        app:normalColor="#ffffff"
        app:normalRadius="38dp"
        app:normalStrokeWidth="4dp"/>
    <ImageView
        android:id="@+id/feed_comic_face_del_btn"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f081ccd"
        app:layout_constraintBottom_toBottomOf="@+id/feed_comic_face_record_btn"
        app:layout_constraintLeft_toRightOf="@+id/feed_comic_face_record_btn"
        app:layout_constraintRight_toLeftOf="@+id/feed_comic_face_record_complete"
        app:layout_constraintTop_toTopOf="@+id/feed_comic_face_record_btn"/>
    <ImageView
        android:id="@+id/feed_comic_face_record_complete"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f081df2"
        app:layout_constraintBottom_toBottomOf="@+id/feed_comic_face_del_btn"
        app:layout_constraintLeft_toRightOf="@+id/feed_comic_face_del_btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feed_comic_face_del_btn"/>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/feed_comic_face_prop_view_pager"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toTopOf="@+id/feed_comic_face_category_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/feed_comic_face_category_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
