<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.seepage.likers.FakeLikersItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="215dp"
    android:layout_margin="4dp"
    app:sl_cornerRadius="0dp"
    app:sl_shadowColor="#00000000"
    app:sl_shadowRadius="0dp"
    holder="seepage.likers.FakeLikersItem">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <View
        android:background="@drawable/fakelikers_head_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VText
        android:id="@+id/left_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:typeface="medium"
        style="@style/core_user_card_top_left_label"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fra_desc"
        android:background="@drawable/core_vip_superlike_game_item_shadaow"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        flatten="true">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/core_card_user_text_color_b2ffffff"
                android:gravity="center"
                android:id="@+id/online_tip"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-2dp"
                android:layout_marginBottom="3dp"
                android:text="@string/MY_TANTAN_CARD_ONLINE"
                android:drawableLeft="@drawable/core_vip_suplerlike_online_tip_layer"
                android:drawablePadding="4dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#fff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/user_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="105dp"
                android:text="21，500m"
                android:maxLines="1"
                app:typeface="medium"/>
        </LinearLayout>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/chat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:src="0x7f081652"
            android:scaleType="center"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.seepage.likers.FakeLikersItem>
