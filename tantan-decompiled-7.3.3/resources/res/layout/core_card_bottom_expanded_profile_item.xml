<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomExpandedProfileItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingRight="80dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomExpandedProfileItemView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/info_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:id="@+id/icon1"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/core_color_70percent_FFFFFF"
            android:ellipsize="end"
            android:id="@+id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:typeface="regular"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/info_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/icon2"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/core_color_70percent_FFFFFF"
            android:ellipsize="end"
            android:id="@+id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:typeface="regular"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomExpandedProfileItemView>
