<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.match.view.MatchSuccessPopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="236dp"
    flatten="true"
    holder="match.view.MatchSuccessPopView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:background="@drawable/core_new_ui_match_success_bg"
        android:paddingBottom="24dp"
        android:layout_width="311dp"
        android:layout_height="178dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="10dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/common_color_0d000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:src="0x7f08114f"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/core_color_cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title_pre"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/core_color_cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle_pre"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_pre"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            flatten="true">
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/emoji_1_container"
                android:background="@drawable/core_new_ui_match_success_emoji_bg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                flatten="true">
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_1"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="0dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/emoji_2_container"
                android:background="@drawable/core_new_ui_match_success_emoji_bg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                flatten="true">
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_2"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="0dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/emoji3_3_container"
                android:background="@drawable/core_new_ui_match_success_emoji_bg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                flatten="true">
                <p151v.VText
                    android:textSize="22sp"
                    android:gravity="center"
                    android:id="@+id/emoji_3"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="0dp"
                    app:enableApngEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/send_message_container"
                android:background="@drawable/core_new_ui_match_success_emoji_bg"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                flatten="true">
                <p151v.VImage
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="0x7f081150"
                    android:layout_marginStart="8dp"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/core_color_33000000"
                    android:id="@+id/send_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打个招呼"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="12dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <p151v.VDraweeView
        android:id="@+id/left_avatar"
        android:visibility="gone"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginTop="9dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/white"
        android:outlineAmbientShadowColor="@color/white"
        app:actualImageScaleType="centerCrop"
        app:backgroundImage="@color/white"
        app:layout_constraintRight_toRightOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/common_white"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderPadding="1dp"
        app:roundingBorderWidth="4dp"/>
    <p151v.VDraweeView
        android:id="@+id/right_avatar_pre"
        android:visibility="gone"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginTop="9dp"
        android:translationX="-10dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/white"
        android:outlineAmbientShadowColor="@color/white"
        app:actualImageScaleType="centerCrop"
        app:backgroundImage="@color/white"
        app:layout_constraintLeft_toLeftOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/common_white"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderPadding="1dp"
        app:roundingBorderWidth="4dp"/>
    <p151v.VDraweeView
        android:id="@+id/right_avatar"
        android:visibility="gone"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginTop="9dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/white"
        android:outlineAmbientShadowColor="@color/white"
        app:actualImageScaleType="centerCrop"
        app:backgroundImage="@color/white"
        app:layout_constraintLeft_toLeftOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/common_white"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderPadding="1dp"
        app:roundingBorderWidth="4dp"/>
    <View
        android:id="@+id/online"
        android:background="@drawable/core_free_trial_online"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/right_avatar"
        app:layout_constraintRight_toRightOf="@+id/right_avatar"/>
    <p151v.VFrame
        android:id="@+id/free_trial_icon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/right_avatar"
        app:layout_constraintRight_toRightOf="@+id/right_avatar"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/free_trial_icon_out"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f0805eb"
            android:scaleType="fitXY"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/free_trial_icon_inner"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="0x7f0805ea"
            android:scaleType="fitXY"/>
    </p151v.VFrame>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="center"
        android:id="@+id/svg_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/white"
        android:outlineAmbientShadowColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/left_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/left_avatar"/>
</com.p051p1.mobile.putong.core.p058ui.match.view.MatchSuccessPopView>
