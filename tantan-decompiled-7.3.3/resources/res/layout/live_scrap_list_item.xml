<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.scrap.ScrapItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="66dp"
    android:layout_height="92dp"
    folder="increment"
    holder="gift.scrap.ScrapItemView">
    <View
        android:id="@+id/scrap_item_bg"
        android:background="0x7f0824cc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/scrap_item_image"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/can_craft_button"
        android:background="0x7f0824cb"
        android:layout_width="54dp"
        android:layout_height="19dp"
        app:layout_constraintBottom_toTopOf="@+id/scrap_item_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#bac7ff"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/scrap_item_name"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="1111111111111111111111111"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/scrap_item_bg"
        app:layout_constraintStart_toStartOf="@+id/scrap_item_bg"
        app:layout_constraintTop_toBottomOf="@+id/scrap_item_image"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.scrap.ScrapItemView>
