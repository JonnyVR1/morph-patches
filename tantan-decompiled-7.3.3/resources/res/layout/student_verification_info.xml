<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    holder="campus.detailinfo.StudentInfoViewModel"
    style="@style/core_account_root">
    <p151v.VScroll
        android:scrollbars="none"
        style="@style/core_account_scroll">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp">
            <p151v.VFrame
                android:id="@+id/school"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <p151v.VMaterialEdit_FakeSpinner
                    android:id="@+id/name"
                    android:focusable="true"
                    android:hint="@string/CAMPUS_UNIVERSITY_NAME"
                    style="@style/campus_input"/>
            </p151v.VFrame>
            <p151v.VText
                android:id="@+id/rejected_for_school"
                android:paddingLeft="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CAMPUS_STUDENT_VERIFICATION_INFO_ERROR"
                style="@style/core_student_ver_rejected_tip"/>
            <p151v.VFrame
                android:id="@+id/start_school"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <p151v.VMaterialEdit_FakeSpinner
                    android:id="@+id/time"
                    android:hint="@string/CAMPUS_ENROLLMENT_TIME"
                    style="@style/campus_input"/>
            </p151v.VFrame>
            <p151v.VText
                android:id="@+id/rejected_for_start_time"
                android:paddingLeft="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CAMPUS_STUDENT_VERIFICATION_INFO_ERROR"
                style="@style/core_student_ver_rejected_tip"/>
            <p151v.VText
                android:textSize="17sp"
                android:textColor="#2eb0ca"
                android:layout_gravity="center"
                android:id="@+id/college_verify_entrance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableRight="0x7f082006"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/student_card"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp">
                <p151v.VText
                    android:textSize="17sp"
                    android:textColor="#dc000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/CAMPUS_UPLOAD_STUDENT_CARD"
                    app:typeface="medium"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <p151v.VFrame
                        android:id="@+id/front"
                        android:background="@drawable/student_id_pic_bg"
                        android:padding="2dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/tip"
                            android:background="@drawable/tf_rect_light"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:background="0x7f082054"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_marginTop="30dp"/>
                            <p151v.VText
                                android:textSize="13sp"
                                android:textColor="#8a000000"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="34dp"
                                android:layout_marginBottom="10dp"
                                android:text="@string/CAMPUS_STUDENT_CARD_FRONT"
                                android:maxLines="1"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                        <p151v.VDraweeView
                            android:id="@+id/picture"
                            android:padding="2dp"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="center"
                            app:failureImage="0x7f081a6c"/>
                    </p151v.VFrame>
                    <p151v.VFrame
                        android:id="@+id/back"
                        android:background="@drawable/student_id_pic_bg"
                        android:padding="2dp"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/hint"
                            android:background="@drawable/tf_rect_light"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:background="0x7f082054"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_marginTop="30dp"/>
                            <p151v.VText
                                android:textSize="13sp"
                                android:textColor="#8a000000"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="34dp"
                                android:layout_marginBottom="10dp"
                                android:text="@string/CAMPUS_STUDENT_CARD_BACK"
                                android:maxLines="1"
                                android:lineSpacingExtra="3sp"/>
                        </LinearLayout>
                        <p151v.VDraweeView
                            android:id="@+id/photo"
                            android:padding="2dp"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="center"
                            app:failureImage="0x7f081a6c"/>
                    </p151v.VFrame>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:weightSum="2">
                    <p151v.VText
                        android:gravity="center_horizontal"
                        android:id="@+id/reject_for_front_pic"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/CAMPUS_STUDENT_VERIFICATION_INFO_ERROR"
                        android:layout_weight="1"
                        style="@style/core_student_ver_rejected_tip"/>
                    <p151v.VText
                        android:gravity="center_horizontal"
                        android:id="@+id/reject_for_back_pic"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="@string/CAMPUS_STUDENT_VERIFICATION_INFO_ERROR"
                        android:layout_weight="1"
                        style="@style/core_student_ver_rejected_tip"/>
                </LinearLayout>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#42000000"
                    android:gravity="left"
                    android:id="@+id/tv_verify_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="30dp"
                    android:text="@string/CAMPUS_STUDENT_CARD_PRIVACY"
                    android:drawableLeft="0x7f08202f"
                    android:drawablePadding="4dp"/>
            </LinearLayout>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:id="@+id/finish"
        android:text="@string/ACTION_DONE"
        style="@style/core_account_continue_button"/>
</p151v.VLinear>
