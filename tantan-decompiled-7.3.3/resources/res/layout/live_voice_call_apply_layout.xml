<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.applymanager.apply.VoiceCallApplyListViewModel">
    <RelativeLayout
        android:id="@+id/free_call_container"
        android:paddingTop="18dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_VOICE_CALL_FREE"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/desc"
            android:layout_width="195dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/LIVE_VOICE_CALL_FREE_DESCRIPTION"
            android:layout_below="@+id/title"/>
        <p151v.VFrame
            android:id="@+id/fl_switcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_alignParentEnd="true"
            flatten="true">
            <p151v.VSwitchButton
                android:id="@+id/switcher"
                android:layout_width="46dp"
                android:layout_height="30dp"/>
        </p151v.VFrame>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/free_call_container"
        flatten="true">
        <View
            android:id="@+id/line"
            android:background="@color/live_white_03_opacity"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apply_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/free_call_container"
        flatten="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_marginTop="39dp"
            android:src="0x7f0827d4"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/live_white_30_opacity"
            android:layout_gravity="center_horizontal"
            android:layout_width="112dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:text="@string/LIVE_VOICE_CALL_NO_APPLY"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
