<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom|center_horizontal"
    android:orientation="vertical"
    android:id="@+id/core_temp_down_dlg"
    android:layout_width="wrap_content"
    android:layout_height="202dp"
    flatten="true"
    holder="messages.model.MessageMainViewModel">
    <RelativeLayout
        android:id="@+id/content_layout"
        android:background="@drawable/core_temp_down_dlg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        flatten="true">
        <TextView
            android:textSize="13sp"
            android:textColor="#4c000000"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:paddingLeft="20dp"
            android:paddingTop="14dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/btn_layout"
            android:background="@drawable/core_temp_down_txt_bg"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:layout_centerHorizontal="true"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/img"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                style="@style/core_im_fresco_base"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:gravity="center_vertical"
                android:id="@+id/des"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="54dp"
                android:layout_marginEnd="14dp"/>
        </FrameLayout>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/wipes_anim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/btn_layout"
            android:layout_alignBottom="@+id/btn_layout"
            android:layout_centerHorizontal="true"
            android:layout_alignStart="@+id/btn_layout"
            android:layout_alignEnd="@+id/btn_layout"/>
    </RelativeLayout>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/temp_down_anim"
        android:layout_width="match_parent"
        android:layout_height="80dp"/>
</LinearLayout>
