<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.usercard.view.LiveUserCardSkinView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_placeholder"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/frame_bottom_static_bg_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="192dp"
        app:actualImageScaleType="focusCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_placeholder"/>
    <p151v.VDraweeView
        android:id="@+id/frame_bottom_dynamic_bg_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="192dp"
        app:actualImageScaleType="focusCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_placeholder"/>
    <View
        android:id="@+id/frame_board"
        android:background="@color/live_gray_19_60_opacity"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="192dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_placeholder"/>
    <Space
        android:id="@+id/top_frame_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_placeholder"/>
    <p151v.VDraweeView
        android:id="@+id/frame_top_static_bg_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/top_frame_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/frame_top_dynamic_bg_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/top_frame_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.effect.video.VideoEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/card_top_bg_video"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="75dp"
        app:layout_constraintDimensionRatio="375:222"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/card_top_bg_pic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="75dp"
        app:layout_constraintDimensionRatio="375:222"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.view.XEGiftView
        android:layout_gravity="center"
        android:id="@+id/card_top_bg_xeGiftView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="75dp"
        app:layout_constraintDimensionRatio="375:222"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.common.usercard.view.LiveUserCardSkinView>
