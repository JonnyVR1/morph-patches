<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.KtvNewStageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="284dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/play_layout"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="284dp">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/volume_wave"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:translationY="-20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:focusableInTouchMode="true"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/grade_effect_view1"
            android:visibility="gone"
            android:layout_width="375dp"
            android:layout_height="512dp"
            android:translationY="-132dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/grade_effect_view"
            android:visibility="gone"
            android:layout_width="375dp"
            android:layout_height="512dp"
            android:translationY="-132dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/singer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/song_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/singer_name">
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/music_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="0x7f0827c6"/>
            <p151v.VMarqueeText
                android:textSize="10sp"
                android:textColor="@color/live_white_80_opacity"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/music_name"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginStart="6dp"/>
            <p151v.VText
                android:textSize="8sp"
                android:textColor="#ccffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_best_singer"
                android:background="@drawable/live_bg_ktv_stage_best_singer"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:maxWidth="62dp"
                android:singleLine="true"
                android:drawablePadding="1dp"
                android:drawableStart="0x7f0827c3"
                android:paddingStart="2dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.LrcView
            android:id="@+id/lrc_view"
            android:layout_width="170dp"
            android:layout_height="38dp"
            android:layout_marginTop="104dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/lv_temp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="104dp"
            app:layout_constraintTop_toBottomOf="@+id/avatar">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ccffffff"
                android:id="@+id/tv_temp_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#66ffffff"
                android:id="@+id/tv_temp_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="250dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_white_80_opacity"
                android:gravity="center"
                android:id="@+id/tv_function"
                android:background="@drawable/live_bg_voice_ktv_stage_func_button"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="3dp"
                android:drawableStart="0x7f0827cb"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <p151v.VFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.VoiceDressCallTouchView
                    android:gravity="center"
                    android:id="@+id/call_layout"
                    android:background="@drawable/live_bg_voice_ktv_stage_func_button"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    flatten="true">
                    <p151v.VDraweeView
                        android:id="@+id/call_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="3dp"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="@color/live_white_80_opacity"
                        android:id="@+id/call_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.VoiceDressCallTouchView>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:layout_gravity="end"
                    android:id="@+id/send_count"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp"/>
            </p151v.VFrame>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/score_layout"
            android:background="@drawable/live_bg_f354f1_r6_a35"
            android:padding="6dp"
            android:layout_width="71dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VMarqueeText
                android:textSize="10sp"
                android:textColor="@color/live_white"
                android:ellipsize="marquee"
                android:id="@+id/tv_level"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="应援0级"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
            <p151v.VText
                android:textSize="8sp"
                android:textColor="@color/live_white_40_opacity"
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0音浪值"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/suggest_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="284dp"
        layout="@layout/live_voice_ktv_stage_choose_song_layout"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/left_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/live_white_90_opacity"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/switch_mode"
            android:background="@drawable/live_bg_black_r8_a15"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="切换玩法"
            android:layout_marginEnd="8dp"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/rule"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f0827c9"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.virtual.ktv.view.KtvNewStageView>
