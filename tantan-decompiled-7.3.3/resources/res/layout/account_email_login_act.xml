<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="accountnew.loginopt.viewmodel.EmailLoginViewModel">
    <p151v.VScroll
        android:id="@+id/scrollView"
        app:layout_constraintBottom_toTopOf="@+id/continue_"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        flatten="true"
        style="@style/account_account_scroll">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_80"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="@string/INTL_TTC_LOGIN_PAGE_TITLE"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/INTL_TTC_LOGIN_PAGE_TEXT"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/number_message"
                android:background="@drawable/common_card_middle_02_bg"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VEditText
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textColorHint="@color/common_000000_20"
                    android:gravity="center_vertical"
                    android:id="@+id/username"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/TTC_CLONE_EMAIL_CASE_SENSITIVE_TEXT"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:inputType="textEmailAddress"
                    android:textCursorDrawable="@drawable/account_signup_ai_cursor"
                    android:paddingStart="20dp"/>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/email_clear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f0803cd"
                    android:layout_marginEnd="20dp"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/password_container"
                android:background="@drawable/common_card_middle_02_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                flatten="true">
                <p151v.VEditText
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textColorHint="@color/common_000000_20"
                    android:id="@+id/password"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/INTL_TTC_LOGIN_PASS_BOX_TEXT"
                    android:maxLines="1"
                    android:maxLength="20"
                    android:layout_weight="1"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/account_signup_ai_cursor"
                    android:paddingStart="20dp"/>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/password_clear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f0803cd"
                    android:layout_marginEnd="10dp"/>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/password_input_type"
                    android:layout_width="20dp"
                    android:layout_height="21dp"
                    android:src="0x7f0801f5"
                    android:layout_marginEnd="20dp"/>
            </p151v.VLinear>
            <FrameLayout
                android:id="@+id/captcha_layout"
                android:background="@drawable/common_card_middle_02_bg"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="20dp"
                flatten="true">
                <p151v.VEditText
                    android:textSize="18dp"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/captcha"
                    android:background="@null"
                    android:paddingLeft="20dp"
                    android:paddingRight="115dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/INTL_CAPTCHA"
                    android:singleLine="true"
                    android:maxLength="4"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/account_signup_ai_cursor"/>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/captcha_image"
                    android:background="#d0d0d0"
                    android:layout_width="100dp"
                    android:layout_height="34dp"
                    android:layout_marginRight="12dp"/>
            </FrameLayout>
            <p151v.VFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp">
                <p151v.VText
                    android:textSize="12dp"
                    android:textColor="@color/common_red"
                    android:gravity="center_vertical"
                    android:id="@+id/error_code"
                    android:background="@drawable/account_sign_input_error_bg"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:includeFontPadding="false"
                    android:drawablePadding="7dp"
                    android:drawableStart="0x7f0801f3"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp"/>
                <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                    android:id="@+id/loading_svga"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </p151v.VFrame>
        </LinearLayout>
    </p151v.VScroll>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:background="0x7f081fdc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"/>
        <p151v.VText
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_TTC_LOGIN_PAGE_TIPS_TEXT"/>
    </LinearLayout>
    <p151v.VText
        android:id="@+id/continue_"
        android:background="@drawable/account_signup_ai_btn_bg_disable"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/GET_VERIFICATION_CODE"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/common_button_large_01"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:background="@color/common_white"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080387"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/common_grey_01"
            android:gravity="center_vertical"
            android:id="@+id/right_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SIGNIN_PASSWORD"
            android:includeFontPadding="false"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_40"
            android:gravity="center_vertical"
            android:id="@+id/right_google_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/INTL_TTC_LOGIN_GMAIL_MODE"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="0x7f08023b"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16dp"
            android:textColor="@color/common_000000_20"
            android:gravity="center_vertical"
            android:id="@+id/right_skip_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/GUESS_ACTION_SKIP"
            android:includeFontPadding="false"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
