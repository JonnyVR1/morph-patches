<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.justreal.JustRealHeadLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/core_just_verification_bg"
    android:paddingLeft="16dp"
    android:paddingTop="11dp"
    android:paddingRight="16dp"
    android:paddingBottom="50dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0"
    android:translationY="50dp"
    flatten="true"
    folder="newui"
    holder="home.justreal.JustRealHeadLayoutViewHome">
    <com.p051p1.mobile.putong.core.newui.home.justreal.JustRealAvatarRootLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar_root"
        android:layout_width="match_parent"
        android:layout_height="28dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="15dp"
        android:textColor="#000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/trial_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:text="试用中，认证后发出喜欢"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="12dp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/goto_verify_center"
        android:background="@drawable/core_white_bg_8dp_radius"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:text="去认证"/>
</com.p051p1.mobile.putong.core.newui.home.justreal.JustRealHeadLayout>
