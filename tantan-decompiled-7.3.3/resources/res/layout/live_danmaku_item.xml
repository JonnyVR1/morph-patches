<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.chat.danmaku.show.DanmakuItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:paddingStart="3dp"
    android:paddingEnd="6dp"
    flatten="true"
    folder="common.chat.danmaku.show"
    holder="DanmakuItem">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/avatar"
        android:layout_width="27dp"
        android:layout_height="27dp"/>
    <View
        android:layout_width="1dp"
        android:layout_height="5dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_80_opacity"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="118dp"
            android:maxLines="1"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white_40_opacity"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=": "/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="44"
            app:enableApngEmojis="true"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </LinearLayout>
    <com.immomo.svgaplayer.view.MomoSVGAImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/emoji"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginLeft="3dp"/>
    <View
        android:layout_width="3dp"
        android:layout_height="1dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.chat.danmaku.show.DanmakuItem>
