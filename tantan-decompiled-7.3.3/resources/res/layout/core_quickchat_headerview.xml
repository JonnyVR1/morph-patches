<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.QuickChatHeaderView">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/svga_id"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerCrop"/>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="top"
        android:id="@+id/svga_love"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerCrop"/>
    <com.tantan.library.svga.SVGAnimationView
        android:layout_gravity="bottom"
        android:id="@+id/svga_loading"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:scaleType="fitCenter"/>
    <com.p051p1.mobile.putong.core.newui.messages.anim.view.QuickChatBgTopView
        android:id="@+id/bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VImage
        android:id="@+id/love"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:src="0x7f0815c7"
        android:layout_centerInParent="true"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="松手寻找闪聊配对"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"/>
    <com.p051p1.mobile.putong.core.newui.messages.anim.view.QuickChatHeaderUserView
        android:id="@+id/getuser_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="102dp"/>
    <com.p051p1.mobile.putong.core.newui.messages.anim.view.ImpressSignalConversationHeadView
        android:id="@+id/impress_signal_layout"
        android:background="0x7f0809f4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="219dp"/>
</merge>
