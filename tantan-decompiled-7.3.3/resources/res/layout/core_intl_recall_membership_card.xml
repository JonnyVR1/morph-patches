<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.active.IntlRecallMembershipCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="active.IntlRecallMembershipCard">
    <p151v.VDraweeView
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="20dp"
        style="@style/core_fresco_base"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:id="@+id/card_icon"
            android:layout_width="108dp"
            android:layout_height="105dp"
            android:layout_marginTop="8dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/black"
            android:id="@+id/card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/core_color_66000000"
            android:gravity="center"
            android:id="@+id/card_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_title"/>
        <p151v.VDraweeView
            android:id="@+id/card_big_icon"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginBottom="16dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@+id/card_btn_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/core_fresco_base"/>
        <p151v.VDraweeView
            android:id="@+id/card_btn_bg"
            android:layout_width="375dp"
            android:layout_height="126dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/core_fresco_base"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/card_btn"
            android:layout_width="320dp"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="@+id/card_btn_bg"
            app:layout_constraintEnd_toEndOf="@+id/card_btn_bg"
            app:layout_constraintStart_toStartOf="@+id/card_btn_bg"
            app:layout_constraintTop_toTopOf="@+id/card_btn_bg"
            app:typeface="medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.active.IntlRecallMembershipCard>
