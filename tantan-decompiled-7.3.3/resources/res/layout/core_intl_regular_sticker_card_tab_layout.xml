<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.intloperation.regularsticker.RegularStickerCardTabView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    flatten="true"
    holder="intloperation.regularsticker.RegularStickerCardTabView">
    <com.google.android.material.card.MaterialCardView
        android:theme="@style/Theme.MaterialComponents"
        android:orientation="vertical"
        android:id="@+id/card"
        android:background="@color/white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#f7f7f7"
        app:strokeWidth="4dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#394a62"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:maxLines="1"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="12dp"/>
    </com.google.android.material.card.MaterialCardView>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/image"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerCrop"
        style="@style/core_fresco_base"/>
</com.p051p1.mobile.putong.core.p058ui.intloperation.regularsticker.RegularStickerCardTabView>
