<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemAddTagsGuide xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemAddTagsGuide">
    <p151v.VRelative
        android:background="@drawable/core_messages_add_tag_artwork_bg"
        android:layout_width="match_parent"
        android:layout_height="234dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginHorizontal="32dp">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:id="@+id/text_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.5dp"
            android:text="选择标签生成你的自我介绍"
            android:layout_centerHorizontal="true"/>
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="0x7f080403"
            android:layout_alignParentRight="true"/>
        <p151v.VPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/text_tips"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="20dp"/>
        <p151v.VPagerCircleIndicator
            android:id="@+id/pager_indicator"
            android:background="@drawable/transparent"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:layout_below="@+id/pager"
            android:layout_centerHorizontal="true"
            app:fillColor="@color/core_fe7e1d"
            app:indicatorSpacing="6dp"
            app:pageColor="@color/core_color_f7f7f7"
            app:radius="3dp"/>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/core_tag_confirm_selector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:text="发送"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="20dp"/>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemAddTagsGuide>
