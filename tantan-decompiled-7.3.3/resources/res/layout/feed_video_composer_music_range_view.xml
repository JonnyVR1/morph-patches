<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.camera.IVMusicRangeEditView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.IVMusicRangeEditView">
    <View
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/video_composer_music_cut_layout"
        android:background="@drawable/feed_video_composer_menu_bg"
        android:layout_width="match_parent"
        android:layout_height="285dp"
        flatten="true">
        <ImageView
            android:id="@+id/music_cut_cancel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:src="0x7f081f21"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#e6ffffff"
            android:ellipsize="marquee"
            android:id="@+id/music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="100dp"
            android:text="Name"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/music_cut_confirm"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/music_cut_confirm"/>
        <ImageView
            android:id="@+id/music_cut_confirm"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f081f24"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.feed.newui.camera.widget.IVMusicRangeSeekView
            android:id="@+id/music_edit_range_view"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintRight_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_cut_confirm"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/music_cut_action_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="32dp"
            android:text="左右拖动声谱以剪取音乐"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_edit_range_view"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:id="@+id/music_cut_time_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="28dp"
            android:text="已选取25秒音频"
            app:layout_constraintBottom_toBottomOf="@+id/music_cut_action_tip"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/music_cut_action_tip"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.feed.newui.camera.IVMusicRangeEditView>
