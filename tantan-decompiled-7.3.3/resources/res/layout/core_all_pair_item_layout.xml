<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationAllPairItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/online_item"
    android:background="@drawable/common_card_bg_medium_02"
    android:clipChildren="false"
    android:layout_width="100dp"
    android:layout_height="115dp"
    flatten="true"
    folder="newui"
    holder="messages.ConversationAllPairItemView"
    innerClass="true">
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="13dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:background="@drawable/core_default_head_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_special_like_avatar"/>
        <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_avatar"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:avatarSize="48dp"
            app:haloSize="60dp"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/chat_red_dot"
            android:background="@drawable/core_bg_chat_red_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"/>
        <p151v.VImage
            android:layout_gravity="top|right"
            android:id="@+id/chat_green_dot"
            android:background="@drawable/core_bg_chat_online_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_black_04"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/txt"
        android:background="@drawable/core_default_txt_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:layout_marginBottom="14dp"
        android:singleLine="true"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationAllPairItemView>
