<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.common.gameoperation.IntlGameOperationItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="intl.common.gameoperation.IntlGameOperationItemView">
    <p151v.VFrame
        android:id="@+id/content"
        android:background="@drawable/live_bg_white_a10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/draweeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:roundedCornerRadius="8dp"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.live.external.intl.common.gameoperation.IntlGameOperationItemView>
