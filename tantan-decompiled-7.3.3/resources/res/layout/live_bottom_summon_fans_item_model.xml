<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.SummonFansItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common.bottom"
    holder="SummonFansItemView">
    <com.p051p1.mobile.putong.live.livingroom.common.bottom.view.BottomViewGroup
        android:layout_gravity="center_horizontal"
        android:id="@+id/scareGroup"
        android:background="@drawable/live_bg_white_r46_a04"
        android:layout_width="68dp"
        android:layout_height="44dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            app:actualImageScaleType="center"
            app:roundedCornerRadius="16dp"/>
        <View
            android:layout_gravity="top|right"
            android:id="@+id/red_dot"
            android:background="@drawable/live_bg_ff3938_r3"
            android:visibility="visible"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="1dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="top|right"
            android:id="@+id/tv_num"
            android:background="@drawable/live_shape_bottom_btn_num_dot_bg"
            android:paddingLeft="3dp"
            android:paddingTop="1dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="1dp"/>
    </com.p051p1.mobile.putong.live.livingroom.common.bottom.view.BottomViewGroup>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_40_opacity"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/live_setting_text_lines"/>
    <TextView
        android:textSize="8sp"
        android:textStyle="normal"
        android:textColor="#fe7e1d"
        android:layout_gravity="center_horizontal"
        android:id="@+id/second_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.SummonFansItemView>
