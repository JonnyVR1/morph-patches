<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.p051p1.mobile.putong.core.newui.view.LiveLightView
        android:id="@+id/live_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lightWidth="100"
        app:loopTime="1500"
        useId="true"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/live_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="@string/LIVE_LINVING"
                useId="true"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/live_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/live_icon"
                useId="true"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#b3ffffff"
            android:id="@+id/live_sub_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:lineSpacingExtra="2sp"
            useId="true"/>
    </LinearLayout>
    <p151v.VImage
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:src="0x7f08233c"/>
</merge>
