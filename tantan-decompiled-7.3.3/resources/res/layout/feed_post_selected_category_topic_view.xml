<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/feed_dialog_bottom_to_top_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="group.dialog.insert.twolevellinkage.FeedPostSelectedCategoryTopicsView">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VMenuBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menubar_bottom_line_visible="false"
            app:menubar_icon_left="0x7f081d67"
            app:menubar_text_center="@string/FEED_ADD_MOMENT_TOPIC"/>
        <p151v.VSearchBar
            android:id="@+id/search_bar"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="搜索话题"
            app:searchbar_cancel_behavior="behavior_float"
            app:searchbar_cancel_text="@string/ACTION_CANCEL"/>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/no_result"
            android:visibility="gone"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="103dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081c54"
                android:scaleType="centerCrop"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/feed_26000000"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="没有符合条件的内容"/>
        </p151v.VLinear>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/all_topic_ll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <com.p051p1.mobile.putong.feed.newui.group.dialog.insert.selecteditem.FeedPostSelectedHeader
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="80dp">
                <p151v.VRecyclerView
                    android:id="@+id/topic_categories"
                    android:background="@color/white"
                    android:scrollbars="none"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:divider="@null"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <p151v.VRecyclerView
                    android:id="@+id/topics"
                    android:background="@color/white"
                    android:scrollbars="none"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp"
                    android:divider="@null"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </LinearLayout>
    </p151v.VLinear>
    <p151v.VButton
        android:textColor="@color/feed_post_tv_confirm_color"
        android:layout_gravity="bottom"
        android:id="@+id/ok"
        android:background="@drawable/common_button_btn_orange_medium"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ACTION_CONFIRM"
        style="@style/common_button_large_01"/>
</p151v.VFrame>
