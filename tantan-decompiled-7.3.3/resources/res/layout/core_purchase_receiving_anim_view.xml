<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.result.PurchaseReceivingAnimView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="#b3000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="result.PurchaseReceivingAnimView">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:scaleX="0.3"
        android:scaleY="0.3">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bg"
            android:layout_width="234dp"
            android:layout_height="234dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="194dp"
            android:layout_marginRight="16dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/obtain"
            android:background="@drawable/core_purchase_result_line_white_border"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="256dp"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="-18dp"
        android:alpha="0"
        android:scaleX="0.3"
        android:scaleY="0.3"/>
</com.p051p1.mobile.putong.core.p058ui.result.PurchaseReceivingAnimView>
