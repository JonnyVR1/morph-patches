<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.newpic.PicExchangeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.newpic.PicExchangeLayout">
    <ImageView
        android:id="@+id/close_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:src="0x7f081325"/>
    <FrameLayout
        android:id="@+id/top_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="42dp"
        flatten="true">
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/fun_tab"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            flatten="true">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/pic_exchange"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="以图换图"
                android:drawableBottom="@drawable/core_pic_exchange_line_bg"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#80ffffff"
                android:id="@+id/limit_shooting"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="95dp"
                android:text="限时快拍"/>
        </p151v.VLinear>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/pre_warn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:alpha="0.6"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/surface_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
    <FrameLayout
        android:id="@+id/fun_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        flatten="true">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/random_photo_or_del"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginLeft="42.28dp"
            android:src="@drawable/core_pic_exchange_random_bg"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/take_photo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="0x7f08132d"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/choose_photo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginRight="42.28dp"
            android:src="@drawable/core_pic_exchange_photo_bg"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.newpic.PicExchangeLayout>
