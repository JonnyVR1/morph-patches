<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ctl_account_tab_root"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    flatten="true"
    folder="ui"
    holder="camera.view.AccountCameraMaskTab">
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_tab_title"
        android:paddingLeft="6dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.account.p055ui.camera.view.AccountRedDotView
        android:id="@+id/iv_tab_red"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="3dp"
        app:accountDotDrawableOvalColor="#ff3228"
        app:accountDotDrawableWidth="10dp"
        app:accountRedDotType="ACCOUNT_STICKER_CATEGORY_POINT"
        app:layout_constraintRight_toRightOf="@+id/tv_tab_title"
        app:layout_constraintTop_toTopOf="@+id/tv_tab_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
