<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.intl.liveend.VoiceLiveIntlEndViewModel">
    <FrameLayout
        android:id="@+id/background_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:failureImage="@drawable/transparent"
            app:failureImageScaleType="fitXY"
            app:placeholderImage="@drawable/transparent"
            app:placeholderImageScaleType="fitXY"/>
        <View
            android:id="@+id/background_top"
            android:background="#b3000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="60dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"
        style="@style/live_fresco_profile_small"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="73dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/sub_layout"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sub_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        flatten="true">
        <TextView
            android:textSize="12sp"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_subject"
            android:background="@drawable/live_bg_white_r12_a10"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/bonus_gift"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_subject"
            app:layout_constraintLeft_toRightOf="@+id/tv_subject"
            app:layout_constraintTop_toTopOf="@+id/tv_subject"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/close_live_end_layout"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="11dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        flatten="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/close_live_end"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f08278c"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_data_settlement"
        android:background="@drawable/live_bg_white_r20_a10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_DURATION"
                android:maxLines="2"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_AUDIENCE_COUNT"
                android:maxLines="2"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_NEW_FOLLOW"
                android:maxLines="2"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/join_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/new_fans"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_RECEIVED_GIFTS"
                android:maxLines="2"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/heartbeat_title"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_MY_SCORE"
                android:maxLines="2"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#99ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/user_gift_number_title"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LIVE_VOICE_SEND_NUMBER"
                android:maxLines="2"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="17dp">
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/receive_gift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/heartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/user_gift_number"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rv_fire"
        android:background="@drawable/live_bg_white_r20_a10"
        android:layout_width="match_parent"
        android:layout_height="83dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_data_settlement"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_fire_process"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="17dp"
            android:maxLines="1"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="2dp"
            android:src="0x7f08278a"
            android:scaleType="center"
            android:layout_toRightOf="@+id/tv_fire_process"
            android:layout_alignTop="@+id/tv_fire_process"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="0x7f08278d"
            android:scaleType="center"
            android:layout_alignTop="@+id/tv_fire_process"
            android:layout_alignParentRight="true"/>
        <com.p051p1.mobile.putong.live.livingroom.voice.intl.liveend.VoiceEndFireProgressView
            android:id="@+id/fire_progress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/tv_fire_process"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_fire_list"
        android:background="@drawable/live_shape_voice_end_page_view_layout_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_fire"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/LIVE_VOICE_SPARK_LIST"
            android:maxLines="1"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_fire_list"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_heartbeat_and_accompany_list"
        android:background="@drawable/live_shape_voice_end_page_view_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_fire"
        flatten="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                app:tabBackground="@null"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/live_list_voice_end_tab_indicator"
                app:tabIndicatorColor="@color/white"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="3dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@color/transparent"
                app:tabSelectedTextColor="@color/white"
                app:tabTextAppearance="@style/live_voice_end_tab_style"
                app:tabTextColor="#99ffffff"/>
            <View
                android:layout_gravity="bottom"
                android:background="#05f9f9f9"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"/>
        </FrameLayout>
        <p151v.VPagerNoPage
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_fire_list_empty"
        android:background="@drawable/live_shape_voice_end_page_view_layout_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_fire">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:src="0x7f082789"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/LIVE_VOICE_SPARK_LIST_EMPTY"
            android:lineSpacingExtra="6sp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/top_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
