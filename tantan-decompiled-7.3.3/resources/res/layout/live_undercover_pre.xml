<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    attachToRoot="true"
    flatten="true">
    <p151v.VImage
        android:id="@+id/logo"
        android:layout_width="160dp"
        android:layout_height="80dp"
        android:layout_marginTop="13dp"
        android:src="0x7f0823d8"
        android:layout_centerHorizontal="true"
        useId="true"/>
    <p151v.VRecyclerView
        android:id="@+id/join_user_rv"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/logo"
        android:layout_centerHorizontal="true"
        useId="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#daf4ff"
        android:id="@+id/wait_tips_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/LIVE_ROOM_UNDERCOVER_WAIT_USER"
        android:layout_below="@+id/join_user_rv"
        android:layout_centerHorizontal="true"
        useId="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#99daf4ff"
        android:id="@+id/wait_tips_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/wait_tips_1"
        android:layout_centerHorizontal="true"
        useId="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1b4173"
        android:gravity="center"
        android:id="@+id/join_btn"
        android:background="@drawable/live_selector_bg_undercover_btn"
        android:layout_width="178dp"
        android:layout_height="48dp"
        android:layout_marginBottom="22dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        useId="true"/>
</merge>
