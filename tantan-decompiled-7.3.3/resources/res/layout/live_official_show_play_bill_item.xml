<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.officialshow.showlist.OfficialShowPlayBillItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="145dp"
    android:layout_height="80dp"
    flatten="true"
    holder="officialshow.showlist.OfficialShowPlayBillItemView">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/time_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/live_white_60_opacity"
            android:layout_gravity="center_vertical"
            android:id="@+id/time"
            android:paddingLeft="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00-00:00"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableLeft="0x7f08232b"
            android:drawablePadding="4dp"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/follow"
            android:background="@drawable/live_bg_fe7e1d_r5"
            android:layout_width="26dp"
            android:layout_height="15dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="8dp"
            android:text="关注"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp">
            <p151v.VDraweeView
                android:id="@+id/avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:roundAsCircle="true"/>
            <com.p051p1.mobile.putong.live.base.view.LiveMainlandTagView
                android:layout_gravity="center_horizontal"
                android:id="@+id/live_tag"
                android:background="@drawable/live_shape_activity_living_tag_bg_r4"
                android:visibility="visible"
                android:layout_width="18dp"
                android:layout_height="12dp"
                android:layout_marginTop="21dp"/>
        </FrameLayout>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="title"
                android:maxLines="1"
                android:singleLine="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/live_white_60_opacity"
                android:ellipsize="end"
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="desc"
                android:maxLines="1"
                android:singleLine="true"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.officialshow.showlist.OfficialShowPlayBillItemView>
