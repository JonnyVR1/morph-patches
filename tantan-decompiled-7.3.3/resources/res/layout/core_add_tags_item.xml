<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <p151v.VDraweeView
            android:id="@+id/work_cover"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            app:background="@color/common_red"
            app:placeholderImage="@drawable/core_slide_card_dlg_bg"
            app:roundedCornerRadius="4dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#cc000000"
            android:id="@+id/prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:singleLine="true"/>
    </p151v.VLinear>
</p151v.VFrame>
