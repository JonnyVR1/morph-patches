<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallInviteView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bind_extends="ConstraintLayout"
    app:binding="true"
    app:flatten="true">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/invite_friend_bg"
                android:background="@drawable/live_bg_f6f7f8_r20"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallRollAnimView
                android:id="@+id/roll_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_alignRight="@+id/entrance_arrow"
                app:enableExitTranslation="true"
                app:layout_constraintBottom_toBottomOf="@+id/invite_friend_bg"
                app:layout_constraintLeft_toLeftOf="@+id/invite_friend_bg"
                app:layout_constraintTop_toTopOf="@+id/invite_friend_bg"
                app:liveItemSize="38"
                app:liveViewPadding="6dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/LIVE_MULTI_CALL_INVITE_FRIENDS_CALL"
                android:fontFamily="PingFangSC-Regular"
                app:layout_constraintBottom_toBottomOf="@+id/invite_friend_bg"
                app:layout_constraintLeft_toRightOf="@+id/roll_view"
                app:layout_constraintTop_toTopOf="@+id/invite_friend_bg"/>
            <p151v.VImage
                android:id="@+id/entrance_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:src="0x7f0823e6"
                android:layout_alignParentRight="true"
                app:layout_constraintBottom_toBottomOf="@+id/invite_friend_bg"
                app:layout_constraintRight_toRightOf="@+id/invite_friend_bg"
                app:layout_constraintTop_toTopOf="@+id/invite_friend_bg"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </p151v.VLinear>
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="center"
        android:id="@+id/tab"
        android:background="@color/live_white"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:fillViewport="false"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container"
        app:layout_scrollFlags="enterAlways|scroll"
        app:tabIndicatorHeight="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="#212121"
        app:tabTextColor="#999999"/>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/pager_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab"
        app:layout_constraintVertical_weight="1"
        useId="true"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallInviteView>
