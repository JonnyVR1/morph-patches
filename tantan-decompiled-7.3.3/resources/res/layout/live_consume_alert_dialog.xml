<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.consumealert.ConsumeAlertDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/live_black_30_opacity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="increment"
    holder="gift.consumealert.ConsumeAlertDialog">
    <View
        android:id="@+id/alert_root"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="311dp"
        android:layout_height="411dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/alert_icon"
        android:layout_width="311dp"
        android:layout_height="208dp"
        android:src="0x7f082280"
        app:layout_constraintEnd_toEndOf="@+id/alert_root"
        app:layout_constraintStart_toStartOf="@+id/alert_root"
        app:layout_constraintTop_toTopOf="@+id/alert_root"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="center"
        android:id="@+id/alert_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CONSUME_ALERT_TITLE"
        app:layout_constraintEnd_toEndOf="@+id/alert_root"
        app:layout_constraintStart_toStartOf="@+id/alert_root"
        app:layout_constraintTop_toBottomOf="@+id/alert_icon"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_40_opacity"
        android:gravity="center"
        android:id="@+id/alert_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/LIVE_CONSUME_ALERT_SUB_TITLE"
        app:layout_constraintEnd_toEndOf="@+id/alert_root"
        app:layout_constraintStart_toStartOf="@+id/alert_root"
        app:layout_constraintTop_toBottomOf="@+id/alert_title"/>
    <p151v.VCheckBox
        android:id="@+id/alert_check_box"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:checked="true"
        app:layout_constraintEnd_toStartOf="@+id/alert_check_box_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/alert_root"
        app:layout_constraintTop_toBottomOf="@+id/alert_sub_title"
        style="@style/common_checkbox"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_20_opacity"
        android:id="@+id/alert_check_box_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CONSUME_ALERT_CHECK_BOX_TEXT"
        app:layout_constraintBottom_toBottomOf="@+id/alert_check_box"
        app:layout_constraintEnd_toEndOf="@+id/alert_root"
        app:layout_constraintStart_toEndOf="@+id/alert_check_box"
        app:layout_constraintTop_toTopOf="@+id/alert_check_box"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="32dp"
        android:text="@string/LIVE_CONSUME_ALERT_BT_TEXT"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/alert_root"
        app:layout_constraintEnd_toEndOf="@+id/alert_root"
        app:layout_constraintStart_toStartOf="@+id/alert_root"
        app:layout_constraintTop_toBottomOf="@+id/alert_check_box"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.consumealert.ConsumeAlertDialog>
