<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.AutoVDraweeView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/feed_fresco_moment_small"/>
    <p151v.VRelative
        android:background="@drawable/feed_media_repeat_img_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="5dp"
            android:src="0x7f081d77"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:background="@drawable/feed_center_image_live_photo_bg"
        android:visibility="gone"
        android:layout_width="45dp"
        android:layout_height="20dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">
        <p151v.VImage
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:src="0x7f081cc2"
            android:scaleType="center"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="LIVE"/>
    </p151v.VLinear>
</p151v.VRelative>
