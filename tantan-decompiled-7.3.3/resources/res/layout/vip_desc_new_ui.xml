<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_intl_privilege_see_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="vip.privilegeNewUi.vipnewuifrag.VipNewUIFragViewModel"
    innerClass="true">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080b56"
        app:title="@string/INTL_ME_SUBSCRIPTION_MANAGEMENT"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.p051p1.mobile.putong.core.p058ui.vip.privilegeNewUi.view.IntlTopCardLayout
            android:id="@+id/card_pager"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.core.p058ui.vip.privilegeNewUi.view.bottom.IntlAlphaTransformerViewPager
            android:id="@+id/viewpager_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="170dp"
            android:layout_marginBottom="88dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_pager"/>
        <FrameLayout
            android:id="@+id/buy_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true">
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/upgrade_svga"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:gravity="center"
                    android:id="@+id/buy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#66000000"
                    android:gravity="center"
                    android:id="@+id/free_trial"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
