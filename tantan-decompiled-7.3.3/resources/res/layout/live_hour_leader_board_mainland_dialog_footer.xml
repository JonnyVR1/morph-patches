<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.HourBoardMainlandFooter xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    flatten="true"
    folder="increment"
    holder="leaderboard.hourleaderboard.mainland.HourBoardMainlandFooter">
    <p151v.VImage
        android:id="@+id/left"
        android:layout_width="21dp"
        android:layout_height="9dp"
        android:src="0x7f082312"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/text"
        app:layout_constraintEnd_toStartOf="@+id/text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white_20_opacity"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="202dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="152dp"
        android:text="@string/LIVE_SQUARE_SUGGEST_REGULAR"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right"
        app:layout_constraintStart_toEndOf="@+id/left"/>
    <p151v.VImage
        android:id="@+id/right"
        android:layout_width="21dp"
        android:layout_height="9dp"
        android:src="0x7f082312"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text"
        app:layout_constraintTop_toTopOf="@+id/text"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainland.HourBoardMainlandFooter>
