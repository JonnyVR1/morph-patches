<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_tr24"
    android:paddingLeft="20dp"
    android:paddingRight="28dp"
    android:layout_width="match_parent"
    android:layout_height="400dp"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true">
    <TextView
        android:textSize="21sp"
        android:textStyle="normal"
        android:textColor="#e6000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/LIVE_ROOM_ANNOUNCEMENT_TITLE"
        android:fontFamily="PingFangSC-Semibold"/>
    <TextView
        android:textSize="21sp"
        android:textStyle="normal"
        android:textColor="#4d000000"
        android:id="@+id/can_input_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_toRightOf="@+id/title"
        android:layout_alignTop="@+id/title"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/live_black"
        android:textColorHint="#4d000000"
        android:gravity="top"
        android:id="@+id/input_text"
        android:background="@null"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="189dp"
        android:layout_marginTop="24dp"
        android:hint="@string/LIVE_ROOM_ANNOUNCEMENT_PLACEHOLDER_CLIENT"
        android:maxLength="1000"
        android:layout_below="@+id/title"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/live_shape_voice_top_notice_input_cursor_style"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/live_black_30_opacity"
        android:id="@+id/input_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/input_text"
        android:layout_alignEnd="@+id/input_text"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/complete_update"
        android:background="@drawable/live_bg_black_r14_a05"
        android:paddingLeft="24dp"
        android:paddingTop="13dp"
        android:paddingRight="24dp"
        android:paddingBottom="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="40dp"
        android:text="@string/LIVE_ROOM_ANNOUNCEMENT_PUBLISH"
        android:layout_below="@+id/input_text"
        android:fontFamily="PingFangSC-Semibold"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/live_black_30_opacity"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@drawable/live_bg_black_r14_a05"
        android:paddingLeft="24dp"
        android:paddingTop="13dp"
        android:paddingRight="24dp"
        android:paddingBottom="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:text="@string/LIVE_ROOM_ANNOUNCEMENT_CANCEL"
        android:layout_toRightOf="@+id/complete_update"
        android:layout_alignBottom="@+id/complete_update"
        android:fontFamily="PingFangSC-Semibold"/>
</RelativeLayout>
