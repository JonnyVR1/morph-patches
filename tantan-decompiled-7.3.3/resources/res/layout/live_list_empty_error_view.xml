<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.internal.virtualVoice.square.fragmentnew2.LiveEmptyErrorView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/empty_error_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="124dp">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="@color/live_white_40_opacity"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/LIVE_THE_CURRENT_NETWORK_IS_UNAVAILABLE"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.external.internal.virtualVoice.square.fragmentnew2.LiveEmptyErrorView>
