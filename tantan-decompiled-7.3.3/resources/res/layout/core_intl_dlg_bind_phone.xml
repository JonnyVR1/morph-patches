<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    flatten="true"
    holder="dlg.IntlFacebookBindPhoneDlg">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/GP_BIND_FACEBOOK_MOBILE_TITLE"
            android:maxLines="2"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_000000_40"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="30dp"
            android:text="@string/GP_BIND_FACEBOOK_MOBILE_NOTICE"
            android:lineSpacingExtra="3dp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/verify"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp">
            <LinearLayout
                android:background="@drawable/common_card_middle_02_bg"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <p151v.VText
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ccode"
                    android:focusableInTouchMode="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="70dp"
                    android:includeFontPadding="false"
                    android:drawableRight="0x7f080558"
                    android:paddingStart="14dp"/>
                <p151v.VEditText
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:id="@+id/phone_num"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/SIGNUP_PHONE_NUMBER"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:inputType="phone"
                    android:textCursorDrawable="@drawable/core_bind_phone_cursor"
                    android:paddingStart="20dp"/>
            </LinearLayout>
            <FrameLayout
                android:background="@drawable/common_card_middle_02_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp">
                <p151v.VEditText
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/common_grey_04"
                    android:gravity="center_vertical"
                    android:id="@+id/code"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:inputType="number"
                    android:textCursorDrawable="@drawable/core_bind_phone_cursor"
                    android:paddingStart="20dp"/>
                <p151v.VText
                    android:enabled="false"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/core_intl_facebook_bind_phone_dlg_get_code_text_selector"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/get_code"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="12dp"
                    android:checked="false"
                    android:minHeight="34dp"
                    android:text="@string/FACEBOOK_LOGIN_RESEND"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="12dp"
                android:textColor="@color/common_orange_02"
                android:gravity="center_vertical"
                android:id="@+id/error_code"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:drawablePadding="7dp"
                android:drawableStart="0x7f0816b7"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
        <p151v.VButton
            android:textStyle="bold"
            android:id="@+id/positive_primary"
            android:background="@drawable/core_intl_facebook_bind_phone_dlg_bg_selector"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="32dp"
            android:text="@string/FACEBOOK_GP_BIND_NOW"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_04"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/nega"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp"
            android:text="@string/FACEBOOK_ACTION_LATER"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
