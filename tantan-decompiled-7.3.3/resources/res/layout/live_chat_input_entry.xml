<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.chat.inputEntry.ChatInputEntryView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common"
    holder="chat.inputEntry.ChatInputEntryView">
    <LinearLayout
        android:id="@+id/chat_input"
        android:background="@drawable/live_bg_black_r12_a15"
        android:paddingLeft="8dp"
        android:layout_width="195dp"
        android:layout_height="38dp"
        android:layout_alignParentBottom="true"
        flatten="true">
        <com.p051p1.mobile.putong.live.livingroom.common.bottom.areaA.view.BottomInputView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/bottom_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            holder="bottom.BottomInputView"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/apply_line"
            android:background="@drawable/live_bg_white_r1_a80"
            android:visibility="visible"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="3dp"/>
        <p151v.VText
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textColorHint="#ccffffff"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/chat_input_text"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:maxWidth="195dp"
            android:minWidth="39dp"
            android:hint="@string/LIVE_PLEASE_TALK_SOMTHING"
            android:lines="1"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.common.chat.inputEntry.ChatInputEntryView>
