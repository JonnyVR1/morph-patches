<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.signin.prize.LiveSignInProgressView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/live_bg_b60043_r9_a20"
    android:padding="2dp"
    android:layout_width="114dp"
    android:layout_height="16dp"
    flatten="true"
    folder="common"
    holder="signin.prize.LiveSignInProgressView">
    <com.p051p1.mobile.putong.live.livingroom.common.signin.prize.RoundImageView
        android:id="@+id/img_progress"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:src="0x7f082676"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="16dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#da2a58"
            android:gravity="center"
            android:id="@+id/text_progress_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#da2a58"
            android:gravity="center"
            android:id="@+id/text_progress_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.common.signin.prize.LiveSignInProgressView>
