<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.intlslguide.IntlSlGuideDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/core_intl_sl_guide_dialog_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="home.intlslguide.IntlSlGuideDialogView">
    <p151v.VFrame
        android:id="@+id/avatar_area"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:src="@drawable/core_intl_card_sl_guide_dlg_bg"/>
        <p151v.VFrame
            android:layout_gravity="center_horizontal"
            android:id="@+id/avatar_container"
            android:clipChildren="false"
            android:layout_width="94dp"
            android:layout_height="120dp"
            android:layout_marginTop="36dp"
            flatten="true">
            <p151v.AutoVDraweeView
                android:id="@+id/avatar"
                android:layout_width="94dp"
                android:layout_height="120dp"
                app:roundedCornerRadius="12dp"/>
            <p151v.VFrame
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/sl_icon_container"
                android:background="@drawable/core_intl_sl_guide_icon_bg"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="-25dp"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/sl_icon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/core_intl_card_sl_guide_dlg_sl_icon"/>
            </p151v.VFrame>
        </p151v.VFrame>
    </p151v.VFrame>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        flatten="true">
        <p151v.VText_NoTopPadding
            android:textSize="18sp"
            android:textColor="#000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="14sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            app:fontWeight="400"/>
        <p151v.VText_NoTopPadding
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_send"
            android:background="@drawable/core_intl_sl_guide_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="15dp"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="14sp"
            android:textColor="#33000000"
            android:gravity="center"
            android:id="@+id/btn_skip"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:fontWeight="600"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.intlslguide.IntlSlGuideDialogView>
