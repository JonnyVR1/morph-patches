<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ReminderView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.ReminderView">
    <RelativeLayout
        android:background="@drawable/bg_message_reminder"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginLeft="66dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="51dp"
        android:layout_marginBottom="10dp">
        <p151v.VDraweeView
            android:id="@+id/cover"
            android:visibility="gone"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginRight="10dp"
            fresco:actualImageScaleType="centerCrop"
            fresco:roundedCornerRadius="4dp"/>
        <p151v.VImage
            android:id="@+id/play"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="18dp"
            android:src="0x7f0828b3"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#de000000"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:layout_toRightOf="@+id/cover"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:layout_alignLeft="@+id/text"
            android:layout_alignParentBottom="true"/>
        <p151v.VImage
            android:id="@+id/like"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0828b1"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ReminderView>
