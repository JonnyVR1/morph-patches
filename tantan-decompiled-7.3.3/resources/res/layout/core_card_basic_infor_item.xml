<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedBasicInfoRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/expanded_card_baseinfo_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.holder.BasicInforHomeCardExpandeHolder">
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:background="@drawable/core_bg_20_ffffff"
        android:paddingTop="24dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="14sp"
                android:textColor="@color/core_color_50percent_000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_TTC_CLONE_SWIPE_PAGE_ABOUT_ME_TITLE"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedCardCommonLabelView
            android:id="@+id/card_label_show_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedBasicInfoRootLayout>
