<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="mediapicker.newcaption.NewCaptionViewModel">
    <p151v.VScroll
        android:scrollbarStyle="outsideOverlay"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.p051p1.mobile.putong.feed.newui.mediapicker.EditTextInScrollView
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light"
                android:gravity="top|left"
                android:id="@+id/edit_field"
                android:background="@null"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="编辑内容"
                android:maxLength="2000"
                android:inputType="textMultiLine"
                android:textCursorDrawable="0x7f082a1a"
                app:typeface="regular"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/bottom_layout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/images"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="16dp"/>
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/low_alert"
                    android:background="#f7f7f7"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/USER_INFO_CHECK_MOMENT_HINT_TITLE"
                    android:maxLines="2"
                    android:drawablePadding="10dp"/>
                <View style="@style/feed_settings_divider"/>
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_light"
                    android:gravity="center_vertical"
                    android:id="@+id/location"
                    android:background="@drawable/tf_rect_light"
                    android:paddingLeft="16dp"
                    android:paddingTop="15dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="14dp"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/MOMENTS_CAPTION_ADD_LOCATION_CELL_TITLE"
                    android:singleLine="true"
                    android:drawableLeft="0x7f0828fb"
                    android:drawablePadding="40dp"
                    app:typeface="regular"/>
                <View
                    android:id="@+id/bottom_divider"
                    style="@style/feed_settings_divider"/>
            </LinearLayout>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VText
        android:id="@+id/alert_text"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        style="@style/edit_text_indicator"/>
</LinearLayout>
