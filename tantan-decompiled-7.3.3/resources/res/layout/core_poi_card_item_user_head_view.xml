<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemUserHeadView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="335dp"
    android:layout_height="335dp"
    flatten="true"
    folder="newui"
    holder="poi.view.FeedPoiCardItemUserHeadView">
    <p151v.VDraweeView
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <View
        android:background="@drawable/core_poi_card_head_bottom_shadow"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_alignParentBottom="true"/>
    <p151v.VLinear_FillerMeasure
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/name_age_tag_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="11dp"
        android:layout_above="@+id/location_and_active"
        app:fillerIndex="0"
        flatten="true">
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="20sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/age"
            android:paddingLeft="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </p151v.VLinear_FillerMeasure>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start|bottom"
        android:id="@+id/location_and_active"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.core.newui.poi.view.FeedPoiCardItemUserHeadView>
