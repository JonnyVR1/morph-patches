<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemPrologueRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemEmojiText
        android:textColorLink="@color/core_msg_cell_link_color"
        android:autoLink="web"
        android:id="@+id/originText"
        android:paddingTop="?attr/left_msg_top_padding"
        android:paddingBottom="?attr/left_msg_bottom_padding"
        android:lineSpacingExtra="1.5dp"
        android:paddingStart="?attr/left_msg_left_padding"
        android:paddingEnd="?attr/left_msg_right_padding"
        app:enableApngEmojis="true"
        app:enableEmojis="true"
        app:largeEmojis="true"
        style="@style/messages_item_right"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Medium
        android:textSize="13sp"
        android:textColor="#99000000"
        android:id="@+id/edit_entry"
        android:background="@drawable/core_new_messages_prompt"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="我的开场白"
        android:drawableLeft="0x7f080fbb"
        android:drawablePadding="3dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemPrologueRight>
