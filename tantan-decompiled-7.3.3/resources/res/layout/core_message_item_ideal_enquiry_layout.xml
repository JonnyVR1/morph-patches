<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.view.MessageIdealEnquiryLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.view.MessageIdealEnquiryLayout">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_local_ideal_enquiry_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="10dp">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="5dp">
            <p151v.VImage
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:srcCompat="@drawable/core_local_ideal_enquiry_ic"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="0dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                    android:textSize="15dp"
                    android:textColor="@color/common_000000_80"
                    android:id="@+id/enquiry_title"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"/>
                <p151v.VText
                    android:textSize="12.5dp"
                    android:textColor="@color/common_000000_40"
                    android:id="@+id/enquiry_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineHeight="18dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.profile.views.FlowTagsView
            android:id="@+id/ideal_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/save_btn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="保存"/>
    </p151v.VLinear>
    <p151v.VImage
        android:layout_gravity="top|right"
        android:id="@+id/ideal_close_btn"
        android:background="0x7f080f2f"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="44dp"
        android:scaleType="centerInside"/>
</com.p051p1.mobile.putong.core.p058ui.messages.view.MessageIdealEnquiryLayout>
