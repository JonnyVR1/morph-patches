<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="virtual.roomInfo.preview.VoiceVirtualNoticePreviewDialog">
    <View
        android:id="@+id/layout_empty"
        android:background="@color/live_black_40_opacity"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/hock"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/hock"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <View
        android:id="@+id/bg"
        android:background="@drawable/live_bg_19191e_tr24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_holder"/>
    <View
        android:id="@+id/top_holder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/icon"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f08274b"
        android:scaleType="centerCrop"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_holder"/>
    <p151v.VImage
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:src="0x7f08274c"
        android:scaleType="centerCrop"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="22sp"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/LIVE_VOICE_VIRTUAL_TOP_NOTICE_TITLE"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toTopOf="@+id/content"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VFrame
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/title_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white_40_opacity"
            android:id="@+id/notice_content"
            android:visibility="visible"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="287dp"
            android:minHeight="134dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"/>
    </p151v.VFrame>
</androidx.constraintlayout.widget.ConstraintLayout>
