<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationItemBlindBoxEntrance xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    folder="newui"
    holder="messages.ConversationItemBlindBoxEntrance">
    <p151v.VFrame
        android:layout_gravity="center"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="0x7f080743"/>
    </p151v.VFrame>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_weight="1">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="盲盒"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:layout_weight="1"
            app:typeface="regular"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/core_color_4d000000"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="12dp"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationItemBlindBoxEntrance>
