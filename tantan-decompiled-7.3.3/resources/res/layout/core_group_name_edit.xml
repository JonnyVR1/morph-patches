<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.group.GroupNameEditViewModel"
    innerClass="true">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VEditText
            android:textSize="16sp"
            android:textColor="#222222"
            android:textColorHint="#d0d0d0"
            android:gravity="center"
            android:id="@+id/edit_group_name"
            android:background="@drawable/core_group_edit_view_bg"
            android:paddingLeft="16dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/CHAT_GROUP_GROUP_NICKNAME"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="15"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/clear"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="@drawable/core_group_create_edit_text_clear"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#a8a8a8"
            android:id="@+id/tv_group_name_limit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/CHAT_GROUP_XIUGAI_QUNMING"
            android:layout_weight="1"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#a8a8a8"
            android:id="@+id/tv_group_name_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="0/15"/>
    </p151v.VLinear>
</p151v.VLinear>
