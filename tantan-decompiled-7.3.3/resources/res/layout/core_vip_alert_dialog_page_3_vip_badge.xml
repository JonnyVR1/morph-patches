<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/avatar_area"
        android:background="0x7f082a88"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="-12dp">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_red_bg"
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:backgroundImage="@drawable/core_bg_svip_vip_avater_red"
            app:roundAsCircle="true"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="82dp"
            android:layout_height="82dp"
            style="@style/core_fresco_profile_white_border"/>
    </FrameLayout>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="-36dp"
        android:layout_marginRight="-36dp"
        android:src="0x7f0818ea"/>
    <p151v.VText
        android:textSize="18dp"
        android:textColor="@color/common_origin_01"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="70dp"
        android:layout_marginRight="70dp"
        android:layout_marginBottom="-48dp"
        android:lines="1"
        android:drawablePadding="8dp"
        app:vectorDrawableRight="@drawable/vip_status_vip"/>
</FrameLayout>
