<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingTop="56dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="group.GroupSuggestListViewModel"
    useId="true">
    <com.p051p1.mobile.putong.core.newui.group.SwipeRefreshList
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/content_wrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true"
            useId="true">
            <p151v.VRecyclerView
                android:orientation="horizontal"
                android:id="@+id/suggest_tab_list"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                useId="true"/>
            <include layout="@layout/core_chat_group_suggest_list_header"/>
            <p151v.VRecyclerView
                android:id="@+id/suggest_list"
                android:background="@color/white"
                android:scrollbars="none"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                useId="true"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.newui.group.SwipeRefreshList>
    <p151v.VRelative
        android:layout_gravity="bottom|right"
        android:id="@+id/chat_group_ring_rl"
        android:background="0x7f0806c5"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="4dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/chat_group_ring_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/core_group_notice_icon"
            android:layout_centerInParent="true"/>
        <p151v.VText
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/chat_group_ring_red_point"
            android:background="@drawable/common_badge_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:typeface="medium"/>
    </p151v.VRelative>
</FrameLayout>
