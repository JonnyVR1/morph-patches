<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="vip.privilege.vipfrag.VipFragViewModel">
    <FrameLayout
        android:id="@+id/default_bg"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true"/>
    <FrameLayout
        android:id="@+id/dark_bg"
        android:background="@drawable/core_privilege_supreme_partner_content_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/dark_texture_bg"
            android:layout_width="match_parent"
            android:layout_height="264dp"
            app:actualImageScaleType="fitXY"
            app:failureImage="@color/transparent"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftIcon="0x7f080387"
            app:title="@string/VIP_MY_PRIVILEGE"/>
        <p151v.VFrame
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/coordinatorlayout"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true">
                <com.p051p1.mobile.putong.core.p058ui.vip.privilege.vipfrag.view.TopCardLayout
                    android:id="@+id/top_card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_behavior="com.p1.mobile.putong.core.ui.vip.privilege.vipfrag.behavior.ViewPagerScrollBehavior"/>
                <com.p051p1.mobile.putong.core.p058ui.vip.privilege.vipfrag.view.bottom.AlphaTransformerViewPager
                    android:id="@+id/viewpager_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="com.p1.mobile.putong.core.ui.vip.privilege.vipfrag.behavior.RecycleViewYBehavior"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/viewpager"/>
                <p151v.VSegmentBar
                    android:id="@+id/tab_layout"
                    android:background="@color/white"
                    app:layout_behavior="com.p1.mobile.putong.core.ui.vip.privilege.vipfrag.behavior.TabLayoutScrollBehavior"
                    app:tabBackground="@drawable/core_privilege_tab_layout_bg"
                    app:tabIndicator="@android:color/transparent"
                    app:tabMinWidth="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    style="@style/VSegmentBarStyle"/>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </p151v.VFrame>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/payment_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.PrivilegePaymentView
                android:layout_gravity="bottom"
                android:id="@+id/privilege_payment_view_youth_vip"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.PrivilegePaymentView
                android:layout_gravity="bottom"
                android:id="@+id/privilege_payment_view_female_vip"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.PrivilegePaymentView
                android:layout_gravity="bottom"
                android:id="@+id/privilege_payment_view_vip"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.PrivilegePaymentView
                android:layout_gravity="bottom"
                android:id="@+id/privilege_payment_view_svip"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.PrivilegePaymentView
                android:layout_gravity="bottom"
                android:id="@+id/privilege_payment_view_platinum"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.PrivilegePaymentView
                android:layout_gravity="bottom"
                android:id="@+id/privilege_payment_view_odiamond"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/partner_payment_view"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                flatten="true">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:background="@drawable/core_privilege_partner_payment_view_bg"
                    android:layout_width="match_parent"
                    android:layout_height="80dp">
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="#011703"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/partner_pay_btn"
                        android:background="@drawable/core_privilege_partner_payment_btn_bg"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:text="至尊合伙人申请"/>
                </FrameLayout>
            </FrameLayout>
            <View
                android:layout_gravity="bottom|right"
                android:id="@+id/anchor"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginRight="66dp"
                android:layout_marginBottom="57dp"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
