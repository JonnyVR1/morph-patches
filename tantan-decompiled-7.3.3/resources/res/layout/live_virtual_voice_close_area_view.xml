<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.close.VirtualVoiceCloseView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    app:bind_extends="ConstraintLayout"
    app:binding="true">
    <p151v.VImage
        android:id="@+id/voiceClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="0x7f08275a"/>
    <p151v.VImage
        android:id="@+id/group_info"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voiceClose"
        app:layout_constraintRight_toLeftOf="@+id/voiceClose"
        app:layout_constraintTop_toTopOf="@+id/voiceClose"
        app:srcCompat="0x7f0827b2"/>
    <p151v.VImage
        android:id="@+id/share"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f082752"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voiceClose"
        app:layout_constraintRight_toLeftOf="@+id/voiceClose"
        app:layout_constraintTop_toTopOf="@+id/voiceClose"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.close.VirtualVoiceCloseView>
