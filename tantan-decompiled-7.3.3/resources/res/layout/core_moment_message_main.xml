<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/moment_root_layout"
    android:background="@color/core_profile_moment_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="moment.MomentMessageViewModel">
    <RelativeLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#ccffffff"
            android:id="@+id/top_text_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/MOMENT_CHAT_EMOJI_TIP"
            android:layout_above="@+id/emoji_layout"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/emoji_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_above="@+id/input_layout"
            flatten="true">
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#e6000000"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:enableEmojis="true"/>
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#e6000000"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_two"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:enableEmojis="true"/>
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#e6000000"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_three"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:enableEmojis="true"/>
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#e6000000"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_four"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:enableEmojis="true"/>
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#e6000000"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/emoji_five"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:enableEmojis="true"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/input_layout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            flatten="true">
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/bottom_input_layout"
                android:background="@drawable/core_moment_message_action_send_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="10dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/head_image"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:roundAsCircle="true"/>
                <com.p051p1.mobile.putong.core.p058ui.messages.emoji.VEditTextEmojiCompat
                    android:textSize="16sp"
                    android:textColor="@color/common_black_01"
                    android:textColorHint="@color/text_light"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/input"
                    android:background="@null"
                    android:paddingLeft="8dp"
                    android:paddingTop="9dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="9dp"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:maxLines="4"
                    android:maxLength="1000"
                    android:layout_weight="1"
                    android:lineSpacingExtra="0.5dp"
                    android:inputType="textMultiLine"
                    android:textCursorDrawable="@drawable/core_message_input_cursor"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/common_orange"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/submit"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="@string/MESSAGES_SEND"
                    app:typeface="bold"/>
            </p151v.VLinear>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
