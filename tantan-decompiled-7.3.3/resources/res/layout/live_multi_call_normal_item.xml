<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallNormalItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_white_tr24"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    app:bind_extends="ConstraintLayout"
    app:binding="true"
    app:flatten="true">
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.MysteryAvatarView
        android:id="@+id/real_avatar_view"
        android:clickable="false"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:failureImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:maxWidth="151dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/real_avatar_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/common_white_01"
        android:id="@+id/friend"
        android:background="@drawable/live_bg_fe7e1d_r6"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:text="@string/LIVE_MULTI_CALL_FRIEND"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintLeft_toRightOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <View
        android:id="@+id/live_status_bg"
        android:background="@drawable/live_bg_fe7e1d_r12"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/live_operation"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:text="@string/LIVE_MULTI_CALL_OPERATION_APPROVE"
        android:fontFamily="PingFangSC-Regular"
        app:layout_constraintBottom_toBottomOf="@+id/live_status_bg"
        app:layout_constraintLeft_toLeftOf="@+id/live_status_bg"
        app:layout_constraintRight_toRightOf="@+id/live_status_bg"
        app:layout_constraintTop_toTopOf="@+id/live_status_bg"/>
    <ImageView
        android:id="@+id/live_connecting"
        android:background="0x7f0823ea"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_status_bg"
        app:layout_constraintLeft_toLeftOf="@+id/live_status_bg"
        app:layout_constraintRight_toRightOf="@+id/live_status_bg"
        app:layout_constraintTop_toTopOf="@+id/live_status_bg"/>
    <p151v.VFrame
        android:id="@+id/check_root"
        android:layout_width="70dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VCheckBox
        android:id="@+id/check"
        android:background="@drawable/live_selector_multi_call_check_bg"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:button="@null"
        app:layout_constraintBottom_toBottomOf="@+id/check_root"
        app:layout_constraintLeft_toLeftOf="@+id/check_root"
        app:layout_constraintRight_toRightOf="@+id/check_root"
        app:layout_constraintTop_toTopOf="@+id/check_root"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallNormalItemView>
