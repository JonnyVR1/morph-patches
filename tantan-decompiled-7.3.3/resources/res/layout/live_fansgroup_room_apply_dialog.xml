<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_19191e_tr24"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    flatten="true"
    folder="common.fansgroup"
    holder="FansGroupApplyDialogHolder">
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        app:failureImage="@drawable/live_vector_default_avatar_bg"
        app:placeholderImage="@drawable/live_vector_default_avatar_bg"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="120dp"
        android:layout_toEndOf="@+id/avatar">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#80ffffff"
            android:id="@+id/num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/apply_btn"
        android:background="@drawable/live_selector_fansgroup_btn"
        android:layout_width="77dp"
        android:layout_height="40dp"
        android:text="@string/LIVE_FANSGROUP_APPLY"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
</p151v.VRelative>
