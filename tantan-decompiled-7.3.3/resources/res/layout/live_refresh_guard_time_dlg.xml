<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/live_bg_white_r20"
    android:paddingBottom="27dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="32dp"
    android:layout_marginRight="32dp"
    android:paddingStart="33dp"
    android:paddingEnd="33dp"
    android:layout_marginHorizontal="32dp">
    <p151v.VDraweeView
        android:id="@+id/gift_icon"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:layout_marginTop="36dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="16dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center_horizontal"
        android:id="@+id/guard_refresh_coins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/LIVE_NONE_GUARD"
        android:lineSpacingExtra="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_icon"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/pos"
        android:background="@drawable/live_bg_ff8817_r16"
        android:paddingTop="1dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"/>
    <p151v.VText
        android:textSize="13dp"
        android:textColor="#cccccc"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"/>
</LinearLayout>
