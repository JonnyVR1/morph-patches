<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationFilterLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    folder="newui"
    holder="messages.ConversationFilterLayout">
    <p151v.VRecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/filter_list"
        android:fadingEdgeLength="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="horizontal"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/core_color_66000000"
        android:gravity="center_vertical"
        android:id="@+id/message_header_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:text=""/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/filter_view"
        android:layout_width="67dp"
        android:layout_height="39dp">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/core_filter_new_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.messages.ConversationFilterLayout>
