<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.IntlVoiceFanBaseTaskItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/task_icon"
        android:background="@drawable/live_shape_intl_voice_fan_base_task_icon_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="24dp"/>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="96dp"
        android:layout_marginRight="114dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/task_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="兔子喵Hoti的粉丝团兔子喵Hoti的粉丝团兔子喵Hoti的粉丝团"
            android:maxLines="2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/live_white_50_opacity"
            android:gravity="center_vertical"
            android:id="@+id/task_desc"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:text="兔子喵Hoti的粉丝团"
            android:maxLines="1"/>
    </p151v.VLinear>
    <TextView
        android:textColor="@color/live_selector_intl_voice_fan_base_task_button_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/task_button"
        android:background="@drawable/live_selector_intl_voice_fan_base_task_button_bg"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="24dp"
        android:minWidth="74dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.IntlVoiceFanBaseTaskItem>
