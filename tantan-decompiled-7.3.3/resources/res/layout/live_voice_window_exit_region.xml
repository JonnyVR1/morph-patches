<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/live_black_20_opacity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/exit_area_bg"
        android:background="@drawable/live_vector_voice_exit_area_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_voice_exit_area_height"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/exit_area"
        android:background="@drawable/live_vector_voice_exit_area_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_voice_exit_area_height">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:id="@+id/exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="17dp"
            android:text="@string/LIVE_VOICE_CLOSE_WINDOW"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:background="@drawable/live_vector_voice_window_quit_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/exit"
            app:layout_constraintRight_toLeftOf="@+id/exit"
            app:layout_constraintTop_toTopOf="@+id/exit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
