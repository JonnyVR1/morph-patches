<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.topeffect.view.LiveIntlStarLeaderBoardEffectView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="increment.gift.topeffect.view.LiveIntlStarLeaderBoardEffectView">
    <p151v.VDraweeView
        android:id="@+id/shadow"
        android:background="@drawable/live_shape_user_upgrade_shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/tray_frame"
        android:layout_width="match_parent"
        android:layout_height="375dp"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="199dp"
            android:layout_height="wrap_content"
            android:minWidth="56dp">
            <p151v.VDraweeView
                android:id="@+id/backgroundView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignTop="@+id/content"
                android:layout_alignBottom="@+id/content"/>
            <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
                android:id="@+id/bg_svga"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignTop="@+id/content"
                android:layout_alignBottom="@+id/content"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selamat kepada host telah Selamat kepada"
                android:maxLines="3"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </RelativeLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.topeffect.view.LiveIntlStarLeaderBoardEffectView>
