<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.bottom.BottomVoiceItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="7dp"
    flatten="true"
    folder="common.bottom"
    holder="BottomVoiceItemView">
    <FrameLayout
        android:id="@+id/content"
        android:background="@drawable/live_bg_white_r46_a04"
        android:layout_width="55dp"
        android:layout_height="35dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:actualImageScaleType="fitXY"/>
        <View
            android:layout_gravity="top|right"
            android:id="@+id/red_dot"
            android:background="@drawable/live_bg_ff3938_r3"
            android:visibility="visible"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="1dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="top|right"
            android:id="@+id/tv_num"
            android:background="@drawable/live_bg_ff6464_r4"
            android:paddingTop="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_30_opacity"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_below="@+id/image"
        android:hyphenationFrequency="full"/>
</com.p051p1.mobile.putong.live.livingroom.common.bottom.BottomVoiceItemView>
