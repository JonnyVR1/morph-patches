<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder=".home.card.expanded.transform.OldTransNewViewModel"
    innerClass="true">
    <com.p051p1.mobile.putong.core.newui.home.card.expanded.transform.OldInfoTransOpLayout
        android:id="@+id/action_root"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <View
            android:id="@+id/root_bg_view"
            android:background="@drawable/core_expanded_card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/welcome_root"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VImage
                android:id="@+id/welcome_bg_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/core_old_info_trans_bg"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.tantan.library.svga.SVGAnimationView
                    android:id="@+id/svga_top_anim_view"
                    android:layout_width="375dp"
                    android:layout_height="438dp"
                    android:layout_marginTop="10dp"/>
                <p151v.VText
                    android:textSize="30dp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-15dp"
                    android:text="不只看脸"/>
                <p151v.VText
                    android:textSize="30dp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="探索社交新形象"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <p151v.VDraweeView
                    android:id="@+id/avatar_image"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginTop="15dp"
                    app:roundAsCircle="true"/>
                <p151v.VText
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="已为你生成全新资料页\10上滑查看"/>
                <com.tantan.library.svga.SVGAnimationView
                    android:id="@+id/svga_bottom_anim_view"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="50dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
        <com.p051p1.mobile.putong.core.newui.home.card.expanded.UserProfileExpandedLayout
            android:id="@+id/user_info_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="44dp"
            android:alpha="0"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/core_new_info_buttom_root_bg"
            android:layout_width="match_parent"
            android:layout_height="110dp"/>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/action_button_layout"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            flatten="true">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16dp"
                android:textColor="@color/common_grey_03"
                android:gravity="center"
                android:id="@+id/edit_profile_btn"
                android:background="@drawable/core_bg_new_info_edit"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="5dp"
                android:text="修改资料"
                android:layout_weight="1"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/save_profile_btn"
                android:background="@drawable/common_button_btn_orange_large"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="20dp"
                android:text="确认新资料页"
                android:layout_weight="1"/>
        </p151v.VLinear>
    </com.p051p1.mobile.putong.core.newui.home.card.expanded.transform.OldInfoTransOpLayout>
    <p151v.VFrame
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/action_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="true">
        <View
            android:id="@+id/action_bar_bg_view"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <p151v.VImage
            android:id="@+id/close_btn"
            android:padding="6dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:srcCompat="0x7f082986"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="21dp"
            android:textColor="@color/common_000000_80"
            android:layout_gravity="center_vertical"
            android:id="@+id/action_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="48dp"
            android:text="查看全新资料页"
            android:alpha="0"/>
    </p151v.VFrame>
</FrameLayout>
