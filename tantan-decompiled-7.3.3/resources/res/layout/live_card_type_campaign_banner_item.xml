<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.campaignBanner.LiveCampaignBannerItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"
        app:placeholderImage="@drawable/live_shape_cover_square_nearby_item_image"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"/>
    <p151v.VDraweeView
        android:id="@+id/pic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="6dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/pic"
        app:layout_constraintRight_toLeftOf="@+id/btn"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#99ffffff"
            android:ellipsize="end"
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginRight="12dp"
        android:minWidth="63dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.campaignBanner.LiveCampaignBannerItemView>
