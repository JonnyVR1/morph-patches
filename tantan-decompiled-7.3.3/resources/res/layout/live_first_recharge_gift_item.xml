<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.recharge.LocalFirstRechargeGiftItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_bg_fffbeb_r16_a35"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="increment.recharge.LocalFirstRechargeGiftItemView">
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_a36313"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/mark_text"
        android:background="@drawable/live_shape_first_recharge_gift_mask_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="32dp"
        android:maxWidth="52dp"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/icon_bg_img"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="5dp"
        app:actualImageScaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VImage
        android:id="@+id/action_img"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="2dp"
        android:scaleType="fitXY"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/icon_bg_img"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_a36313"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/sub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/live_a36313_50_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/button_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_layout"
        android:background="@drawable/live_bg_ffe6ae_br16"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <p151v.VText
            android:textColor="@color/live_fff8d7"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sub_title_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <p151v.VImage
            android:id="@+id/go_detail_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="0x7f0822b7"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/button_layout"
            app:layout_constraintStart_toEndOf="@+id/sub_title_text"
            app:layout_constraintTop_toTopOf="@+id/button_layout"/>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VImage
                android:id="@+id/highlight_first"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:src="0x7f0824b0"
                android:scaleType="fitXY"/>
        </p151v.VFrame>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.recharge.LocalFirstRechargeGiftItemView>
