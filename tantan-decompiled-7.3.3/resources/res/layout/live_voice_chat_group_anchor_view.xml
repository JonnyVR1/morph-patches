<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#4d000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="voice.intl"
    holder="chatgroup.dialog.VoiceChatGroupLiveContentViewModel">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:background="@drawable/live_bg_white_tr24"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            flatten="true">
            <p151v.VText
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#e6000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/LIVE_VOICE_CHAT_GROUP_TEXT"
                android:layout_marginStart="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chat_info_container"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@+id/title"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/group_profile"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:roundAsCircle="true"/>
                <include
                    android:orientation="vertical"
                    android:id="@+id/group_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/group_profile"
                    app:layout_constraintRight_toLeftOf="@+id/right_arrow"
                    app:layout_constraintTop_toTopOf="parent"
                    flatten="true"
                    layout="@layout/live_voice_chat_group_info_view"/>
                <ImageView
                    android:id="@+id/right_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="24dp"
                    android:src="0x7f08277c"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/body"
            android:background="@color/live_white"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#fe7e1d"
                android:id="@+id/apply_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/LIVE_VOICE_CHAT_GROUP_APPLY_LIST_TEXT"
                android:layout_marginStart="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/split"
                android:background="#f9f9f9"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="15dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/apply_name"/>
            <View
                android:id="@+id/indicator"
                android:background="@drawable/live_bg_fe7e1d_r2"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginStart="18dp"
                app:layout_constraintLeft_toLeftOf="@+id/apply_name"
                app:layout_constraintTop_toTopOf="@+id/split"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/apply_list_empty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="264dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/split">
                <p151v.VImage
                    android:layout_gravity="center_horizontal"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="44dp"
                    android:src="0x7f08277b"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#4d323232"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/LIVE_VOICE_ROOM_CHAT_GROUP_APPLY_EMPTY"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apply_list"
                android:layout_width="match_parent"
                android:layout_height="264dp"
                android:layout_marginTop="24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/split"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
