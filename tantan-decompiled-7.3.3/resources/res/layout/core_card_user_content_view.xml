<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardUserContentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardUserContentView">
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/details"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:singleLine="true"
        android:shadowColor="@color/common_light_02"
        android:shadowDx="1"
        android:shadowDy="1"
        android:fontFamily="PingFangSC-Semibold"
        android:lineHeight="20dp"/>
    <com.p051p1.mobile.putong.core.newui.main.view.LinearLayoutFixedLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/third_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/age_sex_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/superlike_recv"
            android:background="@drawable/core_superlike_star_recv"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            android:drawableLeft="0x7f081786"
            android:drawablePadding="2dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/me_was_liked_ab"
            android:background="@drawable/core_card_tag_me_by_liked_style2_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            android:drawableLeft="0x7f0805d5"
            android:drawablePadding="4dp"/>
        <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
            android:id="@+id/odiamond_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"/>
        <com.p051p1.mobile.putong.newui.view.VIPShimmerTag
            android:id="@+id/vip_shimmer_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"/>
        <p151v.VImage
            android:id="@+id/vip_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:src="@drawable/vip_status_vip"/>
        <include
            android:id="@+id/black_diamond_tag"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            layout="@layout/core_black_diamond_tag_layout_view"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/age_sex_content_opt"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"/>
        <p151v.VDraweeView
            android:id="@+id/wealth_icon"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="5dp"/>
        <p151v.VText
            android:id="@+id/online_active"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            android:drawableLeft="0x7f0805db"
            style="@style/core_card_small_tag"/>
        <p151v.VText
            android:id="@+id/icon_student"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            android:text="@string/PROFILE_IS_STUDENT_STRING"
            android:drawableLeft="0x7f080603"
            style="@style/core_card_small_tag"/>
        <p151v.VText
            android:id="@+id/new_user"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            android:text="@string/CORE_SVIP_ADVANCED_FILTER_NEW_USER"
            android:drawableLeft="0x7f0805d8"
            style="@style/core_card_small_tag"/>
        <p151v.VText
            android:id="@+id/icon_purpose"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            android:drawableLeft="@drawable/core_card_purpose_ic"
            android:drawablePadding="5dp"
            style="@style/core_card_small_tag"/>
        <p151v.VLinear
            android:gravity="left"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/purpose"
            android:background="@drawable/core_card_small_tag_blur_bg"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="5dp"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/purpose_img"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
            <p151v.VText
                android:id="@+id/tv_purpose"
                android:background="@null"
                android:paddingLeft="2dp"
                android:paddingRight="1dp"
                style="@style/core_card_small_tag"/>
        </p151v.VLinear>
        <p151v.VText
            android:id="@+id/zodiac"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            style="@style/core_card_small_tag"/>
        <p151v.VText
            android:id="@+id/mutual_friends"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            style="@style/core_card_small_tag"/>
    </com.p051p1.mobile.putong.core.newui.main.view.LinearLayoutFixedLayout>
</com.p051p1.mobile.putong.core.newui.home.views.CardUserContentView>
