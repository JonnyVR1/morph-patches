<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/feed_rect_rounded_post_topic"
    android:paddingLeft="13dp"
    android:paddingTop="11dp"
    android:paddingRight="13dp"
    android:paddingBottom="11dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="topic.topiclist.GroupTopicListCombineItemView">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/feed_post_topic_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/selected_topic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/anonymous_txt"
        android:background="@drawable/feed_post_bg_anonymous_topic"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_marginLeft="4dp"
        android:text="匿名"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/delete_topic"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:src="0x7f081e73"
        android:scaleType="center"/>
</p151v.VLinear>
