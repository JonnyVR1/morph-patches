<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.officialshow.avatar.OfficialShowAvatarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="officialshow"
    holder="avatar.OfficialShowAvatarView">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/background"
        android:background="0x7f0821fb"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="39dp"
        android:layout_marginLeft="3dp"
        android:paddingStart="24dp"
        flatten="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="6dp"
            flatten="true">
            <p151v.VText
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="72dp"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VText
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_white_80_opacity"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:layout_gravity="top"
                    android:id="@+id/heart"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/LIVE_ANCHOR_PROFILE_HEARTBEAT"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/follow_back"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/follow"
                android:background="@drawable/live_bg_ff8817_r10"
                android:visibility="invisible"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:text="订阅"
                flatten="true"/>
        </FrameLayout>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="-3dp"/>
</com.p051p1.mobile.putong.live.livingroom.officialshow.avatar.OfficialShowAvatarView>
