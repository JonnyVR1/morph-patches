<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/core_new_messages_prompt"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/core_msg_cell_no_pic_margin"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/core_msg_cell_no_pic_margin"
        android:layout_marginBottom="10dp">
        <p151v.VImage
            android:id="@+id/iv"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:srcCompat="@drawable/core_message_countdown_like"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <p151v.VText
                android:textSize="14dp"
                android:textColor="@color/common_black_02"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                android:text="@string/FAKE_MATCH_PAGE_TITLE"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/common_grey_09"
                android:gravity="center_vertical"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="18dp"
                android:text="@string/CHAT_PAGE_NOTE_GRET"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
