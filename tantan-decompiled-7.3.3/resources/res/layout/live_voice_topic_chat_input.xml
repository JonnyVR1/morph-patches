<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.dialog.topic.LiveVoiceTopicInputView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:background="@drawable/live_shape_voice_topic_edit_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="65dp"
    app:bind_extends="LinearLayout"
    app:bind_implements="null"
    app:binding="true">
    <p151v.VEditText
        android:textSize="14sp"
        android:textColor="@color/live_white_80_opacity"
        android:textColorHint="@color/live_white_40_opacity"
        android:id="@+id/edit_text"
        android:background="@drawable/live_bg_white_r10_a03"
        android:paddingLeft="10dp"
        android:paddingTop="11dp"
        android:paddingRight="10dp"
        android:paddingBottom="11dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:maxLines="1"
        android:layout_weight="1"/>
    <p151v.VText
        android:enabled="false"
        android:textSize="15sp"
        android:textColor="@color/live_voice_chat_input_done_text"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/done"
        android:background="@drawable/live_selector_voice_functions_confirm_bt_bg"
        android:layout_width="52dp"
        android:layout_height="38dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:text="确认"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.room.functions.dialog.topic.LiveVoiceTopicInputView>
