<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_explore_add_tag_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="explore.view.ExploreAddTagDialog">
    <p151v.VImage
        android:id="@+id/explore_dialog_close"
        android:padding="16dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="0x7f08080a"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/explore_dialog_icon"
        android:layout_width="140dp"
        android:layout_height="110dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="12dp"
        app:actualImageScaleType="fitCenter"
        app:failureImageScaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImageScaleType="fitCenter"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/common_000000_80"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/sub_title"
        app:layout_constraintEnd_toEndOf="@+id/sub_title"
        app:layout_constraintStart_toStartOf="@+id/sub_title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toTopOf="@+id/confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/core_explore_confirm_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
