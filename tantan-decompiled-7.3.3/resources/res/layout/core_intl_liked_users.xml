<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="#120f10"
    android:fitsSystemWindows="false"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    holder="intllikedusers.IntlLikedUsersViewModel">
    <p151v.VImage
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f080ae4"
        android:scaleType="fitStart"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="false">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftIcon="@drawable/core_intl_liked_back"
            app:title="@string/INTL_TAB_ME_LIKE_SENT_TITLE"/>
        <FrameLayout
            android:id="@+id/intl_liked_users_discount_banner_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <p151v.VFrame
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <p151v.VFrame
                android:id="@+id/loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/empty"
                    android:paddingBottom="40dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <p151v.VImage
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080ae8"
                        android:scaleType="centerInside"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="@color/core_stroke_4dffffff"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="110dp"
                        android:layout_marginTop="42dp"
                        android:layout_marginRight="110dp"
                        android:text="@string/INTL_SUPERLIKE_FUNCTION_INTRODUCTION"
                        android:layout_marginHorizontal="110dp"/>
                </LinearLayout>
            </p151v.VFrame>
            <p151v.VPullUpRecyclerView
                android:id="@+id/list"
                android:paddingLeft="4dp"
                android:paddingTop="5dp"
                android:paddingRight="4dp"
                android:paddingBottom="91dp"
                android:visibility="invisible"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/bottom_bg"
                android:background="@drawable/core_intl_liked_user_bottom_gradient"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="86dp"/>
            <p151v.VText_NoTopPadding
                android:textSize="16sp"
                android:textColor="@color/common_black_80"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/get_privilege"
                android:background="@drawable/core_intl_privilege_combo_buy"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="15dp"
                android:text="@string/INTL_I_LIKE_UNCLOCK_BTN"
                android:textAllCaps="false"
                android:layout_marginHorizontal="16dp"
                app:fontWeight="500"/>
        </p151v.VFrame>
    </p151v.VLinear>
</p151v.VFrame>
