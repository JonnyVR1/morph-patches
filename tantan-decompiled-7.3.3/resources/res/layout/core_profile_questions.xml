<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/questions"
    android:paddingTop="0dp"
    flatten="true"
    style="@style/profile_item_frame_no_padding_new">
    <p151v.VText
        android:textStyle="bold"
        android:id="@+id/question_tip"
        android:background="@color/transparent"
        android:paddingTop="24dp"
        android:paddingBottom="0dp"
        android:text="@string/PROFILE_SECTION_HEADER_QUESTIONS"
        style="@style/profile_item_title_black"/>
    <p151v.VText_Tags
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:id="@+id/add"
        android:background="@drawable/tf_rect_light"
        android:paddingLeft="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="2dp"
        android:minHeight="48dp"
        android:hint="@string/PROFILE_ANSWERS_ADD_NEW"
        app:typeface="regular"/>
</p151v.VLinear_Dividers>
