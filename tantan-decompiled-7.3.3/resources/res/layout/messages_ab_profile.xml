<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.model.view.MessageActionBarLeftLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/left_title"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.model.view.MessageActionBarLeftLayout">
    <p151v.VFrame
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/title_layout_profile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginRight="-1dp">
        <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:foreground="@null"
            app:show_audio_chat_frame="true"/>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="bottom|right"
            android:id="@+id/state_container"
            android:background="@drawable/core_bg_round_white"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerInParent="true">
            <p151v.VDraweeView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                style="@style/core_im_fresco_profile_small"/>
        </p151v.VLinear>
    </p151v.VFrame>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:id="@+id/title_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <p151v.VFrame
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/online_match_profile"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp">
            <com.p051p1.mobile.putong.core.newui.talk.view.NewTalkProgressView
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/image2"
                android:layout_width="33dp"
                android:layout_height="33dp"
                app:foreground="@null"
                style="@style/core_im_fresco_profile_small"/>
        </p151v.VFrame>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="false">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/title_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="16dp"
                    flatten="false">
                    <p151v.VText
                        android:textSize="16dp"
                        android:textColor="@color/common_black_02"
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                    <p151v.VDraweeView
                        android:layout_gravity="center"
                        android:id="@+id/emoji"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="6dp"/>
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/verification_icon_right"
                        android:background="0x7f082957"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginLeft="4dp"
                        useId="true"/>
                    <p151v.VLinear
                        android:layout_gravity="center"
                        android:id="@+id/certification_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"/>
                    <com.p051p1.mobile.putong.newui.view.ODiamondTagLabel
                        android:layout_gravity="center"
                        android:id="@+id/odiamond_label"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/svip_tag"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                    <p151v.VLinear
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_know_label"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        flatten="true">
                        <p151v.VText
                            android:textSize="9sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/know_label"
                            android:background="#84dbff"
                            android:paddingLeft="5dp"
                            android:paddingTop="2dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:text="冰山威士忌"
                            android:layout_marginEnd="4dp"
                            android:paddingHorizontal="5dp"/>
                    </p151v.VLinear>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="top|left"
                    android:orientation="horizontal"
                    android:id="@+id/subtitle_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <p151v.VImage
                        android:id="@+id/icon"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="3dp"/>
                    <p151v.VText
                        android:textAppearance="@style/TextAppearance.Widget.AppCompat.Toolbar.Subtitle"
                        android:textSize="12dp"
                        android:textColor="@color/common_grey_09"
                        android:ellipsize="end"
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="4dp"
                        android:maxLines="1"/>
                </LinearLayout>
                <p151v.VText
                    android:textAppearance="@style/TextAppearance.Widget.AppCompat.Toolbar.Subtitle"
                    android:textSize="12dp"
                    android:textColor="#b2b2b2"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/inputting"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/MESSAGES_CHAT_TYPING_TEXT"
                    android:maxLines="1"/>
            </LinearLayout>
            <p151v.VImage
                android:id="@+id/toggle_photos_btn"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/core_message_photos_toggle_up"
                android:layout_marginStart="-32dp"/>
        </LinearLayout>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="@color/common_black_01"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/topic_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="15dp"
        android:maxLines="1"
        android:layout_weight="1"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.messages.model.view.MessageActionBarLeftLayout>
