<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.square.search.widgets.LiveSearchAnchorItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="square.search"
    holder="widgets.LiveSearchAnchorItemView">
    <p151v.VRelative
        android:layout_width="55dp"
        android:layout_height="60dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp">
        <p151v.VDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_alignParentTop="true"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/live_shape_banner_profile_placeholder"
            app:roundAsCircle="true"/>
        <include
            android:id="@+id/living"
            android:layout_width="21dp"
            android:layout_height="15dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            layout="@layout/live_hour_board_list_mainland_living_view"/>
        <p151v.VImage
            android:id="@+id/live_official_show_tag"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="15dp"
            android:src="0x7f082111"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </p151v.VRelative>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_gray_01"
            android:ellipsize="end"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Medium"
            app:layout_constraintEnd_toStartOf="@+id/anchor_level_view"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VDraweeView
            android:id="@+id/anchor_level_view"
            android:layout_width="32dp"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/title_text"
            app:layout_constraintLeft_toRightOf="@+id/title_text"
            app:layout_constraintTop_toTopOf="@+id/title_text"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_gray_7a"
            android:ellipsize="end"
            android:id="@+id/desc_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/on_going"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svga"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="7dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"/>
        <p151v.VImage
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="7dp"
            app:srcCompat="0x7f0824da"/>
    </LinearLayout>
    <p151v.VButton
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_follow"
        android:background="@drawable/common_button_btn_orange_small"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:fontFamily="PingFangSC-Semibold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.live.external.square.search.widgets.LiveSearchAnchorItemView>
