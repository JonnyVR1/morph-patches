<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUiGPPurchaseUpgradeSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="12dp"
    holder="purchase.showcase.NewUiGPPurchaseUpgradeSectionView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <p151v.VText
            android:textSize="26sp"
            android:textColor="@color/common_grey_01"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="17dp"
            android:singleLine="true"
            app:layout_constraintBottom_toTopOf="@+id/select_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="22dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_grey_01"
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="5dp"
            android:text="个月"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/count"
            app:layout_constraintLeft_toRightOf="@+id/count"
            app:typeface="regular"/>
        <p151v.VText_AutoFit
            android:textSize="18sp"
            android:textColor="@color/common_grey_02"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:singleLine="true"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VText_AutoFit
            android:textSize="13sp"
            android:textColor="@color/common_grey_01"
            android:layout_gravity="center_horizontal"
            android:id="@+id/origin_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="51dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/center_price"
            app:typeface="regular"/>
        <View
            android:id="@+id/select_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/count"/>
        <p151v.VText
            android:textSize="15sp"
            android:id="@+id/select_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/INTL_UPGRADE_SELECT_DURATION"
            app:layout_constraintBottom_toBottomOf="@+id/select_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/select_bg"/>
        <p151v.VImage
            android:id="@+id/select_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:src="0x7f080cc6"
            app:layout_constraintBottom_toBottomOf="@+id/select_bg"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/select_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="left"
        android:id="@+id/label"
        android:paddingLeft="16dp"
        android:paddingTop="1dp"
        android:paddingRight="16dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:text="@string/INTL_UPGRADE_SKU_TAG"
        android:maxLines="1"
        android:paddingHorizontal="16dp"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUiGPPurchaseUpgradeSectionView>
