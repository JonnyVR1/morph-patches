<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemLoveBuzzUnlockLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.ItemLoveBuzzUnlockLayout">
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:layout_width="82dp"
        android:layout_height="82dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:background="0x7f080b17"
            android:layout_width="82dp"
            android:layout_height="82dp"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/other_head"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:cropToPadding="false"
            app:roundAsCircle="true"/>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_black_01"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/INTL_BUZZ_IM_UNLOCK_TIP_TITLE_1"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/core_color_80000000"
        android:gravity="center_horizontal"
        android:id="@+id/text_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/INTL_BUZZ_IM_UNLOCK_TIP_DESCRIPTION_1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:typeface="regular"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemLoveBuzzUnlockLayout>
