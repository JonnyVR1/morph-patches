<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.upgradegift.view.UpgradeGiftEquipView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="310dp"
    flatten="true"
    folder="increment.gift.upgradegift.view"
    holder="UpgradeGiftEquipView">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.immomo.svgaplayer.view.MomoLayUpSVGAImageView
            android:id="@+id/bg_svga"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.p051p1.mobile.putong.live.base.view.XEGiftView
            android:id="@+id/bg_gift_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:id="@+id/arrowFirst"
        android:background="0x7f0826be"
        android:layout_width="56dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/currentUse"
        app:layout_constraintEnd_toStartOf="@+id/currentUse"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/currentUse"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#91f3ff"
        android:id="@+id/currentUse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/LIVE_UPGRADE_GIFT_CURRENT_USER"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/arrowSecond"
        app:layout_constraintStart_toEndOf="@+id/arrowFirst"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/arrowSecond"
        android:background="0x7f0826be"
        android:layout_width="56dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/currentUse"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/currentUse"
        app:layout_constraintTop_toTopOf="@+id/currentUse"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="26dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/nameBg"
        android:layout_width="171dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="62dp"
        app:layout_constraintBottom_toBottomOf="@+id/nameBg"
        app:layout_constraintStart_toStartOf="@+id/nameBg"
        app:layout_constraintTop_toTopOf="@+id/nameBg"
        app:placeholderImage="0x7f0822c4"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/coinAndTime"
        android:background="@drawable/live_shape_upgrade_gift_equip_coin_and_time_bg"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        android:layout_marginBottom="11dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/coin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="3dp"
            android:drawableStart="0x7f0826aa"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="3dp"
            android:drawableStart="0x7f0826c0"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.upgradegift.view.UpgradeGiftEquipView>
