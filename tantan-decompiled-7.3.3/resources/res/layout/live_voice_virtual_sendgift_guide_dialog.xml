<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.member.LiveVoiceVirtualSendGiftGuideDialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="voice.member.LiveVoiceVirtualSendGiftGuideDialog">
    <androidx.legacy.widget.Space
        android:id="@+id/space"
        android:layout_width="43dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/my_avatar"
        android:layout_width="115dp"
        android:layout_height="115dp"
        android:layout_marginTop="42dp"
        android:scaleType="centerCrop"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintRight_toRightOf="@+id/space"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
        android:id="@+id/other_avatar"
        android:layout_width="115dp"
        android:layout_height="115dp"
        android:layout_marginTop="42dp"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="@+id/space"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_avatar"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/live_black_40_opacity"
        android:gravity="center"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/btn_layout"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content">
        <p151v.VText
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/btn_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="12dp"
            android:textColor="@color/live_white_80_opacity"
            android:gravity="center"
            android:id="@+id/btn_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/live_black_20_opacity"
        android:gravity="center"
        android:id="@+id/cancel"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="取消"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_layout"/>
</com.p051p1.mobile.putong.live.livingroom.voice.member.LiveVoiceVirtualSendGiftGuideDialog>
