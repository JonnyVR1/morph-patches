<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.base.player.LiveRtcPlayErrorView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingBottom="100dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="base"
    holder="player.LiveRtcPlayErrorView">
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/live_net_error_linear"
        android:background="@drawable/live_bg_black_r10_a50"
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="19dp"
            android:text="@string/LIVE_FOLLOW_ANCHOR"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <View
            android:id="@+id/bt_line"
            android:background="#32ffffff"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/error_bt"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:text="@string/LIVE_RETRY"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.base.player.LiveRtcPlayErrorView>
