<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.intl.greet.message.IntlGreetListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/core_new_dynamic_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    flatten="true"
    holder="intl.greet.message.IntlGreetListItemView"> &apos; 
    <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
        android:id="@+id/profile_wrapper"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_margin="7dp"
        android:src="0x7f080435"
        app:failureImage="@color/common_light_04"
        app:placeholderImage="@color/common_light_04"
        style="@style/core_im_fresco_greet_small"/>
    <View
        android:id="@+id/online_rot"
        android:background="@drawable/core_greet_list_online_dot"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginBottom="5dp"
        android:layout_alignBottom="@+id/profile_wrapper"
        android:layout_marginEnd="4dp"
        android:layout_alignEnd="@+id/profile_wrapper"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/unread_dot"
        android:background="@drawable/core_bg_new_dynamic_greet"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:minWidth="24dp"
        android:layout_marginStart="48dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentRight="true"/>
    <p151v.VFrame
        android:id="@+id/name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_toStartOf="@+id/time"
        android:layout_toEndOf="@+id/profile_wrapper"
        flatten="true">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#e6000000"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:drawablePadding="5dp"/>
        </LinearLayout>
    </p151v.VFrame>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:id="@+id/profile_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_below="@+id/name_layout"
        android:layout_marginEnd="14dp"
        android:layout_alignStart="@+id/name_layout"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/greet_from_other"
        android:background="@drawable/core_new_dynamic_text_bg"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:drawablePadding="5dp"
        android:layout_below="@+id/profile_info"
        android:layout_marginEnd="14dp"
        android:layout_alignStart="@+id/name_layout"
        app:enableEmojis="true"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:id="@+id/greet_from_me"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_below="@+id/name_layout"
        android:layout_marginEnd="14dp"
        android:layout_alignStart="@+id/name_layout"
        app:enableEmojis="true"
        app:typeface="regular"/>
</com.p051p1.mobile.putong.core.p058ui.intl.greet.message.IntlGreetListItemView>
