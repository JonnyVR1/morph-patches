<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.loop.authentication.MarryEditAvatarAuthenticationViewModel">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="90dp">
        <p151v.VRelative
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="24sp"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="头像认证"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                style="@style/marry_loop_edit_title_text"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#4d000000"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="40dp"
                android:text="精选用户均已通过头像本人认证，希望你也使用真实头像和他们交友"
                android:maxLines="2"
                android:layout_below="@+id/title"
                android:layout_centerHorizontal="true"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/certification_avatar_background_corners_16"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="333dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="40dp"
                android:layout_below="@+id/content"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/background_icon"
                    android:layout_width="235dp"
                    android:layout_height="177dp"
                    android:layout_marginTop="44dp"
                    android:src="0x7f080688"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="138dp"
                    android:layout_height="170dp"
                    app:actualImageScaleType="centerCrop"
                    app:failureImage="@color/common_light_04"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/background_icon"
                    app:placeholderImage="@color/common_light_04"
                    app:roundedCornerRadius="16dp"
                    app:roundingBorderColor="#f0fbff"
                    app:roundingBorderPadding="1dp"
                    app:roundingBorderWidth="4dp"/>
                <p151v.VImage
                    android:layout_width="235dp"
                    android:layout_height="177dp"
                    android:layout_marginTop="44dp"
                    android:src="0x7f080687"
                    app:layout_constraintBottom_toBottomOf="@+id/background_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <p151v.VImage
                    android:id="@+id/icon_1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:src="0x7f080664"
                    android:layout_marginStart="40dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/background_icon"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:id="@+id/icon_1_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="加速曝光"
                    app:layout_constraintEnd_toEndOf="@+id/icon_1"
                    app:layout_constraintStart_toStartOf="@+id/icon_1"
                    app:layout_constraintTop_toBottomOf="@+id/icon_1"/>
                <p151v.VImage
                    android:id="@+id/icon_2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="0x7f080665"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/icon_1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="认证标识"
                    app:layout_constraintEnd_toEndOf="@+id/icon_2"
                    app:layout_constraintStart_toStartOf="@+id/icon_2"
                    app:layout_constraintTop_toBottomOf="@+id/icon_2"/>
                <p151v.VImage
                    android:id="@+id/icon_3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="0x7f080666"
                    android:layout_marginEnd="40dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/icon_1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="推荐优质用户"
                    app:layout_constraintEnd_toEndOf="@+id/icon_3"
                    app:layout_constraintStart_toStartOf="@+id/icon_3"
                    app:layout_constraintTop_toBottomOf="@+id/icon_3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </p151v.VRelative>
    </ScrollView>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/certification_avatar_btn_background_verified"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="去认证"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"/>
</p151v.VRelative>
