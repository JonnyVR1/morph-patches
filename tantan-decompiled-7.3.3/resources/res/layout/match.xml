<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/match_root"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="match.MatchActViewModel"
    innerClass="true">
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/passby_text"
        android:background="@drawable/bg_passby_20_percent_black"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:drawableLeft="0x7f0802d5"
        android:drawablePadding="4dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <View
        android:id="@+id/bottom_cover1"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/bottom_cover2"
        android:background="@drawable/bg_match_chat_optimize_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="218dp"
        android:layout_above="@+id/bottom_cover1"/>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="#ccffffff"
        android:id="@+id/share_tv"
        android:background="@color/transparent"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:text="分享"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <com.sunshine.engine.particle.SceneView
        android:id="@+id/lanterns_scene"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/center_div"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerInParent="true"/>
    <p151v.VDraweeView
        android:id="@+id/profile_me"
        android:layout_width="@dimen/core_match_profile_image_size"
        android:layout_height="@dimen/core_match_profile_image_size_height"
        android:layout_marginRight="@dimen/core_match_profile_image_overlap"
        android:layout_toLeftOf="@+id/center_div"
        android:layout_above="@+id/center_div"
        style="@style/core_fresco_profile_white_border"/>
    <p151v.VImage
        android:id="@+id/christmas_hat_me"
        android:visibility="gone"
        android:layout_width="121dp"
        android:layout_height="122dp"
        android:layout_marginRight="-80dp"
        android:layout_marginBottom="-80dp"
        android:src="0x7f0802f0"
        android:layout_toLeftOf="@+id/profile_me"
        android:layout_above="@+id/profile_me"/>
    <p151v.VDraweeView
        android:id="@+id/profile_other"
        android:layout_width="@dimen/core_match_profile_image_size"
        android:layout_height="@dimen/core_match_profile_image_size_height"
        android:layout_marginLeft="@dimen/core_match_profile_image_overlap"
        android:cropToPadding="false"
        android:layout_toRightOf="@+id/center_div"
        android:layout_above="@+id/center_div"
        style="@style/core_fresco_profile_white_border"/>
    <p151v.VImage
        android:id="@+id/christmas_hat_other"
        android:visibility="gone"
        android:layout_width="121dp"
        android:layout_height="122dp"
        android:layout_marginLeft="-80dp"
        android:layout_marginBottom="-80dp"
        android:src="0x7f0802f1"
        android:layout_toRightOf="@+id/profile_other"
        android:layout_above="@+id/profile_other"/>
    <p151v.VImage
        android:id="@+id/intl_receive_like_other"
        android:background="0x7f080b28"
        android:visibility="gone"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginRight="-30dp"
        android:layout_marginBottom="-18dp"
        android:layout_alignBottom="@+id/profile_other"
        android:layout_alignEnd="@+id/profile_other"/>
    <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
        android:id="@+id/heart"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="@dimen/core_match_profile_heart_margin"
        android:scaleType="centerInside"
        android:layout_above="@+id/profile_me"
        android:layout_centerHorizontal="true"
        app:iconWidth="22dp"/>
    <p151v.VLinear_FillerMeasure
        android:orientation="horizontal"
        android:id="@+id/text_like_ui1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="250dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:fillerIndex="0"
        flatten="true">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/text_white"
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:singleLine="true"
            app:autoSizeTextType="uniform"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/text_white"
            android:id="@+id/text_name_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 也喜欢了你"
            app:autoSizeTextType="uniform"
            app:typeface="regular"/>
    </p151v.VLinear_FillerMeasure>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/matching_degree_ll"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="218dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/text_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/matching_degree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="匹配度 "
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeTextType="uniform"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/text_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/matching_degree_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="98%"
            app:autoSizeMaxTextSize="22sp"
            app:autoSizeTextType="uniform"
            app:typeface="regular"/>
    </LinearLayout>
    <p151v.VText_AutoFit
        android:textSize="18sp"
        android:textColor="@color/text_white"
        android:gravity="center"
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="15dp"
        android:layout_above="@+id/normal_btn_container_root"
        android:layout_below="@+id/profile_me"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeTextType="uniform"
        app:typeface="regular"
        useId="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/normal_btn_container_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        flatten="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/normal_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VButton_FakeShadow
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/start_conversation"
                android:background="@drawable/rect_common_rounded_tantan_orange"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:minWidth="264dp"
                android:text="@string/MATCH_BUTTON_START_A_CONVERSATION"
                android:drawablePadding="15dp"
                style="@style/core_main_button"/>
            <p151v.VButton_FakeShadow
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cancel"
                android:background="@drawable/rect_rounded_stroke_white"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/margin_standard"
                android:minWidth="264dp"
                android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
                style="@style/core_main_button"/>
        </LinearLayout>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="@color/text_white_medium"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/share"
            android:background="@drawable/tf_rect_light"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="24dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_standard"
            android:text="@string/SHARE_MATCH_TELL_YOUR_FRIENDS"
            android:maxLines="1"
            android:drawablePadding="10dp"
            android:textAllCaps="true"
            app:vectorDrawableLeft="@drawable/match_invite_ic"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/usa_btn_container"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/normal_btn_container_root"
        flatten="true">
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/usa_cancel"
            android:background="@drawable/usa_match_sliding_background"
            android:paddingLeft="@dimen/usa_btn_padding"
            android:paddingRight="@dimen/usa_btn_padding"
            android:layout_width="@dimen/usa_btn_width"
            android:layout_height="@dimen/usa_btn_height"
            android:text="@string/MATCH_BUTTON_KEEP_PLAYING"
            app:typeface="regular"/>
        <View
            android:layout_width="24dp"
            android:layout_height="0dp"/>
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="@color/usa_match_start_conversation_text"
            android:gravity="center"
            android:id="@+id/usa_start_conversation"
            android:background="@drawable/usa_match_conversation_background"
            android:paddingLeft="@dimen/usa_btn_padding"
            android:paddingRight="@dimen/usa_btn_padding"
            android:layout_width="@dimen/usa_btn_width"
            android:layout_height="@dimen/usa_btn_height"
            android:text="@string/MATCH_BUTTON_START_A_CONVERSATION"
            app:typeface="regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/usa_fake_btn_container"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/normal_btn_container_root"
        flatten="true">
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/usa_fake_cancel"
            android:background="@drawable/usa_match_sliding_background"
            android:paddingLeft="@dimen/usa_btn_padding"
            android:paddingRight="@dimen/usa_btn_padding"
            android:layout_width="@dimen/usa_btn_width"
            android:layout_height="@dimen/usa_btn_height"
            android:text="@string/INTL_SAYHI_ATTEMPTED_MATCH_IGNORE_BTN_USA"
            app:typeface="regular"/>
        <View
            android:layout_width="24dp"
            android:layout_height="0dp"/>
        <p151v.VButton
            android:textSize="17sp"
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/usa_fake_start_conversation"
            android:background="@drawable/usa_match_conversation_background"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="@dimen/usa_btn_width"
            android:layout_height="@dimen/usa_btn_height"
            android:text="@string/INTL_SAYHI_ATTEMPTED_MATCH_BTN_USA"
            android:drawableLeft="0x7f080b1f"
            app:typeface="regular"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/camera_tab_unselected"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/text_topic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80dp"
        android:layout_marginRight="80dp"
        android:layout_marginBottom="173dp"
        android:text="聊聊你们的共同兴趣 “海贼王”"
        android:singleLine="true"
        android:layout_alignParentBottom="true"
        app:autoSizeMaxTextSize="18sp"/>
    <RelativeLayout
        android:id="@+id/edit_rl"
        android:background="@drawable/edit_matching_topic_shape"
        android:visibility="gone"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="106dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VEditText
            android:textSize="18sp"
            android:textColor="#aaaaaa"
            android:textColorHint="#aaaaaa"
            android:ellipsize="end"
            android:id="@+id/edit_text"
            android:background="@null"
            android:paddingLeft="12dp"
            android:layout_width="247dp"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:maxLines="1"
            android:maxLength="1000"
            android:inputType="textAutoCorrect"
            app:typeface="regular"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#d3442c"
            android:id="@+id/text_send"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:autoSizeMaxTextSize="16sp"/>
    </RelativeLayout>
    <p151v.VScroll_Horizontal
        android:id="@+id/scroll_view"
        android:paddingLeft="8dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/edit_rl"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/chat_tags"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
    </p151v.VScroll_Horizontal>
    <p151v.VButton_FakeShadow
        android:textColor="@color/white"
        android:id="@+id/ui1_cancel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="53dp"
        android:text="继续滑动匹配"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/title_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="42dp"
        android:layout_above="@+id/profile_me"
        android:layout_alignParentTop="true"
        flatten="true">
        <p151v.VText
            android:textSize="42dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            app:autoSizeMinTextSize="32sp"/>
    </FrameLayout>
    <com.sunshine.engine.particle.SceneView
        android:id="@+id/snowflakes_scene"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="1dp"
        android:elevation="1dp"/>
</RelativeLayout>
