<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="accountnew.VerifyCodeInputActViewModel"
    style="@style/account_account_root">
    <p151v.VScroll style="@style/account_account_scroll">
        <LinearLayout
            android:gravity="center_horizontal"
            android:paddingBottom="8dp"
            style="@style/account_account_frame">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#61000000"
                android:gravity="center"
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"/>
            <p151v.VText
                android:textSize="26sp"
                android:textColor="#b2000000"
                android:gravity="center"
                android:id="@+id/number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <com.p051p1.mobile.putong.account.p055ui.accountnew.VerifyCodeView
                android:id="@+id/verfiy_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"/>
            <FrameLayout
                android:id="@+id/bottom_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                flatten="true">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:textColorLink="#13cd66"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/resend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typeface="medium"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/feedback_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <View
                        android:background="#e9e9e9"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="43dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="43dp"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/feedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="遇到问题？"/>
                </LinearLayout>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:id="@+id/privacy_container"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                flatten="true">
                <p151v.VCheckBox
                    android:id="@+id/privacy_check"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="7dp"
                    style="@style/common_checkbox"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#b2b2b2"
                    android:textColorLink="#99000000"
                    android:gravity="center_vertical"
                    android:id="@+id/privacy_content"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:id="@+id/continue_"
        android:text="@string/ACTION_CONTINUE"
        style="@style/account_account_continue_button"/>
</LinearLayout>
