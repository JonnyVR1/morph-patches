<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <View
        android:background="#4dffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="275dp"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.gms.ads.nativead.MediaView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="20dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toTopOf="@+id/ad_body"
                app:layout_constraintLeft_toLeftOf="parent">
                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:adjustViewBounds="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:ellipsize="end"
                android:id="@+id/headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/cv_icon"
                app:layout_constraintLeft_toRightOf="@+id/cv_icon"
                app:layout_constraintTop_toTopOf="@+id/cv_icon"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:ellipsize="end"
                android:id="@+id/headline_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/cv_icon"
                app:layout_constraintLeft_toRightOf="@+id/headline"
                app:layout_constraintTop_toTopOf="@+id/cv_icon"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#000000"
                android:gravity="left"
                android:id="@+id/ad_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="12dp"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toTopOf="@+id/ad_call_to_action"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_noad"
                android:background="@drawable/core_buttons_photo_noad"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginBottom="8dp"
                android:minWidth="110dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">
                <ImageView
                    android:background="0x7f0809c6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#ff5038"
                    android:gravity="center"
                    android:id="@+id/ad_call_to_noad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_VIP_NOADS_TITLE"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/ad_call_to_action"
                android:background="@drawable/core_button_btn_new_fe7e1d_30"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:minWidth="160dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ll_noad"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <p151v.VImage
                    android:id="@+id/ad_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:src="0x7f080a20"/>
                <p151v.VImage
                    android:id="@+id/ad_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:src="0x7f080a1f"/>
            </p151v.VLinear>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>
