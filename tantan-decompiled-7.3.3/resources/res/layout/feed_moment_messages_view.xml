<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feedbottom.insert.FeedMomentMesagesView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/message_content"
        android:background="@drawable/feed_bg_moment_message"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/feed_cc000000"
            android:ellipsize="end"
            android:id="@+id/message_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="13dp"
            android:maxLines="2"
            android:layout_toLeftOf="@+id/message_like_content"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/message_like_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/message_like_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:src="0x7f081d79"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/feed_33000000"
                android:id="@+id/message_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feedbottom.insert.FeedMomentMesagesView>
