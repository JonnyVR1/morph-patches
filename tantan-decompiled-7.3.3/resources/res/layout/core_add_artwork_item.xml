<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/literature_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/white"
            app:failureImageScaleType="centerInside"
            app:roundedCornerRadius="10dp"/>
        <FrameLayout
            android:background="@drawable/core_add_artwork_item_bg"
            android:layout_width="match_parent"
            android:layout_height="64.5dp"
            android:layout_alignParentBottom="true"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="6dp">
            <p151v.VImage
                android:id="@+id/type_watch"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:id="@+id/watch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="1dp"
                android:singleLine="true"/>
        </p151v.VLinear>
    </RelativeLayout>
</p151v.VFrame>
