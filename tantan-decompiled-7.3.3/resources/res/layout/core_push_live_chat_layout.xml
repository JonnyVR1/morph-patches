<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aigestudio="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VRelative
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:layout_marginTop="10dp">
        <p151v.VIcon
            android:id="@+id/first_title_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:src="0x7f08149d"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/first_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="聊天消息设置"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#fe7e1d"
            android:id="@+id/first_title_finish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <View
        android:background="#08000000"
        android:layout_width="match_parent"
        android:layout_height="3dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/choose_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="8dp"
        flatten="true">
        <p151v.VRelative
            android:id="@+id/choose_all"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:id="@+id/choose_all_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="48dp"
                android:text="所有人"
                android:layout_weight="1"
                android:layout_centerVertical="true"/>
            <p151v.VImage
                android:textStyle="bold"
                android:id="@+id/all_check"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080330"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </p151v.VRelative>
        <p151v.VRelative
            android:id="@+id/choose_only_liked"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:id="@+id/choose_only_liked_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="48dp"
                android:text="仅喜欢过的人"
                android:layout_weight="1"
                android:layout_centerVertical="true"/>
            <p151v.VImage
                android:id="@+id/only_liked_check"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080330"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </p151v.VRelative>
        <p151v.VRelative
            android:id="@+id/choose_friend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:id="@+id/choose_friend_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="48dp"
                android:text="仅好友"
                android:layout_weight="1"
                android:layout_centerVertical="true"/>
            <p151v.VImage
                android:id="@+id/friend_check"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080330"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </p151v.VRelative>
        <p151v.VRelative
            android:id="@+id/choose_close"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:id="@+id/choose_close_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="48dp"
                android:text="不接收"
                android:layout_weight="1"
                android:layout_centerVertical="true"/>
            <p151v.VImage
                android:id="@+id/close_check"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="0x7f080330"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </p151v.VRelative>
    </p151v.VLinear>
</LinearLayout>
