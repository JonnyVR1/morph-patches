<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="415dp"
    attachToRoot="true"
    folder="ui"
    holder="lovebuzz.widget.BuzzNotifySettingView">
    <p151v.VFrame
        android:id="@+id/text_buzz_pop"
        android:visibility="gone"
        style="@style/core_settings_stacked_frame">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:text="@string/INTL_TEXT_BUZZ_POPUP"
            style="@style/core_settings_header1"/>
        <p151v.VSwitch style="@style/core_settings_item_switch"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/voice_buzz_pop"
        android:visibility="gone"
        style="@style/core_settings_stacked_frame">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:text="@string/INTL_VOICE_BUZZ_POPUP"
            style="@style/core_settings_header1"/>
        <p151v.VSwitch style="@style/core_settings_item_switch"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/video_buzz_pop"
        android:visibility="gone"
        style="@style/core_settings_stacked_frame">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:text="@string/INTL_VIDEO_BUZZ_POPUP"
            style="@style/core_settings_header1"/>
        <p151v.VSwitch style="@style/core_settings_item_switch"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/memoji_buzz_pop"
        android:visibility="gone"
        style="@style/core_settings_stacked_frame">
        <p151v.VText
            android:layout_gravity="center_vertical"
            android:text="@string/INTL_BUZZ_WORLD_POPUP"
            style="@style/core_settings_header1"/>
        <p151v.VSwitch style="@style/core_settings_item_switch"/>
    </p151v.VFrame>
</merge>
