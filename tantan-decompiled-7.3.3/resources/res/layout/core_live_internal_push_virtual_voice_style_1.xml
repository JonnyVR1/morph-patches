<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalBigStyle1VirtualVoicePushView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui.home.bubble"
    holder="internalpush.LiveInternalBigStyle1VirtualVoicePushView">
    <FrameLayout
        android:id="@+id/content_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/background_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/core_bg_white_r16"
            app:roundedCornerRadius="10dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#66000000"
                android:layout_gravity="center_vertical"
                android:id="@+id/left_top_text"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="实时群聊"
                android:drawableLeft="0x7f080d57"
                android:drawablePadding="4dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="0x7f080a18"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="4dp">
                <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                    android:layout_gravity="center"
                    android:id="@+id/svga"
                    android:visibility="gone"
                    android:layout_width="93dp"
                    android:layout_height="93dp"/>
                <p151v.AutoVDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:visibility="gone"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:roundAsCircle="true"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/tag_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginBottom="16dp">
                    <p151v.AutoVDraweeView
                        android:id="@+id/bg"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <p151v.AutoVDraweeView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/icon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:scaleType="centerCrop"/>
                        <TextView
                            android:textSize="9dp"
                            android:textColor="@color/white"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:text=""/>
                    </p151v.VLinear>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="#66000000"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="-12dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"/>
            <p151v.VButton
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/button"
                android:background="@drawable/core_internal_push_bubble_button_bg"
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:layout_marginTop="13dp"/>
        </LinearLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalBigStyle1VirtualVoicePushView>
