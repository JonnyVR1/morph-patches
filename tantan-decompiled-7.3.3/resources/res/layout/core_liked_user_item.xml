<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.likedusers.LikedUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    holder="likedusers.LikedUserItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/personal_info"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/core_card_user_text_color_b2ffffff"
            android:id="@+id/online_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/MY_TANTAN_CARD_ONLINE"
            android:drawableLeft="0x7f08181a"
            android:drawablePadding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/user_info_section"
            app:layout_constraintLeft_toLeftOf="parent"
            app:typeface="regular"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/user_info_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minHeight="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:id="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="regular"/>
            <View
                android:id="@+id/user_divide"
                android:background="#80ffffff"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="9dp"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:id="@+id/user_distance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="regular"/>
        </LinearLayout>
        <p151v.VImage
            android:id="@+id/action_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="0x7f080d3e"/>
        <p151v.VImage
            android:id="@+id/superliked_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:src="0x7f080d3f"
            app:layout_constraintBottom_toTopOf="@+id/online_status"
            app:layout_constraintLeft_toLeftOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VText
        android:id="@+id/new_user"
        android:background="@drawable/core_svip_liked_user_new_user_tag_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/CORE_SVIP_ADVANCED_FILTER_NEW_USER"
        android:drawableLeft="0x7f081808"
        app:typeface="regular"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:textSize="10sp"
        android:id="@+id/superlike_label"
        android:background="@drawable/core_see_superlike_badges_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/CORE_SVIP_BROWSE_LIKED_SUPERLIKED_EVER"
        android:drawableStart="0x7f081651"
        app:typeface="regular"
        style="@style/core_user_card_top_left_label"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/letter_banner"
        android:background="@drawable/core_svip_lettered_banner_bg"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="54dp"
        android:text="@string/CORE_LIKED_USER_TAG_LETTER_SENT"
        android:drawableLeft="@drawable/ic_core_svip_icon_letter"
        android:drawablePadding="3dp"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/status"
        android:background="@drawable/core_svip_liked_user_tag"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_margin="10dp"/>
    <View
        android:id="@+id/mask"
        android:background="@drawable/core_svip_liked_user_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/core_fresco_base"/>
</com.p051p1.mobile.putong.core.p058ui.likedusers.LikedUserItemView>
