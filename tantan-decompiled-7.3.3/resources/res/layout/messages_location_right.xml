<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemLocation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/content"
    android:background="@drawable/core_msg_location_bg"
    android:layout_width="256dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp">
    <p151v.VLinear_MaxWidth
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="256dp"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/image"
                fresco:failureImage="@drawable/core_msg_location_failure_image"
                style="@style/core_messages_location_image"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/location_center_ic"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f08103d"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <p151v.VText
            android:textColor="?attr/message_location_left_title_color"
            android:layout_gravity="left"
            android:id="@+id/name"
            style="@style/core_messages_location_text"/>
        <p151v.VText
            android:textColor="?attr/message_location_left_subtitle_color"
            android:layout_gravity="left"
            android:id="@+id/details"
            style="@style/core_messages_location_details"/>
    </p151v.VLinear_MaxWidth>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemLocation>
