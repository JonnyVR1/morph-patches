<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/avatar_view"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="1dp"
        android:layout_marginStart="20dp"
        fresco:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@android:color/black"
        android:ellipsize="end"
        android:id="@+id/name_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:singleLine="true"
        android:layout_marginStart="16sp"
        android:layout_toEndOf="@+id/avatar_view"/>
    <p151v.VText
        android:textSize="9sp"
        android:textStyle="normal"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/interest_view"
        android:background="@drawable/live_shape_group_suggest_interest_tag_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:minWidth="28dp"
        android:singleLine="true"
        android:layout_alignBottom="@+id/name"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/name_view"/>
    <p151v.VLinear
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/name_view"
        android:layout_marginEnd="30dp"
        android:layout_alignStart="@+id/name_view"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#b3000000"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/detail_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_below="@+id/tags"
        android:layout_marginEnd="30dp"
        android:layout_alignStart="@+id/name_view"/>
</p151v.VRelative>
