<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    attachToRoot="true"
    folder="newui"
    holder="preview.pageritem.PhotoAlbumLivePhotoView">
    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignLeft="@+id/cover"
        android:layout_alignTop="@+id/cover"
        android:layout_alignRight="@+id/cover"
        android:layout_alignBottom="@+id/cover"/>
    <p151v.fresco.photodraweeview.PhotoDraweeView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:actualImageScaleType="centerCrop"
        style="@style/feed_fresco_base"
        useId="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/live_ll"
        android:background="@drawable/feed_live_photo_bg"
        android:layout_width="57dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_alignLeft="@+id/cover"
        android:layout_alignTop="@+id/cover">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="6dp"
            android:src="0x7f081d58"
            android:scaleType="center"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="LIVE"/>
    </p151v.VLinear>
    <p151v.VProgressBar
        android:id="@+id/progress_simple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="10000"
        android:progressDrawable="@drawable/feed_progress_video_playing"
        android:layout_alignBottom="@+id/cover"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/progress_full"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/cover">
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:id="@+id/track_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"/>
        <p151v.VProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:max="10000"
            android:progressDrawable="@drawable/feed_progress_video_playing"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:id="@+id/video_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"/>
    </p151v.VLinear>
</merge>
