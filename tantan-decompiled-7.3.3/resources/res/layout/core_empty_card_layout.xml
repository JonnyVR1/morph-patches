<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.HomeEmptyCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.HomeEmptyCardView"
    useRefId="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/empty_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/core_card_loading_bg"
        android:scaleType="centerCrop"/>
    <p151v.VDraweeView
        android:id="@+id/empty_image"
        android:layout_width="@dimen/radar_image_size"
        android:layout_height="@dimen/radar_image_size"
        android:layout_centerInParent="true"
        android:translationY="-24dp"
        app:backgroundImage="@color/common_light_04"
        app:roundingBorderPadding="3dp"
        style="@style/core_fresco_profile_white_border"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_grey_03"
        android:gravity="center_horizontal"
        android:id="@+id/empty_tip"
        android:visibility="visible"
        android:layout_width="235dp"
        android:layout_height="wrap_content"
        android:text="@string/SUGGEST_USERS_NO_CARDS_INCREASE_DISTANCE_TIPS"
        android:layout_below="@+id/empty_image"
        android:layout_centerHorizontal="true"
        app:typeface="medium"/>
    <p151v.VButton
        android:textSize="16sp"
        android:id="@+id/enlarge_search_distance"
        android:layout_width="247dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/SUGGEST_USERS_NO_CARDS_INCREASE_DISTANCE"
        android:layout_below="@+id/empty_tip"
        android:layout_centerHorizontal="true"
        style="@style/common_button_large_01"/>
    <p151v.VButton
        android:textSize="16sp"
        android:id="@+id/go_edit"
        android:layout_width="247dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/SUGGEST_USERS_NO_CARDS_EDIT_FILTER"
        android:maxLines="2"
        android:layout_below="@+id/enlarge_search_distance"
        android:layout_centerHorizontal="true"
        style="@style/common_button_large_01"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_40percent_000000"
        android:id="@+id/open_other_user"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="看看其他人"
        android:layout_below="@+id/go_edit"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.core.newui.home.HomeEmptyCardView>
