<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="archi"
    holder="frag.teenmode.TeenModeRoomFrag">
    <com.p051p1.mobile.putong.live.base.view.LiveSquareMediaView
        android:id="@+id/media_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VRelative
        android:gravity="center"
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/live_fans_height"
        android:layout_marginTop="@dimen/live_fans_margin_top">
        <p151v.VImage
            android:id="@+id/live_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:srcCompat="0x7f0824a5"/>
    </p151v.VRelative>
</FrameLayout>
