<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemGreetSubTitleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/greeting_message_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    flatten="true"
    folder="newui"
    holder="messages.itemview.ConversationItemGreetSubTitleView">
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/greeting_odiamond_ic"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f081970"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_66000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/greeting_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="5"
        android:singleLine="true"
        app:enableEmojis="true"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/core_color_66000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/greeting_content"
        android:paddingRight="23dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        app:enableEmojis="true"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/red_dot"
        android:background="@drawable/core_conversation_op_red_dot"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="10dp"/>
</com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemGreetSubTitleView>
