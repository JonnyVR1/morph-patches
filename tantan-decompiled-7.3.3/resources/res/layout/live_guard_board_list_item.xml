<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.LiveGuardBoardListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    folder="increment"
    holder="knight.view.leaderboard.LiveGuardBoardListItem">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#bfbfbf"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/rank"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintLeft_toLeftOf="parent"
        fresco:layout_constraintRight_toLeftOf="@+id/avatar"
        fresco:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        fresco:failureImage="@drawable/live_vector_default_avatar_bg"
        fresco:layout_constraintBottom_toBottomOf="@+id/rank"
        fresco:layout_constraintLeft_toRightOf="@+id/rank"
        fresco:layout_constraintRight_toLeftOf="@+id/name"
        fresco:layout_constraintTop_toTopOf="@+id/rank"
        fresco:placeholderImage="@drawable/live_vector_default_avatar_bg"
        fresco:roundAsCircle="true"/>
    <com.p051p1.mobile.putong.live.base.view.LiveTagView
        android:id="@+id/living"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintRight_toLeftOf="parent"
        fresco:layout_constraintStart_toEndOf="@+id/avatar"
        fresco:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#4a4a4a"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="159dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintRight_toLeftOf="parent"
        fresco:layout_constraintStart_toEndOf="@+id/avatar"
        fresco:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#f36c4e"
        android:gravity="end"
        android:id="@+id/guard_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        fresco:layout_constraintBottom_toBottomOf="parent"
        fresco:layout_constraintEnd_toEndOf="parent"
        fresco:layout_constraintLeft_toLeftOf="parent"
        fresco:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.knight.view.leaderboard.LiveGuardBoardListItem>
