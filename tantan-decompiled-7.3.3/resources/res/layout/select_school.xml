<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="campus.selectschool.SelectSchoolViewModel">
    <p151v.VProgressBar
        android:id="@+id/loading_block"
        style="@style/core_loading_block"/>
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VList
            android:id="@+id/school"
            android:paddingBottom="80dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fastScrollEnabled="false"/>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/section_title"
            android:background="@drawable/section_title_bg"
            android:visibility="invisible"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="24dp">
            <p151v.VText
                android:textSize="40sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/favorite_white_ic"/>
        </FrameLayout>
        <com.p051p1.mobile.putong.core.p058ui.secretcrush.ScrollIndexView
            android:layout_gravity="right"
            android:id="@+id/scroller"
            android:background="@drawable/scroll_index_inset_bg"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="60dp"/>
    </FrameLayout>
</p151v.VFrame>
