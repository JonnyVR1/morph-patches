<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.LiveGiftItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    folder="increment"
    holder="gift.LiveGiftItemView">
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="0x7f0822c5"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/dynamic_icon"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/named_bg"
        android:visibility="gone"
        android:layout_width="62dp"
        android:layout_height="12dp"
        android:src="0x7f0822d8"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="@color/live_ffe981"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/named_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="0.5dp"
        android:maxWidth="60dp"
        android:singleLine="true"
        android:lineSpacingExtra="0dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/named_bg"
        app:layout_constraintEnd_toEndOf="@+id/named_bg"
        app:layout_constraintStart_toStartOf="@+id/named_bg"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:lines="1"
        android:lineSpacingExtra="0sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <FrameLayout
        android:id="@+id/count_time_bt"
        android:background="@drawable/live_bg_white_r10_a05"
        android:visibility="gone"
        android:layout_width="53dp"
        android:layout_height="30dp"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/receive_flame_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/shadow_line"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:id="@+id/count_time_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:id="@+id/live_gift_progress_bg"
        android:background="@drawable/live_bg_white_r4_a10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/live_gift_progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="6"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_gift_progress_bg"
        app:layout_constraintTop_toTopOf="@+id/live_gift_progress_bg"
        style="@style/live_gift_effect_progress_horizontal"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/live_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_gift_progress_bg,live_gift_progressBar"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="13dp">
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/live_white_50_opacity"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="13dp"/>
            <p151v.VText
                android:textSize="9sp"
                android:textColor="@color/live_f36c4e_90_opacity"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/failure_time"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:maxLines="1"
                android:singleLine="true"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:id="@+id/tag_anchor"
        android:layout_width="5dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/icon"
        app:layout_constraintEnd_toStartOf="@+id/icon"/>
    <View
        android:id="@+id/right_tag_anchor"
        android:layout_width="5dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/icon"
        app:layout_constraintStart_toEndOf="@+id/icon"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tag"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/tag_anchor"
        app:layout_constraintTop_toTopOf="@+id/tag_anchor"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/right_tag"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/right_tag_anchor"
        app:layout_constraintTop_toTopOf="@+id/right_tag_anchor"/>
    <View
        android:id="@+id/remain_anchor"
        android:layout_width="5dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/remain"
        android:background="@drawable/live_bg_ff8817_r6"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/remain_anchor"
        app:layout_constraintEnd_toEndOf="@+id/remain_anchor"/>
    <p151v.VText
        android:textSize="8sp"
        android:textColor="@color/live_8b2e07"
        android:gravity="center"
        android:id="@+id/tipsView"
        android:background="0x7f0822d4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginBottom="34dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.LiveGiftItemView>
