<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.call.view.VCallSummaryView">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/live_bg_19191e_tr24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="63dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="63dp"
                    android:text="@string/LIVE_CALL_FINISH"/>
                <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
                    android:layout_gravity="center"
                    android:id="@+id/bonus_gift"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginRight="16dp"/>
            </FrameLayout>
            <View
                android:background="@drawable/live_bg_f9f9f9_a02_r1"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="12dp"
                        android:textColor="@color/live_white_60_opacity"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/crv_time_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="连线时长"/>
                    <p151v.VText
                        android:textSize="18dp"
                        android:textColor="@color/live_white"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/crv_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="10:10:10"
                        android:fontFamily="PingFangSC-Semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="12dp"
                        android:textColor="@color/live_white_60_opacity"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/crv_add_fans_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="新增粉丝"/>
                    <p151v.VText
                        android:textSize="18dp"
                        android:textColor="@color/live_white"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/crv_add_fans_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="112"
                        android:fontFamily="PingFangSC-Semibold"/>
                </LinearLayout>
            </LinearLayout>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_confirm"
                android:background="@drawable/live_shape_voice_call_summary_dialog_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/LIVE_CONFIRM"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/gift_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
