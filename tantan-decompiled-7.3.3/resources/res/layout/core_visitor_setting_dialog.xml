<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui">
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/right_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="22dp"
            android:src="0x7f0819c2"/>
    </p151v.VFrame>
    <p151v.VImage
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="6dp"
        android:src="0x7f0819de"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_e6000000"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="12dp"
        android:text="动态访客设置"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/gray_999999"
        android:id="@+id/sub_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:text="关闭后，无法查看谁看了你的动态；同时，你查看他人动态时不会留下记录。"/>
    <p151v.VRelative
        android:id="@+id/open_permission_rl"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="34dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_e6000000"
            android:id="@+id/switch_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开启动态访客"
            android:layout_centerVertical="true"/>
        <p151v.VSwitchButton
            android:id="@+id/switch_btn"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </p151v.VRelative>
</LinearLayout>
