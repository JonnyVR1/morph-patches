<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ShareMessageToFriendListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    folder="newui"
    holder="messages.ShareMessageToFriendListItemView"
    innerClass="true">
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/core_default_head_bg"
        app:placeholderImage="@drawable/core_default_head_bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        android:layout_weight="1"
        app:typeface="medium"/>
    <p151v.VCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/checkbox"
        android:checked="true"
        style="@style/common_checkbox"/>
</com.p051p1.mobile.putong.core.newui.messages.ShareMessageToFriendListItemView>
