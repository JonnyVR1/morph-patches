<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomBaseInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:measureLayoutOrientation="horizontal"
    app:measureReverse="true"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomBaseInfoView">
    <p151v.VText
        android:textSize="32sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:shadowColor="@color/common_grey_04"
        android:fontFamily="PingFangSc-Medium"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/emoji_icon_intl"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"/>
    <p151v.VText
        android:textSize="32sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:shadowColor="@color/common_grey_04"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:lineSpacingExtra="-8dp"
        android:lineHeight="24dp"/>
    <p151v.VFrame
        android:layout_gravity="center_vertical"
        android:id="@+id/pic_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="6dp"
        flatten="true">
        <p151v.VIcon
            android:layout_gravity="center"
            android:id="@+id/pic_icon_outer"
            android:src="0x7f0805eb"
            style="@style/common_icon_small"/>
        <p151v.VIcon
            android:layout_gravity="center"
            android:id="@+id/pic_icon_inner"
            android:src="0x7f0805ea"
            style="@style/common_icon_xxxSmall"/>
    </p151v.VFrame>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/age_sex_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_smalltag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"/>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomBaseInfoView>
