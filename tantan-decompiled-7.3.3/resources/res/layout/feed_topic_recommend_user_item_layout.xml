<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.view.TopicRecommendUserItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/feed_topic_recommend_user_item_bg"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:layout_marginRight="10dp"
    folder="newui"
    holder="photoalbum.view.TopicRecommendUserItemView">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/moment_image_ll"
        android:background="@drawable/feed_topic_recommend_user_item_image_bg"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        flatten="false">
        <p151v.VDraweeView
            android:id="@+id/moment_image_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            app:placeholderImageScaleType="centerInside"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundTopLeft="true"
            app:roundTopRight="true"
            app:roundedCornerRadius="12dp"/>
        <p151v.VDraweeView
            android:id="@+id/moment_image_two"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            app:placeholderImageScaleType="centerInside"/>
        <p151v.VDraweeView
            android:id="@+id/moment_image_three"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/common_light_04"
            app:placeholderImage="@color/common_light_04"
            app:placeholderImageScaleType="centerInside"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:id="@+id/pic_ll"
        android:background="@drawable/feed_single_topic_image_bg"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="-15dp"
        android:layout_below="@+id/moment_image_ll"
        android:layout_centerHorizontal="true"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/pic"
            android:layout_width="27dp"
            android:layout_height="27dp"
            style="@style/feed_fresco_profile_small_recommend"/>
    </p151v.VFrame>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/user_info_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/pic_ll"
        android:layout_centerHorizontal="true"
        flatten="false">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feed_e6000000"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="110dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feed_e6000000"
            android:id="@+id/user_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/common_grey_03"
        android:id="@+id/user_follow_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/user_info_ll"
        android:layout_centerHorizontal="true"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/feed_nearby_topic_color"
        android:ellipsize="end"
        android:id="@+id/recommendation_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:singleLine="true"
        android:layout_below="@+id/user_follow_count"
        android:layout_centerHorizontal="true"/>
    <p151v.VButton
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/attention"
        android:paddingLeft="16dp"
        android:paddingTop="6.5dp"
        android:paddingRight="16dp"
        android:paddingBottom="6.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/FOLLOW_STATE_WITHOUT_PLUS"
        android:layout_below="@+id/recommendation_tv"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.view.TopicRecommendUserItemView>
