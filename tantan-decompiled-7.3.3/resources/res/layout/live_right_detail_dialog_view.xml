<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.rights.list.view.RightDetailDialogContentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="page"
    holder="rights.list.view.RightDetailDialogContentView">
    <View
        android:id="@+id/empty"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.webview.LiveMkWebView
            android:id="@+id/liveWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f0803d5"/>
    </androidx.cardview.widget.CardView>
</com.p051p1.mobile.putong.live.external.page.rights.list.view.RightDetailDialogContentView>
