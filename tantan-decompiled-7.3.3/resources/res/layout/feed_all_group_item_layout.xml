<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.group.allgroup.FeedAllGroupItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginBottom="12dp"
    folder="newui"
    holder="group.allgroup.FeedAllGroupItemView">
    <p151v.VDraweeView
        android:id="@+id/group_head_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="16dp"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="12dp"
        style="@style/feed_fresco_base"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_toRightOf="@+id/group_head_image"
        android:layout_centerVertical="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/feed_e6000000"
                android:ellipsize="end"
                android:id="@+id/group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="134dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/anonymous_txt"
                android:background="@drawable/feed_post_bg_anonymous_topic"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:text="匿名"/>
        </p151v.VLinear>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/feed_comment_author_text_color"
            android:ellipsize="end"
            android:id="@+id/group_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="154dp"
            android:singleLine="true"/>
    </p151v.VLinear>
    <p151v.VImage
        android:id="@+id/arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="0x7f081dcf"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <p151v.VFrame
        android:id="@+id/pic_fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VFrame
            android:id="@+id/pic_three_fl"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="22dp"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/pic_three"
                android:layout_width="20dp"
                android:layout_height="20dp"
                style="@style/feed_fresco_profile_small_recommend"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/pic_two_fl"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/pic_two"
                android:layout_width="20dp"
                android:layout_height="20dp"
                style="@style/feed_fresco_profile_small_recommend"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/pic_one_fl"
            android:layout_width="24dp"
            android:layout_height="24dp"
            flatten="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/pic_one"
                android:layout_width="20dp"
                android:layout_height="20dp"
                style="@style/feed_fresco_profile_small_recommend"/>
        </p151v.VFrame>
    </p151v.VFrame>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/feed_comment_author_text_color"
        android:id="@+id/new_data_count_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/arrow"
        android:layout_centerVertical="true"
        flatten="true"/>
</com.p051p1.mobile.putong.feed.newui.group.allgroup.FeedAllGroupItemView>
