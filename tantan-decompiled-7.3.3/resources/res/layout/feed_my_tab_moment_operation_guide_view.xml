<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.guide.FeedMomentViewersOperationGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.guide.FeedMomentViewersOperationGuideView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/post_guide_rl"
        android:background="@drawable/feed_moment_viewer_operation_bg"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/head"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VDraweeView
                android:id="@+id/header1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VDraweeView
                android:id="@+id/header2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <p151v.VDraweeView
                android:id="@+id/header3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <p151v.VDraweeView
                android:id="@+id/header4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/head"
            app:layout_constraintRight_toLeftOf="@+id/post"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:id="@+id/viewer_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#66000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="发布动态，收获更多喜欢"
                app:layout_constraintLeft_toRightOf="@+id/head"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/post"
            android:background="@drawable/feed_tab_post_icon_bg"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去发布"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.guide.FeedMomentViewersOperationGuideView>
