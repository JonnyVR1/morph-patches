<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.aialbum.view.AiAlbumTemplatesView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="aialbum.view.AiAlbumTemplatesView">
    <p151v.VText
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_85A50"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="56dp"
        android:layout_marginRight="20dp"
        android:text="@string/INTL_AI_HOMEPAGE_TITLE"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_color_25544A"
        android:id="@+id/subtitle_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="4dp"
        android:text="@string/INTL_AI_HOMEPAGE_SUBTITLE"/>
    <p151v.VRecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"/>
    <p151v.VText
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/core_chat_opti_actionbar_bg"
        android:gravity="center"
        android:id="@+id/upload_tv"
        android:background="@drawable/core_ai_album_upload_selector"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/INTL_AI_HOMEPAGE_BTN"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_662CB599"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/refresh_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/INTL_AI_CHANGE_BTN"
        android:drawablePadding="3dp"
        android:drawableStart="0x7f080419"/>
</com.p051p1.mobile.putong.core.p058ui.aialbum.view.AiAlbumTemplatesView>
