<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.view.LikersFilterItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="-4dp"
    holder="view.LikersFilterItemView">
    <com.p051p1.mobile.putong.core.p058ui.home.member.likeme.LikeMeFilterView
        android:id="@+id/like_me_filter"
        android:background="@color/white"
        android:paddingRight="2dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginRight="33dp"
        android:overScrollMode="never"/>
    <p151v.VLinear
        android:layout_gravity="right"
        android:id="@+id/shadow"
        android:layout_width="70dp"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/core_likers_filter_shadow"
            android:layout_width="33dp"
            android:layout_height="44dp"/>
        <View
            android:background="#ffffff"
            android:layout_width="37dp"
            android:layout_height="44dp"/>
    </p151v.VLinear>
    <p151v.VIcon
        android:layout_gravity="right"
        android:id="@+id/filter"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="4dp"
        android:src="0x7f080d34"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/filter_tip"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="58dp"
        android:layout_marginBottom="5dp">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="有99人正在等待你的回应！"
            android:maxLines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="开通SVIP会员，立即解锁喜欢你的人"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.view.LikersFilterItemView>
