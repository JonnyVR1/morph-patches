<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.expandprofilelike.view.ProfileLikeContentRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:paddingLeft="20dp"
    android:paddingTop="4dp"
    android:paddingRight="20dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="profile.expandprofilelike.holder.ExpandProfileLikeAboutMeHolder">
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/ll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VImage
                android:id="@+id/like_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f080588"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="15sp"
                android:textColor="@color/common_000000_80"
                android:id="@+id/like_title"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="关于我"/>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="24dp"
            android:textColor="@color/common_000000_80"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:maxLines="6"
            android:lineHeight="34dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.profile.expandprofilelike.view.ProfileLikeContentRootLayout>
