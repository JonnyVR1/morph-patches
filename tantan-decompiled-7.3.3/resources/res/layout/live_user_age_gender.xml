<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.business.fansgroup.UserAgeGenderView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/gender_age"
    android:layout_width="30dp"
    android:layout_height="14dp"
    android:paddingStart="3dp"
    android:paddingEnd="5dp"
    android:layout_marginEnd="6dp"
    flatten="true"
    holder="business.fansgroup.UserAgeGenderView">
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/gender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/age"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</com.p051p1.mobile.putong.live.base.business.fansgroup.UserAgeGenderView>
