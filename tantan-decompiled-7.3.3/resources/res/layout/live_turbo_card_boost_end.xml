<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.turbocard.TurboCardBoostEndView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="increment.gift.turbocard"
    holder="TurboCardBoostEndView">
    <View
        android:id="@+id/bg"
        android:background="@drawable/live_shape_turbo_card_senior_bg"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VImage
        android:id="@+id/image_bg"
        android:background="0x7f0826b6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="@color/white"
        android:id="@+id/live_boost_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="高级曝光已结束"
        app:layout_constraintBottom_toTopOf="@+id/live_boost_end_tip"
        app:layout_constraintLeft_toLeftOf="@+id/image_bg"
        app:layout_constraintRight_toRightOf="@+id/image_bg"
        app:layout_constraintTop_toTopOf="@+id/image_bg"
        app:layout_constraintVertical_chainStyle="packed"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/live_boost_end_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="15分钟内，共0名观众进入房间！"
        app:layout_constraintBottom_toBottomOf="@+id/image_bg"
        app:layout_constraintLeft_toLeftOf="@+id/image_bg"
        app:layout_constraintRight_toRightOf="@+id/image_bg"
        app:layout_constraintTop_toBottomOf="@+id/live_boost_end"/>
    <p151v.VImage
        android:id="@+id/top_img"
        android:background="0x7f082547"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintLeft_toLeftOf="@+id/bg"
        app:layout_constraintRight_toRightOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"
        app:layout_constraintVertical_bias="1"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.turbocard.TurboCardBoostEndView>
