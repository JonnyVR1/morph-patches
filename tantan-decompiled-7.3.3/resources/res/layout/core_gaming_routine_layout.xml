<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    holder="profile.GameCpViewModel">
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="24sp"
        android:textColor="#cc000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="我的游戏日常"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/second_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="平时打游戏吗？秀一下你的战绩截图"
        android:layout_below="@+id/first_title"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="0sp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/game_name_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/looking_partner_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/rank_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"/>
    <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileItemTextView
        android:id="@+id/micro_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/game_screenshots_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"
        flatten="false">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/game_screenshots_title"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="false">
            <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                android:textColor="#cc000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="游戏截图"
                android:layout_weight="1"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/game_screenshots_icon_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08145e"
                android:layout_weight="0"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/screenshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            flatten="false">
            <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileGameImageView
                android:id="@+id/screenshot_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileGameImageView
                android:id="@+id/screenshot_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
            <com.p051p1.mobile.putong.core.p058ui.profile.views.EditProfileGameImageView
                android:id="@+id/screenshot_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:layout_gravity="bottom"
            android:id="@+id/action_view"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_alignParentBottom="true"
            layout="@layout/core_profile_loop_edit_action_layout"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/finish_btn"
            android:background="@drawable/common_button_btn_orange_small"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="16dp"
            android:text="完成"
            android:layout_marginHorizontal="20dp"/>
    </FrameLayout>
</p151v.VLinear>
