<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    flatten="true"
    folder="newui"
    holder="mediapicker.post.FeedPostAtDialogItem">
    <p151v.VDraweeView
        android:id="@+id/head"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="12dp"
        android:layout_centerVertical="true"
        app:roundAsCircle="true"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_toRightOf="@+id/head"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="探探智多星"
            android:maxLines="1"
            android:lineSpacingExtra="0sp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:lineSpacingExtra="0sp"/>
    </p151v.VLinear>
    <View
        android:id="@+id/cover"
        android:background="@color/feed_99ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"/>
</p151v.VRelative>
