<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#00ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bg_view"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="156dp"
        android:minHeight="156dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_black_90_opacity"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/LIVE_CONFESS_GIFT_MATCHED_CONFIRM_TEXT"
        android:maxLines="3"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintStart_toStartOf="@+id/bg_view"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_gray_83"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/send_confirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_CONFESS_GIFT_CONFIRM_SEND"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/target_enter_line"
        app:layout_constraintEnd_toStartOf="@+id/target_enter_line"
        app:layout_constraintStart_toStartOf="@+id/bg_view"/>
    <View
        android:id="@+id/target_enter_line"
        android:background="@color/live_gray_f9"
        android:layout_width="3dp"
        android:layout_height="22dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintStart_toStartOf="@+id/bg_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_fe7e1d"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/send_other"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_GIFT_SEND_OTHER"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/target_enter_line"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintStart_toEndOf="@+id/target_enter_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
