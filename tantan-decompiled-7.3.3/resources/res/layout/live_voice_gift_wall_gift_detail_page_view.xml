<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:src="0x7f0822e3"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintLeft_toLeftOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#ccffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintLeft_toLeftOf="@+id/top_bar"
        app:layout_constraintRight_toRightOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <p151v.VDraweeView
        android:id="@+id/gift_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <p151v.VLinear
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tip_text"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_icon">
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/card1"
            android:background="@drawable/live_bg_voice_new_gift_wall_card"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="28dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <p151v.VDraweeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/left_card_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:roundAsCircle="true"/>
            <p151v.VFrame
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp">
                <p151v.VLinear
                    android:orientation="vertical"
                    android:id="@+id/left_card1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="11sp"
                        android:textColor="#66ffffff"
                        android:ellipsize="end"
                        android:id="@+id/left_card1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/LIVE_GIFT_YOU_SEND_COUNT"
                        android:singleLine="true"/>
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#ccffffff"
                        android:id="@+id/left_card1_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="999"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:id="@+id/left_card2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="11sp"
                        android:textColor="#66ffffff"
                        android:ellipsize="end"
                        android:id="@+id/left_card2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/LIVE_GIFT_ACCUMULATED_RECEIVED_COUNT"
                        android:singleLine="true"/>
                    <p151v.VText
                        android:textSize="15sp"
                        android:textColor="#ccffffff"
                        android:id="@+id/left_card2_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="999"/>
                </p151v.VLinear>
            </p151v.VFrame>
        </p151v.VLinear>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:background="@drawable/live_bg_voice_new_gift_wall_card"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="28dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="22dp">
            <p151v.VFrame
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:placeholderImage="0x7f08231a"
                    app:roundAsCircle="true"/>
                <p151v.VText
                    android:textSize="7sp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/live_bg_fe7e1d_r4"
                    android:paddingLeft="4dp"
                    android:paddingTop="1dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_CONTRIBUTE_STAR"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp">
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="#66ffffff"
                    android:ellipsize="end"
                    android:id="@+id/card_title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="送出最多"
                    android:singleLine="true"/>
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="#ccffffff"
                    android:ellipsize="end"
                    android:id="@+id/card_content2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66ffffff"
        android:id="@+id/tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_LIGHTED_BECOME_CONTRIBUTE_STAR"
        app:layout_constraintBottom_toTopOf="@+id/one_click"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/one_click"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/LIVE_BUTTON_BECOME_CONTRIBUTE_STAR"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tip_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
