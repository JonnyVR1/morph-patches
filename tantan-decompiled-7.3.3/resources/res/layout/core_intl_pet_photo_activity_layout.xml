<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/core_intl_pet_photo_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rTopLeftRadius="20dp"
    app:rTopRightRadius="20dp">
    <p151v.VDraweeView
        android:id="@+id/img_bg_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundView
        android:id="@+id/top"
        android:background="@color/white"
        android:layout_width="45dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"
        app:rRadius="18dp"/>
    <p151v.VFrame
        android:id="@+id/image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-23dp"
        android:layout_marginEnd="-55dp"
        android:layout_alignParentEnd="true">
        <p151v.VDraweeView
            android:id="@+id/img_bg"
            android:layout_width="330dp"
            android:layout_height="382dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/transparent"
            app:failureImageScaleType="centerInside"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"
            style="@style/core_fresco_base"/>
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/img"
            android:layout_width="148dp"
            android:layout_height="222dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/transparent"
            app:failureImageScaleType="centerInside"
            app:placeholderImage="@color/transparent"
            app:placeholderImageScaleType="centerInside"
            style="@style/core_fresco_base"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="end|bottom"
            android:id="@+id/rule"
            android:background="@drawable/core_intl_pet_photo_rule_bt_bg"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:text="活動規則"
            android:lineSpacingMultiplier="0.8"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="55dp"/>
        <p151v.VImage
            android:id="@+id/star_img"
            android:background="0x7f080b77"
            android:layout_width="41dp"
            android:layout_height="49dp"
            android:layout_marginTop="240dp"
            android:layout_marginStart="68dp"/>
    </p151v.VFrame>
    <p151v.VDraweeView
        android:id="@+id/peg_tag"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="26dp"
        android:layout_alignParentEnd="true"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="150dp"
        android:layout_height="382dp"
        android:layout_marginTop="-23dp"
        android:layout_marginStart="19dp">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#574390"
            android:id="@+id/title"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="寵物合拍"/>
        <p151v.VImage
            android:id="@+id/desc_img"
            android:background="0x7f080b73"
            android:layout_width="116dp"
            android:layout_height="83dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/title"/>
    </p151v.VLinear>
    <TextView
        android:textSize="16sp"
        android:textColor="#574390"
        android:gravity="start"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-28dp"
        android:layout_below="@+id/image_container"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#675499"
        android:id="@+id/reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:text="獎勵三件套"
        android:drawablePadding="18.7dp"
        android:layout_below="@+id/desc"
        android:layout_centerHorizontal="true"
        android:drawableStart="0x7f080b74"
        android:drawableEnd="0x7f080b74"/>
    <p151v.VLinear
        android:gravity="center"
        android:id="@+id/reward_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/reward"
        android:layout_centerHorizontal="true">
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/reward_img1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/transparent"
                app:failureImageScaleType="centerInside"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/transparent"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ef4783"
                android:id="@+id/reward_desc_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="明星互動"
                android:lines="2"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <p151v.VDraweeView
                android:id="@+id/reward_img2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/transparent"
                app:failureImageScaleType="centerInside"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/transparent"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ef4783"
                android:gravity="center_horizontal"
                android:id="@+id/reward_desc_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="線下寵物聚會"
                android:lines="2"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VDraweeView
                android:id="@+id/reward_img3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/transparent"
                app:failureImageScaleType="centerInside"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/transparent"
                app:placeholderImageScaleType="centerInside"
                style="@style/core_fresco_base"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ef4783"
                android:id="@+id/reward_desc_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="萌寵禮包"
                android:lines="2"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/bt"
        android:background="@drawable/core_intl_pet_photo_bt_bg"
        android:layout_width="276dp"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="30dp"
        android:text="點擊上傳"
        android:layout_below="@+id/reward_desc"
        android:layout_centerHorizontal="true"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.roundcorners.view.RoundRelativeLayout>
