<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.settings.intlGender.IntlMoreGenderItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:checkable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardForegroundColor="@color/transparent"
    app:checkedIcon="@null"
    app:contentPadding="4dp"
    app:strokeColor="#08000000"
    app:strokeWidth="3dp"
    flatten="true"
    holder="settings.intlGender.IntlMoreGenderItemView">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_80"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/common_000000_30"
            android:ellipsize="end"
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.settings.intlGender.IntlMoreGenderItemView>
