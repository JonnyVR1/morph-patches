<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.moments.MomentViewLarge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="moments.MomentViewLarge">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            flatten="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VDraweeView
                        android:id="@+id/profile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        style="@style/feed_fresco_profile_small"/>
                    <p151v.VImage
                        android:layout_gravity="bottom|right"
                        android:id="@+id/verification_icon"
                        android:background="0x7f081e18"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                </FrameLayout>
                <include
                    android:id="@+id/header_large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    layout="@layout/moments_header_large"/>
            </LinearLayout>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/text_light"
                android:id="@+id/details"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="64dp"
                android:singleLine="true"
                android:drawableRight="0x7f08209d"
                android:drawablePadding="5dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/text_light"
                android:id="@+id/location"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:drawableLeft="0x7f0828f4"
                android:drawablePadding="5dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/comment_like_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="20dp"
                flatten="true">
                <FrameLayout
                    android:id="@+id/comment"
                    android:background="@drawable/moments_feed_button_rounded"
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    android:layout_marginRight="8dp"
                    flatten="true">
                    <p151v.VText
                        android:layout_gravity="center"
                        android:id="@+id/comment_text"
                        android:text="@string/MOMENTS_BUTTON_COMMENT_TITLE"
                        android:drawableLeft="0x7f0828f2"
                        android:drawablePadding="6dp"
                        style="@style/feed_moment_comment_button_text"/>
                </FrameLayout>
                <include layout="@layout/moments_comment_like"/>
                <FrameLayout
                    android:id="@+id/chat"
                    android:background="@drawable/moments_feed_button_rounded"
                    android:visibility="gone"
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    flatten="true">
                    <p151v.VText
                        android:layout_gravity="center"
                        android:id="@+id/chat_text"
                        android:text="@string/MOMENTS_BUTTON_CHAT_TITLE"
                        android:drawableLeft="0x7f0828f1"
                        android:drawablePadding="6dp"
                        style="@style/feed_moment_comment_button_text"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/options_container"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    flatten="true">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/options"
                        android:background="@drawable/tf_circle_bounded_light"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="0x7f081d9f"
                        android:scaleType="center"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/moments_like_row"/>
        <View
            android:id="@+id/comment_divider"
            style="@style/feed_comment_like_divider"/>
        <FrameLayout
            android:id="@+id/see_all_frame"
            android:background="@drawable/moments_comment_bg"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/text_medium"
                android:layout_gravity="center"
                android:id="@+id/see_all_text"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/MOMENTS_FEED_MORE_COMMENTS_CELL"
                app:typeface="medium"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/comment_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/moments_item_divider"/>
    </LinearLayout>
    <p151v.VFrame_Anim
        android:id="@+id/sending_frame"
        android:background="#d9ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <include
            android:layout_gravity="center"
            android:layout_width="40dp"
            android:layout_height="40dp"
            layout="@layout/feed_messages_sending_or_error"/>
    </p151v.VFrame_Anim>
</com.p051p1.mobile.putong.feed.p065ui.moments.MomentViewLarge>
