<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.verification.AgeVerificationSingleGuideView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="verification.AgeVerificationSingleGuideView">
    <p151v.VImage
        android:layout_gravity="center_horizontal"
        android:layout_width="96dp"
        android:layout_height="62dp"
        android:layout_marginTop="41dp"
        android:src="0x7f08093d"/>
    <p151v.VText
        android:textSize="20sp"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/AGE_CHECK_CHECK_CENTER_TITLE"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/MESSAGE_LIMITED_AGE_CHECK_FIRST_DIALOG_CONTENT_UPDATE"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_white_01"
        android:gravity="center"
        android:id="@+id/tv_known"
        android:background="@drawable/common_button_btn_orange_large"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="12dp"
        android:text="@string/AGE_CHECK_BUTTON_TO_CHECK"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ACTION_CANCEL"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</com.p051p1.mobile.putong.core.p058ui.verification.AgeVerificationSingleGuideView>
