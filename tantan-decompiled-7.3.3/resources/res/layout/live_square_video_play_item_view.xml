<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveSquareLiveVideoItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="view"
    holder="widgets.LiveSquareLiveVideoItemView">
    <p151v.VDraweeView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@color/live_black_30_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:id="@+id/fl_video_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:background="@drawable/live_shape_bg_000000_4d000000"
        android:layout_width="match_parent"
        android:layout_height="79dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:background="@drawable/live_shape_bg_4d000000_000000"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_desc"
        app:layout_constraintEnd_toEndOf="@+id/view_space"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_space"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/tv_center"
        android:background="@drawable/live_bg_white_r10_a50"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginBottom="96dp"
        android:text="点击进入直播间"
        android:paddingStart="42dp"
        android:paddingEnd="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/anim_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_center"
        app:layout_constraintStart_toStartOf="@+id/tv_center"
        app:layout_constraintTop_toTopOf="@+id/tv_center"/>
    <View
        android:id="@+id/view_space"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveSquareLiveVideoItemView>
