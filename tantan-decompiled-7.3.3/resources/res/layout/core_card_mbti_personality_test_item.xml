<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.card.expanded.view.MbtiLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/card_view"
    android:background="@drawable/core_bg_20_ffffff"
    android:paddingTop="30dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:paddingVertical="30dp"
    flatten="true"
    folder="newui"
    holder="home.card.expanded.view.MbtiLayout">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="13dp"
        android:layout_marginHorizontal="16dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/title_ic"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:id="@+id/title"
            android:paddingTop="1dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="我的MBTI"
            android:layout_weight="1"
            style="@style/core_card_expande_title"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/edit_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            app:srcCompat="0x7f082061"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/mbti_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:roundedCornerRadius="10dp"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginLeft="8dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="20sp"
                android:textColor="@color/common_black_80"
                android:gravity="center"
                android:id="@+id/mbti_title"
                android:layout_width="wrap_content"
                android:layout_height="28dp"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#4e000000"
                android:gravity="center"
                android:id="@+id/mbti_des"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="3dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VFrame
        android:id="@+id/tag_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/test_my_layout"
        android:background="0x7f0807c9"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        flatten="true">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="15dp"
                android:textColor="@color/common_black_02"
                android:id="@+id/match_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="测试我的MBTI"
                android:maxLines="1"
                android:lineHeight="21dp"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/common_grey_03"
                android:id="@+id/match_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="测试完即可查看我们的匹配程度测试完即可查看我们的匹配程度"
                android:maxLines="2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="14dp"
            android:textColor="#ff700b"
            android:gravity="center_vertical"
            android:id="@+id/test_my_mbti"
            android:background="@drawable/core_card_mbti_test_btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="立即测试"
            android:lineHeight="20dp"/>
    </p151v.VLinear>
    <p151v.VFrame_Shadow
        android:layout_gravity="bottom"
        android:id="@+id/profile_like_shadow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="4dp"
        app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
        app:sl_dy="2dp"
        app:sl_shadowColor="@color/core_profile_bottom_profile_like"
        app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/profile_like"
            android:background="@drawable/core_newui_profile_like_expand_btn_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"/>
    </p151v.VFrame_Shadow>
</com.p051p1.mobile.putong.core.newui.home.card.expanded.view.MbtiLayout>
