<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.intlmeet.tribe.IntlTribeGroupRight xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="113dp"
    android:layout_height="113dp"
    folder="newui"
    holder="intlmeet.tribe.IntlTribeGroupRight">
    <p151v.VDraweeView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:roundedCornerRadius="20dp"/>
    <p151v.VImage
        android:layout_gravity="end|top"
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/like_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp">
        <p151v.VText_NoTopPadding
            android:textSize="11sp"
            android:textColor="@color/black"
            android:id="@+id/like_count"
            android:background="@drawable/core_intl_tribe_like_bg"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:drawableStart="@drawable/core_intl_tribe_like_icon"
            android:paddingStart="5dp"
            android:paddingEnd="6dp"
            android:paddingVertical="1dp"
            app:fontWeight="500"/>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_intl_tribe_like_tag_icon"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:layout_gravity="center"
        android:layout_width="113dp"
        android:layout_height="match_parent">
        <p151v.AutoVDraweeView
            android:id="@+id/user_1"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="35dp"
            android:scaleType="centerCrop"
            android:alpha="0.7"
            android:rotation="-13"
            android:layout_marginStart="17dp"
            app:roundedCornerRadius="6dp"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="end"
            android:id="@+id/user_3"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="36dp"
            android:scaleType="centerCrop"
            android:alpha="0.7"
            android:rotation="-17"
            android:layout_marginEnd="17dp"
            app:roundedCornerRadius="6dp"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_2"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginTop="31dp"
            android:scaleType="centerCrop"
            android:rotation="10"
            app:roundedCornerRadius="8dp"/>
    </p151v.VFrame>
    <p151v.VText_NoTopPadding
        android:textSize="15sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="15dp"
        android:maxLines="1"
        android:layout_marginHorizontal="10dp"/>
</com.p051p1.mobile.putong.core.newui.intlmeet.tribe.IntlTribeGroupRight>
