<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/icon_1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="0x7f0810b4"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="15dp"
                android:textColor="@color/common_000000_80"
                android:id="@+id/title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="获得认证标识"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/subtitle_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="个人资料上会显示头像本人认证标识"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <p151v.VImage
            android:id="@+id/icon_2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="0x7f0810b5"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="15dp"
                android:textColor="@color/common_000000_80"
                android:id="@+id/title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="只看认证用户特权"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/subtitle_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="划卡时可以筛选完成头像本人认证的用户"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <p151v.VImage
            android:id="@+id/icon_3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/core_new_avatar_success_detail_ic4"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                android:textSize="15dp"
                android:textColor="@color/common_000000_80"
                android:id="@+id/title_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统优先推荐"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/common_000000_40"
                android:id="@+id/subtitle_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="系统会优先把你推荐给其他用户"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/common_exp_button_btn_orange_small"
        android:paddingLeft="47dp"
        android:paddingRight="47dp"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:text="立即认证，获得特权"
        android:paddingHorizontal="47dp"/>
</p151v.VLinear>
