<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkCardShowItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/live_bg_white_r10_a05"
    android:layout_width="96dp"
    android:layout_height="155dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    folder="recreation"
    holder="pk.view.LivePkCardShowItemView">
    <p151v.VDraweeView
        android:id="@+id/iv_icon"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginTop="19dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxEms="6"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/tv_remain_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.p067pk.view.LivePkCardShowItemView>
