<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="settings.personaldetails.IntlPersonalDetailsViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VProgressBar
            android:id="@+id/loading_block"
            android:visibility="visible"
            style="@style/core_loading_block"/>
        <p151v.VScroll
            android:id="@+id/scroll"
            android:visibility="invisible"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_000000_40"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/SETTINGS_ACCOUNT_DETAILS"
                    android:paddingHorizontal="20dp"/>
                <p151v.VLinear
                    android:id="@+id/full_name"
                    style="@style/core_intl_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/EDIT_SETTINGS_CELL_FULL_NAME"
                        style="@style/core_intl_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/intl_settings_secondary_disable"/>
                    <p151v.VIcon
                        android:background="0x7f080c4b"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/birthdate"
                    style="@style/core_intl_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/SETTINGS_BIRTHDAY"
                        style="@style/core_intl_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/intl_settings_secondary_disable"/>
                    <p151v.VIcon
                        android:background="0x7f080c4b"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/my_gender"
                    style="@style/core_intl_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/SETTINGS_YOUR_GENDER"
                        style="@style/core_intl_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/intl_settings_secondary_disable"/>
                    <p151v.VIcon
                        android:background="0x7f080c4b"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/blood_type"
                    android:visibility="gone"
                    style="@style/core_intl_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/BLOOD_TYPE"
                        style="@style/core_intl_settings_primary"/>
                    <p151v.VText
                        android:id="@+id/text"
                        style="@style/intl_settings_secondary_disable"/>
                    <p151v.VIcon
                        android:background="0x7f080c4b"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>
                </p151v.VLinear>
                <p151v.VLinear
                    android:id="@+id/profile_type"
                    android:visibility="gone"
                    style="@style/core_intl_settings_stacked_frame">
                    <p151v.VText
                        android:text="@string/INTL_TTC_CLONE_SIGNUP_GENDER_ADD_DETAILS_SHOW_GENDER_OPTION"
                        style="@style/core_intl_settings_primary"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <p151v.VSwitch
                        android:id="@+id/profile_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"/>
                </p151v.VLinear>
                <View
                    android:background="@color/common_000000_03"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/common_000000_40"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/INTL_MY_EMOJI"
                    android:paddingHorizontal="20dp"/>
                <p151v.VLinear
                    android:id="@+id/add_emoji"
                    android:visibility="gone"
                    style="@style/core_intl_settings_stacked_frame">
                    <p151v.VText
                        android:id="@+id/text"
                        android:text="@string/INTL_ADD_EMOJI"
                        android:layout_weight="1"
                        style="@style/core_intl_settings_primary"/>
                    <p151v.VDraweeView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/emoji"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:actualImageResource="0x7f0809be"/>
                </p151v.VLinear>
            </LinearLayout>
        </p151v.VScroll>
    </p151v.VFrame>
</p151v.VLinear>
