<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear_Dividers xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intl_purpose_fame"
    android:background="@color/core_profile_background"
    android:paddingTop="9dp"
    flatten="true"
    holder="profile.profilelist.itemholders.EditIntlFriendPurposeItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VText
        android:id="@+id/intl_purpse_title"
        android:paddingTop="12dp"
        android:text="@string/INTL_RELATIONSHIP_GOAL_TITLE"
        style="@style/profile_item_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/intl_purpse_layout"
        android:background="@drawable/tf_rect_light"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"
            android:layout_marginEnd="32dp"
            app:srcCompat="@drawable/core_intl_friend_purpose_icon"/>
        <p151v.VLinear
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light"
                android:gravity="center"
                android:id="@+id/intl_purpse"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:hint="@string/INTL_TTC_PROFILE_ADD_PURPOSE"
                android:layout_weight="1"/>
            <p151v.VImage
                android:id="@+id/intl_purpse_red_dot"
                android:background="@drawable/core_intl_profile_me_edit_red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="3dp"/>
        </p151v.VLinear>
    </LinearLayout>
</p151v.VLinear_Dividers>
