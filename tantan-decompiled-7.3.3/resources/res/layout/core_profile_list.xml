<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base_root"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="profile.profilelist.ProfileListFrag">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.navigationbar.VNavigationBar
            android:id="@+id/edit_profile_navigation_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftIcon="0x7f080387"
            app:title="@string/NEW_PROFILE_PICTURE_EDIT"/>
        <p151v.VFrame
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="bottom"
                android:id="@+id/space_view"
                android:background="#fff"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="500dp"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:tabBackground="@color/transparent"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@color/transparent"/>
            <p151v.VFrame
                android:id="@+id/preview_root"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <p151v.VProgressBar
                    android:id="@+id/preview_loading_block"
                    android:visibility="visible"
                    style="@style/core_loading_block"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/root"
                android:background="@color/white"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                flatten="true">
                <p151v.VProgressBar
                    android:id="@+id/loading_block"
                    style="@style/core_loading_block"/>
                <include
                    android:id="@+id/image_content"
                    layout="@layout/core_image_item_layout"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:id="@+id/list_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    flatten="true">
                    <include
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/core_profile_top_warn_layout"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/profile_list"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:descendantFocusability="blocksDescendants"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never"/>
                </p151v.VLinear>
                <com.p051p1.mobile.putong.core.p058ui.FloatShadowButton
                    android:layout_gravity="right"
                    android:id="@+id/profile_float_back"
                    android:visibility="gone"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginRight="17dp"
                    app:animationEnable="false"
                    app:icon="0x7f080aa9"
                    app:iconHeight="11dp"
                    app:iconWidth="18dp"
                    app:shadowColor="#f1f1f1"
                    app:shadowColorLight="#039f8d8d"
                    app:shadowEnable="true"
                    app:shadowWidth="2dp"/>
                <View
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/buttons_bg"
                    android:background="@drawable/core_profile_button_bottom_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="164dp"/>
                <include layout="@layout/core_profile_like_or_dislike_layout"/>
                <include
                    android:id="@+id/like_and_dislike_refactor_wrap"
                    android:visibility="gone"
                    layout="@layout/core_profile_buttons"/>
                <include
                    android:visibility="gone"
                    layout="@layout/core_intl_live_card_buttons"/>
                <include
                    android:id="@+id/buttons_onebtn_match"
                    android:visibility="gone"
                    layout="@layout/core_profile_buttons_onebtn_match"/>
                <include
                    android:layout_gravity="bottom"
                    android:id="@+id/countdown_like_root"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/core_profile_countdown_like_input"/>
                <include
                    android:layout_gravity="bottom"
                    android:id="@+id/city_centre_greet"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/core_city_centre_greeting"/>
                <com.p051p1.mobile.putong.core.p058ui.vip.greet.ProfileSendContainerView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/rl_send_envelop"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="12dp"/>
                <p151v.VFrame_Shadow
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/bottom_send_message_shadow"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
                    app:sl_dy="@dimen/core_profile_bottom_dy"
                    app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                    app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
                    flatten="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/bottom_send_message"
                        android:background="@drawable/core_newui_profile_btn_chat_bg"
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <p151v.VImage
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/core_newui_profile_chat_bottom_bg"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </p151v.VFrame_Shadow>
                <include
                    android:layout_gravity="bottom"
                    android:id="@+id/superlike_combo_anim_view"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="50dp"
                    layout="@layout/core_super_like_combo_anim_view"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#e6ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/recover_match"
                    android:background="@drawable/common_button_btn_orange_large"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/CORE_SVIP_RECOVER_UNMATCH_BUTTON_REMATCH"
                    android:singleLine="true"/>
                <p151v.VFrame_Shadow
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/bottom_super_like_btn_shadow"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
                    app:sl_dy="@dimen/core_profile_bottom_dy"
                    app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                    app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
                    flatten="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:id="@+id/bottom_super_like_btn"
                        android:background="@drawable/core_newui_profile_btn_superlike_bg"
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <p151v.VImage
                            android:id="@+id/bottom_super_like_btn_img"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/core_newui_profile_superlike"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </p151v.VFrame_Shadow>
                <p151v.VLinear
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/pic_like_bottom_linear"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    flatten="true">
                    <View
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <p151v.VFrame_Shadow
                        android:id="@+id/pic_like_bottom_superlike_shadow"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
                        app:sl_dy="@dimen/core_profile_bottom_dy"
                        app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                        app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
                        flatten="true">
                        <RelativeLayout
                            android:layout_gravity="center"
                            android:background="@drawable/core_newui_profile_btn_bottom_superlike_bg"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:layout_width="match_parent"
                            android:layout_height="48dp">
                            <p151v.VImage
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/core_newui_pic_like_superlike"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>
                    </p151v.VFrame_Shadow>
                    <p151v.VFrame_Shadow
                        android:id="@+id/pic_like_bottom_like_shadow"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
                        app:sl_dy="@dimen/core_profile_bottom_dy"
                        app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
                        app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
                        flatten="true">
                        <RelativeLayout
                            android:layout_gravity="center"
                            android:background="@drawable/core_newui_profile_btn_like_bg"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:layout_width="match_parent"
                            android:layout_height="48dp">
                            <p151v.VImage
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/core_newui_profile_like"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>
                    </p151v.VFrame_Shadow>
                </p151v.VLinear>
            </p151v.VFrame>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VRelative
                    android:id="@+id/profile_custom_bar_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    flatten="true">
                    <View
                        android:id="@+id/top_bar_view_bg"
                        android:background="@color/white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"/>
                    <View
                        android:id="@+id/top_empty_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"/>
                    <com.p051p1.mobile.putong.core.p058ui.profile.views.ProfileCustomBar
                        android:id="@+id/profile_custom_bar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/top_empty_view"/>
                </p151v.VRelative>
                <View
                    android:id="@+id/view_core_blur"
                    android:background="@drawable/core_set_blur"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>
            </p151v.VLinear>
            <p151v.VFrame
                android:layout_gravity="bottom"
                android:id="@+id/profile_btm_layout_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </p151v.VFrame>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/intr_risk_pop"
        android:background="@drawable/core_intr_risk_pop_bg"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        flatten="false">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_intr_risk_icon"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#333333"
            android:ellipsize="end"
            android:id="@+id/intr_risk_pop_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="176dp"
            android:maxLines="2"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</p151v.VFrame>
