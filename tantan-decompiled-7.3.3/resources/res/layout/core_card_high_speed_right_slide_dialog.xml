<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="dlg.HighSpeedRightSlideDlg">
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/dialog_view"
        android:background="@drawable/core_bg_bottom_sheet_24_fafafa"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/iv_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            app:srcCompat="0x7f080733"/>
        <p151v.VImage
            android:id="@+id/image_icon"
            android:layout_width="140dp"
            android:layout_height="110dp"
            android:layout_marginLeft="40dp"
            android:src="0x7f0805b7"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="@color/core_color_80percent_000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="15dp"
            android:text="当前划卡速度过快"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_000000_40"
            android:id="@+id/subTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="40dp"
            android:text="过快的的决策无法认识真正的朋友"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/submit0"
            android:background="@drawable/core_certification_bottom_sheet_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:text="我知道了"
            app:typeface="medium"/>
    </p151v.VLinear>
</FrameLayout>
