<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationSuperBoostItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_body"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="96dp"
    flatten="true"
    folder="newui"
    holder="messages.ConversationSuperBoostItemView"
    innerClass="true">
    <com.p051p1.mobile.putong.core.newui.messages.ConversationBoostRoundView
        android:id="@+id/roundview"
        android:layout_width="69dp"
        android:layout_height="69dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_b"
        android:layout_width="17dp"
        android:layout_height="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/roundview"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"/>
    <android.widget.Space
        android:id="@+id/see_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="27dp"
        app:layout_constraintBottom_toBottomOf="@+id/roundview"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"/>
    <p151v.VDraweeView
        android:id="@+id/iv_user"
        android:background="@drawable/core_default_head_bg"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:fadeDuration="0"
        app:layout_constraintBottom_toBottomOf="@+id/roundview"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"
        app:layout_constraintTop_toTopOf="@+id/roundview"
        app:roundAsCircle="true"/>
    <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
        android:id="@+id/spotlight_anim"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/roundview"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"
        app:layout_constraintTop_toTopOf="@+id/roundview"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:background="0x7f0806e3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"
        app:layout_constraintTop_toTopOf="@+id/view_b"/>
    <ImageView
        android:id="@+id/iv_small_icon"
        android:background="0x7f0806cb"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintLeft_toLeftOf="@+id/iv_icon"
        app:layout_constraintRight_toRightOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
        android:id="@+id/see_anim"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"
        app:layout_constraintTop_toTopOf="@+id/see_space"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_black_04"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/roundview"
        app:layout_constraintRight_toRightOf="@+id/roundview"/>
</com.p051p1.mobile.putong.core.newui.messages.ConversationSuperBoostItemView>
