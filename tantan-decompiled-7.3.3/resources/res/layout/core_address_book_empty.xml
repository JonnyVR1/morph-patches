<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="messages.addressbook.BaseConversationHasHeadAdapter">
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/guide_image"
        android:layout_width="220dp"
        android:layout_height="150dp"
        android:src="0x7f080409"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#26000000"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/guide_text"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/CHAT_GROUP_NO_GROUP"
        android:fontFamily="sans-serif"
        app:enableEmojis="true"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/more_btn"
        android:background="@drawable/core_menu_all_pair_new_bg"
        android:visibility="gone"
        android:layout_width="137dp"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:text="发现更多群聊"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/view_exceptions"
        android:background="@drawable/core_bg_8_08000000"
        android:paddingLeft="11dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="42dp">
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/core_33000000"
            android:layout_gravity="center_vertical"
            android:paddingRight="2dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看异常用户"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f081636"/>
    </p151v.VLinear>
</p151v.VLinear>
