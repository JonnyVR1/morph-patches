<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.insert.myself.SeeMyselfRootLayout">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/myslef_avatar_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="16dp"
        style="@style/core_fresco_base"/>
    <p151v.VFrame
        android:id="@+id/style_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:id="@+id/shadow_top"
            android:background="@drawable/core_card_pic_top_shadow_cover_bg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            flatten="true"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="98dp">
            <p151v.VText
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:singleLine="true"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="13dp"
                android:textColor="@color/core_color_65percent_FFFFFF"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="6dp"
                android:minHeight="18dp"
                android:maxLines="2"
                app:typeface="medium"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="top|right"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp">
            <p151v.VImage
                android:id="@+id/goto_verify_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:tint="#99ffffff"/>
            <p151v.VText
                android:textSize="15dp"
                android:textColor="#99ffffff"
                android:id="@+id/verification_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="头像认证"/>
            <p151v.VImage
                android:id="@+id/verification_status_ic"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"/>
        </p151v.VLinear>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_info_content"
            android:background="@drawable/core_guide_bottom_bg"
            android:paddingLeft="16dp"
            android:paddingTop="50dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="16dp"
                android:textColor="#99ffffff"
                android:gravity="center_vertical"
                android:id="@+id/guide_about_me_text"
                android:background="@drawable/core_guide_add_aboutme_bg"
                android:paddingLeft="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="介绍一下你自己..."/>
            <p151v.VImage
                android:id="@+id/sign_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/sign_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="84dp"
                android:layout_marginBottom="4dp"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/guide_pic_1"
                    android:background="0x7f0807d3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:roundedCornerRadius="10dp"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/guide_pic_2"
                    android:background="0x7f0807d3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="6dp"
                    android:backgroundTint="#ffffff"
                    app:roundedCornerRadius="10dp"/>
                <Space
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <p151v.VImage
                    android:layout_gravity="end|bottom"
                    android:id="@+id/profile_enter"
                    android:paddingLeft="32dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f081464"/>
            </p151v.VLinear>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/next_btn"
                android:background="@drawable/core_bg_theme_color_r10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="立即完善"/>
            <p151v.VText
                android:textColor="#7fffffff"
                android:gravity="center"
                android:id="@+id/jump_btn"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="5dp"
                android:text="稍后再说"/>
        </LinearLayout>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/style_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:id="@+id/shadow_top_style_2"
            android:background="@drawable/core_card_pic_top_shadow_cover_bg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>
        <com.p051p1.mobile.putong.core.newui.home.card.expanded.view.ExpandedImageSwitchView
            android:id="@+id/picture_switch_view_mirror"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VDraweeView
            android:layout_gravity="right"
            android:id="@+id/operating_medal"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VLinear
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/core_guide_bottom_bg"
            android:paddingTop="50dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_userinfo_and_enter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <FrameLayout
                    android:id="@+id/bottom_userinfo_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VImage
                    android:id="@+id/profile_enter_style_2"
                    android:background="@drawable/core_profile_enter_bg"
                    android:visibility="visible"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:src="0x7f081464"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/next_btn_style_2"
                android:background="@drawable/core_bg_theme_color_r10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:text="继续划卡"/>
        </p151v.VLinear>
    </p151v.VFrame>
</p151v.VFrame>
