<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.home.virtualcard.HomeNewBizCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    flatten="true"
    holder="home.virtualcard.HomeNewBizCardView">
    <p151v.VImage
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f081644"
        android:scaleType="centerCrop"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <p151v.VImage
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="0x7f081643"
            android:scaleType="centerCrop"/>
        <p151v.VText
            android:textSize="22sp"
            android:textColor="#8d2d8f"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="抢先告白"
            app:typeface="medium"/>
        <p151v.VText
            android:textColor="#668d2d8f"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="无需配对，直接向对方表达你的心意！"/>
    </p151v.VLinear>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/img"
        android:layout_width="359dp"
        android:layout_height="334dp"
        android:scaleType="center"
        app:actualImageScaleType="centerCrop"/>
    <p151v.VButton
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/ok"
        android:background="0x7f081645"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="58dp"
        android:layout_marginRight="58dp"
        android:layout_marginBottom="40dp"
        android:text="获取抢先告白"/>
</com.p051p1.mobile.putong.core.p058ui.home.virtualcard.HomeNewBizCardView>
