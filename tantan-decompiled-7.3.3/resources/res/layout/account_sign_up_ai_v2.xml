<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="accountai.SignUpAiV2ViewModel">
    <p151v.VRelative
        android:id="@+id/title_sign_up_ai_rl"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.p051p1.mobile.putong.account.p055ui.accountai.new2021.view.StepSeekBar
            android:id="@+id/step_progress_view"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="8dp"
            android:max="4"
            android:progress="3"
            android:progressDrawable="@drawable/account_signup_progress_bg"
            android:thumb="@color/transparent"
            android:layout_centerInParent="true"/>
        <p151v.VImage
            android:id="@+id/img_close"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="0x7f0801e9"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/common_000000_40"
            android:id="@+id/title_jump"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跳过"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"/>
    </p151v.VRelative>
    <p151v.VScroll
        android:id="@+id/scroll_sign_up_ai"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/sign_up_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_sign_up_ai_rl"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/content_sign_up_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/sign_up_vp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:id="@+id/sign_up_continue"
        android:background="@drawable/common_button_btn_orange_medium_v2"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="确认"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/common_button_large_01"/>
</androidx.constraintlayout.widget.ConstraintLayout>
