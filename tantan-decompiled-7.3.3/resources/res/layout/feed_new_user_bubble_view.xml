<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.view.FeedNewUserBubbleView">
    <p151v.VRelative
        android:id="@+id/bubble_rl"
        android:background="@color/feed_post_guide_bg_color"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="10dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/bubble_ic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:src="0x7f081e42"
            android:scaleType="center"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/bubble_post_tv"
            android:background="@drawable/feed_post_guide_post_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            android:text="去生成"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:typeface="medium"/>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bubble_text_content"
            android:paddingLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/bubble_post_tv"
            android:layout_toRightOf="@+id/bubble_ic"
            android:layout_centerVertical="true"
            flatten="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="新人冒泡"
                android:maxLines="1"
                android:singleLine="true"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_09"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="发动态获萌新挂件和流量奖励"
                android:maxLines="1"
                android:singleLine="true"/>
        </p151v.VLinear>
    </p151v.VRelative>
</p151v.VRelative>
