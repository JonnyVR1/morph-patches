<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/marry_switch_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/core_marry_swicth_bottom_sheet_bg"
        android:paddingBottom="52dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_gravity="end"
            android:id="@+id/marry_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="0x7f080576"
            android:layout_marginEnd="16dp"/>
        <p151v.VText
            android:textSize="22dp"
            android:textColor="@color/core_color_80percent_000000"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="40dp"
            android:text="选择我的交友模式"
            app:typeface="medium"/>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/love_layout"
            android:background="@drawable/core_bg_10_8_percent_ff645a"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="40dp">
            <p151v.VImage
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                android:src="0x7f0818b0"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.VText
                    android:textSize="16dp"
                    android:textColor="@color/core_color_80percent_000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="想恋爱"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/core_color_40percent_000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="邂逅更多有趣的灵魂"/>
            </p151v.VLinear>
            <p151v.VImage
                android:id="@+id/switch_state_love"
                android:background="0x7f0818bc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="20dp"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/marry_layout"
            android:background="@drawable/core_bg_10_8_percent_34bafe"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="40dp">
            <p151v.VImage
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                android:src="0x7f0818b3"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <p151v.VText
                    android:textSize="16dp"
                    android:textColor="@color/core_color_80percent_000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="想结婚"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/core_color_40percent_000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="以结婚为目的"/>
            </p151v.VLinear>
            <p151v.VImage
                android:id="@+id/switch_state_marry"
                android:background="0x7f0818bc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="20dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</p151v.VFrame>
