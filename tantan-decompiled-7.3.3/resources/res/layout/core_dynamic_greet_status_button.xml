<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.greet.DynamicGreetStatusView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="greet.DynamicGreetStatusView">
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_orange"
        android:gravity="center"
        android:id="@+id/status_chat"
        android:background="@drawable/core_dynamic_greet_status_bg"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="@string/FEED_GREETING_YES"
        android:drawableRight="@drawable/core_status_chat_down"
        android:drawablePadding="4dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/common_grey_03"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/status_not_disturb"
        android:background="@drawable/core_dynamic_greet_default_bg"
        android:paddingLeft="12dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="@string/FEED_GREETING_NO"
        android:drawableRight="@drawable/core_status_not_disturb_down"
        android:drawablePadding="4dp"/>
</com.p051p1.mobile.putong.core.newui.greet.DynamicGreetStatusView>
