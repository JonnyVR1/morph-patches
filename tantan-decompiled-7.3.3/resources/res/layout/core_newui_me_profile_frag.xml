<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_tab_me"
    android:background="@color/core_color_F6F5F1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    flatten="true"
    folder="newui"
    holder="profile.newme.NewMeTabProfileViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/top_navigationbar"
        android:paddingLeft="4dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_navigationbar"
        flatten="true">
        <p151v.VLinear
            android:orientation="vertical"
            android:id="@+id/new_me_linear"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/intr_risk_banner"
                android:background="#fff0ec"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                flatten="false">
                <p151v.VImage
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/core_intr_risk_icon"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/intr_risk_banner_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="2"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ban_release_entrance"
                android:background="@drawable/core_intl_new_bg_ban_release_entrance"
                android:paddingLeft="8dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="8dp"
                android:minHeight="32dp"
                android:text="@string/BAN_APPEAL_HINT_FOR_PROFILE"
                android:drawableLeft="0x7f0810b3"
                android:drawablePadding="8dp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#f17c28"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/fake_tip"
                android:background="@drawable/core_intl_new_bg_fake_tip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="12dp"
                android:text="@string/FAKE2GOOD_PROFILE_UPLOAD_FAIL"
                android:drawablePadding="6dp"
                android:drawableStart="0x7f0810c0"
                android:paddingStart="6dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="13dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/background_avatar"
                    android:layout_width="84dp"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:roundBottomEnd="true"
                    app:roundBottomLeft="true"
                    app:roundBottomRight="true"
                    app:roundBottomStart="true"
                    app:roundedCornerRadius="10dp"
                    style="@style/core_fresco_base"/>
                <p151v.VImage
                    android:id="@+id/iv_edit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="0x7f080b59"
                    app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
                    app:layout_constraintRight_toRightOf="@+id/background_avatar"/>
                <p151v.VImage
                    android:id="@+id/iv_edit_red_dot"
                    android:background="@drawable/core_intl_profile_me_edit_red_dot"
                    android:visibility="visible"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="17dp"
                    android:layout_marginBottom="18dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_edit"
                    app:layout_constraintLeft_toLeftOf="@+id/iv_edit"
                    app:roundAsCircle="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/user_desc_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="96dp"
                    app:layout_constraintLeft_toRightOf="@+id/background_avatar"
                    app:layout_constraintTop_toTopOf="@+id/background_avatar"
                    flatten="true">
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:id="@+id/name_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:ellipsize="end"
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <p151v.VDraweeView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/emoji"
                            android:visibility="gone"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="0dp"/>
                        <p151v.VImage
                            android:layout_gravity="center_vertical"
                            android:id="@+id/verification_icon"
                            android:visibility="gone"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="4dp"
                            android:scaleType="fitXY"/>
                        <p151v.VImage
                            android:layout_gravity="center_vertical"
                            android:id="@+id/img_vip"
                            android:visibility="gone"
                            android:layout_width="30dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="5dp"/>
                    </p151v.VLinear>
                </LinearLayout>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_80000000"
                    android:id="@+id/id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintLeft_toRightOf="@+id/background_avatar"
                    app:layout_constraintTop_toBottomOf="@+id/user_desc_container"/>
                <p151v.VButton
                    android:id="@+id/bt_id_copy"
                    android:background="0x7f080aa2"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/id"
                    app:layout_constraintLeft_toRightOf="@+id/id"
                    app:layout_constraintTop_toTopOf="@+id/id"/>
                <Space
                    android:id="@+id/space"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="35dp"
                    app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
                    app:layout_constraintLeft_toLeftOf="parent"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/wallet_layout"
                    android:background="@drawable/core_bg_10_0f000000"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@+id/background_avatar"
                    app:layout_constraintTop_toBottomOf="@+id/space">
                    <p151v.VImage
                        android:id="@+id/wallet_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="0x7f081188"
                        android:scaleType="fitXY"/>
                    <p151v.VText
                        android:textSize="11sp"
                        android:textColor="@color/core_color_010101"
                        android:id="@+id/wallet_coin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="11dp"
                        android:maxLines="1"/>
                    <p151v.VDraweeView
                        android:id="@+id/luckytantan"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginLeft="16dp"
                        app:actualImageScaleType="fitXY"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ViewStub
                android:id="@+id/intl_pay_guide"
                android:layout="@layout/core_intl_me_guide_privileged_pay_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="13dp"
                android:layout_marginBottom="15dp"
                android:layout_marginHorizontal="13dp"/>
            <com.p051p1.mobile.putong.core.newui.profile.newme.NewProfilePrivilegedPager
                android:id="@+id/privilege_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>
            <p151v.VDraweeView
                android:id="@+id/hide_and_seek"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:actualImageResource="0x7f080cdd"
                app:roundedCornerRadius="12dp"/>
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#4d000000"
                android:id="@+id/service_plu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/INTL_ME_TAB_MORE_SERVICES"/>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/item_layout"
                android:background="@drawable/core_bg_10_ffffff"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"/>
        </p151v.VLinear>
    </ScrollView>
</p151v.VRelative>
