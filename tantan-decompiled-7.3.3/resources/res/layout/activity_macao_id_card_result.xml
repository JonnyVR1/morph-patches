<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="@dimen/identity_ocr_result_page_font_size_big"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/identity_ocr_result_title"
                android:layout_centerInParent="true"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_result_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="@dimen/identity_ocr_main_margin_left"
                android:src="@drawable/identity_ocr_img_comm_close_black"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <View
                android:id="@+id/identity_ocr_result_close"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_result_tips"
            android:background="#ededed"
            android:paddingLeft="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_result_tips_icon"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/identity_ocr_result_id_top_tips_icon"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                android:textColor="#000000"
                android:id="@+id/tv_top_message_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/identity_ocr_result_top_tips"
                android:layout_toRightOf="@+id/iv_result_tips_icon"
                android:layout_centerVertical="true"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="20dp"
                android:src="@drawable/identity_ocr_img_comm_close_grey"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <View
                android:id="@+id/view_result_tips"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <ScrollView
            android:id="@+id/identity_ocr_id_card_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/identity_ocr_main_margin_left"
                        android:layout_marginBottom="@dimen/identity_ocr_main_margin_left">
                        <ImageView
                            android:id="@+id/identity_ocr_id_card_front_default"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_marginLeft="25dp"
                            android:layout_marginRight="25dp"
                            android:scaleType="fitXY"
                            android:layout_weight="1"/>
                        <View
                            android:id="@+id/view_top_break_line"
                            android:background="#f7f7f7"
                            android:layout_width="match_parent"
                            android:layout_height="15dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/identity_ocr_result_id_name_ll"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_surnameCN"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_macao_surnamecn"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_surnameCN"
                                android:maxLength="50"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_givennameCN"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_macao_givernamecn"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_givennameCN"
                                android:maxLength="50"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_surname"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_macao_surname"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_surname"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_givenname"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_macao_givername"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_givenname"
                                android:maxLength="50"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_sex"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_sex"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_sex"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_birthDate"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_birthdate"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_birthDate"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_idNumber"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_page_id_no"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_idNumber"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <com.idv.identity.ocr.widget.OcrContentTitleView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_expiryDate"/>
                            <com.idv.identity.ocr.widget.OcrEditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_expiry_date"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_expiryDate"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/identity_ocr_result_page_card_item_height"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp">
                            <TextView
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:text="@string/identity_ocr_result_id_placeOfBirth"/>
                            <EditText
                                android:textSize="@dimen/identity_ocr_result_page_font_size_small"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/identity_ocr_result_id_macao_placeofbirth"
                                android:background="@drawable/shape_identity_ocr_id_result_edit_bg_grey"
                                android:paddingLeft="10dp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/identity_ocr_result_id_macao_hint_placeOfBirth"
                                android:maxLength="50"
                                android:layout_weight="1"
                                android:inputType="text"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/identity_loading_overlay"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:background="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.8"/>
                </FrameLayout>
            </FrameLayout>
        </ScrollView>
        <Button
            android:textSize="@dimen/identity_ocr_result_page_font_size_big"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/identity_ocr_result_ok"
            android:background="@drawable/identity_result_round_shape"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:text="@string/identity_ocr_result_btn_txt"/>
    </LinearLayout>
    <com.idv.identity.platform.IdentityAlertOverlay
        android:id="@+id/identity_alert_overlay"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.idv.identity.platform.iOSLoadingView
        android:layout_gravity="center"
        android:id="@+id/iosLoadingView"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</FrameLayout>
