<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceDefaultView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    holder="banner.view.PrivilegeEntranceDefaultView">
    <p151v.VImage
        android:id="@+id/texture"
        android:clipChildren="true"
        android:layout_width="337dp"
        android:layout_height="66dp"
        android:layout_margin="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/border"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/arrow_right"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="15dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:layout_marginStart="22dp"
        app:layout_constraintBottom_toTopOf="@+id/desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/arrow_right"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="12dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:alpha="0.9"
        android:layout_marginStart="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/arrow_right"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntranceDefaultView>
