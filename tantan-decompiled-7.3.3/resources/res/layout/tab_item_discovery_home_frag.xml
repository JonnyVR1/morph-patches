<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VText
        android:textSize="18dp"
        android:textColor="@color/tab_text_color_live_square_act"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_tab_title"
        android:paddingLeft="27dp"
        android:paddingRight="27dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        app:typeface="medium"/>
    <p151v.VImage
        android:id="@+id/dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-19dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/moment_white_dot"
        android:layout_toRightOf="@+id/tv_tab_title"/>
</p151v.VRelative>
