<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="account.BanDetailActViewModel">
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_above="@+id/divider_view"
        flatten="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#212121"
                android:id="@+id/ban_detail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/BAN_DETIAL_BEGIN"
                android:lineSpacingExtra="6sp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#212121"
                android:id="@+id/ban_detail_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6sp"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#212121"
                android:id="@+id/ban_detail_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6sp"/>
        </LinearLayout>
    </p151v.VScroll>
    <View
        android:id="@+id/divider_view"
        android:background="#e9e9e9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@+id/appeal"/>
    <p151v.VButton
        android:textSize="13sp"
        android:textStyle="normal"
        android:textColor="#006df7"
        android:gravity="center"
        android:id="@+id/appeal"
        android:background="@drawable/core_ban_detail_appeal_button_bg"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/BAN_DETIAL_PAGE_BUTTON"
        android:layout_above="@+id/bottom_view"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="0sp"/>
    <View
        android:id="@+id/bottom_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
