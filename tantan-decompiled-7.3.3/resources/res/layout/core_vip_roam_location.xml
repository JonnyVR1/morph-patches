<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="vip.roam.VipRoamLocationViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/top_title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="20dp"
            flatten="true">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/core_color_66000000"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/current_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/SETTINGS_LOCATION_TYPE_CURRENT"/>
            <p151v.VImage
                android:layout_gravity="center_vertical"
                android:id="@+id/title_refresh"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginLeft="6dp"
                android:src="0x7f08196a"/>
        </LinearLayout>
        <include
            android:id="@+id/current_location"
            layout="@layout/vip_location_item"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_orange"
            android:id="@+id/tv_no_location_permission_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp"
            android:text="@string/LOCATION_NOPERMISSIONS"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="18dp"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/roaming_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:text="@string/SETTINGS_LOCATION_TYPE_ROAMING"
            android:layout_marginStart="20dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VList
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="52dp"
                android:divider="@null"
                android:dividerHeight="0dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/add_new"
                android:background="@drawable/common_button_btn_orange_large"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="12dp"
                android:text="添加动态漫游位置"
                android:minLines="1"
                android:layout_marginHorizontal="20dp"/>
        </FrameLayout>
    </LinearLayout>
</p151v.VLinear>
