<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.NewQuickChatAudioHeaderViewModel">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/pullbg_svga"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/pullbg_svga_flash"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/tips_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        flatten="true">
        <p151v.VImage
            android:id="@+id/tips_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VText
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tips_text"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="下拉立即匹配在线用户"/>
    </p151v.VLinear>
    <com.p051p1.mobile.putong.core.newui.messages.anim.view.widget.QuickChatPullHeadAnim
        android:id="@+id/quickchat_pullhead_anim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
