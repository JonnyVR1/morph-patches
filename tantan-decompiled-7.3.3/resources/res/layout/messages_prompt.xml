<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemPrompt xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.ItemPrompt">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/core_new_messages_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="15dp">
            <p151v.VImage
                android:id="@+id/iv"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="0x7f08151a"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/core_msg_cell_left_text_color"
                    android:gravity="left"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/MESSAGE_BOTHERING_TITLE_SHORT"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/core_msg_text_tips_text_color"
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/MESSAGE_BOTHERING_DESCRIPTION"
                    android:lineSpacingExtra="2dp"
                    app:typeface="regular"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            flatten="true">
            <p151v.VLinear
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/buttons_wrapper"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:showDividers="middle"
                android:paddingHorizontal="16dp"
                flatten="true">
                <FrameLayout
                    android:id="@+id/no"
                    android:background="@drawable/core_bg_10_ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/core_msg_cell_left_text_color"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/text"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/MESSAGE_BOTHERING_NO"
                        app:typeface="medium"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/yes"
                    android:background="@drawable/core_bg_10_ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1">
                    <p151v.VText
                        android:textSize="16sp"
                        android:textColor="@color/core_msg_cell_left_text_color"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/text"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/MESSAGE_BOTHERING_YES"
                        app:typeface="medium"/>
                </FrameLayout>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#33000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/happy_chatting"
                android:background="@drawable/core_bg_10_ffffff"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/CHAT_SENSITIVE_MESSAGE_AREADY_FEEDBACK"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:typeface="medium"/>
        </FrameLayout>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemPrompt>
