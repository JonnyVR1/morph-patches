<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalCardStylePushView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui.home.bubble"
    holder="internalpush.LiveInternalCardStylePushView">
    <FrameLayout
        android:id="@+id/content_layout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/background_view"
            android:background="@drawable/core_internal_push_bubble_pink_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#66000000"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="直播中"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="0x7f080a18"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
                android:layout_gravity="center"
                android:id="@+id/ani_avatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="17dp"
                app:avatarSize="70dp"
                app:haloSize="84dp"/>
            <p151v.VText
                android:textSize="14dp"
                android:textColor="#66000000"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"/>
            <p151v.VButton
                android:textSize="14dp"
                android:textColor="#cc8c3232"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/button"
                android:background="@drawable/core_internal_push_bubble_button_bg"
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:layout_marginTop="13dp"/>
        </LinearLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.home.bubble.internalpush.LiveInternalCardStylePushView>
