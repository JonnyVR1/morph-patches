<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilege.PrivilegeCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    holder="vip.privilege.PrivilegeCard">
    <FrameLayout
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <FrameLayout
            android:id="@+id/texture_content"
            android:visibility="gone"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            flatten="true">
            <com.tantan.library.svga.SVGAnimationView
                android:id="@+id/texture_svga"
                android:layout_width="306dp"
                android:layout_height="116dp"
                android:layout_marginLeft="-2dp"/>
        </FrameLayout>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/light_svga"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <RelativeLayout
            android:id="@+id/card_rectangle"
            android:background="@drawable/core_vip_privilege_card_border"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/card_texture"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_title"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="18dp"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/iv_title_icon_simple"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="8dp"
                    android:src="0x7f081432"/>
                <p151v.VLinear
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp">
                    <p151v.VLinear
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/title_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        flatten="true">
                        <p151v.VImage
                            android:id="@+id/iv_title_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:src="0x7f081431"/>
                        <p151v.VText
                            android:textSize="19sp"
                            android:textColor="@color/common_white"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:typeface="medium"/>
                    </p151v.VLinear>
                    <p151v.VText
                        android:textSize="9sp"
                        android:textColor="@color/common_white"
                        android:ellipsize="end"
                        android:id="@+id/description_new"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                </p151v.VLinear>
            </LinearLayout>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="@color/common_white"
                android:ellipsize="end"
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="17dp"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_below="@+id/ll_title"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="11dp"
                android:layout_marginBottom="11dp"
                android:minHeight="32dp"
                android:layout_alignParentBottom="true">
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    style="@style/core_fresco_profile_small"/>
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="@color/common_white"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/user_privilege"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="5dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#ff5f23"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/goto_renew"
                    android:background="@drawable/core_privilege_vip_gotorenew_bg"
                    android:visibility="gone"
                    android:layout_width="57dp"
                    android:layout_height="32dp"
                    android:text="@string/REV_AUTOBENEFIT_RENEW"/>
            </p151v.VLinear>
        </RelativeLayout>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/icon_svga"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/icon_roted_svga"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.vip.privilege.PrivilegeCard>
