<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    attachToRoot="true"
    flatten="true"
    folder="newui"
    holder="view.boost.holder.TopBoostRefactorViewHolder">
    <FrameLayout
        android:id="@+id/boost_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="36dp"
        android:layout_centerInParent="true"
        flatten="true">
        <RelativeLayout
            android:id="@+id/fl_boost_anim"
            android:background="@drawable/core_boost_refactor_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="11dp">
            <View
                android:id="@+id/round"
                android:background="@drawable/core_boost_round_bg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_centerVertical="true"/>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#cc5b5198"
                android:gravity="center_vertical"
                android:id="@+id/status"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"
                android:layout_toRightOf="@+id/round"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/boost_svga_particle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="-4dp"
            android:layout_centerVertical="true"/>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/boost_svga"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="-4dp"
            android:layout_centerVertical="true"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/user_image"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            app:roundAsCircle="true"/>
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/boost_odiamond_svga"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="-4dp"
            android:layout_centerVertical="true"/>
    </FrameLayout>
</merge>
