<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="aialbum.AiAlbumDlgViewModel">
    <View
        android:id="@+id/place_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <p151v.VFrame
        android:id="@+id/conent_layout"
        android:background="@drawable/core_ai_album_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/content_bg"
            android:layout_width="match_parent"
            android:layout_height="265dp"
            app:actualImageScaleType="fitXY"/>
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close_iv"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080416"/>
        <include
            android:id="@+id/templates_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_ai_album_templates_view"/>
        <include
            android:id="@+id/picker_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_ai_album_picker_view"/>
        <include
            android:id="@+id/render_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_ai_album_render_view"/>
        <include
            android:id="@+id/result_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/core_ai_album_result_view"/>
    </p151v.VFrame>
</p151v.VLinear>
