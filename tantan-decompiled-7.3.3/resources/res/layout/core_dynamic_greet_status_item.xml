<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.greet.NewTagStatusItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/core_im_newui_filter_zodiacs_item_bg"
    android:clipChildren="false"
    android:layout_width="160dp"
    android:layout_height="120dp"
    attachToRoot="true"
    flatten="true"
    folder="newui"
    holder="greet.NewTagStatusItem">
    <p151v.VImage
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/core_greet_status_choose_not_disturb_seletor"
        android:scaleType="centerCrop"/>
    <p151v.VText_AutoFit
        android:textSize="14sp"
        android:textColor="@color/core_im_filter_check_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:singleLine="true"/>
    <p151v.VImage
        android:layout_gravity="right"
        android:id="@+id/choose_ic"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="-12dp"
        android:layout_marginRight="-12dp"
        android:src="0x7f0811e9"
        android:scaleType="centerCrop"/>
</com.p051p1.mobile.putong.core.newui.greet.NewTagStatusItem>
