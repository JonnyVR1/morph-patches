<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.Keyboard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/common_light_04"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.Keyboard">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"/>
        <p151v.VPagerCircleIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:snap="true"
            app:strokeWidth="0dp"
            style="@style/common_page_circle_indicator_light"/>
        <View
            android:id="@+id/horizontal_divider"
            android:background="#ffb0b2b5"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/hlist_wrapper"
            android:background="#ffd3d5d6"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            flatten="true">
            <p151v.VList_Horizontal
                android:id="@+id/hlist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:lh_divider="@drawable/messages_sticker_item_divider"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VFrame
        android:id="@+id/touch_blocker"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="54.5dp"/>
    <p151v.VFrame
        android:id="@+id/unlock"
        android:background="#88ffffff"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="54.5dp">
        <p151v.VButton_FakeShadow
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/button"
            android:background="@drawable/rect_rounded_tantan_orange"
            android:paddingLeft="24dp"
            android:paddingRight="58dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/MESSAGES_UNLOCK_BUTTON_TITLE"
            android:drawableLeft="0x7f0828d8"
            style="@style/core_im_main_button_left_drawable"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.messages.Keyboard>
