<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.view.LivePreviewTopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="LivePreviewTopView">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:id="@+id/close_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="0x7f0824a5"/>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/live_push_type_selector"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <FrameLayout
                android:id="@+id/live_video"
                android:layout_width="wrap_content"
                android:layout_height="28dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/live_preview_type_selector"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_PREVIEW_VIDEO"/>
                <View
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/live_selector_preview_type_indicator"
                    android:layout_width="12dp"
                    android:layout_height="3dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/live_obs"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginLeft="24dp">
                <p151v.VText
                    android:textSize="15sp"
                    android:textColor="@color/live_preview_type_selector"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LIVE_PREVIEW_COMPUTER"
                    android:layout_weight="1"/>
                <View
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/live_selector_preview_type_indicator"
                    android:layout_width="12dp"
                    android:layout_height="3dp"/>
            </FrameLayout>
        </p151v.VLinear>
    </FrameLayout>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/live_cover_container"
        android:background="@drawable/live_bg_black_r10_a20"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="23dp"
        flatten="true">
        <p151v.VLinear
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">
            <FrameLayout
                android:id="@+id/live_cover_parent"
                android:layout_width="64dp"
                android:layout_height="64dp"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/live_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:failureImage="@drawable/live_shape_preview_cover"
                    app:placeholderImage="@drawable/live_shape_preview_cover"
                    app:placeholderImageScaleType="centerInside"
                    app:roundBottomLeft="true"
                    app:roundBottomRight="true"
                    app:roundTopLeft="true"
                    app:roundTopRight="true"
                    app:roundedCornerRadius="10dp"
                    style="@style/live_fresco_base"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/checking"
                    android:background="@drawable/live_bg_black_br10_a50"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>
                <p151v.VImage
                    android:layout_gravity="bottom|right"
                    android:id="@+id/checking_image"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f0824a3"/>
            </FrameLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/live_margin_start"
                android:layout_marginRight="@dimen/live_margin_end"
                android:layout_marginEnd="@dimen/live_margin_end">
                <p151v.VEditText
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:textColorHint="#66ffffff"
                    android:id="@+id/live_title"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="@string/LIVE_COME_TANTAN_LIVE"
                    android:hint="@string/LIVE_INPUT_ROOM_TITLE"
                    android:lines="1"
                    android:singleLine="true"
                    android:inputType="textNoSuggestions"/>
            </RelativeLayout>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.view.LivePreviewTopView>
