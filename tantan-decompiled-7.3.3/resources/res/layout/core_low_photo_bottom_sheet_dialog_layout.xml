<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/core_friend_tacit_bottom_sheet_bg"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="profile.views.LowPhotoBottomSheet">
    <p151v.VImage
        android:layout_gravity="end"
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="0x7f080576"
        android:layout_marginEnd="16dp"/>
    <p151v.VImage
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f080d90"
        android:layout_marginStart="40dp"/>
    <com.p051p1.mobile.putong.core.p058ui.VText_Bold
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="展示真实的自己和有趣的生活"
        android:layout_marginStart="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#66000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="上传优质照片，收获更多喜欢"
        android:layout_marginStart="40dp"/>
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="40dp"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="40dp"
        app:actualImageScaleType="fitXY"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="#4d000000"
            android:gravity="center"
            android:id="@+id/select_video"
            android:background="@drawable/core_low_photo_bottom_sheet_video_button_bg"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="选择视频"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/select_photo"
            android:background="@drawable/core_low_photo_bottom_sheet_photo_button_bg"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="上传照片"
            android:layout_weight="1"/>
    </p151v.VLinear>
</p151v.VLinear>
