<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.view.diamond.BlackDiamondTagView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_black_diamond_tag_view_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="diamond.BlackDiamondTagView"
    style="@style/core_account_root">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/diamond_svga"
            android:layout_width="28dp"
            android:layout_height="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffe2ab"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/BLACK_DIAMOND"
            android:layout_marginStart="-2dp"
            android:layout_marginEnd="7dp"/>
    </LinearLayout>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/star_svga"
        android:layout_width="28dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/light_svga"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.view.diamond.BlackDiamondTagView>
