<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="seepage.likers.mytab.FakeLikersMyTabViewModel">
    <p151v.VRecyclerView
        android:id="@+id/list"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"/>
    <include
        android:id="@+id/empty"
        android:visibility="gone"
        flatten="true"
        layout="@layout/core_mytab_empty"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/get_privilege"
        android:background="@drawable/core_newui_fakelikers_buy_btn_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/SEE_WHO_LIKED_ME_INTRO_TITLE"
        android:shadowColor="#1e000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"/>
</RelativeLayout>
