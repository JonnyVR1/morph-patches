<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeUnLimitLikeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="purchase.privilege.PrivilegeUnLimitLikeView">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/certain"
        android:paddingTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_left"
            android:background="0x7f082a87"
            android:paddingLeft="9dp"
            android:paddingTop="7dp"
            android:paddingRight="9dp"
            android:paddingBottom="11dp"
            android:layout_width="90dp"
            android:layout_height="108dp"
            android:layout_marginLeft="-30dp"
            app:roundedCornerRadius="5dp"/>
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_right"
            android:background="0x7f082a87"
            android:paddingLeft="9dp"
            android:paddingTop="7dp"
            android:paddingRight="9dp"
            android:paddingBottom="11dp"
            android:layout_width="90dp"
            android:layout_height="108dp"
            android:layout_marginRight="-30dp"
            android:rotation="15"
            app:roundedCornerRadius="5dp"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="-50dp"
            android:src="0x7f082a9a"/>
    </FrameLayout>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/uncertain"
        android:layout_width="wrap_content"
        android:layout_height="110dp"
        android:layout_marginBottom="15dp"
        android:src="0x7f082a98"
        android:scaleType="centerInside"/>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.PrivilegeUnLimitLikeView>
