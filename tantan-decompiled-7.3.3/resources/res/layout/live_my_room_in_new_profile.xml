<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:paddingBottom="5dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="page.profile.myroomnew"
    holder="MyRoomInProfileNewViewModel">
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:id="@+id/my_room_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="@string/LIVE_PROFILE_MY_ROOM"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_voice"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="3.5dp"
        app:layout_constraintEnd_toStartOf="@+id/layout_live"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_room_title"
        app:layout_goneMarginEnd="20dp"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/anim_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:background="@drawable/live_shape_bg_3cffffff_circle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatars"
            app:layout_constraintEnd_toEndOf="@+id/avatars"
            app:layout_constraintStart_toStartOf="@+id/avatars"
            app:layout_constraintTop_toTopOf="@+id/avatars"/>
        <com.p051p1.mobile.putong.live.external.page.profile.myroomnew.view.MultipleAvatarView
            android:id="@+id/avatars"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_subTitle"
            app:layout_constraintEnd_toStartOf="@+id/tv_tailTitle"
            app:layout_constraintStart_toEndOf="@+id/avatars"
            app:layout_constraintTop_toTopOf="@+id/avatars"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/tv_subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/avatars"
            app:layout_constraintEnd_toStartOf="@+id/tv_tailTitle"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/avatars"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_tailTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="#99ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_top_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="私人房"
            android:maxLines="1"
            android:drawablePadding="3dp"
            android:drawableStart="0x7f0824ab"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_live"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="3.5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_voice"
        app:layout_constraintTop_toBottomOf="@+id/my_room_title"
        app:layout_goneMarginStart="20dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/layout_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/bg"
            android:background="@drawable/live_shape_my_room_in_newui_profile_total_live_blur_new"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/avatar_bg"
            android:background="@drawable/live_shape_bg_3cffffff_circle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="@+id/avatar"
            app:layout_constraintStart_toStartOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_title_live"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_subTitle_live"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/tv_subTitle_live"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_live"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
