<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.chat.danmaku.input.effects"
    holder="EffectsDanmakuViewModel">
    <View
        android:id="@+id/layout_input_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.p051p1.mobile.putong.live.base.view.RectangleLayout
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_effect_danmu_height"
        app:topLeftRadius="24dp"
        app:topRightRadius="24dp"
        flatten="true">
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.p051p1.mobile.putong.live.base.view.RectangleLayout>
</LinearLayout>
