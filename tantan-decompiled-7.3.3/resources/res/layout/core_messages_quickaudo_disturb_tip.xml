<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_new_messages_prompt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">
        <p151v.VImage
            android:id="@+id/online_ic"
            android:background="@drawable/core_quickaudio_msg_disturb_baoliu_ic_bg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f0815ba"
            android:scaleType="center"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#cc000000"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/MESSAGE_BOTHERING_TITLE_SHORT"
                app:typeface="medium"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#919393"
                android:id="@+id/tip_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="如果有，请一定要告诉我们"
                android:lineSpacingExtra="2dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#33000000"
        android:gravity="center"
        android:id="@+id/ready"
        android:background="@drawable/core_bg_10_ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:text="已保留配对"
        app:typeface="medium"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/choose"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="normal"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/unmatch"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="解除匹配"
            android:layout_weight="1"
            android:lineSpacingExtra="0sp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textStyle="normal"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/matched"
            android:background="@drawable/core_bg_10_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginLeft="7dp"
            android:text="保持好友"
            android:layout_weight="1"
            android:lineSpacingExtra="0sp"
            app:typeface="medium"/>
    </p151v.VLinear>
</p151v.VLinear>
