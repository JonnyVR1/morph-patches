<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.page.rights.list.view.RightAvatarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="#f7f7f7"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="page"
    holder="rights.list.view.RightAvatarView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/live_shape_user_right_item_normal_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center"
            android:id="@+id/duration"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginTop="9dp"
            android:maxLines="1"
            android:drawablePadding="2dp"
            android:drawableStart="0x7f0826d8"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="33dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/lock_icon"
            android:visibility="gone"
            android:layout_width="23dp"
            android:layout_height="22dp"
            android:src="0x7f0826d1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VImage
            android:id="@+id/right_arrow"
            android:visibility="gone"
            android:layout_width="23dp"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:src="0x7f0826cd"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/duration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/duration"/>
        <p151v.VDraweeView
            android:id="@+id/icon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="13dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/duration"
            app:placeholderImage="0x7f0822c4"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/dynamic_icon"
            android:visibility="gone"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="13dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/duration"
            app:placeholderImage="0x7f0822c4"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"/>
        <FrameLayout
            android:id="@+id/desc_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            flatten="true">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/live_gray_99"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="2dp"
                android:drawableEnd="0x7f0826ce"/>
        </FrameLayout>
        <p151v.VButton
            android:textSize="14.8sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/craft_button"
            android:background="@drawable/live_bg_fe7e1d_r12"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/LIVE_SCRAP_SYNTHESIS"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.external.page.rights.list.view.RightAvatarView>
