<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.suggest.SuggesterItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/new_ui_likers_item_big_image_bg"
    android:layout_width="match_parent"
    android:layout_height="238dp"
    android:layout_margin="5dp"
    folder="newui"
    holder="suggest.SuggesterItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/transparent"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/transparent"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="5dp"
        style="@style/core_fresco_base"/>
    <p151v.VText
        android:ellipsize="end"
        android:id="@+id/dynamic_tag"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        style="@style/core_card_small_tag"/>
    <LinearLayout
        android:gravity="end|top"
        android:layout_gravity="end|top"
        android:id="@+id/pic_verification_container"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        flatten="true">
        <p151v.VImage
            android:id="@+id/verification_icon"
            android:background="0x7f082957"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/core_liked_user_item_common_gradient"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/like_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="8dp"
            app:buttonColorEnd="@color/white"
            app:buttonColorStart="@color/white"
            app:icon="0x7f081608"
            app:iconHeight="18dp"
            app:iconWidth="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="52dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/like_button">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_line_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="4dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_line_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_line_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                app:typeface="medium"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.newui.suggest.SuggesterItemView>
