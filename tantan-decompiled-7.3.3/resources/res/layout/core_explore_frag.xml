<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView
        android:id="@+id/explore_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImageScaleType="centerCrop"
        app:placeholderImageScaleType="centerCrop"/>
    <p151v.VImage
        android:id="@+id/explore_title_back"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:layout_width="48dp"
        android:layout_height="47dp"
        android:src="0x7f080816"
        android:scaleType="fitCenter"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/explore_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@+id/explore_title_back">
        <p151v.VDraweeView
            android:id="@+id/explore_title_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="5dp"
            app:actualImageScaleType="fitCenter"
            app:failureImageScaleType="fitCenter"
            app:placeholderImageScaleType="fitCenter"
            style="@style/core_fresco_base"/>
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/explore_title_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"/>
    </p151v.VLinear>
    <p151v.VRelative
        android:id="@+id/explore_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="115dp"
        android:layout_marginBottom="30dp"
        android:layout_above="@+id/explore_navigation"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <View
            android:id="@+id/explore_empty_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="50dp">
            <p151v.VImage
                android:id="@+id/explore_empty_icon"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:src="0x7f08080c"
                android:layout_centerHorizontal="true"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/explore_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="暂时没有更多人了"
                android:layout_below="@+id/explore_empty_icon"
                android:layout_centerInParent="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="请稍后再试，或去其他主题与更多用户相遇"
                android:layout_below="@+id/explore_empty_title"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </p151v.VRelative>
    <p151v.VRelative
        android:id="@+id/explore_card_border"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="115dp"
        android:layout_marginBottom="25dp"
        android:layout_above="@+id/explore_navigation"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <FrameLayout
            android:id="@+id/explore_card_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/explore_bottom_buttons"
            android:padding="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_alignParentBottom="true"
            android:alpha="0"
            flatten="true">
            <com.p051p1.mobile.putong.core.newui.explore.view.ExploreCardOperationButton
                android:id="@+id/explore_dislike"
                android:background="@drawable/bg_explore_like"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:exploreIconPressStateColor="@color/white"
                app:exploreIconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                app:exploreMaxIconZoomRate="0.8"
                app:exploreNormalStateLayerBackground="@drawable/core_card_button_bg_normal"
                app:explorePressedStateLayerBackground="@drawable/core_card_undo_button_bg_press"/>
            <com.p051p1.mobile.putong.core.newui.explore.view.ExploreCardOperationButton
                android:id="@+id/explore_like"
                android:background="@drawable/bg_explore_like"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:exploreIconPressStateColor="@color/white"
                app:exploreIconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                app:exploreMaxIconZoomRate="0.8"
                app:exploreNormalStateLayerBackground="@drawable/core_card_button_bg_normal"
                app:explorePressedStateLayerBackground="@drawable/core_card_like_button_press"/>
        </p151v.VLinear>
    </p151v.VRelative>
    <View
        android:id="@+id/explore_navigation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"/>
</p151v.VRelative>
