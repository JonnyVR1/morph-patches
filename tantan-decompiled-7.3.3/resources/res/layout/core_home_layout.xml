<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.frag.base.HomeLayoutFrag"
    useRefId="true">
    <FrameLayout
        android:id="@+id/content_frame_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.p051p1.mobile.putong.core.newui.home.frag.base.HomeTitleBarRootLayout
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/titlebar_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        flatten="true">
        <p151v.VFrame
            android:layout_gravity="center_vertical"
            android:id="@+id/open_drawer"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            flatten="true">
            <p151v.VImage
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f0818bd"/>
            <p151v.VOnlineIndicator
                android:layout_gravity="right"
                android:id="@+id/open_drawer_dot"
                android:visibility="gone"
                style="@style/common_online_indicator_01"/>
        </p151v.VFrame>
        <FrameLayout
            android:id="@+id/titlebar"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            flatten="true"/>
    </com.p051p1.mobile.putong.core.newui.home.frag.base.HomeTitleBarRootLayout>
</FrameLayout>
