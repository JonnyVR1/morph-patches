<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.usercard.submodule.giftwall.VoiceCardGiftWallView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    flatten="true"
    holder="voice.usercard.submodule.giftwall.VoiceCardGiftWallView">
    <p151v.VDraweeView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <p151v.VFrame
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/title_bg"
            android:layout_width="25dp"
            android:layout_height="62dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/live_white_40_opacity"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="礼\10物\10墙"/>
    </p151v.VFrame>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/recycler"
        android:fadingEdgeLength="10dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="37dp"
        android:layout_marginRight="42dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"/>
    <p151v.VImage
        android:layout_gravity="center"
        android:id="@+id/more_bt"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="0x7f082846"
        android:layout_marginEnd="8dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.usercard.submodule.giftwall.VoiceCardGiftWallView>
