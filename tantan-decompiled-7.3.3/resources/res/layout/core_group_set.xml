<?xml version="1.0" encoding="utf-8"?>
<p151v.VScroll xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tantan_lemon_white"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.group.GroupSetViewModel"
    innerClass="true">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VFrame
                android:id="@+id/group_base_info"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/group_avatar"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    app:actualImageScaleType="centerCrop"
                    app:roundAsCircle="true"/>
                <p151v.VLinear
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="84dp"
                    android:layout_marginRight="16dp">
                    <p151v.VLinear_FillerMeasure
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fillerIndex="0">
                        <p151v.VText
                            android:textSize="16sp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/group_name"
                            android:paddingRight="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            app:typeface="medium"/>
                        <p151v.VText
                            android:textSize="11sp"
                            android:textColor="#ef7d37"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/group_category"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:typeface="medium"/>
                    </p151v.VLinear_FillerMeasure>
                    <p151v.VText
                        android:textSize="13sp"
                        android:textColor="#909090"
                        android:ellipsize="end"
                        android:id="@+id/group_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lines="2"/>
                </p151v.VLinear>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f081112"/>
            </p151v.VFrame>
            <p151v.VFrame
                android:id="@+id/group_members_count"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                flatten="true">
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:id="@+id/tv_members_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:typeface="medium"/>
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f081112"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/top_members"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <include
                    android:id="@+id/linear_member_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_group_set_member_item"/>
                <include
                    android:id="@+id/linear_member_1"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_group_set_member_item"/>
                <include
                    android:id="@+id/linear_member_2"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_group_set_member_item"/>
                <include
                    android:id="@+id/linear_member_3"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_group_set_member_item"/>
                <include
                    android:id="@+id/linear_member_4"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/core_group_set_member_item"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/frame_group_name"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/GROUPCHAT_GROUP_NAME"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d0d0d0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_group_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"
                    android:drawableRight="0x7f081112"
                    android:drawablePadding="10dp"/>
            </p151v.VLinear>
            <View
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"/>
            <p151v.VFrame
                android:id="@+id/frame_group_cover"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_GROUP_PHOTO_TITLE"
                    app:typeface="regular"/>
                <p151v.VLinear
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <p151v.VDraweeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/img_group_cover"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:actualImageScaleType="centerCrop"
                        app:placeholderImage="0x7f08095c"
                        app:roundAsCircle="true"/>
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:id="@+id/img_cover_edit"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:src="0x7f081112"/>
                </p151v.VLinear>
            </p151v.VFrame>
            <View
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/frame_description"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_GROUP_INTRODUCTION_SHEZHI"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d0d0d0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_group_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"
                    android:drawableRight="0x7f081112"
                    android:drawablePadding="10dp"/>
            </p151v.VLinear>
            <View
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/frame_group_id"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_GROUP_QUN_ID"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d0d0d0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_group_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"/>
            </p151v.VLinear>
            <View
                android:id="@+id/frame_group_manager_gap"
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/frame_group_manager"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_GROUP_MANAGE_GROUP"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d0d0d0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_group_manager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/CHAT_GROUP_MANAGE_SEETING"
                    android:maxLines="1"
                    android:drawableRight="0x7f081112"
                    android:drawablePadding="10dp"/>
            </p151v.VLinear>
            <View
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/frame_nickname"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/CHAT_GROUP_MY_NAME_TITLE"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d0d0d0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"
                    android:drawableRight="0x7f081112"
                    android:drawablePadding="10dp"/>
            </p151v.VLinear>
            <View
                android:background="#e9e9e9"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/frame_search_message"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                flatten="true">
                <p151v.VText
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/SEARCH_CHAT_HISTORY"
                    app:typeface="regular"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#d0d0d0"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_search_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"
                    android:drawableRight="0x7f081112"
                    android:drawablePadding="10dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VFrame
            android:id="@+id/frame_report"
            android:background="@color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#212121"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CHAT_GROUP_JUBAO_TITLE"
                app:typeface="regular"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/switch_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f081112"/>
        </p151v.VFrame>
        <p151v.VFrame
            android:id="@+id/frame_message_notify"
            android:background="@color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            flatten="true">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#212121"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/GROUPCHAT_MUTE_NOTIFICATIONS"
                app:typeface="regular"/>
            <p151v.VSwitch
                android:layout_gravity="center"
                android:id="@+id/switch_message_notify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ff5c31"
            android:gravity="center"
            android:id="@+id/btn_exit_group"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="@string/GROUPCHAT_DELETE_AND_LEAVE"
            app:typeface="regular"/>
    </p151v.VLinear>
</p151v.VScroll>
