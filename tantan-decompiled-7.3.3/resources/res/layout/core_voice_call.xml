<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/common_grey_01"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="voicecall.VoiceCallViewModel">
    <ImageView
        android:id="@+id/zoom_window"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/core_ic_voice_call_zoom_window"/>
    <p151v.VDraweeView
        android:id="@+id/other_pic"
        android:layout_width="152dp"
        android:layout_height="152dp"
        android:layout_marginTop="120dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/common_white_01"
        android:gravity="center"
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="30dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/other_pic"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/common_white_01"
        android:id="@+id/voice_call_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/call_wait_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/caller_hangup"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/core_ic_voice_call_hangup"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_white_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/VOICE_CALL_CANCELLATION"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/caller_hangup"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/callee_wait_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/callee_hangup"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="56dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:srcCompat="@drawable/core_ic_voice_call_hangup"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_white_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/VOICE_CALL_APPLICATION_RECEIVER_REJECT_BUTTON"
            app:layout_constraintLeft_toLeftOf="@+id/callee_hangup"
            app:layout_constraintRight_toRightOf="@+id/callee_hangup"
            app:layout_constraintTop_toBottomOf="@+id/callee_hangup"/>
        <p151v.VImage
            android:id="@+id/callee_hangon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/core_ic_voice_call_hang_on"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_white_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/VOICE_CALL_ANSWER"
            app:layout_constraintLeft_toLeftOf="@+id/callee_hangon"
            app:layout_constraintRight_toRightOf="@+id/callee_hangon"
            app:layout_constraintTop_toBottomOf="@+id/callee_hangon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calling_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/mute"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="32dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:srcCompat="@drawable/core_ic_voice_call_mute_passive"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_white_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/VOICE_CALL_MUTE"
            app:layout_constraintLeft_toLeftOf="@+id/mute"
            app:layout_constraintRight_toRightOf="@+id/mute"
            app:layout_constraintTop_toBottomOf="@+id/mute"/>
        <p151v.VImage
            android:id="@+id/calling_hangup"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/core_ic_voice_call_hangup"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_white_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/VOICE_CALL_FINISH"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calling_hangup"/>
        <p151v.VImage
            android:id="@+id/hang_free"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/core_ic_voice_call_hangs_free_passive"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_white_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/VOICE_CALL_HANDS_FREE"
            app:layout_constraintLeft_toLeftOf="@+id/hang_free"
            app:layout_constraintRight_toRightOf="@+id/hang_free"
            app:layout_constraintTop_toBottomOf="@+id/hang_free"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
