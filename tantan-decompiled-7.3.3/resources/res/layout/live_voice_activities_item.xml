<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.voiceslipcard.activity.LiveVoiceActivitiesItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    flatten="true"
    folder="voiceslipcard"
    holder="activity.LiveVoiceActivitiesItemView">
    <p151v.VRelative
        android:id="@+id/item_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/drawee_view"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginLeft="12dp"
            android:layout_centerVertical="true"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/live_shape_banner_profile_placeholder"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#e6000000"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/voice_status_view"
            android:layout_toRightOf="@+id/drawee_view"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#99000000"
            android:id="@+id/desc_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="12dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/voice_status_view"
            android:layout_below="@+id/title_text"
            android:layout_alignLeft="@+id/title_text"/>
        <FrameLayout
            android:id="@+id/voice_status_view"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            flatten="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/voice_online_layout"
                android:background="@drawable/live_shape_voice_activity_item_status_bg"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                flatten="true">
                <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
                    android:id="@+id/svga"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="5dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/live_white"
                    android:id="@+id/voice_online_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:maxWidth="56dp"
                    android:singleLine="true"/>
                <p151v.VImage
                    android:id="@+id/voice_online_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="4dp"
                    android:src="0x7f082759"/>
            </LinearLayout>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="#33000000"
                android:layout_gravity="center"
                android:id="@+id/voice_end_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
        </FrameLayout>
    </p151v.VRelative>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/allships"
        android:background="#ff6464"
        android:visibility="gone"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:text="@string/LIVE_VOICE_REMOVE_MATCHING"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/followships"
        android:background="#ff6464"
        android:visibility="gone"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:text="@string/LIVE_VOICE_CANCEL_FOLLOWED"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/matchships"
        android:background="#ff6464"
        android:visibility="gone"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:text="@string/LIVE_VOICE_REMOVE_MATCHING"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/likeships"
        android:background="#ff6464"
        android:visibility="gone"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:text="@string/LIVE_VOICE_INTL_LIKE_REMIND_REJECT"/>
</com.p051p1.mobile.putong.live.external.voiceslipcard.activity.LiveVoiceActivitiesItemView>
