<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#323232"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="47dp"
            android:text="@string/LIVE_FANSGROUP_TIPS_TITLE"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/LIVE_FANSGROUP_TIPS_MESSAGE"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <p151v.VButton
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/live_common_btn_color"
            android:gravity="center"
            android:id="@+id/enter_room_btn"
            android:background="@drawable/live_selector_orange_small_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/LIVE_FANSGROUP_ENTER_LIVE"
            android:singleLine="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#cccccc"
            android:id="@+id/ignore_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/LIVE_FANSGROUP_IGNORE"/>
    </p151v.VLinear>
</p151v.VFrame>
