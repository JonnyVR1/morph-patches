<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/agreement_root"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    flatten="true"
    holder="purchase.mediator.agreement.PurchaseAgreementComponent">
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/check"
        android:background="@drawable/core_purchase_shining_agreement_checkbox_bg"
        android:layout_width="20dp"
        android:layout_height="20dp"
        style="@style/core_svip_checkbox"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ccffffff"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/agreement"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:maxHeight="32dp"
        android:text="@string/VIP_ALERT_AGREEMENT_TIP"
        android:maxLines="2"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="10dp"
        android:fallbackLineSpacing="false"/>
</LinearLayout>
