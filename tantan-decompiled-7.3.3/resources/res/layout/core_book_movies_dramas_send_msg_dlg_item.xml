<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/work_cover"
        android:layout_width="68dp"
        android:layout_height="90dp"
        app:background="@color/common_red"
        app:placeholderImage="@drawable/core_slide_card_dlg_bg"
        app:roundedCornerRadius="12dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="normal"
        android:textColor="@color/core_text_e6000000"
        android:gravity="center_horizontal"
        android:id="@+id/prompt"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"/>
</p151v.VLinear>
