<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.livesquare.fragments.common.card.LiveFeedSuggesstIntlStyleCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="176dp"
    android:layout_height="168dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="@dimen/live_square_item_base_margin"
    android:layout_marginEnd="@dimen/live_square_item_base_margin">
    <com.p051p1.mobile.putong.live.base.view.LiveSquareMediaView
        android:id="@+id/media_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/view_group_live_end"
        android:visibility="gone"
        layout="@layout/live_intl_square_item_live_end"/>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:id="@+id/cover"
        android:background="@drawable/live_shape_bg_half_cover"
        android:layout_width="match_parent"
        android:layout_height="77dp"/>
    <include
        android:id="@+id/frame_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/live_intl_square_frame_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ViewStub
            android:id="@+id/guide"
            android:layout="@layout/live_square_suggest_hand_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveSpecialLabelView
            android:id="@+id/view_group_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveNewLabelDView
            android:id="@+id/view_group_label_D"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveNewLabelLeftTopView
            android:id="@+id/view_group_label_ABC"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="40dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveNewLabelEView
            android:id="@+id/view_group_label_E"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="50dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/tv_live_distance"/>
        <include
            android:id="@+id/view_group_opt_label"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/live_square_new_opt_label"/>
        <ViewStub
            android:id="@+id/multical_stub"
            android:layout="@layout/live_intl_square_suggest_multi_cal_avatars"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_name"/>
        <p151v.VDraweeView
            android:id="@+id/anchor_level_icon"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="14dp"
            android:layout_marginBottom="1dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_distance"
            app:layout_constraintStart_toStartOf="@+id/tv_live_distance"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_live_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="1dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/tv_live_distance"
            app:layout_constraintStart_toEndOf="@+id/anchor_level_icon"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="right"
            android:id="@+id/tv_live_audience_amount"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/tv_live_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.live.external.intl.livesquare.fragments.common.card.LiveFeedSuggesstIntlStyleCardView>
