<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.statussquare.CoreStatusSquareEnterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_con"
    android:background="@drawable/core_state_card_bg_small_02"
    android:paddingLeft="9dp"
    android:paddingRight="11dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    folder="newui"
    holder="statussquare.CoreStatusSquareEnterView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_ll"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VLinear
            android:gravity="center"
            android:id="@+id/header1_ll"
            android:background="@drawable/core_bg_round_white"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VDraweeView
                android:id="@+id/header1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:roundAsCircle="true"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:id="@+id/header2_ll"
            android:background="@drawable/core_bg_round_white"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VDraweeView
                android:id="@+id/header2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:roundAsCircle="true"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center"
            android:id="@+id/header3_ll"
            android:background="@drawable/core_bg_round_white"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VDraweeView
                android:id="@+id/header3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:roundAsCircle="true"/>
        </p151v.VLinear>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_color_66000000"
        android:id="@+id/tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:text="更多状态"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/header_ll"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.newui.statussquare.CoreStatusSquareEnterView>
