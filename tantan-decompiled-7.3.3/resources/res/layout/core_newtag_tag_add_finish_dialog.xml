<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="dlg.TagAddFinishDlg">
    <p151v.VLinear
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/core_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VImage
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:src="0x7f08122a"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_323232"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="标签已添加"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_999999"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:text="恭喜你成功添加了标签，已开启本次心动信号！"
            android:layout_marginHorizontal="32dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/main_btn"
            android:background="@drawable/core_bg_fe7e1d_r16"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="去聊天"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/core_color_cccccc"
            android:gravity="center"
            android:id="@+id/minor_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="添加更多标签"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
