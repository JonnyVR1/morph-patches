<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainlandnew.HourLeaderBoardContentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="leaderboard.hourleaderboard.mainlandnew.HourLeaderBoardContentView">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/assistance_title"
                android:background="0x7f082320"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"
                flatten="true">
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f082321"
                    android:scaleType="fitXY"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_ccD89C90"
                    android:gravity="start"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/assistance_title_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <p151v.VImage
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ass_open"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f082324"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="6dp"/>
            </p151v.VLinear>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/assistance_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/assistance_title"
                flatten="true">
                <p151v.VDraweeView
                    android:id="@+id/ass_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:actualImageScaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <p151v.VImage
                    android:id="@+id/ass_close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:src="0x7f08231f"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_ccD89C90"
                    android:id="@+id/assistance_content_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/live_66D89C90"
                    android:gravity="center"
                    android:id="@+id/assistance_content_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:maxLines="2"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/assistance_content_text"/>
                <include
                    android:id="@+id/gift_item1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="17dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/gift_item2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/assistance_content_desc"
                    layout="@layout/live_assistance_gift_item_layout"/>
                <include
                    android:id="@+id/gift_item2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="17dp"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/gift_item3"
                    app:layout_constraintStart_toEndOf="@+id/gift_item1"
                    app:layout_constraintTop_toBottomOf="@+id/assistance_content_desc"
                    layout="@layout/live_assistance_gift_item_layout"/>
                <include
                    android:id="@+id/gift_item3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="17dp"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/gift_item4"
                    app:layout_constraintStart_toEndOf="@+id/gift_item2"
                    app:layout_constraintTop_toBottomOf="@+id/assistance_content_desc"
                    layout="@layout/live_assistance_gift_item_layout"/>
                <include
                    android:id="@+id/gift_item4"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="17dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/gift_item3"
                    app:layout_constraintTop_toBottomOf="@+id/assistance_content_desc"
                    layout="@layout/live_assistance_gift_item_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@+id/assistance_content"/>
            <include
                android:id="@+id/empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="255dp"
                app:layout_constraintTop_toTopOf="@+id/recyclerView"
                layout="@layout/live_hour_leader_board_dialog_content_mainland_empty_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/own"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/live_hour_list_item_mainland_me"/>
</com.p051p1.mobile.putong.live.livingroom.increment.leaderboard.hourleaderboard.mainlandnew.HourLeaderBoardContentView>
