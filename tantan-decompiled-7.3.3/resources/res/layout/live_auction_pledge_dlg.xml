<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="voice.call.auction.dialog.relationchoose.AuctionPledgeChooseDlg">
    <View
        android:id="@+id/empty"
        android:background="@color/live_black_30_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/content"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="match_parent"
        android:layout_height="237dp"
        android:layout_margin="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_80_opacity"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="选择你的关系称号"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="center"
        android:id="@+id/left_tag"
        android:background="@drawable/live_bg_selector_choose_auction"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:minWidth="110dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toStartOf="@+id/right_tag"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="center"
        android:id="@+id/right_tag"
        android:background="@drawable/live_bg_selector_choose_auction"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:minWidth="110dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toEndOf="@+id/left_tag"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/confirm_bt"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="确定"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toBottomOf="@+id/left_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
