<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.account.AccountInactiveMainItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="account.AccountInactiveMainItemView">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/common_black_01"
        android:id="@+id/reason_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="17dp"
        android:layout_alignParentLeft="true"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="20dp"
        android:src="0x7f0811ee"
        android:scaleType="center"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.p051p1.mobile.putong.core.p058ui.account.AccountInactiveMainItemView>
