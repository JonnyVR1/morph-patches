<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.chat.notification.voice.VoiceUserNotificationItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2.5dp"
    android:layout_marginBottom="2.5dp"
    android:paddingEnd="10dp"
    app:bind_extends="LinearLayout"
    app:binding="true">
    <p151v.VDraweeView
        android:id="@+id/startIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_marginStart="8dp"/>
    <p151v.VImage
        android:layout_gravity="center_vertical"
        android:id="@+id/arrow"
        android:background="0x7f0827e9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_marginStart="5dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/button"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="8dp"/>
    <p151v.VDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/dynamic_button"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="1dp"/>
</com.p051p1.mobile.putong.live.livingroom.common.chat.notification.voice.VoiceUserNotificationItemView>
