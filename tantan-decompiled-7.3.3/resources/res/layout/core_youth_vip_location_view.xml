<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.youthvip.view.YouthVipLocationView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/core_youth_vip_locaton_item_bg"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    flatten="true"
    folder="newui"
    holder="youthvip.view.YouthVipLocationView">
    <p151v.VDraweeView
        android:id="@+id/texture"
        android:layout_width="250dp"
        android:layout_height="92dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="10dp"/>
    <ImageView
        android:id="@+id/location_ic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        android:src="0x7f081a49"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/right_arrow_ic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:src="0x7f081a4b"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/location_value"
        android:background="@drawable/core_bg_white_r6"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/right_arrow_ic"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:text="足迹漫游"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintLeft_toRightOf="@+id/location_ic"
        app:layout_constraintRight_toLeftOf="@+id/location_value"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="16dp"
        android:text="修改位置，前往学校附近、旅行目的地或任意地方交友"
        android:maxLines="2"
        android:lineSpacingExtra="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/location_ic"
        app:layout_constraintRight_toLeftOf="@+id/location_value"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"/>
</com.p051p1.mobile.putong.core.newui.youthvip.view.YouthVipLocationView>
