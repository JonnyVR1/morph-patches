<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.chat.notification.UserNotificationItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common"
    holder="chat.notification.UserNotificationItemView">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:layout_marginBottom="2.5dp"
        android:minHeight="44dp"
        android:paddingEnd="10dp">
        <p151v.VDraweeView
            android:id="@+id/startIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="8dp"
            app:roundAsCircle="true"/>
        <p151v.VDraweeView
            android:id="@+id/startIconNew"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="6dp"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="10dp"
            app:srcCompat="@drawable/live_vector_user_notify_item_arrow_white"/>
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/button"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="24dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="8dp"/>
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/dynamic_button"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="1dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/button_text"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:maxWidth="248dp"
            android:maxLines="1"
            android:lineSpacingExtra="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.common.chat.notification.UserNotificationItemView>
