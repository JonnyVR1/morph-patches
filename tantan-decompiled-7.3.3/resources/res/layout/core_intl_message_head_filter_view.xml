<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intl_head"
    android:background="0x7f080339"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    folder="newui"
    holder="messages.ConversationsListHeadView">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/common_card_image_holder_full_round"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="15dp"
            android:minWidth="161dp">
            <LinearLayout
                android:id="@+id/intl_message_sort_default_layout"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:ellipsize="end"
                    android:id="@+id/intl_message_sort_default_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_MESSAGES_FILTER_DEFAULT"
                    android:singleLine="true"
                    android:layout_toLeftOf="@+id/message_sort_default_check_image"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/intl_message_sort_default_check_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080385"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/intl_message_sort_chat_layout"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:ellipsize="end"
                    android:id="@+id/intl_message_sort_chat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_MESSAGES_FILTER_CHAT"
                    android:singleLine="true"
                    android:layout_toLeftOf="@+id/message_sort_unread_check_image"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/intl_message_sort_chat_check_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080385"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/intl_message_sort_match_layout"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/intl_message_sort_match_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/INTL_MESSAGES_FILTER_MATCHES"
                    android:singleLine="true"
                    android:drawableRight="0x7f080fd9"
                    android:drawablePadding="5dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/intl_message_sort_match_check_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080385"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
