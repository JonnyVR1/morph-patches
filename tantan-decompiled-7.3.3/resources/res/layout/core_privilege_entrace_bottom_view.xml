<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntrancePromotionBottomView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_vip_mytab_banner_promotion_vip_bg_new"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    holder="banner.view.PrivilegeEntrancePromotionBottomView">
    <View
        android:id="@+id/divider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VLinear_FillerMeasure
        android:orientation="horizontal"
        android:id="@+id/promotion_desc_layout"
        android:paddingRight="3dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="20dp"
        app:fillerIndex="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/goto_buy"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="15dp"
            android:textColor="#de7400"
            android:layout_gravity="center"
            android:id="@+id/promotion_desc_left"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="首月1元"
            android:layout_marginEnd="2dp"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/promotion_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:src="0x7f081983"/>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="#de7400"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/promotion_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="首月1元"
            android:lines="1"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/promotion_tip"
            android:paddingLeft="5dp"
            android:paddingTop="2dp"
            android:paddingRight="5dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            app:typeface="medium"/>
    </p151v.VLinear_FillerMeasure>
    <p151v.VText
        android:textSize="12dp"
        android:textColor="#fff"
        android:id="@+id/goto_buy"
        android:paddingLeft="11dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="16dp"
        android:text="立即解锁"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/promotion_desc_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:typeface="medium"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#de7400"
        android:id="@+id/buy_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="购买一个月会员"
        app:layout_constraintLeft_toLeftOf="@+id/promotion_desc_layout"
        app:layout_constraintTop_toBottomOf="@+id/promotion_desc_layout"/>
</com.p051p1.mobile.putong.core.p058ui.banner.view.PrivilegeEntrancePromotionBottomView>
