<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.intl.gift.IntlLiveCountdownView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="230dp"
    folder="intl"
    holder="gift.IntlLiveCountdownView">
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/combo_light"
        android:layout_width="210dp"
        android:layout_height="210dp"/>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center_horizontal"
        android:id="@+id/powerStar"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginTop="44dp"/>
    <com.p051p1.mobile.putong.live.livingroom.increment.gift.operation.LiveStrokeTextView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/combo"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="130dp"
        android:layout_height="110dp">
        <com.p051p1.mobile.putong.live.livingroom.increment.gift.operation.countdown.CommonGiftCountDownView
            android:layout_gravity="center"
            android:id="@+id/countdownView"
            android:layout_width="80dp"
            android:layout_height="80dp"/>
        <FrameLayout
            android:layout_gravity="end|top"
            android:id="@+id/closeGroup"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="15dp"
            flatten="true">
            <ImageView
                android:id="@+id/close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f08235e"/>
            <TextView
                android:textSize="9dp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/closeCountDown"
                android:background="@drawable/live_bg_ff8817_oval"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/giftIconGroup"
        android:background="0x7f082362"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/giftIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
    </FrameLayout>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:layout_gravity="center"
        android:id="@+id/long_press_anim"
        android:visibility="gone"
        android:layout_width="85dp"
        android:layout_height="85dp"/>
</com.p051p1.mobile.putong.live.livingroom.intl.gift.IntlLiveCountdownView>
