<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.feed.hello.FeedNearbyOnlineView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="newui"
    holder="photoalbum.feed.hello.FeedNearbyOnlineView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/post_guide_rl"
        android:background="@drawable/feed_greet_nearby_online_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_ll"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/header1_ll"
                android:background="@drawable/bg_round_white"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <p151v.VDraweeView
                    android:id="@+id/header1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:roundAsCircle="true"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/header2_ll"
                android:background="@drawable/bg_round_white"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <p151v.VDraweeView
                    android:id="@+id/header2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:roundAsCircle="true"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:gravity="center"
                android:id="@+id/header3_ll"
                android:background="@drawable/bg_round_white"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <p151v.VDraweeView
                    android:id="@+id/header3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:roundAsCircle="true"/>
            </p151v.VLinear>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VImage
            android:id="@+id/image_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081d29"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_black_02"
            android:id="@+id/online_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/header_ll"
            app:layout_constraintRight_toLeftOf="@+id/image_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.feed.newui.photoalbum.feed.hello.FeedNearbyOnlineView>
