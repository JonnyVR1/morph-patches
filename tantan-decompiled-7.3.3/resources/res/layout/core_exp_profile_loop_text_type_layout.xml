<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_root"
    android:background="@drawable/exp_profile_loop_text_type_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/edit_fl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp">
        <p151v.VEditText
            android:textSize="16dp"
            android:textColor="@color/common_exp_black_01"
            android:textColorHint="@color/common_exp_black_03"
            android:gravity="center_vertical"
            android:id="@+id/edit_view"
            android:background="@drawable/exp_profile_loop_text_type_edit_bg"
            android:paddingLeft="20dp"
            android:paddingRight="56dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:maxLines="1"
            android:singleLine="true"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/clean_content"
            android:background="0x7f080341"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/error_ll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f081c3a"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ff6464"
            android:id="@+id/error_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"/>
    </p151v.VLinear>
</p151v.VLinear>
