<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.view.GiftWallSendGiftDialogContentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="32dp"
    folder="increment"
    holder="gift.giftwallnew.view.GiftWallSendGiftDialogContentView">
    <p151v.VImage
        android:id="@+id/close_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:src="0x7f0827ab"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/iconBg"
        android:background="@drawable/live_bg_ebebeb_r10_a40"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/icon"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="20dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toTopOf="@+id/iconBg"/>
    <View
        android:id="@+id/user_icon_shadow"
        android:background="@drawable/live_bg_white_oval"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_icon"
        app:layout_constraintEnd_toEndOf="@+id/user_icon"
        app:layout_constraintStart_toStartOf="@+id/user_icon"
        app:layout_constraintTop_toTopOf="@+id/user_icon"/>
    <p151v.VDraweeView
        android:id="@+id/user_icon"
        android:visibility="gone"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:roundedCornerRadius="100dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_40_opacity"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <p151v.VText
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toBottomOf="@+id/iconBg"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_40_opacity"
        android:gravity="center"
        android:id="@+id/subscribe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toBottomOf="@+id/subscribe"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_20_opacity"
        android:id="@+id/cancel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/LIVE_LATER_TO_SAY_AGAIN"
        app:layout_constraintEnd_toEndOf="@+id/iconBg"
        app:layout_constraintStart_toStartOf="@+id/iconBg"
        app:layout_constraintTop_toBottomOf="@+id/confirm"/>
    <View
        android:id="@+id/holder"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/cancel"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.giftwallnew.view.GiftWallSendGiftDialogContentView>
