<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.SidesSlipHeadItemViewV2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:layout_marginBottom="14dp"
    folder="newui"
    holder="profile.newmine.newprofile.view.SidesSlipHeadItemViewV2">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/common_black_80"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:paddingEnd="@dimen/comm_margin_size_30"
            app:typeface="medium"/>
        <include
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            layout="@layout/core_fans_follow_layout"/>
    </p151v.VLinear>
    <p151v.VFrame
        android:id="@+id/marry_layout"
        android:background="@drawable/core_bg_8_08000000"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        flatten="true">
        <p151v.VImage
            android:layout_gravity="center"
            android:id="@+id/marry_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="10dp"
            android:src="0x7f080db8"/>
        <p151v.VText
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/marry_tite"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="40dp"
            android:text="14dp"
            app:typeface="medium"/>
        <p151v.VImage
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:src="0x7f080db9"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.SidesSlipHeadItemViewV2>
