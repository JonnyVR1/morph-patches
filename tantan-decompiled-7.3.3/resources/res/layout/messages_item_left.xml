<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageLeft xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    style="@style/core_messages_item_left_root">
    <include
        android:id="@+id/date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        layout="@layout/messages_item_date_header"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/header_tip"
        android:background="@drawable/messages_message_recall"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="10dp"
        app:typeface="medium"/>
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:id="@+id/love_letter"
        android:background="@drawable/core_love_letter_reply_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp"
        android:layout_marginBottom="18dp"
        android:layout_marginHorizontal="35dp">
        <p151v.VImage
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginVertical="7dp"
            app:srcCompat="0x7f080d83"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="13sp"
            android:textColor="#4d000000"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/love_letter_reminder"
            android:paddingLeft="4dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:lineHeight="18.2dp"/>
    </p151v.VLinear>
    <RelativeLayout
        android:id="@+id/content_wrapper"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VRelative
            android:gravity="center_vertical"
            android:id="@+id/check_box_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/profile_image_verfication"
            android:layout_alignBottom="@+id/profile_image_verfication"
            android:layout_marginStart="12dp"
            android:layout_alignParentStart="true">
            <p151v.VCheckBox
                android:id="@+id/pick_message"
                android:background="@drawable/core_message_select_checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@null"/>
        </p151v.VRelative>
        <FrameLayout
            android:id="@+id/profile_image_verfication"
            android:paddingTop="?attr/message_page_profile_left_pic_margin_top"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/check_box_container"
            style="?attr/message_avatar_style">
            <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
                android:id="@+id/profile_image_frame"
                android:layout_marginTop="-4.5dp"
                app:show_audio_chat_frame="true"
                style="@style/core_message_item_left_image_frame"/>
            <p151v.VImage
                android:layout_gravity="bottom|right"
                android:id="@+id/verification_icon"
                android:background="0x7f082957"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                useId="true"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/image_border"
                android:layout_width="?attr/message_page_profile_pic_size"
                android:layout_height="?attr/message_page_profile_pic_size"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="?attr/message_page_profile_border_margin_right"/>
            <com.p051p1.mobile.putong.core.p058ui.view.GradientBgButton
                android:layout_gravity="bottom|right"
                android:id="@+id/match_from"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="centerInside"
                app:iconWidth="6dp"/>
            <FrameLayout
                android:id="@+id/tickle_anim_content"
                android:clipChildren="false"
                android:layout_marginTop="-4dp"
                style="@style/core_message_item_left_image_frame"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="left"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/profile_image_verfication"
            style="@style/core_messages_item_left_frame">
            <p151v.VText
                android:textSize="12sp"
                android:textColor="#66000000"
                android:id="@+id/user_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:paddingStart="5dp"/>
            <com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth
                android:orientation="vertical"
                android:id="@+id/frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/message_page_profile_left_pic_margin"
                app:isLeft="true">
                <include
                    android:layout_gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    layout="@layout/core_ai_translate_msg_item"/>
                <p151v.VText
                    android:id="@+id/sent_from"
                    style="@style/core_messages_sent_from"/>
            </com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLinearMaxWidth>
        </LinearLayout>
    </RelativeLayout>
    <include
        android:layout_gravity="left"
        android:id="@+id/audio_translation"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="54dp"
        layout="@layout/core_audio_translation_view"/>
    <FrameLayout
        android:id="@+id/layout_greet_match"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="78dp"
        android:layout_marginRight="78dp"
        android:layout_marginBottom="10dp">
        <include layout="@layout/core_greet_match"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/footer_tip"
        android:background="@drawable/messages_message_recall"
        android:paddingLeft="9dp"
        android:paddingTop="4dp"
        android:paddingRight="9dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="10dp"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/footer_see_letter"
        android:background="@drawable/core_theme_profile_gerrt_match_bg"
        android:paddingLeft="9dp"
        android:paddingTop="4dp"
        android:paddingRight="9dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="10dp"
        android:text="@string/INTL_LETTER_AGAIN_SEND_TOAST"
        app:typeface="medium"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/layout_block_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="10dp">
        <include layout="@layout/intl_messages_block_hint"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#4c000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/gift_tips"
        android:background="@drawable/online_match_header_tip"
        android:paddingLeft="10dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="这个礼物每天只能送出一份哦，看来他真的很喜欢你"/>
    <ViewStub
        android:id="@+id/quickaudio_tip"
        android:layout="@layout/core_messages_quickaudo_disturb_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="2dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMessageLeft>
