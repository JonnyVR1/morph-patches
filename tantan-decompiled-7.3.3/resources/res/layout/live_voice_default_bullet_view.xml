<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.increment.bullet.VoiceLiveDefaultBulletView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="25dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="10dp"
    flatten="true"
    folder="voice.intl.increment"
    holder="bullet.VoiceLiveDefaultBulletView">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/content_layout"
        android:background="@drawable/live_shape_ff3a00_gradient_r12"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:paddingStart="40dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:ellipsize="marquee"
            android:layout_gravity="center_vertical"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="212dp"
            android:singleLine="true"
            android:marqueeRepeatLimit="1"
            android:layout_marginStart="4dp"/>
        <p151v.VMarqueeText
            android:textSize="12sp"
            android:textColor="@color/live_white"
            android:ellipsize="marquee"
            android:layout_gravity="center_vertical"
            android:id="@+id/marqueeContent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="212dp"
            android:singleLine="true"
            android:marqueeRepeatLimit="1"
            android:layout_marginStart="4dp"/>
        <p151v.VImage
            android:id="@+id/arrow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="3dp"
            android:scaleType="centerCrop"
            android:layout_toRightOf="@+id/content"
            android:layout_marginStart="4dp"
            app:srcCompat="0x7f0824b9"/>
    </RelativeLayout>
    <p151v.VDraweeView
        android:id="@+id/startIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.increment.bullet.VoiceLiveDefaultBulletView>
