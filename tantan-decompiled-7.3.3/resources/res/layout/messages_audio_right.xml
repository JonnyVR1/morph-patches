<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemAudio xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="right"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="?attr/message_audio_height_right">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/message_audio_height_right">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/message_audio_layout_height"
            android:layout_marginTop="?attr/message_audio_layout_top"
            android:paddingEnd="?attr/core_msg_layout_padding_right"
            android:layout_marginStart="?attr/message_audio_layout_left_right">
            <com.p051p1.mobile.putong.core.p058ui.messages.AudioView
                android:id="@+id/audio_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:bgColor="?attr/message_audio_right_bg_color"
                app:itemType="right"
                app:paintColor="?attr/message_audio_right_print_color"
                app:radius="10dp"/>
            <ImageView
                android:id="@+id/audio_img"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="?attr/core_msg_right_item_audio_button_img_start"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"/>
            <p151v.VText
                android:textSize="@dimen/message_text_size"
                android:textColor="?attr/message_audio_right_text_color"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:background="?attr/message_audio_right_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemAudio>
