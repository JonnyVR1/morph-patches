<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.act.GiftWallOptItemVIew xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="97dp"
    android:layout_marginLeft="3.5dp"
    android:layout_marginTop="7dp"
    android:layout_marginRight="3.5dp"
    holder="gift.act.GiftWallOptItemVIew">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="甜筒"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/dot"
        android:background="@drawable/core_vip_giftwall_item_dotbg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="10dp"
        android:minWidth="31dp"
        android:text="2"
        android:lineSpacingExtra="0sp"
        android:elevation="1dp"
        app:typeface="medium"/>
</com.p051p1.mobile.putong.core.p058ui.gift.act.GiftWallOptItemVIew>
