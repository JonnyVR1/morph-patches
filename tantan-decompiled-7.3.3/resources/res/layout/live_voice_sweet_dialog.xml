<?xml version="1.0" encoding="utf-8"?>
<p151v.VRelative xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="553dp"
    flatten="true"
    holder="voice.intl.sweet.view.VoiceSweetDialog">
    <p151v.VImage
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="0x7f08281d"
        android:scaleType="fitXY"/>
    <View
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/bg_img"/>
    <include
        android:id="@+id/my_cp_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        layout="@layout/live_voice_sweet_cp_layout"/>
    <include
        android:id="@+id/cp_rank_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        layout="@layout/live_voice_sweet_cp_rank_list_view"/>
    <p151v.VImage
        android:id="@+id/more_iv"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="8dp"
        android:src="0x7f082837"
        android:scaleType="centerInside"
        android:layout_alignParentRight="true"/>
    <p151v.VImage
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:src="0x7f08283d"
        android:layout_centerHorizontal="true"/>
    <include
        android:id="@+id/tabView"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_centerHorizontal="true"
        layout="@layout/live_voice_sweet_tab_layout"/>
</p151v.VRelative>
