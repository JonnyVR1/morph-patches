<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="account.JailedDialogLikeAct">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/core_jailed_ban_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="0x7f0820ec"/>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:maxLines="2"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_02"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/forbidden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"/>
        <p151v.VButton
            android:id="@+id/detail"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/JAILED_BUTTON_TEXT"
            style="@style/common_button_large_01"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_grey_04"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp"/>
    </LinearLayout>
</LinearLayout>
