<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.UploadGuideImageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.AutoVDraweeView
        android:id="@+id/pic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roundedCornerRadius="10dp"/>
    <p151v.VFrame
        android:id="@+id/refused_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tag_container"
        android:background="@drawable/core_bg_6_00ca48"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp">
        <p151v.VImage
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="0x7f08189e"
            android:scaleType="fitXY"/>
        <p151v.VText
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="2dp"
            android:text="正面照"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.profile.newmine.newprofile.view.UploadGuideImageView>
