<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/core_special_like_dlg_bg"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp">
        <View
            android:id="@+id/center_div"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true"/>
        <FrameLayout
            android:background="0x7f0816be"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginRight="-15dp"
            android:layout_toLeftOf="@+id/center_div">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/profile_other"
                android:layout_width="90dp"
                android:layout_height="90dp"
                style="@style/core_special_like_avatar"/>
        </FrameLayout>
        <FrameLayout
            android:background="0x7f0816be"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginLeft="-15dp"
            android:layout_toRightOf="@+id/center_div">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/profile_me"
                android:layout_width="90dp"
                android:layout_height="90dp"
                style="@style/core_special_like_avatar"/>
        </FrameLayout>
        <p151v.VImage
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="0x7f080986"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="18dp"
        android:textColor="#212121"
        android:gravity="center"
        android:id="@+id/like_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="25dp"
        android:text="她喜欢了你\10右滑才能和她配对！"/>
</LinearLayout>
