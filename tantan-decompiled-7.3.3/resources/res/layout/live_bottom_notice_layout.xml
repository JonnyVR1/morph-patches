<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="increment"
    holder="gift.notice.BottomNoticeDialog">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/root"
        android:background="@drawable/live_bg_191919_tr24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/top_title"
            android:paddingTop="21dp"
            android:paddingBottom="21dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VImage
            android:id="@+id/close"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="20dp"
            android:src="0x7f08224f"
            app:layout_constraintBottom_toBottomOf="@+id/top_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_title"/>
        <p151v.VDraweeView
            android:id="@+id/avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="20dp"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:layout_constraintBottom_toTopOf="@+id/checked"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_title"
            app:layout_goneMarginBottom="36dp"
            app:layout_goneMarginTop="20dp"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"/>
        <p151v.VButton
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sendButton"
            android:background="@drawable/live_bg_ff8817_r14"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:maxWidth="88dp"
            android:maxLines="1"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar"
            app:layout_goneMarginBottom="36dp"
            app:layout_goneMarginTop="20dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintEnd_toEndOf="@+id/content"
            app:layout_constraintStart_toStartOf="@+id/content"
            app:layout_constraintTop_toBottomOf="@+id/top_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginTop="20dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_50_opacity"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="185dp"
            android:maxLines="2"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/checked"
            app:layout_constraintEnd_toStartOf="@+id/sendButton"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_goneMarginBottom="36dp"
            app:layout_goneMarginStart="20dp"
            app:layout_goneMarginTop="12dp"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:id="@+id/content_center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="185dp"
            android:maxLines="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toStartOf="@+id/sendButton"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <p151v.VRadioButton
            android:textSize="12sp"
            android:textColor="@color/live_white_20_opacity"
            android:gravity="center"
            android:id="@+id/checked"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="32dp"
            android:button="@null"
            android:text="@string/LIVE_NOTICE_NOT_SHOW"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/live_selector_gift_notice"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</p151v.VLinear>
