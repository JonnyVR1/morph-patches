<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.applymanager.manager.VoiceCallMemberManagerItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list"
    android:layout_width="match_parent"
    android:layout_height="77dp"
    flatten="true"
    folder="voice"
    holder="applymanager.manager.VoiceCallMemberManagerItemView">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp">
        <com.p051p1.mobile.putong.live.livingroom.common.avatar.CommonMaskAvatarView
            android:id="@+id/avatar_group"
            android:layout_width="73dp"
            android:layout_height="73dp"/>
        <p151v.VText
            android:textSize="9dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/anchor_tag"
            android:background="@drawable/live_bg_fe7e1d_r4"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginBottom="9dp"
            android:maxWidth="60dp"
            android:text="房主房主房主房主房主"
            android:singleLine="true"/>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/boss_tag"
            android:background="0x7f0827d6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="85dp"
        android:layout_marginEnd="95dp"
        flatten="true">
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/live_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:maxWidth="148dp"
            android:maxLines="1"
            android:singleLine="true"/>
        <HorizontalScrollView
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tagsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/gender_age"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:layout_marginEnd="6dp">
                    <p151v.VImage
                        android:layout_gravity="center"
                        android:id="@+id/gender"
                        android:layout_width="14dp"
                        android:layout_height="14dp"/>
                    <p151v.VText
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/age"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="2dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:id="@+id/constellation"
                    android:visibility="gone"
                    android:layout_width="35dp"
                    android:layout_height="14dp"/>
                <p151v.VDraweeView
                    android:id="@+id/level"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="14dp"
                    fresco:actualImageScaleType="fitXY"/>
                <p151v.VDraweeView
                    android:id="@+id/vip"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"
                    fresco:actualImageScaleType="fitXY"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalFirst"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalSecond"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalThird"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
                <com.p051p1.mobile.putong.live.livingroom.common.usercard.CommonMedalView
                    android:id="@+id/medalFour"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/right_desc"
        android:background="@drawable/live_bg_ff8817_r10"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="53dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="20dp"/>
</com.p051p1.mobile.putong.live.livingroom.voice.applymanager.manager.VoiceCallMemberManagerItemView>
