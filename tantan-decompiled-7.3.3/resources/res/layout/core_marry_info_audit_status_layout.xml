<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.audit.MarryInfoAuditStatusViewModel">
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/core_marry_audit_head_bg"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp">
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="85dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:id="@+id/head_image"
                android:layout_width="375dp"
                android:layout_height="182dp"
                app:srcCompat="0x7f080da8"/>
            <p151v.VText
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/audit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="一切以结婚为目的"/>
            <p151v.VText
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/common_grey_02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="希望每个人都能遇见自己的理想伴侣"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/core_marry_audit_status_item_bg"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="20dp">
                <p151v.VImage
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="12dp"
                    app:srcCompat="@drawable/core_marry_audit_veri_ic"/>
                <p151v.VLinear
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <p151v.VText
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/common_black_02"
                        android:id="@+id/verification_audit_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实名 · 头像双重认证"/>
                    <p151v.VText
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/common_grey_02"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="防止诈骗，动机不纯者"/>
                </p151v.VLinear>
                <p151v.VButton
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_white"
                    android:id="@+id/check_veri_btn"
                    android:layout_width="67dp"
                    android:layout_height="34dp"
                    android:layout_marginLeft="11dp"
                    android:layout_marginRight="20dp"
                    android:text="去认证"
                    style="@style/common_button_small_01"/>
            </p151v.VLinear>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp">
                <p151v.VLinear
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/core_marry_audit_status_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="82dp">
                    <p151v.VImage
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="12dp"
                        app:srcCompat="@drawable/core_marry_audit_info_ic"/>
                    <p151v.VLinear
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <p151v.VText
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="@color/common_black_02"
                            android:id="@+id/user_info_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="专属资料更多了解"/>
                        <p151v.VText
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="@color/common_grey_02"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="收入、家庭背景一目了然"/>
                    </p151v.VLinear>
                    <p151v.VButton
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/common_white"
                        android:id="@+id/check_info_btn"
                        android:layout_width="67dp"
                        android:layout_height="34dp"
                        android:layout_marginLeft="11dp"
                        android:layout_marginRight="20dp"
                        android:text="去完善"
                        style="@style/common_button_small_01"/>
                </p151v.VLinear>
                <p151v.VText
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="#ff6244"
                    android:gravity="center"
                    android:layout_gravity="top|right"
                    android:id="@+id/user_info_fail_tips"
                    android:background="@drawable/core_marry_audit_fail_tips_bg"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="-8dp"
                    android:layout_marginRight="-4dp"
                    android:text="部分未通过审核，请重新填写"/>
            </FrameLayout>
            <p151v.VLinear
                android:orientation="vertical"
                android:background="@drawable/core_marry_audit_status_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp">
                <p151v.VText
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="@color/common_grey_04"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="- 劝退警示 -"/>
                <p151v.VText
                    android:textSize="12dp"
                    android:textColor="@color/common_grey_02"
                    android:layout_gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="20dp"
                    android:text="1. 你需补充较多的信息，我们会严格筛选，确保严肃的恋爱环境，提供更精准的匹配 \102. 如果你不是以结婚为目的请不要加入。聊天过程中如果怀疑对方是骗子或非真心恋爱，欢迎随时举报"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </ScrollView>
    <p151v.VButton
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/exchange_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="进入"
        style="@style/common_button"/>
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
</FrameLayout>
