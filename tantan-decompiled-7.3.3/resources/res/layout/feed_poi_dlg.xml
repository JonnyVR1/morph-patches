<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.poi.dialog.FeedPoiBaseDialog">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/dialog_rl"
        android:background="@drawable/feed_poi_dlg_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <View
            android:id="@+id/gradient"
            android:background="@drawable/feed_poi_dlg_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="244dp"/>
        <p151v.VDraweeView
            android:id="@+id/poi_ic"
            android:layout_width="140dp"
            android:layout_height="110dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="24dp"
            android:src="0x7f081e2b"
            app:actualImageScaleType="fitXY"/>
        <ImageView
            android:id="@+id/close_ic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f081e1c"
            android:layout_alignParentRight="true"/>
        <p151v.VText
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/feed_cc000000"
            android:id="@+id/poi_intent_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:layout_below="@+id/poi_ic"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/state_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/poi_intent_txt"
            flatten="true">
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/status_one_ll"
                android:background="@drawable/feed_poi_dialog_status_item_bg"
                android:layout_width="68dp"
                android:layout_height="84dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_image_one"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/feed_99000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_text_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/status_two_ll"
                android:background="@drawable/feed_poi_dialog_status_item_bg"
                android:layout_width="68dp"
                android:layout_height="84dp"
                android:layout_marginLeft="8dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_image_two"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/feed_99000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_text_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/status_three_ll"
                android:background="@drawable/feed_poi_dialog_status_item_bg"
                android:layout_width="68dp"
                android:layout_height="84dp"
                android:layout_marginLeft="8dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_image_three"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/feed_99000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_text_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
            <p151v.VLinear
                android:orientation="vertical"
                android:id="@+id/status_four_ll"
                android:background="@drawable/feed_poi_dialog_status_item_bg"
                android:layout_width="68dp"
                android:layout_height="84dp"
                android:layout_marginLeft="8dp"
                flatten="true">
                <p151v.VDraweeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_image_four"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/feed_99000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_text_four"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VEditText
            android:textSize="16sp"
            android:textColor="@color/feed_cc000000"
            android:textColorHint="@color/feed_33000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/input"
            android:background="@drawable/feed_bg_white_round_corner_10"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:maxLength="300"
            android:layout_below="@+id/state_container"
            android:inputType="text"
            android:textCursorDrawable="@drawable/feed_guide_states_cursor_bg"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/feed_66000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/location"
            android:background="@drawable/feed_poi_dlg_location_bg"
            android:paddingLeft="14dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="40dp"
            android:hint="@string/MOMENTS_CAPTION_ADD_LOCATION_CELL_TITLE"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableLeft="0x7f081ec7"
            android:drawablePadding="5dp"
            android:layout_below="@+id/input"
            android:paddingStart="14dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/post"
            android:background="@drawable/feed_poi_dlg_post_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="32dp"
            android:text="完成"
            android:layout_below="@+id/location"/>
    </RelativeLayout>
</FrameLayout>
