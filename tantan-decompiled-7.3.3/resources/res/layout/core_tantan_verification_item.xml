<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/tt_verification_root"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    flatten="true"
    style="@style/core_verification_lin_container">
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:background="@drawable/core_verification_center_tag_bg2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/VERIFICATION_GRADE_SENIOR_NEW"/>
    <TextView
        android:id="@+id/tt_verification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ID_VERIFICATION"
        style="@style/core_verification_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f0818d5"/>
        <p151v.VText
            android:id="@+id/id_verification_first_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/VERIFICATION_CENTER_ID_PRIVILEGES_1"
            style="@style/core_verification_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f0818d6"/>
        <p151v.VText
            android:id="@+id/id_verification_second_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/VERIFICATION_CENTER_ID_PRIVILEGES_2"
            style="@style/core_verification_content"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp">
        <p151v.VDraweeView
            android:id="@+id/profile_image2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:foreground="@color/transparent"
            style="@style/core_fresco_profile_small"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0818d8"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <p151v.VButton
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/tt_verification_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="56dp"/>
</LinearLayout>
