<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemFeedback xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="?attr/message_bubble_bg_left"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.ItemFeedback"
    useRefId="true">
    <View
        android:layout_width="2000dp"
        android:layout_height="0dp"/>
    <include
        android:id="@+id/text"
        layout="@layout/messages_text_left"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/core_text_e6000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/button_left"
            android:background="@drawable/messages_answer_bg"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:paddingVertical="16dp"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/common_black_01"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/button_right"
            android:background="@drawable/messages_answer_bg"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingVertical="16dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemFeedback>
