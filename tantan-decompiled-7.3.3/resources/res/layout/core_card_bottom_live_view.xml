<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomLiveView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomLiveView">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="94dp"
        android:layout_marginBottom="4dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <include
            android:id="@+id/user_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="94dp"
            layout="@layout/core_card_user_content_view"/>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/content_container"
            android:background="@drawable/core_card_bottom_live_bg"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="12dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VFrame
                android:layout_gravity="center_vertical"
                android:id="@+id/live_container"
                android:layout_width="44dp"
                android:layout_height="44dp"
                flatten="true">
                <p151v.VFrame
                    android:id="@+id/live_img_frame"
                    android:background="@drawable/core_card_bottom_live_svga_bg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"/>
                <com.tantanapp.media.ttmediaeffect.anim.AnimEffectPlayer
                    android:layout_gravity="center"
                    android:id="@+id/live_svga"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/live_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="20dp"
                    android:maxLines="1"
                    app:typeface="medium"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#33ffffff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/live_msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:minHeight="17dp"
                    android:maxLines="1"
                    android:lineSpacingExtra="1dp"
                    app:autoEmojis="true"
                    app:enableEmojis="true"
                    app:largeEmojis="true"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_join_in"
                android:background="@drawable/core_card_bottom_live_join_in_btn_bg"
                android:visibility="visible"
                android:layout_width="53dp"
                android:layout_height="34dp"
                android:layout_marginLeft="12dp"
                android:text="加入"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomLiveView>
