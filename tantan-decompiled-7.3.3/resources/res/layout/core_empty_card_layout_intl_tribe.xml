<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.intltribe.view.IntlTribeSlideEmptyCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_card"
    android:focusable="false"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="-100dp"
    flatten="true"
    folder="newui"
    holder="intltribe.view.IntlTribeSlideEmptyCardView"
    useRefId="true">
    <p151v.VDraweeView
        android:id="@+id/empty_image"
        android:layout_width="@dimen/radar_image_size"
        android:layout_height="@dimen/radar_image_size"
        android:layout_centerInParent="true"
        app:backgroundImage="@color/common_light_04"
        app:roundingBorderPadding="3dp"
        style="@style/core_fresco_profile_white_border"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_000000_40"
        android:gravity="center_horizontal"
        android:id="@+id/empty_tip"
        android:visibility="visible"
        android:layout_width="235dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/INTL_MEET_TRIBE_EMPTY_VIEW_TEXT"
        android:layout_below="@+id/empty_image"
        android:layout_centerHorizontal="true"
        app:typeface="medium"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/roaming_location"
        android:background="@drawable/core_intl_tribe_card_empty_btn_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="265dp"
        android:layout_height="56dp"
        android:layout_marginTop="64dp"
        android:text="@string/SETTINGS_CHANGE_LOCATION_BOTTOM_BUTTON_TITLE"
        android:layout_below="@+id/empty_tip"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="16dp"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/go_edit"
        android:background="@drawable/core_intl_tribe_card_empty_btn_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="265dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/SUGGEST_USERS_NO_CARDS_EDIT_FILTER"
        android:layout_below="@+id/roaming_location"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="16dp"/>
</com.p051p1.mobile.putong.core.newui.intltribe.view.IntlTribeSlideEmptyCardView>
