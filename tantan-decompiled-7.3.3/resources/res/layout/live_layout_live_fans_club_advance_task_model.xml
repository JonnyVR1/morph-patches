<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.fansclub.widget.LiveFansClubAdvanceTaskModelView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/live_shape_fans_club_advance_task_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    flatten="true"
    folder="common.fansclub.widget"
    holder="LiveFansClubAdvanceTaskModelView">
    <FrameLayout
        android:id="@+id/avatar_outside_bg"
        android:background="@drawable/live_bg_white_r10"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="12dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/drawee_view"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:failureImage="@drawable/live_vector_default_avatar_bg"
            app:placeholderImage="@drawable/live_vector_default_avatar_bg"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#e6ffffff"
        android:id="@+id/task_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_toRightOf="@+id/avatar_outside_bg"
        android:layout_alignTop="@+id/avatar_outside_bg"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#66ffffff"
        android:id="@+id/task_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/task_title"
        android:layout_alignLeft="@+id/task_title"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/button_to_finish"
        android:background="@drawable/live_bg_white_r12_a20"
        android:layout_width="66dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="12dp"/>
    <View
        android:id="@+id/line"
        android:background="#19ffffff"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_below="@+id/avatar_outside_bg"
        android:layout_marginHorizontal="12dp"/>
    <FrameLayout
        android:id="@+id/advance_task_reward_layout"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/advance_task_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_marginStart="12dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.common.fansclub.widget.LiveFansClubAdvanceTaskModelView>
