<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemReference xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:paddingLeft="?attr/core_msg_left_reference_padding_left"
    android:paddingTop="?attr/core_msg_left_reference_padding_top"
    android:paddingBottom="?attr/core_msg_left_reference_padding_bottom"
    android:paddingEnd="?attr/core_msg_left_reference_padding_right"
    style="@style/messages_item_left">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/reference_msg_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp">
        <View
            android:id="@+id/reference_line_bg"
            android:background="?attr/core_msg_left_cell_reference_line_bg_style"
            android:layout_width="3dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">
            <p151v.VText
                android:textSize="11sp"
                android:textColor="?attr/core_msg_left_cell_reference_title_text_color"
                android:ellipsize="end"
                android:id="@+id/reference_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="11sp"
                android:textColor="?attr/core_msg_left_reference_text_color"
                android:ellipsize="end"
                android:id="@+id/reference_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                app:autoEmojis="true"
                app:enableEmojis="true"
                app:typeface="regular"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="?attr/core_msg_left_reference_text_color"
        android:textColorLink="@color/core_msg_cell_link_color"
        android:autoLink="web"
        android:id="@+id/answer"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingBottom="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        app:enableEmojis="true"
        app:largeEmojis="true"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemReference>
