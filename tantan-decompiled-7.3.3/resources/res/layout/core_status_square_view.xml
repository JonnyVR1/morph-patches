<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="shareNames"
    holder="statussquare.CoreStatusSquareTabFrag">
    <p151v.VRelative
        android:id="@+id/bg_view"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/bg_img_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="29dp"
            android:layout_marginTop="10dp"
            android:src="0x7f080507"/>
        <p151v.VImage
            android:id="@+id/bg_img_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080508"
            android:layout_alignParentRight="true"/>
        <p151v.VImage
            android:id="@+id/bg_img_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="127dp"
            android:src="0x7f080509"
            android:layout_alignParentBottom="true"/>
    </p151v.VRelative>
    <p151v.VPullDownRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableAutoLoadMore="false"
        app:srlEnableLoadMore="true"
        app:srlEnableRefresh="false"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.statussquare.CoreStateSquareRecycleView
            android:id="@+id/square_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            useId="true"/>
    </p151v.VPullDownRefreshLayout>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/no_data"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0816d7"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4c323232"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂时没有状态"/>
    </p151v.VLinear>
</p151v.VFrame>
