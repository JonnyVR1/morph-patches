<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveActivitiesEntrySignIn xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/live_shape_activity_sign_entry_background"
    android:layout_width="140dp"
    android:layout_height="62dp"
    android:minHeight="40dp"
    flatten="true"
    folder="intl"
    holder="view.widgets.IntlLiveActivitiesEntrySignIn">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:background="@drawable/live_bg_ff57b0_r9"
        android:layout_width="37dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center"
            android:id="@+id/sign_in_gift_icon"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/texts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginStart="57dp"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="PingFangSC-Semibold"/>
        <p151v.VText
            android:textSize="11sp"
            android:textColor="@color/live_white_80_opacity"
            android:id="@+id/desc_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="PingFangSC-Regular"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.external.intl.view.widgets.IntlLiveActivitiesEntrySignIn>
