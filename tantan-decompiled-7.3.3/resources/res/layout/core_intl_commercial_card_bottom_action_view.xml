<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.IntlCommercialCardBottomActionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.views.IntlCommercialCardBottomActionLayout">
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/premium_match"
        android:background="@drawable/core_intl_sayhi_btn_fe7e1d_selector"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/INTL_SAYHI_CARD_BTN"
        android:maxLines="1"
        app:typeface="medium"/>
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/premium_match_us"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cl_us_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            flatten="true">
            <View
                android:id="@+id/view_viewprofile"
                android:background="@drawable/core_bg_view_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@+id/tv_viewprofile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_US_VIEWPROFILE"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/view_viewprofile"
                app:layout_constraintLeft_toLeftOf="@+id/view_viewprofile"
                app:layout_constraintRight_toRightOf="@+id/view_viewprofile"
                app:layout_constraintTop_toTopOf="@+id/view_viewprofile"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p151v.VLinear
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_sayhi_us"
            android:background="@drawable/core_intl_sayhi_btn_us"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            flatten="true">
            <p151v.VImage
                android:background="0x7f080a73"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_sayhi_us"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/INTL_SAYHI_CARD_BTN_USA"/>
        </p151v.VLinear>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.IntlCommercialCardBottomActionLayout>
