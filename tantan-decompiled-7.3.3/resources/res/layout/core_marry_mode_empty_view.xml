<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <p151v.VImage
                android:id="@+id/left_avatar"
                android:layout_width="180dp"
                android:layout_height="152dp"
                android:src="0x7f0818ba"/>
        </RelativeLayout>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <p151v.VText
                android:textSize="22sp"
                android:textColor="@color/core_color_80percent_000000"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/core_color_40percent_000000"
                android:gravity="center"
                android:id="@+id/title_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="每天12点，为你推荐新朋友"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:typeface="medium"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffbb00"
                android:gravity="center"
                android:id="@+id/hour_1"
                android:background="@drawable/core_bg_6_33ffbb00"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="0"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffbb00"
                android:gravity="center"
                android:id="@+id/hour_2"
                android:background="@drawable/core_bg_6_33ffbb00"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="0"
                android:layout_marginStart="3dp"
                app:typeface="medium"/>
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08188c"
                android:layout_marginStart="8dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffbb00"
                android:gravity="center"
                android:id="@+id/minute_1"
                android:background="@drawable/core_bg_6_33ffbb00"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="0"
                android:layout_marginStart="8dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffbb00"
                android:gravity="center"
                android:id="@+id/minute_2"
                android:background="@drawable/core_bg_6_33ffbb00"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="0"
                android:layout_marginStart="3dp"
                app:typeface="medium"/>
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f08188c"
                android:layout_marginStart="8dp"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffbb00"
                android:gravity="center"
                android:id="@+id/second_1"
                android:background="@drawable/core_bg_6_33ffbb00"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="0"
                android:layout_marginStart="8dp"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#ffbb00"
                android:gravity="center"
                android:id="@+id/second_2"
                android:background="@drawable/core_bg_6_33ffbb00"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="0"
                android:layout_marginStart="3dp"
                app:typeface="medium"/>
        </p151v.VLinear>
        <p151v.VButton
            android:textSize="16sp"
            android:id="@+id/switch_mode"
            android:layout_width="251dp"
            android:layout_height="56dp"
            android:layout_marginTop="60dp"
            android:text="切换到恋爱模式"
            style="@style/common_button_large_01"/>
    </p151v.VLinear>
</p151v.VLinear>
