<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.ScrollerGPPurchaseSectionView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="270dp"
    android:layout_height="160dp"
    holder="purchase.showcase.ScrollerGPPurchaseSectionView">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/boost_tip_container"
        android:background="@drawable/core_bg_weekly_boost_tip"
        android:paddingLeft="16dp"
        android:paddingTop="15dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        flatten="true">
        <p151v.VImage
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/boost_alert_ic"
            android:tint="#ff3499"/>
        <p151v.VText_NoTopPadding
            android:textSize="15sp"
            android:textColor="#ff3499"
            android:id="@+id/boost_tip_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:singleLine="true"
            android:layout_weight="1"
            app:fontWeight="500"/>
        <p151v.VText_NoTopPadding
            android:textSize="13sp"
            android:textColor="#ff3499"
            android:id="@+id/boost_tip_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:singleLine="true"
            app:fontWeight="400"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="12dp">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_01"
            android:gravity="center"
            android:id="@+id/hot_tag"
            android:background="@drawable/core_bg_privilege_price_vip_tag"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:text="HOT"
            android:singleLine="true"
            android:paddingHorizontal="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typeface="medium"/>
        <p151v.VImage
            android:id="@+id/select_img"
            android:background="0x7f080ce4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="30sp"
            android:textColor="@color/common_grey_01"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hot_tag"
            app:layout_goneMarginTop="25dp"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="@color/common_grey_01"
            android:layout_gravity="bottom"
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="5dp"
            android:text="个月"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/count"
            app:layout_constraintLeft_toRightOf="@+id/count"
            app:typeface="regular"/>
        <View
            android:id="@+id/center_price_bg"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <p151v.VText_AutoFit
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/top_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/center_price_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/center_price_bg"
            app:typeface="medium"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#4d000000"
            android:id="@+id/label"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/center_price_bg"
            app:layout_constraintRight_toRightOf="@+id/center_price_bg"
            app:layout_constraintTop_toTopOf="@+id/center_price_bg"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.ScrollerGPPurchaseSectionView>
