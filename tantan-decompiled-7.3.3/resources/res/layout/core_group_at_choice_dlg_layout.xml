<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.group.at.GroupUserAtChoiceDialog">
    <FrameLayout
        android:id="@+id/content_root"
        android:background="@drawable/core_impression_share_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="65dp"
        flatten="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/search_content_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="true">
            <EditText
                android:theme="@style/Theme.P1.Light"
                android:textSize="16dp"
                android:textColor="#212121"
                android:textColorHint="#d0d0d0"
                android:id="@+id/search_input"
                android:background="#00000000"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ACTION_SEARCH"
                android:singleLine="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#212121"
                android:gravity="center"
                android:id="@+id/cancel_btn"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ACTION_CANCEL"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/search_title_layout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            flatten="true">
            <p151v.VImage
                android:id="@+id/at_close_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="0x7f082ac0"
                android:scaleType="centerInside"/>
            <p151v.VText
                android:textSize="17dp"
                android:textColor="#212121"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/group_name"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:layout_weight="1"/>
            <p151v.VImage
                android:id="@+id/at_search_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="0x7f082ac1"
                android:scaleType="centerInside"/>
        </LinearLayout>
        <p151v.VRecyclerView
            android:id="@+id/at_list"
            android:paddingBottom="15dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/search_empty_list"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="126dp"
            android:layout_marginBottom="56dp">
            <p151v.VImage
                android:id="@+id/image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f0809e0"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#999999"
                android:layout_gravity="center_vertical"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/SEARCH_CONVERSATION_RESULT_NONE"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
