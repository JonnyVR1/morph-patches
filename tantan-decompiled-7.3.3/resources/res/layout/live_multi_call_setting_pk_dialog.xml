<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true"
    app:flatten="true">
    <p151v.VImage
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08211e"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/top_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white_80_opacity"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="PK设置"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#fe7e1d"
        android:id="@+id/iv_ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="完成"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/top_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_space"
        android:background="@color/live_white_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="21dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/tv_time_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="多人PK时长"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_space"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="300"
        android:drawableEnd="0x7f082405"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_time_title"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/tv_pk_invite_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="192dp"
        android:text="接受多人PK邀请"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_title"/>
    <p151v.VSwitch
        android:id="@+id/switcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pk_invite_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_pk_invite_title"
        style="@style/live_settings_item_switch"/>
    <p151v.VFrame
        android:id="@+id/range_layout"
        android:background="#19191e"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_space">
        <View
            android:layout_gravity="center"
            android:id="@+id/range_bg"
            android:background="@drawable/live_bg_white_r10_a05"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <com.p051p1.mobile.putong.p070ui.datepicker.p072ex.WheelSecondView
            android:layout_gravity="center"
            android:id="@+id/wheel_pick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </p151v.VFrame>
</androidx.constraintlayout.widget.ConstraintLayout>
