<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common"
    holder="chatmanager.ChatManagerDialog">
    <View
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/live_bg_white_tr24"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/chat_manager_title"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/LIVE_SPEAK_MANAGER"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            ignore="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#ff3a00"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/save"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:text="@string/ACTION_SAVE"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:id="@+id/who_can_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LIVE_WHO_CAN_SPEAK"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chat_manager_title"
            ignore="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/jailed_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/who_can_chat"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:id="@+id/shielding_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/LIVE_NOTE_OF_BLOCK_KEYWORDS_NEW"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/jailed_list"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#999999"
            android:id="@+id/shielding_word_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/LIVE_NOTE_OF_HAS_KEYWORDS"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shielding_word"
            ignore="true"/>
        <LinearLayout
            android:id="@+id/shielding_layout"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shielding_word_note"
            flatten="true">
            <p151v.VButton
                android:enabled="true"
                android:id="@+id/add_shielding_words_bt"
                android:background="@drawable/live_selector_chat_manager_add_shielding_words"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/shielding_list"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
        <p151v.VEditText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#212121"
            android:gravity="start|bottom"
            android:id="@+id/new_input"
            android:background="@null"
            android:paddingBottom="14dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:minWidth="72dp"
            android:hint="@string/LIVE_CHAT_MAXIMUM_LENGTH"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:imeActionLabel="@string/LIVE_BUTTON_FINISH"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shielding_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
