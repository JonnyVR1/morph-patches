<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.item.PrivilegeDescListPrivateCustomExtraItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    flatten="true"
    holder="vip.privilege.content.item.PrivilegeDescListPrivateCustomExtraItem">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/core_color_40percent_000000"
        android:gravity="center_vertical"
        android:id="@+id/title_txt"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/top_info_ic"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="2dp"
        android:src="0x7f081392"
        app:layout_constraintLeft_toRightOf="@+id/title_txt"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="39dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <ImageView
            android:id="@+id/privilege_ic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="21dp"
            android:src="0x7f081396"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#8c5b1a"
            android:gravity="center_vertical"
            android:id="@+id/price_txt"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="37dp"
            android:layout_marginRight="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#e8cb8c"
            android:gravity="center_vertical"
            android:id="@+id/buy_btn"
            android:background="@drawable/core_privilege_desc_private_custom_but_btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="16dp"
            android:text="立即解锁"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/core_color_80percent_000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/content_title_txt"
            android:layout_width="0dp"
            android:layout_height="21dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="13dp"
            android:text="私人定制特权"
            android:maxLines="1"
            app:layout_constraintLeft_toRightOf="@+id/privilege_ic"
            app:layout_constraintRight_toLeftOf="@+id/price_txt"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/core_color_40percent_000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/content_info_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="根据定制需求实时推送，开启专属社交体验"
            android:maxLines="2"
            app:layout_constraintLeft_toLeftOf="@+id/content_title_txt"
            app:layout_constraintRight_toRightOf="@+id/content_title_txt"
            app:layout_constraintTop_toBottomOf="@+id/content_title_txt"/>
        <p151v.VRecyclerView
            android:id="@+id/custom_list"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/content_border"
        android:background="@drawable/core_privilege_desc_private_custom_content_bg_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintLeft_toLeftOf="@+id/content"
        app:layout_constraintRight_toRightOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <ImageView
        android:id="@+id/check_ic"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="7dp"
        android:src="0x7f081390"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.p058ui.vip.privilege.content.item.PrivilegeDescListPrivateCustomExtraItem>
