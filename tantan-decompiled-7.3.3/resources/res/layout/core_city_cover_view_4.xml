<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.dlg.views.CityCoverView4 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/city_cover_view_4"
    android:paddingTop="42dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="ture"
    holder="dlg.views.CityCoverView4">
    <include
        android:id="@+id/city_cover_small_card_view"
        layout="@layout/core_city_cover_small_card_view"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/core_color_FFDB89"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="23dp"
        android:maxLines="1"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/core_color_40percent_FFFFFF"
        android:gravity="center"
        android:id="@+id/discount_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#212121"
        android:gravity="center"
        android:id="@+id/btn_submit"
        android:background="@drawable/core_city_cover_buttom_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="47dp"
        android:text="下一步"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</com.p051p1.mobile.putong.core.p058ui.dlg.views.CityCoverView4>
