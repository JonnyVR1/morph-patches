<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.intlmeet.likers.items.IntlMeetFakeLikersItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    app:sl_cornerRadius="0dp"
    app:sl_shadowColor="#00000000"
    app:sl_shadowRadius="0dp"
    folder="newui"
    holder="intlmeet.likers.items.IntlMeetFakeLikersItem">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="@dimen/core_vip_normal_card_corner"
        style="@style/core_fresco_base"/>
    <p151v.VLinear
        android:id="@+id/super_like_tag_ll"
        android:background="@drawable/core_intl_see_superlike_tag_bg"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:paddingVertical="3dp"
        flatten="true">
        <p151v.VText
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/super_like_tag_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <p151v.VImage
            android:id="@+id/superlike_tag_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080c43"/>
    </p151v.VLinear>
    <View
        android:background="@drawable/fakelikers_head_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fra_desc"
        android:background="@drawable/core_vip_superlike_game_item_shadaow"
        android:layout_width="match_parent"
        android:layout_height="93dp"
        flatten="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <FrameLayout
                android:id="@+id/info"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginBottom="1dp"
                app:layout_constraintBottom_toTopOf="@+id/desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                flatten="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="20dp">
                    <p151v.VText_NoTopPadding
                        android:textSize="14sp"
                        android:textColor="#e5ffffff"
                        android:ellipsize="end"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/see_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"
                        app:fontWeight="500"/>
                    <p151v.VText_NoTopPadding
                        android:textSize="14sp"
                        android:textColor="#e5ffffff"
                        android:ellipsize="end"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/see_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="3dp"
                        app:fontWeight="500"/>
                    <p151v.VImage
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/verification_icon"
                        android:background="0x7f082957"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"/>
                    <Space
                        android:layout_width="40dp"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <View
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/mask_name"
                    android:background="@drawable/core_intl_see_name_mask_bg"
                    android:visibility="visible"
                    android:layout_width="100dp"
                    android:layout_height="20dp"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                flatten="true">
                <p151v.VImage
                    android:id="@+id/user_desc_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/user_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
            <View
                android:id="@+id/mask_desc"
                android:background="@drawable/core_intl_see_item_desc_mask"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/desc"
                app:layout_constraintLeft_toLeftOf="@+id/desc"
                app:layout_constraintRight_toRightOf="@+id/desc"
                app:layout_constraintTop_toTopOf="@+id/desc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.intlmeet.likers.items.IntlMeetFakeLikersItem>
