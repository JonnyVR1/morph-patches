<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="#ededed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="messages.redpacket.SendRedPacketViewModel">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/lucky_packet_btn"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/CHAT_GROUP_GOOD_LUCK_RED_PACKET"
            android:layout_weight="1"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:gravity="center"
            android:id="@+id/normal_packet_btn"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/CHAT_GROUP_NORMAL_RED_PACKET"
            android:layout_weight="1"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#f15645"
        android:gravity="center"
        android:id="@+id/banner"
        android:background="#f3d497"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@drawable/core_message_opti_delete_btn_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="16dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:gravity="center_vertical"
            android:id="@+id/money_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:drawablePadding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/money_title"
            app:layout_constraintRight_toLeftOf="@+id/yuan"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#bfbfbf"
                android:gravity="center"
                android:id="@+id/input_money_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"
                android:text="0.00"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#212121"
                android:gravity="center"
                android:id="@+id/input_money"
                android:background="@null"
                android:paddingRight="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="numberDecimal"
                android:textCursorDrawable="@drawable/cursor_style"/>
        </RelativeLayout>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:id="@+id/yuan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CHAT_GROUP_YUAN"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@drawable/core_message_opti_delete_btn_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:id="@+id/number_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/CHAT_GROUP_NUMBER_OF_RED_PACKET"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/number_title"
            app:layout_constraintRight_toLeftOf="@+id/ge"
            app:layout_constraintTop_toTopOf="parent">
            <p151v.VText
                android:textSize="16sp"
                android:textColor="#bfbfbf"
                android:gravity="center"
                android:id="@+id/input_number_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"
                android:text="@string/CHAT_GROUP_SIGN_NUMBER"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <p151v.VEditText
                android:textSize="16sp"
                android:textColor="#212121"
                android:gravity="center"
                android:id="@+id/input_number"
                android:background="@null"
                android:paddingRight="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLength="3"
                android:inputType="number"
                android:textCursorDrawable="@drawable/cursor_style"/>
        </RelativeLayout>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#212121"
            android:id="@+id/ge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CHAT_GROUP_RED_PACKET_SINGLE_NUMBER"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#bfbfbf"
        android:id="@+id/people"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="4dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@drawable/core_message_opti_delete_btn_bg"
        android:paddingLeft="12dp"
        android:paddingTop="15dp"
        android:paddingRight="12dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#bfbfbf"
            android:id="@+id/input_words"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CHAT_GROUP_GOOD_LUCK"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp">
        <p151v.VText
            android:textSize="40sp"
            android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥"/>
        <p151v.VText
            android:textSize="40sp"
            android:textColor="#212121"
            android:id="@+id/money_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="0.00"
            app:typeface="medium"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="19sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/send_btn"
        android:background="@drawable/core_send_red_packet_btn_bg"
        android:layout_width="180dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/CHAT_GROUP_PUT_MONEY_INTO_RED_PACKET"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#808080"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/bottom_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"/>
    </LinearLayout>
</LinearLayout>
