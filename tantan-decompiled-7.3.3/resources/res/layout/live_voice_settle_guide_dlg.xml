<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true"
    app:flatten="true">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/room_avatars"
        android:background="@drawable/live_vector_default_avatar_bg"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.p051p1.mobile.putong.live.base.view.LiveMainlandTagView
        android:id="@+id/live_tag"
        android:background="@drawable/live_shape_settle_guide_svga_bg"
        android:layout_width="21dp"
        android:layout_height="15dp"
        android:layout_marginTop="45dp"
        app:layout_constraintEnd_toEndOf="@+id/room_avatars"
        app:layout_constraintStart_toStartOf="@+id/room_avatars"
        app:layout_constraintTop_toTopOf="@+id/room_avatars"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="left"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="入驻本群，一起玩吧"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/tag_layout"
        app:layout_constraintStart_toEndOf="@+id/room_avatars"
        app:layout_constraintTop_toTopOf="@+id/room_avatars"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tag_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/room_avatars"
        app:layout_constraintStart_toEndOf="@+id/room_avatars"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/settle_start"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="52dp"
        android:layout_height="34dp"
        android:text="入驻"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/room_avatars"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/room_avatars"/>
</androidx.constraintlayout.widget.ConstraintLayout>
