<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="internal.live.square"
    holder="fragments.videochat.LiveVideoChatFragViewModel">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/page_title_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <p151v.VFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VPullDownRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:srlEnableLoadMore="false"
            flatten="true">
            <p151v.VRecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                useId="true"/>
        </p151v.VPullDownRefreshLayout>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp"
            layout="@layout/live_list_empty_error_view"/>
        <include
            android:layout_gravity="bottom|right"
            android:id="@+id/random_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            layout="@layout/live_square_video_chat_random_entry_view"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/start_video_chat"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:text="开启闪聊"/>
    </p151v.VFrame>
</p151v.VLinear>
