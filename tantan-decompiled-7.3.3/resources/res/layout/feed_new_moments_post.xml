<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    folder="newui"
    holder="mediapicker.post.NewPostViewModel">
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header_ll"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <p151v.VImage
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:src="0x7f081e4d"
            android:scaleType="centerCrop"/>
        <com.p051p1.mobile.putong.feed.newui.mediapicker.post.state.FeedMomentPostStatusView
            android:id="@+id/state_select_layout"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/send"
            android:background="@drawable/feed_post_moment_unenable_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginRight="12dp"
            android:text="@string/FEED_RELEASE_NEW"
            android:drawableRight="0x7f081e69"
            android:drawablePadding="7dp"/>
    </p151v.VLinear>
    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VScroll
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/top_scroll"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/new_post_bottom_height"
            flatten="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="20dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <com.p051p1.mobile.putong.feed.newui.mediapicker.post.FeedEditText
                    android:textSize="16sp"
                    android:textColor="@color/common_black_02"
                    android:textColorHint="@color/feed_33000000"
                    android:gravity="top|left"
                    android:id="@+id/edit_field"
                    android:background="@null"
                    android:paddingLeft="20dp"
                    android:paddingTop="16dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="20dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/FEED_POST_HINT"
                    android:minLines="3"
                    android:maxLength="2000"
                    android:lineSpacingExtra="5dp"
                    android:inputType="textMultiLine"
                    app:typeface="medium"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/recycler_ll"
                    android:focusableInTouchMode="true"
                    android:clipChildren="false"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginStart="20dp"
                    flatten="true">
                    <View
                        android:id="@+id/post_tips_target"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:layout_marginLeft="31dp"
                        android:layout_marginStart="31dp"/>
                    <com.p051p1.mobile.putong.feed.newui.mediapicker.post.view.FeedPostMediaRecyclerView
                        android:id="@+id/images"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-3dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="16dp"/>
                    <RelativeLayout
                        android:id="@+id/record_audio_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginBottom="16dp"
                        flatten="false">
                        <com.p051p1.mobile.putong.feed.newui.view.FeedAudioPlayerView
                            android:id="@+id/record_audio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"/>
                        <p151v.VImage
                            android:id="@+id/audio_record_delete"
                            android:padding="11dp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="0x7f081d16"
                            android:layout_toRightOf="@+id/record_audio"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <include
                        android:id="@+id/feed_share_link_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginRight="56dp"
                        android:layout_marginBottom="16dp"
                        layout="@layout/feed_share_link"/>
                    <org.apmem.tools.layouts.FlowLayout
                        android:id="@+id/selected_topics"
                        android:focusableInTouchMode="true"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"/>
                    <p151v.VLinear
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/location_ll"
                        android:background="@drawable/feed_post_bg_text_location"
                        android:paddingRight="8dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginRight="40dp"
                        android:layout_marginBottom="16dp"
                        flatten="false">
                        <p151v.VImage
                            android:id="@+id/location_iv"
                            android:paddingLeft="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f081dec"
                            android:scaleType="center"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="@color/common_grey_09"
                            android:gravity="center_vertical"
                            android:id="@+id/location"
                            android:paddingRight="2dp"
                            android:focusable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:maxWidth="260dp"
                            android:singleLine="true"/>
                        <p151v.VImage
                            android:id="@+id/location_close"
                            android:paddingLeft="2dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f081e67"
                            android:scaleType="center"/>
                    </p151v.VLinear>
                    <p151v.VLinear
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/location_new_ui_ab_ll"
                        android:background="@drawable/feed_post_bg_text_location_new_ui_ab"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginRight="40dp"
                        android:layout_marginBottom="16dp"
                        flatten="false">
                        <p151v.VImage
                            android:id="@+id/location_new_ui_ab_iv"
                            android:paddingLeft="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f081ded"
                            android:scaleType="center"/>
                        <p151v.VText
                            android:textSize="12sp"
                            android:textColor="@color/common_exp_black_03"
                            android:gravity="center_vertical"
                            android:id="@+id/location_new_ui_ab"
                            android:focusable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginLeft="2dp"
                            android:maxWidth="260dp"
                            android:singleLine="true"/>
                        <p151v.VImage
                            android:id="@+id/location_new_ui_ab_close"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:src="0x7f081e68"
                            android:scaleType="center"/>
                    </p151v.VLinear>
                    <RelativeLayout
                        android:id="@+id/feed_forward_setting_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        flatten="true">
                        <p151v.VCheckBox
                            android:id="@+id/forward_check_box"
                            android:checked="false"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            style="@style/common_checkbox"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textColor="@color/feed_cc000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="允许他人转发"
                            android:layout_toRightOf="@+id/forward_check_box"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </p151v.VScroll>
        <p151v.VText
            android:id="@+id/alert_text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            style="@style/edit_text_indicator"/>
        <com.p051p1.mobile.putong.feed.newui.mediapicker.post.bottom.FeedPostBottomView
            android:layout_gravity="bottom"
            android:id="@+id/post_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/topic_search_container"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/chat_question_container"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</p151v.VLinear>
