<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="home.virtualcard.BarLoverGuideCardAdapter">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f08047f"
        android:scaleType="centerCrop"/>
    <View
        android:background="@drawable/core_bar_lover_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:background="0x7f08047e"
        android:layout_width="match_parent"
        android:layout_height="212dp"/>
    <p151v.VLinear
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp">
        <p151v.VFrame
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <View
                android:layout_gravity="bottom"
                android:background="0x7f08200a"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <p151v.VText
                android:textSize="24sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_gravity="bottom"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="38dp"
                android:layout_marginBottom="1dp"
                android:text="都市酒鬼爱人"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.5dp"
            android:text="“猜我喜欢”，不如把酒言欢。滑个酒友，一起天长“递酒”！"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/core_white_bg_12dp_radius"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="去看看"/>
    </p151v.VLinear>
</androidx.cardview.widget.CardView>
