<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <View
        android:id="@+id/circle"
        android:background="@drawable/live_shape_bg_loading_image_circle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"/>
    <View
        android:background="@drawable/live_shape_bg_loading_rect"
        android:layout_width="144dp"
        android:layout_height="14dp"
        android:layout_alignTop="@+id/circle"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/circle"/>
    <View
        android:background="@drawable/live_shape_bg_loading_rect"
        android:layout_width="144dp"
        android:layout_height="14dp"
        android:layout_alignBottom="@+id/circle"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/circle"/>
</RelativeLayout>
