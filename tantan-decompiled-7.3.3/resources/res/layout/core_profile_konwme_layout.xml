<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personality_frame"
    flatten="true"
    holder="profile.profilelist.itemholders.ProfileKnowMeItemHolder"
    style="@style/profile_item_frame_no_padding">
    <p151v.VText
        android:textSize="18dp"
        android:textStyle="normal"
        android:textColor="#e6000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:text="我的社交性格"/>
    <p151v.VText
        android:textSize="13dp"
        android:textStyle="normal"
        android:textColor="#cccccc"
        android:gravity="center"
        android:id="@+id/arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:text="查看匹配度"
        android:drawableRight="0x7f080d1b"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:id="@+id/item_layout"
        android:background="@drawable/core_knowme_profile_item_bingshanweishiji"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/title">
        <ImageView
            android:id="@+id/item_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:src="0x7f080d1f"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_toRightOf="@+id/item_icon"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#cc000000"
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="normal"
                android:textColor="#4c000000"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/core_knowme_profile_item_btn_layout"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginRight="12dp"
            android:text="去测试"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:paddingHorizontal="12dp"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/personal_score_layout"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/item_layout">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="#e6000000"
                android:id="@+id/move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="行动温度"/>
            <FrameLayout
                android:id="@+id/progress_move_layout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="20dp"
                android:layout_toRightOf="@+id/move"
                android:layout_alignParentRight="true"
                flatten="true">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/core_knowme_profile_item_personal_bg"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_toRightOf="@+id/move"
                    android:layout_alignParentRight="true"/>
                <View
                    android:id="@+id/progress_move"
                    android:background="@drawable/core_knowme_profile_item_personal_bg_progress"
                    android:layout_width="12dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="150dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="被动"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="主动"/>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="#e6000000"
                android:id="@+id/sweet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="性格甜度"/>
            <FrameLayout
                android:id="@+id/progress_sweet_layout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="20dp"
                android:layout_toRightOf="@+id/sweet"
                android:layout_alignParentRight="true"
                flatten="true">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/core_knowme_profile_item_personal_bg"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_toRightOf="@+id/move"
                    android:layout_alignParentRight="true"/>
                <View
                    android:id="@+id/progress_sweet"
                    android:background="@drawable/core_knowme_profile_item_personal_bg_progress"
                    android:layout_width="12dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="150dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="严谨"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="有趣"/>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="#e6000000"
                android:id="@+id/alcohol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="酒精浓度"/>
            <FrameLayout
                android:id="@+id/progress_alcohol_layout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="20dp"
                android:layout_toRightOf="@+id/alcohol"
                android:layout_alignParentRight="true"
                flatten="true">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/core_knowme_profile_item_personal_bg"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_toRightOf="@+id/move"
                    android:layout_alignParentRight="true"/>
                <View
                    android:id="@+id/progress_alcohol"
                    android:background="@drawable/core_knowme_profile_item_personal_bg_progress"
                    android:layout_width="12dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="150dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="安稳"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#66000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="洒脱"/>
            </FrameLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
