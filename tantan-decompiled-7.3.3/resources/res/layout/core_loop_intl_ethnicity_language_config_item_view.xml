<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/config_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    flatten="true"
    holder="profile.loop.ethnicitylanguage.ProfileLoopEthnicityLanguageAdapter">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#cc000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/key_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:typeface="medium"/>
    <View
        android:textColor="@color/common_grey_02"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/selected_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
</p151v.VFrame>
