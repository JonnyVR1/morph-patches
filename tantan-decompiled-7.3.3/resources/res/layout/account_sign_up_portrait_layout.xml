<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VImage
        android:id="@+id/sign_up_top_icon"
        android:layout_width="138dp"
        android:layout_height="120dp"
        android:src="0x7f080207"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="24dp"
        android:textColor="@color/black"
        android:id="@+id/sign_up_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="116dp"
        android:layout_marginRight="40dp"
        android:text="最后，上传一张本人五官清晰的正面照"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/sign_up_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="40dp"
        android:text="正确照片上传示例"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_title"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/sign_up_pic_sample"
        android:layout_width="220dp"
        android:layout_height="85dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="@+id/sign_up_desc"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_desc"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_000000_20"
        android:gravity="center"
        android:id="@+id/sign_up_portrait_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="上传照片"
        android:drawableTop="0x7f080229"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_portrait_btn"
        app:layout_constraintEnd_toEndOf="@+id/sign_up_portrait_btn"
        app:layout_constraintStart_toStartOf="@+id/sign_up_portrait_btn"
        app:layout_constraintTop_toTopOf="@+id/sign_up_portrait_btn"/>
    <View
        android:id="@+id/sign_up_portrait_btn"
        android:background="@drawable/account_signup_portrait"
        android:layout_width="160dp"
        android:layout_height="217dp"
        android:layout_marginTop="40dp"
        android:drawableTop="0x7f080229"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_pic_sample"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="@color/common_orange_v2"
        android:gravity="center"
        android:id="@+id/sign_up_portrait_text_shader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="上传照片"
        android:drawableTop="0x7f08022a"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_portrait_btn"
        app:layout_constraintEnd_toEndOf="@+id/sign_up_portrait_btn"
        app:layout_constraintStart_toStartOf="@+id/sign_up_portrait_btn"
        app:layout_constraintTop_toTopOf="@+id/sign_up_portrait_btn"/>
    <View
        android:id="@+id/sign_up_portrait_btn_shader"
        android:background="@drawable/account_signup_portrait_shader"
        android:layout_width="160dp"
        android:layout_height="217dp"
        android:layout_marginTop="40dp"
        android:drawableTop="0x7f080229"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_pic_sample"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/sign_up_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="至少上传一张，才能使用探探"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/sign_up_tip_icon"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_portrait_btn"/>
    <p151v.VImage
        android:id="@+id/sign_up_tip_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f0829f9"
        android:scaleType="fitCenter"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/sign_up_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sign_up_tips"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/sign_up_tip_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="40dp"
        android:text="我们要求用户提供真实照片来保证平台和用户安全"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sign_up_tip_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
