<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.poi.view.FeedPoiNearbyUsesEnterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="photoalbum.poi.view.FeedPoiNearbyUsesEnterView">
    <RelativeLayout
        android:id="@+id/nearby_uses_enter_content"
        android:background="0x7f081e28"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="20dp"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/user_icon"
            android:layout_width="45dp"
            android:layout_height="60dp"
            android:layout_marginLeft="12dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/feed_fresco_placeholder_bg_newui"
            app:placeholderImage="@drawable/feed_fresco_placeholder_bg_newui"
            app:roundedCornerRadius="8dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@+id/post"
            android:layout_toRightOf="@+id/user_icon"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/feed_cc000000"
                android:ellipsize="end"
                android:id="@+id/poi_nearby_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="附近留下足迹的人"
                android:maxLines="1"/>
            <p151v.VLinear_FillerMeasure
                android:gravity="left"
                android:orientation="horizontal"
                android:id="@+id/poi_nearby_guide_info_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:fillerIndex="0"
                flatten="true">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/feed_66000000"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/feed_66000000"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/user_location_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </p151v.VLinear_FillerMeasure>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feed_fe7e1d"
            android:gravity="center"
            android:id="@+id/post"
            android:background="@drawable/feed_bg_white_round_corner_10"
            android:layout_width="53dp"
            android:layout_height="34dp"
            android:layout_marginRight="12dp"
            android:text="查看"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/bottom_space_correct_view"
        android:layout_width="0dp"
        android:layout_height="6dp"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.poi.view.FeedPoiNearbyUsesEnterView>
