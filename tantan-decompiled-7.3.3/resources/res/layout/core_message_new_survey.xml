<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.view.ItemMessageNewSurvey xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="ui"
    holder="messages.view.ItemMessageNewSurvey">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main"
        android:background="@drawable/core_message_survey_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#222222"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            flatten="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/top_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            app:layout_constraintTop_toBottomOf="@+id/title"
            flatten="true"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:id="@+id/content"
            android:background="#99f7f7f7"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/top_linear"
            flatten="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/commit"
            android:background="@drawable/core_message_survey_commit_bg"
            android:layout_width="160dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/submit"
            flatten="true"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#999999"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/other_text"
        android:paddingLeft="20dp"
        android:paddingTop="6dp"
        android:paddingRight="20dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.p051p1.mobile.putong.core.p058ui.messages.view.ItemMessageNewSurvey>
