<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
        android:textSize="15dp"
        android:textColor="@color/common_000000_40"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="认证权益"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/privilege_v1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <p151v.VImage
                android:id="@+id/icon_1"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                app:srcCompat="@drawable/core_avatar_success_id_detail_ic1"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                    android:textSize="15dp"
                    android:textColor="@color/common_000000_80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="获得认证标识"/>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/common_000000_40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="个人资料上会显示实名 · 头像本人标识"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <p151v.VImage
                android:id="@+id/icon_2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/core_avatar_success_id_detail_ic2"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                    android:textSize="15dp"
                    android:textColor="@color/common_000000_80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="只看认证用户特权"/>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/common_000000_40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="划卡时可以筛选完成头像本人认证的用户"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <p151v.VImage
                android:id="@+id/icon_3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/core_avatar_success_id_detail_ic3"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
                    android:textSize="15dp"
                    android:textColor="@color/common_000000_80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统优先推荐"/>
                <p151v.VText
                    android:textSize="13dp"
                    android:textColor="@color/common_000000_40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="系统会优先把你推荐给其他用户"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VLinear>
</androidx.appcompat.widget.LinearLayoutCompat>
