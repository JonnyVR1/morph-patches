<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="moments.MomentsInProfilePreviewAct">
    <p151v.VPager
        android:id="@+id/pager"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/content"
        android:paddingLeft="16dp"
        android:paddingTop="2dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/caption"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:isScrollContainer="false"
            app:typeface="regular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/comment_frame"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/comment"
                android:background="@drawable/moments_in_profile_preview_button_rounded"
                android:layout_width="98dp"
                android:layout_height="34dp"
                android:layout_marginRight="8dp">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#b2ffffff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/MOMENTS_BUTTON_COMMENT_TITLE"
                    android:drawableLeft="0x7f082900"
                    android:drawablePadding="6dp"
                    app:typeface="medium"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/like"
                android:background="@drawable/moments_in_profile_preview_button_rounded"
                android:layout_width="98dp"
                android:layout_height="34dp"
                flatten="true">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/like_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:src="0x7f082901"
                        android:scaleType="fitCenter"/>
                    <p151v.VText
                        android:textSize="12sp"
                        android:textColor="#b2ffffff"
                        android:layout_gravity="center_vertical"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="@string/MOMENTS_BUTTON_LIKE_TITLE"
                        app:typeface="medium"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VFrame
                    android:layout_gravity="center"
                    android:id="@+id/comments_detail"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableLeft="0x7f0828ed"
                        android:drawablePadding="6dp"
                        app:typeface="medium"/>
                    <p151v.VImage_Squared
                        android:layout_gravity="center"
                        android:background="@drawable/tf_circle_bounded_dark"
                        android:duplicateParentState="true"
                        android:layout_width="48dp"
                        android:layout_height="48dp"/>
                </p151v.VFrame>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
