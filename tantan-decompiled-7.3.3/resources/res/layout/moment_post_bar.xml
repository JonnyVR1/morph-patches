<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.newui.photoalbum.MomentPostBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    flatten="true"
    folder="newui"
    holder="photoalbum.MomentPostBar">
    <p151v.VText
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/moment_upload_audio_time"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="12dp"
        fresco:typeface="medium"/>
    <p151v.VDraweeView
        android:layout_gravity="center"
        android:id="@+id/moment_upload_image"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="12dp"
        fresco:roundedCornerRadius="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#2c2c2c"
        android:layout_gravity="center"
        android:id="@+id/moment_upload_state"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="54dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/moment_upload_retry"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginRight="46dp"
        android:src="0x7f0828e8"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/moment_upload_delete"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginRight="2dp"
        android:src="0x7f0828e5"/>
    <ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/moment_upload_progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="500"
        android:progress="0"
        android:progressDrawable="@drawable/moment_upload_progress"
        style="?android:attr/progressBarStyleHorizontal"/>
</com.p051p1.mobile.putong.feed.newui.photoalbum.MomentPostBar>
