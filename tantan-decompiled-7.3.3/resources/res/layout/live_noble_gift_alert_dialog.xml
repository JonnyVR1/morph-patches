<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.noble.NobleAttentionDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="increment.noble.NobleAttentionDialogView">
    <View
        android:id="@+id/empty_view"
        android:background="@color/live_black_40_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg"
        android:background="@drawable/live_bg_white_r20"
        android:layout_width="311dp"
        android:layout_height="348dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/avatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"
        app:roundAsCircle="true"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="@color/live_black_80_opacity"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/LIVE_NOBLE_CAN_NOT_REACH_MARQUESS"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_40_opacity"
        android:gravity="center"
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/LIVE_NOBLE_CAN_NOT_REACH_MARQUESS_SUMMARY"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/see"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/LIVE_NOBLE_SEE_IMMEDIATELY"
        android:maxLines="1"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/summary"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_black_20_opacity"
        android:gravity="center"
        android:id="@+id/leave"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LIVE_NOBLE_CRUEL_LEAVE"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/see"/>
</com.p051p1.mobile.putong.live.livingroom.increment.noble.NobleAttentionDialogView>
