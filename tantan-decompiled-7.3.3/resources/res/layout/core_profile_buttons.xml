<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/like_and_dislike_refactor"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginBottom="3dp"
    flatten="true"
    holder="profile.holders.ProfileButtons"
    needPublic="true">
    <p151v.VFrame_Shadow
        android:id="@+id/dislike_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_toLeftOf="@+id/superlike_shadow"
        android:layout_alignParentBottom="true"
        app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
        app:sl_dy="@dimen/core_profile_bottom_dy"
        app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
        app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/dislike"
            android:background="@drawable/core_newui_profile_btn_dislike_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/core_newui_profile_dislike"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </p151v.VFrame_Shadow>
    <p151v.VText
        android:id="@+id/superlike_popup"
        android:background="0x7f082982"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/superlike_shadow"
        android:layout_centerHorizontal="true"/>
    <p151v.VFrame_Shadow
        android:id="@+id/superlike_shadow"
        android:background="@drawable/core_newui_profile_btn_superlike_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
        app:sl_dy="@dimen/core_profile_bottom_dy"
        app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
        app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
        flatten="true">
        <p151v.VFrame_FlipContainer
            android:layout_gravity="center"
            android:id="@+id/superlike"
            android:background="@drawable/core_newui_profile_btn_superlike_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:mainChildIndex="0"
            app:otherChildIndex="1"
            flatten="true">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/superlike_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/core_newui_profile_superlike"
                android:layout_centerInParent="true"/>
            <p151v.VText
                android:textSize="22sp"
                android:textColor="#00adff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/superlike_turn_tv"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32"
                app:typeface="medium"/>
        </p151v.VFrame_FlipContainer>
    </p151v.VFrame_Shadow>
    <p151v.VFrame_Shadow
        android:id="@+id/like_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="30dp"
        android:layout_toRightOf="@+id/superlike_shadow"
        android:layout_alignParentBottom="true"
        app:sl_cornerRadius="@dimen/core_profile_bottom_cornerRadius"
        app:sl_dy="@dimen/core_profile_bottom_dy"
        app:sl_shadowColor="@color/core_profile_bottom_shadow_color"
        app:sl_shadowRadius="@dimen/core_profile_bottom_shadowRadius"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/like"
            android:background="@drawable/core_newui_profile_btn_like_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <p151v.VImage
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/core_newui_profile_like"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </p151v.VFrame_Shadow>
</RelativeLayout>
