<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.aialbum.view.AiAlbumPickerItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:padding="4dp"
    android:layout_width="86dp"
    android:layout_height="108dp"
    flatten="true"
    folder="ui"
    holder="aialbum.view.AiAlbumPickerItemView">
    <p151v.VDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="10dp"/>
    <ImageView
        android:id="@+id/mengban_iv"
        android:background="@drawable/core_ai_album_mengban"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/state_iv"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_margin="8dp"
        android:src="0x7f080418"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</com.p051p1.mobile.putong.core.p058ui.aialbum.view.AiAlbumPickerItemView>
