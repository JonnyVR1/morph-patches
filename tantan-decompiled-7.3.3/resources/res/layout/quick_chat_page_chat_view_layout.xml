<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    attachToRoot="true"
    holder="quickaudio.newquickchat.secondfloor.item.QuickChatLoftChatItem">
    <p151v.VFrame
        android:layout_gravity="center"
        android:id="@+id/rootView"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.tantan.library.svga.SVGAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/svg_anim"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/click_area"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <p151v.VLinear
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            flatten="true">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/header"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                flatten="true">
                <com.p051p1.mobile.putong.core.newui.messages.anim.view.widget.ImageXfermodeView
                    android:layout_gravity="center"
                    android:id="@+id/header_content"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    style="@style/core_im_fresco_profile_small"/>
                <p151v.VImage
                    android:layout_gravity="end|top"
                    android:background="@drawable/core_online_green_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="3dp"/>
            </FrameLayout>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="#66ffffff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineHeight="18.2dp"/>
            <p151v.VText
                android:textSize="18sp"
                android:textColor="#ccffffff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/describe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineHeight="25.2dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="#ccffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/button"
                android:paddingLeft="24dp"
                android:paddingTop="12dp"
                android:paddingRight="24dp"
                android:paddingBottom="12dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:lineHeight="19.6dp"/>
        </p151v.VLinear>
    </p151v.VFrame>
</merge>
