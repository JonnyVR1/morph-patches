<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_expanded_guide_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.VDraweeView
        android:id="@+id/swipe_guide_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:roundedCornerRadius="20dp"/>
    <p151v.VLinear
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <p151v.VImage
            android:layout_width="80dp"
            android:layout_height="75dp"
            app:srcCompat="@drawable/core_expanded_guide_right_ic"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="18dp"
            android:textColor="#ffffff"
            android:id="@+id/right_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="若对方也喜欢你，即可配对聊天"/>
    </p151v.VLinear>
</FrameLayout>
