<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/page_title_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VScroll
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#66000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="8dp"
                android:text="@string/LIVE_MLN_USER_FEEDBACK_ISSUE_DESCRIPTION"
                app:typeface="medium"/>
            <p151v.VEditText
                android:textSize="14sp"
                android:textColor="#cc000000"
                android:textColorHint="#33000000"
                android:gravity="top|left"
                android:id="@+id/desc_view"
                android:background="@drawable/live_feedback_edit_bg"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:hint="@string/LIVE_MLN_USER_FEEDBACK_ISSUE_DESCRIPTION_DEFALT"
                android:maxLength="500"
                android:textCursorDrawable="@drawable/live_shape_voice_top_notice_input_cursor_style"/>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#66000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/LIVE_MLN_USER_FEEDBACK_ISSUE_SCREENSHOT"
                app:typeface="medium"/>
            <p151v.VFrame
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp">
                <p151v.VDraweeView
                    android:id="@+id/add_pic_view"
                    android:layout_width="106dp"
                    android:layout_height="106dp"/>
                <p151v.VDraweeView
                    android:layout_gravity="top|right"
                    android:id="@+id/delete_button"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    app:roundedCornerRadius="10dp"/>
            </p151v.VFrame>
            <p151v.VText
                android:textSize="15sp"
                android:textColor="#66000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/LIVE_MLN_USER_FEEDBACK_CONTACT_INFORMATION"
                app:typeface="medium"/>
            <p151v.VEditText
                android:textSize="14sp"
                android:textColor="#cc000000"
                android:textColorHint="#33000000"
                android:gravity="center_vertical"
                android:id="@+id/contact_view"
                android:background="@drawable/live_feedback_edit_bg"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:hint="@string/LIVE_MLN_USER_FEEDBACK_CONTACT_INFORMATION_DEFALT"
                android:singleLine="true"
                android:maxLength="30"
                android:textCursorDrawable="@drawable/live_shape_voice_top_notice_input_cursor_style"/>
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="24dp">
                <p151v.VDraweeView
                    android:id="@+id/check_view"
                    android:layout_width="22dp"
                    android:layout_height="22dp"/>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="#4d000000"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:text="@string/LIVE_MLN_USER_FEEDBACK_LOG_UPLOAD"/>
            </p151v.VLinear>
        </p151v.VLinear>
    </p151v.VScroll>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_virtual_create_button_text_color"
        android:gravity="center"
        android:id="@+id/commit_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_MLN_USER_FEEDBACK_SUBMIT_BUTTON"
        android:layout_marginHorizontal="20dp"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#4d000000"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="36dp"
        android:text="@string/LIVE_MLN_USER_FEEDBACK_LOG_DISCLAIMER"/>
</p151v.VLinear>
