<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.LiveVoiceFeedCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/live_shape_feed_card_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="@dimen/live_square_item_base_margin"
    android:layout_marginEnd="@dimen/live_square_item_base_margin">
    <p151v.VDraweeView
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:layout_gravity="bottom"
        android:id="@+id/cover"
        android:background="@drawable/live_shape_bg_half_cover_new"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:layout_gravity="top|left"
        android:id="@+id/attribute_text"
        android:background="@drawable/live_bg_2f3659_r6_a35"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="bottom|left"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="61dp">
        <p151v.VDraweeView
            android:id="@+id/sub_title_image"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="2dp"/>
        <p151v.VMarqueeText
            android:textSize="10dp"
            android:textColor="@color/live_white_90_opacity"
            android:ellipsize="marquee"
            android:id="@+id/sub_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
    </p151v.VLinear>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:layout_gravity="bottom|left"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="32dp"
        android:maxLines="1"/>
    <include
        android:layout_gravity="bottom|left"
        android:id="@+id/avatar_number"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="8dp"
        layout="@layout/live_widget_avatar_number_view_new"/>
</com.p051p1.mobile.putong.live.base.arch.card.cardmodel.feed.LiveVoiceFeedCardView>
