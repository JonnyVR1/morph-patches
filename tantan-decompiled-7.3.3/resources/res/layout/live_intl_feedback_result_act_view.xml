<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/page_title_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"/>
    <p151v.VDraweeView
        android:id="@+id/result_pic"
        android:layout_width="311dp"
        android:layout_height="208dp"
        android:layout_marginTop="99dp"/>
    <p151v.VText
        android:textSize="18sp"
        android:textColor="#cc000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_MLN_USER_FEEDBACK_UPLOAD_SUCCESS"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#80000000"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:text="@string/LIVE_MLN_USER_FEEDBACK_UPLOAD_SUCCESS_DESCRIPTION"/>
</p151v.VLinear>
