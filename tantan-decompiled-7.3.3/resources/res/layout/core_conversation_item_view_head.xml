<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemHeadView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:id="@+id/head"
    android:clipChildren="false"
    android:layout_width="79dp"
    android:layout_height="66dp"
    folder="newui"
    holder="messages.itemview.ConversationItemHeadView">
    <com.p051p1.mobile.putong.core.newui.messages.LiveHaloAvatar
        android:layout_gravity="center"
        android:id="@+id/live_avatar"
        android:visibility="gone"
        android:layout_width="62dp"
        android:layout_height="62dp"
        app:avatarSize="47dp"
        app:haloSize="61dp"/>
    <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
        android:layout_gravity="center"
        android:id="@+id/image_big"
        android:clickable="true"
        android:layout_width="66dp"
        android:layout_height="66dp"
        app:show_audio_chat_frame="true"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/view_spotlight"
        android:background="@drawable/core_spotlight_im_circle"
        android:visibility="gone"
        android:layout_width="61dp"
        android:layout_height="61dp"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/lovebuzz_outer_ring"
        android:background="@drawable/core_intl_love_buzz_conv_item_outer_ring"
        android:visibility="gone"
        android:layout_width="55dp"
        android:layout_height="55dp"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/premium_outer_ring"
        android:background="0x7f080fba"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <com.p051p1.mobile.putong.core.newui.talk.view.NewTalkProgressView
        android:layout_gravity="center"
        android:id="@+id/liked_count_big"
        android:visibility="gone"
        android:layout_width="61dp"
        android:layout_height="61dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/image_icon_layout"
        android:layout_width="55dp"
        android:layout_height="55dp"
        flatten="true">
        <p151v.VImage
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/new_likes_red_dot"
            android:background="@drawable/core_match_reminder_bg"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"/>
        <p151v.VImage
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/core_kankan_red_dot"
            android:background="@drawable/core_kankan_red_dot_bg"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/chat_online_dot"
            android:background="@drawable/core_bg_chat_online_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="2dp"/>
        <p151v.VDraweeView
            android:layout_gravity="end|top"
            android:id="@+id/state"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="-7dp"
            android:layout_marginEnd="-5dp"
            app:roundAsCircle="true"
            style="@style/core_im_fresco_profile_small"/>
    </FrameLayout>
    <p151v.VImage
        android:id="@+id/chat_request_intl"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="4dp"
        android:src="0x7f080f27"
        android:minWidth="24dp"
        android:layout_marginStart="50dp"/>
    <p151v.VImage
        android:id="@+id/love_buzz_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="38dp"
        android:src="0x7f080af9"
        android:layout_marginStart="46dp"/>
    <FrameLayout
        android:layout_gravity="right"
        android:id="@+id/unread_layout"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        flatten="true">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/unread_text_icon"
            android:background="@drawable/core_bg_conversation_unread"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="24dp"
            android:text=""/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.messages.itemview.ConversationItemHeadView>
