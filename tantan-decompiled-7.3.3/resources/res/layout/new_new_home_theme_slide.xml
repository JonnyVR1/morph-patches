<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.themeslide.HomeThemeSlideViewModel"
    useRefId="true">
    <include
        android:id="@+id/location"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="65dp"
        layout="@layout/no_location_info"/>
    <include
        android:layout_gravity="top"
        android:id="@+id/home_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_home_card_title_layout"/>
    <p151v.VFrame
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        flatten="true">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/loading"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/core_card_loading_bg"/>
            <p151v.VFrame_Squared
                android:id="@+id/radar"
                android:layout_width="match_parent"
                android:layout_height="416dp"
                android:layout_centerInParent="true"
                android:translationY="-55dp">
                <com.p051p1.mobile.putong.core.p058ui.RadarRipple
                    android:id="@+id/ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <p151v.VDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:layout_width="@dimen/radar_image_size"
                    android:layout_height="@dimen/radar_image_size"
                    android:outlineSpotShadowColor="#19979797"
                    app:backgroundImage="@color/common_light_04"
                    app:roundingBorderPadding="3dp"
                    style="@style/core_fresco_profile_white_border"/>
            </p151v.VFrame_Squared>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_below="@+id/radar">
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/text_medium"
                    android:gravity="center_horizontal"
                    android:id="@+id/title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="28dp"
                    android:layout_marginBottom="4dp"
                    app:typeface="medium"/>
                <Space
                    android:id="@+id/empty_space"
                    android:visibility="gone"
                    android:layout_width="250dp"
                    android:layout_height="50dp"/>
                <p151v.VFrame
                    android:id="@+id/switcher"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>
                <p151v.VButton_FakeShadow
                    android:textColor="@color/white"
                    android:id="@+id/invite"
                    android:background="@drawable/rect_rounded_tantan_orange"
                    android:layout_marginTop="15dp"
                    android:text="@string/INVITE_FRIENDS"
                    app:vectorDrawableLeft="@drawable/nav_invite_ic"
                    style="@style/core_main_button_left_drawable"/>
            </LinearLayout>
        </RelativeLayout>
        <include
            android:id="@+id/empty_card"
            android:visibility="gone"
            layout="@layout/core_empty_card_layout_theme_slide"/>
        <p151v.VFrame
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:paddingLeft="8dp"
            android:paddingTop="12dp"
            android:paddingRight="8dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            flatten="true">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/buttons"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                flatten="true">
                <p151v.VFrame_FlipContainer
                    android:id="@+id/undo_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    app:mainChildIndex="0"
                    app:otherChildIndex="1"
                    flatten="true">
                    <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
                        android:id="@+id/undo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:iconPressStateColor="@color/white"
                        app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                        app:maxIconZoomRate="0.8"
                        app:normalStateIcon="0x7f08064c"
                        app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
                        app:pressedStateLayerBackground="@drawable/core_card_undo_button_bg_press"/>
                    <p151v.VText
                        android:textSize="20sp"
                        android:textColor="#ffbc00"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/undo_remaining"
                        android:visibility="invisible"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="99+"
                        app:typeface="medium"/>
                </p151v.VFrame_FlipContainer>
                <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
                    android:id="@+id/dislike"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    app:cob_iconStyle="small"
                    app:iconPressStateColor="@color/white"
                    app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                    app:maxIconZoomRate="0.8"
                    app:normalStateIcon="0x7f0805ae"
                    app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
                    app:pressedStateLayerBackground="@drawable/core_card_undo_button_bg_press"/>
                <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
                    android:id="@+id/like"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    app:cob_iconStyle="small"
                    app:iconPressStateColor="@color/white"
                    app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                    app:maxIconZoomRate="0.8"
                    app:normalStateIcon="0x7f0805cb"
                    app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
                    app:pressedStateLayerBackground="@drawable/core_card_like_button_press"/>
                <FrameLayout
                    android:id="@+id/superlike_layout_warp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    flatten="true">
                    <com.tantan.library.svga.SVGAnimationView
                        android:layout_gravity="center"
                        android:id="@+id/superlike_combo_svga"
                        android:layout_width="150dp"
                        android:layout_height="150dp"/>
                    <p151v.VFrame_FlipContainer
                        android:layout_gravity="center"
                        android:id="@+id/superlike_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:mainChildIndex="0"
                        app:otherChildIndex="1"
                        flatten="true">
                        <com.p051p1.mobile.putong.core.newui.home.views.CardOperationButton
                            android:id="@+id/superlike"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:iconPressStateColor="@color/white"
                            app:iconStateListAnimator="@animator/core_card_bottom_button_state_animator"
                            app:maxIconZoomRate="0.8"
                            app:normalStateIcon="0x7f080616"
                            app:normalStateLayerBackground="@drawable/core_card_button_bg_normal"
                            app:pressedStateLayerBackground="@drawable/core_card_superlike_button_press"/>
                        <p151v.VText
                            android:textSize="20sp"
                            android:textColor="#2bccff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/superlike_remaining"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="99+"
                            app:typeface="medium"/>
                    </p151v.VFrame_FlipContainer>
                </FrameLayout>
            </LinearLayout>
        </p151v.VFrame>
        <com.sunshine.engine.particle.SceneView
            android:id="@+id/full_scene"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/slide_tips"
            android:background="0x7f08294d"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"/>
        <com.sunshine.engine.particle.SceneView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/boost_heart_scene"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="135dp"/>
        <p151v.VDraweeView
            android:layout_gravity="end"
            android:id="@+id/prom_center"
            android:visibility="invisible"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_marginTop="54dp"
            android:layout_marginRight="5dp"
            app:placeholderImage="0x7f08097b"/>
        <p151v.VDraweeView
            android:layout_gravity="end|bottom"
            android:id="@+id/prom_bottom"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="54dp"
            android:layout_marginBottom="147dp"
            app:placeholderImage="0x7f08097a"/>
        <p151v.VText
            android:gravity="center"
            android:layout_gravity="top|left"
            android:id="@+id/undo_tip"
            android:background="0x7f08024f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"/>
        <p151v.VText
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/boost_tips"
            android:background="0x7f082939"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="5dp"
            android:text="@string/BOOST_CLICK_BUTTON_TIPS"/>
    </p151v.VFrame>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_us_profile"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_viewprofile"
            android:background="@drawable/core_bg_view_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="92dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            flatten="true"/>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/tv_viewprofile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/INTL_US_VIEWPROFILE"
            android:includeFontPadding="false"
            android:drawableRight="0x7f080795"
            android:drawablePadding="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_viewprofile"
            app:layout_constraintLeft_toLeftOf="@+id/view_viewprofile"
            app:layout_constraintRight_toRightOf="@+id/view_viewprofile"
            app:layout_constraintTop_toTopOf="@+id/view_viewprofile"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VLinear
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:id="@+id/buttons_us"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="27dp"
        flatten="true">
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/superlike_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="#2bccff"
            app:buttonColorStart="#2bccff"
            app:icon="0x7f08178b"
            app:iconWidth="25dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/like_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_like_end"
            app:buttonColorStart="@color/core_card_ic_us_like_start"
            app:icon="0x7f0820fb"
            app:iconWidth="25dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/dislike_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_dislike"
            app:buttonColorStart="@color/core_card_ic_us_dislike"
            app:icon="0x7f081a79"
            app:iconWidth="20dp"/>
        <com.p051p1.mobile.putong.core.p058ui.GradientBgButton
            android:id="@+id/undo_us"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:scaleType="centerInside"
            app:animationEnable="true"
            app:buttonColorEnd="@color/core_card_ic_us_undo"
            app:buttonColorStart="@color/core_card_ic_us_undo"
            app:icon="0x7f082a77"
            app:iconHeight="20dp"
            app:iconWidth="26dp"/>
    </p151v.VLinear>
    <include
        android:id="@+id/error_net_cover"
        android:visibility="gone"
        layout="@layout/core_home_net_error_layout_theme_slide"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/superlike_combo_anim_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_super_like_combo_anim_view"/>
</FrameLayout>
