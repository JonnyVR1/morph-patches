<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.fansclub.view.FansClubCompanyItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="123dp"
    android:layout_height="250dp"
    flatten="true"
    folder="common.fansclub"
    holder="view.FansClubCompanyItemView">
    <p151v.VImage
        android:id="@+id/normal_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="23dp"/>
    <p151v.VDraweeView
        android:id="@+id/gift"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#544e4f"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift"/>
    <p151v.VDraweeView
        android:id="@+id/center_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/center_text"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="#f07f8c"
        android:ellipsize="end"
        android:id="@+id/center_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:maxEms="5"
        app:layout_constraintLeft_toRightOf="@+id/center_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/live_white"
        android:gravity="center"
        android:id="@+id/to_company"
        android:layout_width="88dp"
        android:layout_height="30dp"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_icon"/>
    <p151v.VDraweeView
        android:id="@+id/bottom_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VImage
        android:id="@+id/lock_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="27dp"
        android:layout_marginTop="21dp"
        app:layout_constraintLeft_toLeftOf="@+id/bottom_icon"
        app:layout_constraintTop_toTopOf="@+id/bottom_icon"
        app:srcCompat="0x7f08229d"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:id="@+id/empty_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:text="@string/LIVE_FANS_CLUB_COMPANY_ENPTY_MORE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="11sp"
        android:textColor="#f07f8c"
        android:id="@+id/award_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/award_icon"
        android:layout_width="76dp"
        android:layout_height="18dp"
        android:scaleType="fitXY"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/award_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.common.fansclub.view.FansClubCompanyItemView>
