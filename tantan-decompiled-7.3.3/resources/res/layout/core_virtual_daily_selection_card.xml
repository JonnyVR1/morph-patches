<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.home.view.DailySelectionAdCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    holder="home.view.DailySelectionAdCardView">
    <p151v.VDraweeView
        android:background="@drawable/core_bg_virtual_daily_selection_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VDraweeView
        android:background="0x7f080768"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VLinear
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:src="0x7f08076b"/>
        <p151v.VLinear
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp">
            <p151v.VImage
                android:layout_width="16dp"
                android:layout_height="28dp"
                android:src="0x7f080769"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="24dp"
                android:textColor="#4e5a74"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每日精选"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <p151v.VImage
                android:layout_width="16dp"
                android:layout_height="28dp"
                android:src="0x7f08076a"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#7f88a2"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="28dp"
            android:text="全平台的优质男性都在等你去发现心仪的人"/>
        <com.p051p1.mobile.putong.core.p058ui.home.view.AutoScaleChildFrameLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <p151v.VFrame
                android:layout_gravity="center"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp">
                <p151v.VDraweeView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/introduce_icon"
                    android:layout_width="331dp"
                    android:layout_height="266dp"/>
            </p151v.VFrame>
        </com.p051p1.mobile.putong.core.p058ui.home.view.AutoScaleChildFrameLayout>
        <com.p051p1.mobile.putong.core.p058ui.VText_Bold
            android:textSize="16dp"
            android:textColor="#4e5a74"
            android:gravity="center"
            android:id="@+id/action_btn"
            android:background="@drawable/core_fake_dailog_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="40dp"
            android:text="去看看"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.home.view.DailySelectionAdCardView>
