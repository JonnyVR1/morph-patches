<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.VoiceCardFanBaseEnterView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_voice_fan_base_enter_view_bg"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    app:layout_gravity="center"
    folder="voice.intl"
    holder="fanbase.VoiceCardFanBaseEnterView">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/fan_base_rl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="0x7f082386"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#de53c4"
            android:gravity="center"
            android:id="@+id/num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_toRightOf="@+id/icon"
            android:inputType="number"/>
        <p151v.VMarqueeText
            android:textSize="10sp"
            android:textColor="#80de53c4"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/LIVE_VOICE_FUN_CLUB_ENTR"
            android:singleLine="true"
            android:layout_toRightOf="@+id/icon"
            android:layout_below="@+id/num"
            android:marqueeRepeatLimit="1"/>
    </RelativeLayout>
    <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
        android:id="@+id/svga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
</com.p051p1.mobile.putong.live.livingroom.voice.intl.fanbase.VoiceCardFanBaseEnterView>
