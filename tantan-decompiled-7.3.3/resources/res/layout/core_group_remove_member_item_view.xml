<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.group.GroupRemoveMemberItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="messages.group.GroupRemoveMemberItemView"
    innerClass="true">
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        flatten="true">
        <p151v.VCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/select"
            android:background="@drawable/core_remove_group_member_choice_bg"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:button="@null"/>
        <p151v.VDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/member_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="16dp"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="0x7f08095c"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="15sp"
            android:textColor="#212121"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/member_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:maxLines="1"
            app:typeface="medium"/>
    </p151v.VLinear>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#d0d0d0"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:background="#f7f7f7"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="28dp"/>
</com.p051p1.mobile.putong.core.p058ui.messages.group.GroupRemoveMemberItemView>
