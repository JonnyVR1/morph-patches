<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="marry.profile.edit.MarryEditProfileFragViewModel">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemAvatarView
            android:id="@+id/reorder_container"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp"/>
        <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemAvatarCardView
            android:id="@+id/avatars_container"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemTextView
                android:id="@+id/marry_declaration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.5dp"
                app:leftText="添加你的征婚宣言"
                app:title="征婚宣言"/>
            <p151v.VDivider
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="24dp"
                app:dividerColor="#08000000"
                app:dividerOrientation="horizontal"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemImagesView
                android:id="@+id/moment_life"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17.5dp"
                app:leftText="添加你的生活瞬间"
                app:title="生活瞬间"/>
            <p151v.VDivider
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="24dp"
                app:dividerColor="#08000000"
                app:dividerOrientation="horizontal"/>
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#66000000"
                android:id="@+id/session_marry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="婚恋信息"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/marry_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                app:leftText="婚恋状态"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/marry_expect_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="结婚预期时间"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/baby_willing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="生娃意愿"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemTagsView
                android:id="@+id/marry_mate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17.5dp"
                app:leftText="描述你的理想伴侣"
                app:title="理想伴侣"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemTextView
                android:id="@+id/family_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="33.5dp"
                app:leftText="添加家庭背景"
                app:title="家庭背景"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemTextView
                android:id="@+id/bride_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="33.5dp"
                app:leftText="添加婚礼/彩礼"
                app:title="婚礼/彩礼"/>
            <p151v.VDivider
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="24dp"
                app:dividerColor="#08000000"
                app:dividerOrientation="horizontal"/>
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#66000000"
                android:id="@+id/session_wealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="资产信息"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/profession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                app:leftText="职业"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="年收入"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/car"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="车辆信息"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/house"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="房产信息"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/monthly_cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="月消费"/>
            <p151v.VDivider
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                app:dividerColor="#08000000"
                app:dividerOrientation="horizontal"/>
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#66000000"
                android:id="@+id/session_basic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="基本资料"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/qualification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                app:leftText="学历"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/hometown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="家乡"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="现居地"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="身高"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="体重"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/nick_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="昵称"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/birthday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="生日"/>
            <p151v.VDivider
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                app:dividerColor="#08000000"
                app:dividerOrientation="horizontal"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemTextView
                android:id="@+id/prologue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17.5dp"
                app:leftText="添加你的开场白"
                app:title="开场白"/>
            <p151v.VDivider
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="24dp"
                app:dividerColor="#08000000"
                app:dividerOrientation="horizontal"/>
            <p151v.VText
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#66000000"
                android:id="@+id/session_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="绑定手机号"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.p051p1.mobile.putong.core.p058ui.marry.profile.view.MarryEditProfileItemView
                android:id="@+id/phone_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftText="手机号"
                app:visibleRightIcon="false"/>
            <p151v.VLinear
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/compliance_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                flatten="false">
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="#33000000"
                    android:ellipsize="end"
                    android:id="@+id/compliance_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《个人信息收集清单》"
                    android:lines="1"/>
                <p151v.VText
                    android:textSize="11sp"
                    android:textColor="#33000000"
                    android:ellipsize="end"
                    android:id="@+id/compliance_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《第三方信息数据共享》"
                    android:lines="1"/>
            </p151v.VLinear>
            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"/>
        </p151v.VLinear>
    </p151v.VLinear>
</ScrollView>
