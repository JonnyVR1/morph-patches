<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.profile.AnswerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/white"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    holder="profile.AnswerView"
    style="@style/profile_item_item">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="15sp"
                android:typeface="normal"
                android:textColor="@color/common_black_80"
                android:layout_gravity="center_vertical"
                android:id="@+id/question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <p151v.VText
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#fe7e1d"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/num"
                android:background="@drawable/core_profile_like_num_orange_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="@dimen/core_profile_like_num_padding_bottom"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="@color/core_color_66000000"
            android:id="@+id/answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <p151v.VImage
        android:gravity="center"
        android:id="@+id/arrow_image"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:srcCompat="@drawable/core_profile_edit_right_arrow"
        style="@style/profile_item_item_new"/>
</com.p051p1.mobile.putong.core.p058ui.profile.AnswerView>
