<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loading_panel"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/big_loading_pic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/loading_pic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_centerInParent="true"/>
    <ProgressBar
        android:id="@+id/loading_progress"
        android:background="@drawable/fsm_mgp_game_loading_bg"
        android:padding="3dp"
        android:visibility="invisible"
        android:layout_width="180dp"
        android:layout_height="28dp"
        android:max="100"
        android:layout_centerInParent="true"
        style="@style/fsm_mgp_update_progress_horizontal"/>
    <FrameLayout
        android:id="@+id/container_progress"
        android:background="@drawable/fsm_mgp_game_loading_progress_bg"
        android:layout_width="270dp"
        android:layout_height="62dp"
        android:layout_centerInParent="true">
        <tech.sud.gip.core.view.SudRoundFrameLayout
            android:background="#00000000"
            android:layout_width="234dp"
            android:layout_height="22dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="18dp"
            app:sudCornerRadius="11dp">
            <tech.sud.gip.core.view.round.SudRoundedImageView
                android:id="@+id/fsm_mgp_game_loading_progress"
                android:layout_width="234dp"
                android:layout_height="22dp"
                android:src="@drawable/fsm_mgp_game_loading_progress"
                android:scaleType="fitXY"
                android:layout_marginStart="-234dp"
                app:sud_riv_corner_radius="11dp"/>
        </tech.sud.gip.core.view.SudRoundFrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/fsm_mgp_loading_tip_loading"
        android:gravity="center_horizontal"
        android:id="@+id/loading_tip_result"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:text="@string/fsm_mgp_loading_tip_loading"
        android:layout_centerInParent="true"/>
    <TextView
        android:textColor="@color/fsm_mgp_text_black"
        android:gravity="center_horizontal"
        android:id="@+id/loading_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/fsm_mgp_loading_tip_loading"
        android:layout_below="@+id/loading_pic"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/fsm_mgp_loading_reload_game"
        android:gravity="center"
        android:id="@+id/reload_btn"
        android:background="@drawable/fsm_mgp_game_loading_retry_btn"
        android:visibility="invisible"
        android:layout_width="104dp"
        android:layout_height="36dp"
        android:layout_marginTop="60dp"
        android:text="@string/fsm_mgp_loading_reload_game"
        android:layout_below="@+id/loading_tip_result"
        android:layout_centerInParent="true"
        android:textAlignment="center"/>
    <RelativeLayout
        android:id="@+id/fsm_mgp_container_timeout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/loading_tip_result">
        <TextView
            android:textColor="@color/fsm_mgp_loading_tip_loading"
            android:gravity="center_horizontal"
            android:id="@+id/fsm_mgp_tv_timeout_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/fsm_mgp_continue_wait_tip"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/fsm_mgp_loading_reload_game"
                android:gravity="center"
                android:id="@+id/fsm_mgp_tv_timeout_reload"
                android:background="@drawable/fsm_mgp_game_loading_retry_btn"
                android:layout_width="104dp"
                android:layout_height="36dp"
                android:text="@string/fsm_mgp_loading_reload_game"
                android:textAlignment="center"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/fsm_mgp_btn_continue_wait"
                android:gravity="center"
                android:id="@+id/fsm_mgp_tv_continue_wait"
                android:background="@drawable/fsm_mgp_game_continue_wait_btn"
                android:layout_width="104dp"
                android:layout_height="36dp"
                android:text="@string/fsm_mgp_continue_wait"
                android:textAlignment="center"
                android:layout_marginStart="60dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
