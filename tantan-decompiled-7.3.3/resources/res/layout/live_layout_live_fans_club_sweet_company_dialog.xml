<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="common.fansclub"
    holder="company.FansClubSweetCompanyModel">
    <View
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/top_space"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/back"
        android:background="@drawable/live_shape_bg_fabs_club_back"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/back_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back_top"/>
    <android.widget.Space
        android:id="@+id/top_space"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"/>
    <p151v.VDraweeView
        android:id="@+id/light1"
        android:layout_width="296dp"
        android:layout_height="214dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"/>
    <p151v.VDraweeView
        android:id="@+id/light2"
        android:layout_width="234dp"
        android:layout_height="236dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:layout_width="67dp"
        android:layout_height="0dp"
        android:layout_marginRight="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/back"
        app:layout_constraintRight_toLeftOf="@+id/head2"
        app:layout_constraintTop_toTopOf="@+id/back">
        <p151v.VImage
            android:id="@+id/back1"
            android:layout_width="67dp"
            android:layout_height="62dp"
            android:layout_marginTop="-13dp"
            app:srcCompat="0x7f082297"/>
    </FrameLayout>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"
        app:srcCompat="0x7f082689"/>
    <p151v.VImage
        android:id="@+id/question"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"
        app:srcCompat="0x7f08268c"/>
    <android.widget.Space
        android:id="@+id/center"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="43dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"/>
    <android.widget.Space
        android:id="@+id/center_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        app:layout_constraintLeft_toRightOf="@+id/center"
        app:layout_constraintTop_toTopOf="@+id/center"/>
    <View
        android:id="@+id/head1_back"
        android:background="@drawable/live_bg_white_oval"
        android:layout_width="66dp"
        android:layout_height="66dp"
        app:layout_constraintBottom_toBottomOf="@+id/center"
        app:layout_constraintRight_toRightOf="@+id/center_right"/>
    <p151v.VDraweeView
        android:id="@+id/head1"
        android:layout_width="62dp"
        android:layout_height="62dp"
        app:layout_constraintBottom_toBottomOf="@+id/head1_back"
        app:layout_constraintLeft_toLeftOf="@+id/head1_back"
        app:layout_constraintRight_toRightOf="@+id/head1_back"
        app:layout_constraintTop_toTopOf="@+id/head1_back"
        app:placeholderImage="0x7f082460"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/head2_back"
        android:background="@drawable/live_bg_white_oval"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginLeft="55dp"
        app:layout_constraintLeft_toLeftOf="@+id/head1_back"
        app:layout_constraintTop_toTopOf="@+id/head1_back"/>
    <p151v.VDraweeView
        android:id="@+id/head2"
        android:layout_width="62dp"
        android:layout_height="62dp"
        app:layout_constraintBottom_toBottomOf="@+id/head2_back"
        app:layout_constraintLeft_toLeftOf="@+id/head2_back"
        app:layout_constraintRight_toRightOf="@+id/head2_back"
        app:layout_constraintTop_toTopOf="@+id/head2_back"
        app:placeholderImage="0x7f082460"
        app:roundAsCircle="true"/>
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintLeft_toLeftOf="@+id/head1_back"
        app:layout_constraintRight_toRightOf="@+id/head2_back"
        app:layout_constraintTop_toTopOf="@+id/head1_back">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:id="@+id/svg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <p151v.VImage
        android:id="@+id/static_heart"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintLeft_toLeftOf="@+id/head1_back"
        app:layout_constraintRight_toRightOf="@+id/head2_back"
        app:layout_constraintTop_toTopOf="@+id/head1_back"
        app:srcCompat="0x7f08229f"/>
    <p151v.VImage
        android:id="@+id/back2"
        android:layout_width="45dp"
        android:layout_height="57dp"
        android:layout_marginTop="59dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"
        app:srcCompat="0x7f082298"/>
    <p151v.VImage
        android:id="@+id/back3"
        android:layout_width="102dp"
        android:layout_height="105dp"
        android:layout_marginTop="35dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back"
        app:srcCompat="0x7f082299"/>
    <android.widget.Space
        android:id="@+id/back_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="52dp"
        app:layout_constraintBottom_toTopOf="@+id/title"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/live_white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/LIVE_FANS_CLUB_SWEET_TITLE"
        app:layout_constraintBottom_toTopOf="@+id/fans_company"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.p051p1.mobile.putong.live.livingroom.common.fansclub.view.FansClubCompanyViewGroup
        android:id="@+id/fans_company"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/content">
        <include
            android:id="@+id/company_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="-8dp"
            layout="@layout/live_layout_live_fans_club_sweet_company_item"/>
        <include
            android:id="@+id/company_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="-8dp"
            layout="@layout/live_layout_live_fans_club_sweet_company_item"/>
        <include
            android:id="@+id/company_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/live_layout_live_fans_club_sweet_company_item"/>
    </com.p051p1.mobile.putong.live.livingroom.common.fansclub.view.FansClubCompanyViewGroup>
    <com.p051p1.mobile.putong.live.base.view.ClipRoundImageView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginLeft="27dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="27dp"
        app:clip_image="0x7f0822a8"
        app:clip_margin_hor="1dp"
        app:clip_margin_ver="1dp"
        app:clip_radius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:id="@+id/progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/progress"
        app:layout_constraintLeft_toLeftOf="@+id/progress"
        app:layout_constraintRight_toRightOf="@+id/progress"
        app:layout_constraintTop_toTopOf="@+id/progress"/>
    <android.widget.Space
        android:id="@+id/back_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="27dp"
        app:layout_constraintTop_toBottomOf="@+id/progress"/>
    <p151v.VImage
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="0x7f0822a4"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/live_white"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toTopOf="@+id/progress"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
