<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true"
    app:flatten="true">
    <com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallRollAnimView
        android:id="@+id/user_roll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="27dp"
        android:layout_centerVertical="true"
        app:enableExitTranslation="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:liveItemSize="35"
        app:liveViewPadding="10dp"/>
    <p151v.VImage
        android:id="@+id/close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="20dp"
        android:src="0x7f0823f6"
        app:layout_constraintBottom_toBottomOf="@+id/user_roll_view"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_roll_view"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white_60_opacity"
        android:gravity="center"
        android:id="@+id/top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="20dp"
        android:maxWidth="250dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_roll_view"
        app:typeface="regular"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="20dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_title"
        app:typeface="medium"/>
    <p151v.VButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/openButton"
        android:background="@drawable/live_bg_fe7e1d_r14"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:maxWidth="88dp"
        android:text="@string/LIVE_CONFIRM"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Semibold"
        android:layout_marginEnd="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <p151v.VRadioButton
        android:textSize="12sp"
        android:textColor="#4dffffff"
        android:id="@+id/checked"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="35dp"
        android:button="@null"
        android:text="@string/LIVE_MULTI_CALL_TODY_NOT_SHOW"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/live_selector_multi_call_owner_notice"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/openButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
