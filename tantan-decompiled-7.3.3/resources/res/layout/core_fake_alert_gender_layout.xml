<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VLinear
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <p151v.VFrame
            android:layout_gravity="center_horizontal"
            android:id="@+id/profile_frame"
            android:layout_width="126dp"
            android:layout_height="120dp"
            android:layout_marginTop="46dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <p151v.VDraweeView
                android:layout_gravity="center"
                android:id="@+id/avatar"
                android:layout_width="86dp"
                android:layout_height="120dp"
                app:roundedCornerRadius="12dp"/>
            <p151v.VImage
                android:layout_gravity="end|bottom"
                android:id="@+id/indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f081474"
                android:scaleType="fitXY"/>
        </p151v.VFrame>
        <p151v.VText
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/common_black_01"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="32dp"
            android:maxLines="2"/>
        <p151v.VButton
            android:id="@+id/change_gender_1"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            style="@style/common_button_large_01"/>
        <p151v.VButton
            android:id="@+id/change_gender_2"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="24dp"
            style="@style/common_button_large_01"/>
    </p151v.VLinear>
</p151v.VLinear>
