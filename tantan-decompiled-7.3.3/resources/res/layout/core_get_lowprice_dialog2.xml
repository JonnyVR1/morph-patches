<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecallGetSurprise2Dialog xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#00000000"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true"
    holder="pricerecall.PriceRecallGetSurprise2Dialog">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout"
        android:background="@drawable/common_view_popup_bg"
        android:clickable="false"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/icon"
        android:layout_centerInParent="true">
        <p151v.VImage
            android:layout_gravity="right"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="0x7f080724"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="18sp"
                android:gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"
                android:layout_marginHorizontal="32dp"
                style="@style/core_vip_normal_title_style"/>
            <p151v.VText
                android:textSize="12sp"
                android:textColor="@color/core_vip_normal_subtitle_text_color"
                android:gravity="center_horizontal"
                android:id="@+id/subtitle"
                android:background="@drawable/core_vip_lowprice_dlg_subtittle_bg"
                android:paddingLeft="12dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="32dp"
                android:layout_marginHorizontal="32dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                app:typeface="medium"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <p151v.VText
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="32dp"
                android:layout_marginBottom="32dp"
                android:text="@string/CORE_PRICERECALL_SUPRICE_GET"
                android:stateListAnimator="@anim/widget_button_sla_mini"
                android:layout_marginHorizontal="32dp"
                style="@style/common_button_large_01"/>
        </LinearLayout>
    </LinearLayout>
    <p151v.VImage
        android:id="@+id/icon"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-41dp"
        android:src="0x7f081384"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
</com.p051p1.mobile.putong.core.p058ui.pricerecall.PriceRecallGetSurprise2Dialog>
