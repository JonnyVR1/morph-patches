<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.call.auction.dialog.relationchoose.RelationPageItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="95dp"
    android:layout_marginBottom="12dp"
    app:bind_extends="FrameLayout"
    app:bind_implements="null"
    app:binding="true">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/bg"
        android:layout_width="70dp"
        android:layout_height="95dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="95dp">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/live_white_80_opacity"
            android:layout_gravity="center_horizontal"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:maxLength="5"
            android:fontFamily="PingFangSC-Medium"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="@color/live_white_50_opacity"
            android:layout_gravity="center_horizontal"
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="PingFangSC-Medium"/>
    </LinearLayout>
</com.p051p1.mobile.putong.live.livingroom.voice.call.auction.dialog.relationchoose.RelationPageItemView>
