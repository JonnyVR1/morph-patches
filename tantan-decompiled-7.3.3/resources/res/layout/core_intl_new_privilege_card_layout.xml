<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.profile.newme.NewPrivilegeCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="profile.newme.NewPrivilegeCard">
    <p151v.VDraweeView
        android:id="@+id/privilege_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"
        app:roundedCornerRadius="18dp"/>
    <p151v.VDraweeView
        android:id="@+id/title_res"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="6dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/bg_res"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:id="@+id/buy_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_res"
        flatten="true">
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#9e5701"
            android:gravity="center"
            android:id="@+id/buy"
            android:background="@drawable/core_intl_me_vip_buy_bt"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="13dp"/>
        <p151v.VDraweeView
            android:layout_gravity="right"
            android:id="@+id/free"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="22dp"/>
    </FrameLayout>
    <p151v.VText
        android:textSize="10sp"
        android:textColor="#99000000"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="20dp"
        android:maxLines="3"
        app:layout_constraintLeft_toLeftOf="@+id/title_res"
        app:layout_constraintTop_toBottomOf="@+id/title_res"/>
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/privilege_svga"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="51dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VDraweeView
        android:id="@+id/privilege_icon"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="51dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="9sp"
        android:textColor="@color/white"
        android:id="@+id/upgrade_tag"
        android:background="@drawable/core_intl_upgrade_tag_bg"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/INTL_UPGRADE_ADD_PRICE_TAG"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.p051p1.mobile.putong.core.newui.profile.newme.NewPrivilegeCard>
