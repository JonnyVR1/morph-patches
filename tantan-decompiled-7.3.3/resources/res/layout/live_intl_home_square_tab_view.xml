<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    flatten="true"
    holder="intl.view.widgets.IntlLiveSquareTabView">
    <p151v.VText
        android:textSize="21sp"
        android:textColor="@color/tab_text_color_live_square_act"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/red_dot_num"
        android:background="@drawable/live_shape_tab_red_bg"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-14dp"
        android:layout_marginTop="4dp"
        android:minWidth="18dp"
        android:minHeight="15dp"
        android:singleLine="true"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_toEndOf="@+id/tv_tab_title"/>
    <p151v.VText
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/live_white"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/red_dot_text"
        android:background="@drawable/live_shape_voice_tab_text_red_bg"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginLeft="-16dp"
        android:layout_marginTop="2dp"
        android:text="聚会"
        android:singleLine="true"
        android:layout_toEndOf="@+id/tv_tab_title"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/red_dot"
        android:background="@drawable/live_shape_circle_red_dot"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="-6dp"
        android:layout_marginTop="4dp"
        android:layout_toEndOf="@+id/tv_tab_title"/>
</merge>
