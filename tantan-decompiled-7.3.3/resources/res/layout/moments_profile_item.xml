<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.feed.p065ui.moments.MomentsInProfileView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/white"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="moments.MomentsInProfileView">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include
            android:layout_gravity="center_horizontal"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            layout="@layout/feed_messages_sending_or_error"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:layout_width="68dp"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="20sp"
                android:textColor="@color/text_dark"
                android:id="@+id/day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="medium"/>
            <p151v.VText
                android:textSize="16sp"
                android:textColor="@color/text_medium"
                android:id="@+id/month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:typeface="regular"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/content_frame"
            android:background="@drawable/tf_rect_rounded_light"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            flatten="true">
            <FrameLayout
                android:id="@+id/images"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginRight="16dp"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/text_medium"
                android:ellipsize="end"
                android:id="@+id/caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                app:typeface="regular"/>
        </LinearLayout>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#bdbdbd"
            android:id="@+id/review_image"
            android:paddingLeft="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/USER_INFO_CHECKING"/>
    </LinearLayout>
</com.p051p1.mobile.putong.feed.p065ui.moments.MomentsInProfileView>
