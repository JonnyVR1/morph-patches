<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesInfiltrationItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="view"
    holder="widgets.LiveActivitiesInfiltrationItemView">
    <p151v.VText
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#4c000000"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/hor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp">
        <include
            android:id="@+id/item_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            layout="@layout/live_activities_infiltration_pic_item"/>
        <include
            android:id="@+id/item_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            layout="@layout/live_activities_infiltration_pic_item"/>
        <include
            android:id="@+id/item_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            layout="@layout/live_activities_infiltration_pic_item"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.external.view.widgets.LiveActivitiesInfiltrationItemView>
