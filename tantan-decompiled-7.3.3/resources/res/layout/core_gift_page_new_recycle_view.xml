<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.gift.panel.NewGiftPanelPagerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="-13dp"
    holder="gift.panel.NewGiftPanelPagerView">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:background="@color/transparent"
        android:paddingLeft="15dp"
        android:paddingRight="14dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:divider="@null"
        android:overScrollMode="never"/>
    <p151v.VImage
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginLeft="-15dp"
        android:layout_marginTop="-12dp"
        android:layout_marginRight="-15dp"
        android:src="0x7f0808a1"
        android:scaleType="fitXY"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.p051p1.mobile.putong.core.p058ui.gift.HorRecyclerViewIndicator
            android:layout_gravity="center"
            android:id="@+id/indicator"
            android:background="@drawable/core_gift_newpanel_item_indicator_bg"
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginTop="-5dp"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.gift.panel.NewGiftPanelPagerView>
