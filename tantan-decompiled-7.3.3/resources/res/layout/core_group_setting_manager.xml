<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:paddingLeft="16dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="messages.group.GroupSettingManagerViewModel"
    innerClass="true">
    <p151v.VFrame
        android:id="@+id/member_manager"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/CHAT_GROUP_MEMBER_MANAGE"/>
        <View
            android:layout_gravity="center"
            android:background="0x7f081111"
            android:layout_width="5dp"
            android:layout_height="10dp"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/join_type"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:text="@string/CHAT_GROUP_ADD_METHOD"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4c000000"
            android:layout_gravity="bottom"
            android:id="@+id/txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:text="@string/CHAT_GROUP_RESTRICTION_ANYONE"/>
        <View
            android:layout_gravity="center"
            android:background="0x7f081111"
            android:layout_width="5dp"
            android:layout_height="10dp"/>
    </p151v.VFrame>
    <p151v.VFrame
        android:id="@+id/join_check"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <p151v.VText
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:text="@string/CHAT_GROUP_INTIVE_MEMBER"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="#4c000000"
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:text="@string/CHAT_GROUP_RESTRICTION_ANYONE"/>
        <View
            android:layout_gravity="center"
            android:background="0x7f081111"
            android:layout_width="5dp"
            android:layout_height="10dp"/>
    </p151v.VFrame>
</p151v.VLinear>
