<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="camera.VideoEditFrag">
    <android.view.TextureView
        android:id="@+id/camera_edit_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <View
        android:background="@drawable/camera_top_mask"
        android:layout_width="match_parent"
        android:layout_height="80dp"/>
    <View
        android:background="@drawable/camera_bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/camera_edit_control"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/camera_edit_back"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="0x7f0802b4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginBottom="29dp"
        android:layout_above="@+id/cancel"
        android:layout_alignParentLeft="true"
        flatten="true">
        <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
            android:layout_gravity="center"
            android:id="@+id/camera_edit_cut_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:image_size="24dp"
            app:src="0x7f0802be"
            app:text="@string/FEED_CAPTURE_MUSIC_CUT"/>
        <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
            android:layout_gravity="center"
            android:id="@+id/camera_edit_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            app:image_size="24dp"
            app:src="0x7f0802bf"
            app:text="@string/FEED_CAPTURE_VOLUMN"/>
        <com.p051p1.mobile.putong.feed.newui.camera.widget.CameraMenuView
            android:layout_gravity="center"
            android:id="@+id/camera_edit_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            app:image_size="24dp"
            app:src="0x7f0802c7"
            app:text="@string/PROFILE_TAGS_CATEGORY_MUSIC"/>
    </LinearLayout>
    <p151v.VButton
        android:textSize="14sp"
        android:textColor="@color/common_white"
        android:gravity="center"
        android:id="@+id/camera_edit_complete"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="14dp"
        android:text="@string/ACTION_NEXT"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        style="@style/common_button_small_01"/>
    <p151v.VText
        android:textColor="@color/common_white"
        android:id="@+id/cancel"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginBottom="14dp"
        android:text="@string/ACTION_CANCEL"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"/>
    <android.view.ViewStub
        android:id="@+id/moment_edit_music_panel_viewstub"
        android:visibility="gone"
        android:layout="@layout/view_video_edit_music_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <android.view.ViewStub
        android:id="@+id/camera_edit_music_range_viewstub"
        android:visibility="gone"
        android:layout="@layout/feed_camera_music_range_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"/>
    <android.view.ViewStub
        android:id="@+id/camera_edit_music_volume_viewstub"
        android:visibility="gone"
        android:layout="@layout/feed_camera_music_volume_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
