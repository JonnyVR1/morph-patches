<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.WeekStarChampionItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="115dp">
    <p151v.VDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        app:placeholderImage="0x7f08226e"/>
    <p151v.VText
        android:textSize="13sp"
        android:textColor="#ccffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/gift_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:text="风暴爱心"
        android:singleLine="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp">
        <p151v.VDraweeView
            android:id="@+id/user_avatar"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:placeholderImage="0x7f082781"
            app:roundAsCircle="true"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#66ffffff"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="小小甜心"
            android:singleLine="true"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.live.livingroom.voice.newgiftwall.view.WeekStarChampionItemView>
