<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.justreal.JustRealSuccessLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="newui"
    holder="home.justreal.JustRealSuccessLayout">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginLeft="16dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar1"
            android:background="@drawable/core_bg_oval_white"
            android:padding="2dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:fadeDuration="0"
            app:roundAsCircle="true"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar2"
            android:background="@drawable/core_bg_oval_white"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="20dp"
            app:fadeDuration="0"
            app:roundAsCircle="true"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar3"
            android:background="@drawable/core_bg_oval_white"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="40dp"
            app:fadeDuration="0"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:layout_gravity="bottom|right"
            android:id="@+id/fake_heart_image"
            android:background="@drawable/core_bg_oval_white"
            android:padding="2dp"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginRight="-3dp"
            app:srcCompat="0x7f0805a4"/>
    </FrameLayout>
    <p151v.VLinear
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="20dp">
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="13dp"
            android:textColor="@color/common_000000_80"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="头像认证审核通过"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Default_Bold
            android:textSize="13dp"
            android:textColor="#4c000000"
            android:gravity="center_vertical"
            android:id="@+id/avatar_count"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="头像认证审核通过"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.justreal.JustRealSuccessLayout>
