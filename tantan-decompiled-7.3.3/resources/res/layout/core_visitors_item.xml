<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    holder="visitor.VisitorsView">
    <p151v.VRelative
        android:id="@+id/comment_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <com.p051p1.mobile.putong.p070ui.headframe.HeaderFrameWrapper
            android:id="@+id/profile"
            android:layout_width="69dp"
            android:layout_height="69dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"/>
        <p151v.VLinear
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/profile">
            <p151v.VLinear
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                flatten="true">
                <p151v.VLinear
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <p151v.VLinear
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <p151v.VText
                            android:textSize="15sp"
                            android:textColor="@color/core_color_e6000000"
                            android:ellipsize="end"
                            android:layout_gravity="center"
                            android:id="@+id/name"
                            android:padding="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:fontFamily="PingFangSc-Medium"/>
                        <p151v.VText
                            android:textSize="15sp"
                            android:textColor="@color/core_color_e6000000"
                            android:id="@+id/age"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"/>
                    </p151v.VLinear>
                </p151v.VLinear>
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/core_color_e6000000"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/visitor_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"/>
            </p151v.VLinear>
            <p151v.VText
                android:textSize="13sp"
                android:textColor="@color/common_grey_08"
                android:ellipsize="end"
                android:id="@+id/visitor_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_below="@+id/content_container"/>
        </p151v.VLinear>
    </p151v.VRelative>
</com.p051p1.mobile.putong.core.p058ui.visitor.VisitorsView>
