<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.messages.ConversationHeadIntlSeeItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_header_intl_see_border"
    android:clipChildren="false"
    android:layout_width="100dp"
    android:layout_height="115dp"
    folder="newui"
    holder="messages.ConversationHeadIntlSeeItem"
    innerClass="true">
    <p151v.VFrame
        android:layout_gravity="center_horizontal"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="13dp">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:background="@drawable/core_default_head_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/core_special_like_avatar"/>
        <p151v.VText_AutoFit
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/head_like_num"
            android:background="@drawable/core_see_change_head_num_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="-5dp"
            android:layout_marginRight="-5dp"
            android:minWidth="24dp"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:id="@+id/head_new_like"
            android:background="@drawable/core_bg_conversation_unread"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="-5dp"
            android:layout_marginRight="-5dp"
            android:minWidth="24dp"
            android:text=""/>
    </p151v.VFrame>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginBottom="5.6dp">
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_purchase_dialog_svip_color_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/txt"
            android:background="@drawable/core_default_txt_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="-3dp"
            app:typeface="medium"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.newui.messages.ConversationHeadIntlSeeItem>
