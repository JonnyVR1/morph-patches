<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.topeffect.view.HourTopBroadcastView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    folder="increment"
    holder="gift.topeffect.view.HourTopBroadcastView">
    <p151v.VDraweeView
        android:id="@+id/shadow"
        android:background="@drawable/live_shape_user_upgrade_shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="375dp"/>
    <FrameLayout
        android:id="@+id/tray_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/backgroundView"
            android:layout_width="180dp"
            android:layout_height="56dp"/>
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_horizontal"
            android:id="@+id/svga"
            android:layout_width="180dp"
            android:layout_height="56dp"
            android:scaleType="fitXY"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="180dp"
            android:layout_height="56dp">
            <p151v.VDraweeView
                android:id="@+id/avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="10dp"
                app:failureImage="@drawable/live_vector_default_avatar_bg"
                app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                app:roundAsCircle="true"/>
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/live_white"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="56dp"
                android:layout_marginTop="11dp"
                android:layout_marginRight="10dp"
                android:maxLines="1"/>
            <p151v.VText
                android:textSize="10sp"
                android:textColor="#ffdd19"
                android:ellipsize="end"
                android:id="@+id/rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="56dp"
                android:layout_marginTop="31dp"
                android:singleLine="true"/>
        </FrameLayout>
    </FrameLayout>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.topeffect.view.HourTopBroadcastView>
