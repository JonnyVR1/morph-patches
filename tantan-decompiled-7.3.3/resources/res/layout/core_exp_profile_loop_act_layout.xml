<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/input_root"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="10dp"
            android:src="0x7f081122"/>
    </FrameLayout>
    <p151v.VLinear
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <p151v.AutoVDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_pic"
            android:layout_width="138dp"
            android:layout_height="120dp"/>
        <p151v.VLinear
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="12dp">
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/common_exp_black_01"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"/>
            <com.p051p1.mobile.putong.core.p058ui.VText_Bold
                android:textSize="24dp"
                android:textColor="@color/common_exp_black_03"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title_ext"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="15dp"
            android:textColor="@color/common_grey_12"
            android:gravity="center"
            android:id="@+id/sub_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="28dp"/>
    </p151v.VLinear>
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/input_content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="34dp">
        <p151v.VFrame_Shadow
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:sl_cornerRadius="28dp"
            app:sl_dx="2dp"
            app:sl_dy="3dp"
            app:sl_shadowColor="#19000000"
            app:sl_shadowRadius="10dp">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/pre"
                android:background="@drawable/core_exp_profile_loop_arrow"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
        </p151v.VFrame_Shadow>
        <p151v.VFrame_Shadow
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            app:sl_cornerRadius="28dp"
            app:sl_dx="2dp"
            app:sl_dy="3dp"
            app:sl_shadowColor="#19000000"
            app:sl_shadowRadius="10dp">
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/skip"
                android:background="@drawable/core_exp_profile_loop_arrow"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:rotation="180"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/complete"
                android:background="0x7f0807c5"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
        </p151v.VFrame_Shadow>
        <com.p051p1.mobile.putong.core.p058ui.profile.exploop.ExpSetInfoProgressView
            android:layout_gravity="center_vertical"
            android:id="@+id/input_progress_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginLeft="106dp"
            android:layout_marginRight="106dp"/>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textSize="12dp"
            android:textColor="@color/common_exp_black_03"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bottom_text"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginBottom="16dp"/>
    </FrameLayout>
</p151v.VLinear>
