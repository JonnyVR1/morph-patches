<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/root_view"
    android:background="@drawable/feed_tab_post_icon_bg"
    android:layout_width="wrap_content"
    android:layout_height="34dp">
    <p151v.VDraweeView
        android:id="@+id/status_send_img"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="4dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/status_send_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/FEED_STAT_SEND"/>
</p151v.VLinear>
