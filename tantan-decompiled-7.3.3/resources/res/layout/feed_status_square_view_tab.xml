<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/white"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="false"
    folder="newui"
    holder="status.display.statuspage.newtab.FeedStatusSquareTabFrag">
    <p151v.VRelative
        android:id="@+id/bg_view"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <p151v.VImage
            android:id="@+id/bg_img_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="29dp"
            android:layout_marginTop="10dp"
            android:src="0x7f081c8a"/>
        <p151v.VImage
            android:id="@+id/bg_img_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081c8b"
            android:layout_alignParentRight="true"/>
        <p151v.VImage
            android:id="@+id/bg_img_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="127dp"
            android:src="0x7f081c8c"
            android:layout_alignParentBottom="true"/>
    </p151v.VRelative>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/root_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/space_view"
        app:layout_constraintTop_toTopOf="parent">
        <com.p051p1.mobile.putong.feed.newui.status.display.statuspage.newtab.FeedStateSquareRecycle
            android:orientation="horizontal"
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="true"/>
    </p151v.VLinear>
    <p151v.VLinear
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/no_data"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <p151v.VImage
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f081ee9"/>
        <p151v.VText
            android:textSize="14sp"
            android:textColor="#4c323232"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂时没有状态"/>
    </p151v.VLinear>
    <Space
        android:id="@+id/space_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/bottom_meet_view"/>
    <p151v.VLinear
        android:orientation="horizontal"
        android:id="@+id/bottom_meet_view"
        android:background="0x7f081eee"
        android:padding="17dp"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_bot"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </p151v.VLinear>
</androidx.constraintlayout.widget.ConstraintLayout>
