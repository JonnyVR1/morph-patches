<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.virtual.preview.VirtualNewPreviewView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="0x7f082749"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/close_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:src="0x7f082742"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/create_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:src="0x7f08274a"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_icon"/>
    <p151v.VText
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:id="@+id/create_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="创建房间"
        app:layout_constraintBottom_toBottomOf="@+id/create_icon"
        app:layout_constraintLeft_toRightOf="@+id/create_icon"
        app:layout_constraintTop_toTopOf="@+id/create_icon"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#66ffffff"
        android:gravity="center"
        android:id="@+id/room_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="35dp"
        android:text="房间名称"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/create_icon"/>
    <p151v.VEditText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_white_80_opacity"
        android:textColorHint="@color/live_white_20_opacity"
        android:gravity="center_vertical"
        android:id="@+id/edit_room_name"
        android:background="@drawable/live_bg_white_r10_a05"
        android:paddingLeft="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:hint="给你的群起个名字吧"
        android:maxLines="1"
        android:singleLine="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionNone"
        android:textCursorDrawable="@drawable/live_shape_voice_preview_input_cursor_style"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/room_title_text"/>
    <ImageView
        android:id="@+id/refresh_name"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="16dp"
        android:src="0x7f08274e"
        app:layout_constraintBottom_toBottomOf="@+id/edit_room_name"
        app:layout_constraintRight_toRightOf="@+id/edit_room_name"
        app:layout_constraintTop_toTopOf="@+id/edit_room_name"/>
    <p151v.VText
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#66ffffff"
        android:gravity="center"
        android:id="@+id/room_class_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:text="房间类型"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_room_name"/>
    <org.apmem.tools.layouts.FlowLayout
        android:id="@+id/ll_room_class"
        android:layout_width="match_parent"
        android:layout_height="188dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/room_class_text"/>
    <p151v.VText
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/live_virtual_create_button_text_color"
        android:gravity="center"
        android:id="@+id/create_room_button"
        android:background="@drawable/live_bg_fe7e1d_r10"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:text="创建房间"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <p151v.VText
        android:textSize="14dp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center_vertical"
        android:id="@+id/call_fans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="16dp"
        android:text="通知粉丝"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/live_selector_voice_preview"
        app:layout_constraintBottom_toTopOf="@+id/create_room_button"
        app:layout_constraintLeft_toLeftOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.virtual.preview.VirtualNewPreviewView>
