<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="310dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="286dp"
        android:layout_height="128dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/verify"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VMaterialEdit_FakeSpinner
                    android:id="@+id/ccode"
                    style="@style/feed_account_spinner"/>
                <p151v.VMaterialEdit
                    android:id="@+id/username"
                    android:hint="@string/FEED_INPUT_PHONE"
                    style="@style/feed_account_username"/>
            </LinearLayout>
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VMaterialEdit
                    android:gravity="center_vertical"
                    android:id="@+id/code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/SIGNUP_COMFIRM_CODE"
                    android:inputType="number"
                    style="@style/feed_account_input"/>
                <p151v.VButton_FakeShadowSmall
                    android:enabled="false"
                    android:textColor="@color/account_get_code_red"
                    android:layout_gravity="center"
                    android:id="@+id/get_code"
                    android:background="@drawable/feed_account_get_code_red"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:minHeight="34dp"
                    android:text="@string/SIGNUP_GET_CODE"
                    style="@style/v_button"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
