<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/live_shape_pull_up_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="other.liveend"
    holder="IntlLiveEndViewModel">
    <p151v.VScroll_Fill
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        flatten="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <p151v.VDraweeView
                android:id="@+id/image_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:failureImage="@drawable/live_shape_pull_up_bg"
                app:placeholderImage="@drawable/live_shape_pull_up_bg"
                style="@style/live_fresco_base"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@color/live_bg"
                android:paddingLeft="@dimen/live_padding_start"
                android:paddingRight="@dimen/live_padding_end"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/live_padding_start"
                android:paddingEnd="@dimen/live_padding_end"
                flatten="true">
                <p151v.VText
                    android:textSize="20sp"
                    android:textColor="@color/live_white"
                    android:gravity="center_horizontal"
                    android:id="@+id/live_finished"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="59dp"
                    android:text="@string/LIVE_LIVE_FINISHED"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="#99ffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>
                <p151v.VDraweeView
                    android:id="@+id/avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="24dp"
                    app:failureImage="@drawable/live_vector_default_avatar_bg"
                    app:placeholderImage="@drawable/live_vector_default_avatar_bg"
                    style="@style/live_fresco_profile_small"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/live_white"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/anchor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/anchor_autograph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/set_autograph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <p151v.VText
                        android:textSize="14dp"
                        android:textColor="#80ffffff"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="@string/LIVE_SETTING_SIGNATURE"/>
                    <p151v.VImage
                        android:layout_gravity="center_vertical"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/live_vector_ic_signature_site_enter_icon"
                        android:scaleType="fitXY"
                        android:tint="#80ffffff"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <View
                    android:layout_marginTop="28dp"
                    style="@style/live_line"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/order_content_zh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    flatten="true">
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="@color/live_white"
                        android:gravity="center_horizontal"
                        android:id="@+id/order"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <p151v.VText
                        android:textSize="14sp"
                        android:textColor="@color/live_white"
                        android:gravity="center_horizontal"
                        android:id="@+id/reward_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="36dp"
                        android:layout_marginStart="36dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/order_content_other"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    flatten="true">
                    <p151v.VLinear
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <p151v.VText
                            android:textSize="34sp"
                            android:textColor="@color/live_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/order_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textColor="@color/live_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/order_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </p151v.VLinear>
                    <p151v.VLinear
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/reward_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        flatten="true">
                        <p151v.VText
                            android:textSize="34sp"
                            android:textColor="#f36c4e"
                            android:gravity="center_horizontal"
                            android:id="@+id/reward_amount_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <p151v.VText
                            android:textSize="14sp"
                            android:textColor="@color/live_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/reward_amount_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </p151v.VLinear>
                </LinearLayout>
                <View
                    android:layout_marginTop="24dp"
                    style="@style/live_line"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <p151v.VText
                            android:textSize="18sp"
                            android:textColor="@color/live_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/visitors"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="#99ffffff"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/LIVE_HOST_WATCH_PERSONS_COUNT"/>
                    </LinearLayout>
                    <View
                        android:layout_gravity="center"
                        style="@style/live_line_vertical"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <p151v.VText
                            android:textSize="18sp"
                            android:textColor="@color/live_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/new_follow_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="#99ffffff"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/LIVE_HOST_NEW_FOLLOW"/>
                    </LinearLayout>
                    <View
                        android:layout_gravity="center"
                        style="@style/live_line_vertical"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <p151v.VText
                            android:textSize="18sp"
                            android:textColor="@color/live_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/nums_of_gift"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <p151v.VText
                            android:textSize="13sp"
                            android:textColor="#99ffffff"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/LIVE_HOST_GIVE_GIFT_PERSON_COUNT"/>
                    </LinearLayout>
                </LinearLayout>
                <p151v.VButton
                    android:textSize="17sp"
                    android:textColor="@color/live_white"
                    android:gravity="center"
                    android:id="@+id/confirm"
                    android:background="@drawable/live_bg_white_r6_a20"
                    android:layout_width="176dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="56dp"
                    android:text="@string/LIVE_CONFIRM"/>
            </LinearLayout>
        </FrameLayout>
    </p151v.VScroll_Fill>
</FrameLayout>
