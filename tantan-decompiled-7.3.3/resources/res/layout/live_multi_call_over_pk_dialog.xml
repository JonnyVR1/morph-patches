<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bind_extends="com.p1.mobile.putong.live.livingroom.archi.dialogcenter.BaseDialogHolder"
    app:bind_implements="null"
    app:binding="true"
    app:flatten="true">
    <View
        android:id="@+id/view_top"
        android:background="@drawable/live_bg_white_r3_a05"
        android:layout_width="37dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white_40_opacity"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23dp"
        app:layout_constraintBottom_toTopOf="@+id/top_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/top_space"
        android:background="@color/live_white_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="76dp"
        android:layout_marginBottom="219dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/tv_again_pk"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="再来一局"
        app:layout_constraintTop_toBottomOf="@+id/top_space"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_80_opacity"
        android:gravity="center"
        android:id="@+id/tv_over_pk"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="结束PK"
        app:layout_constraintTop_toBottomOf="@+id/tv_again_pk"/>
    <View
        android:id="@+id/bottom_space"
        android:background="@color/live_white_03_opacity"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_over_pk"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="@color/live_white_40_opacity"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="取消"
        app:layout_constraintTop_toBottomOf="@+id/bottom_space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
