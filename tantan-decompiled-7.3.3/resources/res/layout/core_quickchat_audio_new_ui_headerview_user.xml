<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_send_red_packet_btn_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="219dp"
    attachToRoot="true"
    folder="newui"
    holder="messages.anim.view.QuickChatAudioNewUiHeaderUserView">
    <TextView
        android:textSize="13.5dp"
        android:textColor="@color/common_grey_09"
        android:id="@+id/mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:text="闪聊匹配"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VFrame
        android:id="@+id/avatar_layout"
        android:layout_width="112dp"
        android:layout_height="162dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="41dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true">
        <p151v.VDraweeView
            android:id="@+id/profile_user"
            android:layout_width="112dp"
            android:layout_height="162dp"
            android:layout_centerVertical="true"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="10dp"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_gravity="top|left"
            android:id="@+id/green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:text="在线"
            android:shadowColor="@color/shadow"
            android:shadowRadius="2"
            android:drawableLeft="0x7f0815d3"
            android:drawablePadding="4dp"/>
    </p151v.VFrame>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_layout"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toRightOf="@+id/avatar_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <p151v.VText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/common_black_02"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <p151v.VImage
                android:id="@+id/avatar_icon"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"/>
        </p151v.VLinear>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/common_grey_02"
            android:ellipsize="end"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"/>
        <p151v.VText
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/common_black_02"
            android:ellipsize="end"
            android:id="@+id/say_hi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="2"/>
    </LinearLayout>
    <p151v.VImage
        android:id="@+id/close"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0815d4"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#f2aa7e"
        android:gravity="center"
        android:id="@+id/gotochat"
        android:background="@drawable/core_quickchat_fuliao_tag_bg_audio_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="16dp"
        android:text="和她聊聊"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/avatar_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:typeface="regular"/>
</merge>
