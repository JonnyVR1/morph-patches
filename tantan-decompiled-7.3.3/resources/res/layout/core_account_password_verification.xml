<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    holder="account.PasswordVerificationActViewModel"
    style="@style/core_account_root">
    <p151v.navigationbar.VNavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="0x7f080387"/>
    <p151v.VScroll style="@style/core_account_scroll">
        <LinearLayout style="@style/core_account_frame">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <p151v.VMaterialEdit
                    android:id="@+id/password"
                    android:hint="@string/EDIT_SETTINGS_ENTER_YOUR_PASSWORD"
                    style="@style/core_account_password_free_length"/>
            </LinearLayout>
            <p151v.VText
                android:layout_marginTop="24dp"
                android:text="@string/EDIT_SETTINGS_ENTER_YOUR_PASSWORD_DETAILS"
                style="@style/core_account_tips"/>
        </LinearLayout>
    </p151v.VScroll>
    <p151v.VButton_FakeShadow
        android:enabled="true"
        android:id="@+id/continue_"
        android:text="@string/ACTION_CONTINUE"
        style="@style/core_account_continue_button"/>
</p151v.VLinear>
