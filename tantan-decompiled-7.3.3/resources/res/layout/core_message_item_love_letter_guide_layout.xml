<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLoveLetterGuideView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="messages.view.MessageLoveLetterGuideView">
    <p151v.VLinear
        android:orientation="vertical"
        android:background="@drawable/core_local_love_letter_guide_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="10dp">
        <p151v.VLinear
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="5dp">
            <p151v.VImage
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:srcCompat="0x7f080d61"/>
            <p151v.VLinear
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="0dp">
                <com.p051p1.mobile.putong.core.p058ui.VText_Medium
                    android:textSize="15sp"
                    android:textColor="@color/common_000000_80"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"/>
                <p151v.VText
                    android:textSize="13sp"
                    android:textColor="@color/common_000000_40"
                    android:id="@+id/sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineHeight="18dp"/>
            </p151v.VLinear>
        </p151v.VLinear>
        <com.p051p1.mobile.putong.core.p058ui.VText_Medium
            android:textColor="#fe7e1d"
            android:gravity="center"
            android:id="@+id/save_btn"
            android:background="@drawable/core_local_love_letter_guide_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.messages.view.MessageLoveLetterGuideView>
