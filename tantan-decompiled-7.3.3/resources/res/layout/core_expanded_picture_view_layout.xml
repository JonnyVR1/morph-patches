<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardPictureViewOpt xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    folder="newui"
    holder="home.views.CardPictureViewOpt">
    <com.p051p1.mobile.putong.core.newui.home.card.expanded.view.CardDraweeViewOpt
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"
        useId="true"/>
    <com.p051p1.mobile.putong.core.newui.home.card.expanded.view.CardDraweeViewOpt
        android:id="@+id/image_copy"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/common_card_image_holder_full_round"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        useId="true"/>
    <p151v.VDraweeView
        android:id="@+id/image_center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@color/white"
        app:failureImageScaleType="centerInside"
        app:placeholderImage="@color/white"
        app:placeholderImageScaleType="centerInside"
        style="@style/core_fresco_base"
        useId="true"/>
    <include layout="@layout/media_control_button"/>
</com.p051p1.mobile.putong.core.newui.home.views.CardPictureViewOpt>
