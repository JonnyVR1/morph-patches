<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.newui.home.views.CardBottomMomentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layerType="software"
    flatten="true"
    folder="newui"
    holder="home.views.CardBottomMomentLayout">
    <include
        android:id="@+id/card_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/core_card_bottom_basic_info"/>
    <p151v.VLinear
        android:orientation="vertical"
        android:id="@+id/info_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        flatten="true">
        <p151v.VLinear
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            flatten="true">
            <p151v.VText
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/tv_moment_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CARD_INFO_MOMENTS"
                android:shadowColor="@color/common_light_02"
                android:shadowDx="1"
                android:shadowDy="1"
                android:lineSpacingExtra="0sp"
                app:typeface="regular"/>
        </p151v.VLinear>
        <p151v.VLinear
            android:orientation="horizontal"
            android:id="@+id/image_ll"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            flatten="true">
            <p151v.VDraweeView
                android:id="@+id/image1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@drawable/core_card_moment_image_bg"
                app:roundedCornerRadius="10dp"
                app:roundingBorderColor="#3dffffff"
                app:roundingBorderWidth="1.5dp"/>
            <p151v.VDraweeView
                android:id="@+id/image2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="5dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@drawable/core_card_moment_image_bg"
                app:roundedCornerRadius="10dp"
                app:roundingBorderColor="#3dffffff"
                app:roundingBorderWidth="1.5dp"/>
            <p151v.VDraweeView
                android:id="@+id/image3"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="5dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@drawable/core_card_moment_image_bg"
                app:roundedCornerRadius="10dp"
                app:roundingBorderColor="#3dffffff"
                app:roundingBorderWidth="1.5dp"/>
            <p151v.VDraweeView
                android:id="@+id/image4"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="5dp"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@drawable/core_card_moment_image_bg"
                app:roundedCornerRadius="10dp"
                app:roundingBorderColor="#3dffffff"
                app:roundingBorderWidth="1.5dp"/>
        </p151v.VLinear>
        <p151v.VRelative
            android:id="@+id/post_guide_ll"
            android:background="@drawable/core_bg_10_33ffffff"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="74dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            flatten="true">
            <p151v.VFrame
                android:id="@+id/add_ic"
                android:background="@drawable/core_bg_8_33000000"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                android:layout_centerVertical="true">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="0x7f081382"
                    android:scaleType="centerCrop"/>
            </p151v.VFrame>
            <p151v.VLinear
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="12dp"
                android:layout_toRightOf="@+id/add_ic"
                android:layout_centerVertical="true">
                <p151v.VText
                    android:textSize="12sp"
                    android:textColor="@color/color_ccffffff"
                    android:ellipsize="end"
                    android:id="@+id/subTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="你的动态空空如也"
                    android:singleLine="true"/>
                <p151v.VText
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="发布动态认识更多新朋友"
                    android:singleLine="true"
                    app:typeface="medium"/>
            </p151v.VLinear>
        </p151v.VRelative>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.newui.home.views.CardBottomMomentLayout>
