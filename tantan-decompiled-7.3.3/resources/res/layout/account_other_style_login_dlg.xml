<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/account_bg_share_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#cc000000"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="21dp"
        android:text="其他登录方式"/>
    <p151v.VRecyclerView
        android:id="@+id/rl_login_style"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <View
        android:id="@+id/view_line"
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="24dp"
        android:layout_alignParentBottom="true"/>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/login_privacy_policy_frame"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <p151v.VCheckBox
            android:id="@+id/privacy_check"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            style="@style/common_checkbox"/>
        <p151v.VText
            android:textSize="12sp"
            android:textColor="@color/common_grey_04"
            android:textColorHighlight="@color/transparent"
            android:textColorLink="@color/welcome_privacy_link"
            android:id="@+id/privacy_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/account_welcome_privacy_gravity"/>
    </p151v.VLinear>
</p151v.VLinear>
