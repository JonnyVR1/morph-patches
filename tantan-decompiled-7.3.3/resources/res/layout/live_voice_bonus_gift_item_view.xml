<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true"
    holder="voice.intl.liveend.VoiceBonusGiftItemView">
    <p151v.VDraweeView
        android:id="@+id/gift_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="5"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
        app:layout_constraintRight_toRightOf="@+id/gift_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/live_white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/gift_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="70dp"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
