<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.common.chat.list.ChatListView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    folder="common.chat.list"
    holder="ChatListView">
    <include
        android:id="@+id/top_chat_view"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="70dp"
        android:layout_marginTop="-26dp"
        android:layout_marginBottom="7dp"
        android:layout_marginEnd="10dp"
        layout="@layout/live_chat_top_chat_view"/>
    <FrameLayout
        android:id="@+id/message_list_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        flatten="true">
        <com.p051p1.mobile.putong.live.base.view.LiveFadeRecyclerView
            android:id="@+id/list"
            android:fadingEdgeLength="30dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"/>
        <p151v.VText
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ff8817"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/new_message_tip"
            android:background="@drawable/live_bg_white_r10"
            android:paddingLeft="12dp"
            android:paddingTop="1dp"
            android:paddingRight="9dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/LIVE_NEW_MESSAGE"
            android:drawableRight="@drawable/live_vector_new_message_arrow"
            android:drawablePadding="2dp"/>
    </FrameLayout>
    <include
        android:id="@+id/userNotification"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/live_chat_user_notification_view"/>
</com.p051p1.mobile.putong.live.livingroom.common.chat.list.ChatListView>
