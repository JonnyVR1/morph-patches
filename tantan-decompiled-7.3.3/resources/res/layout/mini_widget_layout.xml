<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="155dp"
    android:layout_height="155dp">
    <ImageView
        android:id="@+id/iv_wight_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_core_mini_widget_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:src="0x7f0828db"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:singleLine="true"
        android:shadowColor="#33000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <ImageView
        android:id="@+id/iv_wight_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#ccffffff"
        android:id="@+id/tv_widget_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="116dp"
        android:singleLine="true"
        android:shadowColor="#33000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_toRightOf="@+id/iv_wight_icon"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ccffffff"
        android:id="@+id/tv_widget_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:shadowColor="#33000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_toRightOf="@+id/iv_wight_icon"
        android:layout_below="@+id/tv_widget_name"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#4c000000"
        android:gravity="center"
        android:id="@+id/tv_widget_light"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="前往App获取数据 "/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ccffffff"
        android:gravity="center"
        android:id="@+id/tv_widget_dark"
        android:background="#1c1c1e"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="前往App获取数据 "/>
</RelativeLayout>
