<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bind_extends="ConstraintLayout"
    app:binding="true"
    app:flatten="true">
    <include
        android:id="@+id/deputy_count_switch"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/live_multi_call_settings_view_deputy_switch"/>
    <include
        android:id="@+id/no_longer_accept"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deputy_count_switch"
        app:layout_goneMarginTop="0dp"
        layout="@layout/live_multi_call_settings_item_view"/>
    <include
        android:id="@+id/no_invitation_required"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_longer_accept"
        layout="@layout/live_multi_call_settings_item_view"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#4d000000"
        android:gravity="center"
        android:id="@+id/close_call"
        android:background="@drawable/live_bg_black_r14_a05"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:text="@string/LIVE_MULTI_CALL_CLOSE_CALL"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.p051p1.mobile.putong.live.livingroom.recreation.multiCall.dialog.view.MultiCallSettingsView>
