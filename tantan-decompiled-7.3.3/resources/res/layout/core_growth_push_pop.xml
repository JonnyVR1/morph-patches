<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.growth.views.GrowthPushPopView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="236dp"
    flatten="true"
    holder="growth.views.GrowthPushPopView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:background="@drawable/core_new_ui_match_success_bg"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="24dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/common_color_0d000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <p151v.VImage
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:src="0x7f08114f"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="18sp"
            android:textColor="@color/core_color_cc000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="@color/core_color_66000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lines="1"
            android:paddingHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <p151v.VButton
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/bt_pop_submit"
            android:background="@drawable/common_button_btn_orange_medium"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:text="立即聊天"
            android:layout_marginStart="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p151v.VFrame
        android:id="@+id/pic_fl"
        android:background="@drawable/core_newui_profile_btn_white_bg"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:elevation="20dp"
        android:outlineSpotShadowColor="@color/common_color_0d000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <p151v.VDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:placeholderImage="@color/common_white"
            app:roundAsCircle="true"/>
        <p151v.VImage
            android:id="@+id/online"
            android:background="@drawable/core_free_trial_online"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="61dp"
            android:layout_marginStart="61dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </p151v.VFrame>
</com.p051p1.mobile.putong.core.p058ui.growth.views.GrowthPushPopView>
