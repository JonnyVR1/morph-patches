<?xml version="1.0" encoding="utf-8"?>
<p151v.VLinear xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_bg_share_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/core_share_tip_bg"
        android:layout_width="37dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="#66000000"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="分享给好友"/>
    <p151v.VRecyclerView
        android:id="@+id/rl_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/ll_wechat_friend"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <View
        android:id="@+id/view_line"
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="24dp"
        android:layout_alignParentBottom="true"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="#51000000"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="取消"
        android:layout_below="@+id/view_line"
        app:typeface="medium"/>
</p151v.VLinear>
