<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="promotion.page.PromotionPageDialog">
    <p151v.VImage
        android:id="@+id/image_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f081851"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VImage
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f081855"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p151v.VText
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/promotion_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="210dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back"
        app:typeface="medium"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#cc000000"
        android:id="@+id/promotion_tip"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/promotion_title"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="#cc000000"
        android:id="@+id/privilege_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:drawablePadding="8dp"
        android:drawableStart="0x7f081512"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/promotion_tip"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="#cc000000"
        android:id="@+id/privilege_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="8dp"
        android:drawableStart="0x7f081512"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privilege_1"/>
    <p151v.VText
        android:textSize="16dp"
        android:textColor="#cc000000"
        android:id="@+id/privilege_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="8dp"
        android:drawableStart="0x7f081512"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privilege_2"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/agreement_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <p151v.VCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/agreement_check"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:checked="false"
            android:button="@null"
            android:layout_marginEnd="10dp"
            style="@style/common_checkbox"/>
        <p151v.VText
            android:textSize="13sp"
            android:textColor="#33000000"
            android:id="@+id/agreement_text"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/pay_method"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/agreement_root"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08180a"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:id="@+id/pay_method_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支付宝"
            android:drawablePadding="8dp"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="4dp"
            android:drawableStart="0x7f080d95"/>
        <p151v.VText
            android:textSize="9sp"
            android:textColor="#ff5435"
            android:layout_gravity="center_vertical"
            android:id="@+id/pay_method_prom_text"
            android:background="@drawable/core_alipay_sell_rect"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/pay_method_txt"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider"
        android:background="#08000000"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/pay_method"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p151v.VText
        android:textSize="15sp"
        android:textColor="#000000"
        android:id="@+id/origin_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.4"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/get_privilege_root"
        android:background="@drawable/core_svip_prom_year_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/origin_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        flatten="true">
        <p151v.VText
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/get_privilege_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <p151v.VText
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ccffffff"
            android:id="@+id/get_privilege_subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <p151v.VText
        android:textSize="9sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/day_price_tips"
        android:background="@drawable/core_svip_low_price_detail_dlg_tip_bg"
        android:paddingTop="9.5dp"
        android:paddingBottom="8.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/get_privilege_root"
        app:layout_constraintRight_toRightOf="parent"/>
    <p151v.VText
        android:textSize="17sp"
        android:textColor="#ccfe7e1d"
        android:id="@+id/promotion_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/get_privilege_root"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
