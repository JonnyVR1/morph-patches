<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.p051p1.mobile.putong.camera.widget.TTFullScreenAutoFitSurfaceView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/cover_layer_1"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VImage
        android:id="@+id/button_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="54dp"
        android:scaleType="fitXY"
        android:tint="@color/white"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/camera_ic_x"/>
    <p151v.VText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <RelativeLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <SurfaceView
            android:id="@+id/inner_surface_view"
            android:background="@drawable/camera_bg_idcard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginHorizontal="6dp"/>
        <p151v.VImage
            android:id="@+id/image_avatar"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="32dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/camera_ic_id_card_head"/>
        <p151v.VImage
            android:id="@+id/image_emblem"
            android:visibility="invisible"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="38dp"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/camera_ic_emblem"/>
    </RelativeLayout>
    <p151v.VImage
        android:id="@+id/button_take_photo"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginBottom="60dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/camera_ic_circle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
