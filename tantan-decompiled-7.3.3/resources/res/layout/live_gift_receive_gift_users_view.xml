<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.live.livingroom.increment.gift.receivegift.ReceiveGiftUsersView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    flatten="true"
    folder="increment"
    holder="gift.receivegift.ReceiveGiftUsersView">
    <p151v.VRecyclerView
        android:id="@+id/recyclerView"
        android:fadingEdgeLength="40dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="13dp"/>
    <p151v.VText
        android:textSize="14sp"
        android:textColor="@color/live_white_30_opacity"
        android:gravity="center"
        android:id="@+id/all"
        android:background="@drawable/live_selector_gift_receive_user_all_bg"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="15dp"
        android:text="@string/LIVE_ALLMIKE"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginHorizontal="15dp"/>
    <include
        android:id="@+id/audienceView"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        layout="@layout/live_gift_receive_gift_audience_view"/>
</com.p051p1.mobile.putong.live.livingroom.increment.gift.receivegift.ReceiveGiftUsersView>
