<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.ExplodeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    flatten="true"
    holder="purchase.privilege.ExplodeLayout">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/dash_1"
        android:visibility="invisible"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/dash_2"
        android:visibility="invisible"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/dash_3"
        android:visibility="invisible"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/dash_4"
        android:visibility="invisible"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/fl_center"
        android:background="0x7f080292"
        android:visibility="invisible"
        android:layout_width="112dp"
        android:layout_height="112dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/center_avatar"
            android:padding="6dp"
            android:layout_width="84dp"
            android:layout_height="84dp"
            fresco:roundAsCircle="true"/>
        <p151v.VImage
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/icon"
            android:layout_width="30dp"
            android:layout_height="21dp"
            android:layout_marginBottom="7dp"
            android:src="0x7f080f27"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_avatar1"
        android:background="0x7f080293"
        android:visibility="invisible"
        android:layout_width="94dp"
        android:layout_height="94dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar1"
            android:padding="3dp"
            android:layout_width="66dp"
            android:layout_height="66dp"
            fresco:roundAsCircle="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_avatar2"
        android:background="0x7f080294"
        android:visibility="invisible"
        android:layout_width="84dp"
        android:layout_height="84dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar2"
            android:padding="3dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            fresco:roundAsCircle="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_avatar3"
        android:background="0x7f080295"
        android:visibility="invisible"
        android:layout_width="72dp"
        android:layout_height="72dp"
        flatten="true"
        style="@style/vip_alert_avatar_frame_round_bg">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar3"
            android:padding="3dp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            fresco:roundAsCircle="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_avatar4"
        android:background="0x7f080296"
        android:visibility="invisible"
        android:layout_width="62dp"
        android:layout_height="62dp"
        flatten="true">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar4"
            android:padding="3dp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            fresco:roundAsCircle="true"/>
    </FrameLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.ExplodeLayout>
