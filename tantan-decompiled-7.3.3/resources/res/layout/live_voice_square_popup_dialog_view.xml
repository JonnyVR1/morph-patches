<?xml version="1.0" encoding="utf-8"?>
<p151v.VFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/empty"
        android:background="@color/live_black_30_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p151v.VFrame
        android:layout_gravity="center"
        android:id="@+id/container"
        android:background="@drawable/live_voice_square_popup_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <com.p051p1.mobile.putong.live.base.mmsdk.AnimEffectPlayer
            android:layout_gravity="center_horizontal"
            android:id="@+id/svga"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="20dp"/>
        <p151v.VDraweeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="36dp"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/live_black_80_opacity"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="160dp"
            android:layout_marginRight="32dp"/>
        <p151v.VLinear
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="189dp"
            android:layout_marginRight="32dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/live_black_40_opacity"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"/>
            <p151v.VLinear
                android:orientation="horizontal"
                android:id="@+id/gender_age"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:paddingStart="3dp"
                android:paddingEnd="5dp"
                android:layout_marginEnd="6dp">
                <p151v.VImage
                    android:layout_gravity="center"
                    android:id="@+id/gender"
                    android:layout_width="14dp"
                    android:layout_height="14dp"/>
                <p151v.VText
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/age"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </p151v.VLinear>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/live_white"
                android:gravity="center"
                android:id="@+id/zodiac"
                android:background="@drawable/live_bg_black_r4_a15"
                android:visibility="gone"
                android:layout_width="35dp"
                android:layout_height="14dp"/>
        </p151v.VLinear>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/live_white"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/live_bg_fe7e1d_r10"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="225dp"
            android:layout_marginRight="32dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/live_black_20_opacity"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="287dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="15dp"
            android:text="取消"/>
    </p151v.VFrame>
</p151v.VFrame>
