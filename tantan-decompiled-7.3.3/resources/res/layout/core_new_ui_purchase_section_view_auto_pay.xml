<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUIPurchaseSectionViewAutoPay xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    holder="purchase.showcase.NewUIPurchaseSectionViewAutoPay">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="121dp"
        android:layout_marginTop="12dp">
        <p151v.VText
            android:textSize="28dp"
            android:textColor="@color/core_auto_pay_count_color"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:singleLine="true"/>
        <p151v.VText_AutoFit
            android:textSize="16dp"
            android:textColor="@color/core_auto_pay_center_price_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/top_price"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            app:typeface="medium"/>
        <p151v.VText_AutoFit
            android:textSize="14dp"
            android:textColor="@color/common_orange_02"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
</com.p051p1.mobile.putong.core.p058ui.purchase.showcase.NewUIPurchaseSectionViewAutoPay>
