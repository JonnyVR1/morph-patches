<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.purchase.privilege.AudioMatchPrivilegeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    flatten="true"
    holder="purchase.privilege.AudioMatchPrivilegeView">
    <com.tantan.library.svga.SVGAnimationView
        android:id="@+id/voice_bg_anim"
        android:layout_width="154dp"
        android:layout_height="154dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_right_container"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_right_container"
        app:layout_constraintRight_toRightOf="@+id/avatar_right_container"
        app:layout_constraintTop_toTopOf="@+id/avatar_right_container"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.46"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_r"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.54"/>
    <FrameLayout
        android:id="@+id/avatar_left_container"
        android:background="@drawable/core_vip_auido_match_privilege_head_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="92dp"
        android:layout_height="92dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_right_container"
        app:layout_constraintRight_toLeftOf="@+id/guideline_r"
        app:layout_constraintTop_toTopOf="@+id/avatar_right_container"
        flatten="true"
        style="@style/vip_alert_avatar_frame_round_bg">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:backgroundImage="@color/white"
            app:roundAsCircle="true"
            style="@style/core_fresco_base"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/avatar_right_container"
        android:background="@drawable/core_vip_auido_match_privilege_right_head_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toRightOf="@+id/guideline_l"
        app:layout_constraintTop_toTopOf="parent"
        flatten="true"
        style="@style/vip_alert_avatar_frame_round_bg">
        <p151v.AutoVDraweeView
            android:layout_gravity="center"
            android:id="@+id/avatar_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true"
            style="@style/core_fresco_base"/>
    </FrameLayout>
    <p151v.VLinear
        android:gravity="center_vertical"
        android:id="@+id/voice_anim_container"
        android:background="@drawable/core_vip_auido_match_privilege_voice_bg"
        android:layout_width="77dp"
        android:layout_height="35dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        flatten="true">
        <p151v.VImage
            android:id="@+id/phone_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="12dp"
            android:src="0x7f0818f1"
            android:scaleType="centerCrop"/>
        <com.tantan.library.svga.SVGAnimationView
            android:id="@+id/voice_anim"
            android:layout_width="30dp"
            android:layout_height="15dp"
            android:layout_marginLeft="5dp"
            android:scaleType="fitCenter"/>
    </p151v.VLinear>
</com.p051p1.mobile.putong.core.p058ui.purchase.privilege.AudioMatchPrivilegeView>
