<?xml version="1.0" encoding="utf-8"?>
<com.p051p1.mobile.putong.core.p058ui.messages.ItemMomentComment xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="@drawable/core_group_msg_left_white"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    flatten="true">
    <RelativeLayout
        android:id="@+id/moment_prompt"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        flatten="true">
        <View
            android:id="@+id/view_left"
            android:background="@drawable/core_msg_left_cell_reference_line_bg"
            android:layout_width="3dp"
            android:layout_height="64dp"/>
        <FrameLayout
            android:id="@+id/moment_image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/view_left"
            android:layout_centerVertical="true">
            <p151v.VDraweeView
                android:id="@+id/moment_image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@color/white"
                app:failureImageScaleType="centerInside"
                app:placeholderImage="@drawable/core_message_comment_video_bg"
                app:placeholderImageScaleType="centerInside"
                app:roundBottomLeft="true"
                app:roundBottomRight="true"
                app:roundTopLeft="true"
                app:roundTopRight="true"
                app:roundedCornerRadius="@dimen/core_common_radius"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/audio_image"
                android:background="@drawable/core_message_comment_left_audio_bg"
                android:visibility="gone"
                android:layout_width="50dp"
                android:layout_height="60dp"/>
            <p151v.VImage
                android:layout_gravity="center"
                android:id="@+id/moment_play"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
        </FrameLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/common_grey_09"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/moment_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:lines="3"
            android:layout_toRightOf="@+id/moment_image_container"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="2dp"
            app:enableEmojis="true"
            app:largeEmojis="true"/>
    </RelativeLayout>
    <com.p051p1.mobile.putong.core.p058ui.messages.ItemText
        android:textSize="16sp"
        android:textColorLink="#1565c0"
        android:autoLink="web"
        android:id="@+id/text"
        android:paddingLeft="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="9.5dp"
        android:lineSpacingExtra="2dp"
        app:enableEmojis="true"
        app:largeEmojis="true"
        style="@style/messages_item_left"/>
</com.p051p1.mobile.putong.core.p058ui.messages.ItemMomentComment>
