<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@android:integer/config_mediumAnimTime">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <stroke
                android:width="4dp"
                android:color="@color/core_color_2CB599"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <stroke
                android:width="2dp"
                android:color="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>
