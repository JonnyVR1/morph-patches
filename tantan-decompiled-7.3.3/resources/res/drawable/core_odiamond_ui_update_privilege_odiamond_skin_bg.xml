<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#33bc811b"
                android:endColor="#66452305"
                android:angle="-45"
                android:centerColor="#0d7c521b"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item
        android:left="0.8dp"
        android:top="0.8dp"
        android:right="0.8dp"
        android:bottom="0.8dp">
        <shape>
            <gradient
                android:startColor="#301604"
                android:endColor="#180801"
                android:angle="-90"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</layer-list>
