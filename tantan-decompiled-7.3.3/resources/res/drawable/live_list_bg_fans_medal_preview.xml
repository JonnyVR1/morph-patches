        <shape android:shape="rectangle">
            <solid android:color="#0af0873c"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
