<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#212121"/>
            <corners android:radius="21dp"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape>
            <gradient
                android:startColor="#fff5bd"
                android:endColor="#ffd5f4"
                android:angle="180"/>
            <corners android:radius="21dp"/>
        </shape>
    </item>
</layer-list>
