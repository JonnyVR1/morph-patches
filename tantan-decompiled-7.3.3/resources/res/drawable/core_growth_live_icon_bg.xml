<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size
                android:height="46dp"
                android:width="46dp"/>
            <corners android:radius="23dp"/>
            <gradient
                android:startColor="#ff69ac"
                android:endColor="#ff5fe9"
                android:angle="0"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape>
            <corners android:radius="20dp"/>
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
</layer-list>
