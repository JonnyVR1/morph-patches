<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#f6d792"
                android:endColor="#d7a534"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#fff4dc"
                android:endColor="#fad88e"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
