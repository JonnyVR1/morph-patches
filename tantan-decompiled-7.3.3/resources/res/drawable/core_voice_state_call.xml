<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp"/>
            <corners android:radius="2dp"/>
            <stroke
                android:width="2.5dp"
                android:color="@color/white"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <padding
                android:left="2dp"
                android:top="1.5dp"
                android:right="2dp"
                android:bottom="1dp"/>
            <corners android:radius="2dp"/>
            <gradient
                android:startColor="#9e6dff"
                android:endColor="#ff8af6"
                android:angle="0"/>
        </shape>
    </item>
</layer-list>
