<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#f7c46b"
                android:endColor="#a36e27"
                android:angle="0"
                android:centerColor="#ffdebc"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient
                android:startColor="#180802"
                android:endColor="#221005"
                android:angle="135"/>
        </shape>
    </item>
</layer-list>
