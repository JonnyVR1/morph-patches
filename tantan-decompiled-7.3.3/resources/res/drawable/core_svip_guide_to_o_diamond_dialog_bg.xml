<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#c8b98c"
                android:endColor="#987f4a"
                android:angle="45"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1c1917"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
